theorem aux_lem_band_des3_close_arith (P E A B K : ℝ) (hP : 0 ≤ P) (hE : 0 ≤ E) (hA : 0 ≤ A)
    (hB : 0 ≤ B) (hK : 1 ≤ K) :
    P * (E + A + B) ≤ 16 * P * E + 8 * P * K * (A + B) := by
  have h1 : P * E ≤ 16 * P * E := by
    have := mul_nonneg hP hE
    linarith
  have h2 : P * (A + B) ≤ 8 * P * K * (A + B) := by
    have hAB : 0 ≤ P * (A + B) := mul_nonneg hP (add_nonneg hA hB)
    have h8 : (1 : ℝ) ≤ 8 * K := by linarith
    calc P * (A + B) = 1 * (P * (A + B)) := by ring
      _ ≤ (8 * K) * (P * (A + B)) := mul_le_mul_of_nonneg_right h8 hAB
      _ = 8 * P * K * (A + B) := by ring
  calc P * (E + A + B) = P * E + P * (A + B) := by ring
    _ ≤ 16 * P * E + 8 * P * K * (A + B) := add_le_add h1 h2

