  have hA0 : 0 ≤ (2 / r) ^ t * Kmacv * (Kf + Cphi) ^ 2 * rad ^ t := by positivity
  have hB0 : 0 ≤ aux_prop_growth_energy_assembly_Cr d r t t1 C * Zs * (Kf + Cphi) ^ 2 *
