theorem aux_lem_band_des3_lin_comb_moment {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (e : ℝ≥0∞) (he : 1 ≤ e) (f g1 g2 g3 : Ω → ℝ) (A B C2 : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hC2 : 0 ≤ C2) (hf : AEStronglyMeasurable f P) (hg1 : AEStronglyMeasurable g1 P)
    (hg2 : AEStronglyMeasurable g2 P) (hg3 : AEStronglyMeasurable g3 P) (bf bg : ℝ)
    (hbf0 : 0 ≤ bf) (hbg0 : 0 ≤ bg)
    (hbf : eLpNorm f e P ≤ ENNReal.ofReal bf) (hbg1 : eLpNorm g1 e P ≤ ENNReal.ofReal bg)
    (hbg2 : eLpNorm g2 e P ≤ ENNReal.ofReal bg) (hbg3 : eLpNorm g3 e P ≤ ENNReal.ofReal bg) :
    eLpNorm (fun om => (A * f om + B * (g1 om + g2 om + g3 om)) * C2) e P ≤
      ENNReal.ofReal (C2 * (A * bf + B * (3 * bg))) := by
  have hg : eLpNorm (fun om => g1 om + g2 om + g3 om) e P ≤ ENNReal.ofReal (3 * bg) := by
    calc eLpNorm (fun om => g1 om + g2 om + g3 om) e P
        ≤ eLpNorm (fun om => g1 om + g2 om) e P + eLpNorm g3 e P :=
          eLpNorm_add_le he
      _ ≤ (eLpNorm g1 e P + eLpNorm g2 e P) + eLpNorm g3 e P :=
          add_le_add (eLpNorm_add_le he) le_rfl
      _ ≤ (ENNReal.ofReal bg + ENNReal.ofReal bg) + ENNReal.ofReal bg :=
          add_le_add (add_le_add hbg1 hbg2) hbg3
      _ = ENNReal.ofReal (3 * bg) := by
          rw [← ENNReal.ofReal_add hbg0 hbg0, ← ENNReal.ofReal_add (by positivity) hbg0]
          ring_nf
  have hAf : eLpNorm (fun om => A * f om) e P ≤ ENNReal.ofReal (A * bf) := by
    calc eLpNorm (fun om => A * f om) e P = eLpNorm (A • f) e P := rfl
      _ ≤ ‖A‖ₑ * eLpNorm f e P := eLpNorm_const_smul_le
      _ ≤ ‖A‖ₑ * ENNReal.ofReal bf := by gcongr
      _ = ENNReal.ofReal (A * bf) := by
          rw [Real.enorm_eq_ofReal hA, ← ENNReal.ofReal_mul hA]
  have hBg : eLpNorm (fun om => B * (g1 om + g2 om + g3 om)) e P ≤
      ENNReal.ofReal (B * (3 * bg)) := by
    calc eLpNorm (fun om => B * (g1 om + g2 om + g3 om)) e P
        = eLpNorm (B • fun om => g1 om + g2 om + g3 om) e P := rfl
      _ ≤ ‖B‖ₑ * eLpNorm (fun om => g1 om + g2 om + g3 om) e P := eLpNorm_const_smul_le
      _ ≤ ‖B‖ₑ * ENNReal.ofReal (3 * bg) := by gcongr
      _ = ENNReal.ofReal (B * (3 * bg)) := by
          rw [Real.enorm_eq_ofReal hB, ← ENNReal.ofReal_mul hB]
  have hsum : eLpNorm (fun om => A * f om + B * (g1 om + g2 om + g3 om)) e P ≤
      ENNReal.ofReal (A * bf + B * (3 * bg)) := by
    calc eLpNorm (fun om => A * f om + B * (g1 om + g2 om + g3 om)) e P
        ≤ eLpNorm (fun om => A * f om) e P +
            eLpNorm (fun om => B * (g1 om + g2 om + g3 om)) e P :=
          eLpNorm_add_le he
      _ ≤ ENNReal.ofReal (A * bf) + ENNReal.ofReal (B * (3 * bg)) := add_le_add hAf hBg
      _ = ENNReal.ofReal (A * bf + B * (3 * bg)) :=
          (ENNReal.ofReal_add (by positivity) (by positivity)).symm
  calc eLpNorm (fun om => (A * f om + B * (g1 om + g2 om + g3 om)) * C2) e P
      = eLpNorm (C2 • fun om => A * f om + B * (g1 om + g2 om + g3 om)) e P := by
        congr 1; funext om; simp only [Pi.smul_apply, smul_eq_mul]; ring
    _ ≤ ‖C2‖ₑ * eLpNorm (fun om => A * f om + B * (g1 om + g2 om + g3 om)) e P :=
        eLpNorm_const_smul_le
    _ ≤ ‖C2‖ₑ * ENNReal.ofReal (A * bf + B * (3 * bg)) := by gcongr
    _ = ENNReal.ofReal (C2 * (A * bf + B * (3 * bg))) := by
        rw [Real.enorm_eq_ofReal hC2, ← ENNReal.ofReal_mul hC2]

theorem aux_lem_band_des3_eLpNorm_div_const {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (e : ℝ≥0∞) (f : Ω → ℝ) (c b : ℝ) (hc : 0 < c) (hb : eLpNorm f e P ≤ ENNReal.ofReal b) :
    eLpNorm (fun om => f om / c) e P ≤ ENNReal.ofReal (b / c) := by
  have hc' : 0 ≤ c⁻¹ := (inv_pos.2 hc).le
  calc eLpNorm (fun om => f om / c) e P = eLpNorm (c⁻¹ • f) e P := by
        congr 1; funext om; simp only [Pi.smul_apply, smul_eq_mul]; ring
    _ ≤ ‖c⁻¹‖ₑ * eLpNorm f e P := eLpNorm_const_smul_le
    _ ≤ ‖c⁻¹‖ₑ * ENNReal.ofReal b := by gcongr
    _ = ENNReal.ofReal (b / c) := by
        rw [Real.enorm_eq_ofReal hc', ← ENNReal.ofReal_mul hc', div_eq_inv_mul]

