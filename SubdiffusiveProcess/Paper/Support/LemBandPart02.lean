        eLpNorm (fun w => mInv N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bst ∧
        eLpNorm (fun w => M N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) * (1 + D N w) ^ t)
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bst)
    (Dx S W : ℕ → BilateralField d → ℝ)
    (hnn : ∀ N w, 0 ≤ Dx N w ∧ 0 ≤ S N w ∧ 0 ≤ S N w ∧ 0 ≤ W N w)
    (hLp : ∀ N, MemLp (Dx N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ∧
      MemLp (S N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ∧
      MemLp (S N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ∧
