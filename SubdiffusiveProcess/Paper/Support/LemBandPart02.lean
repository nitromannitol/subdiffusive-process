theorem aux_lem_band_des3_neumann_face_sample {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (Pn : Paper.in_poincare d hd I)
    (a : PositiveCoefficient (unitNeumannCube d)) (t Kres : ℝ) (hK0 : 0 ≤ Kres)
    (hres : ∀ (f : SpatialCoordinates d → ℝ),
      AEMeasurable f (volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))) →
      ∀ Kf : ℝ, 0 ≤ Kf →
      (∀ᵐ y ∂volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d)), |f y| ≤ Kf) →
      (∫ y in (unitNeumannCube d : Set (SpatialCoordinates d)), f y) = 0 →
      ∀ u : meanZeroSobolevGraph (unitNeumannCube d), SolvesNeumann a f u →
      ∀ x : SpatialCoordinates d, x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)) →
      ∀ r : ℝ, 0 < r → r ≤ 1 →
        localGradientEnergy a
          (s := Metric.ball x r ∩ (unitNeumannCube d : Set (SpatialCoordinates d)))
          (isOpen_ball.measurableSet.inter (unitNeumannCube d).isOpen.measurableSet)
          (sobolevGradient (u : SobolevData (unitNeumannCube d))) ≤
        Kres * (sobolevCoefficientForm a (u : SobolevData (unitNeumannCube d))
          (u : SobolevData (unitNeumannCube d)) + Kf ^ 2) * r ^ t)
    (hP : ∃ Kp : ℝ≥0, ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖)
    (rho : ℝ → ℝ) (pvec : Fin d → ℝ) (eps : ℝ) (heps : 0 < eps) (Dr : ℝ) (hDr : 0 ≤ Dr)
    (hface : ∀ y : SpatialCoordinates d, |faceBump rho pvec eps y| ≤ Dr * eps⁻¹)
    (hfaceMeas : AEStronglyMeasurable (faceBump rho pvec eps)
      (volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))))
    (hface0 : (∫ y in (unitNeumannCube d : Set (SpatialCoordinates d)), faceBump rho pvec eps y) = 0)
    (fL2 : DomainL2 (unitNeumannCube d))
    (hfL2 : ((fL2 : SpatialCoordinates d → ℝ) =ᵐ[
        volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))] faceBump rho pvec eps))
    (x : SpatialCoordinates d) (hx : x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)))
    (rad : ℝ) (hrad0 : 0 < rad) (hrad1 : rad ≤ 1) :
    localGradientEnergy a
        (s := Metric.ball x rad ∩ (unitNeumannCube d : Set (SpatialCoordinates d)))
        (Metric.isOpen_ball.measurableSet.inter (unitNeumannCube d).isOpen.measurableSet)
        (subspaceGradient (meanZeroResponseSpace hP).space
          (responseSolution (meanZeroResponseSpace hP) a
            ((sobolevVolumeLoad fL2).comp (meanZeroResponseSpace hP).space.subtypeL))) ≤
      Dr ^ 2 * (Kres * (1 + Pn.C ^ 2 *
        (I.lam (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos a (fun _ : Fin d => (1 / 2 : ℝ)) 1
          (1 / 8 : ℝ) 1)⁻¹)) * eps ^ (-2 : ℝ) * rad ^ t := by
  have hsol : SolvesNeumann a (faceBump rho pvec eps)
      (responseSolution (meanZeroResponseSpace hP) a
        ((sobolevVolumeLoad fL2).comp (meanZeroResponseSpace hP).space.subtypeL)) :=
    aux_lem_prefix_limit_atom_extraction_solvesN hP a (faceBump rho pvec eps) fL2 hfL2 hface0
  have hKf0 : 0 ≤ Dr * eps⁻¹ := mul_nonneg hDr (inv_nonneg.mpr heps.le)
  have hloc := hres (faceBump rho pvec eps) hfaceMeas.aemeasurable (Dr * eps⁻¹) hKf0
    (Filter.Eventually.of_forall fun y => hface y) hface0 _ hsol x hx rad hrad0 hrad1
  have hEn := aux_prop_neumann_growth_global_energy hd I Pn a (faceBump rho pvec eps) hfaceMeas
    (Dr * eps⁻¹) hKf0 hface _ hsol
  have hlampos := I.lam_pos (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos a
    (fun _ : Fin d => (1 / 2 : ℝ)) 1 (1 / 8 : ℝ) 1
  have hmono := I.lam_mono (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos a
    (fun _ : Fin d => (1 / 2 : ℝ)) 1 1 (1 / 8 : ℝ) 1 (by norm_num)
  have hinv := inv_anti₀ hlampos hmono
  have he2 : eps ^ (-2 : ℝ) = (eps⁻¹) ^ 2 := by
    rw [Real.rpow_neg heps.le, inv_pow]
    norm_cast
  rw [mul_pow, ← he2] at hloc
  have hEn' : sobolevCoefficientForm a
      ((responseSolution (meanZeroResponseSpace hP) a
        ((sobolevVolumeLoad fL2).comp (meanZeroResponseSpace hP).space.subtypeL) :
          (meanZeroResponseSpace hP).space) : SobolevData (unitNeumannCube d))
      ((responseSolution (meanZeroResponseSpace hP) a
        ((sobolevVolumeLoad fL2).comp (meanZeroResponseSpace hP).space.subtypeL) :
          (meanZeroResponseSpace hP).space) : SobolevData (unitNeumannCube d)) ≤
      Dr ^ 2 * eps ^ (-2 : ℝ) * Pn.C ^ 2 *
        (I.lam (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos a (fun _ : Fin d => (1 / 2 : ℝ)) 1 1 1)⁻¹ := by
    rw [he2]; convert! hEn using 2 <;> ring
  exact aux_prop_neumann_growth_combine _ Kres _ Dr (eps ^ (-2 : ℝ)) Pn.C _ _ (rad ^ t) hK0
    (Real.rpow_nonneg heps.le _) (Real.rpow_nonneg hrad0.le _) hinv hloc hEn'

theorem aux_lem_band_des3_neumann_K_moment {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (q C0 Dr Bres Clam : ℝ) (hq : 1 ≤ q) (Kres Lam : Ω → ℝ)
    (hKm : MemLp Kres (ENNReal.ofReal (2 * q)) P)
    (hKb : eLpNorm Kres (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal Bres)
    (hLm : MemLp Lam (ENNReal.ofReal (2 * q)) P)
    (hLb : eLpNorm Lam (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal Clam) :
    MemLp (fun om => Dr ^ 2 * (Kres om * (1 + C0 ^ 2 * Lam om))) (ENNReal.ofReal q) P ∧
    eLpNorm (fun om => Dr ^ 2 * (Kres om * (1 + C0 ^ 2 * Lam om))) (ENNReal.ofReal q) P ≤
      ENNReal.ofReal (Dr ^ 2 * (max (max Bres (C0 ^ 2 * Clam)) 0 *
        (1 + max (max Bres (C0 ^ 2 * Clam)) 0))) := by
  obtain ⟨c0, hc0⟩ : ∃ c : ℝ, c = C0 ^ 2 := ⟨_, rfl⟩
  obtain ⟨e0, he0⟩ : ∃ e : ℝ, e = Dr ^ 2 := ⟨_, rfl⟩
  rw [← hc0, ← he0]
  have hc00 : 0 ≤ c0 := by rw [hc0]; positivity
  have he00 : 0 ≤ e0 := by rw [he0]; positivity
  obtain ⟨Cq, hCqdef⟩ : ∃ Cq : ℝ, Cq = max (max Bres (c0 * Clam)) 0 := ⟨_, rfl⟩
  rw [← hCqdef]
  have hCq0 : 0 ≤ Cq := by rw [hCqdef]; exact le_max_right _ _
  have hV : MemLp (fun om => c0 * Lam om) (ENNReal.ofReal (2 * q)) P := hLm.const_mul _
  have hVb : eLpNorm (fun om => c0 * Lam om) (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal Cq := by
    calc eLpNorm (fun om => c0 * Lam om) (ENNReal.ofReal (2 * q)) P
        = eLpNorm (c0 • Lam) (ENNReal.ofReal (2 * q)) P := rfl
      _ ≤ ‖c0‖ₑ * eLpNorm Lam (ENNReal.ofReal (2 * q)) P := eLpNorm_const_smul_le
      _ ≤ ‖c0‖ₑ * ENNReal.ofReal Clam := by gcongr
      _ = ENNReal.ofReal (c0 * Clam) := by
          rw [Real.enorm_eq_ofReal hc00, ← ENNReal.ofReal_mul hc00]
      _ ≤ ENNReal.ofReal Cq := ENNReal.ofReal_le_ofReal (by
          rw [hCqdef]; exact (le_max_right _ _).trans (le_max_left _ _))
  have hUb : eLpNorm Kres (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal Cq :=
    hKb.trans (ENNReal.ofReal_le_ofReal (by
      rw [hCqdef]; exact (le_max_left _ _).trans (le_max_left _ _)))
  obtain ⟨hUVm, hUVb⟩ := aux_rem_resolved_UV_moment P q Cq hq hCq0 Kres
    (fun om => c0 * Lam om) hKm hV hUb hVb
  refine ⟨hUVm.const_mul e0, ?_⟩
  calc eLpNorm (fun om => e0 * (Kres om * (1 + c0 * Lam om))) (ENNReal.ofReal q) P
      = eLpNorm (e0 • fun om => Kres om * (1 + c0 * Lam om)) (ENNReal.ofReal q) P := rfl
    _ ≤ ‖e0‖ₑ * eLpNorm (fun om => Kres om * (1 + c0 * Lam om)) (ENNReal.ofReal q) P :=
        eLpNorm_const_smul_le
    _ ≤ ‖e0‖ₑ * ENNReal.ofReal (Cq * (1 + Cq)) := by gcongr
    _ = ENNReal.ofReal (e0 * (Cq * (1 + Cq))) := by
        rw [Real.enorm_eq_ofReal he00, ← ENNReal.ofReal_mul he00]

theorem aux_lem_band_des3_neumann_H0_growth_It
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (_Poincare : Paper.in_poincare d hd I)
    (_Extension : Paper.in_extension d hd I) (_Perturbation : Lane4.SmallPerturbationInput d)
    (_Sobolev : Lane4.SobolevFoundationalInput d hd)
    (D : Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (rho : ℝ → ℝ) (hrho : ContDiff ℝ ∞ rho) (hrho0 : ∀ tau, 0 ≤ rho tau)
    (hrhos : ∀ tau, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) (hrhoi : (∫ tau, rho tau) = 1)
    (pvec : Fin d → ℝ) (hpvec : (∑ i : Fin d, (pvec i) ^ 2) = 1)
    (hP : ∃ Kp : ℝ≥0, ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖)
    (fL2 : ℝ → DomainL2 (unitNeumannCube d))
    (hfL2 : ∀ eps : ℝ, (0 < eps ∧ eps < 1 / 8) →
      ((fL2 eps : SpatialCoordinates d → ℝ) =ᵐ[
        volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))]
        faceBump rho pvec eps))
    (t p : ℝ) (ht0 : (d : ℝ) - 1 < t) (ht1 : t < (d : ℝ)) (hp : 2 ≤ p) :
    ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 ≤ B ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : Paper.in_6_16 d M) (_It : Paper.in_iteration d M I Sreg),
        let Q := unitNeumannCube d
        let S := meanZeroResponseSpace hP
        let L0 : S.space →L[ℝ] ℝ :=
          (affineNeumannLoad pvec).comp (subspaceGradient (meanZeroSobolevGraph Q))
        let Leps : ℝ → S.space →L[ℝ] ℝ := fun eps =>
          (sobolevVolumeLoad (fL2 eps)).comp S.space.subtypeL
        let P : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
        let aN : ℕ → BilateralField d → PositiveCoefficient Q := fun N om =>
          cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ => (1 / 2 : ℝ)) one_pos
        let yN : ℕ → BilateralField d → ℝ := fun N om => inverseResponse S (aN N om) L0
        let yeps : ℝ → ℕ → BilateralField d → ℝ := fun eps N om =>
          inverseResponse S (aN N om) (Leps eps)
        let ueps : ℝ → ℕ → BilateralField d → S.space := fun eps N om =>
          responseSolution S (aN N om) (Leps eps)
        ∃ K : ℕ → BilateralField d → ℝ,
          (∀ N, AEStronglyMeasurable (K N) P) ∧
          (∀ᵐ om ∂P, ∀ N, 0 ≤ K N om) ∧
          (∀ᵐ om ∂P,
            ∀ (N : ℕ) (eps : ℝ),
              (0 < eps ∧ eps < 1 / 8) →
              ∀ (x : SpatialCoordinates d) (rad : ℝ),
                x ∈ Q → (0 < rad ∧ rad ≤ 1) →
                localGradientEnergy (aN N om)
                    (s := Metric.ball x rad ∩ (Q : Set (SpatialCoordinates d)))
                    (Metric.isOpen_ball.measurableSet.inter Q.isOpen.measurableSet)
                    (subspaceGradient S.space (ueps eps N om)) ≤
                  K N om * eps ^ (-2 : ℝ) * rad ^ t) ∧
          (∀ N,
            MemLp (K N) (ENNReal.ofReal (3 * p)) P ∧
              eLpNorm (K N) (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal B) := by
  have hps : (1 : ℝ) ≤ 2 * (3 * p) := by linarith
  have h3p : (1 : ℝ) ≤ 3 * p := by linarith
  obtain ⟨δres, Bres, hδres, hBres, hres⟩ := aux_lem_band_des3_h0_rem_resolved d hd I _Poincare _Extension
    _Perturbation D t ht0 ht1 (2 * (3 * p)) hps
  obtain ⟨δlam, hδlam, Clam, hClam, hlam⟩ :=
    aux_lem_band_h0li_lambda_inv_moments d hd I (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos le_rfl
  have hcs : HasCompactSupport rho := by
    refine HasCompactSupport.intro (isCompact_Icc (a := (1 : ℝ)) (b := 2)) ?_
    intro tau htau
    exact hrhos tau (fun h => htau ⟨h.1.le, h.2.le⟩)
  obtain ⟨Mrho, hMrho⟩ := hrho.continuous.bounded_above_of_compact_support hcs
  obtain ⟨Krho, hKrhodef⟩ : ∃ Krho : ℝ, Krho = max Mrho 0 := ⟨_, rfl⟩
  have hKrho : ∀ tau : ℝ, |rho tau| ≤ Krho := by
    intro tau
    rw [← Real.norm_eq_abs, hKrhodef]
    exact (hMrho tau).trans (le_max_left _ _)
  obtain ⟨Dr, hDrdef⟩ : ∃ Dr : ℝ, Dr = (∑ i : Fin d, |pvec i|) * (2 * Krho) := ⟨_, rfl⟩
  have hDr : 0 ≤ Dr := by
    have : 0 ≤ Krho := by rw [hKrhodef]; exact le_max_right _ _
    rw [hDrdef]; positivity
  have hload := fun (eps : ℝ) (heps : 0 < eps) (heps8 : eps < 1 / 8) =>
    lane4_smoothed_load_properties d rho hrho hrhos Krho hKrho pvec eps heps heps8
  have hface : ∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ y : SpatialCoordinates d,
      |faceBump rho pvec eps y| ≤ Dr * eps⁻¹ := by
    intro eps heps heps8 y
    rw [hDrdef]
    simpa only [faceBump, lane4_smoothed_neumann_load] using (hload eps heps heps8).2.1 y
  have hfaceMeas : ∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
      AEStronglyMeasurable (faceBump rho pvec eps)
        (volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))) := by
    intro eps heps heps8
    have hc := (hload eps heps heps8).1.continuous
    simpa only [faceBump, lane4_smoothed_neumann_load] using! hc.aestronglyMeasurable
  have hface0 : ∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
      (∫ y in (unitNeumannCube d : Set (SpatialCoordinates d)), faceBump rho pvec eps y) = 0 := by
    intro eps heps heps8
    simpa only [faceBump, lane4_smoothed_neumann_load] using (hload eps heps heps8).2.2.2
  refine ⟨min δres (δlam (2 * (3 * p))), Dr ^ 2 * (max (max Bres (_Poincare.C ^ 2 *
      Clam (2 * (3 * p)))) 0 * (1 + max (max Bres (_Poincare.C ^ 2 * Clam (2 * (3 * p)))) 0)),
    lt_min hδres (hδlam _ hps), by positivity, ?_⟩
  intro M hM Rm _hRm Sreg It Q S L0 Leps P aN yN yeps ueps
  obtain ⟨Kres, hK0, hKmom, hae⟩ := hres M Rm Sreg It (hM.trans (min_le_left _ _))
  have hlamM := hlam M Rm (2 * (3 * p)) hps (hM.trans (min_le_right _ _))
  have hmom := fun N => aux_lem_band_des3_neumann_K_moment P (3 * p) _Poincare.C Dr Bres
    (Clam (2 * (3 * p))) h3p (Kres N) _ (hKmom N).1 (hKmom N).2 (hlamM N).1 (hlamM N).2
  refine ⟨fun N om => Dr ^ 2 * (Kres N om * (1 + _Poincare.C ^ 2 *
      (I.lam (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos (aN N om) (fun _ : Fin d => (1 / 2 : ℝ)) 1
        (1 / 8 : ℝ) 1)⁻¹)),
    fun N => (hmom N).1.aestronglyMeasurable,
    Filter.Eventually.of_forall fun om N => by
      have h1 := hK0 N om
      have h2 := (inv_pos.2 (I.lam_pos (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos (aN N om)
        (fun _ : Fin d => (1 / 2 : ℝ)) 1 (1 / 8 : ℝ) 1)).le
      positivity, ?_, hmom⟩
  filter_upwards [hae] with om hom
  intro N eps heps x rad hx hrad
  exact aux_lem_band_des3_neumann_face_sample hd I _Poincare (aN N om) t (Kres N om) (hK0 N om) (hom N) hP
    rho pvec eps heps.1 Dr hDr (hface eps heps.1 heps.2) (hfaceMeas eps heps.1 heps.2)
    (hface0 eps heps.1 heps.2) (fL2 eps) (hfL2 eps heps) x hx rad hrad.1 hrad.2

theorem aux_lem_band_des3_neumann_yN_moments (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (_Poincare : Paper.in_poincare d hd I)
    (_Sobolev : Lane4.SobolevFoundationalInput d hd)
    (rho : ℝ → ℝ) (hrho : ContDiff ℝ ∞ rho) (hrho0 : ∀ tau, 0 ≤ rho tau)
    (hrhos : ∀ tau, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) (hrhoi : (∫ tau, rho tau) = 1)
    (pvec : Fin d → ℝ) (hpvec : (∑ i : Fin d, (pvec i) ^ 2) = 1)
    (hP : ∃ Kp : ℝ≥0, ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖)
    (p : ℝ) (hp : 2 ≤ p) :
    ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 ≤ B ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : Paper.in_responses d M) (N : ℕ),
        MemLp (fun om => inverseResponse (meanZeroResponseSpace hP)
