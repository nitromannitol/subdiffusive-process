  have hFnorm := aux_lem_extension_cell_moment_physicalLogNorm_eLpNorm M (m - 1)
    ((3 : ℝ) ^ ((m - 1 : ℕ) : ℤ) • c) 1 p (by norm_num) hp
  have hstep := mul_le_mul_right hFnorm (ENNReal.ofReal (Real.exp D))
  refine hstep.trans ?_
  rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add]
  apply ENNReal.ofReal_le_ofReal
  apply Real.exp_le_exp.mpr
  have hlen : ((m - 1 : ℕ) : ℝ) + 1 ≤ (m : ℝ) + 1 := by
    exact_mod_cast (show m - 1 + 1 ≤ m + 1 by omega)
  have hfluctnn : (0 : ℝ) ≤ (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 :=
