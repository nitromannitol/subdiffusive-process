        M.delta ^ 2 * ((m : ℝ) + 1) :=
    mul_le_mul_of_nonneg_left hlen (mul_nonneg hBnn hdelta2)
  have hcoefle : 2 * Real.log 2 +
      (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4) ≤
      4 * Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 := by
