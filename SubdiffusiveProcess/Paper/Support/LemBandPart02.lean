    (hT1 : eLpNorm (fun om => (1 + Dx om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) *
      (U om * (1 + V om))) (ENNReal.ofReal q) P ≤ ENNReal.ofReal Bst)
    (hT2 : eLpNorm (fun om => ‖Mx om + ((Mx om)⁻¹)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
