    ENNReal.ofReal (Real.exp (Real.log 2 / p +
      (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4) *
        M.delta ^ 2 * ((N : ℝ) + 1))) := by
  have hzero : ∀ om : BilateralField d,
      ‖((fun _ => (0 : C(SpatialCoordinates d, ℝ))) om).restrict
        (K : Set (SpatialCoordinates d))‖ = (0 : ℝ) := fun om => by
    show ‖(ContinuousMap.restrict (K : Set (SpatialCoordinates d))
      (0 : C(SpatialCoordinates d, ℝ)))‖ = 0
    rw [show (ContinuousMap.restrict (K : Set (SpatialCoordinates d))
      (0 : C(SpatialCoordinates d, ℝ))) = 0 from by ext x; rfl, norm_zero]
  have heq : aux_lane4_lambda_inv_cell_moment_env M
      (fun _ => (0 : C(SpatialCoordinates d, ℝ))) K N g =
      fun om => Real.exp (1 * aux_lem_extension_cell_moment_physicalLogNorm M N
        ((3 : ℝ) ^ N • g) om) := by
