      (4 * Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) *
        M.delta ^ 2 * ((m : ℝ) + 1) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hcoefle hdelta2) hm1nn
  unfold aux_lem_extension_cell_moment_aboveRate
  nlinarith [hstep1, hstep2, hA]

theorem aux_lem_band_h0li_env_moment {d : ℕ}
