      = eLpNorm (Z • fun om => U om * (1 + V om)) (ENNReal.ofReal Q) P := rfl
    _ ≤ ‖Z‖ₑ * eLpNorm (fun om => U om * (1 + V om)) (ENNReal.ofReal Q) P :=
        eLpNorm_const_smul_le
    _ ≤ ‖Z‖ₑ * ENNReal.ofReal (CUV * (1 + CUV)) := by gcongr
