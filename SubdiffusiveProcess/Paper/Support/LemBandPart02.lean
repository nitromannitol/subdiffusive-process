    have h3 : ((d : ℝ) + 1) / eta * eta = (d : ℝ) + 1 := by field_simp
    rw [h3] at h2
    linarith
  obtain ⟨C, delta0, Cp, hCpos, hdelta0pos, hCppos, hmain⟩ :=
    aux_lem_band_des3_of_onestep0 d hd I _Poincare _Extension D Lstar Rstar t0 eta etas p q
