    (ht_nn : 0 ≤ t) (htt1 : t < t1) (hq : 1 ≤ q) (hq1 : 1 ≤ 2 * q * max 1 t)
    (hpq : q ≤ 2 * q * max 1 t) (hCm : 0 < Cm) (hCp : 0 < Cp) (hCmic : 0 < Cmic)
    (hBst : 0 ≤ Bst)
    (hrate : 0 ≤ Cde * M.delta + Cpe * M.delta ^ 2)
    (hrate' : Cde * M.delta + Cpe * M.delta ^ 2 ≤ aRateM)
    (hmicL : ∀ eps : ℝ, 0 < eps → eps ≤ 1 →
