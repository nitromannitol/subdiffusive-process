theorem aux_lem_band_des3_point0
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (q : ℝ) (hq : 1 ≤ q) :
    ∃ Cmom Crate : ℝ,
      0 < Cmom ∧ 0 < Crate ∧
      ∀ delta0 : ℝ, 0 < delta0 → delta0 ≤ 1 →
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
        (Rm : Paper.in_responses d M),
        M.delta ≤ delta0 →
        let P := (chaosSampleLaw M).toMeasure
        let K : Set (SpatialCoordinates d) := {x | ∀ i, 0 ≤ x i ∧ x i ≤ 1}
        let G0 : ℕ → BilateralField d → SpatialCoordinates d → ℝ :=
          fun k omega x => ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) x
        let s0 : ℕ → ℕ → BilateralField d → SpatialCoordinates d → ℝ :=
          fun N k omega x =>
            SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
                SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
              Real.exp (G0 k omega x - (k : ℝ) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P)
        ∀ aexp : ℝ, aexp ∈ Set.Icc 1 (2 * q) →
          ∀ (N k : ℕ), k ≤ N → ∀ y ∈ K,
            Integrable (fun omega => (s0 N k omega y) ^ aexp +
              (s0 N k omega y) ^ (-aexp)) P ∧
            (∫ omega, (s0 N k omega y) ^ aexp +
              (s0 N k omega y) ^ (-aexp) ∂P) ≤
              Cmom * Real.exp (Crate * (aexp + aexp ^ 2) * M.delta ^ 2 * (k : ℝ)) ∧
            MemLp (fun omega => s0 N k omega y) (ENNReal.ofReal aexp) P ∧
              MemLp (fun omega => (s0 N k omega y)⁻¹)
              (ENNReal.ofReal aexp) P := by
  set A : ℝ := 4 + ((1 + Real.log 2) ^ (2 : ℝ)⁻¹) ^ 2 with hA_def
  have hAnonneg : 0 ≤ A := by rw [hA_def]; positivity
  clear_value A
  refine ⟨2, A + 2, by norm_num, by linarith, ?_⟩
  intro delta0 hdelta0pos hdelta0le M Rm hMd
  dsimp only
  intro a ha N k hkn y hy
  have ha1 : 0 < a := lt_of_lt_of_le zero_lt_one ha.1
  have hahompos : ∀ m : ℕ, 0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M m :=
    fun m => lt_of_lt_of_le (Real.exp_pos _) (Rm.ahom_lower m)
  set r : ℝ := SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) / SubdiffusiveProcess.CoarseGrainingVocab.ahom M N
    with hr_def
  have hrpos : 0 < r := div_pos (hahompos _) (hahompos _)
  have hratio : r ≤ Real.exp (2 * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P * (k : ℝ)) := by
    by_cases hk0 : k = 0
    · subst hk0
      rw [hr_def, Nat.sub_zero, div_self (ne_of_gt (hahompos N))]
      simp
    · have hsub : N - k < N := by omega
      have hord := Rm.ahom_ordering (N - k) N hsub
      rw [hr_def]
      apply (div_le_iff₀ (hahompos N)).2
      calc
        SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) ≤
            Real.exp (2 * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P * ((N : ℝ) - (N - k : ℕ))) *
              SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := hord.2
        _ = Real.exp (2 * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P * (k : ℝ)) *
              SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := by
          congr 2
          rw [Nat.cast_sub hkn]; ring
  have hratioInv : r⁻¹ ≤ 1 := by
    by_cases hk0 : k = 0
    · subst hk0
      rw [hr_def, Nat.sub_zero, div_self (ne_of_gt (hahompos N))]
      simp
    · rw [hr_def]
      apply inv_le_one_of_one_le₀
      apply (le_div_iff₀ (hahompos N)).2
      simpa using (Rm.ahom_ordering (N - k) N (by omega)).1
  clear_value r
  set center : BilateralField d → ℝ := fun omega =>
    (∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y) -
      (k : ℝ) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P with hcenter_def
  set F : BilateralField d → ℝ := fun omega => r * Real.exp (center omega) with hF_def
  have hFpos : ∀ omega, 0 < F omega := fun omega => mul_pos hrpos (Real.exp_pos _)
  have hFmeas : Measurable F := by
    have hsummeas : Measurable (fun omega : BilateralField d =>
        ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y) :=
      Finset.measurable_sum _ (fun j _ => (continuous_eval_const y).measurable.comp
        (measurable_pi_apply (-(j : ℤ))))
    rw [hF_def]
    exact measurable_const.mul ((hsummeas.sub measurable_const).exp)
  have hexppow : ∀ (x t : ℝ), (Real.exp x) ^ t = Real.exp (x * t) := by
    intro x t
    rw [Real.rpow_def_of_pos (Real.exp_pos x), Real.log_exp]
  have hFpow : ∀ (t : ℝ) (omega : BilateralField d),
      (F omega) ^ t = r ^ t * Real.exp (t * center omega) := by
    intro t omega
    rw [hF_def]
    rw [Real.mul_rpow hrpos.le (Real.exp_pos _).le, hexppow (center omega) t, mul_comm (center omega) t]
  have hsumPos := aux_lane4_reference_point_moments_sum M k y a
  have hsumNeg := aux_lane4_reference_point_moments_sum M k y (-a)
  have habsPos : |a| = a := abs_of_pos ha1
  have habsNeg : |(-a)| = a := by rw [abs_neg, habsPos]
  have hsumNegSq : (-a) ^ 2 = a ^ 2 := by ring
  have hplusInt : Integrable (fun omega => (F omega) ^ a) (chaosSampleLaw M).toMeasure :=
    (hsumPos.1.const_mul (r ^ a)).congr
      (Filter.Eventually.of_forall fun omega => (hFpow a omega).symm)
  have hminusInt : Integrable (fun omega => (F omega) ^ (-a)) (chaosSampleLaw M).toMeasure :=
    (hsumNeg.1.const_mul (r ^ (-a))).congr
      (Filter.Eventually.of_forall fun omega => (hFpow (-a) omega).symm)
  have hplusIntegral : (∫ omega, (F omega) ^ a ∂(chaosSampleLaw M).toMeasure) ≤
      r ^ a * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by
    have heq : (∫ omega, (F omega) ^ a ∂(chaosSampleLaw M).toMeasure) =
        r ^ a * ∫ omega, Real.exp (a * center omega) ∂(chaosSampleLaw M).toMeasure := by
      rw [← integral_const_mul]
      exact integral_congr_ae (Filter.Eventually.of_forall fun omega => hFpow a omega)
    rw [heq]
    apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hrpos.le _)
    calc (∫ omega, Real.exp (a * center omega) ∂(chaosSampleLaw M).toMeasure) ≤
        Real.exp (A * (|a| + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by
          rw [hA_def]; exact hsumPos.2
      _ = Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by rw [habsPos]
  have hminusIntegral : (∫ omega, (F omega) ^ (-a) ∂(chaosSampleLaw M).toMeasure) ≤
      r ^ (-a) * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by
    have heq : (∫ omega, (F omega) ^ (-a) ∂(chaosSampleLaw M).toMeasure) =
        r ^ (-a) * ∫ omega, Real.exp (-a * center omega) ∂(chaosSampleLaw M).toMeasure := by
      rw [← integral_const_mul]
      exact integral_congr_ae (Filter.Eventually.of_forall fun omega => hFpow (-a) omega)
    rw [heq]
    apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg (by positivity) _)
    calc (∫ omega, Real.exp (-a * center omega) ∂(chaosSampleLaw M).toMeasure) ≤
        Real.exp (A * (|(-a)| + (-a) ^ 2) * M.delta ^ 2 * (k : ℝ)) := by
          rw [hA_def]; exact hsumNeg.2
      _ = Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by rw [habsNeg, hsumNegSq]
  have hrapow : r ^ a ≤ Real.exp (2 * a * M.delta ^ 2 * (k : ℝ)) := by
    have hpow := Real.rpow_le_rpow hrpos.le hratio ha1.le
    calc r ^ a ≤ (Real.exp (2 * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P * (k : ℝ))) ^ a := hpow
      _ = Real.exp (2 * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P * (k : ℝ) * a) :=
        hexppow _ a
      _ ≤ Real.exp (2 * a * M.delta ^ 2 * (k : ℝ)) := by
        apply Real.exp_le_exp.mpr
        have htau : SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P ≤ M.delta ^ 2 := by
          have hh := SubdiffusiveProcess.CoarseGrainingVocab.tauSq_le_delta_sq M
          have hlog : Real.log 2 / 2 ≤ 1 := by
            have hlog' := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 2 by norm_num)
            linarith
          nlinarith [sq_nonneg M.delta]
        have hknn : 0 ≤ (k : ℝ) := Nat.cast_nonneg _
        nlinarith [mul_le_mul_of_nonneg_right htau hknn]
  have hraInvpow : r ^ (-a) ≤ 1 := by
    have h1 : r ^ (-a) = (r⁻¹) ^ a := by
      rw [Real.rpow_neg hrpos.le, ← Real.inv_rpow hrpos.le]
    rw [h1]
    calc (r⁻¹) ^ a ≤ 1 ^ a := Real.rpow_le_rpow (inv_nonneg.mpr hrpos.le) hratioInv ha1.le
      _ = 1 := Real.one_rpow a
  have hAstep : A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) ≤
      (A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) := by
    have hnn : (0 : ℝ) ≤ (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) := by positivity
    have h := mul_le_mul_of_nonneg_right (by linarith : A ≤ A + 2) hnn
    calc A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) =
        A * ((a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by ring
      _ ≤ (A + 2) * ((a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := h
      _ = (A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) := by ring
  have hstep1 : 2 * a * M.delta ^ 2 * (k : ℝ) + A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) ≤
      (A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) := by
    have h2a : 2 * a * M.delta ^ 2 * (k : ℝ) ≤ 2 * (a ^ 2 * M.delta ^ 2 * (k : ℝ)) +
        2 * a * M.delta ^ 2 * (k : ℝ) := by
      have : (0 : ℝ) ≤ 2 * (a ^ 2 * M.delta ^ 2 * (k : ℝ)) := by positivity
      linarith
    have heq : (A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) =
        A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) +
          (2 * (a ^ 2 * M.delta ^ 2 * (k : ℝ)) + 2 * a * M.delta ^ 2 * (k : ℝ)) := by ring
    rw [heq]
    linarith
  have hterm1 : r ^ a * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) ≤
      Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by
    calc r ^ a * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) ≤
        Real.exp (2 * a * M.delta ^ 2 * (k : ℝ)) *
          Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) :=
      mul_le_mul_of_nonneg_right hrapow (Real.exp_pos _).le
      _ = Real.exp (2 * a * M.delta ^ 2 * (k : ℝ) + A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) :=
        (Real.exp_add _ _).symm
      _ ≤ Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := Real.exp_le_exp.mpr hstep1
  have hterm2 : r ^ (-a) * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) ≤
      Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by
    calc r ^ (-a) * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) ≤
        1 * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) :=
      mul_le_mul_of_nonneg_right hraInvpow (Real.exp_pos _).le
      _ = Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := one_mul _
      _ ≤ Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := Real.exp_le_exp.mpr hAstep
  have hsumBound : (∫ omega, (F omega) ^ a + (F omega) ^ (-a)
      ∂(chaosSampleLaw M).toMeasure) ≤
      2 * Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by
    rw [integral_add hplusInt hminusInt]
    calc (∫ omega, (F omega) ^ a ∂(chaosSampleLaw M).toMeasure) +
        (∫ omega, (F omega) ^ (-a) ∂(chaosSampleLaw M).toMeasure) ≤
        r ^ a * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) +
          r ^ (-a) * Real.exp (A * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) :=
      add_le_add hplusIntegral hminusIntegral
      _ ≤ Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) +
          Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) :=
        add_le_add hterm1 hterm2
      _ = 2 * Real.exp ((A + 2) * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ)) := by ring
  have hp0 : ENNReal.ofReal a ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr ha1)
  have hptop : ENNReal.ofReal a ≠ (⊤ : ℝ≥0∞) := ENNReal.ofReal_ne_top
  have hmemBase : MemLp F (ENNReal.ofReal a) (chaosSampleLaw M).toMeasure := by
    apply (integrable_norm_rpow_iff hFmeas.aestronglyMeasurable hp0 hptop).mp
    refine hplusInt.congr (Filter.Eventually.of_forall fun omega => ?_)
    show F omega ^ a = ‖F omega‖ ^ (ENNReal.ofReal a).toReal
    rw [Real.norm_eq_abs, abs_of_pos (hFpos omega), ENNReal.toReal_ofReal ha1.le]
  have hmemInv : MemLp (fun omega => (F omega)⁻¹) (ENNReal.ofReal a)
      (chaosSampleLaw M).toMeasure := by
    apply (integrable_norm_rpow_iff hFmeas.inv.aestronglyMeasurable hp0 hptop).mp
    refine hminusInt.congr (Filter.Eventually.of_forall fun omega => ?_)
    show F omega ^ (-a) = ‖(F omega)⁻¹‖ ^ (ENNReal.ofReal a).toReal
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr (hFpos omega)), ENNReal.toReal_ofReal ha1.le,
      Real.inv_rpow (hFpos omega).le, ← Real.rpow_neg (hFpos omega).le]
  refine ⟨?_, hsumBound, ?_, ?_⟩
  · exact hplusInt.add hminusInt
  · exact hmemBase
  · exact hmemInv

theorem aux_lem_band_des3_osc0
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (q : ℝ) (hq : 1 ≤ q) :
    ∃ Cosc : ℝ, 0 < Cosc ∧
      ∀ delta0 : ℝ, 0 < delta0 → delta0 ≤ 1 →
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d),
        M.delta ≤ delta0 →
        let P := (chaosSampleLaw M).toMeasure
        let K : Set (SpatialCoordinates d) := {x | ∀ i, 0 ≤ x i ∧ x i ≤ 1}
        let R : ℕ → ℝ := fun k => (3 : ℝ) ^ (-(k : ℤ)) / 2
        let G0 : ℕ → BilateralField d → SpatialCoordinates d → ℝ :=
          fun k omega x => ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) x
        let oscSet0 : ℕ → BilateralField d → SpatialCoordinates d → Set ℝ :=
          fun k omega y => {v : ℝ | ∃ x ∈ Metric.closedBall y (3 * R k),
            ∃ x' ∈ Metric.closedBall y (3 * R k),
              v = |G0 k omega x - G0 k omega x'|}
        let osc0 : ℕ → BilateralField d → SpatialCoordinates d → ℝ :=
          fun k omega y => sSup (oscSet0 k omega y)
        ∀ (k : ℕ) (y : SpatialCoordinates d), y ∈ K →
          MemLp (fun omega => Real.exp (osc0 k omega y))
              (ENNReal.ofReal (2 * q)) P ∧
        eLpNorm (fun omega => Real.exp (osc0 k omega y))
              (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal Cosc := by
  classical
  obtain ⟨m, hm, hLayer⟩ := aux_lane4_reference_oscillation_moments_layer_exp hd
  set Cosc : ℝ :=
    (2 * Real.exp ((((3 / 2 : ℝ) * (m : ℝ)) * q) ^ 2)) ^ (1 / (2 * q)) with hCosc_def
  have hCoscpos : 0 < Cosc := by rw [hCosc_def]; positivity
  refine ⟨Cosc, hCoscpos, ?_⟩
  intro delta0 hdelta0pos hdelta0le M hMd
  dsimp only
  intro k y hy
  set r : ℝ := 3 * ((3 : ℝ) ^ (-(k : ℤ)) / 2) with hr_def
  have hr : 0 < r := by rw [hr_def]; positivity
  set P : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure with hP_def
  set G0 : BilateralField d → SpatialCoordinates d → ℝ :=
