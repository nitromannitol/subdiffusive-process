def aux_lem_band_h0_cellMap (m : ℤ) (w : SpatialCoordinates d) :
    C(SpatialCoordinates d, SpatialCoordinates d) :=
  ⟨cubeDilation w 0 ((3 : ℝ) ^ (-m)), continuous_cubeDilation w 0 _⟩

theorem aux_lem_band_h0_cellMap_apply (m : ℤ) (w y : SpatialCoordinates d) :
    aux_lem_band_h0_cellMap m w y = w + (3 : ℝ) ^ (-m) • y := by
  funext i
  simp [aux_lem_band_h0_cellMap, cubeDilation_apply]

def aux_lem_band_h0_S (m : ℤ) (w : SpatialCoordinates d) (om : BilateralField d) :
    BilateralField d :=
  fun j => (om (j - m)).comp (aux_lem_band_h0_cellMap m w)

theorem aux_lem_band_h0_S_apply (m : ℤ) (w : SpatialCoordinates d) (om : BilateralField d)
    (i : ℤ) (y : SpatialCoordinates d) :
    aux_lem_band_h0_S m w om i y = om (i - m) (w + (3 : ℝ) ^ (-m) • y) := by
  simp only [aux_lem_band_h0_S, ContinuousMap.comp_apply, aux_lem_band_h0_cellMap_apply]

def aux_lem_band_h0_ret (m : ℤ) (f : ℤ → ℝ) : ℝ :=
  if 0 ≤ m then ∑ j ∈ Finset.Ico (0 : ℤ) m, f (-j) else -∑ j ∈ Finset.Ico m (0 : ℤ), f (-j)

def aux_lem_band_h0_retained (n : ℤ) (z : SpatialCoordinates d) (om : BilateralField d) : ℝ :=
  aux_lem_band_h0_ret n (fun j => om j z)

theorem aux_lem_band_h0_sum_range_shift (G : ℤ → ℝ) (a : ℤ) (t : ℕ) :
    ∑ k ∈ Finset.range t, G (a + k) = ∑ j ∈ Finset.Ico a (a + t), G j := by
  refine Finset.sum_nbij' (fun k : ℕ => a + (k : ℤ)) (fun j : ℤ => (j - a).toNat) ?_ ?_ ?_ ?_ ?_
  · intro k hk; simp only [Finset.mem_range] at hk
    simp only [Finset.mem_Ico]; omega
  · intro j hj; simp only [Finset.mem_Ico] at hj
    simp only [Finset.mem_range]; omega
  · intro k _; simp
  · intro j hj; simp only [Finset.mem_Ico] at hj; omega
  · intro k _; rfl

theorem aux_lem_band_h0_potential_sum (f : ℤ → ℝ) (N : ℕ) (m : ℤ) (hm : m ≤ (N : ℤ)) :
    ∑ j ∈ Finset.range (N + 1), f (-(Int.ofNat j)) =
      ∑ k ∈ Finset.range (((N : ℤ) - m).toNat + 1), f (-(Int.ofNat k) - m) +
        aux_lem_band_h0_ret m f := by
  have hL : ∑ j ∈ Finset.range (N + 1), f (-(Int.ofNat j)) =
      ∑ j ∈ Finset.Ico (0 : ℤ) ((N : ℤ) + 1), f (-j) := by
    have := aux_lem_band_h0_sum_range_shift (fun j => f (-j)) 0 (N + 1)
    simpa using this
  have hR : ∑ k ∈ Finset.range (((N : ℤ) - m).toNat + 1), f (-(Int.ofNat k) - m) =
      ∑ j ∈ Finset.Ico m ((N : ℤ) + 1), f (-j) := by
    have h1 := aux_lem_band_h0_sum_range_shift (fun j => f (-j)) m (((N : ℤ) - m).toNat + 1)
    have h2 : m + ((((N : ℤ) - m).toNat + 1 : ℕ) : ℤ) = (N : ℤ) + 1 := by omega
    rw [h2] at h1
    rw [← h1]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    congr 1; simp; ring
  rw [hL, hR]
  unfold aux_lem_band_h0_ret
  by_cases h0 : 0 ≤ m
  · rw [if_pos h0]
    have hU : Finset.Ico (0 : ℤ) ((N : ℤ) + 1) =
        Finset.Ico (0 : ℤ) m ∪ Finset.Ico m ((N : ℤ) + 1) := by
      ext x; simp only [Finset.mem_Ico, Finset.mem_union]; omega
    have hD : Disjoint (Finset.Ico (0 : ℤ) m) (Finset.Ico m ((N : ℤ) + 1)) :=
      Finset.disjoint_left.2 (by intro x hx hx'; simp only [Finset.mem_Ico] at hx hx'; omega)
    rw [hU, Finset.sum_union hD]; ring
  · rw [if_neg h0]
    have hU : Finset.Ico m ((N : ℤ) + 1) =
        Finset.Ico m (0 : ℤ) ∪ Finset.Ico (0 : ℤ) ((N : ℤ) + 1) := by
      ext x; simp only [Finset.mem_Ico, Finset.mem_union]; omega
    have hD : Disjoint (Finset.Ico m (0 : ℤ)) (Finset.Ico (0 : ℤ) ((N : ℤ) + 1)) :=
      Finset.disjoint_left.2 (by intro x hx hx'; simp only [Finset.mem_Ico] at hx hx'; omega)
    rw [hU, Finset.sum_union hD]; ring

def aux_lem_band_h0_kappa (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (J : ℕ) : ℝ :=
  Real.exp (((J : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) * SubdiffusiveProcess.CoarseGrainingVocab.ahom M J

theorem aux_lem_band_h0_kappa_pos (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (J : ℕ) :
    0 < aux_lem_band_h0_kappa M J :=
  mul_pos (Real.exp_pos _) (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M J)

theorem aux_lem_band_h0_coefficient
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (m : ℤ) (w : SpatialCoordinates d)
    (N : ℕ) (hm : m ≤ (N : ℤ)) (om : BilateralField d) (y : SpatialCoordinates d) :
    cutoffCoefficient M (fun _ => 0) om N (w + (3 : ℝ) ^ (-m) • y) =
      (aux_lem_band_h0_kappa M (((N : ℤ) - m).toNat) / aux_lem_band_h0_kappa M N *
          Real.exp (aux_lem_band_h0_retained m (w + (3 : ℝ) ^ (-m) • y) om)) *
        cutoffCoefficient M (fun _ => 0) (aux_lem_band_h0_S m w om) (((N : ℤ) - m).toNat) y := by
  set x := w + (3 : ℝ) ^ (-m) • y with hx
  set K := ((N : ℤ) - m).toNat with hKdef
  have hSk : ∀ k : ℕ, (aux_lem_band_h0_S m w om) (-(Int.ofNat k)) y = om (-(Int.ofNat k) - m) x :=
    fun k => aux_lem_band_h0_S_apply m w om (-(Int.ofNat k)) y
  have hshift := aux_lem_band_h0_potential_sum (fun j => om j x) N m hm
  have hpsum : ∑ k ∈ Finset.range (K + 1), (aux_lem_band_h0_S m w om) (-(Int.ofNat k)) y =
      ∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) x - aux_lem_band_h0_retained m x om := by
    rw [show (∑ k ∈ Finset.range (K + 1), (aux_lem_band_h0_S m w om) (-(Int.ofNat k)) y) =
        ∑ k ∈ Finset.range (K + 1), om (-(Int.ofNat k) - m) x from
      Finset.sum_congr rfl (fun k _ => hSk k)]
    have hret : aux_lem_band_h0_ret m (fun j => om j x) = aux_lem_band_h0_retained m x om := rfl
    rw [hret] at hshift
    linarith [hshift]
  have hpotL : cutoffPotential (fun _ => 0) om N x =
      ∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) x := by
    simp only [cutoffPotential, ContinuousMap.zero_apply, zero_add]
  have hpotR : cutoffPotential (fun _ => 0) (aux_lem_band_h0_S m w om) K y =
      ∑ k ∈ Finset.range (K + 1), (aux_lem_band_h0_S m w om) (-(Int.ofNat k)) y := by
    simp only [cutoffPotential, ContinuousMap.zero_apply, zero_add]
  have hpot : cutoffPotential (fun _ => 0) om N x =
      cutoffPotential (fun _ => 0) (aux_lem_band_h0_S m w om) K y +
        aux_lem_band_h0_retained m x om := by
    rw [hpotL, hpotR, hpsum]; ring
  have hposK : 0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M K := SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M K
  have hposN : 0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M N
  have hne1 : SubdiffusiveProcess.CoarseGrainingVocab.ahom M N ≠ 0 := hposN.ne'
  have hne2 : SubdiffusiveProcess.CoarseGrainingVocab.ahom M K ≠ 0 := hposK.ne'
  have hL1 : cutoffCoefficient M (fun _ => 0) om N x *
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
      Real.exp (((N : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) =
      Real.exp (cutoffPotential (fun _ => 0) om N x) := by
    unfold cutoffCoefficient
    rw [Real.exp_sub]
    field_simp
  have hR1 : cutoffCoefficient M (fun _ => 0) (aux_lem_band_h0_S m w om) K y *
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M K *
      Real.exp (((K : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) =
      Real.exp (cutoffPotential (fun _ => 0) (aux_lem_band_h0_S m w om) K y) := by
    unfold cutoffCoefficient
    rw [Real.exp_sub]
    field_simp
  have hexppot : Real.exp (cutoffPotential (fun _ => 0) om N x) =
      Real.exp (cutoffPotential (fun _ => 0) (aux_lem_band_h0_S m w om) K y) *
        Real.exp (aux_lem_band_h0_retained m x om) := by
    rw [hpot, ← Real.exp_add]
  have hcombine : cutoffCoefficient M (fun _ => 0) om N x *
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
      Real.exp (((N : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) =
      (cutoffCoefficient M (fun _ => 0) (aux_lem_band_h0_S m w om) K y *
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M K *
          Real.exp (((K : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P)) *
        Real.exp (aux_lem_band_h0_retained m x om) := by
    rw [hL1, hR1, hexppot]
  unfold aux_lem_band_h0_kappa
  have hexpN : Real.exp (((N : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) ≠ 0 :=
    (Real.exp_pos _).ne'
  rw [div_mul_eq_mul_div, div_mul_eq_mul_div, eq_div_iff (mul_ne_zero hexpN hne1)]
  linear_combination hcombine

