theorem aux_lem_band_des3_rr_stat {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (t t1 q CD CE CK aRate_max Bst a : ℝ) (hq : 1 ≤ q) (ha0 : 0 ≤ a) (ha : a ≤ aRate_max)
