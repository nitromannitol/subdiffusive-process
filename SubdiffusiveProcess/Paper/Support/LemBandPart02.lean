    intro N
    obtain ⟨hlip, hmlow_pos, hbound⟩ := hom N
    have hApos : 0 < cutoffCoefficient M (fun _ => 0) om N z := by
      have hahom : 0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M N
