      p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4 := by positivity
  have hlog24 : Real.log 2 ≤ Real.log 4 := Real.log_le_log (by norm_num) (by norm_num)
  have hA : Real.log 2 / p ≤ Real.log 4 / p := by gcongr
  have hstep1 : (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4) *
      M.delta ^ 2 * (((m - 1 : ℕ) : ℝ) + 1) ≤
