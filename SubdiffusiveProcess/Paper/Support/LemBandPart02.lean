          (affineNeumannLoad pvec).comp (subspaceGradient (meanZeroSobolevGraph Q))
        let Leps : ℝ → S.space →L[ℝ] ℝ := fun eps =>
          (sobolevVolumeLoad (fL2 eps)).comp S.space.subtypeL
        let P : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
        let aN : ℕ → BilateralField d → PositiveCoefficient Q := fun N om =>
          cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ => (1 / 2 : ℝ)) one_pos
        let yN : ℕ → BilateralField d → ℝ := fun N om => inverseResponse S (aN N om) L0
        let yeps : ℝ → ℕ → BilateralField d → ℝ := fun eps N om =>
          inverseResponse S (aN N om) (Leps eps)
        let ueps : ℝ → ℕ → BilateralField d → S.space := fun eps N om =>
          responseSolution S (aN N om) (Leps eps)
        ∀ (N : ℕ) (eps : ℝ), (0 < eps ∧ eps < 1 / 8) →
          MemLp (yeps eps N) (ENNReal.ofReal (3 * p)) P ∧
            eLpNorm (yeps eps N) (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal B := by
  obtain ⟨δ0, hδ0, Cb, hCb, Cy, hCy, hbank⟩ :=
    aux_lem_band_des3_h0_neumann_bank d hd I _Poincare _Sobolev rho hrho hrho0 hrhos hrhoi pvec hpvec
  have h3p : (1 : ℝ) ≤ 3 * p := by linarith
  refine ⟨δ0 (3 * p), Cy * Cb (3 * p), hδ0 _ h3p, mul_nonneg hCy (hCb _ h3p), ?_⟩
  intro M hM Rm _hRm Q S L0 Leps P aN yN yeps ueps N eps heps
  obtain ⟨Kc, hKc, hKmom, -, hys⟩ := hbank M Rm hP
  have hmeas : AEStronglyMeasurable (yeps eps N) P :=
    (aux_lem_band_des3_h0_inverseResponse_measurable M N S (Leps eps)).aestronglyMeasurable
  exact aux_rem_bank_response_moments_memLp_of_envelope P (yeps eps N) (Kc N) Cy (Cb (3 * p)) hCy
    (ENNReal.ofReal (3 * p)) hmeas (hKmom _ h3p hM N).1 (hKmom _ h3p hM N).2
    (Filter.Eventually.of_forall fun om => ⟨inverseResponse_nonneg _ _ _, (hKc N om).1,
      (hys eps heps.1 heps.2 (fL2 eps) (hfL2 eps heps) N om).trans_eq (mul_comm _ _)⟩)

theorem aux_lem_band_rcJ_neumann_H0_error
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (_Poincare : Paper.in_poincare d hd I)
    (_Extension : Paper.in_extension d hd I) (_Perturbation : Lane4.SmallPerturbationInput d)
    (_Sobolev : Lane4.SobolevFoundationalInput d hd)
    (D : Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (rho : ℝ → ℝ) (hrho : ContDiff ℝ ∞ rho) (hrho0 : ∀ tau, 0 ≤ rho tau)
    (hrhos : ∀ tau, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) (hrhoi : (∫ tau, rho tau) = 1)
    (pvec : Fin d → ℝ) (hpvec : (∑ i : Fin d, (pvec i) ^ 2) = 1)
    (hP : ∃ Kp : ℝ≥0, ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖)
    (fL2 : ℝ → DomainL2 (unitNeumannCube d))
    (hfL2 : ∀ eps : ℝ, (0 < eps ∧ eps < 1 / 8) →
      ((fL2 eps : SpatialCoordinates d → ℝ) =ᵐ[
        volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))]
        faceBump rho pvec eps))
    (t p : ℝ) (ht0 : (d : ℝ) - 1 < t) (ht1 : t < (d : ℝ)) (hp : 2 ≤ p) :
    ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 ≤ B ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : Paper.in_responses d M), Rm.C ≤ Cresp →
        let Q := unitNeumannCube d
        let S := meanZeroResponseSpace hP
        let L0 : S.space →L[ℝ] ℝ :=
          (affineNeumannLoad pvec).comp (subspaceGradient (meanZeroSobolevGraph Q))
        let Leps : ℝ → S.space →L[ℝ] ℝ := fun eps =>
          (sobolevVolumeLoad (fL2 eps)).comp S.space.subtypeL
        let P : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
        let aN : ℕ → BilateralField d → PositiveCoefficient Q := fun N om =>
          cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ => (1 / 2 : ℝ)) one_pos
        let yN : ℕ → BilateralField d → ℝ := fun N om => inverseResponse S (aN N om) L0
        let yeps : ℝ → ℕ → BilateralField d → ℝ := fun eps N om =>
          inverseResponse S (aN N om) (Leps eps)
        let ueps : ℝ → ℕ → BilateralField d → S.space := fun eps N om =>
          responseSolution S (aN N om) (Leps eps)
        ∀ (N : ℕ) (eps : ℝ), (0 < eps ∧ eps < 1 / 8) →
          eLpNorm (fun om => yN N om - yeps eps N om) (ENNReal.ofReal p) P ≤
            ENNReal.ofReal (B * eps ^ (1 / 4 : ℝ)) := by
  obtain ⟨δ0, hδ0, Cb, hCb, Cy, hCy, hbank⟩ :=
    aux_lem_band_des3_h0_neumann_bank d hd I _Poincare _Sobolev rho hrho hrho0 hrhos hrhoi pvec hpvec
  obtain ⟨Cload, hCload, hload⟩ := lem_neumann_error_load_bound d hd _Sobolev
  have hp1 : (1 : ℝ) ≤ p := by linarith
  have h4p : (1 : ℝ) ≤ 4 * p := by linarith
  obtain ⟨Cerr, Cunif, hCerr, -, hA⟩ := lem_neumann_error_moment_assembly p (Cb (4 * p))
    (Cy * Cb (4 * p)) (8 * Cload) hp1 (hCb _ h4p) (mul_nonneg hCy (hCb _ h4p)) (by positivity)
  refine ⟨δ0 (4 * p), Cerr, hδ0 _ h4p, hCerr.le, ?_⟩
  intro M hM Rm _hRm Q S L0 Leps P aN yN yeps ueps N eps heps
  obtain ⟨Kc, hKc, hKmom, hyN, -⟩ := hbank M Rm hP
  have hdirect := aux_lem_neumann_error_all_pointwise hd hP (fun om => aN N om) L0
    (fun _ => Leps eps) (Kc N) Cload eps hCload heps.1 heps.2 (fun x v => (hKc N x).2 v)
    (fun x z => hload rho hrho hrho0 hrhos hrhoi pvec hpvec eps heps.1 heps.2
      (fun _ _ => fL2 eps) (fun _ _ => hfL2 eps heps) N x z)
  have hYmeas : AEStronglyMeasurable (yN N) P :=
    (aux_lem_band_des3_h0_inverseResponse_measurable M N S L0).aestronglyMeasurable
  have hVmeas : AEStronglyMeasurable (yeps eps N) P :=
    (aux_lem_band_des3_h0_inverseResponse_measurable M N S (Leps eps)).aestronglyMeasurable
  have hY := aux_rem_bank_response_moments_memLp_of_envelope P (yN N) (Kc N) Cy (Cb (4 * p)) hCy
    (ENNReal.ofReal (4 * p)) hYmeas (hKmom _ h4p hM N).1 (hKmom _ h4p hM N).2
    (Filter.Eventually.of_forall fun om => ⟨inverseResponse_nonneg _ _ _, (hKc N om).1,
      (hyN N om).trans_eq (mul_comm _ _)⟩)
  have hY2 : eLpNorm (yN N) (ENNReal.ofReal (4 * p)) P ≤ ENNReal.ofReal (Cy * Cb (4 * p)) := hY.2
  have hasm := hA (BilateralField d) P eps heps.1 heps.2 (Kc N) (yN N) (yeps eps N)
    (fun om => yN N om - yeps eps N om) (fun x => (hKc N x).1)
    (fun x => inverseResponse_nonneg _ _ _) (fun x => inverseResponse_nonneg _ _ _)
    (fun x => (hdirect x).2.2.1) (fun x => (hdirect x).2.2.2) (hYmeas.sub hVmeas) hVmeas
    (hKmom _ h4p hM N).1 (hKmom _ h4p hM N).2 hY.1 hY2
  exact hasm.1

