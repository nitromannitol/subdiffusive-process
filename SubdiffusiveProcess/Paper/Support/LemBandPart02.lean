            Cmic * ((1 + DN) ^ t * eps ^ (t1 - t) * Kmac +
              mN⁻¹ * Kf ^ 2 * eps ^ ((d : ℝ) + 2 - t)) * r ^ t)
    (hstat : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P],
