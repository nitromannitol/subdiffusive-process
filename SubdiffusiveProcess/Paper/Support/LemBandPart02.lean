    norm_num
  have hRstar_mem : Rstar ∈ Set.range (fun k : ℤ => (3 : ℝ) ^ k / 2) := ⟨-7, hRstar_def⟩
  have hetapos : 0 < eta := heta_pos
  have hetas_pos : 0 < etas := by rw [hetas_def]; linarith
  have hetas_lt : etas < (d : ℝ) + 2 - t0 := by rw [hetas_def]; linarith
  have hq_ge : p ≤ q := by rw [hq_def]; exact le_max_left _ _
