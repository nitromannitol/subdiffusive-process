theorem aux_lem_band_des3_geom0 {d : ℕ} (g : Homogenization.Vec d → ℝ) (hg : Continuous g)
    (hgpos : ∀ u, 0 < g u)
    (A : Homogenization.Book.Ch02.CoeffOn
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)))
    (hA : A.toCoeffField =ᵐ[Homogenization.volumeMeasureOn
      (Homogenization.openCubeSet (Homogenization.originCube d 0))]
      (fun u => Homogenization.scalarMatrix (g u)))
    (a : Homogenization.Vec d → ℝ) (ha : ∀ z, a z = g (z - fun _ => (1 / 2 : ℝ)))
    (datac : SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData (aux_lem_band_des3_unitDomain d) a)
    (p q : Homogenization.Vec d) :
    Homogenization.Book.Ch02.responseJ
        (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A p q =
      Homogenization.Book.Ch02.responseJ (aux_lem_band_des3_unitDomain d) datac.toCoeffOn p q := by
  let data0 := Classical.choice
    (SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos hg
      hgpos (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)))
  have hc0 : Homogenization.cubeCenter (Homogenization.originCube d 0) = 0 := by
    funext i; simp [Homogenization.cubeCenter, Homogenization.originCube]
  have hBe : data0.toCoeffOn.toCoeffField =ᵐ[Homogenization.volumeMeasureOn
      (Homogenization.openCubeSet (Homogenization.originCube d 0))]
      (fun y => Homogenization.scalarMatrix (g (Homogenization.cubeCenter
        (Homogenization.originCube d 0) +
          Homogenization.cubeScaleFactor (Homogenization.originCube d 0) • y))) := by
    have h0 : Homogenization.cubeScaleFactor (Homogenization.originCube d 0) = 1 := by
      simpa using Homogenization.cubeScaleFactor_originCube (d := d) (0 : ℤ)
    rw [hc0, h0]
    refine Filter.Eventually.of_forall (fun y => ?_)
    show Homogenization.scalarMatrix (g y) = Homogenization.scalarMatrix (g (0 + (1 : ℝ) • y))
    rw [one_smul, zero_add]
  have h1 := aux_rechart_responseJ_eq A data0.toCoeffOn
    (fun u => Homogenization.scalarMatrix (g u)) hA hBe p q
  rw [h1, Homogenization.Internal.Ch02.book_responseJ_eq_ResponseJ,
    Homogenization.Internal.Ch02.book_responseJ_eq_ResponseJ]
  have hF : data0.toCoeffOn.toCoeffField =
      Homogenization.translateCoeffField (fun _ : Fin d => (1 / 2 : ℝ))
        datac.toCoeffOn.toCoeffField := by
    funext y
    show Homogenization.scalarMatrix (g y) =
      Homogenization.scalarMatrix (a (fun i => y i + (fun _ : Fin d => (1 / 2 : ℝ)) i))
    rw [ha]
    congr 2
    funext i
    simp
  rw [hF, ← Homogenization.ResponseJ_translateSet_eq_translateCoeffField]
  congr 1
  rw [Homogenization.Book.Ch02.cubeDomain_coe]
  exact (aux_lem_band_des3_unit_set d).symm

theorem aux_lem_band_des3_RD_unit_le_J {d : ℕ} [NeZero d] (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (N : ℕ)
    (om : BilateralField d)
    (hΩ : Bornology.IsBounded (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
          Set (SpatialCoordinates d)))
    (hP : ∃ K : ℝ≥0, ∀ w : killedSobolevGraph
          (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos),
        ‖(w : SobolevData (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)).1‖ ≤
          K * ‖subspaceGradient (killedSobolevGraph
            (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)) w‖)
    (e : Fin d → ℝ) (he1 : (∑ i : Fin d, (e i) ^ 2) = 1)
    (A : Homogenization.Book.Ch02.CoeffOn
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)))
    (hA : ∀ᵐ x ∂volume.restrict (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      A.toCoeffField x = Homogenization.scalarMatrix (cutoffCoefficient M (fun _ => 0)
        (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om) N x))
    (J : ℝ) (hJ : IsGreatest {v : ℝ | ∃ e : Fin d → ℝ, (∑ i : Fin d, e i ^ 2) = 1 ∧
      v = Homogenization.Book.Ch02.responseJ
        (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A e e} J) :
    affineDirichletResponse hΩ hP
        (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) e ≤
      2 * (J + 1) := by
  have hN := (exists_killed_meanZero_poincare_of_isOpenBoundedConvexDomain _
    (aux_lem_band_des3_unit_isDomain d)).2
  have hvol : 0 < volume.real (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
      Set (SpatialCoordinates d)) := aux_lem_band_des3_unit_vol_pos d
  have hvol1 : volume.real (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
      Set (SpatialCoordinates d)) = 1 := aux_lem_band_des3_unit_vol d
  have hgc := aux_aux_macro_energy_recurrence_cutoffCoefficient_continuous M (fun _ => 0)
    (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om) N
  have hgpos := aux_aux_macro_energy_recurrence_cutoffCoefficient_pos M (fun _ => 0)
    (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om) N
  have hafc := aux_aux_macro_energy_recurrence_cutoffCoefficient_continuous M (fun _ => 0) om N
  have hafpos := aux_aux_macro_energy_recurrence_cutoffCoefficient_pos M (fun _ => 0) om N
  have haf : ∀ z, cutoffCoefficient M (fun _ => 0) om N z =
      cutoffCoefficient M (fun _ => 0)
        (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om) N
        (z - fun _ => (1 / 2 : ℝ)) := by
    intro z
    simp only [cutoffCoefficient, cutoffPotential, ContinuousMap.zero_apply,
      aux_lem_extension_cell_moment_zoom_apply, neg_zero, zpow_zero, one_smul, sub_zero,
      sub_add_cancel]
  let datac := Classical.choice
    (SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos hafc
      hafpos (aux_lem_band_des3_unitDomain d))
  have haQ : (((cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ))
        one_pos).val : SpatialCoordinates d → ℝ)
      =ᵐ[volume.restrict (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
          Set (SpatialCoordinates d))]
        fun x => cutoffCoefficient M (fun _ => 0) om N x / 1) := by
    filter_upwards [aux_prop_growth_macro_energy_coeff_ae M (fun _ => 0) om N
      (fun _ : Fin d => (1 / 2 : ℝ)) one_pos] with x hx
    rw [hx, div_one]
  have hvn : Homogenization.vecNormSq e = 1 := by
    rw [Homogenization.vecNormSq, Homogenization.vecDot, ← he1]
    exact Finset.sum_congr rfl fun i _ => (sq (e i)).symm
  have hbridge := responseJ_eq_affineDiagonalDefect (aux_lem_band_des3_unitDomain d)
    (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos) rfl one_pos datac hΩ hvol hP hN
    _ haQ e hvn
  rw [Real.sqrt_one, inv_one, one_smul] at hbridge
  have hgeom := aux_lem_band_des3_geom0 _ hgc hgpos A hA _ haf datac e e
  have hJe := hJ.2 ⟨e, he1, rfl⟩
  have hdef := (hgeom.trans hbridge).symm.le.trans hJe
  have hRN : 0 ≤ affineInverseNeumannResponse hN
      (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) e :=
    inverseResponse_nonneg _ _ _
  unfold affineDiagonalDefect at hdef
  rw [hvol1, he1, mul_one] at hdef
  change (affineDirichletResponse hΩ hP (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) e +
    affineInverseNeumannResponse hN (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) e) / 2 - 1 ≤ J at hdef
  linarith only [hdef, hRN]

theorem aux_lem_band_des3_slope_normalize {d : ℕ} (u : Fin d → ℝ) (hu : (∑ i : Fin d, (u i) ^ 2) ≠ 0) :
    ∃ (s : ℝ) (e : Fin d → ℝ), 0 < s ∧ s ^ 2 = ∑ i : Fin d, (u i) ^ 2 ∧ u = s • e ∧
      (∑ i : Fin d, (e i) ^ 2) = 1 := by
  have hs0 : 0 < ∑ i : Fin d, (u i) ^ 2 :=
    lt_of_le_of_ne (Finset.sum_nonneg fun i _ => sq_nonneg _) (Ne.symm hu)
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = Real.sqrt (∑ i : Fin d, (u i) ^ 2) := ⟨_, rfl⟩
  have hspos : 0 < s := by rw [hsdef]; exact Real.sqrt_pos.2 hs0
  have hs2 : s ^ 2 = ∑ i : Fin d, (u i) ^ 2 := by rw [hsdef]; exact Real.sq_sqrt hs0.le
  refine ⟨s, s⁻¹ • u, hspos, hs2, ?_, ?_⟩
  · rw [smul_smul, mul_inv_cancel₀ hspos.ne', one_smul]
  · have h : ∀ i, ((s⁻¹ • u) i) ^ 2 = s⁻¹ ^ 2 * (u i) ^ 2 := by
      intro i; rw [Pi.smul_apply, smul_eq_mul, mul_pow]
    simp only [h, ← Finset.mul_sum, ← hs2, inv_pow]
    exact inv_mul_cancel₀ (by positivity)

theorem aux_lem_band_des3_RD_le_J {d : ℕ} [NeZero d] (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (N : ℕ)
    (om : BilateralField d)
    (hΩ : Bornology.IsBounded (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
          Set (SpatialCoordinates d)))
    (hP : ∃ K : ℝ≥0, ∀ w : killedSobolevGraph
          (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos),
        ‖(w : SobolevData (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)).1‖ ≤
          K * ‖subspaceGradient (killedSobolevGraph
            (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)) w‖)
    (u : Fin d → ℝ)
    (A : Homogenization.Book.Ch02.CoeffOn
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)))
    (hA : ∀ᵐ x ∂volume.restrict (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      A.toCoeffField x = Homogenization.scalarMatrix (cutoffCoefficient M (fun _ => 0)
        (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om) N x))
    (J : ℝ) (hJ : IsGreatest {v : ℝ | ∃ e : Fin d → ℝ, (∑ i : Fin d, e i ^ 2) = 1 ∧
      v = Homogenization.Book.Ch02.responseJ
        (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A e e} J) :
    dirichletResponse (killedResponseSpace hP)
        (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
        (affineSobolev hΩ u 0) ≤ 2 * (J + 1) * ∑ i : Fin d, (u i) ^ 2 := by
  by_cases hu : ∑ i : Fin d, (u i) ^ 2 = 0
  · have h := affineDirichletResponse_le_affine_energy hΩ hP
      (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) u
    rw [hu, zero_mul] at h
    rw [hu, mul_zero]
    exact h
  · obtain ⟨s, e, hspos, hs2, hue, he1⟩ := aux_lem_band_des3_slope_normalize u hu
    have hle := aux_lem_band_des3_RD_unit_le_J M N om hΩ hP e he1 A hA J hJ
    rw [← hs2]
    subst hue
    have hsm := affineDirichletResponse_smulSlope hΩ hP hspos.ne'
      (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) e
    change affineDirichletResponse hΩ hP _ (s • e) ≤ _
    rw [hsm]
    have hs2p : 0 ≤ s ^ 2 := sq_nonneg s
    calc s ^ 2 * affineDirichletResponse hΩ hP _ e ≤ s ^ 2 * (2 * (J + 1)) :=
          mul_le_mul_of_nonneg_left hle hs2p
      _ = 2 * (J + 1) * s ^ 2 := by ring

theorem aux_lem_band_des3_affine_moment {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (q : ℝ) (hq : 1 ≤ q) (X : Ω → ℝ) (hX : AEStronglyMeasurable X P)
    (C a : ℝ) (hC : eLpNorm X (ENNReal.ofReal q) P ≤ ENNReal.ofReal C) (hC0 : 0 ≤ C) (ha : 0 ≤ a) :
    eLpNorm (fun om => 2 * (X om + 1) * a) (ENNReal.ofReal q) P ≤
      ENNReal.ofReal (2 * (C + 1) * a) := by
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := by simpa using ENNReal.ofReal_le_ofReal hq
  have hq0 : ENNReal.ofReal q ≠ 0 := by
    rw [Ne, ENNReal.ofReal_eq_zero]; linarith
  have h1 : eLpNorm (fun _ : Ω => (1 : ℝ)) (ENNReal.ofReal q) P = 1 := by
    rw [eLpNorm_const _ hq0 (NeZero.ne P)]
    simp
  have hsum : eLpNorm (fun om => X om + 1) (ENNReal.ofReal q) P ≤ ENNReal.ofReal (C + 1) := by
    calc eLpNorm (fun om => X om + 1) (ENNReal.ofReal q) P
        ≤ eLpNorm X (ENNReal.ofReal q) P + eLpNorm (fun _ : Ω => (1 : ℝ)) (ENNReal.ofReal q) P :=
          eLpNorm_add_le hq1
      _ ≤ ENNReal.ofReal C + 1 := by rw [h1]; gcongr
      _ = ENNReal.ofReal (C + 1) := by
          rw [ENNReal.ofReal_add hC0 zero_le_one, ENNReal.ofReal_one]
  have h2a : 0 ≤ 2 * a := by positivity
  calc eLpNorm (fun om => 2 * (X om + 1) * a) (ENNReal.ofReal q) P
      = eLpNorm ((2 * a) • fun om => X om + 1) (ENNReal.ofReal q) P := by
        congr 1; funext om; simp only [Pi.smul_apply, smul_eq_mul]; ring
    _ ≤ ‖2 * a‖ₑ * eLpNorm (fun om => X om + 1) (ENNReal.ofReal q) P := eLpNorm_const_smul_le
    _ ≤ ‖2 * a‖ₑ * ENNReal.ofReal (C + 1) := by gcongr
    _ = ENNReal.ofReal (2 * (C + 1) * a) := by
        rw [Real.enorm_eq_ofReal h2a, ← ENNReal.ofReal_mul h2a]
        congr 1; ring

