  have hrmax : 0 < min (t1 - t) (min ((d : ℝ) + 2 - t) ((d : ℝ) - t)) * Real.log 3 :=
    mul_pos (lt_min (by linarith only [htt1]) (lt_min (by linarith only [hdt]) hdt)) hlog3
  have hh4 := aux_prop_growth_energy_assembly_threshold Cde Cpe _ 1 (cde / (2 * q * max 1 t)) hCde hCpe hrmax one_pos (div_pos hcde (by linarith only [hq1]))
