  have hsplit : ((2 / r) ^ t * Kmacv + aux_prop_growth_energy_assembly_Cr d r t t1 C * Zs) *
      (Kf + Cphi) ^ 2 * rad ^ t =
      (2 / r) ^ t * Kmacv * (Kf + Cphi) ^ 2 * rad ^ t +
        aux_prop_growth_energy_assembly_Cr d r t t1 C * Zs * (Kf + Cphi) ^ 2 * rad ^ t := by
    ring
  change L rad ≤ _
