    show Real.exp (‖((fun _ => (0 : C(SpatialCoordinates d, ℝ))) om).restrict
        (K : Set (SpatialCoordinates d))‖ +
      aux_lem_extension_cell_moment_physicalLogNorm M N ((3 : ℝ) ^ N • g) om) = _
    rw [hzero om, zero_add, one_mul]
  rw [heq]
  have h := aux_lem_extension_cell_moment_physicalLogNorm_eLpNorm M N ((3 : ℝ) ^ N • g) 1 p
    (by norm_num) hp
  simpa only [one_mul, one_pow, mul_one] using h

