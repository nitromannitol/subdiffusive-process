theorem aux_lem_band_des3_h0_affine_dirichlet_moments (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (q : ℝ) (hq : 1 ≤ q) :
    ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 ≤ B ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ delta0 →
      ∀ (hΩ : Bornology.IsBounded (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
            Set (SpatialCoordinates d)))
        (hP : ∃ K : ℝ≥0, ∀ w : killedSobolevGraph
            (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos),
          ‖(w : SobolevData (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)).1‖ ≤
            K * ‖subspaceGradient (killedSobolevGraph
              (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)) w‖)
        (u : Fin d → ℝ) (N : ℕ),
        AEStronglyMeasurable (fun om : BilateralField d => dirichletResponse
            (killedResponseSpace hP)
            (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
            (affineSobolev hΩ u 0)) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (fun om : BilateralField d => dirichletResponse (killedResponseSpace hP)
            (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
            (affineSobolev hΩ u 0)) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (B * ∑ i : Fin d, (u i) ^ 2) := by
  obtain ⟨δ0, C0, hδ0, hC0, hmr⟩ := aux_lem_extension_cell_moment_matched_response hd I q hq
  refine ⟨δ0, 2 * (C0 + 1), hδ0, by positivity, ?_⟩
  intro M hM hΩ hP u N
  obtain ⟨family, J, hfam, hJg, hJm, hJn⟩ := hmr M hM
  have hmeas := aux_rem_bank_response_moments_measurable_dirichletResponse M (fun _ => 0)
    measurable_const N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos (killedResponseSpace hP)
    (affineSobolev hΩ u 0)
  refine ⟨hmeas.aestronglyMeasurable, ?_⟩
  have hT := aux_lem_extension_cell_moment_zoom_measurePreserving M 0
    (fun _ : Fin d => (1 / 2 : ℝ))
  have hSu0 : 0 ≤ ∑ i : Fin d, (u i) ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hpt : ∀ om : BilateralField d, ‖dirichletResponse (killedResponseSpace hP)
      (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
      (affineSobolev hΩ u 0)‖ ≤
      2 * (J N (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om) + 1) *
        ∑ i : Fin d, (u i) ^ 2 := by
    intro om
    rw [Real.norm_eq_abs, abs_of_nonneg (dirichletResponse_nonneg _ _ _)]
    exact aux_lem_band_des3_RD_le_J M N om hΩ hP u _
      (hfam N (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om)
        (Homogenization.originCube d 0)) _
      (hJg N (aux_lem_extension_cell_moment_zoom 0 (fun _ : Fin d => (1 / 2 : ℝ)) om))
  have hJq : eLpNorm (J N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal C0 :=
    (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith))).trans
      (hJn N)
  have hJT : eLpNorm (fun om => J N (aux_lem_extension_cell_moment_zoom 0
      (fun _ : Fin d => (1 / 2 : ℝ)) om)) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal C0 := by
    rw [show (fun om => J N (aux_lem_extension_cell_moment_zoom 0
        (fun _ : Fin d => (1 / 2 : ℝ)) om)) = J N ∘ aux_lem_extension_cell_moment_zoom 0
          (fun _ : Fin d => (1 / 2 : ℝ)) from rfl,
      eLpNorm_comp_measurePreserving (hJm N) hT]
    exact hJq
  refine (eLpNorm_mono_real hmeas.aestronglyMeasurable hpt).trans ?_
  refine (aux_lem_band_des3_affine_moment _ q hq _ ((hJm N).comp_measurePreserving hT) C0 _ hJT hC0.le
    hSu0).trans (le_of_eq ?_)
  ring_nf

def aux_lem_band_des3_Kfin (d : ℕ) (t t1 C Cφ Kmacv Dv Mxv : ℝ) (N : ℕ) : ℝ :=
  ((2 / 1) ^ t * Kmacv + aux_prop_growth_energy_assembly_Cr d 1 t t1 C *
      ((1 + Dv) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * Kmacv +
        Mxv * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t) +
        Mxv * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) * (1 + Dv) ^ t)) * (0 + Cφ) ^ 2

theorem aux_lem_band_des3_ksrc_arith (A RD Cφ : ℝ) (hA : 0 ≤ A) (hRD : 0 ≤ RD) (hCφ : 0 < Cφ) :
    A * RD ≤ A * (1 + RD / Cφ ^ 2) * (0 + Cφ) ^ 2 := by
  have hCφ2 : 0 < Cφ ^ 2 := by positivity
  have e : A * (1 + RD / Cφ ^ 2) * (0 + Cφ) ^ 2 = A * (Cφ ^ 2 + RD) := by
    field_simp
    ring
  rw [e]
  exact mul_le_mul_of_nonneg_left (by linarith) hA

theorem aux_lem_band_des3_one_le_kmac (A RD Cφ : ℝ) (hA : 1 ≤ A) (hRD : 0 ≤ RD) (hCφ : 0 < Cφ) :
    1 ≤ A * (1 + RD / Cφ ^ 2) := by
  have hV0 : 0 ≤ RD / Cφ ^ 2 := div_nonneg hRD (by positivity)
  have := mul_le_mul hA (by linarith : (1 : ℝ) ≤ 1 + RD / Cφ ^ 2) zero_le_one (by linarith)
  linarith

theorem aux_lem_band_des3_dirichlet_sample {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (Cp : ℝ) (hFE : aux_aux_macro_energy_recurrence_FE (d := d) Cp)
    (t t1 C : ℝ) (ht : (d : ℝ) - 1 < t) (htt1 : t < t1) (ht1d : t1 < (d : ℝ)) (hC : 0 < C)
    (hmic : aux_prop_growth_energy_assembly_MicroLocal d t t1 C)
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Sreg : in_6_16 d M)
    (hδ : M.delta ≤ Sreg.C⁻¹) (hα : 1 - ((d : ℝ) - t1) / 4 ∈ Sreg.alphaRange)
    (om : BilateralField d) (N : ℕ) (z : SpatialCoordinates d)
    (hΩ : Bornology.IsBounded (centeredCube z 1 one_pos : Set (SpatialCoordinates d)))
    (hP : ∃ K : ℝ≥0, ∀ w : killedSobolevGraph (centeredCube z 1 one_pos),
          ‖(w : SobolevData (centeredCube z 1 one_pos)).1‖ ≤
            K * ‖subspaceGradient (killedSobolevGraph (centeredCube z 1 one_pos)) w‖)
    (u : Fin d → ℝ) (Cφ : ℝ) (hCφ0 : 0 < Cφ)
    (hCφ : c2Norm (closedCube z 1 one_pos : Set (SpatialCoordinates d))
      (fun x : SpatialCoordinates d => affineSlope u x + 0) ≤ Cφ)
    (Dv Mxv : ℝ) (hD0 : 0 ≤ Dv) (hMx : 0 < Mxv)
    (henv : ∀ x ∈ (closedCube z 1 one_pos : Set (SpatialCoordinates d)),
      Mxv⁻¹ ≤ cutoffCoefficient M (fun _ => 0) om N x ∧ cutoffCoefficient M (fun _ => 0) om N x ≤ Mxv)
    (hlip : ∀ x y,
      x ∈ (closedCube z 1 one_pos : Set (SpatialCoordinates d)) →
      y ∈ (closedCube z 1 one_pos : Set (SpatialCoordinates d)) →
      |Real.log (cutoffCoefficient M (fun _ => 0) om N x) -
          Real.log (cutoffCoefficient M (fun _ => 0) om N y)| ≤ Dv * (3 : ℝ) ^ N * dist x y)
    (x : SpatialCoordinates d) (hx : x ∈ (centeredCube z 1 one_pos : Set (SpatialCoordinates d)))
    (rad : ℝ) (hrad0 : 0 < rad) (hrad1 : rad ≤ 1) :
    localGradientEnergy (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos)
        (s := Metric.ball x rad ∩ (centeredCube z 1 one_pos : Set (SpatialCoordinates d)))
        (isOpen_ball.measurableSet.inter (centeredCube z 1 one_pos).isOpen.measurableSet)
        (sobolevGradient (dirichletMinimizer (killedResponseSpace hP)
          (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos)
          (affineSobolev hΩ u 0) : SobolevData (centeredCube z 1 one_pos))) ≤
      aux_lem_band_des3_Kfin d t t1 C Cφ
        (aux_aux_macro_energy_recurrence_Z Sreg.C Cp t1 d *
          ((3 : ℝ) ^ (t1 * (Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N ((3 : ℝ) ^ N • z)
              (aux_aux_macro_energy_recurrence_relabel N om) : ℝ)) *
            (1 + dirichletResponse (killedResponseSpace hP)
              (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos)
              (affineSobolev hΩ u 0) / Cφ ^ 2))) Dv Mxv N * rad ^ t := by
  have hdR : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have ht0 : 0 ≤ t := by linarith
  have ht1 : (d : ℝ) - 1 < t1 := by linarith
  have ht10 : 0 < t1 := by linarith
  have hsol := aux_rem_bank_dm_solves hP (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos)
    (affineSobolev hΩ u 0)
  have hb : (((affineSobolev hΩ u 0 : weakSobolevGraph (centeredCube z 1 one_pos)) :
      SobolevData (centeredCube z 1 one_pos)).1 : SpatialCoordinates d → ℝ)
      =ᵐ[volume.restrict (centeredCube z 1 one_pos : Set (SpatialCoordinates d))]
      (fun x : SpatialCoordinates d => affineSlope u x + 0) := affineL2_coeFn hΩ u 0
  have hφ : ContDiff ℝ 2 (fun x : SpatialCoordinates d => affineSlope u x + 0) :=
    (affineSlope u).contDiff.add contDiff_const
  obtain ⟨RDv, hRDv⟩ : ∃ R : ℝ, R = dirichletResponse (killedResponseSpace hP)
      (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos) (affineSobolev hΩ u 0) := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = (3 : ℝ) ^ (t1 * (Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N
      ((3 : ℝ) ^ N • z) (aux_aux_macro_energy_recurrence_relabel N om) : ℝ)) := ⟨_, rfl⟩
  rw [← hRDv, ← hA]
  have hRD0 : 0 ≤ RDv := by rw [hRDv]; exact dirichletResponse_nonneg _ _ _
  have hA1 : 1 ≤ A := by
    rw [hA]; exact Real.one_le_rpow (by norm_num) (mul_nonneg ht10.le (Nat.cast_nonneg _))
  have hK1 := aux_lem_band_des3_one_le_kmac A RDv Cφ hA1 hRD0 hCφ0
  have hform := aux_lem_band_des3_form_dirichletMinimizer (killedResponseSpace hP)
    (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos) (affineSobolev hΩ u 0)
  rw [← hRDv] at hform
  have hKsrc : A * sobolevCoefficientForm (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos)
      ((dirichletMinimizer (killedResponseSpace hP)
          (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos) (affineSobolev hΩ u 0)).val)
      ((dirichletMinimizer (killedResponseSpace hP)
          (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos) (affineSobolev hΩ u 0)).val) ≤
      A * (1 + RDv / Cφ ^ 2) * (0 + Cφ) ^ 2 := by
    rw [hform]; exact aux_lem_band_des3_ksrc_arith A RDv Cφ (by linarith) hRD0 hCφ0
  have hmacro : ∀ (y : SpatialCoordinates d) (ρ : ℝ), y ∈ centeredCube z 1 one_pos → 0 < ρ →
      ρ ≤ 1 → (3 : ℝ) ^ (-(N : ℤ)) ≤ ρ →
      localGradientEnergy (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos)
          (s := Metric.ball y ρ ∩ (centeredCube z 1 one_pos : Set (SpatialCoordinates d)))
          (isOpen_ball.measurableSet.inter (centeredCube z 1 one_pos).isOpen.measurableSet)
          (sobolevGradient ((dirichletMinimizer (killedResponseSpace hP)
            (cutoffPositiveCoefficient M (fun _ => 0) om N z one_pos) (affineSobolev hΩ u 0)) :
              SobolevData (centeredCube z 1 one_pos))) ≤
        (aux_aux_macro_energy_recurrence_Z Sreg.C Cp t1 d * (A * (1 + RDv / Cφ ^ 2))) *
          (0 + Cφ) ^ 2 * ρ ^ t1 := by
    intro y ρ hy hρ hρ1 hρN
    subst hA
    exact (aux_lem_band_des3_h0_macro_om hd Cp hFE M Sreg t1 ht1 ht1d hδ hα om z N _ le_rfl
      _ hK1 (fun _ => 0) 0 le_rfl aemeasurable_const
      (Filter.Eventually.of_forall fun _ => by simp) _ Cφ hφ hCφ _ _ hb hsol hKsrc y ρ hy hρ
      hρ1 hρN).trans (le_of_eq (by ring))
  have hZ0 : 0 ≤ aux_aux_macro_energy_recurrence_Z Sreg.C Cp t1 d :=
    aux_aux_macro_energy_recurrence_Z_nonneg _ _ _ _
  have hK1' : 1 ≤ A * (1 + RDv / Cφ ^ 2) := aux_lem_band_des3_one_le_kmac A RDv Cφ hA1 hRD0 hCφ0
  have hK0 : 0 ≤ aux_aux_macro_energy_recurrence_Z Sreg.C Cp t1 d * (A * (1 + RDv / Cφ ^ 2)) :=
    mul_nonneg hZ0 (by linarith [hK1'])
  exact aux_lem_band_des3_physical_fixed t t1 C ht0 htt1 ht1d hC hmic M (fun _ => 0) om N z 1
    one_pos le_rfl _ Dv Mxv hK0 hD0 hMx henv hlip (fun _ => 0) 0 le_rfl aemeasurable_const
    (Filter.Eventually.of_forall fun _ => by simp) _ Cφ hφ hCφ _ _ hb hsol hmacro x rad hx hrad0
    hrad1

