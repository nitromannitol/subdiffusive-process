        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bst :=
  by
  intro N
  have h := hstat (BilateralField d) (chaosSampleLaw M).toMeasure q hq Dx S S W a ha0 ha
    hnn hLp hD hS hW N
  exact ⟨h.1, h.2.1⟩

theorem aux_lem_band_des3_rr_model {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
