        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖)
    (pvec : Fin d → ℝ) (fL2 : ℝ → DomainL2 (unitNeumannCube d))
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (a Cn p B : ℝ) (ha0 : 0 < a)
    (hCn : 0 ≤ Cn) (hδ0 : 0 ≤ M.delta) (hB : 0 ≤ B) (h1r : 0 < 1 - (3 : ℝ) ^ (-a)) (h N : ℕ) :
