                    one_pos).val y *
                    ∑ i : Fin d, (((sobolevGradient (u : SobolevData (unitNeumannCube d))) i :
                      SpatialCoordinates d → ℝ) y) ^ 2) + V N om * Kf ^ 2) := by
  set Lstar : ℝ := 10 with hLstar_def
  set Rstar : ℝ := (3 : ℝ) ^ (-(7 : ℤ)) / 2 with hRstar_def
  set etas : ℝ := ((d : ℝ) + 2 - t0) / 2 with hetas_def
  set q : ℝ := max p (((d : ℝ) + 1) / eta) with hq_def
