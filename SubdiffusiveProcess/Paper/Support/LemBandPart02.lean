theorem aux_lem_band_des3_lintegral_exp_le_uniform {α : Type*} [MeasurableSpace α]
    (μ : Measure α) [IsProbabilityMeasure μ] (L : α → ℕ) (hL : Measurable L)
    (Cc κ0 κ lam : ℝ) (hCc : 1 ≤ Cc) (hlam : 0 ≤ lam) (hκ0lam : lam < κ0) (hκ0κ : κ0 ≤ κ)
    (n0 : ℕ) (hn0 : Cc + 1 ≤ (n0 : ℝ))
    (htail : ∀ k : ℕ, μ {om : α | k < L om} ≤
      ENNReal.ofReal (Cc * Real.exp (κ * Cc) * Real.exp (-κ * k))) :
    ∫⁻ om, ENNReal.ofReal (Real.exp (lam * (L om : ℝ))) ∂μ ≤
      ENNReal.ofReal (Real.exp (lam * (n0 : ℝ)) *
        ((n0 : ℝ) + Cc * Real.exp (κ0 * (Cc + 1 - (n0 : ℝ))) * (1 - Real.exp (lam - κ0))⁻¹)) := by
  have hκ00 : 0 < κ0 := lt_of_le_of_lt hlam hκ0lam
  have hκpos : 0 < κ := lt_of_lt_of_le hκ00 hκ0κ
  have hn01 : (1 : ℝ) ≤ (n0 : ℝ) := le_trans (by linarith) hn0
  have hn0pos : 1 ≤ n0 := by exact_mod_cast hn01
  have hρlt : Real.exp (lam - κ) < 1 := by
    rw [Real.exp_lt_one_iff]; linarith
  have hρ0lt : Real.exp (lam - κ0) < 1 := by
    rw [Real.exp_lt_one_iff]; linarith
  have hρnn : (0:ℝ) ≤ Real.exp (lam - κ) := (Real.exp_pos _).le
  have hden0 : (0:ℝ) < 1 - Real.exp (lam - κ) := by linarith
  have hden00 : (0:ℝ) < 1 - Real.exp (lam - κ0) := by linarith
  have hdenmono : Real.exp (lam - κ) ≤ Real.exp (lam - κ0) := by
    apply Real.exp_le_exp.mpr; linarith
  have hinvmono : (1 - Real.exp (lam - κ))⁻¹ ≤ (1 - Real.exp (lam - κ0))⁻¹ := by
    rw [← one_div, ← one_div]
    exact one_div_le_one_div_of_le hden00 (by linarith)
  have hexpmono : Real.exp (κ * (Cc + 1 - (n0:ℝ))) ≤ Real.exp (κ0 * (Cc + 1 - (n0:ℝ))) := by
    apply Real.exp_le_exp.mpr
    have hnn : Cc + 1 - (n0:ℝ) ≤ 0 := by linarith
    nlinarith
  have hlint : ∫⁻ om, ENNReal.ofReal (Real.exp (lam * (L om : ℝ))) ∂μ =
      ∑' n : ℕ, ENNReal.ofReal (Real.exp (lam * n)) * μ (L ⁻¹' {n}) := by
    have hg : Measurable (fun n : ℕ => ENNReal.ofReal (Real.exp (lam * n))) :=
      measurable_from_nat
    rw [← lintegral_map hg hL, lintegral_countable']
    congr 1
    funext n
    rw [Measure.map_apply hL (measurableSet_singleton n)]
  rw [hlint]
  set f : ℕ → ℝ≥0∞ := fun n => ENNReal.ofReal (Real.exp (lam * (n : ℝ))) * μ (L ⁻¹' {n}) with hfdef
                                                                         
  have hbranch : ∀ n : ℕ, n0 ≤ n →
      f n ≤ ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
        ENNReal.ofReal (Real.exp ((lam - κ) * n)) := by
    intro n hn
    have hn1 : 1 ≤ n := le_trans hn0pos hn
    have hset : L ⁻¹' {n} ⊆ {om : α | (n - 1) < L om} := by
      intro om hom
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hom
      simp only [Set.mem_setOf_eq, hom]
      omega
    have htailn := (measure_mono hset).trans (htail (n - 1))
    have hcast : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
      push_cast [Nat.cast_sub hn1]; ring
    rw [hcast] at htailn
    have heq : Cc * Real.exp (κ * Cc) * Real.exp (-κ * ((n : ℝ) - 1)) =
        Cc * Real.exp (κ * (Cc + 1)) * Real.exp (-κ * (n : ℝ)) := by
      rw [show κ * (Cc + 1) = κ * Cc + κ by ring,
        show (-κ * ((n : ℝ) - 1)) = -κ * (n : ℝ) + κ by ring, Real.exp_add, Real.exp_add]
      ring
    rw [heq] at htailn
    rw [hfdef]
    refine (mul_le_mul_right htailn _).trans (le_of_eq ?_)
    rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show Real.exp (lam * n) * (Cc * Real.exp (κ * (Cc + 1)) * Real.exp (-κ * (n : ℝ))) =
        Cc * Real.exp (κ * (Cc + 1)) * (Real.exp (lam * n) * Real.exp (-κ * (n : ℝ))) by ring,
      ← Real.exp_add]
    congr 2
    ring
  have hsplit : (∑ i ∈ Finset.range n0, f i) + ∑' i : ℕ, f (i + n0) = ∑' n, f n :=
    (ENNReal.summable (f := fun n : ℕ => f (n + n0))).sum_add_tsum_nat_add'
  rw [← hsplit]
                                                           
  have hhead : (∑ i ∈ Finset.range n0, f i) ≤ ENNReal.ofReal ((n0 : ℝ) * Real.exp (lam * (n0:ℝ))) := by
    have hb : (∑ i ∈ Finset.range n0, f i) ≤
        ∑ _i ∈ Finset.range n0, ENNReal.ofReal (Real.exp (lam * (n0 : ℝ))) := by
      apply Finset.sum_le_sum
      intro i hi
      have h1 : μ (L ⁻¹' {i}) ≤ 1 := prob_le_one
      have h2 : f i ≤ ENNReal.ofReal (Real.exp (lam * i)) := by
        rw [hfdef]
        calc ENNReal.ofReal (Real.exp (lam * (i:ℝ))) * μ (L ⁻¹' {i})
            ≤ ENNReal.ofReal (Real.exp (lam * (i:ℝ))) * 1 := mul_le_mul_right h1 _
          _ = ENNReal.ofReal (Real.exp (lam * (i:ℝ))) := mul_one _
      have h3 : Real.exp (lam * i) ≤ Real.exp (lam * (n0 : ℝ)) := by
        apply Real.exp_le_exp.mpr
        apply mul_le_mul_of_nonneg_left _ hlam
        exact_mod_cast (Finset.mem_range.mp hi).le
      exact h2.trans (ENNReal.ofReal_le_ofReal h3)
    refine hb.trans (le_of_eq ?_)
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, ← ENNReal.ofReal_natCast n0,
      ← ENNReal.ofReal_mul (Nat.cast_nonneg n0)]
                                                                
  have htailsum : (∑' i : ℕ, f (i + n0)) ≤
      ENNReal.ofReal (Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ))) * Real.exp (lam * (n0:ℝ)) *
        (1 - Real.exp (lam - κ0))⁻¹) := by
    have hstep1 : (∑' i : ℕ, f (i + n0)) ≤
        ∑' i : ℕ, ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
          ENNReal.ofReal (Real.exp ((lam - κ) * (i + n0 : ℕ))) :=
      ENNReal.tsum_le_tsum fun i => hbranch (i + n0) (Nat.le_add_left n0 i)
    have hstep2 : (∑' i : ℕ, ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
        ENNReal.ofReal (Real.exp ((lam - κ) * (i + n0 : ℕ)))) =
        ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ))) *
          ENNReal.ofReal (1 - Real.exp (lam - κ))⁻¹ := by
      have hfun : (fun i : ℕ => ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
          ENNReal.ofReal (Real.exp ((lam - κ) * (i + n0 : ℕ)))) =
          fun i : ℕ => ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1) + (lam - κ) * (n0:ℝ))) *
            ENNReal.ofReal (Real.exp (lam - κ) ^ i) := by
        funext i
        have hexppow : Real.exp ((lam - κ) * (i:ℝ)) = Real.exp (lam - κ) ^ i := by
          rw [show (lam - κ) * (i:ℝ) = (i:ℝ) * (lam - κ) by ring, Real.exp_nat_mul]
        have hreal : Cc * Real.exp (κ * (Cc + 1)) * Real.exp ((lam - κ) * ((i + n0 : ℕ):ℝ)) =
            Cc * Real.exp (κ * (Cc + 1) + (lam - κ) * (n0:ℝ)) * Real.exp (lam - κ) ^ i := by
          push_cast
          rw [show (lam - κ) * ((i:ℝ) + (n0:ℝ)) = (lam - κ) * (n0:ℝ) + (lam - κ) * (i:ℝ) by ring,
            Real.exp_add, Real.exp_add, hexppow]
          ring
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity), hreal]
      rw [hfun, ENNReal.tsum_mul_left, ← ENNReal.ofReal_tsum_of_nonneg
        (fun i => pow_nonneg (Real.exp_pos _).le i)
        (summable_geometric_of_lt_one (Real.exp_pos _).le hρlt),
        tsum_geometric_of_lt_one (Real.exp_pos _).le hρlt]
      congr 2
      ring
    refine hstep1.trans (hstep2.trans_le ?_)
    rw [← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_ofReal
    have hexpmono' : Real.exp (κ * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) ≤
        Real.exp (κ0 * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) := by
      apply Real.exp_le_exp.mpr
      have : κ * (Cc + 1 - (n0:ℝ)) ≤ κ0 * (Cc + 1 - (n0:ℝ)) := by
        have hnn : Cc + 1 - (n0:ℝ) ≤ 0 := by linarith
        nlinarith
      linarith
    calc Cc * Real.exp (κ * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) * (1 - Real.exp (lam - κ))⁻¹
        ≤ Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) * (1 - Real.exp (lam - κ))⁻¹ := by
          gcongr
      _ ≤ Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) * (1 - Real.exp (lam - κ0))⁻¹ := by
          gcongr
      _ = Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ))) * Real.exp (lam * (n0:ℝ)) *
            (1 - Real.exp (lam - κ0))⁻¹ := by rw [Real.exp_add]; ring
  refine (add_le_add hhead htailsum).trans (le_of_eq ?_)
  rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 1
  ring

theorem aux_lem_band_des3_delta_sq_log_mono {δ D : ℝ} (hδ0 : 0 < δ) (hδD : δ ≤ D)
    (hD1 : D ≤ Real.exp (-(1/2 : ℝ))) :
    δ ^ 2 * |Real.log δ| ≤ D ^ 2 * |Real.log D| := by
  set X : ℝ := Real.exp (-(1/2 : ℝ)) with hXdef
  have hX0 : 0 < X := Real.exp_pos _
  have hX1 : X < 1 := by
    rw [hXdef]
    calc Real.exp (-(1/2:ℝ)) < Real.exp 0 := Real.exp_lt_exp.mpr (by norm_num)
      _ = 1 := Real.exp_zero
  set g : ℝ → ℝ := fun x => -(x ^ 2 * Real.log x) with hgdef
  have hderiv : ∀ x ∈ Set.Ioo (0:ℝ) X, HasDerivAt g (x * (-2 * Real.log x - 1)) x := by
    intro x hx
    have hx0 : x ≠ 0 := ne_of_gt hx.1
    have h1 : HasDerivAt Real.log x⁻¹ x := Real.hasDerivAt_log hx0
    have h2 : HasDerivAt (fun y : ℝ => y ^ 2) (2 * x) x := by
      simpa using (hasDerivAt_pow 2 x)
    have h3 : HasDerivAt (fun y : ℝ => y ^ 2 * Real.log y) (2 * x * Real.log x + x ^ 2 * x⁻¹) x :=
      h2.fun_mul h1
    have h4 := h3.fun_neg
    convert h4 using 1
    have hxx : x ^ 2 * x⁻¹ = x := by field_simp
    rw [hxx]; ring
  have hcont : ContinuousOn g (Set.Ioc (0:ℝ) X) := by
    apply ContinuousOn.neg
    apply ContinuousOn.mul (continuous_pow 2).continuousOn
    intro x hx
    exact (Real.continuousAt_log (ne_of_gt hx.1)).continuousWithinAt
  have hdiffOn : DifferentiableOn ℝ g (interior (Set.Ioc (0:ℝ) X)) := by
    rw [interior_Ioc]
    intro x hx
    exact (hderiv x hx).differentiableAt.differentiableWithinAt
  have hmono : MonotoneOn g (Set.Ioc (0:ℝ) X) := by
    apply monotoneOn_of_deriv_nonneg (convex_Ioc _ _) hcont hdiffOn
    rw [interior_Ioc]
    intro x hx
    rw [(hderiv x hx).deriv]
    have hlogx : Real.log x ≤ -(1/2 : ℝ) := by
      have h := (Real.log_le_log_iff hx.1 hX0).mpr hx.2.le
      rw [hXdef, Real.log_exp] at h
      exact h
    have hxpos : 0 < x := hx.1
    nlinarith
  have hδlt1 : δ < 1 := lt_of_le_of_lt (hδD.trans hD1) hX1
  have hDlt1 : D < 1 := lt_of_le_of_lt hD1 hX1
  have hδmem : δ ∈ Set.Ioc (0:ℝ) X := ⟨hδ0, hδD.trans hD1⟩
  have hDmem : D ∈ Set.Ioc (0:ℝ) X := ⟨lt_of_lt_of_le hδ0 hδD, hD1⟩
  have hg := hmono hδmem hDmem hδD
  have habsδ : |Real.log δ| = -Real.log δ := abs_of_neg (Real.log_neg hδ0 hδlt1)
  have habsD : |Real.log D| = -Real.log D :=
    abs_of_neg (Real.log_neg (lt_of_lt_of_le hδ0 hδD) hDlt1)
  rw [habsδ, habsD, show δ ^ 2 * -Real.log δ = g δ by rw [hgdef]; ring,
    show D ^ 2 * -Real.log D = g D by rw [hgdef]; ring]
  exact hg

theorem aux_lem_band_des3_threshold_uniform {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (t1 Pexp : ℝ) (ht1 : (d : ℝ) - 1 < t1) (ht1' : t1 < d) (ht10 : 0 ≤ t1) (hP1 : 1 ≤ Pexp) :
    ∃ dA : ℝ, 0 < dA ∧
    ∃ κ0 : ℝ, 2 * Pexp * t1 * Real.log 3 < κ0 ∧
    ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Sreg : in_6_16 d M),
      M.delta ≤ dA →
      M.delta ≤ Sreg.C⁻¹ ∧ 1 - ((d : ℝ) - t1) / 4 ∈ Sreg.alphaRange ∧
        κ0 ≤ (1 - (1 - ((d : ℝ) - t1) / 4)) ^ 2 / (Sreg.C * M.delta ^ 2 * |Real.log M.delta|) := by
  obtain ⟨Cd, hCd⟩ : ∃ Cd : ℝ, Cd = ((d : ℝ) + 1) ^ 2 *
      max 1 (Classical.choose (SubdiffusiveProcess.Frozen.Section6.cutoff_holder_regularity d)) := ⟨_, rfl⟩
  have hCd1 : 1 ≤ Cd := by
    rw [hCd]
    have h1 : (1 : ℝ) ≤ ((d : ℝ) + 1) ^ 2 := by
      have : (1 : ℝ) ≤ (d : ℝ) + 1 := by linarith [(Nat.cast_nonneg d : (0 : ℝ) ≤ d)]
      nlinarith
    have h2 : (1 : ℝ) ≤
        max 1 (Classical.choose (SubdiffusiveProcess.Frozen.Section6.cutoff_holder_regularity d)) :=
      le_max_left _ _
    nlinarith
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = ((d : ℝ) - t1) / 4 := ⟨_, rfl⟩
  have ha0 : 0 < a := by rw [ha]; linarith
  have ha1 : a < 1 / 4 := by rw [ha]; linarith
  obtain ⟨lam, hlamdef⟩ : ∃ lam : ℝ, lam = 2 * Pexp * t1 * Real.log 3 := ⟨_, rfl⟩
  have hlam : 0 ≤ lam := by
    rw [hlamdef]
    have hlog3 : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num : (1 : ℝ) ≤ 3)
    have hPnn : (0 : ℝ) ≤ Pexp := by linarith
    positivity
  have hCd0 : 0 < Cd := by linarith
  set dA : ℝ := min (min (1 / 2) Cd⁻¹) (min ((a / Cd) ^ 2) (a ^ 2 / (2 * Cd * (lam + 1))))
    with hdAdef
  have hdA0 : 0 < dA := by
    rw [hdAdef]
    refine lt_min (lt_min (by norm_num) (inv_pos.2 hCd0)) (lt_min (by positivity) ?_)
    have : 0 < 2 * Cd * (lam + 1) := by positivity
    positivity
  have hdAhalf : dA ≤ (1 / 2 : ℝ) := (min_le_left _ _).trans (min_le_left _ _)
  have hdAX : dA ≤ Real.exp (-(1/2:ℝ)) := by
    have hhalf : (1/2:ℝ) ≤ Real.exp (-(1/2:ℝ)) := by
      have := Real.add_one_le_exp (-(1/2:ℝ))
      linarith
    exact hdAhalf.trans hhalf
  obtain ⟨hδCA, hαA, hκlamA⟩ :=
    aux_aux_macro_moment_bank_delta_facts Cd a lam dA hCd1 ha0 ha1 hlam hdA0 (le_refl dA)
  refine ⟨dA, hdA0, (1 - (1 - a)) ^ 2 / (Cd * dA ^ 2 * |Real.log dA|), ?_, ?_⟩
  · rwa [← hlamdef]
  · intro M Sreg hδA
    have hδ0 : 0 < M.delta := M.shellPrefix.delta_pos
    have hCeq : Sreg.C = Cd := by rw [Sreg.C_eq_dimensional, hCd]
    obtain ⟨hδC, hα, _⟩ :=
      aux_aux_macro_moment_bank_delta_facts Cd a lam M.delta hCd1 ha0 ha1 hlam hδ0 hδA
    rw [← hCeq] at hδC hα
    rw [← Sreg.alphaRange_eq, ha] at hα
    refine ⟨hδC, hα, ?_⟩
    have hmono := aux_lem_band_des3_delta_sq_log_mono hδ0 hδA hdAX
    have hbc : Cd * M.delta ^ 2 * |Real.log M.delta| ≤ Cd * dA ^ 2 * |Real.log dA| := by
      calc Cd * M.delta ^ 2 * |Real.log M.delta| = Cd * (M.delta ^ 2 * |Real.log M.delta|) := by
            ring
        _ ≤ Cd * (dA ^ 2 * |Real.log dA|) := mul_le_mul_of_nonneg_left hmono hCd0.le
        _ = Cd * dA ^ 2 * |Real.log dA| := by ring
    have hδlt1 : M.delta < 1 := lt_of_le_of_lt (hδA.trans hdAhalf) (by norm_num)
    have hcpos : 0 < Cd * M.delta ^ 2 * |Real.log M.delta| := by
      have hlogne : Real.log M.delta < 0 := Real.log_neg hδ0 hδlt1
      have habspos : 0 < |Real.log M.delta| := abs_pos.mpr hlogne.ne
      positivity
    rw [hCeq, ← ha]
    exact div_le_div_of_nonneg_left (sq_nonneg _) hcpos hbc

theorem aux_lem_band_des3_sqrt_power_bound
    (C t : ℝ) (hC : 0 ≤ C) (ht : 0 ≤ t) (N : ℕ) :
    (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t ≤
      (1 + C) ^ t * (1 + (N : ℝ)) ^ (t / 2) := by
  have hsqrt : 1 ≤ Real.sqrt (1 + (N : ℝ)) := by
    nlinarith [Real.sq_sqrt (by positivity : 0 ≤ 1 + (N : ℝ)),
      Real.sqrt_nonneg (1 + (N : ℝ))]
  have harg : 0 ≤ 1 + C * Real.sqrt (1 + (N : ℝ)) := by positivity
  have hcmp : 1 + C * Real.sqrt (1 + (N : ℝ)) ≤
      (1 + C) * Real.sqrt (1 + (N : ℝ)) := by nlinarith
  calc
    _ ≤ ((1 + C) * Real.sqrt (1 + (N : ℝ))) ^ t :=
      Real.rpow_le_rpow harg hcmp ht
    _ = (1 + C) ^ t * (Real.sqrt (1 + (N : ℝ))) ^ t := by
      rw [Real.mul_rpow (by linarith) (Real.sqrt_nonneg _)]
    _ = (1 + C) ^ t * (1 + (N : ℝ)) ^ (t / 2) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (by linarith : 0 ≤ 1 + (N : ℝ))]
      ring

theorem aux_lem_band_des3_rate_bound
    (A C t a s : ℝ) (hA : 0 ≤ A) (hC : 0 ≤ C) (ht : 0 ≤ t)
    (ha : a < s * Real.log 3) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ N : ℕ,
      A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t *
        Real.exp (a * (N : ℝ)) * ((3 : ℝ) ^ (-(N : ℝ))) ^ s ≤ B := by
  obtain ⟨Brate, hBrate, hrate⟩ :=
    aux_rem_resolved_microscopic_poly_exp_bounded (t / 2)
      (s * Real.log 3 - a) (sub_pos.mpr ha)
  refine ⟨A * (1 + C) ^ t * Brate, by positivity, ?_⟩
  intro N
  have hid := aux_rem_resolved_microscopic_scale_exp_identity a s N
  have hfac : 0 ≤ A * Real.exp (a * (N : ℝ)) *
      ((3 : ℝ) ^ (-(N : ℝ))) ^ s := by positivity
  have hstep := mul_le_mul_of_nonneg_left
    (aux_lem_band_des3_sqrt_power_bound C t hC ht N) hfac
  have hright := mul_le_mul_of_nonneg_left (hrate N)
    (mul_nonneg hA (Real.rpow_nonneg (by linarith : 0 ≤ 1 + C) t))
  calc
    A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t *
        Real.exp (a * (N : ℝ)) * ((3 : ℝ) ^ (-(N : ℝ))) ^ s =
      (A * Real.exp (a * (N : ℝ)) * ((3 : ℝ) ^ (-(N : ℝ))) ^ s) *
        (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t := by ring
    _ ≤ (A * Real.exp (a * (N : ℝ)) * ((3 : ℝ) ^ (-(N : ℝ))) ^ s) *
          ((1 + C) ^ t * (1 + (N : ℝ)) ^ (t / 2)) := hstep
    _ = (A * (1 + C) ^ t) *
          ((1 + (N : ℝ)) ^ (t / 2) * Real.exp (a * (N : ℝ)) *
            ((3 : ℝ) ^ (-(N : ℝ))) ^ s) := by ring
    _ = (A * (1 + C) ^ t) *
          ((1 + (N : ℝ)) ^ (t / 2) *
            Real.exp (-(s * Real.log 3 - a) * (N : ℝ))) := by
              simp only [mul_assoc, hid]
    _ ≤ A * (1 + C) ^ t * Brate := by simpa [mul_assoc] using hright

theorem aux_lem_band_des3_uniform_microscopic_rate_bound
    (A C t a_max s : ℝ) (hA : 0 ≤ A) (hC : 0 ≤ C) (ht : 0 ≤ t)
    (ha_max : a_max < s * Real.log 3) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ a : ℝ, 0 ≤ a → a ≤ a_max → ∀ N : ℕ,
      A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t *
        Real.exp (a * (N : ℝ)) * ((3 : ℝ) ^ (-(N : ℝ))) ^ s ≤ B := by
  obtain ⟨B, hB0, hBmax⟩ := aux_lem_band_des3_rate_bound A C t a_max s hA hC ht ha_max
  refine ⟨B, hB0, ?_⟩
  intro a ha0 hamax N
  have hbase : 0 ≤ A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ s := by
    positivity
  have hexp : Real.exp (a * (N : ℝ)) ≤ Real.exp (a_max * (N : ℝ)) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hamax (Nat.cast_nonneg N))
  calc A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t * Real.exp (a * (N : ℝ)) *
        ((3 : ℝ) ^ (-(N : ℝ))) ^ s
      = (A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ s) *
          Real.exp (a * (N : ℝ)) := by ring
    _ ≤ (A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ s) *
          Real.exp (a_max * (N : ℝ)) := mul_le_mul_of_nonneg_left hexp hbase
    _ = A * (1 + C * Real.sqrt (1 + (N : ℝ))) ^ t * Real.exp (a_max * (N : ℝ)) *
          ((3 : ℝ) ^ (-(N : ℝ))) ^ s := by ring
    _ ≤ B := hBmax N

theorem aux_lem_band_des3_scaled_bound
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (p z : ℝ) (f : Ω → ℝ) (F B : ℝ)
    (hz : 0 ≤ z) (hF : 0 ≤ F)
    (hf : eLpNorm f (ENNReal.ofReal p) P ≤ ENNReal.ofReal F)
    (hnum : F * z ≤ B) :
    eLpNorm (fun w => f w * z)
      (ENNReal.ofReal p) P ≤ ENNReal.ofReal B := by
  calc
    _ = ENNReal.ofReal z * eLpNorm f (ENNReal.ofReal p) P := by
      have hfun : (fun w => f w * z) = (fun w => z * f w) := by funext w; ring
      rw [hfun]
      exact aux_rem_resolved_microscopic_nonneg_scalar_eLpNorm P p _ hz f
    _ ≤ ENNReal.ofReal z * ENNReal.ofReal F :=
      mul_le_mul_right hf _
    _ = ENNReal.ofReal (F * z) := by
      rw [ENNReal.ofReal_mul hF]
      ac_rfl
    _ ≤ ENNReal.ofReal B := ENNReal.ofReal_le_ofReal hnum

theorem aux_lem_band_des3_uniform_statistical_conjunct
    (d : ℕ) (hd : 2 ≤ d) (t t1 : ℝ) (ht : (d : ℝ) - 1 < t)
    (CD CE CK aRate_max : ℝ) (hCD : 0 ≤ CD) (hCE : 0 ≤ CE) (hCK : 0 ≤ CK)
    (haRate_max0 : 0 ≤ aRate_max)
    (haRate_max : aRate_max < min (t1 - t) (min ((d : ℝ) + 2 - t) ((d : ℝ) - t)) * Real.log 3) :
    ∃ B : ℝ, 0 ≤ B ∧
      ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P],
      ∀ p : ℝ, 1 ≤ p →
      let q := 2 * p * max 1 t
      ∀ D M mInv Kmac : ℕ → Ω → ℝ,
      ∀ aRate : ℝ, 0 ≤ aRate → aRate ≤ aRate_max →
      (∀ N w, 0 ≤ D N w ∧ 0 ≤ M N w ∧ 0 ≤ mInv N w ∧ 0 ≤ Kmac N w) →
      (∀ N, MemLp (D N) (ENNReal.ofReal q) P ∧ MemLp (M N) (ENNReal.ofReal q) P ∧
        MemLp (mInv N) (ENNReal.ofReal q) P ∧ MemLp (Kmac N) (ENNReal.ofReal q) P) →
      (∀ N, eLpNorm (D N) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (CD * Real.sqrt (1 + (N : ℝ)))) →
      (∀ N, eLpNorm (fun w => M N w + mInv N w) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (CE * Real.exp (aRate * (N : ℝ)))) →
      (∀ N, eLpNorm (Kmac N) (ENNReal.ofReal q) P ≤ ENNReal.ofReal CK) →
      ∀ N : ℕ,
        eLpNorm (fun w => (1 + D N w) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * Kmac N w)
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal B ∧
        eLpNorm (fun w => mInv N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal B ∧
        eLpNorm (fun w => M N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) * (1 + D N w) ^ t)
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal B := by
  have ht0 : 0 ≤ t := by
    have hdreal : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    linarith
  have hlog : 0 ≤ Real.log 3 := (Real.log_pos (by norm_num)).le
  have hrate1 : aRate_max < (t1 - t) * Real.log 3 :=
    lt_of_lt_of_le haRate_max (mul_le_mul_of_nonneg_right (min_le_left _ _) hlog)
  have hrate2 : aRate_max < ((d : ℝ) + 2 - t) * Real.log 3 :=
    lt_of_lt_of_le haRate_max
      (mul_le_mul_of_nonneg_right ((min_le_right _ _).trans (min_le_left _ _)) hlog)
  have hrate3 : aRate_max < ((d : ℝ) - t) * Real.log 3 :=
    lt_of_lt_of_le haRate_max
      (mul_le_mul_of_nonneg_right ((min_le_right _ _).trans (min_le_right _ _)) hlog)

  have hrate1' : (0 : ℝ) < (t1 - t) * Real.log 3 := lt_of_le_of_lt haRate_max0 hrate1
  obtain ⟨B1, hB1, hrateB1⟩ :=
    aux_lem_band_des3_rate_bound CK CD t 0 (t1 - t) hCK hCD ht0 hrate1'
  obtain ⟨B2, hB2, hrateB2⟩ :=
    aux_lem_band_des3_uniform_microscopic_rate_bound CE 0 t aRate_max ((d : ℝ) + 2 - t)
      hCE (le_refl _) ht0 hrate2
  obtain ⟨B3, hB3, hrateB3⟩ :=
    aux_lem_band_des3_uniform_microscopic_rate_bound CE CD t aRate_max ((d : ℝ) - t)
      hCE hCD ht0 hrate3
  refine ⟨max B1 (max B2 B3), le_trans hB1 (le_max_left _ _), ?_⟩
  intro Ω _ P _ p hp
  dsimp only
  intro D M mInv Kmac aRate ha0 hamax hnonneg hLp hDnorm hSumnorm hKnorm N
  have hDN := (hLp N).1
  have hMN := (hLp N).2.1
  have hmN := (hLp N).2.2.1
  have hKN := (hLp N).2.2.2
  have hKprod := aux_rem_resolved_microscopic_K_product_bound P p t
    (CD * Real.sqrt (1 + (N : ℝ))) CK hp ht0
    (mul_nonneg hCD (Real.sqrt_nonneg _)) hCK
    (D N) (Kmac N) (fun w => (hnonneg N w).1)
    hDN hKN (hDnorm N) (hKnorm N)
  have hMprod := aux_rem_resolved_microscopic_M_product_bound P p t
    (CD * Real.sqrt (1 + (N : ℝ)))
    (CE * Real.exp (aRate * (N : ℝ))) hp ht0
    (mul_nonneg hCD (Real.sqrt_nonneg _)) (mul_nonneg hCE (Real.exp_pos _).le)
    (D N) (M N) (mInv N)
    (fun w => (hnonneg N w).1) (fun w => (hnonneg N w).2.1)
    (fun w => (hnonneg N w).2.2.1)
    hDN hMN (hDnorm N) (hSumnorm N)
  have hmBound := aux_rem_resolved_microscopic_mInv_bound P p t
    (CE * Real.exp (aRate * (N : ℝ))) hp
    (M N) (mInv N) (fun w => (hnonneg N w).2.1)
    (fun w => (hnonneg N w).2.2.1) hmN (hSumnorm N)
  have hKnum : CK * (1 + CD * Real.sqrt (1 + (N : ℝ))) ^ t *
      ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) ≤ B1 := by
    have := hrateB1 N
    simpa using this
  have hmNum : CE * Real.exp (aRate * (N : ℝ)) *
      ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t) ≤ B2 := by
    have := hrateB2 aRate ha0 hamax N
    simpa using this
  have hMnum : (CE * Real.exp (aRate * (N : ℝ))) *
      (1 + CD * Real.sqrt (1 + (N : ℝ))) ^ t *
      ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) ≤ B3 := by
    have := hrateB3 aRate ha0 hamax N
    convert this using 1 <;> ring
  refine ⟨?_, ?_, ?_⟩
  · have hscale := aux_lem_band_des3_scaled_bound P p
        (((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t))
        (fun w => (1 + D N w) ^ t * Kmac N w)
        (CK * (1 + CD * Real.sqrt (1 + (N : ℝ))) ^ t) B1
        (by positivity) (by positivity) hKprod hKnum
    have hle : ENNReal.ofReal B1 ≤ ENNReal.ofReal (max B1 (max B2 B3)) :=
      ENNReal.ofReal_le_ofReal (le_max_left _ _)
    have := hscale.trans hle
    simpa only [mul_assoc, mul_left_comm, mul_comm] using this
  · have hscale := aux_lem_band_des3_scaled_bound P p
        (((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
        (mInv N) (CE * Real.exp (aRate * (N : ℝ))) B2
        (by positivity) (by positivity) hmBound hmNum
    exact hscale.trans (ENNReal.ofReal_le_ofReal
      (le_trans (le_max_left _ _) (le_max_right _ _)))
  · have hscale := aux_lem_band_des3_scaled_bound P p
        (((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t))
        (fun w => M N w * (1 + D N w) ^ t)
        ((CE * Real.exp (aRate * (N : ℝ))) *
          (1 + CD * Real.sqrt (1 + (N : ℝ))) ^ t) B3
        (by positivity) (by positivity) hMprod hMnum
    have hle : ENNReal.ofReal B3 ≤ ENNReal.ofReal (max B1 (max B2 B3)) :=
      ENNReal.ofReal_le_ofReal (le_trans (le_max_right _ _) (le_max_right _ _))
    have := hscale.trans hle
    simpa only [mul_assoc, mul_left_comm, mul_comm] using this

