    let yeps : ℝ → ℕ → BilateralField d → ℝ := fun eps N om => inverseResponse S (aN N om) (Leps eps)
    let laws : ℤ → Measure C(SpatialCoordinates d, ℝ) := fun j =>
      (scaledLayerLaw d (chaosRootFieldLaw M) j : Measure C(SpatialCoordinates d, ℝ))
    (hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p) →
    (hyNm : AEStronglyMeasurable (yN N) (Measure.infinitePi laws)) →
    (hFCmp : MeasurePreserving
