  exact aux_lem_band_des3_rr_sample M om N t t1 t0 Cm Cmic (U N om) (V N om) (Dx N om) (Mx N om)
    htt1.le hCm.le hCmic (hU0 N om) (hV0 N om) (hDM0 N om).1 hMxpos henv hlip hmicL (hω1 N)

theorem aux_lem_band_des3_h0_rem_resolved (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (_Poincare : Paper.in_poincare d hd I)
    (_Extension : Paper.in_extension d hd I) (_Perturbation : Lane4.SmallPerturbationInput d)
    (D : Paper.lane4_deterministic_good_scale_input d)
    (t : ℝ) (ht0 : (d : ℝ) - 1 < t) (ht1 : t < (d : ℝ)) (q : ℝ) (hq : 1 ≤ q) :
    ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 ≤ B ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : Paper.in_responses d M)
        (Sreg : Paper.in_6_16 d M) (_It : Paper.in_iteration d M I Sreg), M.delta ≤ delta0 →
        ∃ K : ℕ → BilateralField d → ℝ, (∀ N om, 0 ≤ K N om) ∧
          (∀ N, MemLp (K N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
            eLpNorm (K N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal B) ∧
          ∀ᵐ om ∂(chaosSampleLaw M).toMeasure, ∀ (N : ℕ) (f : SpatialCoordinates d → ℝ),
            AEMeasurable f (volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))) →
            ∀ Kf : ℝ, 0 ≤ Kf →
            (∀ᵐ y ∂volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d)), |f y| ≤ Kf) →
            (∫ y in (unitNeumannCube d : Set (SpatialCoordinates d)), f y) = 0 →
            ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
              SolvesNeumann (cutoffPositiveCoefficient M (fun _ => 0) om N
                (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) f u →
            ∀ x : SpatialCoordinates d, x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)) →
            ∀ r : ℝ, 0 < r → r ≤ 1 →
              localGradientEnergy (cutoffPositiveCoefficient M (fun _ => 0) om N
                  (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
                (s := Metric.ball x r ∩ (unitNeumannCube d : Set (SpatialCoordinates d)))
                (isOpen_ball.measurableSet.inter (unitNeumannCube d).isOpen.measurableSet)
                (sobolevGradient (u : SobolevData (unitNeumannCube d))) ≤
              K N om * (sobolevCoefficientForm (cutoffPositiveCoefficient M (fun _ => 0) om N
                  (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
                (u : SobolevData (unitNeumannCube d)) (u : SobolevData (unitNeumannCube d)) +
                Kf ^ 2) * r ^ t := by
  have htd : t < (d : ℝ) := ht1
  have hdt : 0 < (d : ℝ) - t := by linarith only [htd]
  have hd2 : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have ht_nn : 0 ≤ t := by linarith only [ht0, hd2]
  obtain ⟨t1, ht1⟩ : ∃ t1 : ℝ, t1 = t + ((d : ℝ) - t) / 3 := ⟨_, rfl⟩
  obtain ⟨t0, ht0d⟩ : ∃ t0 : ℝ, t0 = t + 2 * ((d : ℝ) - t) / 3 := ⟨_, rfl⟩
  have htt1 : t < t1 := by rw [ht1]; linarith only [hdt]
  have ht1d : t1 < (d : ℝ) := by rw [ht1]; linarith only [hdt]
  have ht0_low : (d : ℝ) - 1 < t0 := by rw [ht0d]; linarith only [ht0, hdt]
  have ht0_high : t0 < (d : ℝ) := by rw [ht0d]; linarith only [hdt]
  have heta_pos : 0 < t0 - t1 := by rw [ht0d, ht1]; linarith only [hdt]
  have heta_lt : t0 - t1 < t0 - ((d : ℝ) - 1) := by rw [ht1]; linarith only [ht0, hdt]
  have hmax1 : (1 : ℝ) ≤ max 1 t := le_max_left _ _
  have hq1 : 1 ≤ 2 * q * max 1 t :=
    one_le_mul_of_one_le_of_one_le (by linarith only [hq]) hmax1
  have hpq : q ≤ 2 * q * max 1 t :=
    calc q ≤ 2 * q * 1 := by linarith only [hq]
      _ ≤ 2 * q * max 1 t := mul_le_mul_of_nonneg_left hmax1 (by linarith only [hq])
  have hh1 := aux_lem_band_des3_h0_meshes d hd I _Poincare _Extension D t0 (t0 - t1) (2 * (2 * q * max 1 t)) ht0_low ht0_high heta_pos heta_lt (by linarith only [hq1])
  obtain ⟨Cm, Cp, delta0m, hCm, hCp, hdelta0m, hmesh⟩ := hh1
  have hp1 : (2 : ℝ) ≤ 2 + 4 * (d : ℝ) / ((d : ℝ) - t) := by
    have h4d : 0 ≤ 4 * (d : ℝ) / ((d : ℝ) - t) := by positivity
    linarith only [h4d]
  have htp : t < (d : ℝ) - 2 * (d : ℝ) / (2 + 4 * (d : ℝ) / ((d : ℝ) - t)) := by
    have hp1pos : 0 < 2 + 4 * (d : ℝ) / ((d : ℝ) - t) := by linarith only [hp1]
    have hkey : 2 * (d : ℝ) / (2 + 4 * (d : ℝ) / ((d : ℝ) - t)) < ((d : ℝ) - t) / 2 := by
      rw [div_lt_iff₀ hp1pos]
      have h5 : ((d : ℝ) - t) / 2 * (2 + 4 * (d : ℝ) / ((d : ℝ) - t)) =
          ((d : ℝ) - t) + 2 * (d : ℝ) := by
        field_simp
        ring
      rw [h5]
      linarith only [hdt]
