            (s N k omega (ygrid k a) + (s N k omega (ygrid k a))⁻¹)
        (∀ (omega : BilateralField d) (N k : ℕ), k ≤ N →
          ∀ z ∈ K, 0 < b N k omega z) ∧
        (∀ (omega : BilateralField d) (k : ℕ) (y : SpatialCoordinates d), y ∈ K →
