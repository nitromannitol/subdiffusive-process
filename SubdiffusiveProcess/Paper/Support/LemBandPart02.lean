  have hZs0 : 0 ≤ Zs := by
    have h1 : 0 ≤ (1 + Dv) ^ t := Real.rpow_nonneg (by linarith) _
    have h2 : 0 ≤ w ^ (t1 - t) := Real.rpow_nonneg hw0.le _
    have h3 : 0 ≤ w ^ ((d : ℝ) + 2 - t) := Real.rpow_nonneg hw0.le _
    have h4 : 0 ≤ w ^ ((d : ℝ) - t) := Real.rpow_nonneg hw0.le _
