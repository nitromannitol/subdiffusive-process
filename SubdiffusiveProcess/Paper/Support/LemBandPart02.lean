section DES3DirichletPieces

theorem aux_lem_band_des3_prefix_moment {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] (t1 Pexp : ℝ) (ht1 : (d : ℝ) - 1 < t1)
    (ht1' : t1 < d) (ht10 : 0 ≤ t1) (hP1 : 1 ≤ Pexp) :
    ∃ dA : ℝ, 0 < dA ∧ ∃ Bpre : ℝ, 0 ≤ Bpre ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Sreg : in_6_16 d M), M.delta ≤ dA →
        M.delta ≤ Sreg.C⁻¹ ∧ 1 - ((d : ℝ) - t1) / 4 ∈ Sreg.alphaRange ∧
        ∀ (N : ℕ) (z : SpatialCoordinates d),
          Measurable (fun om : BilateralField d => Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N
            ((3 : ℝ) ^ N • z) (aux_aux_macro_energy_recurrence_relabel N om)) ∧
          eLpNorm (fun om : BilateralField d => (3 : ℝ) ^ (t1 *
              (Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N ((3 : ℝ) ^ N • z)
                (aux_aux_macro_energy_recurrence_relabel N om) : ℝ)))
            (ENNReal.ofReal (2 * Pexp)) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bpre := by
  obtain ⟨dA, hdA, κ0, hκ0lam, hthr⟩ := aux_lem_band_des3_threshold_uniform (d := d) t1 Pexp ht1 ht1' ht10 hP1
  obtain ⟨Cd, hCd⟩ : ∃ Cd : ℝ, Cd = ((d : ℝ) + 1) ^ 2 *
      max 1 (Classical.choose (SubdiffusiveProcess.Frozen.Section6.cutoff_holder_regularity d)) := ⟨_, rfl⟩
  have hCd1 : 1 ≤ Cd := by
    rw [hCd]
    have h1 : (1 : ℝ) ≤ ((d : ℝ) + 1) ^ 2 := by
      have : (1 : ℝ) ≤ (d : ℝ) + 1 := by linarith [(Nat.cast_nonneg d : (0 : ℝ) ≤ d)]
      nlinarith
    have h2 : (1 : ℝ) ≤
        max 1 (Classical.choose (SubdiffusiveProcess.Frozen.Section6.cutoff_holder_regularity d)) :=
      le_max_left _ _
    nlinarith
  set lam : ℝ := 2 * Pexp * t1 * Real.log 3 with hlamdef
  have hlam0 : 0 ≤ lam := by
    have h1 := Real.log_nonneg (by norm_num : (1 : ℝ) ≤ 3)
    have h2 : (0 : ℝ) ≤ Pexp := by linarith
    rw [hlamdef]; positivity
  have hκ00 : 0 < κ0 := lt_of_le_of_lt hlam0 hκ0lam
  set n0 : ℕ := ⌈Cd⌉₊ + 1 with hn0def
  have hn0 : Cd + 1 ≤ (n0 : ℝ) := by
    rw [hn0def]; push_cast; linarith [Nat.le_ceil Cd]
  have hden : 0 < 1 - Real.exp (lam - κ0) := by
    have : Real.exp (lam - κ0) < 1 := by rw [Real.exp_lt_one_iff]; linarith
    linarith
  refine ⟨dA, hdA, (Real.exp (lam * (n0 : ℝ)) *
      ((n0 : ℝ) + Cd * Real.exp (κ0 * (Cd + 1 - (n0 : ℝ))) * (1 - Real.exp (lam - κ0))⁻¹)) ^
        (1 / (2 * Pexp)), by positivity, ?_⟩
  intro M Sreg hδ
  obtain ⟨hδC, hα, hκ0κ⟩ := hthr M Sreg hδ
  have hCeq : Sreg.C = Cd := by rw [Sreg.C_eq_dimensional, hCd]
  refine ⟨hδC, hα, ?_⟩
  intro N z
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = (1 - (1 - ((d : ℝ) - t1) / 4)) ^ 2 /
      (Sreg.C * M.delta ^ 2 * |Real.log M.delta|) := ⟨_, rfl⟩
  rw [← hκ] at hκ0κ
  have hκ0 : 0 ≤ κ := hκ00.le.trans hκ0κ
  have hpres := aux_aux_macro_moment_bank_relabel_measurePreserving M N
  have hLm : Measurable (fun om : BilateralField d => Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N
      ((3 : ℝ) ^ N • z) (aux_aux_macro_energy_recurrence_relabel N om)) :=
    (Sreg.prefix_measurable _ _ _ _).comp hpres.measurable
  refine ⟨hLm, ?_⟩
  have htail : ∀ k : ℕ, (chaosSampleLaw M).toMeasure {om : BilateralField d | k <
      Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N ((3 : ℝ) ^ N • z)
        (aux_aux_macro_energy_recurrence_relabel N om)} ≤
      ENNReal.ofReal (Sreg.C * Real.exp (κ * Sreg.C) * Real.exp (-κ * k)) := by
    intro k
    have hset : {om : BilateralField d | k < Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N
        ((3 : ℝ) ^ N • z) (aux_aux_macro_energy_recurrence_relabel N om)} =
        aux_aux_macro_moment_bank_relabel N ⁻¹'
          {om | k < Sreg.prefixLen N (1 - ((d : ℝ) - t1) / 4) N ((3 : ℝ) ^ N • z) om} := rfl
    rw [hset, hpres.measure_preimage
      (measurableSet_lt measurable_const (Sreg.prefix_measurable _ _ _ _)).nullMeasurableSet]
    exact aux_aux_macro_moment_bank_tail_geometric M Sreg _ κ hδC hα hκ hκ0 _ _ _ k
  have hCc : 1 ≤ Sreg.C := Sreg.C_ge_one
  have hn0' : Sreg.C + 1 ≤ (n0 : ℝ) := by rw [hCeq]; exact hn0
  have hbound := aux_lem_band_des3_lintegral_exp_le_uniform (chaosSampleLaw M).toMeasure _ hLm Sreg.C κ0 κ
    lam hCc hlam0 hκ0lam hκ0κ n0 hn0' htail
  rw [hCeq] at hbound
  erw [← SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded
    ((Real.continuous_const_rpow (by norm_num : (3 : ℝ) ≠ 0)).comp_aestronglyMeasurable
      ((aestronglyMeasurable_const (b := t1)).mul
        (((measurable_of_countable (fun n : ℕ => (n : ℝ))).comp hLm).aestronglyMeasurable)))]
  refine (aux_aux_macro_moment_bank_eLpNorm_rpow_three_le (chaosSampleLaw M).toMeasure _ t1
    (2 * Pexp) (by linarith) _ hbound).trans (le_of_eq ?_)
  exact ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)

theorem aux_lem_band_des3_form_dirichletMinimizer {d : ℕ} {Ω : Opens (SpatialCoordinates d)}
    (S : ResponseSpace Ω) (a : PositiveCoefficient Ω) (b : weakSobolevGraph Ω) :
