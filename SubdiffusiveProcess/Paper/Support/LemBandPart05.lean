theorem aux_lem_band_U2_ref_band_cubeCenter_le {d : ℕ} [NeZero d] (k : ℕ)
    (R : Homogenization.TriadicCube d)
    (hR : R ∈ Homogenization.descendantsAtScale (Homogenization.originCube d 0)
      ((Homogenization.originCube d 0).scale - (k : ℤ))) :
    ‖Homogenization.cubeCenter R‖ ≤ (1 / 2 : ℝ) := by
  have hmem : Homogenization.cubeCenter R ∈ Homogenization.openCubeSet R := by
    rw [← Homogenization.ball_cubeCenter_eq_openCubeSet]
    exact Metric.mem_ball_self (Homogenization.cubeRadius_pos R)
  have hRdepth : R ∈ Homogenization.descendantsAtDepth (Homogenization.originCube d 0) k := by
    have h1 : (Homogenization.originCube d 0).scale - (k : ℤ) ≤
        (Homogenization.originCube d 0).scale := by simp [Homogenization.originCube]
    have := hR
    unfold Homogenization.descendantsAtScale at this
    rw [dite_eq_left h1] at this
    have hcongr : (Homogenization.originCube d 0).scale -
        ((Homogenization.originCube d 0).scale - (k:ℤ)) = (k:ℤ) := by ring
    rwa [show ((Homogenization.originCube d 0).scale -
      ((Homogenization.originCube d 0).scale - (k:ℤ))).toNat = k by rw [hcongr]; simp] at this
  have hsub : Homogenization.openCubeSet R ⊆
      Homogenization.openCubeSet (Homogenization.originCube d 0) :=
    Homogenization.openCubeSet_subset_of_mem_descendantsAtDepth hRdepth
  have hmem0 := hsub hmem
  rw [Homogenization.mem_openCubeSet_originCube_iff] at hmem0
  rw [pi_norm_le_iff_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
  intro i
  rw [Real.norm_eq_abs]
  obtain ⟨h1, h2⟩ := hmem0 i
  simp only [zpow_zero, mul_one] at h1 h2
  exact abs_le.mpr ⟨h1.le, h2.le⟩

theorem aux_lem_band_U2_ref_band
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
