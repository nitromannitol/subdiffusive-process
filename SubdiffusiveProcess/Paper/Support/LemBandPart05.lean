theorem aux_lem_band_U2_rates (a a1 : ℝ) (h : ℕ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (haa1 : a ≤ a1) :
    (3 : ℝ) ^ (-(h : ℝ)) ≤ (3 : ℝ) ^ (-(a * (h : ℝ))) ∧
    (3 : ℝ) ^ (-(a1 * ((h + 1 : ℕ) : ℝ))) ≤ (3 : ℝ) ^ (-(a * (h : ℝ))) ∧
    (3 : ℝ) ^ (-(a1 * ((h + 1 : ℕ) : ℝ))) ≤ 1 := by
  have hh : (0 : ℝ) ≤ h := Nat.cast_nonneg h
  have hh1 : ((h + 1 : ℕ) : ℝ) = (h : ℝ) + 1 := by push_cast; ring
  refine ⟨aux_lem_band_U2_rpow_mono_exp ?_, aux_lem_band_U2_rpow_mono_exp ?_, ?_⟩
  · have : a * (h : ℝ) ≤ 1 * (h : ℝ) := mul_le_mul_of_nonneg_right ha1 hh
    linarith
  · rw [hh1]
    have : a * (h : ℝ) ≤ a1 * (h : ℝ) := mul_le_mul_of_nonneg_right haa1 hh
    have : 0 ≤ a1 := ha0.trans haa1
    nlinarith
  · refine Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) ?_
    have : 0 ≤ a1 * ((h + 1 : ℕ) : ℝ) := mul_nonneg (ha0.trans haa1) (Nat.cast_nonneg _)
    linarith

theorem aux_lem_band_U2_band_arith_int (w1 W w' h k : ℕ) (h1 : w1 ≤ W) (h2 : 2 * W + 1 ≤ w') (hk : k ≤ h) :
    -((w' * (h + 1) : ℕ) : ℤ) ≤ -((h + 1 : ℕ) : ℤ) ∧ ((h + 1 : ℕ) : ℤ) ≤ ((w' * (h + 1) : ℕ) : ℤ) ∧
    -((w' * (h + 1) : ℕ) : ℤ) ≤ -((w1 * (h + 1 + 1) : ℕ) : ℤ) - (k : ℤ) ∧
    ((w1 * (h + 1 + 1) : ℕ) : ℤ) - (k : ℤ) ≤ ((w' * (h + 1) : ℕ) : ℤ) := by
  obtain ⟨e1, e2⟩ := aux_lem_band_U2_band_arith w1 W w' h k h1 h2 hk
  have f1 : ((w1 * (h + 1 + 1) : ℕ) : ℤ) + (k : ℤ) ≤ ((w' * (h + 1) : ℕ) : ℤ) := by
    exact_mod_cast e1
  have f2 : ((h + 1 : ℕ) : ℤ) ≤ ((w' * (h + 1) : ℕ) : ℤ) := by exact_mod_cast e2
  have f3 : (0 : ℤ) ≤ (k : ℤ) := Int.natCast_nonneg k
  exact ⟨by linarith, f2, by linarith, by linarith⟩

