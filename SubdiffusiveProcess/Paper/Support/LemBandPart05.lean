  toFun := aux_lem_band_U2_shift m w
  invFun := aux_lem_band_U2_shift (-m) (-(((3 : ℝ) ^ m) • w))
  left_inv := aux_lem_band_U2_shift_leftInverse m w
  right_inv := aux_lem_band_U2_shift_rightInverse m w
  measurable_toFun := aux_lem_band_U2_shift_measurable m w
  measurable_invFun := aux_lem_band_U2_shift_measurable (-m) _

theorem aux_lem_band_U2_eLpNorm_comp_shift {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (m : ℤ) (w : SpatialCoordinates d)
    (g : BilateralField d → ℝ) (q : ℝ≥0∞) :
    eLpNorm (fun omega => g (aux_lem_band_U2_shift m w omega)) q (chaosSampleLaw M).toMeasure =
      eLpNorm g q (chaosSampleLaw M).toMeasure := by
  have he : MeasurableEmbedding (aux_lem_band_U2_shift (d := d) m w) :=
    (aux_lem_band_U2_shiftEquiv (d := d) m w).measurableEmbedding
  have hmp := aux_lem_band_U2_T1_shift_measurePreserving M m w
  have h1 := he.eLpNorm_map_measure (g := g) (p := q) (μ := (chaosSampleLaw M).toMeasure)
