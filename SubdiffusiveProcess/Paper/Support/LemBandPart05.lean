theorem aux_lem_band_fine_one_values {d : ℕ} (Q : Homogenization.TriadicCube d) :
    Ch02.sigmaStarInvCoarse (Ch02.cubeDomain Q) (aux_lem_band_fine_one Q).toCoeffOn = 1 ∧
