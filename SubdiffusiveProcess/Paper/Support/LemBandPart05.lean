        intro x hx
        have hh := ContinuousMap.norm_coe_le_norm
          ((H o-infraredPartialSum o (h+1)).restrict (Qc : Set (SpatialCoordinates d))) ⟨x,hx⟩
        change ‖H o x-infraredPartialSum o (h+1) x‖ ≤ T h o at hh
        rw [Real.norm_eq_abs, abs_sub_comm] at hh
        exact hh.trans (le_add_of_nonneg_right hs.le)
      have hh := aux_lem_band_fine_chart_difference I M H (fun o => infraredPartialSum o (h+1)) o K
        R hRsub (V K o+M.delta) (T h o+s) (hVstrict o) (by linarith [hT0 h o])
        (fun x hx => (ho K x hx).trans (le_add_of_nonneg_right hδ.le)) ht i j
      cases b
      · simpa only [F, Bool.false_eq_true, ↓reduceIte, U, Z, mul_assoc] using hh.2
      · simpa only [F, ↓reduceIte, U, Z, mul_assoc] using hh.1
    have hh := aux_lem_band_fine_domination (chaosSampleLaw M).toMeasure q 28728
      ((B*(3:ℝ)^(γ*(K:ℝ)))*(CT*s)) (by norm_num)
      (fun o => F b H o-F b (fun o => infraredPartialSum o (h+1)) o)
      (fun o => U o*Z o) (fun o => mul_nonneg (Real.exp_pos _).le (hZ0 o)) hp
        ((SubdiffusiveProcess.RawLp.eLpNorm_le_guarded _ _ _).trans hprod)
    have hFB : AEStronglyMeasurable (F b (fun o => infraredPartialSum o (h+1)))
        (chaosSampleLaw M).toMeasure :=
      ((hFBm b h hkh).mono (aux_lem_band_U2_band_le_ambient _ _) le_rfl).aestronglyMeasurable
    erw [SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded ((hFm b).aestronglyMeasurable.sub hFB)] at hh
    convert! hh using 1 ; dsimp [s] ; congr 1 ; ring
  have hcell (b : Bool) := aux_lem_band_fine_cell_from_bounds (chaosSampleLaw M).toMeasure K k
    (Nat.le_of_lt hKk) q γ M.delta (504*B) (28728*B*CT) hγ hδ (by positivity) (by positivity)
    (F b H) (fun h => F b (fun o => infraredPartialSum o (h+1))) x0
    (hFm b).aestronglyMeasurable (hFBm b) (hbase b) (hdiff b)
  exact ⟨hcell true, hcell false⟩

