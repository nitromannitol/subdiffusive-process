theorem aux_lem_band_U2_sigmaStarInvCoarse_scaled {d : ℕ} {U : Homogenization.Book.Ch02.Domain d}
    (c : ℝ) (hc : 0 < c) (a b : Homogenization.Book.Ch02.CoeffOn U)
