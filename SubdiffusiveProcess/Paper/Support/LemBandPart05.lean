theorem aux_lem_band_U2_K_transport {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (n off : ℤ) (w : SpatialCoordinates d)
    (w' w0 h : ℕ) (hw0 : w' + off.natAbs ≤ w0) (p ε : ℝ)
    (coord G : BilateralField d → ℝ)
    (hcoord : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      coord omega = G (aux_lem_band_U2_shift (n + off) w omega))
    (hG : aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-((w' * (h + 1) : ℕ) : ℤ))
      ((w' * (h + 1) : ℕ) : ℤ) p G ε) :
    ∃ Yband : BilateralField d → ℝ,
      AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) =>
            omega (j : ℤ))
        inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega => coord omega - Yband omega) (ENNReal.ofReal p)
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal ε := by
  obtain ⟨Y, hYm, hYb⟩ := hG
  refine ⟨fun omega => Y (aux_lem_band_U2_shift (n + off) w omega), ?_, ?_⟩
  · have h1 := aux_lem_band_U2_T2_band_transfer M (n + off) w _ _ hYm
    have hmul : (w' + off.natAbs) * (h + 1) ≤ w0 * (h + 1) := Nat.mul_le_mul_right _ hw0
    have hexp : (w' + off.natAbs) * (h + 1) = w' * (h + 1) + off.natAbs * (h + 1) := by ring
    have hge : off.natAbs ≤ off.natAbs * (h + 1) := Nat.le_mul_of_pos_right _ (Nat.succ_pos h)
    have hA : ((w' * (h + 1) : ℕ) : ℤ) + (off.natAbs : ℤ) ≤ ((w0 * (h + 1) : ℕ) : ℤ) := by
      have : w' * (h + 1) + off.natAbs ≤ w0 * (h + 1) := by omega
      exact_mod_cast this
    have hB : off ≤ (off.natAbs : ℤ) := Int.le_natAbs
    have hC : -off ≤ (off.natAbs : ℤ) := by
      have := Int.le_natAbs (a := -off)
      rwa [Int.natAbs_neg] at this
    exact aux_lem_band_U2_band_mono (by omega) (by omega) h1
  · have heq : (fun omega => coord omega - Y (aux_lem_band_U2_shift (n + off) w omega)) =ᵐ[
        (chaosSampleLaw M).toMeasure]
        (fun omega => (fun o => G o - Y o) (aux_lem_band_U2_shift (n + off) w omega)) := by
      filter_upwards [hcoord] with omega homega
      rw [homega]
    rw [eLpNorm_congr_ae heq, aux_lem_band_U2_eLpNorm_comp_shift M (n + off) w (fun o => G o - Y o)]
    exact hYb

theorem aux_lem_band_U2_descAtDepth_nonempty {d : ℕ} (Q : Homogenization.TriadicCube d) (n : ℕ) :
    (Homogenization.descendantsAtDepth Q n).Nonempty := by
  induction n with
  | zero => exact ⟨Q, by simp [Homogenization.descendantsAtDepth]⟩
  | succ n ih =>
    simp only [Homogenization.descendantsAtDepth]
    refine ih.biUnion (fun R _ => ?_)
    unfold Homogenization.childCubes
    exact Finset.univ_nonempty.image _

theorem aux_lem_band_U2_descAtDepth_card {d : ℕ} (Q : Homogenization.TriadicCube d) (n : ℕ) :
    (Homogenization.descendantsAtDepth Q n).card ≤ 3 ^ (d * n) := by
  induction n with
  | zero => simp [Homogenization.descendantsAtDepth]
  | succ n ih =>
    simp only [Homogenization.descendantsAtDepth]
    have hchild : ∀ R ∈ Homogenization.descendantsAtDepth Q n,
        (Homogenization.childCubes R).card ≤ 3 ^ d := by
      intro R _
      unfold Homogenization.childCubes
      refine (Finset.card_image_le).trans ?_
      simp [Finset.card_univ, Fintype.card_fin]
    calc ((Homogenization.descendantsAtDepth Q n).biUnion Homogenization.childCubes).card
        ≤ (Homogenization.descendantsAtDepth Q n).card * 3 ^ d :=
          Finset.card_biUnion_le_card_mul _ _ _ hchild
      _ ≤ 3 ^ (d * n) * 3 ^ d := Nat.mul_le_mul_right _ ih
      _ = 3 ^ (d * (n + 1)) := by rw [← pow_add]; ring_nf

abbrev aux_lem_band_U2_D {d : ℕ} (n : ℕ) : Finset (Homogenization.TriadicCube d) :=
  Homogenization.descendantsAtScale (Homogenization.originCube d 0)
