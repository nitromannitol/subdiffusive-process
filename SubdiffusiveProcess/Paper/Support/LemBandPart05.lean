theorem aux_lem_band_U2E_coeffScalar_cont_pos {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M)
    (eta : BilateralField d) (K : ℕ) :
    Continuous (Rm.coeffScalar K eta) ∧ ∀ x, 0 < Rm.coeffScalar K eta x := by
  constructor
  · have heq : Rm.coeffScalar K eta = fun x : SpatialCoordinates d =>
        Real.exp ((∑ j ∈ Finset.range (K + 1), (eta (j : ℤ)) x) -
          ((K : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) := by
      funext x; exact Rm.coeffScalar_eq K eta x
    rw [heq]
    exact Real.continuous_exp.comp
      ((continuous_finsetSum (Finset.range (K + 1))
          (fun (j : ℕ) _ => (eta (j : ℤ)).continuous)).sub continuous_const)
  · intro x; exact Rm.coeffScalar_pos K eta x

theorem aux_lem_band_U2E_a0_cont_pos {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M)
    (eta : BilateralField d) (K : ℕ) :
    Continuous (fun z : Homogenization.Vec d =>
      (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ * Rm.coeffScalar K eta ((3 : ℝ) ^ K • z)) ∧
    ∀ z : Homogenization.Vec d, 0 < (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ *
      Rm.coeffScalar K eta ((3 : ℝ) ^ K • z) := by
  obtain ⟨hcont, hpos⟩ := aux_lem_band_U2E_coeffScalar_cont_pos M Rm eta K
  refine ⟨?_, fun z => mul_pos (inv_pos.mpr (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M K)) (hpos _)⟩
  exact continuous_const.mul (hcont.comp (continuous_const_smul ((3 : ℝ) ^ K)))

theorem aux_lem_band_U2E_coeff_eq {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (omega : BilateralField d) (K : ℕ)
    (z : Homogenization.Vec d) :
    SubdiffusiveProcess.cutoffCoefficient M H omega K z =
      (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ *
        Rm.coeffScalar K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega)
          ((3 : ℝ) ^ K • z) *
        Real.exp ((H omega) z) := by
  classical
  have hcd : ∀ (r : ℝ) (y : SpatialCoordinates d),
      cubeDilation (0 : SpatialCoordinates d) 0 r y = r • y := by
    intro r y; funext k; simp [cubeDilation_apply]
  have hgeq : ∀ (N : ℕ) (om : BilateralField d) (y : SpatialCoordinates d) (i : ℕ),
      om ((i : ℤ) - (N : ℤ)) (((3 : ℝ) ^ (-(N : ℤ))) • y) =
        (aux_lem_band_U2_shift (N : ℤ) (0 : SpatialCoordinates d) om) (i : ℤ) y := by
    intro N om y i
    show om ((i : ℤ) - (N : ℤ)) (((3 : ℝ) ^ (-(N : ℤ))) • y) =
      ((om ((i : ℤ) - (N : ℤ))).comp (aux_lem_band_U2_cellMap (N : ℤ) (0 : SpatialCoordinates d))) y
    rw [ContinuousMap.comp_apply]
    congr 1
    show (((3 : ℝ) ^ (-(N : ℤ))) • y) =
      (aux_lem_band_U2_cellMap (N : ℤ) (0 : SpatialCoordinates d)) y
    show (((3 : ℝ) ^ (-(N : ℤ))) • y) = cubeDilation 0 0 ((3 : ℝ) ^ (-(N : ℤ))) y
    rw [hcd]
  have ha0eq : ∀ (N : ℕ) (om : BilateralField d) (y : SpatialCoordinates d),
      Real.exp (∑ i ∈ Finset.range (N + 1),
        (om ((i : ℤ) - (N : ℤ)) (((3 : ℝ) ^ (-(N : ℤ))) • y) -
          _root_.SubdiffusiveProcess.Model.tauSq M.P)) =
        Rm.coeffScalar N (aux_lem_band_U2_shift (N : ℤ) (0 : SpatialCoordinates d) om) y := by
    intro N om y
    rw [Rm.coeffScalar_eq N (aux_lem_band_U2_shift (N : ℤ) (0 : SpatialCoordinates d) om) y]
    have hrearrange :
        (∑ j ∈ Finset.range (N + 1),
          (aux_lem_band_U2_shift (N : ℤ) (0 : SpatialCoordinates d) om) (j : ℤ) y) -
          ((N : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P =
        ∑ i ∈ Finset.range (N + 1),
          ((aux_lem_band_U2_shift (N : ℤ) (0 : SpatialCoordinates d) om) (i : ℤ) y -
            _root_.SubdiffusiveProcess.Model.tauSq M.P) := by
      rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      push_cast; ring
    rw [hrearrange]
    congr 1
    exact Finset.sum_congr rfl (fun i _ => by rw [hgeq N om y i])
  have hcpi := (_root_.SubdiffusiveProcess.Paper.coefficient_physical_identity M H hH
    (fun N om i y => om ((i : ℤ) - (N : ℤ)) (((3 : ℝ) ^ (-(N : ℤ))) • y))
    (fun N om i y => rfl)
    (fun N om y => Real.exp (∑ i ∈ Finset.range (N + 1),
      (om ((i : ℤ) - (N : ℤ)) (((3 : ℝ) ^ (-(N : ℤ))) • y) -
        _root_.SubdiffusiveProcess.Model.tauSq M.P)))
    (fun N om y => rfl)).1 omega K z
  rw [hcpi, ha0eq K omega ((3 : ℝ) ^ K • z)]

