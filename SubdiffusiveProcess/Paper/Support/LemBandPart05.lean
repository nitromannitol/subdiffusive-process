theorem aux_lem_band_U2_cell_sigmaStarInvNorm
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp) :
    ∃ a c : ℝ, 0 < a ∧ 0 < c ∧ ∃ w' : ℕ, 0 < w' ∧
      ∀ γ : ℝ, 0 < γ → ∀ q : ℝ, 1 ≤ q → ∃ delta0 C : ℝ, 0 < delta0 ∧ 0 ≤ C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K k : ℕ), ∀ R ∈ aux_lem_band_U2_D (d := d) k,
        AEStronglyMeasurable (fun omega =>
          Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R
            (aux_lem_band_U2_unitChart I M H omega K)) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (fun omega => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R
            (aux_lem_band_U2_unitChart I M H omega K) - 1) (ENNReal.ofReal q)
          (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C * M.delta ^ c * (3 : ℝ) ^ (γ * (k : ℝ))) ∧
        ∀ h : ℕ, k ≤ h →
          aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-((w' * (h + 1) : ℕ) : ℤ))
            ((w' * (h + 1) : ℕ) : ℤ) q
            (fun omega => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R
              (aux_lem_band_U2_unitChart I M H omega K) - 1)
            (C * M.delta ^ c * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(a * (h : ℝ)))) := by
  obtain ⟨a, c, ha, hc, w', hw', hE⟩ := aux_lem_band_U2_cellE d hd I _Poincare _Extension _Perturbation
    _Sobolev D Cresp hCresp
  refine ⟨a, c, ha, hc, w', hw', ?_⟩
  intro γ hγ q hq
  obtain ⟨δ0, C, hδ0, hC, hE'⟩ := hE γ hγ q hq
  refine ⟨δ0, (d : ℝ) * d * C, hδ0, by positivity, ?_⟩
  intro M hM Rm hRm Sreg It H hH K k R hR
  have hδc : 0 ≤ M.delta ^ c := Real.rpow_nonneg M.shellPrefix.delta_pos.le c
  have hent : ∀ ij : Fin d × Fin d,
      AEStronglyMeasurable (fun omega => Homogenization.Book.Ch02.sigmaStarInvCoarse
        (Homogenization.Book.Ch02.cubeDomain R) ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R)
          ij.1 ij.2) (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega => Homogenization.Book.Ch02.sigmaStarInvCoarse
          (Homogenization.Book.Ch02.cubeDomain R) ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R)
