  have hCδ : C1 * δ ^ c1 ≤ C2 * δ ^ c2 := mul_le_mul hC hδc hδc0 (hC1.trans hC)
  refine ⟨hm, hmom.trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hCδ hg)), ?_⟩
  intro h hkh
