theorem aux_lem_band_U2N_num_combine (delta rate B1 B2 C1 CB2 : ℝ)
    (hδ0 : 0 < delta) (hδ1 : delta ≤ 1) (hrate0 : 0 ≤ rate) (hrate1 : rate ≤ 1)
    (hB1 : 0 ≤ B1) (_hB2 : 0 ≤ B2) (hC1 : 0 ≤ C1) (hCB2 : 0 ≤ CB2) :
    B2 * (C1 * delta ^ (1 / 2 : ℝ) * rate) +
      (CB2 * delta * rate) * (B1 + C1 * delta ^ (1 / 2 : ℝ) * rate) ≤
      (C1 * B2 + C1 * CB2 + CB2 * B1) * (delta ^ (1 / 2 : ℝ) * rate) := by
  have hδsqrt : delta ≤ delta ^ (1 / 2 : ℝ) := by
    have h := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 (by norm_num : (1 / 2 : ℝ) ≤ 1)
    rwa [Real.rpow_one] at h
  have hδsqrt_le1 : delta ^ (1 / 2 : ℝ) ≤ 1 := Real.rpow_le_one hδ0.le hδ1 (by norm_num)
  have hX_le1 : delta ^ (1 / 2 : ℝ) * rate ≤ 1 :=
    calc delta ^ (1 / 2 : ℝ) * rate ≤ 1 * 1 :=
          mul_le_mul hδsqrt_le1 hrate1 hrate0 zero_le_one
      _ = 1 := by ring
  have step1 : CB2 * delta * rate ≤ CB2 * delta ^ (1 / 2 : ℝ) * rate :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hδsqrt hCB2) hrate0
  have step2 : B1 + C1 * delta ^ (1 / 2 : ℝ) * rate ≤ B1 + C1 := by
    have hCterm : C1 * delta ^ (1 / 2 : ℝ) * rate ≤ C1 := by
      calc C1 * delta ^ (1 / 2 : ℝ) * rate = C1 * (delta ^ (1 / 2 : ℝ) * rate) := by ring
        _ ≤ C1 * 1 := mul_le_mul_of_nonneg_left hX_le1 hC1
        _ = C1 := mul_one C1
    linarith
  have hT3 : (CB2 * delta * rate) * (B1 + C1 * delta ^ (1 / 2 : ℝ) * rate) ≤
      CB2 * (B1 + C1) * (delta ^ (1 / 2 : ℝ) * rate) := by
    have hnn1 : (0:ℝ) ≤ CB2 * delta ^ (1 / 2 : ℝ) * rate := by positivity
    have hnn2 : (0:ℝ) ≤ B1 + C1 * delta ^ (1 / 2 : ℝ) * rate := by positivity
    calc (CB2 * delta * rate) * (B1 + C1 * delta ^ (1 / 2 : ℝ) * rate)
        ≤ (CB2 * delta ^ (1 / 2 : ℝ) * rate) * (B1 + C1) := mul_le_mul step1 step2 hnn2 hnn1
      _ = CB2 * (B1 + C1) * (delta ^ (1 / 2 : ℝ) * rate) := by ring
  have hT2 : B2 * (C1 * delta ^ (1 / 2 : ℝ) * rate) = C1 * B2 * (delta ^ (1 / 2 : ℝ) * rate) := by
    ring
  rw [hT2]
  calc C1 * B2 * (delta ^ (1 / 2 : ℝ) * rate) +
        (CB2 * delta * rate) * (B1 + C1 * delta ^ (1 / 2 : ℝ) * rate)
      ≤ C1 * B2 * (delta ^ (1 / 2 : ℝ) * rate) + CB2 * (B1 + C1) * (delta ^ (1 / 2 : ℝ) * rate) := by
        linarith [hT3]
    _ = (C1 * B2 + C1 * CB2 + CB2 * B1) * (delta ^ (1 / 2 : ℝ) * rate) := by ring

theorem aux_lem_band_U2N_unit_neumann_band_probe
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (pvec : Fin d → ℝ) (hpvec : ∑ k, (pvec k) ^ 2 = 1) (q : ℝ) (hq : 1 ≤ q) :
    ∃ delta0 C : ℝ, 0 < delta0 ∧ 0 ≤ C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K h : ℕ),
        aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-(h : ℤ)) (h : ℤ) q
          (fun omega => Homogenization.Book.Ch02.responseJ
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0))
            0 pvec)
          (C * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ)))) := by
  obtain ⟨δ1, C1, B1, hδ1, hC1, hB1, hprobe⟩ := aux_lem_band_U2N_unit_probe d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp pvec hpvec q hq
  obtain ⟨δ2, B2, D2, CB2, hδ2, hB2, hD2, hCB2, href⟩ := aux_lem_band_U2N_reference_band d hd q hq
  refine ⟨min δ1 (min δ2 1), C1 * B2 + C1 * CB2 + CB2 * B1,
    lt_min hδ1 (lt_min hδ2 one_pos), by positivity, ?_⟩
  intro M hM Rm hRm Sreg It H hH K h
  have hM1 : M.delta ≤ δ1 := hM.trans (min_le_left _ _)
  have hM2 : M.delta ≤ δ2 := hM.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hMle1 : M.delta ≤ 1 := hM.trans ((min_le_right _ _).trans (min_le_right _ _))
  have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
