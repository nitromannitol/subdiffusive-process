    have hprod : eLpNorm (fun o => U o*Z o) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal ((B*(3:ℝ)^(γ*(K:ℝ)))*(CT*s)) := by
      refine (aux_lem_band_eLpNorm_mul_double (by positivity) hUm.aestronglyMeasurable
        hZm.aestronglyMeasurable).trans ?_
      exact (mul_le_mul' hGM.1 hZn).trans_eq (ENNReal.ofReal_mul (by positivity)).symm
    have hp : ∀ᵐ o ∂(chaosSampleLaw M).toMeasure,
        |F b H o-F b (fun o => infraredPartialSum o (h+1)) o| ≤ 28728*(U o*Z o) := by
      filter_upwards [hVbound] with o ho
      have ht : ∀ x ∈ (closedCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
