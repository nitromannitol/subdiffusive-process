    (N k : ℕ) (y : SpatialCoordinates d) : Measurable (aux_lem_band_ref_log M H N k y) := by
  exact (measurable_const.add ((continuous_eval_const y).measurable.comp hH)).add
    (aux_lem_band_K7_retained_meas aux_lem_band_U2_retained rfl k y)

theorem aux_lem_band_ref_log_exp {d : ℕ}
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (N k : ℕ)
    (y : SpatialCoordinates d) (o : BilateralField d) :
    Real.exp (aux_lem_band_ref_log M H N k y o) = aux_lem_band_U2_reference M H N k y o := by
  unfold aux_lem_band_ref_log aux_lem_band_U2_reference
  rw [add_assoc, Real.exp_add, Real.exp_log (div_pos
    (aux_lem_band_U2_kappa_pos M _) (aux_lem_band_U2_kappa_pos M N))]

theorem aux_lem_band_ref_exp_abs_moment
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (S : Ω → ℝ) (hS : Measurable S) (q B : ℝ) (hq : 1 ≤ q) (hB : 0 ≤ B)
    (hpos : eLpNorm (fun o => Real.exp (S o)) (ENNReal.ofReal q) μ ≤ ENNReal.ofReal B)
    (hneg : eLpNorm (fun o => Real.exp (-S o)) (ENNReal.ofReal q) μ ≤ ENNReal.ofReal B) :
    eLpNorm (fun o => Real.exp |S o|) (ENNReal.ofReal q) μ ≤ ENNReal.ofReal (2 * B) := by
  have hpt : ∀ x : ℝ, Real.exp |x| ≤ Real.exp x + Real.exp (-x) := by
    intro x
    rcases le_or_gt 0 x with hx | hx
    · rw [abs_of_nonneg hx]
      linarith [Real.exp_pos (-x)]
    · rw [abs_of_neg hx]
      linarith [Real.exp_pos x]
  calc _ ≤ eLpNorm (fun o => Real.exp (S o) + Real.exp (-S o)) (ENNReal.ofReal q) μ := by
        apply eLpNorm_mono hS.norm.exp.aestronglyMeasurable
        intro o
        simpa only [Real.norm_of_nonneg (Real.exp_pos _).le,
          Real.norm_of_nonneg (add_nonneg (Real.exp_pos _).le (Real.exp_pos _).le)] using! hpt (S o)
    _ ≤ eLpNorm (fun o => Real.exp (S o)) (ENNReal.ofReal q) μ +
        eLpNorm (fun o => Real.exp (-S o)) (ENNReal.ofReal q) μ :=
      eLpNorm_add_le (ENNReal.one_le_ofReal.mpr hq)
    _ ≤ ENNReal.ofReal B + ENNReal.ofReal B := add_le_add hpos hneg
    _ = ENNReal.ofReal (2 * B) := by rw [← ENNReal.ofReal_add hB hB, two_mul]

theorem aux_lem_band_ref_abs_exp_sub_one (x : ℝ) :
    |Real.exp x - 1| ≤ |x| * Real.exp |x| := by
  by_cases hx : 0 ≤ x
  · rw [abs_of_nonneg (sub_nonneg.mpr (Real.one_le_exp_iff.mpr hx)), abs_of_nonneg hx]
    have hh := Real.add_one_le_exp (-x)
    have hh' := mul_le_mul_of_nonneg_left hh (Real.exp_pos x).le
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero] at hh'
    nlinarith
  · have hx' : x ≤ 0 := le_of_not_ge hx
    rw [abs_of_nonpos (sub_nonpos.mpr (Real.exp_le_one_iff.mpr hx')), abs_of_nonpos hx']
    have hh := Real.add_one_le_exp x
    have he := Real.one_le_exp_iff.mpr (neg_nonneg.mpr hx')
    nlinarith

theorem aux_lem_band_ref_exp_baseline_norm
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (S : Ω → ℝ) (hS : Measurable S) (q A B : ℝ) (hq : 0 < q) (hA : 0 ≤ A)
    (hSn : eLpNorm S (ENNReal.ofReal (2 * q)) μ ≤ ENNReal.ofReal A)
    (hEn : eLpNorm (fun o => Real.exp |S o|) (ENNReal.ofReal (2 * q)) μ ≤ ENNReal.ofReal B) :
    eLpNorm (fun o => Real.exp (S o) - 1) (ENNReal.ofReal q) μ ≤ ENNReal.ofReal (A * B) := by
  calc _ ≤ eLpNorm (fun o => |S o| * Real.exp |S o|) (ENNReal.ofReal q) μ := by
        apply eLpNorm_mono (hS.exp.sub_const 1).aestronglyMeasurable
        intro o
        simpa only [Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤
          |S o| * Real.exp |S o|)] using aux_lem_band_ref_abs_exp_sub_one (S o)
    _ ≤ eLpNorm (fun o => |S o|) (ENNReal.ofReal (2 * q)) μ *
        eLpNorm (fun o => Real.exp |S o|) (ENNReal.ofReal (2 * q)) μ :=
      aux_lem_band_eLpNorm_mul_double hq hS.norm.aestronglyMeasurable
        hS.norm.exp.aestronglyMeasurable
    _ ≤ ENNReal.ofReal A * ENNReal.ofReal B := by
        simpa only [← Real.norm_eq_abs, eLpNorm_norm _ hS.aestronglyMeasurable] using mul_le_mul' hSn hEn
    _ = ENNReal.ofReal (A * B) := (ENNReal.ofReal_mul hA).symm

theorem aux_lem_band_ref_polynomial (γ : ℝ) (hγ : 0 < γ) (k : ℕ) :
    ((k : ℝ) + 1) * (3 : ℝ) ^ (γ / 2 * (k : ℝ)) ≤
      (1 + (γ / 2 * Real.log 3)⁻¹) * (3 : ℝ) ^ (γ * (k : ℝ)) := by
  let β := γ / 2 * Real.log 3
  have hβ : 0 < β := by dsimp [β]; positivity
  have he := Real.add_one_le_exp (β * (k : ℝ))
  have he1 : 1 ≤ Real.exp (β * (k : ℝ)) := Real.one_le_exp (by positivity)
  have hk : (k : ℝ) ≤ β⁻¹ * Real.exp (β * (k : ℝ)) := by
    have hr : β⁻¹ * Real.exp (β * (k : ℝ)) = Real.exp (β * (k : ℝ)) / β := by ring
    rw [hr]
    apply (le_div_iff₀ hβ).mpr
    linarith
  have hpoly : (k : ℝ) + 1 ≤ (1 + β⁻¹) * Real.exp (β * (k : ℝ)) := by nlinarith
  have heq : Real.exp (β * (k : ℝ)) = (3 : ℝ) ^ (γ / 2 * (k : ℝ)) := by
    rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 3)]
    congr 1
    dsimp [β]
    ring
  rw [heq] at hpoly
  calc _ ≤ ((1 + β⁻¹) * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) *
        (3 : ℝ) ^ (γ / 2 * (k : ℝ)) := mul_le_mul_of_nonneg_right hpoly (by positivity)
    _ = _ := by
      rw [mul_assoc, ← Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
      congr 2
      ring

theorem aux_lem_band_ref_tail_meas {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : Measurable H)
    (y : SpatialCoordinates d) (h : ℕ) : Measurable (aux_lem_band_ref_tail H y h) := by
  exact (((continuous_eval_const y).measurable.comp hH).add
    (aux_lem_band_K7_retained_meas aux_lem_band_U2_retained rfl _ y)).sub
      (aux_lem_band_K7_retained_meas aux_lem_band_U2_retained rfl _ 0)

theorem aux_lem_band_ref_truncated_log_meas {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (y : SpatialCoordinates d) (k h : ℕ) (hkh : k ≤ h) (a : ℝ) :
    Measurable[aux_lem_band_U2_band d (-((h + 1 : ℕ) : ℤ)) ((h + 1 : ℕ) : ℤ)]
      (fun o : BilateralField d => a + aux_lem_band_U2_retained k y o -
        aux_lem_band_U2_retained (-((h + 1 : ℕ) : ℤ)) y o +
        aux_lem_band_U2_retained (-((h + 1 : ℕ) : ℤ)) 0 o) := by
  classical
  let edge : ℤ := h + 1
  let proj : BilateralField d → (Set.Icc (-edge) edge → C(SpatialCoordinates d, ℝ)) :=
    fun o j => o (j : ℤ)
  let mB := MeasurableSpace.comap proj inferInstance
  have hproj : Measurable[mB] proj := Measurable.of_comap_le le_rfl
  have hm (lo hi : ℤ) (hl : -edge ≤ lo) (hh : hi ≤ edge) (z : SpatialCoordinates d) :
      Measurable[mB] (fun o : BilateralField d => ∑ j ∈ Finset.Ico lo hi, o (-j) z) := by
    refine Finset.measurable_sum _ fun j hj => ?_
    have hj' : -j ∈ Set.Icc (-edge) edge := by
      simp only [Finset.mem_Ico] at hj
      constructor <;> omega
    exact (continuous_eval_const z).measurable.comp
      ((measurable_pi_apply (⟨-j, hj'⟩ : Set.Icc (-edge) edge)).comp hproj)
  have hneg : ¬0 ≤ -((h + 1 : ℕ) : ℤ) := by omega
  simp only [aux_lem_band_U2_retained, ite_eq_left (Int.natCast_nonneg k), ite_eq_right hneg]
  exact (((measurable_const.add (hm 0 k (by dsimp [edge]; omega)
    (by dsimp [edge]; omega) y)).sub
      (hm (-edge) 0 le_rfl (by dsimp [edge]; omega) y).neg).add
      (hm (-edge) 0 le_rfl (by dsimp [edge]; omega) 0).neg)

theorem aux_lem_band_ref_exp_tail_norm
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (S T : Ω → ℝ) (hS : Measurable S) (hT : Measurable T)
    (q A B D : ℝ) (hq : 0 < q) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hTn : eLpNorm T (ENNReal.ofReal (2 * q)) μ ≤ ENNReal.ofReal A)
    (hSn : eLpNorm (fun o => Real.exp |S o|) (ENNReal.ofReal (4 * q)) μ ≤ ENNReal.ofReal B)
    (hEn : eLpNorm (fun o => Real.exp |T o|) (ENNReal.ofReal (4 * q)) μ ≤ ENNReal.ofReal D) :
    eLpNorm (fun o => Real.exp (S o) - Real.exp (S o - T o)) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (A * (B * D)) := by
  have hprod := aux_lem_band_eLpNorm_mul_double (mu := μ) (by positivity : 0 < 2 * q)
    hS.norm.exp.aestronglyMeasurable hT.norm.exp.aestronglyMeasurable
  rw [show 2 * (2 * q) = 4 * q by ring] at hprod
  calc _ ≤ eLpNorm (fun o => |T o| * (Real.exp |S o| * Real.exp |T o|))
        (ENNReal.ofReal q) μ := by
        apply eLpNorm_mono (hS.exp.sub ((hS.sub hT).exp)).aestronglyMeasurable
        intro o
        simpa only [Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤
          |T o| * (Real.exp |S o| * Real.exp |T o|))] using!
          aux_lem_band_exp_difference (S o) (T o)
    _ ≤ eLpNorm (fun o => |T o|) (ENNReal.ofReal (2 * q)) μ *
        eLpNorm (fun o => Real.exp |S o| * Real.exp |T o|) (ENNReal.ofReal (2 * q)) μ :=
      aux_lem_band_eLpNorm_mul_double hq hT.norm.aestronglyMeasurable
        (hS.norm.exp.mul hT.norm.exp).aestronglyMeasurable
    _ ≤ ENNReal.ofReal A * (ENNReal.ofReal B * ENNReal.ofReal D) := by
        have hTa : eLpNorm (fun o => |T o|) (ENNReal.ofReal (2 * q)) μ ≤ ENNReal.ofReal A := by
          simpa only [← Real.norm_eq_abs, eLpNorm_norm _ hT.aestronglyMeasurable] using hTn
        exact mul_le_mul' hTa (hprod.trans (mul_le_mul' hSn hEn))
    _ = ENNReal.ofReal (A * (B * D)) := by
        rw [← ENNReal.ofReal_mul hB, ← ENNReal.ofReal_mul hA]

theorem aux_lem_band_ref_point_all {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (γ q : ℝ) (hγ : 0 < γ) (hq : 1 ≤ q) :
    ∃ delta0 C : ℝ, 0 < delta0 ∧ 0 ≤ C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (_Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (N k : ℕ), k ≤ N → ∀ y : SpatialCoordinates d, ‖y‖ ≤ 1 →
        aux_lem_band_U2_RefOK (chaosSampleLaw M).toMeasure C γ M.delta q k
          (aux_lem_band_U2_reference M H N k y) ∧
        aux_lem_band_U2_RefOK (chaosSampleLaw M).toMeasure C γ M.delta q k
          (fun o => (aux_lem_band_U2_reference M H N k y o)⁻¹) := by
  have hq0 : 0 < q := by linarith
  obtain ⟨δ0, Cr, hδ0, hδ01, hCr, hRmoms⟩ :=
    aux_lem_band_U2_ref_band_clause12 d hd (γ / 2) (by linarith) (4 * q) (by linarith)
  obtain ⟨Cl, hCl, hLog⟩ := aux_lem_band_ref_log_moment hd q hq
  obtain ⟨A, hA, hTail⟩ := aux_lem_band_ref_tail_orlicz (d := d)
  obtain ⟨Co, hCo, hO⟩ := exists_universal_orlicz_eLpNorm_constant
  let Cp : ℝ := 1 + (γ / 2 * Real.log 3)⁻¹
  let Ct : ℝ := Co * A * Real.sqrt (2 * q)
  let Et : ℝ := (2 * Real.exp ((4 * q) ^ 2 * A ^ 2 / 4)) ^ (1 / (4 * q))
  let Cbase : ℝ := Cl * (2 * Cr) * Cp
  let Cband : ℝ := Ct * (2 * Cr * Et)
  let C : ℝ := 2 * Cr + Cbase + Cband
  have hCp : 0 ≤ Cp := by dsimp [Cp]; positivity
  have hCt : 0 ≤ Ct := by dsimp [Ct]; positivity
  have hEt : 0 ≤ Et := by dsimp [Et]; positivity
  have hCb : 0 ≤ Cbase := by dsimp [Cbase]; positivity
  have hCtB : 0 ≤ Cband := by dsimp [Cband]; positivity
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have hC1 : 2 * Cr ≤ C := by dsimp [C]; linarith
  have hC2 : Cbase ≤ C := by dsimp [C]; linarith
  have hC3 : Cband ≤ C := by dsimp [C]; linarith
  refine ⟨δ0, C, hδ0, hC, ?_⟩
  intro M hM Rm H hH N k hk y hy
  let μ := (chaosSampleLaw M).toMeasure
  let S := aux_lem_band_ref_log M H N k y
  have hδ := M.shellPrefix.delta_pos
  have hδ1 : M.delta ≤ 1 := hM.trans hδ01
  have hSm : Measurable S := aux_lem_band_ref_log_meas M H hH.1 N k y
  obtain ⟨_, _, hRp, hRi⟩ := hRmoms M hM Rm H hH N k hk y hy
  have hSexp : eLpNorm (fun o => Real.exp |S o|) (ENNReal.ofReal (4 * q)) μ ≤
      ENNReal.ofReal (2 * Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) := by
    have hp : eLpNorm (fun o => Real.exp (S o)) (ENNReal.ofReal (4 * q)) μ ≤
        ENNReal.ofReal (Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) := by
      simpa only [S, aux_lem_band_ref_log_exp] using hRp
    have hn : eLpNorm (fun o => Real.exp (-S o)) (ENNReal.ofReal (4 * q)) μ ≤
        ENNReal.ofReal (Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) := by
      simpa only [Real.exp_neg, S, aux_lem_band_ref_log_exp] using hRi
    have hh := aux_lem_band_ref_exp_abs_moment μ S hSm (4 * q)
      (Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) (by linarith) (by positivity) hp hn
    simpa only [mul_assoc] using hh
  have hSn := hLog M hδ1 Rm H hH N k hk y hy
  have hrate : (3 : ℝ) ^ (γ / 2 * (k : ℝ)) ≤ (3 : ℝ) ^ (γ * (k : ℝ)) := by
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    nlinarith [Nat.cast_nonneg (α := ℝ) k]
  have hsign : ∀ sign : ℝ, |sign| = 1 →
      aux_lem_band_U2_RefOK μ C γ M.delta q k (fun o => Real.exp (sign * S o)) := by
    intro sign hsign
    have hss : Measurable (fun o => sign * S o) := measurable_const.mul hSm
    have habs : ∀ o, |sign * S o| = |S o| := by intro o; rw [abs_mul, hsign, one_mul]
    have hSsn : eLpNorm (fun o => sign * S o) (ENNReal.ofReal (2 * q)) μ ≤
        ENNReal.ofReal (Cl * M.delta * ((k : ℝ) + 1)) := by
      rw [aux_lem_band_U2_eLpNorm_cmul, hsign, ENNReal.ofReal_one, one_mul]
      exact hSn
    have hE4 : eLpNorm (fun o => Real.exp |sign * S o|) (ENNReal.ofReal (4 * q)) μ ≤
        ENNReal.ofReal (2 * Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) := by
      simpa only [habs] using hSexp
    have hE2 : eLpNorm (fun o => Real.exp |sign * S o|) (ENNReal.ofReal (2 * q)) μ ≤
        ENNReal.ofReal (2 * Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) :=
      (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith))).trans hE4
    refine ⟨hss.exp.aestronglyMeasurable, ?_, ?_, ?_⟩
    · have hqE := (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith : q ≤ 4 * q))).trans hE4
      refine (eLpNorm_mono hss.exp.aestronglyMeasurable (fun o => ?_)).trans (hqE.trans (ENNReal.ofReal_le_ofReal ?_))
      · simp only [Real.norm_of_nonneg (Real.exp_pos _).le]
        exact Real.exp_le_exp.mpr (le_abs_self _)
      · exact mul_le_mul hC1 hrate (by positivity) hC
    · have hb := aux_lem_band_ref_exp_baseline_norm μ (fun o => sign * S o) hss q
        (Cl * M.delta * ((k : ℝ) + 1)) (2 * Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ)))
        hq0 (by positivity) hSsn hE2
      refine hb.trans (ENNReal.ofReal_le_ofReal ?_)
      have hpoly := aux_lem_band_ref_polynomial γ hγ k
      have hstep := mul_le_mul_of_nonneg_left hpoly (by positivity : 0 ≤ Cl * (2 * Cr) * M.delta)
      have hbig := mul_le_mul_of_nonneg_right hC2
        (by positivity : 0 ≤ M.delta * (3 : ℝ) ^ (γ * (k : ℝ)))
      dsimp [Cbase, Cp] at hbig
      nlinarith
    · intro h hkh
      let T := aux_lem_band_ref_tail H y h
      have hTm : Measurable T := aux_lem_band_ref_tail_meas H hH.1 y h
      let Z : BilateralField d → ℝ := fun o =>
        Real.log (aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N) +
        aux_lem_band_U2_retained k y o - aux_lem_band_U2_retained (-((h + 1 : ℕ) : ℤ)) y o +
        aux_lem_band_U2_retained (-((h + 1 : ℕ) : ℤ)) 0 o
      have hZm := aux_lem_band_ref_truncated_log_meas y k h hkh
        (Real.log (aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N))
      have hST : ∀ o, S o - T o = Z o := by
        intro o
        dsimp [S, T, Z, aux_lem_band_ref_log, aux_lem_band_ref_tail]
        ring
      let τ := A * M.delta * (3 : ℝ) ^ (-(h : ℝ))
      have hτ : 0 < τ := by dsimp [τ]; positivity
      have hτA : τ ≤ A := by
        have hr : (3 : ℝ) ^ (-(h : ℝ)) ≤ 1 :=
          Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg h))
        calc τ ≤ A * M.delta := mul_le_of_le_one_right (by positivity) hr
          _ ≤ A := mul_le_of_le_one_right hA.le hδ1
      have hTsg : Measurable (fun o => sign * T o) := measurable_const.mul hTm
      have hTg : (∫⁻ o, ENNReal.ofReal (Real.exp ((|sign * T o| / τ) ^ 2)) ∂μ) ≤ 2 := by
        simp only [abs_mul, hsign, one_mul]
        exact hTail M H hH y hy h
      have ht := hO μ (fun o => |sign * T o|) τ hTsg.norm (fun _ => abs_nonneg _) hτ hTg
        (ENNReal.ofReal (2 * q)) ENNReal.ofReal_ne_top
        (by rw [← ENNReal.ofReal_ofNat]; exact ENNReal.ofReal_le_ofReal (by linarith))
      rw [ENNReal.toReal_ofReal (by linarith : 0 ≤ 2 * q)] at ht
      have hTn : eLpNorm (fun o => sign * T o) (ENNReal.ofReal (2 * q)) μ ≤
          ENNReal.ofReal (Ct * M.delta * (3 : ℝ) ^ (-(h : ℝ))) := by
        simpa only [← Real.norm_eq_abs, eLpNorm_norm _ hTsg.aestronglyMeasurable, ENNReal.toReal_ofReal (by linarith : 0 ≤ 2 * q),
          τ, Ct, mul_assoc, mul_left_comm, mul_comm] using ht
      have hTe := aux_lem_band_orlicz_exp_norm μ (fun o => sign * T o) hTsg τ A (4 * q)
        hτ hτA (by positivity) hTg
      have hb := aux_lem_band_ref_exp_tail_norm μ (fun o => sign * S o) (fun o => sign * T o)
        hss hTsg q (Ct * M.delta * (3 : ℝ) ^ (-(h : ℝ)))
        (2 * Cr * (3 : ℝ) ^ (γ / 2 * (k : ℝ))) Et hq0 (by positivity) (by positivity) hTn hE4 hTe
      refine ⟨fun o => Real.exp (sign * Z o) - 1,
        ((measurable_const.mul hZm).exp.sub measurable_const).aestronglyMeasurable, ?_⟩
      have heq : (fun o => Real.exp (sign * S o) - 1 - (Real.exp (sign * Z o) - 1)) =
          (fun o => Real.exp (sign * S o) - Real.exp (sign * S o - sign * T o)) := by
        funext o
        rw [← hST o, mul_sub]
        ring
      rw [heq]
      refine hb.trans (ENNReal.ofReal_le_ofReal ?_)
      have h1 := mul_le_mul_of_nonneg_left hrate
        (by positivity : 0 ≤ Cband * M.delta * (3 : ℝ) ^ (-(h : ℝ)))
      have h2 := mul_le_mul_of_nonneg_right hC3
        (by positivity : 0 ≤ M.delta * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(h : ℝ)))
      dsimp [Cband] at h1 h2
      nlinarith
  constructor
  · simpa only [one_mul, S, aux_lem_band_ref_log_exp] using hsign 1 (by norm_num)
  · simpa only [neg_one_mul, Real.exp_neg, S, aux_lem_band_ref_log_exp] using hsign (-1) (by norm_num)

theorem aux_lem_band_U2N_aN_le_one (d : ℕ) (hd : 2 ≤ d) : aux_lem_band_U2N_aN d ≤ 1 := by
