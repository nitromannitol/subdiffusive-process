def aux_lem_band_U2_cellMap {d : ℕ} (m : ℤ) (w : SpatialCoordinates d) :
    C(SpatialCoordinates d, SpatialCoordinates d) :=
  ⟨cubeDilation w 0 ((3 : ℝ) ^ (-m)), continuous_cubeDilation w 0 _⟩

def aux_lem_band_U2_shift {d : ℕ} (m : ℤ) (w : SpatialCoordinates d) (omega : BilateralField d) :
    BilateralField d :=
  fun i => (omega (i - m)).comp (aux_lem_band_U2_cellMap m w)

def aux_lem_band_U2_retained {d : ℕ} (k : ℤ) (y : SpatialCoordinates d) (omega : BilateralField d) : ℝ :=
  if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
    else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y

def aux_lem_band_U2_kappa {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (J : ℕ) : ℝ :=
  Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * SubdiffusiveProcess.CoarseGrainingVocab.ahom M J

def aux_lem_band_U2_reference {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (N : ℕ) (k : ℤ)
    (y : SpatialCoordinates d) (omega : BilateralField d) : ℝ :=
  aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N *
    Real.exp (H omega y + aux_lem_band_U2_retained k y omega)

def aux_lem_band_U2_unitChart {d : ℕ} (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (omega : BilateralField d) (K : ℕ) :
    Homogenization.Book.Ch02.TriadicCoeffFamily d :=
  I.chart 0 1 one_pos (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos) 0 1

