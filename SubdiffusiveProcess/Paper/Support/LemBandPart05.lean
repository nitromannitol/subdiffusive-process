theorem aux_lem_band_U2_unit_neumann_band
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp) :
    ∃ a : ℝ, 0 < a ∧ ∀ q : ℝ, 1 ≤ q → ∃ delta0 C : ℝ, 0 < delta0 ∧ 0 ≤ C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K h : ℕ) (i j : Fin d),
        aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-(h : ℤ)) (h : ℤ) q
          (fun omega => Homogenization.Book.Ch02.responseJ
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0))
            0 (Pi.single i 1 + Pi.single j 1))
          (C * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(a * (h : ℝ)))) := by
  refine ⟨aux_lem_band_U2N_aN d, aux_lem_band_U2N_aN_pos d hd, ?_⟩
  intro q hq
  set qv : Fin d × Fin d → Fin d → ℝ :=
    fun ij => Pi.single ij.1 (1 : ℝ) + Pi.single ij.2 (1 : ℝ) with hqvdef
  set c : Fin d × Fin d → ℝ := fun ij => Real.sqrt (∑ k, (qv ij k) ^ 2) with hcdef
  have hNpos : ∀ ij : Fin d × Fin d, (0 : ℝ) < ∑ k, (qv ij k) ^ 2 :=
    fun ij => aux_lem_band_U2N_qv_pos ij.1 ij.2
  have hNle4 : ∀ ij : Fin d × Fin d, ∑ k, (qv ij k) ^ 2 ≤ 4 :=
    fun ij => aux_lem_band_U2N_qv_le_four ij.1 ij.2
  have hcpos : ∀ ij, 0 < c ij := fun ij => Real.sqrt_pos.mpr (hNpos ij)
  set pvUnit : Fin d × Fin d → Fin d → ℝ := fun ij => (c ij)⁻¹ • (qv ij) with hpvUnitdef
  have hpvUnit : ∀ ij, ∑ k, (pvUnit ij k) ^ 2 = 1 := by
    intro ij
    have hc2 : (c ij) ^ 2 = ∑ k, (qv ij k) ^ 2 := Real.sq_sqrt (hNpos ij).le
    have e : ∀ k, (pvUnit ij k) ^ 2 = (c ij)⁻¹ ^ 2 * (qv ij k) ^ 2 := by
      intro k; simp only [hpvUnitdef, Pi.smul_apply, smul_eq_mul, mul_pow]
    simp_rw [e]
    rw [← Finset.mul_sum, ← hc2, inv_pow, inv_mul_cancel₀ (pow_ne_zero 2 (hcpos ij).ne')]
  have hqveq : ∀ ij, qv ij = c ij • pvUnit ij := by
    intro ij; funext k
    simp only [hpvUnitdef, Pi.smul_apply, smul_eq_mul]
    rw [← mul_assoc, mul_inv_cancel₀ (hcpos ij).ne', one_mul]
  have hprobe := fun ij : Fin d × Fin d => aux_lem_band_U2N_unit_neumann_band_probe d hd I _Poincare
    _Extension _Perturbation _Sobolev D Cresp hCresp (pvUnit ij) (hpvUnit ij) q hq
  choose δf Cf hδf hCf hband using hprobe
  have hne : (Finset.univ : Finset (Fin d × Fin d)).Nonempty := Finset.univ_nonempty
  refine ⟨Finset.univ.inf' hne δf, 4 * Finset.univ.sup' hne Cf,
    (Finset.lt_inf'_iff hne).2 (fun ij _ => hδf ij), by
      have h0 := hCf hne.choose
      have h1 : Cf hne.choose ≤ Finset.univ.sup' hne Cf := Finset.le_sup' Cf (Finset.mem_univ _)
      linarith, ?_⟩
  intro M hM Rm hRm Sreg It H hH K h i j
  have hM' : M.delta ≤ δf (i, j) := hM.trans (Finset.inf'_le _ (Finset.mem_univ _))
  have hb := hband (i, j) M hM' Rm hRm Sreg It H hH K h
  have hfeq : (fun omega => Homogenization.Book.Ch02.responseJ
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
      ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0))
      0 (Pi.single i 1 + Pi.single j 1)) =
      (fun omega => (∑ k, (qv (i, j) k) ^ 2) *
        Homogenization.Book.Ch02.responseJ
          (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
          ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0))
          0 (pvUnit (i, j))) := by
    funext omega
    have hs := Homogenization.Book.Ch02.responseJ_smul
      (U := Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
      (a := (aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0))
      (c (i, j)) 0 (pvUnit (i, j))
    rw [smul_zero] at hs
    have hcq : c (i, j) • pvUnit (i, j) = qv (i, j) := (hqveq (i, j)).symm
    rw [hcq] at hs
    have hc2 : (c (i, j)) ^ 2 = ∑ k, (qv (i, j) k) ^ 2 := Real.sq_sqrt (hNpos (i, j)).le
    rw [hc2] at hs
    exact hs
  rw [hfeq]
  have hmono := aux_lem_band_U2_BA_const_mul (∑ k, (qv (i, j) k) ^ 2) hb
  refine aux_lem_band_U2_BA_mono ?_ hmono
  have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
  have h3 : (0 : ℝ) ≤ M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ))) := by positivity
  have hNabs : |∑ k, (qv (i, j) k) ^ 2| = ∑ k, (qv (i, j) k) ^ 2 :=
    abs_of_nonneg (Finset.sum_nonneg (fun k _ => sq_nonneg _))
  rw [hNabs]
  have hCle : Cf (i, j) ≤ Finset.univ.sup' hne Cf := Finset.le_sup' Cf (Finset.mem_univ _)
  have hCfnn : (0 : ℝ) ≤ Cf (i, j) := hCf (i, j)
  have hCfX : Cf (i, j) * (M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ)))) ≤
      Finset.univ.sup' hne Cf * (M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ)))) :=
    mul_le_mul_of_nonneg_right hCle h3
  have hCfX0 : (0 : ℝ) ≤
      Cf (i, j) * (M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ)))) :=
    mul_nonneg hCfnn h3
  calc (∑ k, (qv (i, j) k) ^ 2) *
        (Cf (i, j) * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ))))
      = (∑ k, (qv (i, j) k) ^ 2) *
          (Cf (i, j) * (M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ))))) := by ring
    _ ≤ 4 * (Finset.univ.sup' hne Cf * (M.delta ^ (1 / 2 : ℝ) *
          (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ))))) :=
        mul_le_mul (hNle4 (i, j)) hCfX hCfX0 (by norm_num)
    _ = 4 * Finset.univ.sup' hne Cf * M.delta ^ (1 / 2 : ℝ) *
        (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ))) := by ring

end UnitNeumannAssembly

theorem aux_lem_band_U2_chart_symm {d : ℕ} (I : _root_.SubdiffusiveProcess.Paper.in_J d) (z : SpatialCoordinates d) (r : ℝ)
