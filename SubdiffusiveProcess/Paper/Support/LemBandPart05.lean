theorem aux_lem_band_U2E_chart_AEEq {d : ℕ} [NeZero d]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (omega : BilateralField d) (K : ℕ)
    (hbData : SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData
      (Ch02.cubeDomain (Homogenization.originCube d 0)) (cutoffCoefficient M H omega K)) :
    Ch02.CoeffOn.AEEq
      ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0))
      hbData.toCoeffOn := by
  set A := (aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0) with hAdef
  have h1 := I.chart_eq 0 1 one_pos (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos) 0 1
    one_pos subset_rfl (Homogenization.originCube d 0) subset_rfl
  have h2 : ∀ᵐ y ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), ∀ hy : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)),
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val y =
        cutoffCoefficient M H omega K y / 1 := by
    have : Fact ((centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) ⊆
        closedCube (0 : SpatialCoordinates d) 1 one_pos) :=
      ⟨centeredCube_subset_closedCube (0 : SpatialCoordinates d) one_pos⟩
    exact normalizedContinuousPositiveCoefficient_coeFn _ _ _ 1 one_pos
  have hcar := aux_chart_transfer_root_carrier (d := d)
  have h2' : ∀ᵐ y ∂volume.restrict (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      ∀ hy : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val y =
        cutoffCoefficient M H omega K y / 1 := by
    rw [← hcar]; exact h2
  have hA : ∀ᵐ y ∂volumeMeasureOn (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      A.toCoeffField y = Homogenization.scalarMatrix (cutoffCoefficient M H omega K y) := by
    filter_upwards [h1, h2', ae_restrict_mem
      (Homogenization.measurableSet_openCubeSet (Homogenization.originCube d 0))] with y hy1 hy2 hym
    rw [hAdef]
    unfold aux_lem_band_U2_unitChart
    rw [hy1]
    have hy0 : (fun i => (0 : SpatialCoordinates d) i + 1 * y i) = y := by funext i; simp
    have hyc : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) := by
      rw [hcar]; exact hym
    rw [hy0, hy2 hyc, div_one]
  unfold Ch02.CoeffOn.AEEq
  simpa only [SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData.toCoeffOn,
    SubdiffusiveProcess.CoarseGrainingVocab.scalarCoeffField] using! hA

theorem aux_lem_band_U2E_small_delta (Cresp : ℝ) (hCresp : 0 < Cresp) (p : ℝ) (hp : 0 < p) :
    ∃ delta0 : ℝ, 0 < delta0 ∧ delta0 < 1 ∧
      ∀ delta : ℝ, 0 < delta → delta ≤ delta0 →
        4 * p ≤ Cresp⁻¹ * (delta ^ 2)⁻¹ * |Real.log delta|⁻¹ := by
  have htend := tendsto_log_mul_rpow_nhdsGT_zero (r := (2 : ℝ)) (by norm_num)
  rw [Metric.tendsto_nhdsWithin_nhds] at htend
  have hε : (0 : ℝ) < 1 / (4 * p * Cresp) := by positivity
  obtain ⟨δ0', hδ0'pos, hδ0'⟩ := htend (1 / (4 * p * Cresp)) hε
  refine ⟨min (δ0' / 2) (1 / 2), by positivity, lt_of_le_of_lt (min_le_right _ _) (by norm_num), ?_⟩
  intro delta hdpos hdle
  have hdlt1 : delta < 1 := lt_of_le_of_lt (hdle.trans (min_le_right _ _)) (by norm_num)
  have hlog_neg : Real.log delta < 0 := Real.log_neg hdpos hdlt1
  have habs_pos : (0 : ℝ) < |Real.log delta| := abs_pos.mpr hlog_neg.ne
  have hd2pos : (0 : ℝ) < delta ^ 2 := by positivity
  have hclose : dist delta 0 < δ0' := by
    rw [Real.dist_eq, sub_zero, abs_of_pos hdpos]
    exact lt_of_le_of_lt (hdle.trans (min_le_left _ _)) (by linarith)
  have hval := hδ0' (Set.mem_Ioi.mpr hdpos) hclose
  have hpow_eq : delta ^ (2 : ℝ) = delta ^ 2 := by
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
  rw [Real.dist_eq, sub_zero, hpow_eq] at hval
  have hval' : |Real.log delta| * delta ^ 2 < 1 / (4 * p * Cresp) := by
    calc |Real.log delta| * delta ^ 2 = |Real.log delta * delta ^ 2| := by
          rw [abs_mul, abs_of_pos hd2pos]
      _ < 1 / (4 * p * Cresp) := hval
  have hcross : 4 * p * (Cresp * (delta ^ 2 * |Real.log delta|)) ≤ 1 := by
    have h4pC : (0 : ℝ) < 4 * p * Cresp := by positivity
    have hmul := mul_lt_mul_of_pos_left hval' h4pC
    have hone : 4 * p * Cresp * (1 / (4 * p * Cresp)) = 1 := by field_simp
    rw [hone] at hmul
    nlinarith [hmul]
  have hD : (0 : ℝ) < Cresp * (delta ^ 2 * |Real.log delta|) :=
    mul_pos hCresp (mul_pos hd2pos habs_pos)
  have hgoal_eq : Cresp⁻¹ * (delta ^ 2)⁻¹ * |Real.log delta|⁻¹ =
      1 / (Cresp * (delta ^ 2 * |Real.log delta|)) := by field_simp
  rw [hgoal_eq, le_div_iff₀ hD]
  nlinarith [hcross]

theorem aux_lem_band_U2E_JN_eq {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (K : ℕ) (qv : Homogenization.Vec d) :
    ∀ omega, Homogenization.Book.Ch02.responseJ
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
      ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0)) 0 qv =
      affineInverseNeumannResponse (aux_lem_band_U2_root_poincareN (d := d))
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos) qv /
        (2 * volume.real (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
          Set (SpatialCoordinates d))) := by
  have hPn := aux_lem_band_U2_root_poincareN (d := d)
  have hcar := aux_chart_transfer_root_carrier (d := d)
  have hset : (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) =
      ((Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0) :
        Homogenization.Book.Ch02.Domain d) : Set (Homogenization.Vec d)) := by
    simpa only [Homogenization.Book.Ch02.cubeDomain_coe] using hcar
  have hvol : 0 < volume.real (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)) := by
    rw [aux_chart_transfer_root_volume]; norm_num
  have key : ∀ omega, Homogenization.Book.Ch02.responseJ
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
      ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0)) 0 qv =
      affineInverseNeumannResponse hPn (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos) qv /
        (2 * volume.real (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
          Set (SpatialCoordinates d))) := by
    intro omega
    set A := (aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0) with hAdef
    have hsym : Homogenization.Book.Ch02.CoeffOn.IsSymmetric A := aux_lem_band_U2_chart_symm I 0 1 one_pos _
    have T := Homogenization.Book.Ch02.responseSymmetricDirichletNeumannTheory
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A hsym
    have h1 := I.chart_eq 0 1 one_pos (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos) 0 1
      one_pos subset_rfl (Homogenization.originCube d 0) subset_rfl
    have h2 : ∀ᵐ y ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)), ∀ hy : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
          Set (SpatialCoordinates d)),
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val y =
          cutoffCoefficient M H omega K y / 1 := by
      have : Fact ((centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) ⊆
          closedCube (0 : SpatialCoordinates d) 1 one_pos) :=
        ⟨centeredCube_subset_closedCube (0 : SpatialCoordinates d) one_pos⟩
      exact normalizedContinuousPositiveCoefficient_coeFn _ _ _ 1 one_pos
    have h2' : ∀ᵐ y ∂volume.restrict (Homogenization.openCubeSet (Homogenization.originCube d 0)),
        ∀ hy : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val y =
          cutoffCoefficient M H omega K y / 1 := by
      rw [← hcar]; exact h2
    have hA : ∀ᵐ y ∂volumeMeasureOn (Homogenization.openCubeSet (Homogenization.originCube d 0)),
        A.toCoeffField y = Homogenization.scalarMatrix (cutoffCoefficient M H omega K y) := by
      filter_upwards [h1, h2', ae_restrict_mem
        (Homogenization.measurableSet_openCubeSet (Homogenization.originCube d 0))] with y hy1 hy2 hym
      rw [hAdef]
      unfold aux_lem_band_U2_unitChart
      rw [hy1]
      have hy0 : (fun i => (0 : SpatialCoordinates d) i + 1 * y i) = y := by funext i; simp
      have hyc : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) := by
        rw [hcar]; exact hym
      rw [hy0, hy2 hyc, div_one]
    let data := Classical.choice
      (SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos
        (cutoffCoefficient_continuous M H omega K) (cutoffCoefficient_pos M H omega K)
        (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)))
    have hAE : Homogenization.Book.Ch02.CoeffOn.AEEq A data.toCoeffOn := by
      unfold Homogenization.Book.Ch02.CoeffOn.AEEq
      simpa only [Homogenization.Book.Ch02.cubeDomain_coe,
        SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData.toCoeffOn,
        SubdiffusiveProcess.CoarseGrainingVocab.scalarCoeffField] using! hA
    have haP : ((_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val :
        SpatialCoordinates d → ℝ) =ᵐ[volume.restrict (centeredCube (0 : SpatialCoordinates d) 1
          one_pos : Set (SpatialCoordinates d))] cutoffCoefficient M H omega K := by
      filter_upwards [h2, ae_restrict_mem (centeredCube (0 : SpatialCoordinates d) 1
        one_pos).isOpen.measurableSet] with y hy hym
      rw [hy hym, div_one]
    have hNeu := aux_chart_transfer_neumannNu
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
      (centeredCube (0 : SpatialCoordinates d) 1 one_pos) hset data hvol hPn
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos) haP qv
    have e1 := T.response_dirichlet_neumann_split 0 qv
    have e2 := T.dirichlet_value_by_sigma 0
    have e3 : Homogenization.vecDot (0 : Homogenization.Vec d) qv = 0 := by
      simp [Homogenization.vecDot]
    have e4 : Homogenization.vecDot (0 : Homogenization.Vec d)
        (Homogenization.matVecMul (Homogenization.Book.Ch02.sigmaCoarse
          (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A) 0) = 0 := by
      simp [Homogenization.vecDot]
    have e5 := Homogenization.Book.Ch02.symmetricNeumannNu_eq_ofAEEq hAE qv
    calc Homogenization.Book.Ch02.responseJ
          (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A 0 qv
        = Homogenization.Book.Ch02.symmetricDirichletNu
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A 0 +
          Homogenization.Book.Ch02.symmetricNeumannNu
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A qv -
          Homogenization.vecDot 0 qv := e1
      _ = Homogenization.Book.Ch02.symmetricNeumannNu
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)) A qv := by
          rw [e2, e3, e4]; ring
      _ = Homogenization.Book.Ch02.symmetricNeumannNu
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            data.toCoeffOn qv := e5
      _ = _ := hNeu
  exact key

theorem aux_lem_band_U2E_response_split {d : ℕ}
    (U : Ch02.Domain d) (a : Ch02.CoeffOn U)
    (ha : Ch02.CoeffOn.IsSymmetric a) (e : Homogenization.Vec d) :
    Ch02.responseJ U a e e + Homogenization.vecNormSq e =
      Ch02.responseJ U a e 0 + Ch02.responseJ U a 0 e := by
  have T := Ch02.responseSymmetricDirichletNeumannTheory U a ha
  rw [T.response_dirichlet_neumann_split e e,
    T.response_dirichlet_neumann_split e 0,
    T.response_dirichlet_neumann_split 0 e,
    T.neumann_value_by_sigmaStarInv 0, T.dirichlet_value_by_sigma 0]
  simp [Homogenization.vecNormSq, Homogenization.vecDot]

theorem aux_lem_band_U2E_cutoff_compare {d : ℕ}
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (omega : BilateralField d) (K : ℕ) (ε : ℝ)
    (hε : ∀ x ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), |H omega x| ≤ ε) :
    (∀ᵐ x ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)),
      Real.exp (-ε) * (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos).val x ≤
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val x) ∧
    (∀ᵐ x ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)),
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val x ≤
        Real.exp ε * (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos).val x) := by
  have : Fact ((centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)) ⊆ closedCube (0 : SpatialCoordinates d) 1 one_pos) :=
    ⟨centeredCube_subset_closedCube (0 : SpatialCoordinates d) one_pos⟩
  have hA : ∀ᵐ x ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), ∀ hx : x ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)),
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val x =
        cutoffCoefficient M H omega K x / 1 :=
    normalizedContinuousPositiveCoefficient_coeFn _ _ _ 1 one_pos
  have hB : ∀ᵐ x ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), ∀ hx : x ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)),
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos).val x =
        cutoffCoefficient M (fun _ => 0) omega K x / 1 :=
    normalizedContinuousPositiveCoefficient_coeFn _ _ _ 1 one_pos
  have hfac : ∀ x, cutoffCoefficient M H omega K x =
      cutoffCoefficient M (fun _ => 0) omega K x * Real.exp (H omega x) := by
    intro x
    unfold cutoffCoefficient cutoffPotential
    simp only [ContinuousMap.zero_apply, zero_add]
    rw [show H omega x + (∑ j ∈ Finset.range (K + 1), omega (-(Int.ofNat j)) x) -
        (↑K + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P =
        ((∑ j ∈ Finset.range (K + 1), omega (-(Int.ofNat j)) x) -
        (↑K + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) + H omega x by ring,
      Real.exp_add, mul_assoc]
  have hboth : ∀ᵐ x ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)),
      Real.exp (-ε) * (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos).val x ≤
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val x ∧
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val x ≤
        Real.exp ε * (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos).val x := by
    filter_upwards [hA, hB, ae_restrict_mem
      (centeredCube (0 : SpatialCoordinates d) 1 one_pos).isOpen.measurableSet] with x ha hb hx
    rw [ha hx, hb hx, div_one, div_one, hfac x]
    have hpos := (cutoffCoefficient_pos M (fun _ => 0) omega K x).le
    have hbnd := abs_le.mp (hε x hx)
    constructor
    · simpa only [mul_comm] using mul_le_mul_of_nonneg_left
        (Real.exp_le_exp.mpr hbnd.1) hpos
    · simpa only [mul_comm] using mul_le_mul_of_nonneg_left
        (Real.exp_le_exp.mpr hbnd.2) hpos
  exact ⟨hboth.mono fun _ h => h.1, hboth.mono fun _ h => h.2⟩

theorem aux_lem_band_U2E_H_global_arith {Jhee Jhe0 Jh0e J0ee J0e0 J00e nn DH NH D0 N0 E vol : ℝ}
    (he : nn = 1) (hvol : vol = 1) (hJH : Jhee + nn = Jhe0 + Jh0e) (hJ0 : J0ee + nn = J0e0 + J00e)
    (hDH : Jhe0 = DH / 2) (hNH : Jh0e = NH / (2 * vol))
    (hD0 : J0e0 = D0 / 2) (hN0 : J00e = N0 / (2 * vol))
    (hD : DH ≤ E * D0) (hN : NH ≤ E * N0) :
    Jhee ≤ E * J0ee + (E - 1) := by
  subst he hvol
  have h1 : Jhee = DH / 2 + NH / 2 - 1 := by
    rw [hDH, hNH] at hJH; linarith only [hJH]
  have h2 : J0ee = D0 / 2 + N0 / 2 - 1 := by
    rw [hD0, hN0] at hJ0; linarith only [hJ0]
  rw [h1, h2]
  linarith only [hD, hN]

theorem aux_lem_band_U2E_H_global {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (omega : BilateralField d) (K : ℕ) (ε : ℝ)
    (hε : ∀ x ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), |H omega x| ≤ ε)
    (e : Homogenization.Vec d) (he : Homogenization.vecNormSq e = 1) :
    Ch02.responseJ (Ch02.cubeDomain (Homogenization.originCube d 0))
      ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0)) e e ≤
      Real.exp ε * Ch02.responseJ (Ch02.cubeDomain (Homogenization.originCube d 0))
        ((aux_lem_band_U2_unitChart I M (fun _ => 0) omega K).coeffOn
          (Homogenization.originCube d 0)) e e + (Real.exp ε - 1) := by
  obtain ⟨hl, hu⟩ := aux_lem_band_U2E_cutoff_compare M H omega K ε hε
  have hD := (dirichletResponse_exp_comparison
    (killedResponseSpace (aux_matched_root_poincare (d := d)).1)
    (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos)
    (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos)
    (affineSobolev (centeredCube_isBounded (0 : SpatialCoordinates d)
      (by norm_num : (0 : ℝ) < 1)) e 0) ε hl hu).2
  have hN := (inverseResponse_exp_comparison
    (meanZeroResponseSpace (aux_lem_band_U2_root_poincareN (d := d)))
    (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos)
    (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos)
    ((affineNeumannLoad e).comp (subspaceGradient (meanZeroSobolevGraph
      (centeredCube (0 : SpatialCoordinates d) 1 one_pos)))) ε hl hu).2
  change affineDirichletResponse _ _ _ e ≤ Real.exp ε * affineDirichletResponse _ _ _ e at hD
  change affineInverseNeumannResponse _ _ e ≤ Real.exp ε * affineInverseNeumannResponse _ _ e at hN
  exact aux_lem_band_U2E_H_global_arith he
    (aux_chart_transfer_root_volume (d := d))
    (aux_lem_band_U2E_response_split _ _
      (aux_lem_band_U2_chart_symm I 0 1 one_pos
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos)) e)
    (aux_lem_band_U2E_response_split _ _
      (aux_lem_band_U2_chart_symm I 0 1 one_pos
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M (fun _ => 0) omega K 0 one_pos)) e)
    (aux_lem_band_U2_JD_eq I M H omega K e) (aux_lem_band_U2E_JN_eq I M H K e omega)
    (aux_lem_band_U2_JD_eq I M (fun _ => 0) omega K e)
    (aux_lem_band_U2E_JN_eq I M (fun _ => 0) K e omega) hD hN

theorem aux_lem_band_U2E_chart_AEEq_of_eq {d : ℕ} [NeZero d]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (omega : BilateralField d) (K : ℕ)
    (g : SpatialCoordinates d → ℝ)
    (heq : ∀ x, cutoffCoefficient M H omega K x = g x)
    (hbData : SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData
      (Ch02.cubeDomain (Homogenization.originCube d 0)) g) :
    Ch02.CoeffOn.AEEq
      ((aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0))
      hbData.toCoeffOn := by
  set A := (aux_lem_band_U2_unitChart I M H omega K).coeffOn (Homogenization.originCube d 0) with hAdef
  have h1 := I.chart_eq 0 1 one_pos (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos) 0 1
    one_pos subset_rfl (Homogenization.originCube d 0) subset_rfl
  have h2 : ∀ᵐ y ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), ∀ hy : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)),
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val y =
        cutoffCoefficient M H omega K y / 1 := by
    have : Fact ((centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) ⊆
        closedCube (0 : SpatialCoordinates d) 1 one_pos) :=
      ⟨centeredCube_subset_closedCube (0 : SpatialCoordinates d) one_pos⟩
    exact normalizedContinuousPositiveCoefficient_coeFn _ _ _ 1 one_pos
  have hcar := aux_chart_transfer_root_carrier (d := d)
  have h2' : ∀ᵐ y ∂volume.restrict (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      ∀ hy : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
      (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K 0 one_pos).val y =
        cutoffCoefficient M H omega K y / 1 := by
    rw [← hcar]; exact h2
  have hA : ∀ᵐ y ∂volumeMeasureOn (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      A.toCoeffField y = Homogenization.scalarMatrix (cutoffCoefficient M H omega K y) := by
    filter_upwards [h1, h2', ae_restrict_mem
      (Homogenization.measurableSet_openCubeSet (Homogenization.originCube d 0))] with y hy1 hy2 hym
    rw [hAdef]
    unfold aux_lem_band_U2_unitChart
    rw [hy1]
    have hy0 : (fun i => (0 : SpatialCoordinates d) i + 1 * y i) = y := by funext i; simp
    have hyc : y ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) := by
      rw [hcar]; exact hym
    rw [hy0, hy2 hyc, div_one]
  unfold Ch02.CoeffOn.AEEq
  simpa only [SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData.toCoeffOn,
    SubdiffusiveProcess.CoarseGrainingVocab.scalarCoeffField, heq] using! hA

theorem aux_lem_band_U2E_cutoff_factor {d : ℕ}
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (omega : BilateralField d) (K : ℕ) (x : SpatialCoordinates d) :
    cutoffCoefficient M H omega K x =
      cutoffCoefficient M (fun _ => 0) omega K x * Real.exp (H omega x) := by
  unfold cutoffCoefficient cutoffPotential
  simp only [ContinuousMap.zero_apply, zero_add]
  rw [show H omega x + (∑ j ∈ Finset.range (K + 1), omega (-(Int.ofNat j)) x) -
      (↑K + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P =
      ((∑ j ∈ Finset.range (K + 1), omega (-(Int.ofNat j)) x) -
      (↑K + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) + H omega x by ring,
    Real.exp_add, mul_assoc]

theorem aux_lem_band_U2E_H0_defect {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (omega : BilateralField d) (K : ℕ)
    (e : Homogenization.Vec d) (he : Homogenization.vecNormSq e = 1) :
    Ch02.responseJ (Ch02.cubeDomain (Homogenization.originCube d 0))
      ((aux_lem_band_U2_unitChart I M (fun _ => 0) omega K).coeffOn
        (Homogenization.originCube d 0)) e e ≤
      Rm.defect K 0 (aux_lem_band_U2_shift (K : ℤ) 0 omega) := by
  let g : SpatialCoordinates d → ℝ := fun z =>
    (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ *
      Rm.coeffScalar K (aux_lem_band_U2_shift (K : ℤ) 0 omega) ((3 : ℝ) ^ K • z)
  obtain ⟨hc, hp⟩ := aux_lem_band_U2E_a0_cont_pos M Rm
    (aux_lem_band_U2_shift (K : ℤ) 0 omega) K
  obtain ⟨data⟩ := SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos
    hc hp (Ch02.cubeDomain (Homogenization.originCube d 0))
  have heq : ∀ x, cutoffCoefficient M (fun _ => 0) omega K x = g x := by
    intro x
    apply mul_right_cancel₀ (Real.exp_ne_zero (H omega x))
    rw [← aux_lem_band_U2E_cutoff_factor M H omega K x]
    exact aux_lem_band_U2E_coeff_eq M H hH Rm omega K x
  have hAE := aux_lem_band_U2E_chart_AEEq_of_eq I M (fun _ => 0) omega K g heq data
  rw [Ch02.responseJ_eq_ofAEEq hAE]
  exact aux_lem_band_U2E_dilate_reduction M Rm omega K data e he

theorem aux_lem_band_U2E_entries_envelope {d : ℕ}
    (U : Ch02.Domain d) (a : Ch02.CoeffOn U) (ha : Ch02.CoeffOn.IsSymmetric a)
    (F : ℝ) (hF : 0 ≤ F)
    (hJ : ∀ e : Homogenization.Vec d, Homogenization.vecNormSq e = 1 →
      Ch02.responseJ U a e e ≤ F) (i j : Fin d) :
    |Ch02.sigmaStarInvCoarse U a i j - (if i = j then (1 : ℝ) else 0)| ≤
        2 * Real.sqrt 6 * (Real.sqrt F + F) ∧
      |Ch02.sigmaCoarse U a i j - (if i = j then (1 : ℝ) else 0)| ≤
        2 * Real.sqrt 6 * (Real.sqrt F + F) := by
  let B : ℝ := Real.sqrt 6 * (Real.sqrt F + F)
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hrate : ∀ e : Homogenization.Vec d, Homogenization.vecNormSq e = 1 →
      aux_lem_band_U2E_rate (Ch02.responseJ U a e e) ≤ B := by
    intro e he
    exact (aux_lem_band_U2E_rate_mono (Ch02.responseJ_nonneg U a e e) (hJ e he)).trans
      (aux_lem_band_U2E_rate_le F hF)
  have hsingle : ∀ k : Fin d, Homogenization.vecNormSq (Pi.single k (1 : ℝ)) = 1 := by
    intro k
    show Homogenization.vecDot (Pi.single k (1 : ℝ)) (Pi.single k (1 : ℝ)) = 1
    rw [aux_lem_band_U2E_single_dot]
    simp
  have hdiag : ∀ k : Fin d,
      |Ch02.sigmaCoarse U a k k - 1| ≤ B ∧ |Ch02.sigmaStarInvCoarse U a k k - 1| ≤ B := by
    intro k
    have hh := aux_lem_band_U2E_two_sided U a ha (Pi.single k 1) (hsingle k)
    rw [aux_lem_band_U2E_quad_diag, aux_lem_band_U2E_quad_diag] at hh
    exact ⟨hh.1.trans (hrate _ (hsingle k)), hh.2.trans (hrate _ (hsingle k))⟩
  have hfinal : 2 * Real.sqrt 6 * (Real.sqrt F + F) = 2 * B := by dsimp [B]; ring
  rw [hfinal]
  by_cases hij : i = j
  · subst j
    simp only [ite_true]
    constructor <;> nlinarith [(hdiag i).1, (hdiag i).2]
  · simp only [ite_eq_right hij, sub_zero]
    have hD := (aux_lem_band_U2E_entries U a ha i j hij).2.2
    have hN := (aux_lem_band_U2E_entries_starInv U a ha i j hij).2.2
    have hhalf : (1 / 2 : ℝ) * Ch02.responseJ U a
        (Pi.single i 1 + Pi.single j 1) (Pi.single i 1 + Pi.single j 1) =
        Ch02.responseJ U a ((Real.sqrt 2)⁻¹ • (Pi.single i 1 + Pi.single j 1))
          ((Real.sqrt 2)⁻¹ • (Pi.single i 1 + Pi.single j 1)) := by
      rw [Ch02.responseJ_smul, inv_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
      norm_num
    rw [hhalf] at hD hN
    have hOff := hrate _ (aux_lem_band_U2E_offdiag_unit i j hij)
    have hi := hrate _ (hsingle i)
    have hj := hrate _ (hsingle j)
    constructor <;> nlinarith

theorem aux_lem_band_U2E_envelope_moment
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X D : Ω → ℝ) (hXm : Measurable X) (hDm : AEStronglyMeasurable D μ)
    (_hX0 : ∀ o, 0 ≤ X o) (_hD0 : ∀ o, 0 ≤ D o)
    (q δ Cx Cd : ℝ) (hq : 1 ≤ q) (hδ0 : 0 < δ) (hδ1 : δ ≤ 1)
    (hCx : 0 ≤ Cx) (hCd : 0 ≤ Cd)
    (hE : eLpNorm (fun o => Real.exp (X o) - 1) (ENNReal.ofReal (2 * q)) μ ≤
      ENNReal.ofReal (Cx * δ))
    (hD : eLpNorm D (ENNReal.ofReal (2 * q)) μ ≤ ENNReal.ofReal (Cd * δ ^ 2)) :
    eLpNorm (fun o => Real.exp (X o) * D o + (Real.exp (X o) - 1))
      (ENNReal.ofReal q) μ ≤ ENNReal.ofReal (((Cx + 1) * Cd + Cx) * δ) := by
  have hq0 : 0 < q := by linarith
  have hp : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := ENNReal.one_le_ofReal.mpr hq
  have hp2 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 * q) :=
    ENNReal.one_le_ofReal.mpr (by linarith)
  have hm : AEStronglyMeasurable (fun o => Real.exp (X o)) μ := hXm.exp.aestronglyMeasurable
  have hem : AEStronglyMeasurable (fun o => Real.exp (X o) - 1) μ :=
    hm.sub aestronglyMeasurable_const
  have hE1 : eLpNorm (fun o => Real.exp (X o) - 1) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (Cx * δ) :=
    (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith))).trans hE
  have hExp : eLpNorm (fun o => Real.exp (X o)) (ENNReal.ofReal (2 * q)) μ ≤
      ENNReal.ofReal (Cx + 1) := by
    have heq : (fun o => Real.exp (X o)) = (fun o => Real.exp (X o) - 1) +
        (fun _ : Ω => (1 : ℝ)) := by funext o; simp
    rw [heq]
    calc _ ≤ eLpNorm (fun o => Real.exp (X o) - 1) (ENNReal.ofReal (2 * q)) μ +
          eLpNorm (fun _ : Ω => (1 : ℝ)) (ENNReal.ofReal (2 * q)) μ :=
        eLpNorm_add_le hp2
      _ ≤ ENNReal.ofReal (Cx * δ) + ENNReal.ofReal 1 := by
        apply add_le_add hE
        rw [eLpNorm_const _ (by positivity : ENNReal.ofReal (2 * q) ≠ 0) (NeZero.ne μ),
          measure_univ, ENNReal.one_rpow, mul_one]
        simp
      _ = ENNReal.ofReal (Cx * δ + 1) :=
        (ENNReal.ofReal_add (mul_nonneg hCx hδ0.le) zero_le_one).symm
      _ ≤ ENNReal.ofReal (Cx + 1) :=
        ENNReal.ofReal_le_ofReal (add_le_add (by simpa using mul_le_mul_of_nonneg_left hδ1 hCx) le_rfl)
  have hprod : eLpNorm (fun o => Real.exp (X o) * D o) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal ((Cx + 1) * (Cd * δ ^ 2)) := by
    refine (aux_lem_band_eLpNorm_mul_double (mu := μ) hq0 hm hDm).trans ?_
    simpa only [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
      ← ENNReal.ofReal_mul (by positivity : 0 ≤ Cx + 1)] using mul_le_mul' hExp hD
  calc _ ≤ eLpNorm (fun o => Real.exp (X o) * D o) (ENNReal.ofReal q) μ +
          eLpNorm (fun o => Real.exp (X o) - 1) (ENNReal.ofReal q) μ :=
        eLpNorm_add_le hp
    _ ≤ ENNReal.ofReal ((Cx + 1) * (Cd * δ ^ 2)) + ENNReal.ofReal (Cx * δ) :=
        add_le_add hprod hE1
    _ = ENNReal.ofReal ((Cx + 1) * (Cd * δ ^ 2) + Cx * δ) :=
        (ENNReal.ofReal_add (by positivity) (by positivity)).symm
    _ ≤ ENNReal.ofReal (((Cx + 1) * Cd + Cx) * δ) := by
        apply ENNReal.ofReal_le_ofReal
        have hs : δ ^ 2 ≤ δ := by nlinarith
        have hm' := mul_le_mul_of_nonneg_left hs (mul_nonneg (by positivity : 0 ≤ Cx + 1) hCd)
        nlinarith

theorem aux_lem_band_U2E_sqrt_envelope_moment
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (F : Ω → ℝ) (hFm : AEStronglyMeasurable F μ) (hF0 : ∀ o, 0 ≤ F o)
    (q δ B : ℝ) (hq : 1 ≤ q) (hδ0 : 0 ≤ δ) (hδ1 : δ ≤ 1) (hB : 0 ≤ B)
    (hF : eLpNorm F (ENNReal.ofReal q) μ ≤ ENNReal.ofReal (B * δ)) :
    eLpNorm (fun o => 2 * Real.sqrt 6 * (Real.sqrt (F o) + F o))
      (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (2 * Real.sqrt 6 * (Real.sqrt B + B) * Real.sqrt δ) := by
  have hq0 : 0 < q := by linarith
  have hSq : eLpNorm (fun o => Real.sqrt (F o)) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (Real.sqrt B * Real.sqrt δ) := by
    have heq : (fun o => Real.sqrt (F o)) = fun o => ‖F o‖ ^ (1 / 2 : ℝ) := by
      funext o
      rw [Real.norm_of_nonneg (hF0 o), Real.sqrt_eq_rpow]
    rw [heq, eLpNorm_norm_rpow _ hFm (by norm_num)]
    calc _ ≤ eLpNorm F (ENNReal.ofReal q) μ ^ (1 / 2 : ℝ) := by
          refine ENNReal.rpow_le_rpow ?_ (by norm_num)
          apply eLpNorm_le_eLpNorm_of_exponent_le _
          rw [← ENNReal.ofReal_mul hq0.le]
          exact ENNReal.ofReal_le_ofReal (by linarith)
      _ ≤ ENNReal.ofReal (B * δ) ^ (1 / 2 : ℝ) := ENNReal.rpow_le_rpow hF (by norm_num)
      _ = ENNReal.ofReal (Real.sqrt B * Real.sqrt δ) := by
          rw [ENNReal.ofReal_rpow_of_nonneg (mul_nonneg hB hδ0) (by norm_num),
            ← Real.sqrt_eq_rpow, Real.sqrt_mul hB]
  have hδs : δ ≤ Real.sqrt δ := by
    apply (Real.le_sqrt hδ0 hδ0).2
    nlinarith
  have hF' : eLpNorm F (ENNReal.ofReal q) μ ≤ ENNReal.ofReal (B * Real.sqrt δ) :=
    hF.trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hδs hB))
  have hC0 : 0 ≤ 2 * Real.sqrt 6 := by positivity
  rw [aux_lem_band_U2_eLpNorm_cmul, abs_of_nonneg hC0]
  have hsum := eLpNorm_add_le (μ := μ) (f := fun o => Real.sqrt (F o)) (g := F) (ENNReal.one_le_ofReal.mpr hq)
  calc _ ≤ ENNReal.ofReal (2 * Real.sqrt 6) *
        (eLpNorm (fun o => Real.sqrt (F o)) (ENNReal.ofReal q) μ +
          eLpNorm F (ENNReal.ofReal q) μ) := mul_le_mul_right hsum _
    _ ≤ ENNReal.ofReal (2 * Real.sqrt 6) *
        (ENNReal.ofReal (Real.sqrt B * Real.sqrt δ) + ENNReal.ofReal (B * Real.sqrt δ)) :=
      mul_le_mul_right (add_le_add hSq hF') _
    _ = ENNReal.ofReal (2 * Real.sqrt 6 * (Real.sqrt B + B) * Real.sqrt δ) := by
      rw [← ENNReal.ofReal_add (by positivity) (by positivity), ← ENNReal.ofReal_mul hC0]
      congr 1
      ring

theorem aux_lem_band_U2E_defect_moments
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rinput : _root_.SubdiffusiveProcess.Paper.in_responses d M)
    (Cresp p : ℝ) (hCresp : 0 < Cresp) (hRC : Rinput.C ≤ Cresp)
    (hscale : 4 * p ≤ Cresp⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹)
    (relab : ℕ → BilateralField d → BilateralField d)
    (hrelabMP : ∀ N, MeasurePreserving (relab N)
      (chaosSampleLaw M).toMeasure (chaosSampleLaw M).toMeasure)
    (N : ℕ) (y : SpatialCoordinates d) :
    (∀ xi : ℝ, 1 ≤ xi → xi ≤ 4 * p →
        MemLp (fun om => Rinput.defect N y (relab N om))
          (ENNReal.ofReal xi) (chaosSampleLaw M).toMeasure) ∧
      (∀ xi : ℝ, 1 ≤ xi → xi ≤ 4 * p →
        eLpNorm (fun om => Rinput.defect N y (relab N om))
            (ENNReal.ofReal xi) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (Cresp * xi * Real.log (2 + xi) * M.delta ^ 2)) := by
  have hbound4 : 4 * p ≤ Rinput.C⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹ := by
    have hCinv : Cresp⁻¹ ≤ Rinput.C⁻¹ := (inv_le_inv₀ hCresp Rinput.C_pos).2 hRC
    calc
      4 * p ≤ Cresp⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹ := hscale
      _ ≤ Rinput.C⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹ := by gcongr
  refine ⟨fun xi hxi hxi4 => ?_, fun xi hxi hxi4 => ?_⟩
  · have hmem := Rinput.defect_memLp xi hxi (hxi4.trans hbound4) N
      y
    simpa [Function.comp_def] using hmem.comp_measurePreserving (hrelabMP N)
  · have hxi_pos : 0 < xi := lt_of_lt_of_le zero_lt_one hxi
    have hmem := Rinput.defect_memLp xi hxi (hxi4.trans hbound4) N
      y
    have hnorm := hmem.eLpNorm_eq_integral_rpow_norm
      (ENNReal.ofReal_pos.mpr hxi_pos).ne' ENNReal.ofReal_ne_top
    have heq : eLpNorm (fun om => Rinput.defect N y (relab N om))
        (ENNReal.ofReal xi) (chaosSampleLaw M).toMeasure =
        eLpNorm (Rinput.defect N y)
          (ENNReal.ofReal xi) (chaosSampleLaw M).toMeasure := by
      simpa [Function.comp_def] using
        eLpNorm_comp_measurePreserving hmem.aestronglyMeasurable (hrelabMP N)
    rw [heq, hnorm]
    apply ENNReal.ofReal_mono
    have hm := Rinput.moment xi hxi (hxi4.trans hbound4) N y
    have hm' : (∫ om, ‖Rinput.defect N y om‖ ^
          (ENNReal.ofReal xi).toReal ∂(chaosSampleLaw M).toMeasure) ^
          ((ENNReal.ofReal xi).toReal)⁻¹ ≤
        Rinput.C * xi * Real.log (2 + xi) * M.delta ^ 2 := by
      simpa [ENNReal.toReal_ofReal hxi_pos.le, Real.norm_eq_abs, one_div,
        abs_of_nonneg (Rinput.defect_nonneg N y _)] using hm
    refine hm'.trans ?_
    have hlogxi : 0 ≤ Real.log (2 + xi) := Real.log_nonneg (by linarith)
    have hstep : Rinput.C * xi * Real.log (2 + xi) ≤ Cresp * xi * Real.log (2 + xi) := by
      have hxl : 0 ≤ xi * Real.log (2 + xi) := mul_nonneg hxi_pos.le hlogxi
      linarith [mul_le_mul_of_nonneg_right hRC hxl]
    nlinarith [hstep, sq_nonneg M.delta]

theorem aux_lem_band_U2_unit_entry_meas {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (K : ℕ) (i j : Fin d) :
    AEStronglyMeasurable (fun omega => aux_lem_band_U2_sigStarInvF i j (aux_lem_band_U2_unitChart I M H omega K))
      (chaosSampleLaw M).toMeasure ∧
    AEStronglyMeasurable (fun omega => aux_lem_band_U2_sigF i j (aux_lem_band_U2_unitChart I M H omega K))
      (chaosSampleLaw M).toMeasure := by
  have hN : ∀ a b : Fin d, AEStronglyMeasurable
      (fun omega => aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) a b) (chaosSampleLaw M).toMeasure :=
    fun a b => aux_lem_band_U2_unit_neumann_meas I M H hH K _
  have hD : ∀ a b : Fin d, AEStronglyMeasurable
      (fun omega => aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) a b) (chaosSampleLaw M).toMeasure :=
    fun a b => aux_lem_band_U2_unit_dirichlet_meas I M H hH K _
  have e1 : (fun omega => aux_lem_band_U2_sigStarInvF i j (aux_lem_band_U2_unitChart I M H omega K)) =
      fun omega => if i = j then (1 / 2 : ℝ) * aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) i i
        else aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) i j -
          (1 / 4 : ℝ) * aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) i i -
          (1 / 4 : ℝ) * aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) j j := by
    funext omega; exact aux_lem_band_U2_sigStarInvF_eq_resp _ i j
  have e2 : (fun omega => aux_lem_band_U2_sigF i j (aux_lem_band_U2_unitChart I M H omega K)) =
      fun omega => if i = j then (1 / 2 : ℝ) * aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) i i
        else aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) i j -
          (1 / 4 : ℝ) * aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) i i -
          (1 / 4 : ℝ) * aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) j j := by
    funext omega
    exact aux_lem_band_U2_sigF_eq_resp _ (aux_lem_band_U2_chart_symm I 0 1 one_pos _) i j
  rw [e1, e2]
  by_cases hij : i = j
  · simp only [ite_eq_left hij]
    exact ⟨(hN i i).const_mul _, (hD i i).const_mul _⟩
  · simp only [ite_eq_right hij]
    exact ⟨((hN i j).sub ((hN i i).const_mul _)).sub ((hN j j).const_mul _),
      ((hD i j).sub ((hD i i).const_mul _)).sub ((hD j j).const_mul _)⟩

theorem aux_lem_band_U2_unit_entry_moment
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (_D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp) :
    ∃ c : ℝ, 0 < c ∧ ∀ q : ℝ, 1 ≤ q → ∃ delta0 C : ℝ, 0 < delta0 ∧ 0 ≤ C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K : ℕ) (i j : Fin d),
        eLpNorm (fun omega => aux_lem_band_U2_sigStarInvF i j (aux_lem_band_U2_unitChart I M H omega K) -
            (if i = j then (1 : ℝ) else 0)) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C * M.delta ^ c) ∧
        eLpNorm (fun omega => aux_lem_band_U2_sigF i j (aux_lem_band_U2_unitChart I M H omega K) -
            (if i = j then (1 : ℝ) else 0)) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C * M.delta ^ c) := by
  obtain ⟨Cinf, hCinf, hExpAll⟩ :=
    exists_uniform_compactExponentialMoment_of_infraredCharacterization hd
  let Kc := closedCube (0 : SpatialCoordinates d) 1 one_pos
  refine ⟨1 / 2, by norm_num, ?_⟩
  intro q hq
  have hq0 : 0 < q := by linarith
  obtain ⟨δ0, hδ0, hδ01, hscale⟩ := aux_lem_band_U2E_small_delta Cresp hCresp q hq0
  let Cx : ℝ := 2 * Real.sqrt (2 * q) *
    Real.exp (Cinf Kc * (Real.sqrt (2 * q) + 2 * q) ^ 2)
  let Cd : ℝ := Cresp * (2 * q) * Real.log (2 + 2 * q)
  let B : ℝ := (Cx + 1) * Cd + Cx
  have hCx : 0 ≤ Cx := by dsimp [Cx]; positivity
  have hlog : 0 ≤ Real.log (2 + 2 * q) := Real.log_nonneg (by linarith)
  have hCd : 0 ≤ Cd := by dsimp [Cd]; positivity
  have hB : 0 ≤ B := by dsimp [B]; positivity
  refine ⟨δ0, 2 * Real.sqrt 6 * (Real.sqrt B + B), hδ0, by positivity, ?_⟩
  intro M hM Rm hRm Sreg It H hH K i j
  have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
  have hδ1 : M.delta ≤ 1 := (hM.trans hδ01.le)
  have hscaleM := hscale M.delta hδpos hM
  let P : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
  let X : BilateralField d → ℝ := fun o => ‖(H o).restrict (Kc : Set (SpatialCoordinates d))‖
  let De : BilateralField d → ℝ := fun o =>
    Rm.defect K 0 (aux_lem_band_U2_shift (K : ℤ) 0 o)
  have hXm : Measurable X :=
    (continuous_norm.comp (ContinuousMap.continuous_restrict
      (Kc : Set (SpatialCoordinates d)))).measurable.comp hH.1
  have hX0 : ∀ o, 0 ≤ X o := fun _ => norm_nonneg _
  have hD0 : ∀ o, 0 ≤ De o := fun o => Rm.defect_nonneg K 0 _
  have hMP : ∀ N : ℕ, MeasurePreserving (aux_lem_band_U2_shift (N : ℤ) 0)
      (chaosSampleLaw M).toMeasure (chaosSampleLaw M).toMeasure :=
    fun N => aux_lem_band_U2_T1_shift_measurePreserving M (N : ℤ) 0
  obtain ⟨hDmem, hDnorm⟩ := aux_lem_band_U2E_defect_moments M Rm Cresp q hCresp hRm hscaleM
    (fun N => aux_lem_band_U2_shift (N : ℤ) 0) hMP K 0
  have h2q : 1 ≤ 2 * q := by linarith
  have h2q4 : 2 * q ≤ 4 * q := by linarith
  have hDm : AEStronglyMeasurable De P := (hDmem (2 * q) h2q h2q4).aestronglyMeasurable
  have hDn : eLpNorm De (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal (Cd * M.delta ^ 2) :=
    hDnorm (2 * q) h2q h2q4
  have hExp : ∀ lam : ℝ, 0 ≤ lam → Integrable (fun o => Real.exp (lam * X o)) P ∧
      (∫ o, Real.exp (lam * X o) ∂P) ≤ 2 * Real.exp (Cinf Kc * lam ^ 2 * M.delta ^ 2) :=
    hExpAll M H hH Kc
  have hEn : eLpNorm (fun o => Real.exp (X o) - 1) (ENNReal.ofReal (2 * q)) P ≤
      ENNReal.ofReal (Cx * M.delta) :=
    aux_neumann_centered_response_expX_norm P X hX0 (Cinf Kc) (hCinf Kc)
      M.delta hδpos hδ1 hExp (2 * q) h2q
  let F : BilateralField d → ℝ := fun o => Real.exp (X o) * De o + (Real.exp (X o) - 1)
  have hFm : AEStronglyMeasurable F P :=
    (hXm.exp.aestronglyMeasurable.mul hDm).add
      (hXm.exp.aestronglyMeasurable.sub aestronglyMeasurable_const)
  have hF0 : ∀ o, 0 ≤ F o := by
    intro o
    have he : 0 ≤ Real.exp (X o) - 1 := sub_nonneg.mpr (Real.one_le_exp (hX0 o))
    exact add_nonneg (mul_nonneg (Real.exp_pos _).le (hD0 o)) he
  have hFn : eLpNorm F (ENNReal.ofReal q) P ≤ ENNReal.ofReal (B * M.delta) :=
    aux_lem_band_U2E_envelope_moment P X De hXm hDm hX0 hD0 q M.delta Cx Cd hq
      hδpos hδ1 hCx hCd hEn hDn
  have hEnv := aux_lem_band_U2E_sqrt_envelope_moment P F hFm hF0 q M.delta B
    hq hδpos.le hδ1 hB hFn
  have hbound : ∀ o, ∀ x ∈ (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), |H o x| ≤ X o := by
    intro o x hx
    exact ContinuousMap.norm_coe_le_norm ((H o).restrict (Kc : Set (SpatialCoordinates d)))
      ⟨x, centeredCube_subset_closedCube (0 : SpatialCoordinates d) one_pos hx⟩
  have hJunif : ∀ o, ∀ e : Homogenization.Vec d, Homogenization.vecNormSq e = 1 →
      Ch02.responseJ (Ch02.cubeDomain (Homogenization.originCube d 0))
        ((aux_lem_band_U2_unitChart I M H o K).coeffOn (Homogenization.originCube d 0)) e e ≤ F o := by
    intro o e he
    have hh := aux_lem_band_U2E_H_global I M H o K (X o) (hbound o) e he
    have h0 := aux_lem_band_U2E_H0_defect I M H hH Rm o K e he
    exact hh.trans (add_le_add
      (mul_le_mul_of_nonneg_left h0 (Real.exp_pos _).le) le_rfl)
  have hpoint := fun o => aux_lem_band_U2E_entries_envelope
    (Ch02.cubeDomain (Homogenization.originCube d 0))
    ((aux_lem_band_U2_unitChart I M H o K).coeffOn (Homogenization.originCube d 0))
    (aux_lem_band_U2_chart_symm I 0 1 one_pos _) (F o) (hF0 o) (hJunif o) i j
  have hnum : ENNReal.ofReal (2 * Real.sqrt 6 * (Real.sqrt B + B) * Real.sqrt M.delta) =
      ENNReal.ofReal (2 * Real.sqrt 6 * (Real.sqrt B + B) * M.delta ^ (1 / 2 : ℝ)) := by
    simp only [Real.sqrt_eq_rpow]
  rw [hnum] at hEnv
  constructor
  · refine (eLpNorm_mono ((aux_lem_band_U2_unit_entry_meas I M H hH K i j).1.sub aestronglyMeasurable_const) (fun o => ?_)).trans hEnv
    have hFo := hF0 o
    simpa only [Real.norm_eq_abs,
      abs_of_nonneg (by positivity : 0 ≤ 2 * Real.sqrt 6 * (Real.sqrt (F o) + F o)),
      aux_lem_band_U2_sigStarInvF, Pi.sub_apply] using! (hpoint o).1
  · refine (eLpNorm_mono ((aux_lem_band_U2_unit_entry_meas I M H hH K i j).2.sub aestronglyMeasurable_const) (fun o => ?_)).trans hEnv
    have hFo := hF0 o
