theorem aux_lem_band_fine_infrared_tail_orlicz {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (R : ℝ) (hR : 0 < R) :
    ∃ A : ℝ, 0 < A ∧ ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K : Compacts (SpatialCoordinates d)),
      (∀ x ∈ (K : Set (SpatialCoordinates d)), ‖x‖ ≤ R) → ∀ h : ℕ,
      (∫⁻ o, ENNReal.ofReal (Real.exp
        ((‖(H o - infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d))‖ /
          (A*M.delta*(1/3:ℝ)^h))^2)) ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨A, hA, hb⟩ := aux_lem_band_fine_layer_orlicz (d := d) R hR
  refine ⟨(3/2)*A, by positivity, ?_⟩
  intro M H hH K hK h
  let : MeasurableSpace C(K, ℝ) := borel _
  let : BorelSpace C(K, ℝ) := ⟨rfl⟩
  have hdelta := M.shellPrefix.delta_pos
  have hs := aux_lem_band_fine_series_orlicz (chaosSampleLaw M).toMeasure
    (aux_lem_band_fine_layer K) (aux_lem_band_fine_layer_meas K)
    (A*M.delta) (by positivity) (hb M K hK)
  have heq : ∀ᵐ o ∂(chaosSampleLaw M).toMeasure,
      (H o - infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d)) =
        ∑' n, aux_lem_band_fine_layer K (n+h) o := by
    filter_upwards [hs.1, hH.2] with o ho hHo
    have hp L : (∑ n ∈ Finset.range L, aux_lem_band_fine_layer K n o) =
        (infraredPartialSum o L).restrict (K : Set (SpatialCoordinates d)) := by
      ext x
      change (∑ n ∈ Finset.range L, aux_lem_band_fine_layer K n o) x =
        (infraredPartialSum o L) (x : SpatialCoordinates d)
      rw [ContinuousMap.sum_apply]
      unfold infraredPartialSum
      rw [ContinuousMap.sum_apply]
      apply Finset.sum_congr rfl
      intro n hn
      rfl
    have hlim := ((ContinuousMap.continuous_restrict (K : Set (SpatialCoordinates d))).tendsto
      (H o)).comp hHo
    have htot : (H o).restrict (K : Set (SpatialCoordinates d)) =
        ∑' n, aux_lem_band_fine_layer K n o := by
      exact tendsto_nhds_unique (by simpa only [Function.comp_def, ← hp] using hlim)
        ho.of_norm.hasSum.tendsto_sum_nat
    have hadd := ho.of_norm.sum_add_tsum_nat_add h
    have he : (H o - infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d)) =
        (H o).restrict (K : Set (SpatialCoordinates d)) -
          (infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d)) := by ext x; rfl
    rw [he, htot, ← hp h]
    exact (eq_sub_iff_add_eq.mpr (by simpa only [add_comm] using hadd)).symm
  have hh := hs.2 h
  have hden : (3/2:ℝ)*(A*M.delta)*(1/3:ℝ)^h = (3/2*A)*M.delta*(1/3:ℝ)^h := by ring
  rw [hden] at hh
  refine (lintegral_congr_ae ?_).trans_le hh
  filter_upwards [heq] with o ho
  rw [ho]

theorem aux_lem_band_fine_exp_small (x a : ℝ) (hx : 0 ≤ x) (ha : 0 < a) (ha1 : a ≤ 1) :
    Real.exp x - 1 ≤ a * Real.exp (2*x/a) := by
  have hbase : Real.exp x - 1 ≤ x*Real.exp x := by
    have hh := mul_le_mul_of_nonneg_left (Real.add_one_le_exp (-x)) (Real.exp_pos x).le
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero] at hh
    nlinarith
  have hxa : x ≤ x/a := (le_div_iff₀ ha).mpr (by nlinarith)
  have hxexp : x ≤ a*Real.exp (x/a) := by
    have hh := (div_le_iff₀ ha).mp ((by linarith [Real.add_one_le_exp (x/a)] : x/a ≤ Real.exp (x/a)))
    nlinarith
  calc Real.exp x - 1 ≤ x*Real.exp x := hbase
    _ ≤ (a*Real.exp (x/a))*Real.exp x := mul_le_mul_of_nonneg_right hxexp (Real.exp_pos _).le
    _ = a*Real.exp (x/a+x) := by rw [mul_assoc, ← Real.exp_add]
    _ ≤ a*Real.exp (2*x/a) := by
      apply mul_le_mul_of_nonneg_left _ ha.le
      apply Real.exp_le_exp.mpr
      calc x / a + x ≤ x / a + x / a := add_le_add le_rfl hxa
        _ = 2 * x / a := by ring

theorem aux_lem_band_fine_envelope_moment {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (V : Ω → ℝ) (hVm : Measurable V) (hV0 : ∀ o, 0 ≤ V o)
    (delta C p : ℝ) (N : ℕ) (hp : 1 ≤ p) (hdelta : 0 < delta)
    (hdelta1 : delta ≤ 1/(8*p))
    (hi : Integrable (fun o => Real.exp (V o/(4*delta))) μ)
    (hb : (∫ o, Real.exp (V o/(4*delta)) ∂μ) ≤ Real.exp (C*((N:ℝ)+1))) :
    MemLp (fun o => Real.exp (V o)) (ENNReal.ofReal p) μ ∧
    eLpNorm (fun o => Real.exp (V o)) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (Real.exp (C*((N:ℝ)+1)/p)) ∧
    eLpNorm (fun o => Real.exp (V o)-1) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (8*p*delta*Real.exp (C*((N:ℝ)+1)/p)) := by
  have hp0 : 0 < p := by linarith
  have hden : 8*p*delta ≤ 1 := by
    have hh := (le_div_iff₀ (by positivity : 0<8*p)).mp hdelta1
    nlinarith
  have hden0 : 0 < 4*delta*p := by positivity
  let Y : Ω → ℝ := fun o => V o / (4*delta*p)
  have heq : (fun o => Real.exp (p*Y o)) = fun o => Real.exp (V o/(4*delta)) := by
    funext o
    congr 1
    dsimp [Y]
    field_simp
  have hiY : Integrable (fun o => Real.exp (p*Y o)) μ := by rw [heq]; exact hi
  have hbY : (∫ o, Real.exp (p*Y o) ∂μ) ≤ Real.exp (p*(C*((N:ℝ)+1)/p)) := by
    rw [heq, mul_div_cancel₀ _ hp0.ne']
    exact hb
  have hY := aux_finite_cutoff_log_abs_majorant_eLpNorm_exp μ Y
    (hVm.div_const _) p hp0 hiY (C*((N:ℝ)+1)/p) hbY
  have hVY o : V o ≤ Y o := by
    apply (le_div_iff₀ hden0).mpr
    have hvo := hV0 o
    nlinarith
  have hnorm : eLpNorm (fun o => Real.exp (V o)) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (Real.exp (C*((N:ℝ)+1)/p)) := by
    refine (eLpNorm_mono hVm.exp.aestronglyMeasurable (fun o => ?_)).trans hY.2
    simpa only [Real.norm_of_nonneg (Real.exp_pos _).le] using Real.exp_le_exp.mpr (hVY o)
  refine ⟨hnorm.trans_lt ENNReal.ofReal_lt_top, hnorm, ?_⟩
  have hpwise o : ‖Real.exp (V o)-1‖ ≤ ‖(8*p*delta)*Real.exp (Y o)‖ := by
    rw [Real.norm_of_nonneg (sub_nonneg.mpr (Real.one_le_exp_iff.mpr (hV0 o))),
      Real.norm_of_nonneg (by positivity)]
    have hh := aux_lem_band_fine_exp_small (V o) (8*p*delta) (hV0 o) (by positivity) hden
    have he : 2*V o/(8*p*delta) = Y o := by dsimp [Y]; field_simp; ring
    rwa [he] at hh
  calc _ ≤ eLpNorm (fun o => (8*p*delta)*Real.exp (Y o)) (ENNReal.ofReal p) μ := eLpNorm_mono (hVm.exp.sub_const 1).aestronglyMeasurable hpwise
    _ = ENNReal.ofReal (8*p*delta)*eLpNorm (fun o => Real.exp (Y o)) (ENNReal.ofReal p) μ := by
      have he : (fun o => (8*p*delta)*Real.exp (Y o)) = (8*p*delta) • (fun o => Real.exp (Y o)) := by
        funext o; rfl
      rw [he, eLpNorm_const_smul, Real.enorm_eq_ofReal (by positivity)]
    _ ≤ ENNReal.ofReal (8*p*delta)*ENNReal.ofReal (Real.exp (C*((N:ℝ)+1)/p)) :=
      mul_le_mul_right hY.2 _
    _ = _ := (ENNReal.ofReal_mul (by positivity)).symm

theorem aux_lem_band_fine_growth_moments (C γ q : ℝ) (_hC : 0 < C)
    (hγ : 0 < γ) (hq : 1 ≤ q) :
    ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 < B ∧ delta0 ≤ 1 ∧
      ∀ {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
        (V : Ω → ℝ), Measurable V → (∀ o, 0 ≤ V o) →
      ∀ delta : ℝ, 0 < delta → delta ≤ delta0 → ∀ N : ℕ,
      Integrable (fun o => Real.exp (V o/(4*delta))) μ →
      (∫ o, Real.exp (V o/(4*delta)) ∂μ) ≤ Real.exp (C*((N:ℝ)+1)) →
      eLpNorm (fun o => Real.exp (2*(V o+delta))) (ENNReal.ofReal (2*q)) μ ≤
        ENNReal.ofReal (B*(3:ℝ)^(γ*(N:ℝ))) ∧
      eLpNorm (fun o => Real.exp (2*(V o+delta))-1) (ENNReal.ofReal q) μ ≤
        ENNReal.ofReal (B*delta*(3:ℝ)^(γ*(N:ℝ))) := by
  let p := max (2*q) (max 1 ((C+1)/(γ*Real.log 3)))
  have hpq : 2*q ≤ p := le_max_left _ _
  have hp : 1 ≤ p := (le_max_left _ _).trans (le_max_right _ _)
  have hp0 : 0 < p := by linarith
  have hlog : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hrate : (C+1)/p ≤ γ*Real.log 3 := by
    have hh : (C+1)/(γ*Real.log 3) ≤ p := (le_max_right _ _).trans (le_max_right _ _)
    have hh' := (div_le_iff₀ (mul_pos hγ hlog)).mp hh
    apply (div_le_iff₀ hp0).mpr
    nlinarith
  let B0 := Real.exp ((C+1)/p)
  have hB0 : 0 < B0 := Real.exp_pos _
  refine ⟨min 1 (1/(16*p)), (16*p+1)*B0, lt_min one_pos (by positivity),
    by positivity, min_le_left _ _, ?_⟩
  intro Ω _ μ _ V hV hV0 delta hd hd0 N hi hb
  have hδ : 2*delta ≤ 1/(8*p) := by
    have hh := (le_div_iff₀ (by positivity : 0<16*p)).mp (hd0.trans (min_le_right _ _))
    apply (le_div_iff₀ (by positivity : 0<8*p)).mpr
    nlinarith
  let W : Ω → ℝ := fun o => 2*(V o+delta)
  have hW : Measurable W := measurable_const.mul (hV.add_const _)
  have he o : W o/(4*(2*delta)) = (1/4:ℝ)+V o/(4*delta) := by
    dsimp [W]; field_simp; ring
  have hei : (fun o => Real.exp (W o/(4*(2*delta)))) =
      (fun o => Real.exp (1/4:ℝ)*Real.exp (V o/(4*delta))) := by
    funext o; rw [he, Real.exp_add]
  have hiW : Integrable (fun o => Real.exp (W o/(4*(2*delta)))) μ := by
    rw [hei]; exact hi.const_mul _
  have hbW : (∫ o, Real.exp (W o/(4*(2*delta))) ∂μ) ≤ Real.exp ((C+1)*((N:ℝ)+1)) := by
    rw [hei, integral_const_mul]
    calc Real.exp (1/4:ℝ)*(∫ o, Real.exp (V o/(4*delta)) ∂μ) ≤
        Real.exp (1/4:ℝ)*Real.exp (C*((N:ℝ)+1)) :=
          mul_le_mul_of_nonneg_left hb (Real.exp_pos _).le
      _ = Real.exp ((1/4:ℝ)+C*((N:ℝ)+1)) := (Real.exp_add _ _).symm
      _ ≤ _ := Real.exp_le_exp.mpr (by have hN : (0:ℝ)≤N := Nat.cast_nonneg N; nlinarith)
  have hh := aux_lem_band_fine_envelope_moment μ W hW
    (fun o => mul_nonneg (by norm_num) (add_nonneg (hV0 o) hd.le)) (2*delta) (C+1) p N hp (by positivity) hδ hiW hbW
  have hG : Real.exp ((C+1)*((N:ℝ)+1)/p) ≤ B0*(3:ℝ)^(γ*(N:ℝ)) := by
    rw [show (C+1)*((N:ℝ)+1)/p = (C+1)/p + ((C+1)/p)*(N:ℝ) by ring,
      Real.exp_add]
    apply mul_le_mul_of_nonneg_left _ hB0.le
    rw [Real.rpow_def_of_pos (by norm_num : (0:ℝ)<3)]
    apply Real.exp_le_exp.mpr
    calc (C+1)/p*(N:ℝ) ≤ (γ*Real.log 3)*(N:ℝ) :=
      mul_le_mul_of_nonneg_right hrate (Nat.cast_nonneg _)
      _ = _ := by ring
  have hBn : B0 ≤ (16*p+1)*B0 := by nlinarith
  have hBdiff : 16*p*B0 ≤ (16*p+1)*B0 := by nlinarith
  constructor
  · refine (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hpq)).trans (hh.2.1.trans ?_)
    apply ENNReal.ofReal_le_ofReal
    exact hG.trans (mul_le_mul_of_nonneg_right hBn (by positivity))
  · have hqp : q ≤ p := by linarith
    refine (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hqp)).trans (hh.2.2.trans ?_)
    apply ENNReal.ofReal_le_ofReal
    calc 8*p*(2*delta)*Real.exp ((C+1)*((N:ℝ)+1)/p) ≤
        8*p*(2*delta)*(B0*(3:ℝ)^(γ*(N:ℝ))) :=
          mul_le_mul_of_nonneg_left hG (by positivity)
      _ = (16*p*B0)*delta*(3:ℝ)^(γ*(N:ℝ)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hBdiff hd.le) (by positivity)

theorem aux_lem_band_fine_tail_moment (A q : ℝ) (hA : 0 < A) (hq : 1 ≤ q) :
    ∃ C : ℝ, 0 < C ∧ ∀ {Ω : Type*} [MeasurableSpace Ω]
      (μ : Measure Ω) [IsProbabilityMeasure μ] (T : Ω → ℝ), Measurable T →
      (∀ o, 0 ≤ T o) → ∀ s : ℝ, 0 < s → s ≤ 1 →
      (∫⁻ o, ENNReal.ofReal (Real.exp ((T o/(A*s))^2)) ∂μ) ≤ 2 →
      eLpNorm (fun o => Real.exp (2*(T o+s))-1) (ENNReal.ofReal q) μ ≤
        ENNReal.ofReal (C*s) := by
  obtain ⟨Co, hCo, hO⟩ := exists_universal_orlicz_eLpNorm_constant
  let B := 2*(A+2)
  let E := (2*Real.exp ((2*q)^2*B^2/4))^(1/(2*q))
  have hB : 0 < B := by dsimp [B]; positivity
  have hE : 0 < E := by dsimp [E]; positivity
  refine ⟨Co*B*Real.sqrt (2*q)*E, by positivity, ?_⟩
  intro Ω _ μ _ T hT hT0 s hs hs1 hor
  let S : Ω → ℝ := fun o => 2*(T o+s)
  have hS : Measurable S := measurable_const.mul (hT.add_const s)
  have hS0 : ∀ o, 0 ≤ S o := fun o => mul_nonneg (by norm_num) (add_nonneg (hT0 o) hs.le)
  have hg : (∫⁻ o, ENNReal.ofReal (Real.exp ((S o/(B*s))^2)) ∂μ) ≤ 2 := by
    let X : Fin 2 → Ω → ℝ := fun i o => if i=0 then 2*T o else 2*s
    let a : Fin 2 → ℝ := fun i => if i=0 then 2*A*s else 4*s
    have hX : ∀ i ∈ (Finset.univ : Finset (Fin 2)), AEStronglyMeasurable (X i) μ := by
      intro i _; fin_cases i <;> dsimp [X]
      · exact (measurable_const.mul hT).aestronglyMeasurable
      · exact aestronglyMeasurable_const
    have hX0 : ∀ i ∈ (Finset.univ : Finset (Fin 2)), ∀ᵐ o ∂μ, 0 ≤ X i o := by
      intro i _; filter_upwards [] with o
      fin_cases i <;> dsimp [X]
      · exact mul_nonneg (by norm_num) (hT0 o)
      · positivity
    have ha : ∀ i ∈ (Finset.univ : Finset (Fin 2)), 0 < a i := by
      intro i _; fin_cases i <;> dsimp [a] <;> positivity
    have hb : ∀ i ∈ (Finset.univ : Finset (Fin 2)),
        (∫⁻ o, ENNReal.ofReal (Real.exp ((X i o/a i)^2)) ∂μ) ≤ 2 := by
      intro i _; fin_cases i
      · change (∫⁻ o, ENNReal.ofReal (Real.exp (((2*T o)/(2*A*s))^2)) ∂μ) ≤ 2
        have he o : (2*T o)/(2*A*s) = T o/(A*s) := by field_simp
        simpa only [he] using hor
      · change (∫⁻ _o : Ω, ENNReal.ofReal (Real.exp (((2*s)/(4*s))^2)) ∂μ) ≤ 2
        have he : (2*s)/(4*s) = (1/2:ℝ) := by field_simp; ring
        rw [he]
        have hh : Real.exp ((1/2:ℝ)^2) ≤ 2 := by
          calc Real.exp ((1/2:ℝ)^2) ≤ Real.exp (Real.log 2) := by
                apply Real.exp_le_exp.mpr
                have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0:ℝ)<2)
                norm_num at hh ⊢; linarith
            _ = 2 := Real.exp_log (by norm_num)
        simpa only [lintegral_const, measure_univ, mul_one, ENNReal.ofReal_ofNat] using
          ENNReal.ofReal_le_ofReal hh
    have hh := lintegral_exp_sq_finset_sum_le μ Finset.univ X a
      Finset.univ_nonempty hX hX0 ha hb
    have he o : (∑ i : Fin 2, X i o)/(∑ i : Fin 2, a i) = S o/(B*s) := by
      simp only [Fin.sum_univ_two]
      dsimp [X,a,S,B]
      congr 1 <;> ring
    simpa only [he] using hh
  have hn := hO μ S (B*s) hS hS0 (by positivity) hg (ENNReal.ofReal (2*q))
    ENNReal.ofReal_ne_top (by simpa only [ENNReal.ofReal_ofNat] using ENNReal.ofReal_le_ofReal (show (2:ℝ)≤2*q by linarith))
  rw [ENNReal.toReal_ofReal (by positivity : 0≤2*q)] at hn
  have hg' : (∫⁻ o, ENNReal.ofReal (Real.exp ((|S o|/(B*s))^2)) ∂μ) ≤ 2 := by
    simpa only [abs_of_nonneg (hS0 _)] using hg
  have he := aux_lem_band_orlicz_exp_norm μ S hS (B*s) B (2*q)
    (by positivity) (by nlinarith) (by positivity) hg'
  have hh := aux_lem_band_ref_exp_baseline_norm μ S hS q
    (Co*(B*s)*Real.sqrt (2*q)) E (by positivity) (by positivity) hn he
  convert hh using 1 ; congr 1 ; ring

theorem aux_lem_band_fine_partial_meas {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)] (h : ℕ) :
    Measurable (fun o : BilateralField d => infraredPartialSum o h) := by
