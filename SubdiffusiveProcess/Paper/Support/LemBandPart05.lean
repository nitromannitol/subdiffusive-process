      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ K h : ℕ, 1 ≤ h → ∀ ei ej : Fin d,
        aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-((w' * (h + 1) : ℕ) : ℤ))
          ((w' * (h + 1) : ℕ) : ℤ) p
          (fun omega => aux_lem_band_U2_sigStarInvF ei ej (aux_lem_band_U2_unitChart I M H omega K) -
            (if ei = ej then (1 : ℝ) else 0))
          (C * M.delta ^ c * (3 : ℝ) ^ (-(a * (h : ℝ)))) := by
  obtain ⟨a, ha, hc2⟩ := aux_lem_band_U2_unit_neumann_band d hd I _Poincare _Extension _Perturbation
    _Sobolev D Cresp hCresp
  refine ⟨a, 1 / 2, ha, by norm_num, 1, one_pos, ?_⟩
  intro p hp
  obtain ⟨δ0, C, hδ0, hC, hc2'⟩ := hc2 p hp
  refine ⟨δ0, 2 * C, hδ0, by positivity, ?_⟩
  intro M hM Rm hRm Sreg It H hH K h _hh ei ej
  have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
  have hε0 : 0 ≤ C * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(a * (h : ℝ))) := by positivity
  let Z : Fin d → Fin d → BilateralField d → ℝ := fun i j omega =>
    aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) i j
  have hZm : ∀ i j, AEStronglyMeasurable (Z i j) (chaosSampleLaw M).toMeasure :=
    fun i j => aux_lem_band_U2_unit_neumann_meas I M H hH K _
  have hZb : ∀ i j, aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-(h : ℤ)) (h : ℤ) p (Z i j)
      (C * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(a * (h : ℝ)))) :=
    fun i j => hc2' M hM Rm hRm Sreg It H hH K h i j
  set c1 : ℝ := if ei = ej then 1 / 2 else 1 with hc1def
  set c2 : ℝ := if ei = ej then 0 else -(1 / 4) with hc2def
  have hlin := aux_lem_band_U2_BA_lin3 hp hε0 (hZm ei ej) (hZm ei ei) (hZm ej ej) (hZb ei ej) (hZb ei ei)
    (hZb ej ej) c1 c2 c2 (-(if ei = ej then (1 : ℝ) else 0))
  have hcoef : (|c1| + |c2| + |c2|) * (C * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(a * (h : ℝ)))) ≤
      2 * C * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(a * (h : ℝ))) := by
    have hc : |c1| + |c2| + |c2| ≤ 2 := by
      rw [hc1def, hc2def]
      split_ifs
      · rw [abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2), abs_zero]; norm_num
      · rw [abs_one, abs_of_neg (by norm_num : -(1 / 4 : ℝ) < 0)]; norm_num
    nlinarith
  have hent : ∀ omega, c1 * Z ei ej omega + c2 * Z ei ei omega + c2 * Z ej ej omega +
      -(if ei = ej then (1 : ℝ) else 0) =
      aux_lem_band_U2_sigStarInvF ei ej (aux_lem_band_U2_unitChart I M H omega K) -
        (if ei = ej then (1 : ℝ) else 0) := by
    intro omega
    rw [aux_lem_band_U2_sigStarInvF_eq_resp (aux_lem_band_U2_unitChart I M H omega K) ei ej]
    rw [hc1def, hc2def]
    split_ifs with hij
    · subst hij; ring
    · ring
  refine aux_lem_band_U2_BA_band_mono (lo' := -(h : ℤ)) (hi' := (h : ℤ)) (by push_cast; omega)
    (by push_cast; omega) ?_
  exact aux_lem_band_U2_BA_mono hcoef (aux_lem_band_U2_BA_congr hent hlin)

theorem aux_lem_band_U2_prod {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (mB : MeasurableSpace Ω) (hmB : mB ≤ mΩ) (X Z : Ω → ℝ)
    (hX : AEStronglyMeasurable[mΩ] X P) (hZ : AEStronglyMeasurable[mΩ] Z P) (z0 : ℝ)
    (q : ℝ) (hq : 1 ≤ q) (B1 D1 D2 ε1 ε2 : ℝ) (hB1 : 0 ≤ B1) (hD1 : 0 ≤ D1) (hD2 : 0 ≤ D2)
    (hε1 : 0 ≤ ε1) (hε2 : 0 ≤ ε2)
    (hXb : eLpNorm X (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal B1)
    (hX1 : eLpNorm (fun o => X o - 1) (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal D1)
    (hZ1 : eLpNorm (fun o => Z o - z0) (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal D2) :
    eLpNorm (fun o => X o * Z o - z0) (ENNReal.ofReal q) P ≤
      ENNReal.ofReal (|z0| * D1 + B1 * D2) ∧
    ((∃ Y1 : Ω → ℝ, AEStronglyMeasurable[mB] Y1 P ∧
        eLpNorm (fun o => X o - 1 - Y1 o) (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal ε1) →
     (∃ Y2 : Ω → ℝ, AEStronglyMeasurable[mB] Y2 P ∧
        eLpNorm (fun o => Z o - z0 - Y2 o) (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal ε2) →
     ∃ Y : Ω → ℝ, AEStronglyMeasurable[mB] Y P ∧
       eLpNorm (fun o => X o * Z o - z0 - Y o) (ENNReal.ofReal q) P ≤
         ENNReal.ofReal (|z0| * ε1 + B1 * ε2 + ε1 * (D2 + ε2))) := by
  let : MeasurableSpace Ω := mΩ
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := ENNReal.one_le_ofReal.mpr hq
  have hmono : ∀ f : Ω → ℝ, AEStronglyMeasurable f P →
      eLpNorm f (ENNReal.ofReal q) P ≤ eLpNorm f (ENNReal.ofReal (2 * q)) P :=
    fun f hf => eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith))
  have hX1m : AEStronglyMeasurable (fun o => X o - 1) P := hX.sub aestronglyMeasurable_const
  have hZ1m : AEStronglyMeasurable (fun o => Z o - z0) P := hZ.sub aestronglyMeasurable_const
  constructor
  · have e : (fun o => X o * Z o - z0) =
        (fun o => z0 * (X o - 1)) + (fun o => X o * (Z o - z0)) := by
      funext o; simp only [Pi.add_apply]; ring
    rw [e]
    calc eLpNorm ((fun o => z0 * (X o - 1)) + (fun o => X o * (Z o - z0))) (ENNReal.ofReal q) P
        ≤ eLpNorm (fun o => z0 * (X o - 1)) (ENNReal.ofReal q) P +
            eLpNorm (fun o => X o * (Z o - z0)) (ENNReal.ofReal q) P :=
          eLpNorm_add_le hq1
      _ ≤ ENNReal.ofReal |z0| * ENNReal.ofReal D1 + ENNReal.ofReal B1 * ENNReal.ofReal D2 := by
          refine add_le_add ?_ ?_
          · rw [aux_lem_band_U2_eLpNorm_cmul]
            exact mul_le_mul_right ((hmono _ hX1m).trans hX1) _
          · exact (aux_lem_band_U2_holder2 P q hq _ _ hX hZ1m).trans (mul_le_mul' hXb hZ1)
      _ = ENNReal.ofReal (|z0| * D1 + B1 * D2) := by
          rw [ENNReal.ofReal_add (mul_nonneg (abs_nonneg _) hD1) (mul_nonneg hB1 hD2),
            ENNReal.ofReal_mul (abs_nonneg _), ENNReal.ofReal_mul hB1]
  · rintro ⟨Y1, hY1m, hY1b⟩ ⟨Y2, hY2m, hY2b⟩
    have hY1a : AEStronglyMeasurable Y1 P := hY1m.mono hmB
    have hY2a : AEStronglyMeasurable Y2 P := hY2m.mono hmB
    refine ⟨fun o => z0 * Y1 o + (1 + Y1 o) * Y2 o,
      (hY1m.const_mul z0).add ((aestronglyMeasurable_const.add hY1m).mul hY2m), ?_⟩
    have hA : AEStronglyMeasurable (fun o => X o - 1 - Y1 o) P := hX1m.sub hY1a
    have hB : AEStronglyMeasurable (fun o => Z o - z0 - Y2 o) P := hZ1m.sub hY2a
    have hY2n : eLpNorm Y2 (ENNReal.ofReal (2 * q)) P ≤ ENNReal.ofReal (D2 + ε2) := by
      have e : Y2 = (fun o => Z o - z0) - (fun o => Z o - z0 - Y2 o) := by
        funext o; simp only [Pi.sub_apply]; ring
      rw [e, ENNReal.ofReal_add hD2 hε2]
      exact (eLpNorm_sub_le (ENNReal.one_le_ofReal.mpr (by linarith))).trans
        (add_le_add hZ1 hY2b)
    have e : (fun o => X o * Z o - z0 - (z0 * Y1 o + (1 + Y1 o) * Y2 o)) =
        ((fun o => z0 * (X o - 1 - Y1 o)) + (fun o => X o * (Z o - z0 - Y2 o))) +
          (fun o => (X o - 1 - Y1 o) * Y2 o) := by
      funext o; simp only [Pi.add_apply]; ring
    rw [e]
    calc eLpNorm (((fun o => z0 * (X o - 1 - Y1 o)) + (fun o => X o * (Z o - z0 - Y2 o))) +
          (fun o => (X o - 1 - Y1 o) * Y2 o)) (ENNReal.ofReal q) P
        ≤ eLpNorm ((fun o => z0 * (X o - 1 - Y1 o)) + (fun o => X o * (Z o - z0 - Y2 o)))
            (ENNReal.ofReal q) P + eLpNorm (fun o => (X o - 1 - Y1 o) * Y2 o) (ENNReal.ofReal q) P :=
          eLpNorm_add_le hq1
      _ ≤ (eLpNorm (fun o => z0 * (X o - 1 - Y1 o)) (ENNReal.ofReal q) P +
            eLpNorm (fun o => X o * (Z o - z0 - Y2 o)) (ENNReal.ofReal q) P) +
            eLpNorm (fun o => (X o - 1 - Y1 o) * Y2 o) (ENNReal.ofReal q) P :=
          add_le_add (eLpNorm_add_le hq1) le_rfl
      _ ≤ (ENNReal.ofReal |z0| * ENNReal.ofReal ε1 + ENNReal.ofReal B1 * ENNReal.ofReal ε2) +
            ENNReal.ofReal ε1 * ENNReal.ofReal (D2 + ε2) := by
          refine add_le_add (add_le_add ?_ ?_) ?_
          · rw [aux_lem_band_U2_eLpNorm_cmul]
            exact mul_le_mul_right ((hmono _ hA).trans hY1b) _
          · exact (aux_lem_band_U2_holder2 P q hq _ _ hX hB).trans (mul_le_mul' hXb hY2b)
          · exact (aux_lem_band_U2_holder2 P q hq _ _ hA hY2a).trans (mul_le_mul' hY1b hY2n)
      _ = ENNReal.ofReal (|z0| * ε1 + B1 * ε2 + ε1 * (D2 + ε2)) := by
          rw [ENNReal.ofReal_add (add_nonneg (mul_nonneg (abs_nonneg _) hε1) (mul_nonneg hB1 hε2))
            (mul_nonneg hε1 (add_nonneg hD2 hε2)),
            ENNReal.ofReal_add (mul_nonneg (abs_nonneg _) hε1) (mul_nonneg hB1 hε2),
            ENNReal.ofReal_mul (abs_nonneg _), ENNReal.ofReal_mul hB1, ENNReal.ofReal_mul hε1]

theorem aux_lem_band_U2_opnorm_le_sum {d : ℕ} (C : Homogenization.Mat d) :
    Homogenization.Book.Ch02.matrixNorm C ≤ ∑ i, ∑ j, |C i j| := by
  unfold Homogenization.Book.Ch02.matrixNorm
  refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun x => ?_)
  have hx : ∀ j, |x j| ≤ ‖x‖ := fun j => by
    have := PiLp.norm_apply_le x j
    rwa [Real.norm_eq_abs] at this
  have hy : ∀ y : EuclideanSpace ℝ (Fin d), ‖y‖ ≤ ∑ i, |y i| := by
    intro y
    rw [EuclideanSpace.norm_eq]
    have h1 : ∑ i, ‖y i‖ ^ 2 ≤ (∑ i, |y i|) ^ 2 := by
      have := Finset.sum_sq_le_sq_sum_of_nonneg (s := Finset.univ) (f := fun i => |y i|)
        (fun i _ => abs_nonneg _)
      simpa [Real.norm_eq_abs, sq_abs] using this
    calc Real.sqrt (∑ i, ‖y i‖ ^ 2) ≤ Real.sqrt ((∑ i, |y i|) ^ 2) := Real.sqrt_le_sqrt h1
      _ = ∑ i, |y i| := Real.sqrt_sq (Finset.sum_nonneg (fun i _ => abs_nonneg _))
  refine (hy _).trans ?_
  have happ : ∀ i, (Matrix.toEuclideanCLM (n := Fin d) (𝕜 := ℝ) C x) i = ∑ j, C i j * x j := by
    intro i
    rfl
  calc ∑ i, |(Matrix.toEuclideanCLM (n := Fin d) (𝕜 := ℝ) C x) i|
      = ∑ i, |∑ j, C i j * x j| := by
        refine Finset.sum_congr rfl (fun i _ => ?_); rw [happ]
    _ ≤ ∑ i, ∑ j, |C i j| * ‖x‖ := by
        refine Finset.sum_le_sum (fun i _ => (Finset.abs_sum_le_sum_abs _ _).trans ?_)
        refine Finset.sum_le_sum (fun j _ => ?_)
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left (hx j) (abs_nonneg _)
    _ = (∑ i, ∑ j, |C i j|) * ‖x‖ := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finset.sum_mul]

theorem aux_lem_band_U2_matrixNorm_lip {d : ℕ} (A B : Homogenization.Mat d) :
    |Homogenization.Book.Ch02.matrixNorm A - Homogenization.Book.Ch02.matrixNorm B| ≤
      ∑ i, ∑ j, |A i j - B i j| := by
  have h1 : |Homogenization.Book.Ch02.matrixNorm A - Homogenization.Book.Ch02.matrixNorm B| ≤
      Homogenization.Book.Ch02.matrixNorm (A - B) := by
    unfold Homogenization.Book.Ch02.matrixNorm
    rw [map_sub]
    exact abs_norm_sub_norm_le _ _
  refine h1.trans ((aux_lem_band_U2_opnorm_le_sum (A - B)).trans (le_of_eq ?_))
  simp only [Matrix.sub_apply]

theorem aux_lem_band_U2_probe_eq_PG {d : ℕ} (R : Homogenization.TriadicCube d)
    (F : Homogenization.Book.Ch02.TriadicCoeffFamily d)
    (hsym : Homogenization.Book.Ch02.CoeffOn.IsSymmetric (F.coeffOn R)) :
    (SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax R F 1).toReal =
      aux_lem_band_U2_PG (Sum.elim
        (fun ij => Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain R)
          (F.coeffOn R) ij.1 ij.2)
        (fun ij => Homogenization.Book.Ch02.sigmaStarInvCoarse (Homogenization.Book.Ch02.cubeDomain R)
          (F.coeffOn R) ij.1 ij.2)) := by
  have T := Homogenization.Book.Ch02.responseSymmetricDirichletNeumannTheory
    (Homogenization.Book.Ch02.cubeDomain R) (F.coeffOn R) hsym
  have hJ : ∀ e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1},
      SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbe R F 1 e.1 =
        (1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j *
          (Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain R)
              (F.coeffOn R) i j +
            Homogenization.Book.Ch02.sigmaStarInvCoarse (Homogenization.Book.Ch02.cubeDomain R)
              (F.coeffOn R) i j) - 1 := by
    intro e
    unfold SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbe SubdiffusiveProcess.CoarseGrainingVocab.J
    rw [Real.sqrt_one, inv_one, one_smul, T.response_dirichlet_neumann_split,
      T.dirichlet_value_by_sigma, T.neumann_value_by_sigmaStarInv]
    have he : Homogenization.vecDot e.1 e.1 = 1 := e.2
    rw [he]
    congr 1
    unfold Homogenization.vecDot Homogenization.matVecMul
    rw [← mul_add, ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  have hfun : (fun e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1} =>
      (ENNReal.ofReal (SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbe R F 1 e.1)).toReal) =
      fun e => max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j *
          (Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain R)
              (F.coeffOn R) i j +
            Homogenization.Book.Ch02.sigmaStarInvCoarse (Homogenization.Book.Ch02.cubeDomain R)
              (F.coeffOn R) i j) - 1) := by
    funext e
    rw [ENNReal.toReal_ofReal', hJ e, max_comm]
  have hiSup : (SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax R F 1).toReal =
      ⨆ e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1},
        (ENNReal.ofReal (SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbe R F 1 e.1)).toReal := by
    unfold SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax
    exact ENNReal.toReal_iSup (fun e => ENNReal.ofReal_ne_top)
  rw [hiSup, hfun]
  rfl

theorem aux_lem_band_U2_PG_one {d : ℕ} [NeZero d] :
    aux_lem_band_U2_PG (d := d) (Sum.elim (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)
      (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)) = 0 := by
  unfold aux_lem_band_U2_PG
  have hval : ∀ e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1},
      max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j *
        ((Sum.elim (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)
          (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)) (Sum.inl (i, j)) +
        (Sum.elim (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)
          (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)) (Sum.inr (i, j))) - 1) = 0 := by
    intro e
    have hs : ∑ i, ∑ j, e.1 i * e.1 j *
        ((Sum.elim (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)
          (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)) (Sum.inl (i, j)) +
        (Sum.elim (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)
          (fun ij : Fin d × Fin d => if ij.1 = ij.2 then (1 : ℝ) else 0)) (Sum.inr (i, j))) =
        2 * Homogenization.vecNormSq e.1 := by
      unfold Homogenization.vecNormSq Homogenization.vecDot
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [Sum.elim_inl, Sum.elim_inr]
      rw [Finset.sum_eq_single i]
      · simp; ring
      · intro j _ hji; simp [Ne.symm hji]
      · intro h; exact absurd (Finset.mem_univ i) h
    rw [hs, e.2]; norm_num
  have hS : ∀ S : Set ℝ, (∀ x ∈ S, x = 0) → sSup S = 0 := by
    intro S hS0
    refine le_antisymm (Real.sSup_nonpos (fun x hx => (hS0 x hx).le))
      (Real.sSup_nonneg (fun x hx => (hS0 x hx).ge))
  apply hS
  rintro _ ⟨e, rfl⟩
  exact hval e

