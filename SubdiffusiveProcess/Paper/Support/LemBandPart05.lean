theorem aux_lem_band_U2_num_mom (δ c cm Cr Cm C1 Cf g z : ℝ)
    (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (hc1 : c ≤ 1) (hccm : c ≤ cm)
    (hCr : 0 ≤ Cr) (hCm : 0 ≤ Cm) (hC1 : 0 ≤ C1) (hCf : 0 ≤ Cf) (hg : 0 ≤ g) (hz : |z| ≤ 1) :
    |z| * (Cr * δ * g) + Cr * g * (Cm * δ ^ cm) ≤ (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g := by
  have hδc : δ ≤ δ ^ c := by
    have := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 hc1
    rwa [Real.rpow_one] at this
  have hδcm : δ ^ cm ≤ δ ^ c := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 hccm
  have hδcpos : 0 ≤ δ ^ c := Real.rpow_nonneg hδ0.le _
  have A : |z| * (Cr * δ * g) ≤ Cr * δ ^ c * g := by
    calc |z| * (Cr * δ * g) ≤ 1 * (Cr * δ * g) :=
          mul_le_mul_of_nonneg_right hz (by positivity)
      _ = Cr * δ * g := one_mul _
      _ ≤ Cr * δ ^ c * g := by gcongr
  have B : Cr * g * (Cm * δ ^ cm) ≤ Cr * g * (Cm * δ ^ c) := by gcongr
  have e : (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g =
      Cr * δ ^ c * g + Cr * g * (Cm * δ ^ c) + (Cr * (1 + 2 * C1) + Cf) * δ ^ c * g := by ring
  have hrest : 0 ≤ (Cr * (1 + 2 * C1) + Cf) * δ ^ c * g := by positivity
  rw [e]; linarith

theorem aux_lem_band_U2_num_band (δ c c1 cm u v t Cr Cm C1 Cf g z : ℝ)
    (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (hc1 : c ≤ 1) (hcc1 : c ≤ c1) (_hccm : c ≤ cm)
    (hc1pos : 0 ≤ c1) (hcmpos : 0 ≤ cm)
