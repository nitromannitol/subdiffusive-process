  refine aux_lem_band_U2_BA_band_mono (by omega) hw' (aux_lem_band_U2_BA_mono ?_ (hband h hkh))
  have h3 : (3 : ℝ) ^ (-(a1 * (h : ℝ))) ≤ (3 : ℝ) ^ (-(a2 * (h : ℝ))) :=
    aux_lem_band_U2_rpow_mono_exp (by have : (0 : ℝ) ≤ h := Nat.cast_nonneg h; nlinarith)
  have h30 : 0 ≤ (3 : ℝ) ^ (-(a1 * (h : ℝ))) := Real.rpow_nonneg (by norm_num) _
  calc C1 * δ ^ c1 * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(a1 * (h : ℝ)))
      ≤ C2 * δ ^ c2 * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(a1 * (h : ℝ))) :=
