      T.neumann_value_by_sigmaStarInv, hσ, hh.1]
    simp only [Homogenization.matVecMul_one, vecDot_zero_right, vecDot_zero_left, mul_zero, zero_add, sub_zero]

theorem aux_lem_band_fine_response_ratio {d : ℕ} {U : Ch02.Domain d}
    {a b : Vec d → ℝ} (ha : ScalarCoeffOnData U a) (hb : ScalarCoeffOnData U b)
    {ε : ℝ} (hε : 0 < ε)
    (hupper : ∀ᵐ x ∂ volumeMeasureOn (U : Set (Vec d)), b x ≤ Real.exp ε * a x)
    (hlower : ∀ᵐ x ∂ volumeMeasureOn (U : Set (Vec d)), Real.exp (-ε) * a x ≤ b x)
    (p q : Vec d) (hpq : vecDot p q = 0) :
    |Ch02.responseJ U hb.toCoeffOn p q - Ch02.responseJ U ha.toCoeffOn p q| ≤
      56 * (Real.exp (2*ε) - 1) * Ch02.responseJ U ha.toCoeffOn p q := by
  have hX0 := Ch02.responseJ_nonneg U ha.toCoeffOn p q
  have hY0 := Ch02.responseJ_nonneg U hb.toCoeffOn p q
  by_cases hs : ε ≤ Real.log 2
  · have hh := aux_continuity_responseJ_ratio ha hb hε hs hupper hlower p q
    simp only [hpq, abs_zero, add_zero] at hh
    exact hh.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (sub_le_sub_right (Real.exp_le_exp.mpr (by linarith)) 1)
        (by norm_num)) hX0)
  · have hE : 2 ≤ Real.exp ε := by
      have hh := Real.exp_le_exp.mpr (le_of_not_ge hs)
      simpa only [Real.exp_log (by norm_num : (0:ℝ)<2)] using hh
    have hE2 : Real.exp (2*ε) = Real.exp ε ^ 2 := by
      rw [show 2*ε = ε+ε by ring, Real.exp_add, sq]
    obtain ⟨hba, hab⟩ := aux_continuity_scalarRatioLInf_le_of_ratio_bound ha hb hε.le hupper hlower
    have hba0 := scalarRatioLInf_nonneg U b a
    have hab0 := scalarRatioLInf_nonneg U a b
    have hsq : scalarRatioLInf U a b ^ 2 + scalarRatioLInf U b a ^ 2 ≤
        2*(Real.exp ε-1)^2 := by
      nlinarith [sq_le_sq₀ hab0 (by linarith : 0≤Real.exp ε-1) |>.mpr hab,
        sq_le_sq₀ hba0 (by linarith : 0≤Real.exp ε-1) |>.mpr hba]
    have hsens := aux_continuity_responseJ_sensitivity_one ha hb one_pos le_rfl p q
    simp only [hpq, add_zero] at hsens
    norm_num only at hsens
    have hYX : Ch02.responseJ U hb.toCoeffOn p q ≤
        (2+6*(Real.exp ε-1)^2)*Ch02.responseJ U ha.toCoeffOn p q := by
      have hh := mul_le_mul_of_nonneg_right hsq hX0
      nlinarith [hsens]
    have hc : 2+6*(Real.exp ε-1)^2 ≤ 56*(Real.exp (2*ε)-1) := by
      rw [hE2]
      nlinarith [sq_nonneg (Real.exp ε-1)]
    have hc1 : 1 ≤ 56*(Real.exp (2*ε)-1) := by
      rw [hE2]
      nlinarith
    have hYb := hYX.trans (mul_le_mul_of_nonneg_right hc hX0)
    have hXb := mul_le_mul_of_nonneg_right hc1 hX0
    rw [abs_le]
    constructor <;> nlinarith

theorem aux_lem_band_fine_response_ratio_left {d : ℕ} {U : Ch02.Domain d}
    {a b : Vec d → ℝ} (ha : ScalarCoeffOnData U a) (hb : ScalarCoeffOnData U b)
    {ε : ℝ} (hε : 0 < ε)
    (hupper : ∀ᵐ x ∂ volumeMeasureOn (U : Set (Vec d)), b x ≤ Real.exp ε * a x)
    (hlower : ∀ᵐ x ∂ volumeMeasureOn (U : Set (Vec d)), Real.exp (-ε) * a x ≤ b x)
    (q : Vec d) :
    |Ch02.responseJ U hb.toCoeffOn 0 q - Ch02.responseJ U ha.toCoeffOn 0 q| ≤
      56 * (Real.exp (2*ε) - 1) * Ch02.responseJ U ha.toCoeffOn 0 q :=
  aux_lem_band_fine_response_ratio ha hb hε hupper hlower 0 q (vecDot_zero_left q)

theorem aux_lem_band_fine_sigmaStarInvEntry {d : ℕ} {U : Ch02.Domain d}
    {a b : Vec d → ℝ} (ha : ScalarCoeffOnData U a) (hb : ScalarCoeffOnData U b)
    {ε : ℝ} (hε : 0 < ε)
    (hupper : ∀ᵐ x ∂ volumeMeasureOn (U : Set (Vec d)), b x ≤ Real.exp ε * a x)
    (hlower : ∀ᵐ x ∂ volumeMeasureOn (U : Set (Vec d)), Real.exp (-ε) * a x ≤ b x)
    (i j : Fin d) :
    |Ch02.sigmaStarInvEntry U hb.toCoeffOn i j - Ch02.sigmaStarInvEntry U ha.toCoeffOn i j| ≤
      168 * (Real.exp (2*ε) - 1) * (Ch02.responseJ U ha.toCoeffOn 0 (Pi.single i 1) +
        Ch02.responseJ U ha.toCoeffOn 0 (Pi.single j 1) +
        Ch02.responseJ U ha.toCoeffOn 0 (Pi.single i 1 + Pi.single j 1)) := by
  have hJnonneg : ∀ v : Vec d, 0 ≤ Ch02.responseJ U ha.toCoeffOn 0 v :=
    fun v => Ch02.responseJ_nonneg U ha.toCoeffOn 0 v
  have hε0 : 0 ≤ Real.exp (2*ε) - 1 := by have := Real.one_le_exp (by linarith : 0 ≤ 2*ε); linarith
  rw [abs_le]
  by_cases hij : i = j
  · subst hij
    rw [show Ch02.sigmaStarInvEntry U hb.toCoeffOn i i =
          2 * Ch02.responseJ U hb.toCoeffOn 0 (Pi.single i 1) from dite_eq_left rfl,
        show Ch02.sigmaStarInvEntry U ha.toCoeffOn i i =
          2 * Ch02.responseJ U ha.toCoeffOn 0 (Pi.single i 1) from dite_eq_left rfl]
    have h := aux_lem_band_fine_response_ratio_left ha hb hε hupper hlower (Pi.single i 1)
    rw [abs_le] at h
    obtain ⟨h1, h2⟩ := h
    constructor
    · nlinarith [h1, hJnonneg (Pi.single i 1), hJnonneg (Pi.single i 1 + Pi.single i 1)]
    · nlinarith [h2, hJnonneg (Pi.single i 1), hJnonneg (Pi.single i 1 + Pi.single i 1)]
  · rw [show Ch02.sigmaStarInvEntry U hb.toCoeffOn i j =
          Ch02.responseJ U hb.toCoeffOn 0 (Pi.single i 1 + Pi.single j 1) -
            Ch02.responseJ U hb.toCoeffOn 0 (Pi.single i 1) -
            Ch02.responseJ U hb.toCoeffOn 0 (Pi.single j 1) from dite_eq_right hij,
        show Ch02.sigmaStarInvEntry U ha.toCoeffOn i j =
          Ch02.responseJ U ha.toCoeffOn 0 (Pi.single i 1 + Pi.single j 1) -
            Ch02.responseJ U ha.toCoeffOn 0 (Pi.single i 1) -
            Ch02.responseJ U ha.toCoeffOn 0 (Pi.single j 1) from dite_eq_right hij]
    have h1 := aux_lem_band_fine_response_ratio_left ha hb hε hupper hlower (Pi.single i 1)
    have h2 := aux_lem_band_fine_response_ratio_left ha hb hε hupper hlower (Pi.single j 1)
    have h3 := aux_lem_band_fine_response_ratio_left ha hb hε hupper hlower
      (Pi.single i 1 + Pi.single j 1)
    rw [abs_le] at h1 h2 h3
    obtain ⟨h1a, h1b⟩ := h1
    obtain ⟨h2a, h2b⟩ := h2
    obtain ⟨h3a, h3b⟩ := h3
    constructor
    · nlinarith [h1a, h1b, h2a, h2b, h3a, h3b, hJnonneg (Pi.single i 1), hJnonneg (Pi.single j 1),
        hJnonneg (Pi.single i 1 + Pi.single j 1)]
    · nlinarith [h1a, h1b, h2a, h2b, h3a, h3b, hJnonneg (Pi.single i 1), hJnonneg (Pi.single j 1),
        hJnonneg (Pi.single i 1 + Pi.single j 1)]

theorem aux_lem_band_fine_response_ratio_right {d : ℕ} {U : Ch02.Domain d}
    {a b : Vec d → ℝ} (ha : ScalarCoeffOnData U a) (hb : ScalarCoeffOnData U b)
    {ε : ℝ} (hε : 0 < ε)
    (hupper : ∀ᵐ x ∂ volumeMeasureOn (U : Set (Vec d)), b x ≤ Real.exp ε * a x)
