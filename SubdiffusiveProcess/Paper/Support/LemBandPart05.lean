  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have ht0 : (d : ℝ) - 1 < (d : ℝ) - 1 / 2 := by linarith
  have ht1 : (d : ℝ) - 1 / 2 < (d : ℝ) := by linarith
  have hp2 : (2 : ℝ) ≤ max q 2 := le_max_right _ _
  have hqp : q ≤ max q 2 := le_max_left _ _
  have hr : (0 : ℝ) < 1 := one_pos
  have hΩ := centeredCube_isBounded (0 : SpatialCoordinates d) hr
  have hP := (aux_matched_root_poincare (d := d)).1
  have hcube : (centeredCube (0 : SpatialCoordinates d) 1 hr : Set (SpatialCoordinates d)) =
