  · intro v
    rw [T.response_dirichlet_neumann_split, T.dirichlet_value_by_sigma,
      T.neumann_value_by_sigmaStarInv, hσ, hh.1]
    simp only [Homogenization.matVecMul_one, vecDot_zero_right, mul_zero, add_zero, sub_zero]
  · intro v
