theorem aux_lem_band_U2_D_eq {d : ℕ} (n : ℕ) :
    aux_lem_band_U2_D (d := d) n = Homogenization.descendantsAtDepth (Homogenization.originCube d 0) n := by
  unfold aux_lem_band_U2_D Homogenization.descendantsAtScale
  have h1 : (Homogenization.originCube d 0).scale - (n : ℤ) ≤ (Homogenization.originCube d 0).scale := by
    simp [Homogenization.originCube]
