    (hCr : 0 ≤ Cr) (hCm : 0 ≤ Cm) (hC1 : 0 ≤ C1) (hCf : 0 ≤ Cf) (hg : 0 ≤ g) (hz : |z| ≤ 1) :
    |z| * (Cr * δ * g * u) + Cr * g * (C1 * δ ^ c1 * v) +
        Cr * δ * g * u * (Cm * δ ^ cm + C1 * δ ^ c1 * v) ≤
      (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g * t := by
  have hδc : δ ≤ δ ^ c := by
