theorem aux_lem_band_fine_chart_AEEq {d : ℕ}
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (o : BilateralField d) (N : ℕ)
    (R : Homogenization.TriadicCube d) (hR : openCubeSet R ⊆ openCubeSet (originCube d 0))
    (ha : ScalarCoeffOnData (Ch02.cubeDomain R) (cutoffCoefficient M H o N)) :
    Ch02.CoeffOn.AEEq ((aux_lem_band_U2_unitChart I M H o N).coeffOn R) ha.toCoeffOn := by
  have hc : (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) =
      openCubeSet (originCube d 0) := aux_chart_transfer_root_carrier
  have hsub : openCubeSet R ⊆ (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) := by
    rw [hc]; exact hR
  have hAC : volume.restrict (openCubeSet R) ≪
      volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) :=
    (Measure.restrict_mono hsub le_rfl).absolutelyContinuous
  let : Fact ((centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) ⊆ (closedCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d))) := ⟨centeredCube_subset_closedCube 0 one_pos⟩
  have hv : ∀ᵐ x ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
      ∀ hx : x ∈ centeredCube (0 : SpatialCoordinates d) 1 one_pos,
        (cutoffPositiveCoefficient M H o N 0 one_pos).val x =
          cutoffCoefficientCM M H o N 0 one_pos ⟨x, centeredCube_subset_closedCube 0 one_pos hx⟩ / 1 :=
    normalizedContinuousPositiveCoefficient_coeFn _ _ _ 1 one_pos
  have hh := I.chart_eq 0 1 one_pos (cutoffPositiveCoefficient M H o N 0 one_pos) 0 1 one_pos
    subset_rfl R hR
  filter_upwards [hh, hAC.ae_le hv, ae_restrict_mem (measurableSet_openCubeSet R)] with x hx hvx hxm
  change ((I.chart 0 1 one_pos (cutoffPositiveCoefficient M H o N 0 one_pos) 0 1).coeffOn R).toCoeffField x = _
  rw [hx]
  have he : (fun i => (0 : SpatialCoordinates d) i + 1*x i) = x := by funext i; simp
  rw [he, hvx (hsub hxm), div_one]
  rfl

