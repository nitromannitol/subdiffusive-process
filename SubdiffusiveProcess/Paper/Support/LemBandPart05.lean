    ((continuous_eval_const (0 : SpatialCoordinates d)).measurable.comp (measurable_pi_apply _)))

theorem aux_lem_band_fine_chart_meas {d : ℕ} (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : Measurable H) (N : ℕ)
    (R : Homogenization.TriadicCube d) (hR : openCubeSet R ⊆ openCubeSet (originCube d 0)) (i j : Fin d) :
    Measurable (fun o => Ch02.sigmaStarInvCoarse (Ch02.cubeDomain R)
      ((aux_lem_band_U2_unitChart I M H o N).coeffOn R) i j) ∧
    Measurable (fun o => Ch02.sigmaCoarse (Ch02.cubeDomain R)
      ((aux_lem_band_U2_unitChart I M H o N).coeffOn R) i j) := by
  refine ⟨aux_core_sigmaStarInvCoarse_measurable_R_gen hd I M H hH N 0 1 one_pos R hR i j, ?_⟩
  have hh := aux_core_bCoarse_measurable_R_gen hd I M H hH N 0 1 one_pos R hR i j
  have he : (fun o => Ch02.bCoarse (Ch02.cubeDomain R)
      ((aux_lem_band_U2_unitChart I M H o N).coeffOn R) i j) =
      (fun o => Ch02.sigmaCoarse (Ch02.cubeDomain R)
      ((aux_lem_band_U2_unitChart I M H o N).coeffOn R) i j) := by
    funext o
    have hs := aux_lem_band_U2_chart_symm_Q I 0 1 one_pos (cutoffPositiveCoefficient M H o N 0 one_pos) R hR
    unfold aux_lem_band_U2_unitChart
    rw [(Ch02.responseSymmetricDirichletNeumannTheory (Ch02.cubeDomain R) _ hs).derived_matrices.2.2]
  change Measurable (fun o => Ch02.bCoarse (Ch02.cubeDomain R)
    ((aux_lem_band_U2_unitChart I M H o N).coeffOn R) i j) at hh
  rwa [he] at hh

theorem aux_lem_band_fine_truncated_chart_congr {d : ℕ}
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (N h : ℕ) (hN : N ≤ h)
    (o o' : BilateralField d)
    (ho : ∀ i : ℤ, -((h+1:ℕ):ℤ) ≤ i → i ≤ ((h+1:ℕ):ℤ) → o i = o' i) :
    aux_lem_band_U2_unitChart I M (fun x => infraredPartialSum x (h+1)) o N =
      aux_lem_band_U2_unitChart I M (fun x => infraredPartialSum x (h+1)) o' N := by
  have hp : infraredPartialSum o (h+1) = infraredPartialSum o' (h+1) := by
    unfold infraredPartialSum
    refine Finset.sum_congr rfl fun n hn => ?_
    have hh := Finset.mem_range.mp hn
    rw [ho (Int.ofNat (n+1)) (by change -((h+1:ℕ):ℤ) ≤ ((n+1:ℕ):ℤ); omega)
      (by change ((n+1:ℕ):ℤ) ≤ ((h+1:ℕ):ℤ); omega)]
  have hCM : cutoffCoefficientCM M (fun x => infraredPartialSum x (h+1)) o N 0 one_pos =
      cutoffCoefficientCM M (fun x => infraredPartialSum x (h+1)) o' N 0 one_pos := by
    ext x
    change cutoffCoefficient M _ o N (x : SpatialCoordinates d) = cutoffCoefficient M _ o' N (x : SpatialCoordinates d)
    unfold cutoffCoefficient cutoffPotential
    dsimp only
    rw [hp]
    congr 4
    refine Finset.sum_congr rfl fun n hn => ?_
    have hh := Finset.mem_range.mp hn
    rw [ho (-(Int.ofNat n)) (by change -((h+1:ℕ):ℤ) ≤ -(n:ℤ); omega)
      (by change -(n:ℤ) ≤ ((h+1:ℕ):ℤ); omega)]
  unfold aux_lem_band_U2_unitChart cutoffPositiveCoefficient
  rw [aux_lem_band_rcJ_normalized_congr _ _ hCM]

theorem aux_lem_band_fine_truncated_chart_band_meas {d : ℕ} (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
