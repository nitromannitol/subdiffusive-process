theorem aux_lem_band_ref_infrared_zero {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H) :
    ∀ᵐ o ∂(chaosSampleLaw M).toMeasure, H o 0 = 0 := by
  filter_upwards [hH.2] with o ho
  have hh := ((continuous_eval_const (0 : SpatialCoordinates d)).tendsto (H o)).comp ho
  have hz : ∀ L : ℕ, infraredPartialSum o L 0 = 0 := by
    intro L
    simp [infraredPartialSum]
  have hconst : Tendsto (fun L : ℕ => infraredPartialSum o L 0) atTop (nhds (0 : ℝ)) := by
    simpa only [hz] using (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (nhds 0))
  exact (tendsto_nhds_unique hh hconst)

theorem aux_lem_band_ref_tail_orlicz {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∃ A : ℝ, 0 < A ∧ ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (y : SpatialCoordinates d), ‖y‖ ≤ 1 → ∀ h : ℕ,
      (∫⁻ o, ENNReal.ofReal (Real.exp
        ((|aux_lem_band_ref_tail H y h o| / (A * M.delta * (3 : ℝ) ^ (-(h : ℝ)))) ^ 2))
        ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨m, hm, htail⟩ := aux_lem_band_piece_coords_K7_tail_uniform_tail_exp (d := d)
  refine ⟨m, by exact_mod_cast hm, ?_⟩
  intro M H hH y hy h
  have hδpos := M.shellPrefix.delta_pos
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  let edge : ℤ := h + 1
  have hsp : (2 / 3 : ℝ) * (‖-y‖ + 1) ≤ (3 : ℝ) ^ (edge + 0 + 1) := by
    have h3 : (3 : ℝ) ^ (2 : ℤ) ≤ (3 : ℝ) ^ (edge + 0 + 1) := by
      apply zpow_le_zpow_right₀ (by norm_num)
      dsimp [edge]
      omega
    rw [norm_neg, add_zero]
    norm_num at h3
    linarith
  have hb := htail M y (-y) 0 edge hsp
  simp only [neg_zero, zpow_zero, one_smul, add_neg_cancel, add_zero] at hb
  let τ : ℝ := (1 / 2 : ℝ) * m * M.delta * (‖-y‖ + 1) * (3 : ℝ) ^ (-edge)
  have hτ : 0 < τ := by dsimp [τ]; positivity
  have hτle : τ ≤ (m : ℝ) * M.delta * (3 : ℝ) ^ (-(h : ℝ)) := by
    have hn : (1 / 2 : ℝ) * (‖-y‖ + 1) ≤ 1 := by rw [norm_neg]; linarith
    have hp : (3 : ℝ) ^ (-edge) ≤ (3 : ℝ) ^ (-(h : ℝ)) := by
      rw [← Real.rpow_intCast]
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      dsimp [edge]
      push_cast
      linarith
    calc τ = ((m : ℝ) * M.delta) * ((1 / 2 : ℝ) * (‖-y‖ + 1)) *
          (3 : ℝ) ^ (-edge) := by dsimp [τ]; ring
      _ ≤ ((m : ℝ) * M.delta) * 1 * (3 : ℝ) ^ (-(h : ℝ)) := by gcongr
      _ = _ := by ring
  have heq := aux_lem_band_K7_tail_eq M H hH y 0 edge aux_lem_band_U2_retained rfl
  apply aux_lem_band_K7_orlicz_mono (chaosSampleLaw M).toMeasure
    (aux_lem_band_ref_tail H y h)
    (fun o => ‖∑' k : ℕ, (o (edge + 1 + k) y - o (edge + 1 + k) 0)‖)
    τ _ hτ hτle
  · filter_upwards [heq, aux_lem_band_ref_infrared_zero M H hH] with o ho hz
    rw [ho, hz, sub_zero, Real.norm_eq_abs]
    exact le_rfl
  · exact hb

theorem aux_lem_band_ref_log_meas {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
