theorem aux_lem_band_U2_quad_single {d : ℕ} (A : Homogenization.Mat d) (i j : Fin d) :
    Homogenization.vecDot (Pi.single i 1) (Homogenization.matVecMul A (Pi.single j 1)) = A i j := by
  unfold Homogenization.vecDot Homogenization.matVecMul
  rw [Finset.sum_eq_single i]
  · rw [Finset.sum_eq_single j]
    · simp
    · intro k _ hk; simp [hk]
    · intro h; exact absurd (Finset.mem_univ j) h
  · intro k _ hk; simp [Pi.single_apply, hk]
  · intro h; exact absurd (Finset.mem_univ i) h

theorem aux_lem_band_U2_mat_eq_one_of_quad {d : ℕ} (A : Homogenization.Mat d) (hA : A.IsSymm)
    (h : ∀ x : Homogenization.Vec d, Homogenization.vecDot x (Homogenization.matVecMul A x) =
      Homogenization.vecDot x x) : A = 1 := by
  have hlin : ∀ x y : Homogenization.Vec d,
      Homogenization.vecDot (x + y) (Homogenization.matVecMul A (x + y)) =
        Homogenization.vecDot x (Homogenization.matVecMul A x) +
        Homogenization.vecDot x (Homogenization.matVecMul A y) +
        Homogenization.vecDot y (Homogenization.matVecMul A x) +
        Homogenization.vecDot y (Homogenization.matVecMul A y) := by
    intro x y
    unfold Homogenization.vecDot Homogenization.matVecMul
    simp only [Pi.add_apply, mul_add, add_mul, Finset.sum_add_distrib]
    ring
  ext i j
  have hii := h (Pi.single i 1)
  rw [aux_lem_band_U2_quad_single] at hii
  by_cases hij : i = j
  · subst hij
    rw [hii]; simp [Homogenization.vecDot, Pi.single_apply]
  · have hjj := h (Pi.single j 1)
    rw [aux_lem_band_U2_quad_single] at hjj
    have hs := h (Pi.single i 1 + Pi.single j 1)
    rw [hlin, aux_lem_band_U2_quad_single, aux_lem_band_U2_quad_single, aux_lem_band_U2_quad_single, aux_lem_band_U2_quad_single] at hs
    have hsym : A j i = A i j := by
      have := hA.apply i j
      simpa using this
    have hvi : Homogenization.vecDot (Pi.single i (1 : ℝ) : Homogenization.Vec d) (Pi.single i 1) = 1 := by
      simp [Homogenization.vecDot, Pi.single_apply]
    have hvj : Homogenization.vecDot (Pi.single j (1 : ℝ) : Homogenization.Vec d) (Pi.single j 1) = 1 := by
      simp [Homogenization.vecDot, Pi.single_apply]
    have hvs : Homogenization.vecDot (Pi.single i (1 : ℝ) + Pi.single j 1 : Homogenization.Vec d)
        (Pi.single i 1 + Pi.single j 1) = 2 := by
      unfold Homogenization.vecDot
      simp only [Pi.add_apply]
      rw [Finset.sum_eq_add i j hij (fun k _ hk => by simp [hk.1, hk.2])
        (fun h => absurd (Finset.mem_univ i) h) (fun h => absurd (Finset.mem_univ j) h)]
      simp [hij, Ne.symm hij]; norm_num
    rw [hvi] at hii; rw [hvj] at hjj; rw [hvs, hii, hjj, hsym] at hs
    rw [Matrix.one_apply_ne hij]
    linarith

theorem aux_lem_band_U2_identity_coarse {d : ℕ} (Q : Homogenization.TriadicCube d)
    (a : Homogenization.Book.Ch02.CoeffOn (Homogenization.Book.Ch02.cubeDomain Q))
    (ha : ∀ᵐ x ∂volume.restrict (Homogenization.openCubeSet Q),
      a.toCoeffField x = Homogenization.scalarMatrix (1 : ℝ)) :
    Homogenization.Book.Ch02.sigmaStarInvCoarse (Homogenization.Book.Ch02.cubeDomain Q) a = 1 ∧
      Homogenization.Book.Ch02.bCoarse (Homogenization.Book.Ch02.cubeDomain Q) a = 1 := by
  have hsym : Homogenization.Book.Ch02.CoeffOn.IsSymmetric a := by
    unfold Homogenization.Book.Ch02.CoeffOn.IsSymmetric
    filter_upwards [ha] with x hx
    rw [hx]; exact Matrix.isSymm_one.smul _
  have T := Homogenization.Book.Ch02.responseSymmetricDirichletNeumannTheory
    (Homogenization.Book.Ch02.cubeDomain Q) a hsym
  obtain ⟨hB1, hB2, hB3⟩ := T.dirichlet_neumann_bracketing
  have hvolpos : 0 < (volume (Homogenization.openCubeSet Q)).toReal := by
    have hne := (Homogenization.Book.Ch02.cubeDomain Q).nonempty
    have hopen : IsOpen (Homogenization.openCubeSet Q) :=
      (Homogenization.Book.Ch02.cubeDomain Q).isDomain.isOpen
    have h1 : 0 < volume (Homogenization.openCubeSet Q) := hopen.measure_pos volume hne
    have h2 : volume (Homogenization.openCubeSet Q) < ⊤ :=
      (Homogenization.isBounded_openCubeSet Q).measure_lt_top
    exact ENNReal.toReal_pos h1.ne' h2.ne
  have havg : ∀ A : Homogenization.Vec d → Homogenization.Mat d,
      (∀ᵐ x ∂volume.restrict (Homogenization.openCubeSet Q), A x = 1) →
      Homogenization.Book.Ch02.averageMat (Homogenization.Book.Ch02.cubeDomain Q) A = 1 := by
    intro A hA
    ext i j
    unfold Homogenization.Book.Ch02.averageMat
    rw [Homogenization.Book.Ch02.average_eq_of_ae_eq (U := Homogenization.Book.Ch02.cubeDomain Q)
      (f := fun x => A x i j) (g := fun _ => (1 : Homogenization.Mat d) i j)
      (hA.mono (fun x hx => by simp only [hx]))]
    unfold Homogenization.Book.Ch02.average
    rw [setIntegral_const, smul_eq_mul, measureReal_def]
    change (volume (Homogenization.openCubeSet Q)).toReal⁻¹ *
      ((volume (Homogenization.openCubeSet Q)).toReal * (1 : Homogenization.Mat d) i j) = _
    field_simp
  have h1 : Homogenization.Book.Ch02.averageMat (Homogenization.Book.Ch02.cubeDomain Q)
      a.toCoeffField = 1 :=
    havg _ (ha.mono fun x hx => by rw [hx]; simp [Homogenization.scalarMatrix])
  have hsp : Homogenization.symmPart (Homogenization.scalarMatrix (d := d) (1 : ℝ)) = 1 := by
    ext i j
    simp only [Homogenization.symmPart, Homogenization.scalarMatrix, one_smul]
    by_cases hij : i = j
    · subst hij; simp
    · rw [Matrix.one_apply_ne hij, Matrix.one_apply_ne (Ne.symm hij)]
      norm_num
  have h2 : Homogenization.Book.Ch02.averagedSymmPartInv (Homogenization.Book.Ch02.cubeDomain Q)
      a = 1 := by
    unfold Homogenization.Book.Ch02.averagedSymmPartInv
    refine havg _ (ha.mono fun x hx => ?_)
    rw [hx, hsp, inv_one]
  rw [h2, inv_one] at hB1
  rw [h1] at hB3
  have hquad : ∀ (A : Homogenization.Mat d), A.IsSymm →
      Homogenization.MatLoewnerLE 1 A → Homogenization.MatLoewnerLE A 1 → A = 1 := by
    intro A hA hlo hhi
    refine aux_lem_band_U2_mat_eq_one_of_quad A hA (fun x => ?_)
    have e1 := hlo x
    have e2 := hhi x
    have e3 : Homogenization.matVecMul (1 : Homogenization.Mat d) x = x := by
      funext i
      unfold Homogenization.matVecMul
      simp [Matrix.one_apply]
    rw [e3] at e1 e2
    linarith
  have hσ : Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain Q) a = 1 :=
    hquad _ (Homogenization.Book.Ch02.sigmaCoarse_isSymm _ _) (fun x => (hB1 x).trans (hB2 x)) hB3
  have hσs : Homogenization.Book.Ch02.sigmaStarCoarse (Homogenization.Book.Ch02.cubeDomain Q) a = 1 :=
    hquad _ (Homogenization.Book.Ch02.sigmaStarCoarse_isSymm _ _) hB1
      (fun x => (hB2 x).trans (hB3 x))
  refine ⟨?_, ?_⟩
  ·                                                 
    have hinv : (Homogenization.Book.Ch02.sigmaStarInvCoarse
        (Homogenization.Book.Ch02.cubeDomain Q) a)⁻¹ = 1 := hσs
    by_cases hdet : IsUnit (Homogenization.Book.Ch02.sigmaStarInvCoarse
        (Homogenization.Book.Ch02.cubeDomain Q) a).det
    · rw [← Matrix.nonsing_inv_nonsing_inv _ hdet, hinv, inv_one]
    · rw [Matrix.nonsing_inv_apply_not_isUnit _ hdet] at hinv
      have hsub : ∀ A B : Homogenization.Mat d, A = B := by
        intro A B
        have hA : A = A * 1 := (mul_one A).symm
        have hB : B = B * 1 := (mul_one B).symm
        rw [hA, hB, ← hinv, mul_zero, mul_zero]
      exact hsub _ _
  · rw [T.derived_matrices.2.2, hσ]

theorem aux_lem_band_U2_matrixNorm_one {d : ℕ} [NeZero d] :
    Homogenization.Book.Ch02.matrixNorm (1 : Homogenization.Mat d) = 1 := by
  unfold Homogenization.Book.Ch02.matrixNorm
  rw [map_one]
  exact ContinuousLinearMap.norm_id

theorem aux_lem_band_U2_isOne_lamF {d : ℕ} [NeZero d] (sigma : ℝ) (hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1)
    (E : Homogenization.Book.Ch02.TriadicCoeffFamily d) (hE : aux_lem_band_U2_IsOne E) :
    aux_lem_band_U2_lamF sigma E = 1 := by
  have hcell : ∀ n (R : Homogenization.TriadicCube d), R ∈ aux_lem_band_U2_D (d := d) n →
      Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R E = 1 := by
    intro n R hR
    unfold Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm
    rw [(aux_lem_band_U2_identity_coarse R _ (hE R (aux_lem_band_U2_desc_sub n R hR))).1, aux_lem_band_U2_matrixNorm_one]
  have hterm : ∀ n, Homogenization.Book.Ch02.geometricWeight sigma 2 n *
      (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
        (fun R => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R E) =
      Homogenization.Book.Ch02.geometricWeight sigma 2 n := by
    intro n
    rw [Finset.sup'_congr (aux_lem_band_U2_D_nonempty n) rfl (fun R hR => hcell n R hR), Finset.sup'_const,
      mul_one]
  have h1 : (aux_lem_band_U2_lamF sigma E)⁻¹ = 1 := by
    rw [aux_lem_band_U2_lamF_inv_eq]
    simp_rw [hterm]
    exact (aux_lem_band_U2_gw_tsum sigma hsigma.1).tsum_eq
  exact inv_eq_one.mp h1

theorem aux_lem_band_U2_isOne_LamF {d : ℕ} [NeZero d] (sigma : ℝ) (hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1)
    (E : Homogenization.Book.Ch02.TriadicCoeffFamily d) (hE : aux_lem_band_U2_IsOne E) :
    aux_lem_band_U2_LamF sigma E = 1 := by
  have hcell : ∀ n (R : Homogenization.TriadicCube d), R ∈ aux_lem_band_U2_D (d := d) n →
      Homogenization.Book.Ch02.coarseBMatrixNorm R E = 1 := by
    intro n R hR
    unfold Homogenization.Book.Ch02.coarseBMatrixNorm
    rw [(aux_lem_band_U2_identity_coarse R _ (hE R (aux_lem_band_U2_desc_sub n R hR))).2, aux_lem_band_U2_matrixNorm_one]
  have hterm : ∀ n, Homogenization.Book.Ch02.geometricWeight sigma 2 n *
      (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
        (fun R => Homogenization.Book.Ch02.coarseBMatrixNorm R E) =
      Homogenization.Book.Ch02.geometricWeight sigma 2 n := by
    intro n
    rw [Finset.sup'_congr (aux_lem_band_U2_D_nonempty n) rfl (fun R hR => hcell n R hR), Finset.sup'_const,
      mul_one]
  rw [aux_lem_band_U2_LamF_eq]
  simp_rw [hterm]
  exact (aux_lem_band_U2_gw_tsum sigma hsigma.1).tsum_eq

theorem aux_lem_band_U2_chart_isOne {d : ℕ} (I : _root_.SubdiffusiveProcess.Paper.in_J d) (z : SpatialCoordinates d) (r : ℝ)
    (hr : 0 < r) (u : PositiveCoefficient (centeredCube z r hr))
    (hu : u.val =ᵐ[volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d))]
      (fun _ => (1 : ℝ))) :
    aux_lem_band_U2_IsOne (I.chart z r hr u z r) := by
  intro Q hQ
  have h1 := I.chart_eq z r hr u z r hr subset_rfl Q hQ
  have hmap := map_cubeDilation_restrict z (0 : SpatialCoordinates d) hr one_pos
  have hu' : ∀ᵐ y ∂(Measure.map (cubeDilation z (0 : SpatialCoordinates d) r)
      (volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)))), u.val y = 1 := by
    rw [hmap]; exact Measure.ae_smul_measure hu _
  have hpull : ∀ᵐ x ∂volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
      Set (SpatialCoordinates d)), u.val (cubeDilation z (0 : SpatialCoordinates d) r x) = 1 :=
    ae_of_ae_map (continuous_cubeDilation z (0 : SpatialCoordinates d) r).measurable.aemeasurable hu'
  have hcar := aux_chart_transfer_root_carrier (d := d)
  have hpull0 : ∀ᵐ x ∂volume.restrict (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      u.val (cubeDilation z (0 : SpatialCoordinates d) r x) = 1 := by
    rw [← hcar]; exact hpull
  have hpullQ := ae_restrict_of_ae_restrict_of_subset hQ hpull0
  filter_upwards [h1, hpullQ] with x hx1 hx2
  rw [hx1]
  have hx : (fun i => z i + r * x i) = cubeDilation z (0 : SpatialCoordinates d) r x := by
    funext i; simp [cubeDilation]
  rw [hx, hx2]

theorem aux_lem_band_U2_holder2 {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (q : ℝ) (hq : 1 ≤ q)
    (f g : Ω → ℝ) (hf : AEStronglyMeasurable f P) (hg : AEStronglyMeasurable g P) :
    eLpNorm (fun o => f o * g o) (ENNReal.ofReal q) P ≤
      eLpNorm f (ENNReal.ofReal (2 * q)) P * eLpNorm g (ENNReal.ofReal (2 * q)) P := by
  have hq0 : 0 < q := by linarith
  have : ENNReal.HolderTriple (ENNReal.ofReal (2 * q)) (ENNReal.ofReal (2 * q))
      (ENNReal.ofReal q) := ⟨by
    rw [← ENNReal.ofReal_inv_of_pos (by linarith), ← ENNReal.ofReal_inv_of_pos hq0,
      ← ENNReal.ofReal_add (by positivity) (by positivity)]
    congr 1; field_simp; ring⟩
  have := eLpNorm_smul_le_mul_eLpNorm (μ := P) (p := ENNReal.ofReal (2 * q))
    (q := ENNReal.ofReal (2 * q)) (r := ENNReal.ofReal q) hf hg
  have heq : (f • g) = fun o => f o * g o := by funext o; simp [smul_eq_mul]
  rw [heq] at this
  exact this

theorem aux_lem_band_U2_eLpNorm_cmul {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (p : ℝ≥0∞) (c : ℝ)
    (f : Ω → ℝ) : eLpNorm (fun o => c * f o) p P = ENNReal.ofReal |c| * eLpNorm f p P := by
  have : (fun o => c * f o) = c • f := by funext o; simp [smul_eq_mul]
  rw [this, eLpNorm_const_smul, Real.enorm_eq_ofReal_abs]

theorem aux_lem_band_U2_sqrt_sub_le (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    |Real.sqrt a - Real.sqrt b| ≤ Real.sqrt |a - b| := by
  have key : ∀ x y : ℝ, 0 ≤ x → 0 ≤ y → Real.sqrt x ≤ Real.sqrt y + Real.sqrt |x - y| := by
    intro x y hx hy
    have h1 : x ≤ y + |x - y| := by have := le_abs_self (x - y); linarith
    have h2 : Real.sqrt x ≤ Real.sqrt (y + |x - y|) := Real.sqrt_le_sqrt h1
    have h3 : Real.sqrt (y + |x - y|) ≤ Real.sqrt y + Real.sqrt |x - y| := by
      rw [Real.sqrt_le_left (by positivity)]
      have e := Real.sq_sqrt hy
      have e2 := Real.sq_sqrt (abs_nonneg (x - y))
      nlinarith [Real.sqrt_nonneg y, Real.sqrt_nonneg |x - y|]
    linarith
  rw [abs_le]
  constructor
  · have := key b a hb ha
    rw [abs_sub_comm] at this
    linarith
  · have := key a b ha hb
    linarith

theorem aux_lem_band_U2_recip_pt (T y t : ℝ) (hT : 0 < T) (ht0 : 0 < t) (ht : t ≤ 1 / 2) :
    |T⁻¹ - 1 - ((max (1 + y) t)⁻¹ - 1)| ≤
      T⁻¹ * |T - 1 - y| * t⁻¹ + 2 * t * (T⁻¹ * T⁻¹ * |T - 1|) := by
  have hm : 0 < max (1 + y) t := lt_of_lt_of_le ht0 (le_max_right _ _)
  have e : T⁻¹ - 1 - ((max (1 + y) t)⁻¹ - 1) = T⁻¹ - (max (1 + y) t)⁻¹ := by ring
  rw [e]
  have hTi : 0 < T⁻¹ := inv_pos.mpr hT
  rcases le_or_gt t T with hTt | hTt
  ·         
    have hlip : |max (1 + y) t - T| ≤ |T - 1 - y| := by
      have h1 : |max (1 + y) t - max T t| ≤ |(1 + y) - T| := abs_max_sub_max_le_abs _ _ _
      rw [max_eq_left hTt] at h1
      rw [abs_sub_comm (1 + y) T] at h1
      calc |max (1 + y) t - T| ≤ |T - (1 + y)| := h1
        _ = |T - 1 - y| := by ring_nf
    have hdiff : T⁻¹ - (max (1 + y) t)⁻¹ = (max (1 + y) t - T) * (T⁻¹ * (max (1 + y) t)⁻¹) := by
      field_simp
    rw [hdiff, abs_mul, abs_of_pos (mul_pos hTi (inv_pos.mpr hm))]
    have hmi : (max (1 + y) t)⁻¹ ≤ t⁻¹ := inv_anti₀ ht0 (le_max_right _ _)
    have h2 : 0 ≤ 2 * t * (T⁻¹ * T⁻¹ * |T - 1|) := by positivity
    calc |max (1 + y) t - T| * (T⁻¹ * (max (1 + y) t)⁻¹)
        ≤ |T - 1 - y| * (T⁻¹ * t⁻¹) := by
          apply mul_le_mul hlip (mul_le_mul_of_nonneg_left hmi hTi.le) (by positivity)
            (abs_nonneg _)
      _ = T⁻¹ * |T - 1 - y| * t⁻¹ := by ring
      _ ≤ T⁻¹ * |T - 1 - y| * t⁻¹ + 2 * t * (T⁻¹ * T⁻¹ * |T - 1|) := le_add_of_nonneg_right h2
  ·         
    have hmi : (max (1 + y) t)⁻¹ ≤ T⁻¹ :=
      inv_anti₀ hT ((le_of_lt hTt).trans (le_max_right _ _))
    have habs : |T⁻¹ - (max (1 + y) t)⁻¹| ≤ T⁻¹ := by
      rw [abs_of_nonneg (by linarith)]
      linarith [inv_pos.mpr hm]
    have hT1 : 1 / 2 ≤ |T - 1| := by
      rw [abs_sub_comm, abs_of_pos (by linarith)]; linarith
    have htT : 1 ≤ t * T⁻¹ := by
      rw [← div_eq_mul_inv, le_div_iff₀ hT]; linarith
    have hkey : T⁻¹ ≤ 2 * t * (T⁻¹ * T⁻¹ * |T - 1|) := by
      have : 1 ≤ 2 * |T - 1| * (t * T⁻¹) := by nlinarith
      calc T⁻¹ = T⁻¹ * 1 := (mul_one _).symm
        _ ≤ T⁻¹ * (2 * |T - 1| * (t * T⁻¹)) := mul_le_mul_of_nonneg_left this hTi.le
        _ = 2 * t * (T⁻¹ * T⁻¹ * |T - 1|) := by ring
    have h1 : 0 ≤ T⁻¹ * |T - 1 - y| * t⁻¹ := by positivity
    linarith

theorem aux_lem_band_U2_aesm_sup' {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (mB : MeasurableSpace Ω) {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (f : ι → Ω → ℝ)
    (hf : ∀ i ∈ s, AEStronglyMeasurable[mB] (f i) P) :
    AEStronglyMeasurable[mB] (fun o => s.sup' hs (fun i => f i o)) P := by
  classical
  let g : ι → Ω → ℝ := fun i => if h : i ∈ s then (hf i h).mk (f i) else 0
  have hg : ∀ i ∈ s, Measurable[mB] (g i) := by
    intro i hi
    simp only [g, dite_eq_left hi]
    exact (hf i hi).stronglyMeasurable_mk.measurable
  refine ⟨fun o => s.sup' hs (fun i => g i o), ?_, ?_⟩
  · have hm : Measurable[mB] (s.sup' hs g) := Finset.measurable_sup' hs hg
    have heq : (fun o => s.sup' hs (fun i => g i o)) = s.sup' hs g := by
      funext o; rw [Finset.sup'_apply]
    rw [heq]; exact hm.stronglyMeasurable
  · have hall : ∀ᵐ o ∂P, ∀ i ∈ s, f i o = g i o := by
      rw [Filter.eventually_all_finset]
      intro i hi
      have := (hf i hi).ae_eq_mk
      filter_upwards [this] with o ho
      simp only [g, dite_eq_left hi]; exact ho
    filter_upwards [hall] with o ho
    exact Finset.sup'_congr hs rfl (fun i hi => ho i hi)

theorem aux_lem_band_U2_sup'_sub_le {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (f g : ι → ℝ) :
    |s.sup' hs f - s.sup' hs g| ≤ s.sup' hs (fun i => |f i - g i|) := by
  rw [abs_le]
  constructor
  · obtain ⟨i, hi, hgi⟩ := Finset.exists_mem_eq_sup' hs g
    have h1 : f i ≤ s.sup' hs f := Finset.le_sup' f hi
    have h2 : |f i - g i| ≤ s.sup' hs (fun i => |f i - g i|) :=
      Finset.le_sup' (fun i => |f i - g i|) hi
    have h3 := neg_abs_le (f i - g i)
    linarith
  · obtain ⟨i, hi, hfi⟩ := Finset.exists_mem_eq_sup' hs f
    have h1 : g i ≤ s.sup' hs g := Finset.le_sup' g hi
    have h2 : |f i - g i| ≤ s.sup' hs (fun i => |f i - g i|) :=
      Finset.le_sup' (fun i => |f i - g i|) hi
    have h3 := le_abs_self (f i - g i)
    linarith

theorem aux_lem_band_U2_max_lp {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {ι : Type*}
    (s : Finset ι) (hs : s.Nonempty) (h : ι → Ω → ℝ) (hm : ∀ i ∈ s, AEStronglyMeasurable (h i) P)
    (q : ℝ) (hq : 1 ≤ q) (b : ℝ) (_hb : 0 ≤ b)
    (hh : ∀ i ∈ s, eLpNorm (h i) (ENNReal.ofReal q) P ≤ ENNReal.ofReal b) :
    eLpNorm (fun o => s.sup' hs (fun i => |h i o|)) (ENNReal.ofReal q) P ≤
      ENNReal.ofReal ((s.card : ℝ) ^ (1 / q) * b) := by
  have hq0 : 0 < q := by linarith
  have hq0' : ENNReal.ofReal q ≠ 0 := by simp [hq0]
  have hqt : ENNReal.ofReal q ≠ ⊤ := ENNReal.ofReal_ne_top
  have htr : (ENNReal.ofReal q).toReal = q := ENNReal.toReal_ofReal hq0.le
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hq0' hqt
    (aux_lem_band_U2_aesm_sup' P inferInstance s hs (fun i o => |h i o|) (fun i hi => (hm i hi).norm)), htr]
  have hpt : ∀ o, ‖s.sup' hs (fun i => |h i o|)‖ₑ ^ q ≤ ∑ i ∈ s, ‖h i o‖ₑ ^ q := by
    intro o
    obtain ⟨i, hi, hsi⟩ := Finset.exists_mem_eq_sup' hs (fun i => |h i o|)
    rw [hsi]
    have : ‖|h i o|‖ₑ = ‖h i o‖ₑ := by
      rw [Real.enorm_eq_ofReal_abs, Real.enorm_eq_ofReal_abs, abs_abs]
    rw [this]
    exact Finset.single_le_sum (f := fun i => ‖h i o‖ₑ ^ q) (fun _ _ => (show (0 : ℝ≥0∞) ≤ _ from zero_le)) hi
  have hint : ∫⁻ o, ‖s.sup' hs (fun i => |h i o|)‖ₑ ^ q ∂P ≤ ∑ i ∈ s, ∫⁻ o, ‖h i o‖ₑ ^ q ∂P := by
    calc ∫⁻ o, ‖s.sup' hs (fun i => |h i o|)‖ₑ ^ q ∂P ≤ ∫⁻ o, ∑ i ∈ s, ‖h i o‖ₑ ^ q ∂P :=
          lintegral_mono hpt
      _ = ∑ i ∈ s, ∫⁻ o, ‖h i o‖ₑ ^ q ∂P := by
          refine lintegral_finsetSum' s (fun i hi => ?_)
          exact ((hm i hi).enorm).pow_const q
  have hterm : ∀ i ∈ s, ∫⁻ o, ‖h i o‖ₑ ^ q ∂P ≤ ENNReal.ofReal b ^ q := by
    intro i hi
    have e := eLpNorm_eq_lintegral_rpow_enorm_toReal hq0' hqt (hm i hi)
    rw [htr] at e
    have h1 : (∫⁻ o, ‖h i o‖ₑ ^ q ∂P) = (eLpNorm (h i) (ENNReal.ofReal q) P) ^ q := by
      rw [e, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
    rw [h1]
    exact ENNReal.rpow_le_rpow (hh i hi) hq0.le
  have hsum : ∑ i ∈ s, ∫⁻ o, ‖h i o‖ₑ ^ q ∂P ≤ (s.card : ℝ≥0∞) * ENNReal.ofReal b ^ q := by
    calc ∑ i ∈ s, ∫⁻ o, ‖h i o‖ₑ ^ q ∂P ≤ ∑ _i ∈ s, ENNReal.ofReal b ^ q :=
          Finset.sum_le_sum hterm
      _ = (s.card : ℝ≥0∞) * ENNReal.ofReal b ^ q := by rw [Finset.sum_const, nsmul_eq_mul]
  calc (∫⁻ o, ‖s.sup' hs (fun i => |h i o|)‖ₑ ^ q ∂P) ^ (1 / q)
      ≤ ((s.card : ℝ≥0∞) * ENNReal.ofReal b ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (hint.trans hsum) (by positivity)
    _ = ENNReal.ofReal ((s.card : ℝ) ^ (1 / q) * b) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one,
          ENNReal.ofReal_mul (Real.rpow_nonneg (Nat.cast_nonneg _) _),
          ← ENNReal.ofReal_natCast, ENNReal.ofReal_rpow_of_nonneg (Nat.cast_nonneg _) (by positivity)]

theorem aux_lem_band_U2_band_sum_sup {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (mB : MeasurableSpace Ω) {ι : Type*} (D : ℕ → Finset ι) (hD : ∀ k, (D k).Nonempty)
    (wt : ℕ → ℝ) (e : ℕ → ι → ℝ) (L : ℕ) (Yf : ℕ → ι → Ω → ℝ)
    (hY : ∀ k, k < L → ∀ i ∈ D k, AEStronglyMeasurable[mB] (Yf k i) P) :
    AEStronglyMeasurable[mB] (fun o => ∑ k ∈ Finset.range L, wt k *
      ((D k).sup' (hD k) (fun i => e k i + Yf k i o) - (D k).sup' (hD k) (e k))) P := by
  have hterm : ∀ k, k < L → AEStronglyMeasurable[mB] (fun o => wt k *
      ((D k).sup' (hD k) (fun i => e k i + Yf k i o) - (D k).sup' (hD k) (e k))) P := by
    intro k hk
    refine AEStronglyMeasurable.const_mul ?_ _
    refine AEStronglyMeasurable.sub ?_ aestronglyMeasurable_const
    exact @aux_lem_band_U2_aesm_sup' Ω mΩ P mB ι (D k) (hD k) (fun i o => e k i + Yf k i o)
      (fun i hi => aestronglyMeasurable_const.add (hY k hk i hi))
  have key : ∀ n, n ≤ L → AEStronglyMeasurable[mB] (fun o => ∑ k ∈ Finset.range n, wt k *
      ((D k).sup' (hD k) (fun i => e k i + Yf k i o) - (D k).sup' (hD k) (e k))) P := by
    intro n
    induction n with
    | zero =>
      intro _
      simp only [Finset.range_zero, Finset.sum_empty]
      exact aestronglyMeasurable_const
    | succ n ih =>
      intro hn
      have h1 := ih (by omega)
      have h2 := hterm n (by omega)
      simp only [Finset.sum_range_succ]
      exact h1.add h2
  exact key L le_rfl

theorem aux_lem_band_U2_BA_band_mono {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {lo hi lo' hi' : ℤ} (hlo : lo ≤ lo') (hhi : hi' ≤ hi)
    {p : ℝ} {X : BilateralField d → ℝ} {ε : ℝ}
    (hX : aux_lem_band_U2_BandApprox P lo' hi' p X ε) : aux_lem_band_U2_BandApprox P lo hi p X ε := by
  obtain ⟨Y, hYm, hYb⟩ := hX
  exact ⟨Y, aux_lem_band_U2_band_mono hlo hhi hYm, hYb⟩

theorem aux_lem_band_U2_BA_congr {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {lo hi : ℤ} {p : ℝ} {X X' : BilateralField d → ℝ} {ε : ℝ}
    (hXX : ∀ omega, X omega = X' omega) (hX : aux_lem_band_U2_BandApprox P lo hi p X ε) :
    aux_lem_band_U2_BandApprox P lo hi p X' ε := by
  have : X = X' := funext hXX
  rw [← this]; exact hX

theorem aux_lem_band_U2_agg {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (mB : MeasurableSpace Ω) (hmB : mB ≤ mΩ) {ι : Type*}
    (D : ℕ → Finset ι) (hD : ∀ k, (D k).Nonempty) (dd : ℝ) (_hdd : 0 ≤ dd)
    (hcard : ∀ k, ((D k).card : ℝ) ≤ (3 : ℝ) ^ (dd * (k : ℝ)))
    (wt : ℕ → ℝ) (β : ℝ) (hβ : 0 < β) (hwt0 : ∀ k, 0 ≤ wt k)
    (hwt : ∀ k, wt k ≤ (3 : ℝ) ^ (-(β * (k : ℝ))))
    (X : ℕ → ι → Ω → ℝ) (e : ℕ → ι → ℝ)
    (hXm : ∀ k, ∀ i ∈ D k, AEStronglyMeasurable[mΩ] (X k i) P)
    (hsum : ∀ o, Summable fun k => wt k * (D k).sup' (hD k) (fun i => X k i o))
    (hsumE : Summable fun k => wt k * (D k).sup' (hD k) (e k))
    (p q γ : ℝ) (hp : 1 ≤ p) (hpq : p ≤ q) (_hγ : 0 ≤ γ) (hqγ : dd / q + γ ≤ β / 2)
    (Cm ε : ℝ) (hCm : 0 ≤ Cm) (hε : 0 ≤ ε) (L : ℕ)
    (hmom : ∀ k, ∀ i ∈ D k, eLpNorm (fun o => X k i o - e k i) (ENNReal.ofReal q) P ≤
      ENNReal.ofReal (Cm * (3 : ℝ) ^ (γ * (k : ℝ))))
    (hband : ∀ k, k < L → ∀ i ∈ D k, ∃ Y : Ω → ℝ, AEStronglyMeasurable[mB] Y P ∧
      eLpNorm (fun o => X k i o - e k i - Y o) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (ε * (3 : ℝ) ^ (γ * (k : ℝ)))) :
    AEStronglyMeasurable[mΩ] (fun o => ∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) P ∧
    eLpNorm (fun o => (∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) -
        ∑' k, wt k * (D k).sup' (hD k) (e k)) (ENNReal.ofReal p) P ≤
      ENNReal.ofReal ((1 - (3 : ℝ) ^ (-(β / 2)))⁻¹ * Cm) ∧
    ∃ Y : Ω → ℝ, AEStronglyMeasurable[mB] Y P ∧
      eLpNorm (fun o => (∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) -
          (∑' k, wt k * (D k).sup' (hD k) (e k)) - Y o) (ENNReal.ofReal p) P ≤
        ENNReal.ofReal ((1 - (3 : ℝ) ^ (-(β / 2)))⁻¹ *
          (ε + Cm * (3 : ℝ) ^ (-(β / 2 * (L : ℝ))))) := by
  classical
                                  
  let Yf : ℕ → ι → Ω → ℝ := fun k i =>
    if h : k < L ∧ i ∈ D k then Classical.choose (hband k h.1 i h.2) else 0
  have hYf : ∀ k (hk : k < L) i (hi : i ∈ D k), AEStronglyMeasurable[mB] (Yf k i) P ∧
      eLpNorm (fun o => X k i o - e k i - Yf k i o) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (ε * (3 : ℝ) ^ (γ * (k : ℝ))) := by
    intro k hk i hi
    have hsp := Classical.choose_spec (hband k hk i hi)
    simp only [Yf, dite_eq_left (And.intro hk hi)]
    exact hsp
  let : MeasurableSpace Ω := mΩ
  have hYmeas := aux_lem_band_U2_band_sum_sup P mB D hD wt e L Yf (fun k hk i hi => (hYf k hk i hi).1)
  have hq1 : 1 ≤ q := hp.trans hpq
  have hq0 : 0 < q := by linarith
  have hr0 : 0 ≤ (3 : ℝ) ^ (-(β / 2)) := Real.rpow_nonneg (by norm_num) _
  have hr1 : (3 : ℝ) ^ (-(β / 2)) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hpow : ∀ k : ℕ, ((3 : ℝ) ^ (-(β / 2))) ^ k = (3 : ℝ) ^ (-(β / 2) * (k : ℝ)) := by
    intro k; rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
                                                   
  have hrate : ∀ (k : ℕ) (C : ℝ), 0 ≤ C →
      wt k * (((D k).card : ℝ) ^ (1 / q) * (C * (3 : ℝ) ^ (γ * (k : ℝ)))) ≤
        C * ((3 : ℝ) ^ (-(β / 2))) ^ k := by
    intro k C hC
    have hc1 : ((D k).card : ℝ) ^ (1 / q) ≤ (3 : ℝ) ^ (dd * (k : ℝ) / q) := by
      calc ((D k).card : ℝ) ^ (1 / q) ≤ ((3 : ℝ) ^ (dd * (k : ℝ))) ^ (1 / q) :=
            Real.rpow_le_rpow (Nat.cast_nonneg _) (hcard k) (by positivity)
        _ = (3 : ℝ) ^ (dd * (k : ℝ) / q) := by
            rw [← Real.rpow_mul (by norm_num)]; congr 1; ring
    have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
    have hexp : -(β * (k : ℝ)) + dd * (k : ℝ) / q + γ * (k : ℝ) ≤ -(β / 2) * (k : ℝ) := by
      have : (dd / q + γ) * (k : ℝ) ≤ β / 2 * (k : ℝ) := mul_le_mul_of_nonneg_right hqγ hk0
      have e1 : dd * (k : ℝ) / q = dd / q * (k : ℝ) := by ring
      nlinarith
    have hcomb : (3 : ℝ) ^ (-(β * (k : ℝ))) * ((3 : ℝ) ^ (dd * (k : ℝ) / q) *
        (3 : ℝ) ^ (γ * (k : ℝ))) ≤ (3 : ℝ) ^ (-(β / 2) * (k : ℝ)) := by
      rw [← Real.rpow_add (by norm_num), ← Real.rpow_add (by norm_num)]
      exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
    rw [hpow]
    have h3g : 0 ≤ (3 : ℝ) ^ (γ * (k : ℝ)) := Real.rpow_nonneg (by norm_num) _
    have hcpos : 0 ≤ ((D k).card : ℝ) ^ (1 / q) := Real.rpow_nonneg (Nat.cast_nonneg _) _
    calc wt k * (((D k).card : ℝ) ^ (1 / q) * (C * (3 : ℝ) ^ (γ * (k : ℝ))))
        ≤ (3 : ℝ) ^ (-(β * (k : ℝ))) * ((3 : ℝ) ^ (dd * (k : ℝ) / q) *
            (C * (3 : ℝ) ^ (γ * (k : ℝ)))) := by
          apply mul_le_mul (hwt k) (mul_le_mul_of_nonneg_right hc1 (mul_nonneg hC h3g))
            (mul_nonneg hcpos (mul_nonneg hC h3g)) (Real.rpow_nonneg (by norm_num) _)
      _ = C * ((3 : ℝ) ^ (-(β * (k : ℝ))) * ((3 : ℝ) ^ (dd * (k : ℝ) / q) *
            (3 : ℝ) ^ (γ * (k : ℝ)))) := by ring
      _ ≤ C * (3 : ℝ) ^ (-(β / 2) * (k : ℝ)) := mul_le_mul_of_nonneg_left hcomb hC
                    
  set F : ℕ → Ω → ℝ := fun k o =>
    wt k * ((D k).sup' (hD k) (fun i => X k i o) - (D k).sup' (hD k) (e k)) with hFdef
  have hSm : ∀ k, AEStronglyMeasurable (fun o => (D k).sup' (hD k) (fun i => X k i o)) P :=
    fun k => aux_lem_band_U2_aesm_sup' P mΩ (D k) (hD k) (X k) (hXm k)
  have hFm : ∀ k, AEStronglyMeasurable (F k) P :=
    fun k => ((hSm k).sub aestronglyMeasurable_const).const_mul _
  have hdevm : ∀ k, ∀ i ∈ D k, AEStronglyMeasurable (fun o => X k i o - e k i) P :=
    fun k i hi => (hXm k i hi).sub aestronglyMeasurable_const
  have hFq : ∀ k, eLpNorm (F k) (ENNReal.ofReal q) P ≤
      ENNReal.ofReal (Cm * ((3 : ℝ) ^ (-(β / 2))) ^ k) := by
    intro k
    have hmax := aux_lem_band_U2_max_lp P (D k) (hD k) (fun i o => X k i o - e k i) (hdevm k) q hq1
      (Cm * (3 : ℝ) ^ (γ * (k : ℝ))) (by positivity) (hmom k)
    have hpt : ∀ o, ‖F k o‖ ≤ ‖wt k * (D k).sup' (hD k) (fun i => |X k i o - e k i|)‖ := by
      intro o
      have hle := aux_lem_band_U2_sup'_sub_le (D k) (hD k) (fun i => X k i o) (e k)
      have hnn : 0 ≤ (D k).sup' (hD k) (fun i => |X k i o - e k i|) :=
        (abs_nonneg _).trans hle
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul, abs_of_nonneg (hwt0 k),
        abs_of_nonneg hnn]
      exact mul_le_mul_of_nonneg_left hle (hwt0 k)
    calc eLpNorm (F k) (ENNReal.ofReal q) P
        ≤ eLpNorm (fun o => wt k * (D k).sup' (hD k) (fun i => |X k i o - e k i|))
            (ENNReal.ofReal q) P := eLpNorm_mono (hFm k) hpt
      _ = ENNReal.ofReal (wt k) * eLpNorm (fun o => (D k).sup' (hD k)
            (fun i => |X k i o - e k i|)) (ENNReal.ofReal q) P := by
          rw [aux_lem_band_U2_eLpNorm_cmul, abs_of_nonneg (hwt0 k)]
      _ ≤ ENNReal.ofReal (wt k) * ENNReal.ofReal (((D k).card : ℝ) ^ (1 / q) *
            (Cm * (3 : ℝ) ^ (γ * (k : ℝ)))) := mul_le_mul_right hmax _
      _ = ENNReal.ofReal (wt k * (((D k).card : ℝ) ^ (1 / q) *
            (Cm * (3 : ℝ) ^ (γ * (k : ℝ))))) := (ENNReal.ofReal_mul (hwt0 k)).symm
      _ ≤ ENNReal.ofReal (Cm * ((3 : ℝ) ^ (-(β / 2))) ^ k) :=
          ENNReal.ofReal_le_ofReal (hrate k Cm hCm)
  have hFp : ∀ k, eLpNorm (F k) (ENNReal.ofReal p) P ≤
      ENNReal.ofReal (Cm * ((3 : ℝ) ^ (-(β / 2))) ^ k) := fun k =>
    (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hpq)).trans (hFq k)
  have hFmem : ∀ k, MemLp (F k) (ENNReal.ofReal p) P :=
    fun k => (hFp k).trans_lt ENNReal.ofReal_lt_top
  obtain ⟨-, htails⟩ := SubdiffusiveProcess.memLp_geometric_tsum_tails P (ENNReal.one_le_ofReal.mpr hp)
    ENNReal.ofReal_ne_top F hFmem hCm hr0 hr1 hFp
  have hFsum : ∀ o, Summable (fun k => F k o) := by
    intro o
    have := (hsum o).sub hsumE
    refine this.congr (fun k => ?_)
    simp only [hFdef]; ring
  have hTF : ∀ o, (∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) -
      ∑' k, wt k * (D k).sup' (hD k) (e k) = ∑' k, F k o := by
    intro o
    rw [← (hsum o).tsum_sub hsumE]
    refine tsum_congr (fun k => ?_)
    simp only [hFdef]; ring
  have htail0 : (fun o => ∑' n : ℕ, F (n + 0) o) = fun o => ∑' k, F k o := by
    funext o; simp only [add_zero]
  have hCβ : (1 - (3 : ℝ) ^ (-(β / 2)))⁻¹ = 1 / (1 - (3 : ℝ) ^ (-(β / 2))) := (one_div _).symm
  refine ⟨?_, ?_, ?_⟩
  ·                 
    have hm0 := (htails 0).1.aestronglyMeasurable
    rw [htail0] at hm0
    have : (fun o => ∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) =
        fun o => (∑' k, F k o) + ∑' k, wt k * (D k).sup' (hD k) (e k) := by
      funext o; rw [← hTF o]; ring
    rw [this]
    exact hm0.add aestronglyMeasurable_const
  ·          
    have h0 := (htails 0).2
    rw [htail0] at h0
    have : (fun o => (∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) -
        ∑' k, wt k * (D k).sup' (hD k) (e k)) = fun o => ∑' k, F k o := funext hTF
    rw [this]
    refine h0.trans (ENNReal.ofReal_le_ofReal (le_of_eq ?_))
    rw [pow_zero, mul_one]; field_simp
  ·        
    refine ⟨fun o => ∑ k ∈ Finset.range L, wt k *
      ((D k).sup' (hD k) (fun i => e k i + Yf k i o) - (D k).sup' (hD k) (e k)), hYmeas, ?_⟩
    set G : ℕ → Ω → ℝ := fun k o => wt k * ((D k).sup' (hD k) (fun i => X k i o) -
      (D k).sup' (hD k) (fun i => e k i + Yf k i o)) with hGdef
    have hsplit : ∀ o, (∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) -
        (∑' k, wt k * (D k).sup' (hD k) (e k)) -
        ∑ k ∈ Finset.range L, wt k *
          ((D k).sup' (hD k) (fun i => e k i + Yf k i o) - (D k).sup' (hD k) (e k)) =
        (∑ k ∈ Finset.range L, G k o) + ∑' n, F (n + L) o := by
      intro o
      rw [hTF o, ← (hFsum o).sum_add_tsum_nat_add L]
      have : ∑ k ∈ Finset.range L, F k o -
          ∑ k ∈ Finset.range L, wt k *
            ((D k).sup' (hD k) (fun i => e k i + Yf k i o) - (D k).sup' (hD k) (e k)) =
          ∑ k ∈ Finset.range L, G k o := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        simp only [hFdef, hGdef]; ring
      linarith
    have hGm : ∀ k ∈ Finset.range L, AEStronglyMeasurable (G k) P := by
      intro k hk
      have hk' : k < L := Finset.mem_range.mp hk
      refine (AEStronglyMeasurable.sub (hSm k) ?_).const_mul _
      exact aux_lem_band_U2_aesm_sup' P mΩ (D k) (hD k) (fun i o => e k i + Yf k i o)
        (fun i hi => aestronglyMeasurable_const.add ((hYf k hk' i hi).1.mono hmB))
    have hGq : ∀ k ∈ Finset.range L, eLpNorm (G k) (ENNReal.ofReal p) P ≤
        ENNReal.ofReal (ε * ((3 : ℝ) ^ (-(β / 2))) ^ k) := by
      intro k hk
      have hk' : k < L := Finset.mem_range.mp hk
      have hmax := aux_lem_band_U2_max_lp P (D k) (hD k) (fun i o => X k i o - e k i - Yf k i o)
        (fun i hi => (hdevm k i hi).sub ((hYf k hk' i hi).1.mono hmB)) q hq1
        (ε * (3 : ℝ) ^ (γ * (k : ℝ))) (by positivity) (fun i hi => (hYf k hk' i hi).2)
      have hpt : ∀ o, ‖G k o‖ ≤
          ‖wt k * (D k).sup' (hD k) (fun i => |X k i o - e k i - Yf k i o|)‖ := by
        intro o
        have hle := aux_lem_band_U2_sup'_sub_le (D k) (hD k) (fun i => X k i o)
          (fun i => e k i + Yf k i o)
        have hnn : 0 ≤ (D k).sup' (hD k) (fun i => |X k i o - e k i - Yf k i o|) := by
          obtain ⟨i, hi⟩ := hD k
          exact (abs_nonneg _).trans (Finset.le_sup' (fun i => |X k i o - e k i - Yf k i o|) hi)
        have heq : (fun i => |X k i o - (e k i + Yf k i o)|) =
            fun i => |X k i o - e k i - Yf k i o| := by
          funext i; congr 1; ring
        rw [heq] at hle
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul, abs_of_nonneg (hwt0 k),
          abs_of_nonneg hnn]
        exact mul_le_mul_of_nonneg_left hle (hwt0 k)
      have hGmk := hGm k hk
      calc eLpNorm (G k) (ENNReal.ofReal p) P ≤ eLpNorm (G k) (ENNReal.ofReal q) P :=
            eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hpq)
        _ ≤ eLpNorm (fun o => wt k * (D k).sup' (hD k) (fun i => |X k i o - e k i - Yf k i o|))
              (ENNReal.ofReal q) P := eLpNorm_mono hGmk hpt
        _ = ENNReal.ofReal (wt k) * eLpNorm (fun o => (D k).sup' (hD k)
              (fun i => |X k i o - e k i - Yf k i o|)) (ENNReal.ofReal q) P := by
            rw [aux_lem_band_U2_eLpNorm_cmul, abs_of_nonneg (hwt0 k)]
        _ ≤ ENNReal.ofReal (wt k) * ENNReal.ofReal (((D k).card : ℝ) ^ (1 / q) *
              (ε * (3 : ℝ) ^ (γ * (k : ℝ)))) := mul_le_mul_right hmax _
        _ = ENNReal.ofReal (wt k * (((D k).card : ℝ) ^ (1 / q) *
              (ε * (3 : ℝ) ^ (γ * (k : ℝ))))) := (ENNReal.ofReal_mul (hwt0 k)).symm
        _ ≤ ENNReal.ofReal (ε * ((3 : ℝ) ^ (-(β / 2))) ^ k) :=
            ENNReal.ofReal_le_ofReal (hrate k ε hε)
    have hfin : eLpNorm (fun o => ∑ k ∈ Finset.range L, G k o) (ENNReal.ofReal p) P ≤
        ENNReal.ofReal (ε * (1 - (3 : ℝ) ^ (-(β / 2)))⁻¹) := by
      have heq : (fun o => ∑ k ∈ Finset.range L, G k o) = ∑ k ∈ Finset.range L, G k := by
        funext o; simp only [Finset.sum_apply]
      rw [heq]
      refine (eLpNorm_sum_le (ENNReal.one_le_ofReal.mpr hp)).trans ?_
      refine (Finset.sum_le_sum hGq).trans ?_
      rw [← ENNReal.ofReal_sum_of_nonneg (fun k _ => by positivity)]
      refine ENNReal.ofReal_le_ofReal ?_
      rw [← Finset.mul_sum]
      refine mul_le_mul_of_nonneg_left ?_ hε
      have := sum_le_hasSum (Finset.range L) (fun k _ => pow_nonneg hr0 k)
        (hasSum_geometric_of_lt_one hr0 hr1)
      exact this
    have htl := (htails L).2
    have htlm := (htails L).1.aestronglyMeasurable
    have hGsm : AEStronglyMeasurable (fun o => ∑ k ∈ Finset.range L, G k o) P :=
      Finset.aestronglyMeasurable_fun_sum _ hGm
    calc eLpNorm (fun o => (∑' k, wt k * (D k).sup' (hD k) (fun i => X k i o)) -
          (∑' k, wt k * (D k).sup' (hD k) (e k)) -
          ∑ k ∈ Finset.range L, wt k *
            ((D k).sup' (hD k) (fun i => e k i + Yf k i o) - (D k).sup' (hD k) (e k)))
          (ENNReal.ofReal p) P
        = eLpNorm ((fun o => ∑ k ∈ Finset.range L, G k o) + fun o => ∑' n, F (n + L) o)
            (ENNReal.ofReal p) P := by
          congr 1; funext o; rw [hsplit o]; rfl
      _ ≤ eLpNorm (fun o => ∑ k ∈ Finset.range L, G k o) (ENNReal.ofReal p) P +
            eLpNorm (fun o => ∑' n, F (n + L) o) (ENNReal.ofReal p) P :=
          eLpNorm_add_le (ENNReal.one_le_ofReal.mpr hp)
      _ ≤ ENNReal.ofReal (ε * (1 - (3 : ℝ) ^ (-(β / 2)))⁻¹) +
            ENNReal.ofReal (Cm * ((3 : ℝ) ^ (-(β / 2))) ^ L / (1 - (3 : ℝ) ^ (-(β / 2)))) :=
          add_le_add hfin htl
      _ = ENNReal.ofReal ((1 - (3 : ℝ) ^ (-(β / 2)))⁻¹ *
            (ε + Cm * (3 : ℝ) ^ (-(β / 2 * (L : ℝ))))) := by
          have h1' : 0 < 1 - (3 : ℝ) ^ (-(β / 2)) := by linarith
          have hA : 0 ≤ ε * (1 - (3 : ℝ) ^ (-(β / 2)))⁻¹ := mul_nonneg hε (inv_nonneg.mpr h1'.le)
          have hB : 0 ≤ Cm * ((3 : ℝ) ^ (-(β / 2))) ^ L / (1 - (3 : ℝ) ^ (-(β / 2))) :=
            div_nonneg (mul_nonneg hCm (pow_nonneg hr0 L)) h1'.le
          rw [← ENNReal.ofReal_add hA hB]
          congr 1
          rw [hpow L]
          have h1 : 0 < 1 - (3 : ℝ) ^ (-(β / 2)) := by linarith
          have e3 : (3 : ℝ) ^ (-(β / 2) * (L : ℝ)) = (3 : ℝ) ^ (-(β / 2 * (L : ℝ))) := by
            congr 1; ring
          rw [e3]
          field_simp

theorem aux_lem_band_U2_recip {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (mB : MeasurableSpace Ω) (hmB : mB ≤ mΩ)
    (T : Ω → ℝ) (hT : AEStronglyMeasurable[mΩ] T P) (hTpos : ∀ o, 0 < T o)
    (p : ℝ) (hp : 1 ≤ p) (B0 Dm ε t : ℝ) (hB0 : 0 ≤ B0) (hDm : 0 ≤ Dm) (hε : 0 ≤ ε)
    (ht0 : 0 < t) (ht : t ≤ 1 / 2)
    (hTinv : eLpNorm (fun o => (T o)⁻¹) (ENNReal.ofReal (4 * p)) P ≤ ENNReal.ofReal B0)
    (hTdev : eLpNorm (fun o => T o - 1) (ENNReal.ofReal (4 * p)) P ≤ ENNReal.ofReal Dm)
    (hY : ∃ Y : Ω → ℝ, AEStronglyMeasurable[mB] Y P ∧
      eLpNorm (fun o => T o - 1 - Y o) (ENNReal.ofReal (2 * p)) P ≤ ENNReal.ofReal ε) :
    ∃ Z : Ω → ℝ, AEStronglyMeasurable[mB] Z P ∧
      eLpNorm (fun o => (T o)⁻¹ - 1 - Z o) (ENNReal.ofReal p) P ≤
        ENNReal.ofReal (B0 * ε / t + 4 * B0 ^ 2 * Dm * t) := by
  obtain ⟨Y, hYm, hYb⟩ := hY
  have hcont : Continuous (fun y : ℝ => (max (1 + y) t)⁻¹ - 1) := by
    refine Continuous.sub (Continuous.inv₀ ((continuous_const.add continuous_id).max
      continuous_const) (fun y => (lt_of_lt_of_le ht0 (le_max_right _ _)).ne')) continuous_const
  refine ⟨fun o => (max (1 + Y o) t)⁻¹ - 1, hcont.comp_aestronglyMeasurable hYm, ?_⟩
  let : MeasurableSpace Ω := mΩ
  have hYa : AEStronglyMeasurable Y P := hYm.mono hmB
  have hp0 : 0 < p := by linarith
  have hTi : AEStronglyMeasurable (fun o => (T o)⁻¹) P :=
    (measurable_inv.comp_aemeasurable (AEStronglyMeasurable.aemeasurable hT)).aestronglyMeasurable
  have hA : AEStronglyMeasurable (fun o => T o - 1 - Y o) P :=
    (hT.sub aestronglyMeasurable_const).sub hYa
  have hD : AEStronglyMeasurable (fun o => T o - 1) P := hT.sub aestronglyMeasurable_const
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := ENNReal.one_le_ofReal.mpr hp
                          
  have hTinv2 : eLpNorm (fun o => (T o)⁻¹) (ENNReal.ofReal (2 * p)) P ≤ ENNReal.ofReal B0 :=
    (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith))).trans hTinv
  have hTdev2 : eLpNorm (fun o => T o - 1) (ENNReal.ofReal (2 * p)) P ≤ ENNReal.ofReal Dm :=
    (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith))).trans hTdev
  have hsq : eLpNorm (fun o => (T o)⁻¹ * (T o)⁻¹) (ENNReal.ofReal (2 * p)) P ≤
      ENNReal.ofReal (B0 * B0) := by
    have := aux_lem_band_U2_holder2 P (2 * p) (by linarith) _ _ hTi hTi
    rw [show 2 * (2 * p) = 4 * p by ring] at this
    rw [ENNReal.ofReal_mul hB0]
    exact this.trans (mul_le_mul' hTinv hTinv)
                   
  set g1 : Ω → ℝ := fun o => t⁻¹ * ((T o)⁻¹ * |T o - 1 - Y o|) with hg1
  set g2 : Ω → ℝ := fun o => (2 * t) * (((T o)⁻¹ * (T o)⁻¹) * |T o - 1|) with hg2
  have hg1m : AEStronglyMeasurable g1 P := (hTi.mul (continuous_abs.comp_aestronglyMeasurable hA)).const_mul _
  have hg2m : AEStronglyMeasurable g2 P := ((hTi.mul hTi).mul (continuous_abs.comp_aestronglyMeasurable hD)).const_mul _
  have hpt : ∀ o, ‖(T o)⁻¹ - 1 - ((max (1 + Y o) t)⁻¹ - 1)‖ ≤ ‖(g1 + g2) o‖ := by
    intro o
    have h := aux_lem_band_U2_recip_pt (T o) (Y o) t (hTpos o) ht0 ht
    have hTo := hTpos o
    have hnn : 0 ≤ (g1 + g2) o := by
      simp only [hg1, hg2, Pi.add_apply]
      have a1 : 0 ≤ (T o)⁻¹ := inv_nonneg.mpr hTo.le
      exact add_nonneg (mul_nonneg (inv_nonneg.mpr ht0.le) (mul_nonneg a1 (abs_nonneg _)))
        (mul_nonneg (by linarith) (mul_nonneg (mul_nonneg a1 a1) (abs_nonneg _)))
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hnn]
    simp only [hg1, hg2, Pi.add_apply]
    linarith
  have hn1 : eLpNorm g1 (ENNReal.ofReal p) P ≤ ENNReal.ofReal (t⁻¹ * (B0 * ε)) := by
    have e : g1 = fun o => t⁻¹ * ((T o)⁻¹ * |T o - 1 - Y o|) := rfl
    rw [e, aux_lem_band_U2_eLpNorm_cmul, abs_of_pos (inv_pos.mpr ht0),
      show ENNReal.ofReal (t⁻¹ * (B0 * ε)) = ENNReal.ofReal t⁻¹ * ENNReal.ofReal (B0 * ε) from
        ENNReal.ofReal_mul (inv_pos.mpr ht0).le]
    refine mul_le_mul_right ?_ _
    have := aux_lem_band_U2_holder2 P p hp _ _ hTi (continuous_abs.comp_aestronglyMeasurable hA)
    refine this.trans ?_
    rw [ENNReal.ofReal_mul hB0]
    refine mul_le_mul' hTinv2 ?_
    have e2 : (fun o => |T o - 1 - Y o|) = fun o => ‖T o - 1 - Y o‖ := by
      funext o; rw [Real.norm_eq_abs]
    rw [e2, eLpNorm_norm _ hA]; exact hYb
  have hn2 : eLpNorm g2 (ENNReal.ofReal p) P ≤ ENNReal.ofReal (2 * t * (B0 * B0 * Dm)) := by
    have e : g2 = fun o => (2 * t) * (((T o)⁻¹ * (T o)⁻¹) * |T o - 1|) := rfl
    rw [e, aux_lem_band_U2_eLpNorm_cmul, abs_of_pos (by linarith),
      show ENNReal.ofReal (2 * t * (B0 * B0 * Dm)) =
        ENNReal.ofReal (2 * t) * ENNReal.ofReal (B0 * B0 * Dm) from ENNReal.ofReal_mul (by linarith)]
    refine mul_le_mul_right ?_ _
    have := aux_lem_band_U2_holder2 P p hp _ _ (hTi.mul hTi) (continuous_abs.comp_aestronglyMeasurable hD)
    refine this.trans ?_
    rw [ENNReal.ofReal_mul (mul_nonneg hB0 hB0)]
    refine mul_le_mul' hsq ?_
    have e2 : (fun o => |T o - 1|) = fun o => ‖T o - 1‖ := by
      funext o; rw [Real.norm_eq_abs]
    rw [e2, eLpNorm_norm _ hD]; exact hTdev2
  calc eLpNorm (fun o => (T o)⁻¹ - 1 - ((max (1 + Y o) t)⁻¹ - 1)) (ENNReal.ofReal p) P
      ≤ eLpNorm (g1 + g2) (ENNReal.ofReal p) P := eLpNorm_mono
        (hTi.sub aestronglyMeasurable_const |>.sub
          (measurable_inv.comp_aemeasurable
            ((aestronglyMeasurable_const.add hYa).sup aestronglyMeasurable_const).aemeasurable
            |>.aestronglyMeasurable |>.sub aestronglyMeasurable_const)) hpt
    _ ≤ eLpNorm g1 (ENNReal.ofReal p) P + eLpNorm g2 (ENNReal.ofReal p) P :=
        eLpNorm_add_le hq1
    _ ≤ ENNReal.ofReal (t⁻¹ * (B0 * ε)) + ENNReal.ofReal (2 * t * (B0 * B0 * Dm)) :=
        add_le_add hn1 hn2
    _ = ENNReal.ofReal (t⁻¹ * (B0 * ε) + 2 * t * (B0 * B0 * Dm)) :=
        (ENNReal.ofReal_add (by positivity) (by positivity)).symm
    _ ≤ ENNReal.ofReal (B0 * ε / t + 4 * B0 ^ 2 * Dm * t) := by
        refine ENNReal.ofReal_le_ofReal ?_
        have h1 : t⁻¹ * (B0 * ε) = B0 * ε / t := by field_simp
        have h2 : 0 ≤ B0 ^ 2 * Dm * t := by positivity
        rw [h1]
        nlinarith

theorem aux_lem_band_U2_sqrt {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (mB : MeasurableSpace Ω) (hmB : mB ≤ mΩ)
    (T : Ω → ℝ) (hT : AEStronglyMeasurable[mΩ] T P) (hT0 : ∀ o, 0 ≤ T o)
    (p : ℝ) (hp : 1 ≤ p) (ε : ℝ) (hε : 0 ≤ ε)
    (hY : ∃ Y : Ω → ℝ, AEStronglyMeasurable[mB] Y P ∧
      eLpNorm (fun o => T o - Y o) (ENNReal.ofReal p) P ≤ ENNReal.ofReal ε) :
    ∃ Z : Ω → ℝ, AEStronglyMeasurable[mB] Z P ∧
      eLpNorm (fun o => Real.sqrt (T o) - Z o) (ENNReal.ofReal p) P ≤
        ENNReal.ofReal (Real.sqrt ε) := by
  obtain ⟨Y, hYm, hYb⟩ := hY
  refine ⟨fun o => Real.sqrt (max (Y o) 0),
    (Real.continuous_sqrt.comp (continuous_id.max continuous_const)).comp_aestronglyMeasurable hYm,
    ?_⟩
  let : MeasurableSpace Ω := mΩ
  have hYa : AEStronglyMeasurable Y P := hYm.mono hmB
  have hpt : ∀ o, ‖Real.sqrt (T o) - Real.sqrt (max (Y o) 0)‖ ≤ ‖‖T o - Y o‖ ^ (1 / 2 : ℝ)‖ := by
    intro o
    rw [Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _), ← Real.sqrt_eq_rpow]
    refine (aux_lem_band_U2_sqrt_sub_le _ _ (hT0 o) (le_max_right _ _)).trans (Real.sqrt_le_sqrt ?_)
    rcases le_total (Y o) 0 with h | h
    · rw [max_eq_right h, sub_zero, abs_of_nonneg (hT0 o)]
      rw [abs_of_nonneg (by linarith [hT0 o])]
      linarith
    · rw [max_eq_left h]
  have hp0 : 0 < p := by linarith
  calc eLpNorm (fun o => Real.sqrt (T o) - Real.sqrt (max (Y o) 0)) (ENNReal.ofReal p) P
      ≤ eLpNorm (fun o => ‖T o - Y o‖ ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) P := eLpNorm_mono
        ((Real.continuous_sqrt.comp_aestronglyMeasurable hT).sub
          (Real.continuous_sqrt.comp_aestronglyMeasurable (hYa.sup aestronglyMeasurable_const))) hpt
    _ = eLpNorm (fun o => T o - Y o) (ENNReal.ofReal p * ENNReal.ofReal (1 / 2)) P ^ (1 / 2 : ℝ) :=
        eLpNorm_norm_rpow _ (hT.sub hYa) (by norm_num)
    _ ≤ eLpNorm (fun o => T o - Y o) (ENNReal.ofReal p) P ^ (1 / 2 : ℝ) := by
        refine ENNReal.rpow_le_rpow ?_ (by norm_num)
        refine eLpNorm_le_eLpNorm_of_exponent_le ?_
        rw [← ENNReal.ofReal_mul hp0.le]
        exact ENNReal.ofReal_le_ofReal (by linarith)
    _ ≤ ENNReal.ofReal ε ^ (1 / 2 : ℝ) := ENNReal.rpow_le_rpow hYb (by norm_num)
    _ = ENNReal.ofReal (Real.sqrt ε) := by
        rw [Real.sqrt_eq_rpow, ENNReal.ofReal_rpow_of_nonneg hε (by norm_num)]

