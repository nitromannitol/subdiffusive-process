      (1/2 : ℝ) * |Homogenization.Book.Ch02.sigmaStarInvCoarse U a i i - 1| := by
    rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 1/2)]
  have e2 : |(1/2 : ℝ) * (Homogenization.Book.Ch02.sigmaStarInvCoarse U a j j - 1)| =
      (1/2 : ℝ) * |Homogenization.Book.Ch02.sigmaStarInvCoarse U a j j - 1| := by
    rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 1/2)]
  rw [e1, e2]
