  have hδcm1 : δ ^ cm ≤ 1 := Real.rpow_le_one hδ0.le hδ1 hcmpos
  have hδc11 : δ ^ c1 ≤ 1 := Real.rpow_le_one hδ0.le hδ1 hc1pos
  have hδcpos : 0 ≤ δ ^ c := Real.rpow_nonneg hδ0.le _
  have hδcm0 : 0 ≤ δ ^ cm := Real.rpow_nonneg hδ0.le _
  have hδc10 : 0 ≤ δ ^ c1 := Real.rpow_nonneg hδ0.le _
  have ht0 : 0 ≤ t := hu0.trans hut
  have A : |z| * (Cr * δ * g * u) ≤ Cr * δ ^ c * g * t := by
    calc |z| * (Cr * δ * g * u) ≤ 1 * (Cr * δ * g * u) :=
          mul_le_mul_of_nonneg_right hz (by positivity)
      _ = Cr * δ * g * u := one_mul _
      _ ≤ Cr * δ ^ c * g * t := by gcongr
  have B : Cr * g * (C1 * δ ^ c1 * v) ≤ Cr * g * (C1 * δ ^ c * t) := by gcongr
  have hin : Cm * δ ^ cm + C1 * δ ^ c1 * v ≤ Cm + C1 := by
    have h1 : Cm * δ ^ cm ≤ Cm * 1 := by gcongr
    have h2 : δ ^ c1 * v ≤ 1 * 1 := mul_le_mul hδc11 hv1 hv0 zero_le_one
    have h3 : C1 * (δ ^ c1 * v) ≤ C1 * (1 * 1) := by gcongr
    linarith [mul_assoc C1 (δ ^ c1) v]
  have Cc : Cr * δ * g * u * (Cm * δ ^ cm + C1 * δ ^ c1 * v) ≤ Cr * δ ^ c * g * t * (Cm + C1) := by
    have hin0 : 0 ≤ Cm * δ ^ cm + C1 * δ ^ c1 * v := by positivity
    have h1 : Cr * δ * g * u ≤ Cr * δ ^ c * g * t := by gcongr
    exact mul_le_mul h1 hin hin0 (by positivity)
  have e : (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g * t =
