  have hphi : ContDiff ℝ ∞ (fun x : SpatialCoordinates d => affineSlope pv x + 0) :=
    (affineSlope pv).contDiff.add contDiff_const
  have hnonconst : ∃ x ∈ frontier (centeredCube (0 : SpatialCoordinates d) 1 hr :
        Set (SpatialCoordinates d)),
      ∃ y ∈ frontier (centeredCube (0 : SpatialCoordinates d) 1 hr : Set (SpatialCoordinates d)),
        (fun x : SpatialCoordinates d => affineSlope pv x + 0) x ≠
          (fun x : SpatialCoordinates d => affineSlope pv x + 0) y := by
    rw [hcube, frontier_ball (0 : SpatialCoordinates d) (by norm_num : (1 / 2 : ℝ) ≠ 0)]
    refine ⟨fun _ => (1 / 2 : ℝ), ?_, fun _ => -(1 / 2 : ℝ), ?_, ?_⟩
    · rw [mem_sphere_zero_iff_norm, pi_norm_const]; norm_num
    · rw [mem_sphere_zero_iff_norm, pi_norm_const]; norm_num
    · simp only [affineSlope_apply, add_zero]
      rw [← Finset.sum_mul, ← Finset.sum_mul]
      intro heq
      apply hpv
      linarith
  have hb : (((affineSobolev hΩ pv 0 : weakSobolevGraph (centeredCube (0 : SpatialCoordinates d) 1 hr)) :
      SobolevData (centeredCube (0 : SpatialCoordinates d) 1 hr)).1 :
      SpatialCoordinates d → ℝ) =ᵐ[volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 hr :
        Set (SpatialCoordinates d))] (fun x => affineSlope pv x + 0) :=
    affineL2_coeFn hΩ pv 0
                                                        
  let φb : ContDiffBump (0 : SpatialCoordinates d) := ⟨1 / 8, 1 / 4, by norm_num, by norm_num⟩
  have hf : ContDiff ℝ ∞ (φb : SpatialCoordinates d → ℝ) := φb.contDiff
  have hfc : HasCompactSupport (φb : SpatialCoordinates d → ℝ) := φb.hasCompactSupport
  have hfsupp : tsupport (φb : SpatialCoordinates d → ℝ) ⊆
