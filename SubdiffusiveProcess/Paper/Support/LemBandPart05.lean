theorem aux_lem_band_U2_cutoff_ae_exp {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (N : ℕ) (omega : BilateralField d) :
    ((_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega N 0 one_pos).val : SpatialCoordinates d → ℝ)
      =ᵐ[volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d))]
      (fun x => Real.exp (cutoffPotential H omega N x - Real.log (aux_lem_band_U2_kappa M N))) := by
  have : Fact ((centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) ⊆
      closedCube (0 : SpatialCoordinates d) 1 one_pos) :=
    ⟨centeredCube_subset_closedCube (0 : SpatialCoordinates d) one_pos⟩
  have h0 := normalizedContinuousPositiveCoefficient_coeFn
    (Ω := centeredCube (0 : SpatialCoordinates d) 1 one_pos)
    (closedCube (0 : SpatialCoordinates d) 1 one_pos) (cutoffCoefficientCM M H omega N 0 one_pos)
    (cutoffCoefficientCM_pos M H omega N 0 one_pos) 1 one_pos
  filter_upwards [h0, ae_restrict_mem (centeredCube (0 : SpatialCoordinates d) 1 one_pos).isOpen.measurableSet]
    with x hx hxm
  have := hx hxm
  change (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega N 0 one_pos).val x = _
  unfold _root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient
  rw [this, div_one]
  change cutoffCoefficient M H omega N x = _
  unfold cutoffCoefficient aux_lem_band_U2_kappa
  have hA := SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M N
  have key : ∀ u : ℝ, Real.exp (u - Real.log (SubdiffusiveProcess.CoarseGrainingVocab.ahom M N)) =
      (SubdiffusiveProcess.CoarseGrainingVocab.ahom M N)⁻¹ * Real.exp u := by
    intro u; rw [Real.exp_sub, Real.exp_log hA, div_eq_inv_mul]
  rw [Real.log_mul (Real.exp_pos _).ne' hA.ne', Real.log_exp, sub_add_eq_sub_sub]
  exact (key _).symm

theorem aux_lem_band_U2_unit_dirichlet_band_probe
