  simp [Homogenization.originCube]

theorem aux_lem_band_U2_D_nonempty {d : ℕ} (n : ℕ) : (aux_lem_band_U2_D (d := d) n).Nonempty := by
  rw [aux_lem_band_U2_D_eq]; exact aux_lem_band_U2_descAtDepth_nonempty _ n

theorem aux_lem_band_U2_D_card {d : ℕ} (n : ℕ) :
    ((aux_lem_band_U2_D (d := d) n).card : ℝ) ≤ (3 : ℝ) ^ ((d : ℝ) * (n : ℝ)) := by
  rw [aux_lem_band_U2_D_eq]
  have h := aux_lem_band_U2_descAtDepth_card (Homogenization.originCube d 0) n
  have h' : ((Homogenization.descendantsAtDepth (Homogenization.originCube d 0) n).card : ℝ) ≤
      ((3 ^ (d * n) : ℕ) : ℝ) := by exact_mod_cast h
  refine h'.trans (le_of_eq ?_)
  rw [Nat.cast_pow, ← Real.rpow_natCast]
  push_cast
  ring_nf

theorem aux_lem_band_U2_gw_nonneg (sigma : ℝ) (hs : 0 ≤ sigma) (n : ℕ) :
    0 ≤ Homogenization.Book.Ch02.geometricWeight sigma 2 n := by
  unfold Homogenization.Book.Ch02.geometricWeight Homogenization.Book.Ch02.geometricDiscount
  have h1 : Real.rpow (3 : ℝ) (-sigma * 2) ≤ 1 := by
    rw [Real.rpow_eq_pow]
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by linarith)
  exact mul_nonneg (by linarith) (Real.rpow_nonneg (by norm_num) _)

theorem aux_lem_band_U2_gw_le (sigma : ℝ) (_hs : 0 ≤ sigma) (n : ℕ) :
    Homogenization.Book.Ch02.geometricWeight sigma 2 n ≤
      (3 : ℝ) ^ (-((2 * sigma) * (n : ℝ))) := by
  unfold Homogenization.Book.Ch02.geometricWeight Homogenization.Book.Ch02.geometricDiscount
  have h0 : 0 < Real.rpow (3 : ℝ) (-sigma * 2) := Real.rpow_pos_of_pos (by norm_num) _
  have h2 : Real.rpow (3 : ℝ) (-sigma * 2 * (n : ℝ)) = (3 : ℝ) ^ (-((2 * sigma) * (n : ℝ))) := by
    rw [Real.rpow_eq_pow]; congr 1; ring
  rw [h2]
  have h3 : 0 < (3 : ℝ) ^ (-((2 * sigma) * (n : ℝ))) := Real.rpow_pos_of_pos (by norm_num) _
  nlinarith

theorem aux_lem_band_U2_gw_tsum (sigma : ℝ) (hs : 0 < sigma) :
    HasSum (fun n : ℕ => Homogenization.Book.Ch02.geometricWeight sigma 2 n) 1 := by
  set r : ℝ := (3 : ℝ) ^ (-sigma * 2) with hr
  have hr0 : 0 ≤ r := Real.rpow_nonneg (by norm_num) _
  have hr1 : r < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hterm : ∀ n : ℕ, Homogenization.Book.Ch02.geometricWeight sigma 2 n = (1 - r) * r ^ n := by
    intro n
    unfold Homogenization.Book.Ch02.geometricWeight Homogenization.Book.Ch02.geometricDiscount
    rw [hr, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    simp only [Real.rpow_eq_pow]
  have hfun : (fun n : ℕ => Homogenization.Book.Ch02.geometricWeight sigma 2 n) =
      fun n => (1 - r) * r ^ n := funext hterm
  rw [hfun]
  have hg := (hasSum_geometric_of_lt_one hr0 hr1).mul_left (1 - r)
  have h1r : (1 - r) * (1 - r)⁻¹ = 1 := mul_inv_cancel₀ (by linarith)
  rw [h1r] at hg
  exact hg

theorem aux_lem_band_U2_lamF_inv_eq {d : ℕ} (sigma : ℝ)
    (F : Homogenization.Book.Ch02.TriadicCoeffFamily d) :
    (aux_lem_band_U2_lamF sigma F)⁻¹ =
      ∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight sigma 2 n *
        (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
          (fun R => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R F) := by
  unfold aux_lem_band_U2_lamF Homogenization.Book.Ch02.lambdaSq Homogenization.Book.Ch02.lambdaSqFinite
  have h22 : (2 : ℝ) / 2 = 1 := by norm_num
  simp only [h22, Real.rpow_eq_pow, Real.rpow_one, Real.rpow_neg_one, inv_inv]
  refine tsum_congr (fun n => ?_)
  congr 1
  unfold Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
    Homogenization.Book.Ch02.finsetSupReal
  rw [Finset.sup'_eq_csSup_image]

theorem aux_lem_band_U2_LamF_eq {d : ℕ} (sigma : ℝ)
    (F : Homogenization.Book.Ch02.TriadicCoeffFamily d) :
    aux_lem_band_U2_LamF sigma F =
      ∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight sigma 2 n *
        (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
          (fun R => Homogenization.Book.Ch02.coarseBMatrixNorm R F) := by
  unfold aux_lem_band_U2_LamF Homogenization.Book.Ch02.LambdaSq Homogenization.Book.Ch02.LambdaSqFinite
  have h22 : (2 : ℝ) / 2 = 1 := by norm_num
  simp only [h22, Real.rpow_eq_pow, Real.rpow_one]
  refine tsum_congr (fun n => ?_)
  congr 1
  unfold Homogenization.Book.Ch02.maxDescendantBMatrixNormAtScale
    Homogenization.Book.Ch02.finsetSupReal
  rw [Finset.sup'_eq_csSup_image]

theorem aux_lem_band_U2_gw_pos (s : ℝ) (hs : 0 < s) (n : ℕ) :
    0 < Homogenization.Book.Ch02.geometricWeight s 2 n := by
  unfold Homogenization.Book.Ch02.geometricWeight Homogenization.Book.Ch02.geometricDiscount
  have h1 : Real.rpow (3 : ℝ) (-s * 2) < 1 := by
    rw [Real.rpow_eq_pow]
    exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  exact mul_pos (by linarith) (Real.rpow_pos_of_pos (by norm_num) _)

theorem aux_lem_band_U2_iSup_toReal_eq_sup' {ι : Type*} (D : Finset ι) (hD : D.Nonempty) (f : ι → ℝ≥0∞)
    (hf : ∀ i ∈ D, f i ≠ ⊤) :
    (⨆ R : {R : ι // R ∈ D}, f R).toReal = D.sup' hD (fun R => (f R).toReal) := by
  rw [ENNReal.toReal_iSup (f := fun R : {R : ι // R ∈ D} => f R) (fun R => hf R.1 R.2),
    Finset.sup'_eq_csSup_image]
  show sSup (Set.range fun R : {R : ι // R ∈ D} => (f R).toReal) = _
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_image, Finset.mem_coe, Subtype.exists]
  constructor
  · rintro ⟨R, hR, rfl⟩; exact ⟨R, hR, rfl⟩
  · rintro ⟨R, hR, rfl⟩; exact ⟨R, hR, rfl⟩

theorem aux_lem_band_U2_errF_eq {d : ℕ} (s : ℝ) (hs : 0 < s)
    (F : Homogenization.Book.Ch02.TriadicCoeffFamily d)
    (hfin : SubdiffusiveProcess.CoarseGrainingVocab.paperHomogenizationErrorFinite
      (Homogenization.originCube d 0) 0 s Homogenization.Book.Ch02.MultiscaleExponent.infinity 2
      F 1 < ⊤) :
    (Summable fun n : ℕ => Homogenization.Book.Ch02.geometricWeight s 2 n *
        (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
          (fun R => (SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax R F 1).toReal)) ∧
    aux_lem_band_U2_errF s F 1 = Real.sqrt (∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight s 2 n *
        (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
          (fun R => (SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax R F 1).toReal)) := by
  set M : ℕ → ℝ≥0∞ := fun l => ⨆ R : {R : Homogenization.TriadicCube d // R ∈
      Homogenization.descendantsAtScale (Homogenization.originCube d 0) (0 - (l : ℤ))},
      SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax (R : Homogenization.TriadicCube d) F 1 with hM
  set T : ℕ → ℝ≥0∞ := fun l => ENNReal.ofReal (Homogenization.Book.Ch02.geometricWeight s 2 l) * M l
    with hT
  have hE : SubdiffusiveProcess.CoarseGrainingVocab.paperHomogenizationErrorFinite
      (Homogenization.originCube d 0) 0 s Homogenization.Book.Ch02.MultiscaleExponent.infinity 2 F 1 =
      (∑' l, T l) ^ (1 / (2 : ℝ)) := by
    unfold SubdiffusiveProcess.CoarseGrainingVocab.paperHomogenizationErrorFinite
      SubdiffusiveProcess.CoarseGrainingVocab.paperScaleResponseAtScale
      SubdiffusiveProcess.CoarseGrainingVocab.paperMaxDescendantProbeAtScale
    dsimp only
    congr 1
    refine tsum_congr (fun l => ?_)
    simp only [hT, hM]
    congr 1
    rw [← ENNReal.rpow_mul]
    norm_num
  have hS : ∑' l, T l ≠ ⊤ := by
    intro htop
    rw [hE, htop, ENNReal.top_rpow_of_pos (by norm_num)] at hfin
    exact lt_irrefl _ hfin
  have hTfin : ∀ l, T l ≠ ⊤ := fun l => ne_top_of_le_ne_top hS (ENNReal.le_tsum l)
  have hMfin : ∀ l, M l ≠ ⊤ := by
    intro l hMl
    have := hTfin l
    simp only [hT] at this
    rw [hMl, ENNReal.mul_top (by simp [aux_lem_band_U2_gw_pos s hs l])] at this
    exact this rfl
  have hpmfin : ∀ l, ∀ R ∈ aux_lem_band_U2_D (d := d) l,
      SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax R F 1 ≠ ⊤ := by
    intro l R hR htop
    apply hMfin l
    simp only [hM]
    refine eq_top_iff.mpr ?_
    rw [← htop]
    exact le_iSup (fun R : {R : Homogenization.TriadicCube d // R ∈
      Homogenization.descendantsAtScale (Homogenization.originCube d 0) (0 - (l : ℤ))} =>
        SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax (R : Homogenization.TriadicCube d) F 1)
      ⟨R, by simpa [aux_lem_band_U2_D, Homogenization.originCube] using hR⟩
  have hTreal : ∀ l, (T l).toReal = Homogenization.Book.Ch02.geometricWeight s 2 l *
      (aux_lem_band_U2_D (d := d) l).sup' (aux_lem_band_U2_D_nonempty l)
        (fun R => (SubdiffusiveProcess.CoarseGrainingVocab.paperScalarProbeMax R F 1).toReal) := by
    intro l
    simp only [hT, hM]
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (aux_lem_band_U2_gw_pos s hs l).le]
    congr 1
    exact aux_lem_band_U2_iSup_toReal_eq_sup' (aux_lem_band_U2_D (d := d) l) (aux_lem_band_U2_D_nonempty l) _
      (hpmfin l)
  refine ⟨?_, ?_⟩
  · have := ENNReal.summable_toReal hS
    exact this.congr hTreal
  · unfold aux_lem_band_U2_errF
    rw [hE, ← ENNReal.toReal_rpow, ENNReal.tsum_toReal_eq hTfin, Real.sqrt_eq_rpow]
    congr 1
    exact tsum_congr hTreal

