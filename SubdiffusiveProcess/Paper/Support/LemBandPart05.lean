theorem aux_lem_band_U2E_V_eq_cubeAt {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (K : ℕ) :
    (Ch02.cubeDomain (Ch02.dilateCube (K : ℤ) (Homogenization.originCube d 0)) :
      Set (Homogenization.Vec d)) =
      (Rm.cubeAt K (0 : SpatialCoordinates d) : Set (Homogenization.Vec d)) := by
  have hpow : (0 : ℝ) < (3 : ℝ) ^ K := by positivity
  have h1 : (Ch02.cubeDomain (Ch02.dilateCube (K : ℤ) (Homogenization.originCube d 0)) :
      Set (Homogenization.Vec d)) =
      (3 : ℝ) ^ K • (centeredCube (0 : SpatialCoordinates d) 1 one_pos :
        Set (SpatialCoordinates d)) := by
    show Homogenization.openCubeSet (Ch02.dilateCube (K : ℤ) (Homogenization.originCube d 0)) = _
    rw [Ch02.openCubeSet_dilateCube, Ch02.triadicDilationFactor, zpow_natCast,
      ← aux_chart_transfer_root_carrier (d := d)]
  rw [h1, show (centeredCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)) =
      Metric.ball (0 : SpatialCoordinates d) (1 / 2) from rfl,
    smul_ball (show (3 : ℝ) ^ K ≠ 0 by positivity), smul_zero,
    Real.norm_of_nonneg hpow.le, show (3 : ℝ) ^ K * (1 / 2) = (3 : ℝ) ^ K / 2 from by ring,
    Rm.cubeAt_eq K 0 hpow]
  rfl

theorem aux_lem_band_U2E_dilate_reduction {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M)
    (omega : BilateralField d) (K : ℕ)
    (a0Data : SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData
      (Ch02.cubeDomain (Homogenization.originCube d 0))
      (fun z => (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ *
        Rm.coeffScalar K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega)
          ((3 : ℝ) ^ K • z)))
    (e : Homogenization.Vec d) (he : Homogenization.vecNormSq e = 1) :
    Ch02.responseJ (Ch02.cubeDomain (Homogenization.originCube d 0)) a0Data.toCoeffOn e e ≤
      Rm.defect K (0 : SpatialCoordinates d)
        (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega) := by
  classical
  set V : Ch02.Domain d := Ch02.cubeDomain (Ch02.dilateCube (K : ℤ) (Homogenization.originCube d 0))
    with hVdef
  set b : Ch02.CoeffOn V := Ch02.CoeffOn.dilate (K : ℤ) a0Data.toCoeffOn with hbdef
  have hIsDil : Ch02.CoeffOn.IsCubeDilation (K : ℤ) a0Data.toCoeffOn b :=
    Ch02.CoeffOn.dilate_isCubeDilation (K : ℤ) a0Data.toCoeffOn
  have hdil : Ch02.responseJ V b e e =
      Ch02.responseJ (Ch02.cubeDomain (Homogenization.originCube d 0)) a0Data.toCoeffOn e e :=
    Ch02.responseJ_dilate hIsDil e e
  obtain ⟨hcontRaw, hposRaw⟩ := aux_lem_band_U2E_coeffScalar_cont_pos M Rm
    (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega) K
  obtain ⟨dataRaw⟩ := SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos
    hcontRaw hposRaw V
  have hundilate : ∀ x : Homogenization.Vec d,
      Ch02.undilateVec (K : ℤ) x = ((3 : ℝ) ^ K)⁻¹ • x := by
    intro x
    unfold Ch02.undilateVec Ch02.triadicDilationFactor
    rw [zpow_natCast]
  have hcancel : ∀ x : Homogenization.Vec d,
      (3 : ℝ) ^ K • (((3 : ℝ) ^ K)⁻¹ • x) = x := by
    intro x
    rw [smul_smul, mul_inv_cancel₀ (by positivity : (3 : ℝ) ^ K ≠ 0), one_smul]
  have hAEScaled : Ch02.CoeffOn.AEScaled (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹
      dataRaw.toCoeffOn b := by
    have hae := hIsDil.coeff_ae_eq
    refine hae.mono (fun x hx => ?_)
    rw [hx, Ch02.dilateCoeffField_apply, hundilate]
    show Homogenization.scalarMatrix ((SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ *
        Rm.coeffScalar K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega)
          ((3 : ℝ) ^ K • (((3 : ℝ) ^ K)⁻¹ • x))) =
      (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ •
        Homogenization.scalarMatrix
          (Rm.coeffScalar K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega) x)
    rw [hcancel]
    unfold Homogenization.scalarMatrix
    rw [SemigroupAction.mul_smul]
  have hlampos : (0 : ℝ) < (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ :=
    inv_pos.mpr (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M K)
  have hhom := (Ch02.responseSubadditivityAndScalingTheory V dataRaw.toCoeffOn).responseJ_homogeneous
    hlampos hAEScaled e e
  have hsqrtinv : Real.sqrt (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K)⁻¹ =
      (Real.sqrt (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K))⁻¹ := Real.sqrt_inv _
  rw [hsqrtinv, inv_inv] at hhom
  have hVeq := aux_lem_band_U2E_V_eq_cubeAt M Rm K
  have hfieldeq : dataRaw.toCoeffOn.toCoeffField =
      Rm.coeffAt K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega) := by
    funext x
    show Homogenization.scalarMatrix
        (Rm.coeffScalar K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega) x) =
      Rm.coeffAt K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega) x
    rw [Rm.coeffAt_eq K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega) x]
  have hmem : Ch02.responseJ V dataRaw.toCoeffOn
      ((Real.sqrt (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K))⁻¹ • e)
      (Real.sqrt (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K) • e) ∈
      {t : ℝ | ∃ e' : Homogenization.Vec d, Homogenization.vecNormSq e' = 1 ∧
        t = Homogenization.ResponseJ (Rm.cubeAt K (0 : SpatialCoordinates d) : Set _)
          ((Real.sqrt (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K))⁻¹ • e')
          (Real.sqrt (SubdiffusiveProcess.CoarseGrainingVocab.ahom M K) • e')
          (Rm.coeffAt K (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega))} := by
    refine ⟨e, he, ?_⟩
    rw [Homogenization.Internal.Ch02.book_responseJ_eq_ResponseJ, ← hVeq, hfieldeq]
  have hle := (Rm.defect_isGreatest K (0 : SpatialCoordinates d)
    (aux_lem_band_U2_shift (K : ℤ) (0 : SpatialCoordinates d) omega)).2 hmem
  rw [← hdil, hhom]
  exact hle

theorem aux_lem_band_U2E_two_sided {d : ℕ} (U : Homogenization.Book.Ch02.Domain d) (a : Homogenization.Book.Ch02.CoeffOn U)
    (hsym : Homogenization.Book.Ch02.CoeffOn.IsSymmetric a) (e : Homogenization.Vec d) (he : Homogenization.vecNormSq e = 1) :
    |Homogenization.vecDot e (Homogenization.matVecMul (Homogenization.Book.Ch02.sigmaCoarse U a) e) - 1| ≤
      Real.sqrt (2 * Homogenization.Book.Ch02.responseJ U a e e *
        (1 + 2 * Homogenization.Book.Ch02.responseJ U a e e + Real.sqrt (2 * Homogenization.Book.Ch02.responseJ U a e e))) ∧
    |Homogenization.vecDot e (Homogenization.matVecMul (Homogenization.Book.Ch02.sigmaStarInvCoarse U a) e) - 1| ≤
      Real.sqrt (2 * Homogenization.Book.Ch02.responseJ U a e e *
        (1 + 2 * Homogenization.Book.Ch02.responseJ U a e e + Real.sqrt (2 * Homogenization.Book.Ch02.responseJ U a e e))) := by
  set x : ℝ := Homogenization.vecDot e (Homogenization.matVecMul (Homogenization.Book.Ch02.sigmaCoarse U a) e) with hxdef
  set y : ℝ := Homogenization.vecDot e (Homogenization.matVecMul (Homogenization.Book.Ch02.sigmaStarInvCoarse U a) e) with hydef
  set J : ℝ := Homogenization.Book.Ch02.responseJ U a e e with hJdef
  have hJnonneg : 0 ≤ J := Homogenization.Book.Ch02.responseJ_nonneg U a e e
  have T := Homogenization.Book.Ch02.responseSymmetricDirichletNeumannTheory U a hsym
  have hsplit := T.response_dirichlet_neumann_split e e
  have hD := T.dirichlet_value_by_sigma e
  have hN := T.neumann_value_by_sigmaStarInv e
  have hderiv := T.derived_matrices
  have hee : Homogenization.vecDot e e = 1 := he
  have hsum : x + y - 2 = 2 * J := by
    rw [hxdef, hydef, hJdef, hsplit, hD, hN, hee]; ring
  have hune : e ≠ 0 := by
    intro h0
    rw [h0] at he
    simp [Homogenization.vecNormSq, Homogenization.vecDot] at he
  have hxpos : 0 < x := by
    rw [hxdef, ← hderiv.2.2]
    simpa [Homogenization.vecDot, Homogenization.matVecMul, dotProduct, Matrix.mulVec] using
      (Homogenization.Book.Ch02.bCoarse_posDef U a).dotProduct_mulVec_pos hune
  have hypos : 0 < y := by
    rw [hydef]
    simpa [Homogenization.vecDot, Homogenization.matVecMul, dotProduct, Matrix.mulVec] using
      (Homogenization.Book.Ch02.sigmaStarInvCoarse_posDef U a).dotProduct_mulVec_pos hune
  have hxy : 1 ≤ x * y := by
    have hCS := SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.sq_vecNormSq_le_vecDot_bCoarse_mul_vecDot_sigmaStarInvCoarse U a e
    rw [he] at hCS
    rw [hxdef, hydef, ← hderiv.2.2]
    simpa using hCS
  have hyx : 1 ≤ y * x := by rw [mul_comm]; exact hxy
  have hfx : SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.invMulSubOneSq x ≤ x + y - 2 := SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.invMulSubOneSq_le_add_sub_two hxpos hxy
  have hfy : SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.invMulSubOneSq y ≤ y + x - 2 := SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.invMulSubOneSq_le_add_sub_two hypos hyx
  rw [hsum] at hfx
  have hfy' : SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.invMulSubOneSq y ≤ 2 * J := by rw [show y + x - 2 = x + y - 2 by ring, hsum] at hfy; exact hfy
  have h2Jnn : 0 ≤ 2 * J := by linarith
  have hxub : x - 1 ≤ 2 * J + Real.sqrt (2 * J) :=
    SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.sub_one_le_add_sqrt_of_invMulSubOneSq_le hxpos h2Jnn hfx
  have hyub : y - 1 ≤ 2 * J + Real.sqrt (2 * J) :=
    SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.sub_one_le_add_sqrt_of_invMulSubOneSq_le hypos h2Jnn hfy'
  have hxle : x ≤ 1 + 2 * J + Real.sqrt (2 * J) := by linarith
  have hyle : y ≤ 1 + 2 * J + Real.sqrt (2 * J) := by linarith
  have hUnn : 0 ≤ 1 + 2 * J + Real.sqrt (2 * J) := by positivity
  have hxsq : (x - 1) ^ 2 ≤ 2 * J * x := by
    have hmul := mul_le_mul_of_nonneg_left hfx hxpos.le
    rw [SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.invMulSubOneSq, ← mul_assoc, mul_inv_cancel₀ hxpos.ne', one_mul, mul_comm] at hmul
    linarith [hmul]
  have hysq : (y - 1) ^ 2 ≤ 2 * J * y := by
    have hmul := mul_le_mul_of_nonneg_left hfy' hypos.le
    rw [SubdiffusiveProcess.CoarseGrainingVocab.Section4Recursion.ErrorComparison.invMulSubOneSq, ← mul_assoc, mul_inv_cancel₀ hypos.ne', one_mul, mul_comm] at hmul
    linarith [hmul]
  have hxsq' : (x - 1) ^ 2 ≤ 2 * J * (1 + 2 * J + Real.sqrt (2 * J)) := by
    have := mul_le_mul_of_nonneg_left hxle h2Jnn
    linarith [hxsq, this]
  have hysq' : (y - 1) ^ 2 ≤ 2 * J * (1 + 2 * J + Real.sqrt (2 * J)) := by
    have := mul_le_mul_of_nonneg_left hyle h2Jnn
    linarith [hysq, this]
  have hbig : 0 ≤ 2 * J * (1 + 2 * J + Real.sqrt (2 * J)) := mul_nonneg h2Jnn hUnn
  constructor
  · rw [hxdef]
    have := Real.sqrt_le_sqrt hxsq'
    rwa [Real.sqrt_sq_eq_abs] at this
  · rw [hydef]
    have := Real.sqrt_le_sqrt hysq'
    rwa [Real.sqrt_sq_eq_abs] at this

def aux_lem_band_U2E_rate (J : ℝ) : ℝ := Real.sqrt (2 * J * (1 + 2 * J + Real.sqrt (2 * J)))

theorem aux_lem_band_U2E_rate_mono {J1 J2 : ℝ} (h0 : 0 ≤ J1) (h : J1 ≤ J2) :
    aux_lem_band_U2E_rate J1 ≤ aux_lem_band_U2E_rate J2 := by
  unfold aux_lem_band_U2E_rate
  have h0' : 0 ≤ J2 := h0.trans h
  gcongr

theorem aux_lem_band_U2E_rate_le (x : ℝ) (hx : 0 ≤ x) :
    aux_lem_band_U2E_rate x ≤ Real.sqrt 6 * (Real.sqrt x + x) := by
  unfold aux_lem_band_U2E_rate
  set s : ℝ := Real.sqrt x with hsdef
  have hs0 : 0 ≤ s := Real.sqrt_nonneg x
  have hs2 : s ^ 2 = x := Real.sq_sqrt hx
  rw [← hs2]
  have h2x : Real.sqrt (2 * s ^ 2) = Real.sqrt 2 * s := by
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_sq hs0]
  rw [h2x]
  have hrw : 2 * s ^ 2 * (1 + 2 * s ^ 2 + Real.sqrt 2 * s) =
      2 * s ^ 2 + 4 * s ^ 4 + 2 * Real.sqrt 2 * s ^ 3 := by ring
  rw [hrw]
  have hsq2le : Real.sqrt 2 ≤ 2 := by
    have h4 : (2:ℝ) = Real.sqrt 4 := by
      rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 2)]
    rw [h4]; exact Real.sqrt_le_sqrt (by norm_num)
  have hcube : Real.sqrt 2 * s ^ 3 ≤ 2 * s ^ 3 :=
    mul_le_mul_of_nonneg_right hsq2le (pow_nonneg hs0 3)
  have hle2 : 2 * s ^ 2 + 4 * s ^ 4 + 2 * Real.sqrt 2 * s ^ 3 ≤
      6 * s ^ 2 + 12 * s ^ 3 + 6 * s ^ 4 := by
    nlinarith [pow_nonneg hs0 2, pow_nonneg hs0 3, pow_nonneg hs0 4, hcube]
  have hexpand : (Real.sqrt 6 * (s + s ^ 2)) ^ 2 = 6 * s ^ 2 + 12 * s ^ 3 + 6 * s ^ 4 := by
    have h6 : Real.sqrt 6 ^ 2 = 6 := Real.sq_sqrt (by norm_num)
    rw [mul_pow, h6]; ring
  have hfinal2 : 2 * s ^ 2 + 4 * s ^ 4 + 2 * Real.sqrt 2 * s ^ 3 ≤
      (Real.sqrt 6 * (s + s ^ 2)) ^ 2 := by rw [hexpand]; exact hle2
  have hrhs_nonneg : 0 ≤ Real.sqrt 6 * (s + s ^ 2) := by positivity
  calc Real.sqrt (2 * s ^ 2 + 4 * s ^ 4 + 2 * Real.sqrt 2 * s ^ 3)
      ≤ Real.sqrt ((Real.sqrt 6 * (s + s ^ 2)) ^ 2) := Real.sqrt_le_sqrt hfinal2
    _ = Real.sqrt 6 * (s + s ^ 2) := Real.sqrt_sq hrhs_nonneg

theorem aux_lem_band_U2E_quad_single_single {d : ℕ} (A : Homogenization.Mat d) (i j : Fin d) :
    Homogenization.vecDot (Pi.single i (1 : ℝ)) (Homogenization.matVecMul A (Pi.single j (1 : ℝ))) = A i j := by
  unfold Homogenization.vecDot Homogenization.matVecMul
  rw [Finset.sum_eq_single i]
  · rw [Finset.sum_eq_single j]
    · simp
    · intro l _ hlj; simp [Ne.symm hlj]
    · intro h; exact absurd (Finset.mem_univ j) h
  · intro k _ hki
    simp [Pi.single_apply, Ne.symm hki]
  · intro h; exact absurd (Finset.mem_univ i) h

theorem aux_lem_band_U2E_quad_diag {d : ℕ} (A : Homogenization.Mat d) (i : Fin d) :
    Homogenization.vecDot (Pi.single i (1 : ℝ)) (Homogenization.matVecMul A (Pi.single i (1 : ℝ))) = A i i :=
  aux_lem_band_U2E_quad_single_single A i i

theorem aux_lem_band_U2E_quad_offdiag {d : ℕ} (A : Homogenization.Mat d) (hA : A.IsSymm) (i j : Fin d) :
    Homogenization.vecDot (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ))
        (Homogenization.matVecMul A (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ))) =
      A i i + 2 * A i j + A j j := by
  have hji : A j i = A i j := by
    have := congrFun (congrFun hA.eq j) i
    simpa [Matrix.transpose_apply] using this.symm
  rw [Homogenization.matVecMul_add, Homogenization.vecDot_add_left, Homogenization.vecDot_add_right, Homogenization.vecDot_add_right,
    aux_lem_band_U2E_quad_single_single, aux_lem_band_U2E_quad_single_single, aux_lem_band_U2E_quad_single_single,
    aux_lem_band_U2E_quad_single_single, hji]
  ring

theorem aux_lem_band_U2E_abs_sub_sub_le (A B C : ℝ) : |A - B - C| ≤ |A| + |B| + |C| := by
  have heq : A - B - C = A + (-B) + (-C) := by ring
  rw [heq]
  calc |A + (-B) + (-C)| ≤ |A + (-B)| + |-C| := abs_add_le _ _
    _ ≤ |A| + |-B| + |-C| := by
        have h1 : |A + (-B)| ≤ |A| + |-B| := abs_add_le _ _
        linarith
    _ = |A| + |B| + |C| := by rw [abs_neg, abs_neg]

theorem aux_lem_band_U2E_single_dot {d : ℕ} (i j : Fin d) :
    Homogenization.vecDot (Pi.single i (1 : ℝ)) (Pi.single j (1 : ℝ)) = if i = j then (1 : ℝ) else 0 := by
  have h := aux_lem_band_U2E_quad_single_single (1 : Homogenization.Mat d) i j
  rw [show Homogenization.matVecMul (1 : Homogenization.Mat d) (Pi.single j (1:ℝ)) = Pi.single j (1:ℝ) by
    funext k; simp [Homogenization.matVecMul, Matrix.one_apply]] at h
  rw [h, Matrix.one_apply]

theorem aux_lem_band_U2E_offdiag_unit {d : ℕ} (i j : Fin d) (hij : i ≠ j) :
    Homogenization.vecNormSq ((Real.sqrt 2)⁻¹ • (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ))) = 1 := by
  rw [Homogenization.vecNormSq_smul]
  have hexp : Homogenization.vecNormSq (Pi.single i (1:ℝ) + Pi.single j (1:ℝ)) =
      Homogenization.vecDot (Pi.single i (1:ℝ)) (Pi.single i (1:ℝ)) +
        Homogenization.vecDot (Pi.single i (1:ℝ)) (Pi.single j (1:ℝ)) +
        (Homogenization.vecDot (Pi.single j (1:ℝ)) (Pi.single i (1:ℝ)) +
          Homogenization.vecDot (Pi.single j (1:ℝ)) (Pi.single j (1:ℝ))) := by
    show Homogenization.vecDot _ _ = _
    rw [Homogenization.vecDot_add_left, Homogenization.vecDot_add_right, Homogenization.vecDot_add_right]
  have hsq : (Real.sqrt 2)⁻¹ ^ 2 = 1 / 2 := by
    rw [inv_pow, Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 2)]
    norm_num
  rw [hsq, hexp, aux_lem_band_U2E_single_dot, aux_lem_band_U2E_single_dot, aux_lem_band_U2E_single_dot, aux_lem_band_U2E_single_dot]
  simp only [ite_eq_right hij, ite_eq_right (Ne.symm hij)]
  norm_num

theorem aux_lem_band_U2E_entries {d : ℕ} (U : Homogenization.Book.Ch02.Domain d) (a : Homogenization.Book.Ch02.CoeffOn U)
    (hsym : Homogenization.Book.Ch02.CoeffOn.IsSymmetric a) (i j : Fin d) (hij : i ≠ j) :
    |Homogenization.Book.Ch02.sigmaCoarse U a i i - 1| ≤ aux_lem_band_U2E_rate (Homogenization.Book.Ch02.responseJ U a
        (Pi.single i (1:ℝ)) (Pi.single i (1:ℝ))) ∧
    |Homogenization.Book.Ch02.sigmaCoarse U a j j - 1| ≤ aux_lem_band_U2E_rate (Homogenization.Book.Ch02.responseJ U a
        (Pi.single j (1:ℝ)) (Pi.single j (1:ℝ))) ∧
    |Homogenization.Book.Ch02.sigmaCoarse U a i j| ≤
      aux_lem_band_U2E_rate ((1/2 : ℝ) * Homogenization.Book.Ch02.responseJ U a
        (Pi.single i (1:ℝ) + Pi.single j (1:ℝ)) (Pi.single i (1:ℝ) + Pi.single j (1:ℝ))) +
      (1/2 : ℝ) * aux_lem_band_U2E_rate (Homogenization.Book.Ch02.responseJ U a (Pi.single i (1:ℝ)) (Pi.single i (1:ℝ))) +
      (1/2 : ℝ) * aux_lem_band_U2E_rate (Homogenization.Book.Ch02.responseJ U a (Pi.single j (1:ℝ)) (Pi.single j (1:ℝ))) := by
  unfold aux_lem_band_U2E_rate
  have hnormsq : ∀ k : Fin d, Homogenization.vecNormSq (Pi.single k (1:ℝ)) = 1 := by
    intro k
    show Homogenization.vecDot (Pi.single k (1:ℝ)) (Pi.single k (1:ℝ)) = 1
    rw [aux_lem_band_U2E_single_dot]; simp
  have hii := (aux_lem_band_U2E_two_sided U a hsym (Pi.single i (1:ℝ)) (hnormsq i)).1
  rw [aux_lem_band_U2E_quad_diag] at hii
  have hjj := (aux_lem_band_U2E_two_sided U a hsym (Pi.single j (1:ℝ)) (hnormsq j)).1
  rw [aux_lem_band_U2E_quad_diag] at hjj
  have hoff := (aux_lem_band_U2E_two_sided U a hsym
    ((Real.sqrt 2)⁻¹ • (Pi.single i (1:ℝ) + Pi.single j (1:ℝ)))
    (aux_lem_band_U2E_offdiag_unit i j hij)).1
  have hsymmat : (Homogenization.Book.Ch02.sigmaCoarse U a).IsSymm := Homogenization.Book.Ch02.sigmaCoarse_isSymm U a
  rw [Homogenization.matVecMul_smul, Homogenization.vecDot_smul_left, Homogenization.vecDot_smul_right,
    aux_lem_band_U2E_quad_offdiag _ hsymmat] at hoff
  have hr2sq : (Real.sqrt 2)⁻¹ * (Real.sqrt 2)⁻¹ = 1 / 2 := by
    rw [← mul_inv, Real.mul_self_sqrt (by norm_num : (0:ℝ) ≤ 2)]
    norm_num
  rw [← mul_assoc, hr2sq] at hoff
  have hJscale : (1 / 2 : ℝ) * Homogenization.Book.Ch02.responseJ U a
      (Pi.single i (1:ℝ) + Pi.single j (1:ℝ)) (Pi.single i (1:ℝ) + Pi.single j (1:ℝ)) =
      Homogenization.Book.Ch02.responseJ U a ((Real.sqrt 2)⁻¹ • (Pi.single i (1:ℝ) + Pi.single j (1:ℝ)))
        ((Real.sqrt 2)⁻¹ • (Pi.single i (1:ℝ) + Pi.single j (1:ℝ))) := by
    rw [Homogenization.Book.Ch02.responseJ_smul, pow_two, hr2sq]
  rw [hJscale]
  refine ⟨hii, hjj, ?_⟩
  have hdecomp : Homogenization.Book.Ch02.sigmaCoarse U a i j =
      ((1/2 : ℝ) * (Homogenization.Book.Ch02.sigmaCoarse U a i i + 2 * Homogenization.Book.Ch02.sigmaCoarse U a i j +
          Homogenization.Book.Ch02.sigmaCoarse U a j j) - 1) -
        (1/2 : ℝ) * (Homogenization.Book.Ch02.sigmaCoarse U a i i - 1) -
        (1/2 : ℝ) * (Homogenization.Book.Ch02.sigmaCoarse U a j j - 1) := by ring
  rw [hdecomp]
  refine (aux_lem_band_U2E_abs_sub_sub_le _ _ _).trans ?_
  have e1 : |(1/2 : ℝ) * (Homogenization.Book.Ch02.sigmaCoarse U a i i - 1)| =
      (1/2 : ℝ) * |Homogenization.Book.Ch02.sigmaCoarse U a i i - 1| := by
    rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 1/2)]
  have e2 : |(1/2 : ℝ) * (Homogenization.Book.Ch02.sigmaCoarse U a j j - 1)| =
      (1/2 : ℝ) * |Homogenization.Book.Ch02.sigmaCoarse U a j j - 1| := by
    rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 1/2)]
  rw [e1, e2]
  gcongr

theorem aux_lem_band_U2E_entries_starInv {d : ℕ} (U : Homogenization.Book.Ch02.Domain d) (a : Homogenization.Book.Ch02.CoeffOn U)
    (hsym : Homogenization.Book.Ch02.CoeffOn.IsSymmetric a) (i j : Fin d) (hij : i ≠ j) :
