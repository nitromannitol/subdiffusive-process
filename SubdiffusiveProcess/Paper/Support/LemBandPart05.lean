  have hfac : (fun omega : BilateralField d => omega j) =
      (fun g : Set.Icc (-(h : ℤ)) (h : ℤ) → C(SpatialCoordinates d, ℝ) => g ⟨j, hj⟩) ∘
        (fun omega : BilateralField d => fun i : Set.Icc (-(h : ℤ)) (h : ℤ) => omega (i : ℤ)) := rfl
  change MeasurableSpace.comap (fun omega : BilateralField d => omega j) inferInstance ≤ _
  rw [hfac, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_pi_apply _).comap_le

theorem aux_lem_band_U2N_pde_probe
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : in_J d) (P : in_poincare d hd I) (X : in_extension d hd I)
    (W : SmallPerturbationInput d) (S : SobolevFoundationalInput d hd)
    (D : lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (pvec : Fin d → ℝ) (hpvec : ∑ i, (pvec i)^2 = 1) (q : ℝ) (hq : 1 ≤ q) :
    ∃ δ0 C B : ℝ, 0 < δ0 ∧ 0 ≤ C ∧ 0 ≤ B ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ δ0 →
      ∀ (Rm : in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : in_6_16 d M) (_It : in_iteration d M I Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
      InfraredCharacterization M H →
      let yN : ℕ → BilateralField d → ℝ := fun N o =>
        affineInverseNeumannResponse (aux_lem_band_U2N_poincareN (aux_lem_band_U2N_zn d))
          (cutoffPositiveCoefficient M H o N (aux_lem_band_U2N_zn d) one_pos) pvec
      ∀ N h : ℕ,
        MemLp (yN N) (ENNReal.ofReal (2*q)) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (yN N) (ENNReal.ofReal (2*q)) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal B ∧
        aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-(h:ℤ)) (h:ℤ) (2*q)
          (yN N) (C * M.delta^(1/2:ℝ) * (3:ℝ)^(-(aux_lem_band_U2N_aN d * (h:ℝ)))) := by
  let t : ℝ := (d:ℝ)-1/2
  have ht0 : (d:ℝ)-1 < t := by dsimp [t]; linarith
  have ht1 : t < d := by dsimp [t]; linarith
  let p : ℝ := 2*q
  have hp : 2 ≤ p := by dsimp [p]; linarith
  let hP := aux_lem_band_U2N_poincareN (aux_lem_band_U2N_zn d)
  obtain ⟨rho, Cρ, fL2, Cload, Cy, hrho, hrho0, hrhos, hrhoi, hCρ, hface, hmean,
      hfL2, hCload, hload, hCy, hresponse⟩ :=
    aux_lem_prefix_limit_atom_extraction_neumann_data d hd S pvec hpvec
  obtain ⟨δc, hδc, B9, Bsm, hB9, hBsm, hcoer⟩ :=
    aux_lem_band_rem_bank_uniform_neumann_coercive d hd I P S Cresp hCresp p hp
      rho hrho hrho0 hrhos hrhoi pvec hpvec hP
  obtain ⟨δg, hδg, B13, hB13, hgrowth⟩ :=
    aux_lem_band_rem_bank_uniform_neumann_growth d hd I P X W D t ht0 ht1 Cresp hCresp p hp
      rho hrho hrho0 hrhos hrhoi pvec hpvec
  obtain ⟨δe, Ke, Cerr, Cunif, hδe, hKe, hCerr, hCunif, herr⟩ :=
    lem_neumann_error d hd I P S p (by linarith) B9 B9 hB9 hB9
  let B : ℝ := B9+Bsm+B13+Cerr
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have h9B : B9 ≤ B := by dsimp [B]; linarith
  have hsmB : Bsm ≤ B := by dsimp [B]; linarith
  have h13B : B13 ≤ B := by dsimp [B]; linarith
  have heB : Cerr ≤ B := by dsimp [B]; linarith
  obtain ⟨δp, Cp, hδp, hδp1, hCp, hprop⟩ := prop_16.2 d hd I Cresp hCresp
    rho hrho hrho0 hrhos hrhoi pvec hpvec hP fL2
    (fun eps he => hfL2 eps he.1 he.2) t p B ⟨ht0, ht1, hp, hB⟩
  obtain ⟨δs, hδs, hδs1, hsmall⟩ := aux_lem_band_U2N_small_delta Cresp hCresp p (by linarith)
  refine ⟨min δc (min δg (min δe (min δp δs))), Cp, B9,
    lt_min hδc (lt_min hδg (lt_min hδe (lt_min hδp hδs))), hCp.le, hB9, ?_⟩
  intro M hM Rm hRm Sreg It H hH
  have hMc := hM.trans (min_le_left _ _)
  have hMg := hM.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hMe := hM.trans ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
  have hMp := hM.trans ((min_le_right _ _).trans ((min_le_right _ _).trans
    ((min_le_right _ _).trans (min_le_left _ _))))
  have hMs := hM.trans ((min_le_right _ _).trans ((min_le_right _ _).trans
    ((min_le_right _ _).trans (min_le_right _ _))))
  obtain ⟨Kco, hKco, hmem, hnorm, hsm⟩ := hcoer M Rm hRm H hH hMc
  obtain ⟨Kg, hga, hgm⟩ := hgrowth M Rm hRm Sreg It H hH hMg
  let yN : ℕ → BilateralField d → ℝ := fun N o => affineInverseNeumannResponse hP
    (cutoffPositiveCoefficient M H o N (aux_lem_band_U2N_zn d) one_pos) pvec
  change ∀ N h, MemLp (yN N) _ _ ∧ _
  have hk12 N : eLpNorm (Kco N) (ENNReal.ofReal (12*p)) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal B9 :=
    (le_add_right (le_add_right (le_add_right le_rfl))).trans (hnorm N)
  have hy12 N : eLpNorm (yN N) (ENNReal.ofReal (12*p)) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal B9 :=
    (le_add_right (le_add_right (le_add_left le_rfl))).trans (hnorm N)
  have h412 : ENNReal.ofReal (4*p) ≤ ENNReal.ofReal (12*p) := ENNReal.ofReal_le_ofReal (by linarith)
  have hK4 N := (hmem N).1.mono_exponent h412
  have hy4 N := (hmem N).2.1.mono_exponent h412
  have hKn4 N := (eLpNorm_le_eLpNorm_of_exponent_le h412).trans (hk12 N)
  have hyn4 N := (eLpNorm_le_eLpNorm_of_exponent_le h412).trans (hy12 N)
  have herror N eps (he : 0 < eps ∧ eps < 1/8) :=
    (herr M Rm H hH hMe rho hrho hrho0 hrhos hrhoi pvec hpvec hP Kco
      (fun N o => (hKco N o).2) hK4 hKn4 hy4 hyn4 eps he.1 he.2
      (fun _ _ => fL2 eps) (fun _ _ => hfL2 eps he.1 he.2) N (0 : BilateralField d)).2.1
  have hgrowth' : ∀ᵐ o ∂(chaosSampleLaw M).toMeasure,
      ∀ N eps, (0 < eps ∧ eps < 1/8) → ∀ x rad,
      x ∈ unitNeumannCube d → (0 < rad ∧ rad ≤ 1) →
      localGradientEnergy (cutoffPositiveCoefficient M H o N (aux_lem_band_U2N_zn d) one_pos)
        (s := Metric.ball x rad ∩ (unitNeumannCube d : Set (SpatialCoordinates d)))
        (Metric.isOpen_ball.measurableSet.inter (unitNeumannCube d).isOpen.measurableSet)
        (subspaceGradient (meanZeroResponseSpace hP).space
          (responseSolution (meanZeroResponseSpace hP)
            (cutoffPositiveCoefficient M H o N (aux_lem_band_U2N_zn d) one_pos)
            ((sobolevVolumeLoad (fL2 eps)).comp (meanZeroResponseSpace hP).space.subtypeL))) ≤
        Kg N o * eps^(-2:ℝ) * rad^t := by
    filter_upwards [hga] with o ho
    intro N eps he x rad hx hr
    exact (ho N).2 eps he.1 he.2 _
      (aux_lem_prefix_limit_atom_extraction_solvesN hP _ _ _ (hfL2 eps he.1 he.2)
        (hmean eps he.1 he.2)) x hx rad hr.1 hr.2
  have hmain := hprop M ⟨M.shellPrefix.delta_pos, hMp⟩ Rm hRm
    (hsmall M.delta M.shellPrefix.delta_pos hMs) H hH Kg
    (fun N => (hgm N).1.aestronglyMeasurable) (hga.mono (fun o ho N => (ho N).1)) hgrowth'
    (fun N => ⟨(hgm N).1, (hgm N).2.trans (ENNReal.ofReal_le_ofReal h13B)⟩)
    (fun N eps he => ⟨(hsm eps he.1 he.2 (fL2 eps) (hfL2 eps he.1 he.2) N).1,
      ((le_add_right le_rfl).trans (hsm eps he.1 he.2 (fL2 eps) (hfL2 eps he.1 he.2) N).2.2).trans
        (ENNReal.ofReal_le_ofReal hsmB)⟩)
    (fun N => ⟨hy4 N, (hyn4 N).trans (ENNReal.ofReal_le_ofReal h9B)⟩)
    (fun N eps he => (herror N eps he).trans (ENNReal.ofReal_le_ofReal
      (mul_le_mul_of_nonneg_right heB (Real.rpow_nonneg he.1.le _))))
  intro N h
  have h112 : ENNReal.ofReal p ≤ ENNReal.ofReal (12*p) := ENNReal.ofReal_le_ofReal (by linarith)
  refine ⟨(hmem N).2.1.mono_exponent h112,
    (eLpNorm_le_eLpNorm_of_exponent_le h112).trans (hy12 N), ?_⟩
  refine ⟨(chaosSampleLaw M).toMeasure[yN N | bandSigma (fun _ : ℤ => C(SpatialCoordinates d, ℝ)) h],
    (stronglyMeasurable_condExp.mono (aux_lem_band_U2_bandSigma_le h)).aestronglyMeasurable, ?_⟩
  simpa only [yN, affineInverseNeumannResponse, aux_lem_band_U2N_aN, t, p,
    Real.sqrt_eq_rpow, aux_lem_band_U2N_zn] using! (hmain.1 h N)

theorem aux_lem_band_U2N_chart_neumann_eq {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d)
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (omega : BilateralField d) (K : ℕ)
    (qv : Fin d → ℝ) :
    Homogenization.Book.Ch02.responseJ
        (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
        ((I.chart (aux_lem_band_U2N_zn d) 1 one_pos
            (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K (aux_lem_band_U2N_zn d) one_pos)
            (aux_lem_band_U2N_zn d) 1).coeffOn (Homogenization.originCube d 0)) 0 qv =
      affineInverseNeumannResponse (aux_lem_band_U2N_poincareN (aux_lem_band_U2N_zn d))
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K (aux_lem_band_U2N_zn d) one_pos) qv /
        (2 * volume.real (unitNeumannCube d : Set (SpatialCoordinates d))) := by
  set zn := aux_lem_band_U2N_zn d with hzndef
  set aK := _root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K zn one_pos with hAKdef
  set D0 : Homogenization.Book.Ch02.Domain d :=
    Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0) with hD0def
  have hQdom : Homogenization.IsOpenBoundedConvexDomain
      (unitNeumannCube d : Set (SpatialCoordinates d)) := aux_lem_band_U2N_convex zn
  have hQne : (unitNeumannCube d : Set (SpatialCoordinates d)).Nonempty :=
    ⟨zn, by
      show zn ∈ Metric.ball zn (1/2)
      exact Metric.mem_ball_self (by norm_num)⟩
  set Dn : Homogenization.Book.Ch02.Domain d := ⟨(unitNeumannCube d : Set _), hQdom, hQne⟩
    with hDndef
                                                                   
  set g : SpatialCoordinates d → ℝ := fun x => cutoffCoefficient M H omega K (zn + x) with hgdef
  have hg_cont : Continuous g :=
    (cutoffCoefficient_continuous M H omega K).comp (continuous_const.add continuous_id)
  have hg_pos : ∀ x, 0 < g x := fun x => cutoffCoefficient_pos M H omega K _
  obtain ⟨data0⟩ :=
    SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos
      hg_cont hg_pos D0
  obtain ⟨dataUnit⟩ :=
    SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos
      (cutoffCoefficient_continuous M H omega K) (cutoffCoefficient_pos M H omega K) Dn
                                                                      
  have hcar := aux_chart_transfer_root_carrier (d := d)
  have hD0set : (D0 : Set (Homogenization.Vec d)) =
      Homogenization.openCubeSet (Homogenization.originCube d 0) := by
    simp [hD0def, Homogenization.Book.Ch02.cubeDomain_coe]
  have hshift_set : (centeredCube zn 1 one_pos : Set (SpatialCoordinates d)) =
      Homogenization.translateSet zn (D0 : Set (Homogenization.Vec d)) := by
    rw [hD0set, ← hcar]
    ext x
    rw [Homogenization.mem_translateSet_iff_sub_mem]
    show x ∈ Metric.ball zn (1 / 2) ↔ x - zn ∈ Metric.ball (0 : SpatialCoordinates d) (1 / 2)
    rw [Metric.mem_ball, Metric.mem_ball, dist_eq_norm, dist_eq_norm, sub_zero]
  have hunit_set : (Dn : Set (Homogenization.Vec d)) =
      Homogenization.translateSet zn (D0 : Set (Homogenization.Vec d)) := hshift_set
                                                                       
  have haK_ae : ∀ᵐ y ∂volume.restrict (centeredCube zn 1 one_pos : Set (SpatialCoordinates d)),
      ∀ _hy : y ∈ (centeredCube zn 1 one_pos : Set (SpatialCoordinates d)),
      aK.val y = cutoffCoefficient M H omega K y / 1 := by
    have : Fact ((centeredCube zn 1 one_pos : Set (SpatialCoordinates d)) ⊆
        closedCube zn 1 one_pos) := ⟨centeredCube_subset_closedCube zn one_pos⟩
    exact normalizedContinuousPositiveCoefficient_coeFn _ _ _ 1 one_pos
  have hmp : MeasureTheory.MeasurePreserving (fun x : SpatialCoordinates d => x + zn)
      (volume.restrict (D0 : Set (Homogenization.Vec d)))
      (volume.restrict (Homogenization.translateSet zn (D0 : Set (Homogenization.Vec d)))) :=
    Homogenization.measurePreserving_addRight_restrict_translateSet zn
      (D0 : Set (Homogenization.Vec d))
  have haK_ae' : ∀ᵐ x ∂volume.restrict (D0 : Set (Homogenization.Vec d)),
      ∀ _hy : x + zn ∈ (centeredCube zn 1 one_pos : Set (SpatialCoordinates d)),
      aK.val (x + zn) = cutoffCoefficient M H omega K (x + zn) / 1 := by
    have hpush : ∀ᵐ y ∂ (MeasureTheory.Measure.map (fun x : SpatialCoordinates d => x + zn)
        (volume.restrict (D0 : Set (Homogenization.Vec d)))),
        ∀ _hy : y ∈ (centeredCube zn 1 one_pos : Set (SpatialCoordinates d)),
        aK.val y = cutoffCoefficient M H omega K y / 1 := by
      rw [hmp.map_eq, ← hshift_set]
      exact haK_ae
    exact MeasureTheory.ae_of_ae_map hmp.aemeasurable hpush
  have hmemD0 : ∀ x ∈ (D0 : Set (Homogenization.Vec d)),
      x + zn ∈ (centeredCube zn 1 one_pos : Set (SpatialCoordinates d)) := by
    intro x hx
    rw [hshift_set, Homogenization.mem_translateSet_iff_sub_mem, add_sub_cancel_right]
    exact hx
  have h1 := I.chart_eq zn 1 one_pos aK zn 1 one_pos subset_rfl
    (Homogenization.originCube d 0) subset_rfl
  set A := (I.chart zn 1 one_pos aK zn 1).coeffOn (Homogenization.originCube d 0) with hAdef
  have hAE : Homogenization.Book.Ch02.CoeffOn.AEEq A data0.toCoeffOn := by
    show A.toCoeffField =ᵐ[Homogenization.volumeMeasureOn (D0 : Set (Homogenization.Vec d))]
      data0.toCoeffOn.toCoeffField
    rw [← hD0set] at h1
    rw [Homogenization.volumeMeasureOn, hD0set]
    filter_upwards [h1, haK_ae', MeasureTheory.ae_restrict_mem
      (D0.isDomain.isOpen.measurableSet)] with x hx1 hx2 hxm
    have hshifteq : (fun i => zn i + 1 * x i) = x + zn := by
      funext i; simp [add_comm]
    rw [hAdef]
    rw [show (fun i => zn i + 1 * x i) = x + zn from hshifteq] at hx1
    rw [hx1, hx2 (hmemD0 x hxm)]
    show Homogenization.scalarMatrix (cutoffCoefficient M H omega K (x + zn) / 1) =
      Homogenization.scalarMatrix (g x)
    rw [div_one, hgdef]
    congr 2
    abel
                                                                             
  set c0data : Homogenization.Book.Ch02.CoeffOn Dn :=
    aux_neumann_response_defect_transport_translateCoeffOn D0 Dn zn hunit_set data0.toCoeffOn
    with hc0def
  have hc0_eq : c0data.toCoeffField = dataUnit.toCoeffOn.toCoeffField := by
    funext x
    show Homogenization.translateCoeffField (-zn) data0.toCoeffOn.toCoeffField x = _
    show data0.toCoeffOn.toCoeffField (x + -zn) = _
    show Homogenization.scalarMatrix (g (x + -zn)) =
      Homogenization.scalarMatrix (cutoffCoefficient M H omega K x)
    congr 2
    rw [hgdef]
    show cutoffCoefficient M H omega K (zn + (x + -zn)) = cutoffCoefficient M H omega K x
    congr 1
    abel
  have hc0_ae : Homogenization.Book.Ch02.CoeffOn.AEEq c0data dataUnit.toCoeffOn := by
    show c0data.toCoeffField =ᵐ[Homogenization.volumeMeasureOn (Dn : Set (Homogenization.Vec d))]
      dataUnit.toCoeffOn.toCoeffField
    rw [hc0_eq]
  have hsig_translate := aux_neumann_response_defect_transport_sigma_translate D0 Dn zn hunit_set
    data0.toCoeffOn
  have hsig_eq : Homogenization.Book.Ch02.sigmaStarInvCoarse D0 data0.toCoeffOn =
      Homogenization.Book.Ch02.sigmaStarInvCoarse Dn dataUnit.toCoeffOn := by
    rw [← hsig_translate]
    exact Homogenization.Book.Ch02.sigmaStarInvCoarse_eq_ofAEEq hc0_ae
                                            
  have hsym0 : Homogenization.Book.Ch02.CoeffOn.IsSymmetric data0.toCoeffOn :=
    Filter.Eventually.of_forall (fun x => Homogenization.scalarMatrix_isSymm _)
  have hsymUnit : Homogenization.Book.Ch02.CoeffOn.IsSymmetric dataUnit.toCoeffOn :=
    Filter.Eventually.of_forall (fun x => Homogenization.scalarMatrix_isSymm _)
  have hsymA : Homogenization.Book.Ch02.CoeffOn.IsSymmetric A := by
    unfold Homogenization.Book.Ch02.CoeffOn.IsSymmetric
    filter_upwards [hAE] with x hx
    rw [hx]
    exact Homogenization.scalarMatrix_isSymm _
                                                                            
  have hT0 := Homogenization.Book.Ch02.responseSymmetricDirichletNeumannTheory D0 data0.toCoeffOn
    hsym0
  have hTUnit := Homogenization.Book.Ch02.responseSymmetricDirichletNeumannTheory Dn
    dataUnit.toCoeffOn hsymUnit
  have hNu0 := hT0.neumann_value_by_sigmaStarInv qv
  have hNuUnit := hTUnit.neumann_value_by_sigmaStarInv qv
  have hNu_eq : Homogenization.Book.Ch02.symmetricNeumannNu D0 data0.toCoeffOn qv =
      Homogenization.Book.Ch02.symmetricNeumannNu Dn dataUnit.toCoeffOn qv := by
    rw [hNu0, hNuUnit, hsig_eq]
                                                                                
  have hvol : 0 < volume.real (unitNeumannCube d : Set (SpatialCoordinates d)) :=
    centeredCube_volume_pos zn one_pos
  have haP : ((aK.val : SpatialCoordinates d → ℝ)
      =ᵐ[volume.restrict ((unitNeumannCube d : Opens (SpatialCoordinates d)) :
        Set (SpatialCoordinates d))] cutoffCoefficient M H omega K) := by
    filter_upwards [haK_ae, MeasureTheory.ae_restrict_mem
      (unitNeumannCube d).isOpen.measurableSet] with y hy hym
    rw [hy hym, div_one]
  have hset_eq : ((unitNeumannCube d : Opens (SpatialCoordinates d)) :
      Set (Homogenization.Vec d)) = (Dn : Set (Homogenization.Vec d)) := rfl
  have hNeu := aux_chart_transfer_neumannNu Dn (unitNeumannCube d) hset_eq dataUnit hvol
    (aux_lem_band_U2N_poincareN zn) aK haP qv
                                                                              
  have T := Homogenization.Book.Ch02.responseSymmetricDirichletNeumannTheory D0 A hsymA
  have e1 := T.response_dirichlet_neumann_split 0 qv
  have e2 := T.dirichlet_value_by_sigma 0
  have e3 : Homogenization.vecDot (0 : Homogenization.Vec d) qv = 0 := by
    simp [Homogenization.vecDot]
  have e4 : Homogenization.vecDot (0 : Homogenization.Vec d)
      (Homogenization.matVecMul (Homogenization.Book.Ch02.sigmaCoarse D0 A) 0) = 0 := by
    simp [Homogenization.vecDot]
  have e5 := Homogenization.Book.Ch02.symmetricNeumannNu_eq_ofAEEq hAE qv
  calc Homogenization.Book.Ch02.responseJ D0 A 0 qv
      = Homogenization.Book.Ch02.symmetricDirichletNu D0 A 0 +
          Homogenization.Book.Ch02.symmetricNeumannNu D0 A qv -
          Homogenization.vecDot 0 qv := e1
    _ = Homogenization.Book.Ch02.symmetricNeumannNu D0 A qv := by rw [e2, e3, e4]; ring
    _ = Homogenization.Book.Ch02.symmetricNeumannNu D0 data0.toCoeffOn qv := e5
    _ = Homogenization.Book.Ch02.symmetricNeumannNu Dn dataUnit.toCoeffOn qv := hNu_eq
    _ = _ := hNeu

theorem aux_lem_band_U2N_unit_probe
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (pvec : Fin d → ℝ) (hpvec : ∑ k, (pvec k) ^ 2 = 1) (q : ℝ) (hq : 1 ≤ q) :
    ∃ delta0 C B : ℝ, 0 < delta0 ∧ 0 ≤ C ∧ 0 ≤ B ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K h : ℕ),
        AEStronglyMeasurable (fun omega => Homogenization.Book.Ch02.responseJ
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            ((I.chart (aux_lem_band_U2N_zn d) 1 one_pos
                (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K (aux_lem_band_U2N_zn d) one_pos)
                (aux_lem_band_U2N_zn d) 1).coeffOn (Homogenization.originCube d 0)) 0 pvec)
          (chaosSampleLaw M).toMeasure ∧
        eLpNorm (fun omega => Homogenization.Book.Ch02.responseJ
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            ((I.chart (aux_lem_band_U2N_zn d) 1 one_pos
                (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K (aux_lem_band_U2N_zn d) one_pos)
                (aux_lem_band_U2N_zn d) 1).coeffOn (Homogenization.originCube d 0)) 0 pvec)
          (ENNReal.ofReal (2 * q)) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal B ∧
        aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-(h : ℤ)) (h : ℤ) (2 * q)
          (fun omega => Homogenization.Book.Ch02.responseJ
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            ((I.chart (aux_lem_band_U2N_zn d) 1 one_pos
                (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega K (aux_lem_band_U2N_zn d) one_pos)
                (aux_lem_band_U2N_zn d) 1).coeffOn (Homogenization.originCube d 0)) 0 pvec)
          (C * M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(aux_lem_band_U2N_aN d * (h : ℝ)))) := by
  obtain ⟨δ0, C, B, hδ0, hC, hB, hpde⟩ := aux_lem_band_U2N_pde_probe d hd I
    _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp pvec hpvec q hq
  let c : ℝ := (2 * volume.real (unitNeumannCube d : Set (SpatialCoordinates d)))⁻¹
  refine ⟨δ0, |c| * C, |c| * B, hδ0, by positivity, by positivity, ?_⟩
  intro M hM Rm hRm Sreg It H hH K h
  obtain ⟨hYm, hYb, hYba⟩ := hpde M hM Rm hRm Sreg It H hH K h
  let Y : BilateralField d → ℝ := fun o =>
    affineInverseNeumannResponse (aux_lem_band_U2N_poincareN (aux_lem_band_U2N_zn d))
      (cutoffPositiveCoefficient M H o K (aux_lem_band_U2N_zn d) one_pos) pvec
  have hfun : (fun omega => Homogenization.Book.Ch02.responseJ
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
      ((I.chart (aux_lem_band_U2N_zn d) 1 one_pos
        (cutoffPositiveCoefficient M H omega K (aux_lem_band_U2N_zn d) one_pos)
        (aux_lem_band_U2N_zn d) 1).coeffOn (Homogenization.originCube d 0)) 0 pvec) =
      fun o => c*Y o := by
    funext o
    rw [aux_lem_band_U2N_chart_neumann_eq I M H o K pvec]
    dsimp [Y,c]
    ring
  rw [hfun]
  refine ⟨hYm.aestronglyMeasurable.const_mul c, ?_, ?_⟩
  · rw [aux_lem_band_U2_eLpNorm_cmul, ENNReal.ofReal_mul (abs_nonneg c)]
    exact mul_le_mul_right hYb _
  · have hh := aux_lem_band_U2_BA_const_mul c hYba
    simpa only [mul_assoc] using hh

def aux_lem_band_U2_RefOK {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (P : Measure (BilateralField d)) (C γ δ q : ℝ) (k : ℕ) (X : BilateralField d → ℝ) : Prop :=
  AEStronglyMeasurable X P ∧
  eLpNorm X (ENNReal.ofReal q) P ≤ ENNReal.ofReal (C * (3 : ℝ) ^ (γ * (k : ℝ))) ∧
  eLpNorm (fun omega => X omega - 1) (ENNReal.ofReal q) P ≤
    ENNReal.ofReal (C * δ * (3 : ℝ) ^ (γ * (k : ℝ))) ∧
  ∀ h : ℕ, k ≤ h →
    aux_lem_band_U2_BandApprox P (-((h + 1 : ℕ) : ℤ)) ((h + 1 : ℕ) : ℤ) q (fun omega => X omega - 1)
      (C * δ * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(h : ℝ)))

theorem aux_lem_band_ref_deterministic_budget
    (A CH q a delta tau r : ℝ) (k : ℕ)
    (hA : 0 ≤ A) (hCH : 0 ≤ CH) (hq : 0 < q) (ha : 0 < a)
    (haUpper : a ≤ 2 * q) (hdelta : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (htau : tau ≤ delta^2) (hrpos : 0 < r)
    (hratio : r ≤ Real.exp (2 * tau * (k : ℝ))) (hratioInv : r⁻¹ ≤ 1) :
    let T : ℝ := (a + a^2) * delta^2 * (k : ℝ)
    let E0 : ℝ := 16 * CH * q^2
    let Crate : ℝ := 4 * A + 2
    r^a ≤ Real.exp (2 * T) ∧ (r⁻¹)^a ≤ 1 ∧ 0 ≤ E0 ∧ 0 ≤ Crate * T ∧
      2 * T + CH * (2*a)^2 * delta^2 ≤ Crate*T + E0 ∧
      2 * T + A * (|2*a| + (2*a)^2) * delta^2 * (k:ℝ) ≤ Crate*T ∧
      CH * (-2*a)^2 * delta^2 ≤ E0 ∧
      A * (|-2*a| + (-2*a)^2) * delta^2 * (k:ℝ) ≤ Crate*T := by
  dsimp only
  let T : ℝ := (a + a^2) * delta^2 * (k : ℝ)
  let E0 : ℝ := 16 * CH * q^2
  let Crate : ℝ := 4 * A + 2
  change r^a ≤ Real.exp (2*T) ∧ _
  have hTdef : T = (a + a^2) * delta^2 * (k : ℝ) := rfl
  have hδ2le : delta^2 ≤ 1 := by nlinarith [sq_nonneg delta, sq_nonneg (1-delta)]
  have hT : 0 ≤ T := by
    dsimp [T]
    positivity
  have hE0 : 0 ≤ E0 := by
    dsimp [E0]
    exact mul_nonneg (mul_nonneg (by norm_num) (hCH)) (sq_nonneg q)
  have hsumAbsPos : |2 * a| = 2 * a := by
    rw [abs_of_nonneg]
    linarith
  have hsumAbsNeg : |-2 * a| = 2 * a := by
    rw [abs_of_nonpos]
    · ring
    · linarith
  have hsumSq : (-2 * a)^2 = (2 * a)^2 := by ring
  have hsumBudgetPosNorm :
    A * (2 * a + (2 * a)^2) * delta^2 * (k : ℝ) ≤ 4 * A * T := by
    have hlin : 2 * a + (2 * a)^2 ≤ 4 * (a + a^2) :=
      aux_lane4_reference_point_moments_quadratic a ha.le
    have hfac : 0 ≤ delta^2 * (k : ℝ) :=
      mul_nonneg (sq_nonneg _) (Nat.cast_nonneg _)
    have hmul :
        (2 * a + (2 * a)^2) * (delta^2 * (k : ℝ)) ≤
          4 * (a + a^2) * (delta^2 * (k : ℝ)) :=
      mul_le_mul_of_nonneg_right hlin hfac
    calc
      A * (2 * a + (2 * a)^2) * delta^2 * (k : ℝ) =
          A * ((2 * a + (2 * a)^2) * (delta^2 * (k : ℝ))) :=
            by simp only [mul_assoc]
      _ ≤ A * (4 * (a + a^2) * (delta^2 * (k : ℝ))) :=
        mul_le_mul_of_nonneg_left hmul hA
      _ = 4 * A * T := by
        rw [hTdef]
        simp only [mul_assoc, mul_left_comm, mul_comm]
  have hsumBudgetPos :
      A * (|2 * a| + (2 * a)^2) * delta^2 * (k : ℝ) ≤ 4 * A * T := by
    rw [hsumAbsPos]
    exact hsumBudgetPosNorm
  have hsumBudgetNeg :
      A * (|-2 * a| + (-2 * a)^2) * delta^2 * (k : ℝ) ≤ 4 * A * T := by
    rw [hsumAbsNeg, hsumSq]
    exact hsumBudgetPosNorm
  have hHbudgetPos : CH * (2 * a)^2 * delta^2 ≤ E0 := by
    have hCH0 : 0 ≤ CH := hCH
    have haSq : (2 * a)^2 ≤ (4 * q)^2 := by
      apply (sq_le_sq₀ (by positivity) (by positivity)).2
      linarith
    dsimp [E0]
    calc
      CH * (2 * a)^2 * delta^2 ≤ CH * (2 * a)^2 * 1 :=
        mul_le_mul_of_nonneg_left hδ2le
          (mul_nonneg hCH0 (sq_nonneg _))
      _ ≤ CH * (4 * q)^2 * 1 := by
        simpa only [mul_one] using mul_le_mul_of_nonneg_left haSq hCH0
      _ = 16 * CH * q^2 := by ring
  have hHbudgetNeg : CH * (-2 * a)^2 * delta^2 ≤ E0 := by
    rw [hsumSq]
    exact hHbudgetPos
  have hdetBudget : 2 * a * tau * (k : ℝ) ≤ 2 * T := by
    have hk : 0 ≤ (k : ℝ) := Nat.cast_nonneg _
    have h2a : 0 ≤ 2 * a := by positivity
    have h1 : 2 * a * tau * (k : ℝ) ≤
        2 * a * delta^2 * (k : ℝ) := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left htau h2a) hk
    dsimp [T]
    have hlin : 2 * a ≤ 2 * (a + a^2) := by
      linarith [sq_nonneg a]
    have h2 := mul_le_mul_of_nonneg_right hlin
      (mul_nonneg (sq_nonneg delta) hk)
    calc
      2 * a * tau * (k : ℝ) ≤
          2 * a * delta^2 * (k : ℝ) := h1
      _ ≤ 2 * ((a + a^2) * delta^2 * (k : ℝ)) := by
        calc
          2 * a * delta^2 * (k : ℝ) =
              2 * a * (delta^2 * (k : ℝ)) := by ring
          _ ≤ 2 * (a + a^2) * (delta^2 * (k : ℝ)) := h2
          _ = 2 * ((a + a^2) * delta^2 * (k : ℝ)) := by ring
  have hrrpow : r^a ≤ Real.exp (2 * T) := by
    have hpow := Real.rpow_le_rpow hrpos.le hratio ha.le
    have hpow' : r^a ≤ (Real.exp
        (2 * tau * (k : ℝ)))^a := hpow
    calc
      r^a ≤ (Real.exp
          (2 * tau * (k : ℝ)))^a := hpow'
      _ = Real.exp (2 * tau * (k : ℝ) * a) := by
        rw [Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp]
      _ = Real.exp (2 * a * tau * (k : ℝ)) := by
        congr 1
        ring
      _ ≤ Real.exp (2 * T) := by
        exact Real.exp_le_exp.mpr hdetBudget
  have hrrpowInv : (r⁻¹)^a ≤ 1 := by
    have hpow := Real.rpow_le_rpow (by positivity : 0 ≤ r⁻¹) hratioInv ha.le
    simpa using hpow
  have hbudget : 2 * T + 4 * A * T = Crate * T := by
    dsimp [Crate]
    ring
  have hbudget_le : 2 * T ≤ Crate * T := by
    have hnonneg : 0 ≤ 4 * A * T :=
      mul_nonneg (mul_nonneg (by norm_num) hA) hT
    rw [← hbudget]
    exact le_add_of_nonneg_right hnonneg
  have hplusExpBudget :
      2 * T + CH * (2 * a)^2 * delta^2 ≤ Crate * T + E0 := by
    calc
      2 * T + CH * (2 * a)^2 * delta^2 ≤ 2 * T + E0 :=
        add_le_add_right hHbudgetPos (2 * T)
      _ ≤ Crate * T + E0 := add_le_add_left hbudget_le E0
  have hplusSumExpBudget :
      2 * T + A * (|2 * a| + (2 * a)^2) * delta^2 * (k : ℝ) ≤
        Crate * T := by
    calc
      2 * T + A * (|2 * a| + (2 * a)^2) * delta^2 * (k : ℝ) ≤
          2 * T + 4 * A * T := add_le_add_right hsumBudgetPos (2 * T)
      _ = Crate * T := hbudget
  have hminusSumExpBudget :
      A * (|-2 * a| + (-2 * a)^2) * delta^2 * (k : ℝ) ≤
        Crate * T := by
    calc
      A * (|-2 * a| + (-2 * a)^2) * delta^2 * (k : ℝ) ≤
          4 * A * T := hsumBudgetNeg
      _ ≤ 2 * T + 4 * A * T :=
        le_add_of_nonneg_left (mul_nonneg (by norm_num) hT)
      _ = Crate * T := hbudget
  exact ⟨hrrpow, hrrpowInv, hE0, mul_nonneg (by positivity) hT,
    hplusExpBudget, hplusSumExpBudget, hHbudgetNeg, hminusSumExpBudget⟩

theorem aux_lem_band_ref_exponential_budget
    (r a E0 T Z Ep En Sp Sn : ℝ) (hr : 0 ≤ r)
    (hrp : r ^ a ≤ Real.exp (2 * T)) (hri : (r⁻¹) ^ a ≤ 1)
    (hE0 : 0 ≤ E0) (hZ : 0 ≤ Z)
    (hep : 2 * T + Ep ≤ Z + E0) (hsp : 2 * T + Sp ≤ Z)
    (hen : En ≤ E0) (hsn : Sn ≤ Z) :
    (r ^ a / 2) * (2 * Real.exp Ep) ≤ Real.exp E0 * Real.exp Z ∧
    (r ^ a / 2) * Real.exp Sp ≤ Real.exp E0 * Real.exp Z ∧
    ((r⁻¹) ^ a / 2) * (2 * Real.exp En) ≤ Real.exp E0 * Real.exp Z ∧
    ((r⁻¹) ^ a / 2) * Real.exp Sn ≤ Real.exp E0 * Real.exp Z := by
  have hE1 : 1 ≤ Real.exp E0 := Real.one_le_exp hE0
  have hZ1 : 1 ≤ Real.exp Z := Real.one_le_exp hZ
  have hEd : Real.exp Z ≤ Real.exp E0 * Real.exp Z := by
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hE1 (Real.exp_pos Z).le
  have hZd : Real.exp E0 ≤ Real.exp E0 * Real.exp Z := by
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hZ1 (Real.exp_pos E0).le
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc _ = r ^ a * Real.exp Ep := by ring
      _ ≤ Real.exp (2 * T) * Real.exp Ep := mul_le_mul_of_nonneg_right hrp (Real.exp_pos _).le
      _ = Real.exp (2 * T + Ep) := (Real.exp_add _ _).symm
      _ ≤ Real.exp (Z + E0) := Real.exp_le_exp.mpr hep
      _ = _ := by rw [Real.exp_add]; ring
  · have hhalf : r ^ a / 2 ≤ r ^ a := by nlinarith [Real.rpow_nonneg hr a]
    calc _ ≤ r ^ a * Real.exp Sp := mul_le_mul_of_nonneg_right hhalf (Real.exp_pos _).le
      _ ≤ Real.exp (2 * T) * Real.exp Sp := mul_le_mul_of_nonneg_right hrp (Real.exp_pos _).le
      _ = Real.exp (2 * T + Sp) := (Real.exp_add _ _).symm
      _ ≤ Real.exp Z := Real.exp_le_exp.mpr hsp
      _ ≤ _ := hEd
  · calc _ = (r⁻¹) ^ a * Real.exp En := by ring
      _ ≤ 1 * Real.exp En := mul_le_mul_of_nonneg_right hri (Real.exp_pos _).le
      _ = Real.exp En := one_mul _
      _ ≤ Real.exp E0 := Real.exp_le_exp.mpr hen
      _ ≤ _ := hZd
  · have hhalf : (r⁻¹) ^ a / 2 ≤ 1 := by linarith
    calc _ ≤ 1 * Real.exp Sn := mul_le_mul_of_nonneg_right hhalf (Real.exp_pos _).le
      _ = Real.exp Sn := one_mul _
      _ ≤ Real.exp Z := Real.exp_le_exp.mpr hsn
      _ ≤ _ := hEd

theorem aux_lem_band_U2_ref_band_eLpNorm_of_integral_rpow {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (F : Ω → ℝ) (hFm : Measurable F) (hFnonneg : ∀ omg, 0 ≤ F omg)
    (a : ℝ) (ha : 0 < a) (hFa : Integrable (fun omg => (F omg) ^ a) μ) (M : ℝ) (hM0 : 0 ≤ M)
    (hM : (∫ omg, (F omg) ^ a ∂μ) ≤ M) :
    eLpNorm F (ENNReal.ofReal a) μ ≤ ENNReal.ofReal (M ^ (1 / a)) := by
  have hane : ENNReal.ofReal a ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr ha)
  have hatop : ENNReal.ofReal a ≠ ⊤ := ENNReal.ofReal_ne_top
  have haR : (ENNReal.ofReal a).toReal = a := ENNReal.toReal_ofReal ha.le
  have hpt : ∀ omg, ‖F omg‖ₑ ^ a = ENNReal.ofReal ((F omg) ^ a) := by
    intro omg
    rw [Real.enorm_eq_ofReal (hFnonneg omg),
      ENNReal.ofReal_rpow_of_nonneg (hFnonneg omg) ha.le]
  have hnn : 0 ≤ᵐ[μ] fun omg => (F omg) ^ a :=
    Filter.Eventually.of_forall (fun omg => Real.rpow_nonneg (hFnonneg omg) a)
  have hlint : (∫⁻ omg, ‖F omg‖ₑ ^ a ∂μ) ≤ ENNReal.ofReal M := by
    calc (∫⁻ omg, ‖F omg‖ₑ ^ a ∂μ) = ∫⁻ omg, ENNReal.ofReal ((F omg) ^ a) ∂μ :=
          lintegral_congr fun omg => hpt omg
      _ = ENNReal.ofReal (∫ omg, (F omg) ^ a ∂μ) :=
          (ofReal_integral_eq_lintegral_ofReal hFa hnn).symm
      _ ≤ ENNReal.ofReal M := ENNReal.ofReal_le_ofReal hM
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hane hatop hFm.aestronglyMeasurable, haR]
  calc (∫⁻ omg, ‖F omg‖ₑ ^ a ∂μ) ^ (1 / a) ≤ (ENNReal.ofReal M) ^ (1 / a) :=
        ENNReal.rpow_le_rpow hlint (by positivity)
    _ = ENNReal.ofReal (M ^ (1 / a)) := by
        rw [ENNReal.ofReal_rpow_of_nonneg hM0 (by positivity)]

theorem aux_lem_band_U2_ref_band_moments
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (q : ℝ) (hq : 1 ≤ q) :
    ∃ Cmom Crate : ℝ,
      0 < Cmom ∧ 0 < Crate ∧
      ∀ delta0 : ℝ, 0 < delta0 → delta0 ≤ 1 →
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
        (_Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        let P := (chaosSampleLaw M).toMeasure
        let G : ℕ → BilateralField d → SpatialCoordinates d → ℝ :=
          fun k omega x => H omega x + ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) x
        let s : ℕ → ℕ → BilateralField d → SpatialCoordinates d → ℝ :=
          fun N k omega x =>
            SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
                SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
              Real.exp (G k omega x - (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P)
        ∀ aexp : ℝ, aexp ∈ Set.Icc 1 (2 * q) →
          ∀ (N k : ℕ), k ≤ N → ∀ y : SpatialCoordinates d, ‖y‖ ≤ 1 →
            Integrable (fun omega => (s N k omega y)^aexp +
              (s N k omega y)^(-aexp)) P ∧
            (∫ omega, (s N k omega y)^aexp +
              (s N k omega y)^(-aexp) ∂P) ≤
              Cmom * Real.exp (Crate * (aexp + aexp^2) * M.delta^2 * (k : ℝ)) ∧
            MemLp (fun omega => s N k omega y) (ENNReal.ofReal aexp) P ∧
              MemLp (fun omega => (s N k omega y)⁻¹)
              (ENNReal.ofReal aexp) P ∧
            eLpNorm (fun omega => s N k omega y) (ENNReal.ofReal aexp) P ≤
              ENNReal.ofReal ((Cmom * Real.exp (Crate * (aexp + aexp^2) *
                M.delta^2 * (k : ℝ))) ^ (1 / aexp)) ∧
            eLpNorm (fun omega => (s N k omega y)⁻¹) (ENNReal.ofReal aexp) P ≤
              ENNReal.ofReal ((Cmom * Real.exp (Crate * (aexp + aexp^2) *
                M.delta^2 * (k : ℝ))) ^ (1 / aexp)) := by
  obtain ⟨CH, hCH, hHmom⟩ :=
    SubdiffusiveProcess.exists_uniform_compactExponentialMoment_of_infraredCharacterization hd
  let Kc : Compacts (SpatialCoordinates d) :=
    ⟨Metric.closedBall (0 : SpatialCoordinates d) 1,
      ProperSpace.isCompact_closedBall (0 : SpatialCoordinates d) 1⟩
  let c0 : ℝ := 3 + ((1 + Real.log 2) ^ (2 : ℝ)⁻¹)^2
  let Cmom : ℝ := 4 * Real.exp (16 * CH Kc * q^2)
  let Crate : ℝ := 4 * (4 + ((1 + Real.log 2) ^ (2 : ℝ)⁻¹)^2) + 2
  refine ⟨Cmom, Crate, ?_, ?_, ?_⟩
  · dsimp [Cmom]
    positivity
  · dsimp [Crate]
    have hbase : 0 ≤ ((1 + Real.log 2) ^ (2 : ℝ)⁻¹)^2 := sq_nonneg _
    linarith
  · intro delta0 hdelta0pos hdelta0le M Rm H hH hMd
    dsimp
    intro a ha N k hkn y hy
    have ha1 : 0 < a := lt_of_lt_of_le zero_lt_one ha.1
    have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
    have haUpper : a ≤ 2 * q := ha.2
    have hyK : y ∈ (Kc : Set (SpatialCoordinates d)) := by
      change y ∈ Metric.closedBall (0 : SpatialCoordinates d) 1
      rwa [Metric.mem_closedBall, dist_zero_right]
    have hHexp (t : ℝ) :
        Integrable (fun omega => Real.exp (t * H omega y))
          (chaosSampleLaw M).toMeasure ∧
        (∫ omega, Real.exp (t * H omega y)
          ∂(chaosSampleLaw M).toMeasure) ≤
          2 * Real.exp (CH Kc * t^2 * M.delta^2) := by
      have hnorm := hHmom M H hH Kc |t| (abs_nonneg t)
      have htarget : Measurable (fun omega => Real.exp (t * H omega y)) := by
        exact (measurable_const.mul
          ((continuous_eval_const y).measurable.comp hH.1)).exp
      have hdom : ∀ omega, t * H omega y ≤
          |t| * ‖(H omega).restrict (Kc : Set (SpatialCoordinates d))‖ := by
        intro omega
        have hb := ((H omega).restrict (Kc : Set (SpatialCoordinates d))).norm_coe_le_norm
          ⟨y, hyK⟩
        calc
          t * H omega y ≤ |t * H omega y| := le_abs_self _
          _ = |t| * |H omega y| := abs_mul _ _
          _ ≤ |t| * ‖(H omega).restrict (Kc : Set (SpatialCoordinates d))‖ := by
            rw [← Real.norm_eq_abs]
            exact mul_le_mul_of_nonneg_left hb (abs_nonneg t)
      have hint : Integrable (fun omega => Real.exp (t * H omega y))
          (chaosSampleLaw M).toMeasure := by
        refine hnorm.1.mono' htarget.aestronglyMeasurable ?_
        filter_upwards [] with omega
        rw [Real.norm_of_nonneg (Real.exp_pos _).le]
        exact Real.exp_le_exp.mpr (hdom omega)
      constructor
      · exact hint
      · calc
          (∫ omega, Real.exp (t * H omega y)
            ∂(chaosSampleLaw M).toMeasure) ≤
              ∫ omega, Real.exp (|t| * ‖(H omega).restrict
                (Kc : Set (SpatialCoordinates d))‖)
                ∂(chaosSampleLaw M).toMeasure :=
            integral_mono hint hnorm.1 (fun omega =>
              Real.exp_le_exp.mpr (hdom omega))
          _ ≤ 2 * Real.exp (CH Kc * |t|^2 * M.delta^2) := hnorm.2
          _ = 2 * Real.exp (CH Kc * t^2 * M.delta^2) := by
            rw [sq_abs]
    let r : ℝ := SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M N
    have hahompos (m : ℕ) :
        0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M m := by
      exact lt_of_lt_of_le (Real.exp_pos _) (Rm.ahom_lower m)
    have hrpos : 0 < r := by
      dsimp [r]
      exact div_pos (hahompos _) (hahompos _)
    have hratio : r ≤ Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P *
        (k : ℝ)) := by
      by_cases hk0 : k = 0
      · subst k
        dsimp [r]
        rw [div_self (ne_of_gt (hahompos N))]
        simp
      · have hsub : N - k < N := by omega
        have hord := Rm.ahom_ordering (N - k) N hsub
        apply (div_le_iff₀ (hahompos N)).2
        calc
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) ≤
              Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P *
                ((N : ℝ) - (N - k : ℕ))) *
                SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := hord.2
          _ = Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * (k : ℝ)) *
                SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := by
            congr 2
            rw [Nat.cast_sub hkn]
            ring
    have hratioInv : r⁻¹ ≤ 1 := by
      by_cases hk0 : k = 0
      · subst k
        dsimp [r]
        rw [div_self (ne_of_gt (hahompos N))]
        simp
      · apply inv_le_one_of_one_le₀
        apply (le_div_iff₀ (hahompos N)).2
        simpa using (Rm.ahom_ordering (N - k) N (by omega)).1
    have hsumPos := aux_lane4_reference_point_moments_sum M k y (2 * a)
    have hsumNeg := aux_lane4_reference_point_moments_sum M k y (-2 * a)
    have hHPos := hHexp (2 * a)
    have hHNeg := hHexp (-2 * a)
    let center : BilateralField d → ℝ := fun omega =>
      (∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y) -
        (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P
    have hsrepr (omega : BilateralField d) :
        SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
            SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
          Real.exp (H omega y +
            ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
            (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P) =
        r * Real.exp (H omega y + center omega) := by
      dsimp [r, center]
      rw [show H omega y +
          ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
          (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P =
          H omega y +
            (∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
            (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P) by ring]
    let A : ℝ := 4 + ((1 + Real.log 2) ^ (2 : ℝ)⁻¹)^2
    have hsumPosA :
        (∫ omega, Real.exp (2 * a * center omega)
            ∂(chaosSampleLaw M).toMeasure) ≤
          Real.exp (A * (|2 * a| + (2 * a)^2) * M.delta^2 * (k : ℝ)) := by
      simpa only [A] using hsumPos.2
    have hsumNegA :
        (∫ omega, Real.exp (-2 * a * center omega)
            ∂(chaosSampleLaw M).toMeasure) ≤
          Real.exp (A * (|-2 * a| + (-2 * a)^2) * M.delta^2 * (k : ℝ)) := by
      simpa only [A] using hsumNeg.2
    have hpointPos (omega : BilateralField d) :
        (r * Real.exp (H omega y + center omega))^a ≤
          (r^a / 2) * (Real.exp (2 * a * H omega y) +
            Real.exp (2 * a * center omega)) := by
      exact aux_lane4_reference_point_moments_amgm r (H omega y)
        (center omega) a hrpos
    have hHpointMeas : Measurable (fun omega : BilateralField d => H omega y) :=
      (continuous_eval_const y).measurable.comp hH.1
    have hsumMeas : Measurable (fun omega : BilateralField d =>
        ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y) := by
      apply Finset.measurable_sum
      intro j hj
      exact (continuous_eval_const y).measurable.comp
        (measurable_pi_apply (-(j : ℤ)))
    let F : BilateralField d → ℝ := fun omega =>
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
        Real.exp (H omega y +
          ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
          (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P)
    have hFmeas : Measurable F := by
      dsimp [F]
      have hratioMeas : Measurable (fun _ : BilateralField d =>
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
            SubdiffusiveProcess.CoarseGrainingVocab.ahom M N) := measurable_const
      exact hratioMeas.mul
        (((hHpointMeas.add hsumMeas).sub measurable_const).exp)
    have hFpos (omega : BilateralField d) : 0 < F omega := by
      dsimp [F]
      exact mul_pos (div_pos (hahompos _) (hahompos _)) (Real.exp_pos _)
    have hplusMeas : Measurable (fun omega : BilateralField d =>
        (F omega)^a) := by
      dsimp [F]
      fun_prop
    have hplusDom : Integrable (fun omega : BilateralField d =>
        (r^a / 2) * (Real.exp (2 * a * H omega y) +
          Real.exp (2 * a * center omega)))
        (chaosSampleLaw M).toMeasure := by
      have hA := hHPos.1.add hsumPos.1
      exact hA.const_mul (r^a / 2)
    have hplusInt : Integrable (fun omega : BilateralField d => (F omega)^a)
        (chaosSampleLaw M).toMeasure := by
      refine hplusDom.mono' hplusMeas.aestronglyMeasurable ?_
      filter_upwards [] with omega
      dsimp [F]
      rw [hsrepr omega]
      rw [abs_of_nonneg
        (Real.rpow_nonneg (mul_nonneg hrpos.le (Real.exp_pos _).le) _)]
      exact hpointPos omega
    have hinvrepr (omega : BilateralField d) :
        (SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
            SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
          Real.exp (H omega y +
            ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
            (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P))^(-a) =
          (r⁻¹ * Real.exp (-(H omega y) - center omega))^a := by
      rw [hsrepr omega]
      rw [Real.rpow_neg (mul_nonneg hrpos.le (Real.exp_pos _).le)]
      rw [← Real.inv_rpow (mul_nonneg hrpos.le (Real.exp_pos _).le)]
      congr 1
      rw [_root_.mul_inv_rev, ← Real.exp_neg, neg_add']
      exact mul_comm _ _
    have hpointNeg (omega : BilateralField d) :
        (r⁻¹ * Real.exp (-(H omega y) - center omega))^a ≤
          ((r⁻¹)^a / 2) * (Real.exp (-2 * a * H omega y) +
            Real.exp (-2 * a * center omega)) := by
      convert aux_lane4_reference_point_moments_amgm (r⁻¹) (-(H omega y))
        (-center omega) a (inv_pos.mpr hrpos) using 1
      have e1 : -2 * a * (H omega) y = 2 * a * -(H omega) y := by ring
      have e2 : -2 * a * center omega = 2 * a * -center omega := by ring
      rw [e1, e2]
    have hminusMeas : Measurable (fun omega : BilateralField d =>
        (F omega)^(-a)) := by
      dsimp [F]
      fun_prop
    have hminusDom : Integrable (fun omega : BilateralField d =>
        ((r⁻¹)^a / 2) * (Real.exp (-2 * a * H omega y) +
          Real.exp (-2 * a * center omega)))
        (chaosSampleLaw M).toMeasure := by
      have hA := hHNeg.1.add hsumNeg.1
      exact hA.const_mul ((r⁻¹)^a / 2)
    have hminusInt : Integrable (fun omega : BilateralField d => (F omega)^(-a))
        (chaosSampleLaw M).toMeasure := by
      refine hminusDom.mono' hminusMeas.aestronglyMeasurable ?_
      filter_upwards [] with omega
      dsimp [F]
      rw [hinvrepr omega]
      rw [abs_of_nonneg
        (Real.rpow_nonneg (mul_nonneg (inv_pos.mpr hrpos).le
          (Real.exp_pos _).le) _)]
      exact hpointNeg omega
    have hplusIntegral :
        (∫ omega, (F omega)^a
          ∂(chaosSampleLaw M).toMeasure) ≤
          (r^a / 2) *
            ((∫ omega, Real.exp (2 * a * H omega y)
                ∂(chaosSampleLaw M).toMeasure) +
              (∫ omega, Real.exp (2 * a * center omega)
                ∂(chaosSampleLaw M).toMeasure)) := by
      calc
        _ ≤ ∫ omega, (r^a / 2) *
            (Real.exp (2 * a * H omega y) +
              Real.exp (2 * a * center omega))
            ∂(chaosSampleLaw M).toMeasure := by
              apply integral_mono hplusInt hplusDom
              intro omega
              change (SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
                SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
                  Real.exp (H omega y +
                    ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
                    (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P))^a ≤ _
              rw [hsrepr omega]
              simpa using hpointPos omega
        _ = _ := by
          rw [integral_const_mul, integral_add hHPos.1 hsumPos.1]
    have hminusIntegral :
        (∫ omega, (F omega)^(-a)
          ∂(chaosSampleLaw M).toMeasure) ≤
          ((r⁻¹)^a / 2) *
            ((∫ omega, Real.exp (-2 * a * H omega y)
                ∂(chaosSampleLaw M).toMeasure) +
              (∫ omega, Real.exp (-2 * a * center omega)
                ∂(chaosSampleLaw M).toMeasure)) := by
      calc
        _ ≤ ∫ omega, ((r⁻¹)^a / 2) *
            (Real.exp (-2 * a * H omega y) +
              Real.exp (-2 * a * center omega))
            ∂(chaosSampleLaw M).toMeasure := by
              apply integral_mono hminusInt hminusDom
              intro omega
              change (SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
                SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
                  Real.exp (H omega y +
                    ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
                    (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P))^(-a) ≤ _
              rw [hinvrepr omega]
              simpa using hpointNeg omega
        _ = _ := by
          rw [integral_const_mul, integral_add hHNeg.1 hsumNeg.1]
    let T : ℝ := (a + a^2) * M.delta^2 * (k : ℝ)
    let E0 : ℝ := 16 * CH Kc * q^2
    have hTdef : T = (a + a^2) * M.delta^2 * (k : ℝ) := rfl
    have hA : 0 ≤ A := by dsimp [A]; positivity
    have hδ : 0 ≤ M.delta := M.shellPrefix.delta_pos.le
    have htau : _root_.SubdiffusiveProcess.Model.tauSq M.P ≤ M.delta^2 := by
      have hh := SubdiffusiveProcess.CoarseGrainingVocab.tauSq_le_delta_sq M
      have hlog : Real.log 2 / 2 ≤ 1 := by
        have hlog' := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 2 by norm_num)
        linarith only [hlog']
      exact hh.trans (mul_le_of_le_one_left (sq_nonneg M.delta) hlog)
    obtain ⟨hrrpow, hrrpowInv, hE0, hZT, hplusExpBudget, hplusSumExpBudget,
        hHbudgetNeg, hminusSumExpBudget⟩ :=
      aux_lem_band_ref_deterministic_budget A (CH Kc) q a M.delta
        (_root_.SubdiffusiveProcess.Model.tauSq M.P) r k hA (hCH Kc) hq0 ha1 haUpper
        hδ (hMd.trans hdelta0le) htau hrpos hratio hratioInv
    have hHbudgetPos : CH Kc * (2*a)^2 * M.delta^2 ≤ E0 := by
      simpa only [neg_mul, neg_sq] using hHbudgetNeg
    let Ep : ℝ := CH Kc * (2 * a)^2 * M.delta^2
    let En : ℝ := CH Kc * (-2 * a)^2 * M.delta^2
    let Sp : ℝ := A * (|2 * a| + (2 * a)^2) * M.delta^2 * (k : ℝ)
    let Sn : ℝ := A * (|-2 * a| + (-2 * a)^2) * M.delta^2 * (k : ℝ)
    have hEp : Ep ≤ E0 := by simpa [Ep] using hHbudgetPos
    have hEn : En ≤ E0 := by simpa [En] using hHbudgetNeg
    have hSp :
        (∫ omega, Real.exp (2 * a * center omega)
            ∂(chaosSampleLaw M).toMeasure) ≤ Real.exp Sp := by
      simpa [Sp] using hsumPosA
    have hSn :
        (∫ omega, Real.exp (-2 * a * center omega)
            ∂(chaosSampleLaw M).toMeasure) ≤ Real.exp Sn := by
      simpa [Sn] using hsumNegA
    have hplusRaw :
        (∫ omega, (F omega)^a ∂(chaosSampleLaw M).toMeasure) ≤
          (r^a / 2) *
            (2 * Real.exp Ep + Real.exp Sp) := by
      calc
        _ ≤ (r^a / 2) *
            ((∫ omega, Real.exp (2 * a * H omega y)
                ∂(chaosSampleLaw M).toMeasure) +
              (∫ omega, Real.exp (2 * a * center omega)
                ∂(chaosSampleLaw M).toMeasure)) := hplusIntegral
        _ ≤ _ := by
          apply mul_le_mul_of_nonneg_left
          · exact add_le_add hHPos.2 hSp
          · positivity
    obtain ⟨hplusTerm1, hplusTerm2, hminusTerm1, hminusTerm2⟩ :=
      aux_lem_band_ref_exponential_budget r a E0 T (Crate * T) Ep En Sp Sn hrpos.le
        hrrpow hrrpowInv hE0 hZT
        hplusExpBudget hplusSumExpBudget hEn hminusSumExpBudget
    let Iplus : ℝ := ∫ omega, (F omega)^a ∂(chaosSampleLaw M).toMeasure
    let Iminus : ℝ := ∫ omega, (F omega)^(-a) ∂(chaosSampleLaw M).toMeasure
    have hplusRawF : Iplus ≤
        (r^a / 2) * (2 * Real.exp Ep + Real.exp Sp) := by
      change (∫ omega, (F omega)^a ∂(chaosSampleLaw M).toMeasure) ≤ _
      exact hplusRaw
    have hminusRawF : Iminus ≤
        ((r⁻¹)^a / 2) * (2 * Real.exp En + Real.exp Sn) := by
      apply le_trans (show Iminus ≤
        ((r⁻¹)^a / 2) *
        ((∫ omega, Real.exp (-2 * a * H omega y)
              ∂(chaosSampleLaw M).toMeasure) +
            (∫ omega, Real.exp (-2 * a * center omega)
              ∂(chaosSampleLaw M).toMeasure)) by
        change (∫ omega, (F omega)^(-a) ∂(chaosSampleLaw M).toMeasure) ≤ _
        exact hminusIntegral)
      apply mul_le_mul_of_nonneg_left
      · exact add_le_add hHNeg.2 hSn
      · exact div_nonneg (Real.rpow_nonneg (inv_nonneg.mpr hrpos.le) _)
          (by norm_num)
    have hplusCore : Iplus ≤
        2 * (Real.exp E0 * Real.exp (Crate * T)) := by
      exact aux_lane4_reference_point_moments_combine_two
        Iplus (r^a / 2) (Real.exp Ep) (Real.exp Sp)
        (Real.exp E0 * Real.exp (Crate * T)) hplusRawF hplusTerm1 hplusTerm2
    have hminusCore : Iminus ≤
        2 * (Real.exp E0 * Real.exp (Crate * T)) := by
      exact aux_lane4_reference_point_moments_combine_two
        Iminus ((r⁻¹)^a / 2) (Real.exp En) (Real.exp Sn)
        (Real.exp E0 * Real.exp (Crate * T)) hminusRawF
        hminusTerm1 hminusTerm2
    have hplusBoundF : Iplus ≤ Cmom * Real.exp (Crate * T) := by
      calc
        _ ≤ 2 * (Real.exp E0 * Real.exp (Crate * T)) := hplusCore
        _ ≤ Cmom * Real.exp (Crate * T) := by
          simpa only [Cmom, E0] using
            aux_lane4_reference_point_moments_two_le_four
              (Real.exp (16 * CH Kc * q^2)) (Real.exp (Crate * T))
              (Real.exp_pos _).le (Real.exp_pos _).le
    have hminusBoundF : Iminus ≤ Cmom * Real.exp (Crate * T) := by
      calc
        _ ≤ 2 * (Real.exp E0 * Real.exp (Crate * T)) := hminusCore
        _ ≤ Cmom * Real.exp (Crate * T) := by
          simpa only [Cmom, E0] using
            aux_lane4_reference_point_moments_two_le_four
              (Real.exp (16 * CH Kc * q^2)) (Real.exp (Crate * T))
              (Real.exp_pos _).le (Real.exp_pos _).le
    have hp0 : ENNReal.ofReal a ≠ 0 :=
      ne_of_gt (ENNReal.ofReal_pos.mpr ha1)
    have hptop : ENNReal.ofReal a ≠ (⊤ : ℝ≥0∞) := ENNReal.ofReal_ne_top
    have hplusNormInt :
        Integrable (fun omega : BilateralField d =>
          ‖F omega‖ ^ (ENNReal.ofReal a).toReal)
          (chaosSampleLaw M).toMeasure := by
      refine hplusInt.congr (Filter.Eventually.of_forall ?_)
      intro omega
      change (F omega)^a = ‖F omega‖ ^ (ENNReal.ofReal a).toReal
      rw [Real.norm_eq_abs, abs_of_pos (hFpos omega),
        ENNReal.toReal_ofReal ha1.le]
    have hminusNormInt :
        Integrable (fun omega : BilateralField d =>
          ‖(F omega)⁻¹‖ ^ (ENNReal.ofReal a).toReal)
          (chaosSampleLaw M).toMeasure := by
      refine hminusInt.congr (Filter.Eventually.of_forall ?_)
      intro omega
      change (F omega)^(-a) = ‖(F omega)⁻¹‖ ^ (ENNReal.ofReal a).toReal
      rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr (hFpos omega)),
        ENNReal.toReal_ofReal ha1.le, Real.inv_rpow (hFpos omega).le,
        ← Real.rpow_neg (hFpos omega).le]
    have hmemBase :
        MemLp F
          (ENNReal.ofReal a) (chaosSampleLaw M).toMeasure :=
      (integrable_norm_rpow_iff hFmeas.aestronglyMeasurable hp0 hptop).mp
        hplusNormInt
    have hmemInv :
        MemLp (fun omega : BilateralField d => (F omega)⁻¹)
          (ENNReal.ofReal a) (chaosSampleLaw M).toMeasure :=
      (integrable_norm_rpow_iff hFmeas.inv.aestronglyMeasurable hp0 hptop).mp
        hminusNormInt
    have hsumInt :
        Integrable (fun omega : BilateralField d =>
          (F omega)^a + (F omega)^(-a))
          (chaosSampleLaw M).toMeasure :=
      hplusInt.add hminusInt
    have hsumBound :
        (∫ omega : BilateralField d,
          (SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
              SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
            Real.exp (H omega y +
              ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
              (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P))^a +
          (SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
              SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
            Real.exp (H omega y +
              ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y -
              (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P))^(-a)
            ∂(chaosSampleLaw M).toMeasure) ≤
          Cmom * Real.exp (Crate * (a + a^2) * M.delta^2 * (k : ℝ)) := by
      have hrawF :
          (∫ omega, (F omega)^a + (F omega)^(-a)
            ∂(chaosSampleLaw M).toMeasure) ≤
            Cmom * Real.exp (Crate * T) := by
        rw [integral_add hplusInt hminusInt]
        have hcore : Iplus + Iminus ≤
            Cmom * Real.exp (Crate * T) := by
          calc
            Iplus + Iminus ≤
                2 * (Real.exp E0 * Real.exp (Crate * T)) +
                  2 * (Real.exp E0 * Real.exp (Crate * T)) :=
              add_le_add hplusCore hminusCore
            _ = Cmom * Real.exp (Crate * T) := by
              dsimp [Cmom]
              ring
        simpa only [Iplus, Iminus] using hcore
      have hExpEq : Crate * T =
          Crate * (a + a^2) * M.delta^2 * (k : ℝ) := by
        rw [hTdef]
        ring
      calc
        _ = (∫ omega, (F omega)^a + (F omega)^(-a)
              ∂(chaosSampleLaw M).toMeasure) := by
          simp only [F]
        _ ≤ Cmom * Real.exp (Crate * T) := hrawF
        _ = _ := by rw [hExpEq]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · simpa only [F] using hsumInt
    · exact hsumBound
    · simpa only [F] using hmemBase
    · simpa only [F] using hmemInv
    · have hb := aux_lem_band_U2_ref_band_eLpNorm_of_integral_rpow (chaosSampleLaw M).toMeasure F hFmeas
        (fun omega => (hFpos omega).le) a ha1 hplusInt _ (by positivity) hplusBoundF
      have heq : Crate * T = Crate * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) := by
        rw [hTdef]; ring
      rw [heq] at hb
      simpa only [F] using hb
    · have hFinv_eq : (fun omega : BilateralField d => ((F omega)⁻¹) ^ a) =
          (fun omega => (F omega) ^ (-a)) := by
        funext omega
        rw [Real.rpow_neg (hFpos omega).le, ← Real.inv_rpow (hFpos omega).le]
      have hFinv_int : Integrable (fun omega : BilateralField d => ((F omega)⁻¹) ^ a)
          (chaosSampleLaw M).toMeasure := by rw [hFinv_eq]; exact hminusInt
      have hFinv_bound : (∫ omega, ((F omega)⁻¹) ^ a ∂(chaosSampleLaw M).toMeasure) ≤
          Cmom * Real.exp (Crate * T) := by rw [hFinv_eq]; exact hminusBoundF
      have hb := aux_lem_band_U2_ref_band_eLpNorm_of_integral_rpow (chaosSampleLaw M).toMeasure
        (fun omega => (F omega)⁻¹) hFmeas.inv
        (fun omega => (inv_pos.mpr (hFpos omega)).le) a ha1 hFinv_int _ (by positivity)
        hFinv_bound
      have heq : Crate * T = Crate * (a + a ^ 2) * M.delta ^ 2 * (k : ℝ) := by
        rw [hTdef]; ring
      rw [heq] at hb
      simpa only [F] using hb

theorem aux_lem_band_U2_ref_band_reference_eq_s {d : ℕ}
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (N k : ℕ) (hk : k ≤ N) (y : SpatialCoordinates d) (omega : BilateralField d) :
    aux_lem_band_U2_reference M H N (k : ℤ) y omega =
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) / SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
        Real.exp ((H omega y + ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y) -
          (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P) := by
  have htoNat : ((N : ℤ) - (k : ℤ)).toNat = N - k := by omega
  have hsum : ∑ j ∈ Finset.Ico (0 : ℤ) (k : ℤ), omega (-j) y =
      ∑ n ∈ Finset.range k, omega (-(n : ℤ)) y := by
    refine Finset.sum_nbij' (fun j : ℤ => j.toNat) (fun n : ℕ => (n : ℤ)) ?_ ?_ ?_ ?_ ?_
    · intro j hj; simp only [Finset.mem_Ico] at hj; simp only [Finset.mem_range]; omega
    · intro n hn; simp only [Finset.mem_range] at hn; simp only [Finset.mem_Ico]; omega
    · intro j hj; simp only [Finset.mem_Ico] at hj; omega
    · intro n _hn; omega
    · intro j hj; simp only [Finset.mem_Ico] at hj
      have heq : (-j : ℤ) = -((j.toNat : ℤ)) := by omega
      rw [heq]
  show aux_lem_band_U2_kappa M ((N : ℤ) - (k : ℤ)).toNat / aux_lem_band_U2_kappa M N *
      Real.exp (H omega y + aux_lem_band_U2_retained (k : ℤ) y omega) = _
  rw [htoNat]
  unfold aux_lem_band_U2_retained
  rw [ite_eq_left (by positivity : (0 : ℤ) ≤ (k : ℤ)), hsum]
  unfold aux_lem_band_U2_kappa
  set Aexp : ℝ := ((N - k : ℕ) : ℝ) + 1 with hAexpdef
  set Bexp : ℝ := ((N : ℕ) : ℝ) + 1 with hBexpdef
  have hAB : Aexp * _root_.SubdiffusiveProcess.Model.tauSq M.P -
      Bexp * _root_.SubdiffusiveProcess.Model.tauSq M.P =
      -(k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P := by
    have hcast : ((N - k : ℕ) : ℝ) = (N : ℝ) - (k : ℝ) := Nat.cast_sub hk
    rw [hAexpdef, hBexpdef, hcast]; ring
  set S : ℝ := H omega y + ∑ j ∈ Finset.range k, (omega (-(j : ℤ))) y with hSdef
  have hexp : Real.exp (Aexp * _root_.SubdiffusiveProcess.Model.tauSq M.P) /
      Real.exp (Bexp * _root_.SubdiffusiveProcess.Model.tauSq M.P) * Real.exp S =
      Real.exp (S - (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P) := by
    rw [← Real.exp_sub, hAB, ← Real.exp_add]
    congr 1
    ring
  calc
    Real.exp (Aexp * _root_.SubdiffusiveProcess.Model.tauSq M.P) *
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) /
        (Real.exp (Bexp * _root_.SubdiffusiveProcess.Model.tauSq M.P) *
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M N) * Real.exp S =
        SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) / SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
          (Real.exp (Aexp * _root_.SubdiffusiveProcess.Model.tauSq M.P) /
            Real.exp (Bexp * _root_.SubdiffusiveProcess.Model.tauSq M.P) *
            Real.exp S) := by ring
    _ = SubdiffusiveProcess.CoarseGrainingVocab.ahom M (N - k) / SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
          Real.exp (S - (k : ℝ) * _root_.SubdiffusiveProcess.Model.tauSq M.P) := by rw [hexp]

theorem aux_lem_band_U2_ref_band_clause12
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∀ γ : ℝ, 0 < γ → ∀ q : ℝ, 1 ≤ q → ∃ delta0 C : ℝ, 0 < delta0 ∧ delta0 ≤ 1 ∧ 0 ≤ C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (_Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
      InfraredCharacterization M H →
      ∀ (N k : ℕ), k ≤ N → ∀ y : SpatialCoordinates d, ‖y‖ ≤ 1 →
        AEStronglyMeasurable (fun omega => aux_lem_band_U2_reference M H N (k : ℤ) y omega)
          (chaosSampleLaw M).toMeasure ∧
        AEStronglyMeasurable (fun omega => (aux_lem_band_U2_reference M H N (k : ℤ) y omega)⁻¹)
          (chaosSampleLaw M).toMeasure ∧
        eLpNorm (fun omega => aux_lem_band_U2_reference M H N (k : ℤ) y omega) (ENNReal.ofReal q)
          (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (C * (3 : ℝ) ^ (γ * (k : ℝ))) ∧
        eLpNorm (fun omega => (aux_lem_band_U2_reference M H N (k : ℤ) y omega)⁻¹) (ENNReal.ofReal q)
          (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (C * (3 : ℝ) ^ (γ * (k : ℝ))) := by
  intro γ hγ q hq
  obtain ⟨Cmom, Crate, hCmom, hCrate, hmom⟩ := aux_lem_band_U2_ref_band_moments d hd q hq
  have hqpos : 0 < q := lt_of_lt_of_le one_pos hq
  set delta0 : ℝ := min 1 (Real.sqrt (γ * Real.log 3 / (Crate * (1 + q)))) with hdelta0def
  have hCratepos : 0 < Crate * (1 + q) := by positivity
  have hdelta0pos : 0 < delta0 := lt_min one_pos (Real.sqrt_pos.mpr (by positivity))
  refine ⟨delta0, Cmom ^ (1 / q), hdelta0pos, min_le_left _ _, by positivity, ?_⟩
  intro M hM Rm H hH N k hk y hy
  have hmomI := hmom delta0 hdelta0pos (min_le_left _ _) M Rm H hH hM q ⟨hq, by linarith⟩ N k hk y hy
  obtain ⟨_, _, hmembase, hmeminv, hb1, hb2⟩ := hmomI
  have hδsq : M.delta ^ 2 ≤ γ * Real.log 3 / (Crate * (1 + q)) := by
    have h1 : M.delta ≤ Real.sqrt (γ * Real.log 3 / (Crate * (1 + q))) :=
      hM.trans (min_le_right _ _)
    have h2 : 0 ≤ M.delta := M.shellPrefix.delta_pos.le
    calc M.delta ^ 2 ≤ (Real.sqrt (γ * Real.log 3 / (Crate * (1 + q)))) ^ 2 :=
          pow_le_pow_left₀ h2 h1 2
      _ = γ * Real.log 3 / (Crate * (1 + q)) := Real.sq_sqrt (by positivity)
  have hexp_bound : Crate * (q + q ^ 2) * M.delta ^ 2 * (k : ℝ) * (1 / q) ≤
      Real.log 3 * (γ * (k : ℝ)) := by
    have hk0 : 0 ≤ (k : ℝ) := Nat.cast_nonneg _
    have heq : Crate * (q + q ^ 2) * M.delta ^ 2 * (k : ℝ) * (1 / q) =
        Crate * (1 + q) * M.delta ^ 2 * (k : ℝ) := by
      field_simp
    rw [heq]
    calc Crate * (1 + q) * M.delta ^ 2 * (k : ℝ) ≤
        Crate * (1 + q) * (γ * Real.log 3 / (Crate * (1 + q))) * (k : ℝ) := by
          apply mul_le_mul_of_nonneg_right _ hk0
          exact mul_le_mul_of_nonneg_left hδsq hCratepos.le
      _ = Real.log 3 * (γ * (k : ℝ)) := by field_simp
  have hbound : (Cmom * Real.exp (Crate * (q + q ^ 2) * M.delta ^ 2 * (k : ℝ))) ^ (1 / q) ≤
      Cmom ^ (1 / q) * (3 : ℝ) ^ (γ * (k : ℝ)) := by
    rw [Real.mul_rpow hCmom.le (Real.exp_pos _).le]
    apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hCmom.le _)
    rw [Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp,
      Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 3)]
    exact Real.exp_le_exp.mpr hexp_bound
  simp only [aux_lem_band_U2_ref_band_reference_eq_s M H N k hk]
  refine ⟨hmembase.aestronglyMeasurable, hmeminv.aestronglyMeasurable,
    hb1.trans (ENNReal.ofReal_le_ofReal hbound), hb2.trans (ENNReal.ofReal_le_ofReal hbound)⟩

def aux_lem_band_ref_log {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (N k : ℕ)
    (y : SpatialCoordinates d) (o : BilateralField d) : ℝ :=
  Real.log (aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N) +
    H o y + aux_lem_band_U2_retained k y o

theorem aux_lem_band_ref_point_moment {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∃ C : ℝ, 0 < C ∧ ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
      (p : ℝ), 2 ≤ p → ∀ (j : ℤ) (y : SpatialCoordinates d),
      eLpNorm (fun o : BilateralField d => o j y) (ENNReal.ofReal p)
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (C * M.delta * Real.sqrt p) := by
  obtain ⟨C, hC, hO⟩ := exists_universal_orlicz_eLpNorm_constant
  refine ⟨C, hC, ?_⟩
  intro M p hp j y
  have hv : Measurable (fun o : BilateralField d => o j y) :=
    (continuous_eval_const y).measurable.comp (measurable_pi_apply j)
  have hb := hO (chaosSampleLaw M).toMeasure (fun o : BilateralField d => |o j y|)
    M.delta hv.norm (fun _ => abs_nonneg _) M.shellPrefix.delta_pos
    (aux_lem_band_K7_layer_point_exp M j y) (ENNReal.ofReal p) ENNReal.ofReal_ne_top
    (by rw [← ENNReal.ofReal_ofNat]; exact ENNReal.ofReal_le_ofReal hp)
  simpa only [← Real.norm_eq_abs, eLpNorm_norm _ hv.aestronglyMeasurable, ENNReal.toReal_ofReal (by linarith : 0 ≤ p)] using hb

theorem aux_lem_band_ref_log_scalar {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M)
    (N k : ℕ) (hk : k ≤ N) :
    |Real.log (aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N)| ≤
      3 * _root_.SubdiffusiveProcess.Model.tauSq M.P * (k : ℝ) := by
  have hkN : (k : ℤ) ≤ N := by exact_mod_cast hk
  have h0N : (0 : ℤ) ≤ N := Int.natCast_nonneg _
  let c := aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N
  have hc : 0 < c := div_pos (aux_lem_band_U2_kappa_pos M _) (aux_lem_band_U2_kappa_pos M N)
  have hu := (aux_lem_band_piece_coords_K7_kappa_ratio_bounded M Rm k 0 N hkN h0N).2
  have hi := (aux_lem_band_piece_coords_K7_kappa_ratio_bounded M Rm 0 k N h0N hkN).2
  have hu' : c ≤ Real.exp (3 * _root_.SubdiffusiveProcess.Model.tauSq M.P * (k : ℝ)) := by
    simpa [c, aux_lem_band_U2_kappa, abs_of_nonneg (Nat.cast_nonneg k : (0 : ℝ) ≤ k)] using hu
  have hi' : c⁻¹ ≤ Real.exp (3 * _root_.SubdiffusiveProcess.Model.tauSq M.P * (k : ℝ)) := by
    simpa [c, aux_lem_band_U2_kappa, inv_div, abs_of_nonneg (Nat.cast_nonneg k : (0 : ℝ) ≤ k)] using hi
  have hlogu := (Real.log_le_iff_le_exp hc).mpr hu'
  have hlogi := (Real.log_le_iff_le_exp (inv_pos.mpr hc)).mpr hi'
  rw [Real.log_inv] at hlogi
  exact abs_le.mpr ⟨by linarith, hlogu⟩

theorem aux_lem_band_ref_log_moment {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (q : ℝ) (hq : 1 ≤ q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ 1 →
      ∀ (_Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (N k : ℕ), k ≤ N → ∀ y : SpatialCoordinates d, ‖y‖ ≤ 1 →
      eLpNorm (aux_lem_band_ref_log M H N k y) (ENNReal.ofReal (2 * q))
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (C * M.delta * ((k : ℝ) + 1)) := by
  obtain ⟨Cp, hCp, hpoint⟩ := aux_lem_band_ref_point_moment (d := d)
  obtain ⟨Cinf, hCinf, hExp⟩ := exists_uniform_compactExponentialMoment_of_infraredCharacterization hd
  let Kc : Compacts (SpatialCoordinates d) :=
    ⟨Metric.closedBall (0 : SpatialCoordinates d) 1, ProperSpace.isCompact_closedBall _ _⟩
  let Ch : ℝ := 2 * Real.sqrt (2 * q) * Real.exp (Cinf Kc * (Real.sqrt (2 * q) + 2 * q) ^ 2)
  let Cl : ℝ := Cp * Real.sqrt (2 * q)
  have hCh : 0 ≤ Ch := by dsimp [Ch]; positivity
  have hCl : 0 ≤ Cl := by dsimp [Cl]; positivity
  refine ⟨3 + Ch + Cl, by positivity, ?_⟩
  intro M hδ1 Rm H hH N k hk y hy
  let μ := (chaosSampleLaw M).toMeasure
  have hδ := M.shellPrefix.delta_pos
  have hp2 : 2 ≤ 2 * q := by linarith
  have hp : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 * q) := ENNReal.one_le_ofReal.mpr (by linarith)
  have hp0 : ENNReal.ofReal (2 * q) ≠ 0 := by positivity
  let X : BilateralField d → ℝ := fun o => ‖(H o).restrict (Kc : Set (SpatialCoordinates d))‖
  have hX0 : ∀ o, 0 ≤ X o := fun _ => norm_nonneg _
  have hHn : eLpNorm (fun o => H o y) (ENNReal.ofReal (2 * q)) μ ≤
      ENNReal.ofReal (Ch * M.delta) := by
    have he := aux_neumann_centered_response_expX_norm μ X hX0 (Cinf Kc) (hCinf Kc)
      M.delta hδ hδ1 (hExp M H hH Kc) (2 * q) (by linarith)
    refine (eLpNorm_mono ((continuous_eval_const y).measurable.comp hH.1).aestronglyMeasurable (fun o => ?_)).trans he
    have hyK : y ∈ (Kc : Set (SpatialCoordinates d)) := by
      simpa only [Kc, Compacts.coe_mk, Metric.mem_closedBall, dist_zero_right] using hy
    have hyb := ContinuousMap.norm_coe_le_norm ((H o).restrict (Kc : Set (SpatialCoordinates d)))
      ⟨y, hyK⟩
    have he0 : 0 ≤ Real.exp (X o) - 1 := sub_nonneg.mpr (Real.one_le_exp (hX0 o))
    rw [Real.norm_of_nonneg he0]
    have he1 := Real.add_one_le_exp (X o)
    exact hyb.trans (by linarith)
  have hHm : AEStronglyMeasurable (fun o => H o y) μ :=
    ((continuous_eval_const y).measurable.comp hH.1).aestronglyMeasurable
  have hRm : AEStronglyMeasurable (aux_lem_band_U2_retained (k : ℤ) y) μ :=
    (aux_lem_band_K7_retained_meas aux_lem_band_U2_retained rfl k y).aestronglyMeasurable
  have hRn : eLpNorm (aux_lem_band_U2_retained (k : ℤ) y) (ENNReal.ofReal (2 * q)) μ ≤
      ENNReal.ofReal (Cl * M.delta * (k : ℝ)) := by
    classical
    have heq : aux_lem_band_U2_retained (k : ℤ) y =
        ∑ j ∈ Finset.Ico (0 : ℤ) (k : ℤ), (fun o : BilateralField d => o (-j) y) := by
      funext o
      simp [aux_lem_band_U2_retained]
    rw [heq]
    calc _ ≤ ∑ j ∈ Finset.Ico (0 : ℤ) (k : ℤ),
          eLpNorm (fun o : BilateralField d => o (-j) y) (ENNReal.ofReal (2 * q)) μ := by
            apply eLpNorm_sum_le hp
      _ ≤ ∑ _j ∈ Finset.Ico (0 : ℤ) (k : ℤ), ENNReal.ofReal (Cp * M.delta * Real.sqrt (2 * q)) :=
        Finset.sum_le_sum (fun j _ => hpoint M (2 * q) hp2 (-j) y)
      _ = ENNReal.ofReal (Cl * M.delta * (k : ℝ)) := by
        simp only [Finset.sum_const, Int.card_Ico, sub_zero, Int.toNat_natCast, nsmul_eq_mul]
        rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (Nat.cast_nonneg k)]
        congr 1
        dsimp [Cl]
        ring
  let c := Real.log (aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N)
  have hτ : _root_.SubdiffusiveProcess.Model.tauSq M.P ≤ M.delta := by
    have ht := SubdiffusiveProcess.CoarseGrainingVocab.tauSq_le_delta_sq M
    have hl := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    have hs : M.delta ^ 2 ≤ M.delta := by nlinarith
    have hl2 : Real.log 2 / 2 ≤ 1 := by linarith
    exact (ht.trans (by nlinarith [mul_le_mul_of_nonneg_right hl2 (sq_nonneg M.delta)])).trans hs
  have hcn : |c| ≤ 3 * M.delta * (k : ℝ) :=
    (aux_lem_band_ref_log_scalar M Rm N k hk).trans
      (by gcongr)
  have hcLp : eLpNorm (fun _ : BilateralField d => c) (ENNReal.ofReal (2 * q)) μ ≤
      ENNReal.ofReal (3 * M.delta * (k : ℝ)) := by
    rw [eLpNorm_const _ hp0 (NeZero.ne μ), measure_univ, ENNReal.one_rpow, mul_one,
      Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal hcn
  have hFun : aux_lem_band_ref_log M H N k y =
      ((fun _ : BilateralField d => c) + (fun o => H o y)) + aux_lem_band_U2_retained k y := rfl
  rw [hFun]
  calc _ ≤ eLpNorm ((fun _ : BilateralField d => c) + (fun o => H o y))
        (ENNReal.ofReal (2 * q)) μ + eLpNorm (aux_lem_band_U2_retained k y) (ENNReal.ofReal (2 * q)) μ :=
      eLpNorm_add_le hp
    _ ≤ (eLpNorm (fun _ : BilateralField d => c) (ENNReal.ofReal (2 * q)) μ +
        eLpNorm (fun o => H o y) (ENNReal.ofReal (2 * q)) μ) +
        eLpNorm (aux_lem_band_U2_retained k y) (ENNReal.ofReal (2 * q)) μ :=
      add_le_add (eLpNorm_add_le hp) le_rfl
    _ ≤ (ENNReal.ofReal (3 * M.delta * (k : ℝ)) + ENNReal.ofReal (Ch * M.delta)) +
        ENNReal.ofReal (Cl * M.delta * (k : ℝ)) := add_le_add (add_le_add hcLp hHn) hRn
    _ = ENNReal.ofReal (3 * M.delta * (k : ℝ) + Ch * M.delta + Cl * M.delta * (k : ℝ)) := by
      rw [← ENNReal.ofReal_add (by positivity) (by positivity),
        ← ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ ENNReal.ofReal ((3 + Ch + Cl) * M.delta * ((k : ℝ) + 1)) := by
      apply ENNReal.ofReal_le_ofReal
      have hh : 0 ≤ Ch * M.delta * (k : ℝ) := by positivity
      have hl : 0 ≤ Cl * M.delta := by positivity
      nlinarith

def aux_lem_band_ref_tail {d : ℕ}
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (y : SpatialCoordinates d) (h : ℕ)
