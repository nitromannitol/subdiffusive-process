theorem aux_lem_band_U2_T3_infrared_transport {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (m : ℤ) (w : SpatialCoordinates d) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ y : SpatialCoordinates d,
      H (aux_lem_band_U2_shift m w omega) y =
        H omega (aux_lem_band_U2_cellMap m w y) - H omega w +
          aux_lem_band_U2_retained m (aux_lem_band_U2_cellMap m w y) omega - aux_lem_band_U2_retained m w omega := by
  filter_upwards [aux_lem_band_transport_infrared hH m w] with omega h y
  have e : aux_lem_band_U2_cellMap m w y = w + (3 : ℝ) ^ (-m) • y := aux_lem_band_transport_cellMap_apply m w y
  rw [e]
  exact h y

theorem aux_lem_band_U2_T4_chart_identity {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (N : ℕ) (m : ℤ) (hm : m ≤ (N : ℤ)) (w : SpatialCoordinates d)
    (hr : 0 < (3 : ℝ) ^ (-m)) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      aux_lem_band_U2_Scaled (aux_lem_band_U2_reference M H N m w omega)
        (aux_lem_band_U2_unitChart I M H (aux_lem_band_U2_shift m w omega) ((N : ℤ) - m).toNat)
        (I.chart w ((3 : ℝ) ^ (-m)) hr
          (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega N w hr) w ((3 : ℝ) ^ (-m))) := by
  have hA := aux_lem_band_transport_chart_agree I M hH N m hm w (fun n => by positivity)
  filter_upwards [hA] with omega hom Q hQ
  have h1 := hom Q hQ
  have hrefpos := aux_lem_band_transport_reference_pos M H N m w omega
  have h2 := I.chart_eq 0 1 one_pos (scalePositiveCoefficient
    (aux_lem_band_transport_reference M H N m w omega) hrefpos
    (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H (aux_lem_band_transport_S m w omega) (((N : ℤ) - m).toNat) 0 one_pos))
    0 1 one_pos subset_rfl Q hQ
  have h3 := I.chart_eq 0 1 one_pos
    (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H (aux_lem_band_transport_S m w omega) (((N : ℤ) - m).toNat) 0 one_pos)
    0 1 one_pos subset_rfl Q hQ
  have h4 := scalePositiveCoefficient_coeFn (aux_lem_band_transport_reference M H N m w omega) hrefpos
    (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H (aux_lem_band_transport_S m w omega) (((N : ℤ) - m).toNat) 0 one_pos)
  have hcar := aux_chart_transfer_root_carrier (d := d)
  have h4' : ∀ᵐ x ∂volume.restrict (Homogenization.openCubeSet (Homogenization.originCube d 0)),
      (scalePositiveCoefficient (aux_lem_band_transport_reference M H N m w omega) hrefpos
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H (aux_lem_band_transport_S m w omega)
          (((N : ℤ) - m).toNat) 0 one_pos)).val x =
      aux_lem_band_transport_reference M H N m w omega *
        (_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H (aux_lem_band_transport_S m w omega)
          (((N : ℤ) - m).toNat) 0 one_pos).val x := by
    rw [← hcar]; exact h4
  have h4Q := ae_restrict_of_ae_restrict_of_subset hQ h4'
  unfold Homogenization.Book.Ch02.CoeffOn.AEScaled
  filter_upwards [h1, h2, h3, h4Q] with x hx1 hx2 hx3 hx4
  have e0 : (fun i => (0 : SpatialCoordinates d) i + 1 * x i) = x := by funext i; simp
  have hx3' : ((aux_lem_band_U2_unitChart I M H (aux_lem_band_U2_shift m w omega) ((N : ℤ) - m).toNat).coeffOn
      Q).toCoeffField x = Homogenization.scalarMatrix
        ((_root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H (aux_lem_band_U2_shift m w omega) ((N : ℤ) - m).toNat 0
          one_pos).val (fun i => (0 : SpatialCoordinates d) i + 1 * x i)) := hx3
  rw [hx1, hx2, hx3', e0, hx4]
  simp only [Homogenization.scalarMatrix, smul_smul]
  rfl

theorem aux_lem_band_rem_bank_uniform_dirichlet (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : _root_.SubdiffusiveProcess.Paper.in_J d) (_P : _root_.SubdiffusiveProcess.Paper.in_poincare d hd E) (_X : _root_.SubdiffusiveProcess.Paper.in_extension d hd E)
    (_W : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d) (_Sob : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (_D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (t : ℝ) (_ht0 : (d : ℝ) - 1 < t) (_ht1 : t < (d : ℝ)) (Cresp : ℝ) (_hCresp : 0 < Cresp) :
    ∀ p : ℝ, 2 ≤ p →
    ∀ z : SpatialCoordinates d, ∀ r : ℝ, ∀ hr : 0 < r, r ≤ 1 →
      ∀ hP : (∃ K : ℝ≥0, ∀ w : killedSobolevGraph (centeredCube z r hr),
          ‖(w : SobolevData (centeredCube z r hr)).1‖ ≤
            K * ‖subspaceGradient (killedSobolevGraph (centeredCube z r hr)) w‖),
      ∀ phi : SpatialCoordinates d → ℝ, ContDiff ℝ ∞ phi →
      ∀ b : weakSobolevGraph (centeredCube z r hr),
        (b.val.1 =ᵐ[volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d))] phi) →
      ∀ f : SpatialCoordinates d → ℝ, ContDiff ℝ ∞ f → HasCompactSupport f →
        tsupport f ⊆ (centeredCube z r hr : Set (SpatialCoordinates d)) →
      ∀ fL2 : DomainL2 (centeredCube z r hr),
        ((fL2 : SpatialCoordinates d → ℝ)
          =ᵐ[volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d))] f) →
      ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 ≤ B ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M E Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        let q : ℝ := 2 * p
        let Q : Opens (SpatialCoordinates d) := centeredCube z r hr
        let Pm : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
        let S : ResponseSpace Q := killedResponseSpace hP
        let a : ℕ → BilateralField d → PositiveCoefficient Q :=
            fun N omega => cutoffPositiveCoefficient M H omega N z hr
        let load : S.space →L[ℝ] ℝ := (sobolevVolumeLoad fL2).comp S.space.subtypeL
        let uD : ℕ → BilateralField d → weakSobolevGraph Q :=
            fun N omega => dirichletMinimizer S (a N omega) b
        let uK : ℕ → BilateralField d → S.space :=
            fun N omega => responseSolution S (a N omega) load
        let RD : ℕ → BilateralField d → ℝ := fun N omega => dirichletResponse S (a N omega) b
        let RK : ℕ → BilateralField d → ℝ := fun N omega => inverseResponse S (a N omega) load
        ∃ KD KK : ℕ → BilateralField d → ℝ,
          (∀ᵐ omega ∂Pm, ∀ N, 0 ≤ KD N omega ∧ 0 ≤ KK N omega ∧
            (∀ x ∈ (Q : Set (SpatialCoordinates d)), ∀ rad : ℝ, 0 < rad → rad ≤ 1 →
                localGradientEnergy (a N omega)
                  (show MeasurableSet (Metric.ball x rad ∩ (Q : Set (SpatialCoordinates d))) from
                    (Metric.isOpen_ball.inter Q.isOpen).measurableSet)
                  (sobolevGradient (uD N omega).val) ≤ KD N omega * rad ^ t) ∧
            (∀ x ∈ (Q : Set (SpatialCoordinates d)), ∀ rad : ℝ, 0 < rad → rad ≤ 1 →
                localGradientEnergy (a N omega)
                  (show MeasurableSet (Metric.ball x rad ∩ (Q : Set (SpatialCoordinates d))) from
                    (Metric.isOpen_ball.inter Q.isOpen).measurableSet)
                  (sobolevGradient (uK N omega).val) ≤ KK N omega * rad ^ t)) ∧
          (∀ N, MemLp (KD N) (ENNReal.ofReal (3 * p)) Pm ∧
                MemLp (KK N) (ENNReal.ofReal (3 * p)) Pm ∧
                MemLp (RD N) (ENNReal.ofReal (3 * p)) Pm ∧
                MemLp (RK N) (ENNReal.ofReal (3 * p)) Pm ∧
                MemLp (RD N) (ENNReal.ofReal q) Pm ∧
                MemLp (RK N) (ENNReal.ofReal q) Pm) ∧
          (∀ N, eLpNorm (KD N) (ENNReal.ofReal (3 * p)) Pm +
                eLpNorm (KK N) (ENNReal.ofReal (3 * p)) Pm +
                eLpNorm (RD N) (ENNReal.ofReal (3 * p)) Pm +
                eLpNorm (RK N) (ENNReal.ofReal (3 * p)) Pm +
                eLpNorm (RD N) (ENNReal.ofReal q) Pm +
                eLpNorm (RK N) (ENNReal.ofReal q) Pm ≤ ENNReal.ofReal B) := by
  intro p hp z r hr hr1 hP phi hphi b hb f hf hfc hfsub fL2 hfL2
  obtain ⟨δ0, hδ0, B, hB, h⟩ := aux_lem_band_UBlane_rem_bank_uniform_dirichlet d hd E _P _X _W _Sob _D t
    _ht0 _ht1 Cresp _hCresp p hp z r hr hr1 hP phi hphi b hb f hf hfc hfsub fL2 hfL2
  exact ⟨δ0, B, hδ0, hB, fun M Rm hRm Sreg It H hH hδ => h M Rm hRm Sreg It H hH hδ⟩

theorem aux_lem_band_rem_bank_uniform_neumann (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : _root_.SubdiffusiveProcess.Paper.in_J d) (_P : _root_.SubdiffusiveProcess.Paper.in_poincare d hd E) (_X : _root_.SubdiffusiveProcess.Paper.in_extension d hd E)
    (_W : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d) (_Sob : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (_D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (t : ℝ) (_ht0 : (d : ℝ) - 1 < t) (_ht1 : t < (d : ℝ)) (Cresp : ℝ) (_hCresp : 0 < Cresp) :
    ∀ p : ℝ, 2 ≤ p →
    ∀ rho : ℝ → ℝ, ContDiff ℝ ∞ rho → (∀ v : ℝ, 0 ≤ rho v) →
      (∀ v : ℝ, v ∉ Set.Ioo (1 : ℝ) 2 → rho v = 0) → (∫ v, rho v) = 1 →
    ∀ pvec : Fin d → ℝ, (∑ i : Fin d, (pvec i) ^ 2) = 1 →
    ∀ hPn : (∃ K : ℝ≥0, ∀ w : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(w : SobolevData (unitNeumannCube d)).1‖ ≤
          K * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) w‖),
      ∃ delta0 B9 B13 Bsm : ℝ, 0 < delta0 ∧ 0 ≤ B9 ∧ 0 ≤ B13 ∧ 0 ≤ Bsm ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M E Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        let q : ℝ := 2 * p
        let Pm : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
        let Qn : Opens (SpatialCoordinates d) := unitNeumannCube d
        let zn : SpatialCoordinates d := fun _ : Fin d => (1 / 2 : ℝ)
        let Sn : ResponseSpace Qn := meanZeroResponseSpace hPn
        let an : ℕ → BilateralField d → PositiveCoefficient Qn :=
            fun N omega => cutoffPositiveCoefficient M H omega N zn one_pos
        let Lp : Sn.space →L[ℝ] ℝ :=
            (affineNeumannLoad pvec).comp (subspaceGradient (meanZeroSobolevGraph Qn))
        let yn : ℕ → BilateralField d → ℝ := fun N omega => inverseResponse Sn (an N omega) Lp
        ∃ Kcoerc K13 : ℕ → BilateralField d → ℝ,
          (∀ᵐ omega ∂Pm, ∀ N, 0 ≤ Kcoerc N omega ∧ 0 ≤ K13 N omega ∧
            (∀ v : meanZeroSobolevGraph Qn,
                cubeFractionalSqNorm hd zn 1 one_pos threeQuarterOrder v.val.1 ≤
                  Kcoerc N omega * sobolevCoefficientForm (an N omega) v.val v.val) ∧
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ v : meanZeroSobolevGraph Qn,
                SolvesNeumann (an N omega) (faceBump rho pvec eps) v →
                ∀ x ∈ (Qn : Set (SpatialCoordinates d)), ∀ rad : ℝ, 0 < rad → rad ≤ 1 →
                    localGradientEnergy (an N omega)
                      (show MeasurableSet
                          (Metric.ball x rad ∩ (Qn : Set (SpatialCoordinates d))) from
                        (Metric.isOpen_ball.inter Qn.isOpen).measurableSet)
                      (sobolevGradient v.val) ≤ K13 N omega * eps ^ (-2 : ℝ) * rad ^ t)) ∧
          (∀ N, MemLp (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm ∧
                MemLp (yn N) (ENNReal.ofReal (12 * p)) Pm ∧
                MemLp (Kcoerc N) (ENNReal.ofReal (4 * q)) Pm ∧
                MemLp (yn N) (ENNReal.ofReal (4 * q)) Pm) ∧
          (∀ N, eLpNorm (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm +
                eLpNorm (yn N) (ENNReal.ofReal (12 * p)) Pm +
                eLpNorm (Kcoerc N) (ENNReal.ofReal (4 * q)) Pm +
                eLpNorm (yn N) (ENNReal.ofReal (4 * q)) Pm ≤ ENNReal.ofReal B9) ∧
          (∀ N, MemLp (K13 N) (ENNReal.ofReal (3 * p)) Pm ∧
                eLpNorm (K13 N) (ENNReal.ofReal (3 * p)) Pm ≤ ENNReal.ofReal B13) ∧
          (∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ fL2 : DomainL2 Qn,
              ((fL2 : SpatialCoordinates d → ℝ)
                =ᵐ[volume.restrict (Qn : Set (SpatialCoordinates d))] faceBump rho pvec eps) →
              let ys : ℕ → BilateralField d → ℝ :=
                fun N omega => inverseResponse Sn (an N omega)
                  ((sobolevVolumeLoad fL2).comp Sn.space.subtypeL)
              ∀ N, MemLp (ys N) (ENNReal.ofReal (3 * p)) Pm ∧
                   MemLp (ys N) (ENNReal.ofReal q) Pm ∧
                   eLpNorm (ys N) (ENNReal.ofReal (3 * p)) Pm +
                     eLpNorm (ys N) (ENNReal.ofReal q) Pm ≤ ENNReal.ofReal Bsm) := by
  intro p hp rho hrho hrho0 hrhos hrhoi pvec hpvec hPn
  obtain ⟨δ0, hδ0, B9, B13, Bsm, hB9, hB13, hBsm, h⟩ := aux_lem_band_UBlane_rem_bank_uniform_neumann d hd
    E _P _X _W _Sob _D t _ht0 _ht1 Cresp _hCresp p hp rho hrho hrho0 hrhos hrhoi pvec hpvec hPn
  refine ⟨δ0, B9, B13, Bsm, hδ0, hB9, hB13, hBsm, fun M Rm hRm Sreg It H hH hδ => ?_⟩
  have hM := h M Rm hRm Sreg It H hH hδ
  dsimp only at hM ⊢
  rw [show (4 : ℝ) * (2 * p) = 8 * p by ring]
  exact hM

theorem aux_lem_band_U2_band_le {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {lo hi lo' hi' : ℤ} (hlo : lo ≤ lo') (hhi : hi' ≤ hi) :
    aux_lem_band_U2_band d lo' hi' ≤ aux_lem_band_U2_band d lo hi := by
  set incl : Set.Icc lo' hi' → Set.Icc lo hi :=
    fun j => ⟨j.1, ⟨hlo.trans j.2.1, j.2.2.trans hhi⟩⟩ with hincl
  set restr : (Set.Icc lo hi → C(SpatialCoordinates d, ℝ)) →
      (Set.Icc lo' hi' → C(SpatialCoordinates d, ℝ)) := fun g j => g (incl j) with hrestr
  have hrestr_meas : Measurable restr :=
    Measurable.of_eval (fun j => measurable_pi_apply (incl j))
  have hfactor : (fun omega : BilateralField d => fun j : Set.Icc lo' hi' => omega (j : ℤ)) =
      restr ∘ (fun omega : BilateralField d => fun j : Set.Icc lo hi => omega (j : ℤ)) := by
    funext omega j
    rfl
  unfold aux_lem_band_U2_band
  rw [hfactor, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono hrestr_meas.comap_le

theorem aux_lem_band_U2_band_mono {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {mu : Measure (BilateralField d)} {lo hi lo' hi' : ℤ} (hlo : lo ≤ lo') (hhi : hi' ≤ hi)
    {f : BilateralField d → ℝ} (hf : AEStronglyMeasurable[aux_lem_band_U2_band d lo' hi'] f mu) :
    AEStronglyMeasurable[aux_lem_band_U2_band d lo hi] f mu := by
  obtain ⟨g, hg, hfg⟩ := hf
  exact ⟨g, hg.mono (aux_lem_band_U2_band_le hlo hhi), hfg⟩

theorem aux_lem_band_U2_shift_measurable {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (m : ℤ) (w : SpatialCoordinates d) : Measurable (aux_lem_band_U2_shift (d := d) m w) := by
  have hc : Measurable fun f : C(SpatialCoordinates d, ℝ) => f.comp (aux_lem_band_U2_cellMap m w) := by
    fun_prop
  exact Measurable.of_eval (fun j => hc.comp (measurable_pi_apply (j - m)))

theorem aux_lem_band_U2_cellMap_inv {d : ℕ} (m : ℤ) (w : SpatialCoordinates d) (y : SpatialCoordinates d) :
    aux_lem_band_U2_cellMap m w (aux_lem_band_U2_cellMap (-m) (-(((3 : ℝ) ^ m) • w)) y) = y := by
  funext i
  simp only [aux_lem_band_U2_cellMap, ContinuousMap.coe_mk, cubeDilation, Pi.zero_apply, sub_zero,
    Pi.neg_apply, Pi.smul_apply, smul_eq_mul, neg_neg]
  have h3 : (3 : ℝ) ^ (-m) * (3 : ℝ) ^ m = 1 := by
    rw [← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]; simp
  calc w i + (3 : ℝ) ^ (-m) * (-((3 : ℝ) ^ m * w i) + (3 : ℝ) ^ m * y i)
      = w i - ((3 : ℝ) ^ (-m) * (3 : ℝ) ^ m) * w i + ((3 : ℝ) ^ (-m) * (3 : ℝ) ^ m) * y i := by
        ring
    _ = y i := by rw [h3]; ring

theorem aux_lem_band_U2_shift_leftInverse {d : ℕ} (m : ℤ) (w : SpatialCoordinates d)
    (omega : BilateralField d) :
    aux_lem_band_U2_shift (-m) (-(((3 : ℝ) ^ m) • w)) (aux_lem_band_U2_shift m w omega) = omega := by
  funext i
  ext y
  simp only [aux_lem_band_U2_shift, ContinuousMap.comp_apply]
  rw [aux_lem_band_U2_cellMap_inv m w y]
  congr 2
  ring

theorem aux_lem_band_U2_shift_rightInverse {d : ℕ} (m : ℤ) (w : SpatialCoordinates d)
    (omega : BilateralField d) :
    aux_lem_band_U2_shift m w (aux_lem_band_U2_shift (-m) (-(((3 : ℝ) ^ m) • w)) omega) = omega := by
  funext i
  ext y
  simp only [aux_lem_band_U2_shift, ContinuousMap.comp_apply]
  have hy : aux_lem_band_U2_cellMap (-m) (-(((3 : ℝ) ^ m) • w)) (aux_lem_band_U2_cellMap m w y) = y := by
    have h := aux_lem_band_U2_cellMap_inv (-m) (-(((3 : ℝ) ^ m) • w)) y
    have hw : -(((3 : ℝ) ^ (-m)) • -(((3 : ℝ) ^ m) • w)) = w := by
      rw [smul_neg, neg_neg, smul_smul, ← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]
      simp
    rw [neg_neg, hw] at h
    exact h
  rw [hy]
  congr 2
  ring

def aux_lem_band_U2_shiftEquiv {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
