  · norm_num [Pi.single_apply, hij, Ne.symm hij]

theorem aux_lem_band_fine_scalar_baseline {d : ℕ} (Q : Homogenization.TriadicCube d)
    {b : Vec d → ℝ} (hb : ScalarCoeffOnData (Ch02.cubeDomain Q) b)
    (V : ℝ) (hV : 0 < V)
    (hupper : ∀ᵐ x ∂ volumeMeasureOn (Ch02.cubeDomain Q : Set (Vec d)), b x ≤ Real.exp V)
    (hlower : ∀ᵐ x ∂ volumeMeasureOn (Ch02.cubeDomain Q : Set (Vec d)), Real.exp (-V) ≤ b x)
    (i j : Fin d) :
    |Ch02.sigmaStarInvCoarse (Ch02.cubeDomain Q) hb.toCoeffOn i j -
      (if i=j then (1:ℝ) else 0)| ≤ 504*(Real.exp (2*V)-1) ∧
    |Ch02.sigmaCoarse (Ch02.cubeDomain Q) hb.toCoeffOn i j -
      (if i=j then (1:ℝ) else 0)| ≤ 504*(Real.exp (2*V)-1) ∧
    Ch02.responseJ (Ch02.cubeDomain Q) hb.toCoeffOn 0 (Pi.single i 1) +
      Ch02.responseJ (Ch02.cubeDomain Q) hb.toCoeffOn 0 (Pi.single j 1) +
      Ch02.responseJ (Ch02.cubeDomain Q) hb.toCoeffOn 0 (Pi.single i 1 + Pi.single j 1) ≤
        171*Real.exp (2*V) ∧
    Ch02.responseJ (Ch02.cubeDomain Q) hb.toCoeffOn (Pi.single i 1) 0 +
      Ch02.responseJ (Ch02.cubeDomain Q) hb.toCoeffOn (Pi.single j 1) 0 +
      Ch02.responseJ (Ch02.cubeDomain Q) hb.toCoeffOn (Pi.single i 1 + Pi.single j 1) 0 ≤
        171*Real.exp (2*V) := by
  let ha := aux_lem_band_fine_one Q
  have hu : ∀ᵐ x ∂ volumeMeasureOn (Ch02.cubeDomain Q : Set (Vec d)),
      b x ≤ Real.exp V * (1:ℝ) := by simpa using hupper
  have hl : ∀ᵐ x ∂ volumeMeasureOn (Ch02.cubeDomain Q : Set (Vec d)),
      Real.exp (-V) * (1:ℝ) ≤ b x := by simpa using hlower
  have hv0 : 0 ≤ Real.exp (2*V)-1 := sub_nonneg.mpr (Real.one_le_exp (by linarith))
  have hone := aux_lem_band_fine_one_values Q
  have hs := aux_lem_band_fine_sigmaStarInvEntry ha hb hV hu hl i j
  have hd := aux_lem_band_fine_sigmaCoarse_entry_ratio ha hb hV hu hl i j
  change |Ch02.sigmaStarInvCoarse _ hb.toCoeffOn i j - Ch02.sigmaStarInvCoarse _ ha.toCoeffOn i j| ≤ _ at hs
  simp only [ha, hone.1, hone.2.1, hone.2.2.1, hone.2.2.2, Matrix.one_apply] at hs hd
  have hnum := aux_lem_band_fine_basis_budget i j
  refine ⟨hs.trans ?_, hd.trans ?_, ?_, ?_⟩
  · nlinarith [mul_le_mul_of_nonneg_left hnum (by positivity : 0 ≤ 168*(Real.exp (2*V)-1))]
  · nlinarith [mul_le_mul_of_nonneg_left hnum (by positivity : 0 ≤ 168*(Real.exp (2*V)-1))]
  · have hsum := add_le_add (add_le_add
        (le_abs_self _ |>.trans (aux_lem_band_fine_response_ratio_left ha hb hV hu hl (Pi.single i 1)))
        (le_abs_self _ |>.trans (aux_lem_band_fine_response_ratio_left ha hb hV hu hl (Pi.single j 1))))
        (le_abs_self _ |>.trans (aux_lem_band_fine_response_ratio_left ha hb hV hu hl (Pi.single i 1 + Pi.single j 1)))
    simp only [ha, hone.2.2.2] at hsum
    have hm := mul_le_mul_of_nonneg_left hnum (by positivity : 0 ≤ 1+56*(Real.exp (2*V)-1))
    nlinarith
  · have hsum := add_le_add (add_le_add
        (le_abs_self _ |>.trans (aux_lem_band_fine_response_ratio_right ha hb hV hu hl (Pi.single i 1)))
        (le_abs_self _ |>.trans (aux_lem_band_fine_response_ratio_right ha hb hV hu hl (Pi.single j 1))))
        (le_abs_self _ |>.trans (aux_lem_band_fine_response_ratio_right ha hb hV hu hl (Pi.single i 1 + Pi.single j 1)))
    simp only [ha, hone.2.2.1] at hsum
    have hm := mul_le_mul_of_nonneg_left hnum (by positivity : 0 ≤ 1+56*(Real.exp (2*V)-1))
    nlinarith

theorem aux_lem_band_fine_chart_baseline {d : ℕ}
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (o : BilateralField d) (N : ℕ)
    (R : Homogenization.TriadicCube d) (hR : openCubeSet R ⊆ openCubeSet (originCube d 0))
    (V : ℝ) (hV : 0 < V)
    (hv : ∀ x ∈ (closedCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
      |Real.log (cutoffCoefficient M H o N x)| ≤ V) (i j : Fin d) :
    let a := (aux_lem_band_U2_unitChart I M H o N).coeffOn R
    |Ch02.sigmaStarInvCoarse (Ch02.cubeDomain R) a i j - (if i=j then (1:ℝ) else 0)| ≤
      504*(Real.exp (2*V)-1) ∧
    |Ch02.sigmaCoarse (Ch02.cubeDomain R) a i j - (if i=j then (1:ℝ) else 0)| ≤
      504*(Real.exp (2*V)-1) ∧
    Ch02.responseJ (Ch02.cubeDomain R) a 0 (Pi.single i 1) +
      Ch02.responseJ (Ch02.cubeDomain R) a 0 (Pi.single j 1) +
      Ch02.responseJ (Ch02.cubeDomain R) a 0 (Pi.single i 1 + Pi.single j 1) ≤ 171*Real.exp (2*V) ∧
    Ch02.responseJ (Ch02.cubeDomain R) a (Pi.single i 1) 0 +
      Ch02.responseJ (Ch02.cubeDomain R) a (Pi.single j 1) 0 +
      Ch02.responseJ (Ch02.cubeDomain R) a (Pi.single i 1 + Pi.single j 1) 0 ≤ 171*Real.exp (2*V) := by
  let ha := SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.scalarCoeffOnDataOfContinuousPos
    (cutoffCoefficient_continuous M H o N) (cutoffCoefficient_pos M H o N) (Ch02.cubeDomain R)
  have hAE := aux_lem_band_fine_chart_AEEq I M H o N R hR ha
  have hbounds : ∀ᵐ x ∂volumeMeasureOn (Ch02.cubeDomain R : Set (Vec d)),
      Real.exp (-V) ≤ cutoffCoefficient M H o N x ∧ cutoffCoefficient M H o N x ≤ Real.exp V := by
    filter_upwards [ae_restrict_mem (measurableSet_openCubeSet R)] with x hx
    have hh := abs_le.mp (hv x (aux_lem_band_fine_mem_closed_root R hR hx))
    have he := Real.exp_log (cutoffCoefficient_pos M H o N x)
    constructor
    · rw [← he]; exact Real.exp_le_exp.mpr hh.1
    · rw [← he]; exact Real.exp_le_exp.mpr hh.2
  have hh := aux_lem_band_fine_scalar_baseline R ha V hV
    (hbounds.mono fun _ h => h.2) (hbounds.mono fun _ h => h.1) i j
  dsimp only
  rw [Ch02.sigmaStarInvCoarse_eq_ofAEEq hAE, Ch02.sigmaCoarse_eq_ofAEEq hAE]
  simp_rw [Ch02.responseJ_eq_ofAEEq hAE]
  exact hh

theorem aux_lem_band_fine_domination {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (q c B : ℝ) (hc : 0 ≤ c) (X Y : Ω → ℝ)
    (hY0 : ∀ o, 0 ≤ Y o)
    (hXY : ∀ᵐ o ∂μ, |X o| ≤ c*Y o)
    (hY : SubdiffusiveProcess.RawLp.eLpNorm Y (ENNReal.ofReal q) μ ≤ ENNReal.ofReal B) :
    SubdiffusiveProcess.RawLp.eLpNorm X (ENNReal.ofReal q) μ ≤ ENNReal.ofReal (c*B) := by
  calc _ ≤ SubdiffusiveProcess.RawLp.eLpNorm (fun o => c*Y o) (ENNReal.ofReal q) μ := by
        apply SubdiffusiveProcess.RawLp.eLpNorm_mono_ae
        filter_upwards [hXY] with o ho
        simpa only [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hc (hY0 o))] using ho
    _ = ENNReal.ofReal c*SubdiffusiveProcess.RawLp.eLpNorm Y (ENNReal.ofReal q) μ := by
      by_cases hp0 : ENNReal.ofReal q = 0
      · simp only [SubdiffusiveProcess.RawLp.eLpNorm, hp0, ite_true, mul_zero]
      · have hqpos : 0 < q := ENNReal.ofReal_pos.mp (pos_iff_ne_zero.mpr hp0)
        simp only [SubdiffusiveProcess.RawLp.eLpNorm, ite_eq_right hp0, ite_eq_right ENNReal.ofReal_ne_top]
        change eLpNorm' (c • Y) (ENNReal.ofReal q).toReal μ = _
        rw [eLpNorm'_const_smul c (by simpa only [ENNReal.toReal_ofReal hqpos.le] using! hqpos), Real.enorm_eq_ofReal hc]
    _ ≤ ENNReal.ofReal c*ENNReal.ofReal B := mul_le_mul_right hY _
    _ = _ := (ENNReal.ofReal_mul hc).symm

theorem aux_lem_band_fine_cutoff_ratio {d : ℕ}
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H H' : BilateralField d → C(SpatialCoordinates d, ℝ)) (o : BilateralField d) (N : ℕ)
    (x : SpatialCoordinates d) :
    cutoffCoefficient M H' o N x =
      Real.exp (H' o x-H o x) * cutoffCoefficient M H o N x := by
  rw [aux_lem_band_U2E_cutoff_factor M H' o N x, aux_lem_band_U2E_cutoff_factor M H o N x]
  rw [Real.exp_sub]
  field_simp

theorem aux_lem_band_fine_chart_difference {d : ℕ}
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H H' : BilateralField d → C(SpatialCoordinates d, ℝ)) (o : BilateralField d) (N : ℕ)
    (R : Homogenization.TriadicCube d) (hR : openCubeSet R ⊆ openCubeSet (originCube d 0))
    (V D : ℝ) (hV : 0 < V) (hD : 0 < D)
    (hv : ∀ x ∈ (closedCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
      |Real.log (cutoffCoefficient M H o N x)| ≤ V)
    (hdiff : ∀ x ∈ (closedCube (0 : SpatialCoordinates d) 1 one_pos : Set (SpatialCoordinates d)),
      |H' o x-H o x| ≤ D) (i j : Fin d) :
    let a := (aux_lem_band_U2_unitChart I M H o N).coeffOn R
    let b := (aux_lem_band_U2_unitChart I M H' o N).coeffOn R
    |Ch02.sigmaStarInvCoarse (Ch02.cubeDomain R) a i j - Ch02.sigmaStarInvCoarse (Ch02.cubeDomain R) b i j| ≤
      28728*Real.exp (2*V)*(Real.exp (2*D)-1) ∧
    |Ch02.sigmaCoarse (Ch02.cubeDomain R) a i j - Ch02.sigmaCoarse (Ch02.cubeDomain R) b i j| ≤
      28728*Real.exp (2*V)*(Real.exp (2*D)-1) := by
  let ha := SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.scalarCoeffOnDataOfContinuousPos
    (cutoffCoefficient_continuous M H o N) (cutoffCoefficient_pos M H o N) (Ch02.cubeDomain R)
  let hb := SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.scalarCoeffOnDataOfContinuousPos
    (cutoffCoefficient_continuous M H' o N) (cutoffCoefficient_pos M H' o N) (Ch02.cubeDomain R)
  have haE := aux_lem_band_fine_chart_AEEq I M H o N R hR ha
  have hbE := aux_lem_band_fine_chart_AEEq I M H' o N R hR hb
  have hbounds : ∀ᵐ x ∂volumeMeasureOn (Ch02.cubeDomain R : Set (Vec d)),
      Real.exp (-D)*cutoffCoefficient M H o N x ≤ cutoffCoefficient M H' o N x ∧
      cutoffCoefficient M H' o N x ≤ Real.exp D*cutoffCoefficient M H o N x := by
    filter_upwards [ae_restrict_mem (measurableSet_openCubeSet R)] with x hx
    have hh := abs_le.mp (hdiff x (aux_lem_band_fine_mem_closed_root R hR hx))
    rw [aux_lem_band_fine_cutoff_ratio M H H' o N x]
    constructor <;> apply mul_le_mul_of_nonneg_right _ (cutoffCoefficient_pos M H o N x).le
    · exact Real.exp_le_exp.mpr hh.1
    · exact Real.exp_le_exp.mpr hh.2
  have hupper := hbounds.mono fun _ h => h.2
  have hlower := hbounds.mono fun _ h => h.1
  have hs := aux_lem_band_fine_sigmaStarInvEntry ha hb hD hupper hlower i j
  have hd := aux_lem_band_fine_sigmaCoarse_entry_ratio ha hb hD hupper hlower i j
  have hbase := (aux_lem_band_fine_chart_baseline I M H o N R hR V hV hv i j).2.2
  simp_rw [Ch02.responseJ_eq_ofAEEq haE] at hbase
  have hD0 : 0 ≤ 168*(Real.exp (2*D)-1) := by
    have hh := Real.one_le_exp (by linarith : 0≤2*D)
    exact mul_nonneg (by norm_num) (sub_nonneg.mpr hh)
  dsimp only
  rw [Ch02.sigmaStarInvCoarse_eq_ofAEEq haE, Ch02.sigmaStarInvCoarse_eq_ofAEEq hbE,
    Ch02.sigmaCoarse_eq_ofAEEq haE, Ch02.sigmaCoarse_eq_ofAEEq hbE]
  rw [abs_sub_comm (Ch02.sigmaStarInvCoarse _ _ i j), abs_sub_comm (Ch02.sigmaCoarse _ _ i j)]
  constructor
  · exact hs.trans ((mul_le_mul_of_nonneg_left hbase.1 hD0).trans_eq (by ring))
  · exact hd.trans ((mul_le_mul_of_nonneg_left hbase.2 hD0).trans_eq (by ring))

theorem aux_lem_band_fine_cell_from_bounds {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (μ : Measure (BilateralField d)) (N k : ℕ) (hNk : N ≤ k)
    (q γ δ A B : ℝ) (hγ : 0 < γ) (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (X : BilateralField d → ℝ) (Xh : ℕ → BilateralField d → ℝ) (x0 : ℝ)
    (hXm : AEStronglyMeasurable X μ)
    (hXhm : ∀ h, k ≤ h → Measurable[aux_lem_band_U2_band d (-((h+1:ℕ):ℤ)) ((h+1:ℕ):ℤ)] (Xh h))
    (hXn : eLpNorm (fun o => X o-x0) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (A*δ*(3:ℝ)^(γ*(N:ℝ))))
    (hXhn : ∀ h, k ≤ h → eLpNorm (fun o => X o-Xh h o) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (B*δ*(3:ℝ)^(γ*(N:ℝ))*(1/3:ℝ)^(h+1))) :
    aux_lem_band_U2_CellOK μ 1 1 1 (A+B) γ δ q k X x0 := by
  have hG : (3:ℝ)^(γ*(N:ℝ)) ≤ (3:ℝ)^(γ*(k:ℝ)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num)
      (mul_le_mul_of_nonneg_left (by exact_mod_cast hNk) hγ.le)
  have hAn : A*δ*(3:ℝ)^(γ*(N:ℝ)) ≤ (A+B)*δ*(3:ℝ)^(γ*(k:ℝ)) := by
    apply mul_le_mul (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hB) hδ.le) hG
      (by positivity) (by positivity)
  refine ⟨hXm, ?_, ?_⟩
  · simpa only [Real.rpow_one] using hXn.trans (ENNReal.ofReal_le_ofReal hAn)
  · intro h hkh
    have hh : (1/3:ℝ)^(h+1) ≤ (3:ℝ)^(-(h:ℝ)) := by
      rw [Real.rpow_neg (by norm_num : (0:ℝ)≤3), Real.rpow_natCast, ← inv_pow]
      have he : (3:ℝ)⁻¹ = 1/3 := by norm_num
      rw [he]
      exact pow_le_pow_of_le_one (by norm_num) (by norm_num) (Nat.le_succ _)
    have hBn : B*δ*(3:ℝ)^(γ*(N:ℝ)) ≤ (A+B)*δ*(3:ℝ)^(γ*(k:ℝ)) := by
      apply mul_le_mul (mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hA) hδ.le) hG
        (by positivity) (by positivity)
    have hn := (hXhn h hkh).trans (ENNReal.ofReal_le_ofReal
      (mul_le_mul hBn hh (by positivity) (by positivity)))
    refine ⟨fun o => Xh h o-x0, ?_, ?_⟩
    · convert! ((hXhm h hkh).sub_const x0).aestronglyMeasurable (μ := μ) using 1
      congr 1 <;> omega
    · have he : (fun o => (X o-x0)-(Xh h o-x0)) = fun o => X o-Xh h o := by funext o; ring
      simpa only [he, Real.rpow_one, one_mul] using! hn

theorem aux_lem_band_U2_cellE_fine
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (_D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (_hCresp : 0 < Cresp) :
    ∃ a c : ℝ, 0 < a ∧ 0 < c ∧ ∃ w' : ℕ, 0 < w' ∧
      ∀ γ : ℝ, 0 < γ → ∀ q : ℝ, 1 ≤ q → ∃ delta0 C : ℝ, 0 < delta0 ∧ 0 ≤ C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K k : ℕ), K < k → ∀ R ∈ aux_lem_band_U2_D (d := d) k, ∀ i j : Fin d,
        aux_lem_band_U2_CellOK (chaosSampleLaw M).toMeasure w' a c C γ M.delta q k
          (fun omega =>
            Homogenization.Book.Ch02.sigmaStarInvCoarse (Homogenization.Book.Ch02.cubeDomain R)
              ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) i j) (if i = j then (1 : ℝ) else 0) ∧
        aux_lem_band_U2_CellOK (chaosSampleLaw M).toMeasure w' a c C γ M.delta q k
          (fun omega =>
            Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain R)
              ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) i j) (if i = j then (1 : ℝ) else 0) := by
  classical
  obtain ⟨CE, hCE, hEnv⟩ := aux_lem_band_fine_log_envelope d hd 0 1 one_pos
  obtain ⟨A, hA, hTail⟩ := aux_lem_band_fine_infrared_tail_orlicz (d := d) 1 one_pos
  refine ⟨1, 1, one_pos, one_pos, 1, Nat.zero_lt_one, ?_⟩
  intro γ hγ q hq
  obtain ⟨delta0, B, hδ0, hB, hδ01, hGrowth⟩ := aux_lem_band_fine_growth_moments CE γ q hCE hγ hq
  obtain ⟨CT, hCT, hTM⟩ := aux_lem_band_fine_tail_moment A (2*q) hA (by linarith)
  refine ⟨delta0, 504*B+28728*B*CT, hδ0, by positivity, ?_⟩
  intro M hMd Rm _ Sreg It H hH K k hKk R hR i j
  have hδ := M.shellPrefix.delta_pos
  have hδ1 : M.delta ≤ 1 := hMd.trans hδ01
  obtain ⟨V, hVm, hV0, hVbound, hVint⟩ := hEnv M Rm H hH
  have hGM := hGrowth (chaosSampleLaw M).toMeasure (V K) (hVm K) (hV0 K)
    M.delta hδ hMd K (hVint K).1 (hVint K).2
  have hRsub := aux_lem_band_U2_desc_sub k R hR
  let Qc : Compacts (SpatialCoordinates d) := closedCube 0 1 one_pos
  let : MeasurableSpace C(Qc, ℝ) := borel _
  let : BorelSpace C(Qc, ℝ) := ⟨rfl⟩
  have hQc : ∀ x ∈ (Qc : Set (SpatialCoordinates d)), ‖x‖ ≤ (1:ℝ) := by
    intro x hx
    have hh : dist x (0 : SpatialCoordinates d) ≤ (1:ℝ)/2 := hx
    rw [dist_zero_right] at hh
    linarith
  let T : ℕ → BilateralField d → ℝ := fun n o =>
    ‖(H o-infraredPartialSum o (n+1)).restrict (Qc : Set (SpatialCoordinates d))‖
  have hTm n : Measurable (T n) := by
    exact ((ContinuousMap.continuous_restrict (Qc : Set (SpatialCoordinates d))).measurable.comp
      (hH.1.sub (aux_lem_band_fine_partial_meas (n+1)))).norm
  have hT0 n o : 0 ≤ T n o := norm_nonneg _
  let U : BilateralField d → ℝ := fun o => Real.exp (2*(V K o+M.delta))
  have hUm : Measurable U := (measurable_const.mul ((hVm K).add_const _)).exp
  let F : Bool → (BilateralField d → C(SpatialCoordinates d, ℝ)) → BilateralField d → ℝ :=
    fun b H0 o => if b then
      Ch02.sigmaStarInvCoarse (Ch02.cubeDomain R) ((aux_lem_band_U2_unitChart I M H0 o K).coeffOn R) i j
    else Ch02.sigmaCoarse (Ch02.cubeDomain R) ((aux_lem_band_U2_unitChart I M H0 o K).coeffOn R) i j
  let x0 : ℝ := if i=j then 1 else 0
  have hFm (b : Bool) : Measurable (F b H) := by
    have hh := aux_lem_band_fine_chart_meas hd I M H hH.1 K R hRsub i j
    cases b
    · exact hh.2
    · exact hh.1
  have hFBm (b : Bool) (h : ℕ) (hkh : k ≤ h) :
      Measurable[aux_lem_band_U2_band d (-((h+1:ℕ):ℤ)) ((h+1:ℕ):ℤ)]
        (F b (fun o => infraredPartialSum o (h+1))) := by
    have hh := aux_lem_band_fine_truncated_chart_band_meas hd I M K h (by omega) R hRsub i j
    cases b
    · exact hh.2
    · exact hh.1
  have hVstrict o : 0 < V K o+M.delta := add_pos_of_nonneg_of_pos (hV0 K o) hδ
  have hbase (b : Bool) : eLpNorm (fun o => F b H o-x0) (ENNReal.ofReal q)
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal ((504*B)*M.delta*(3:ℝ)^(γ*(K:ℝ))) := by
    have hp : ∀ᵐ o ∂(chaosSampleLaw M).toMeasure,
        |F b H o-x0| ≤ 504*(Real.exp (2*(V K o+M.delta))-1) := by
      filter_upwards [hVbound] with o ho
      have hh := aux_lem_band_fine_chart_baseline I M H o K R hRsub _ (hVstrict o)
        (fun x hx => (ho K x hx).trans (le_add_of_nonneg_right hδ.le)) i j
      cases b
      · exact hh.2.1
      · exact hh.1
    have hh := aux_lem_band_fine_domination (chaosSampleLaw M).toMeasure q 504
      (B*M.delta*(3:ℝ)^(γ*(K:ℝ))) (by norm_num) (fun o => F b H o-x0)
      (fun o => Real.exp (2*(V K o+M.delta))-1)
      (fun o => sub_nonneg.mpr (Real.one_le_exp (by linarith [hVstrict o]))) hp
        ((SubdiffusiveProcess.RawLp.eLpNorm_le_guarded _ _ _).trans hGM.2)
    erw [SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded
      ((hFm b).aestronglyMeasurable.sub (aestronglyMeasurable_const (b := x0)))] at hh
    convert! hh using 1 ; congr 1 ; ring
  have hdiff (b : Bool) (h : ℕ) (hkh : k ≤ h) :
      eLpNorm (fun o => F b H o-F b (fun o => infraredPartialSum o (h+1)) o)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal ((28728*B*CT)*M.delta*(3:ℝ)^(γ*(K:ℝ))*(1/3:ℝ)^(h+1)) := by
    let s : ℝ := M.delta*(1/3:ℝ)^(h+1)
    have hs : 0 < s := by dsimp [s]; positivity
    have hs1 : s ≤ 1 := by
      have hr : (1/3:ℝ)^(h+1) ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
      dsimp [s]
      exact (mul_le_mul_of_nonneg_left hr hδ.le).trans (by simpa using hδ1)
    have hg : (∫⁻ o, ENNReal.ofReal (Real.exp ((T h o/(A*s))^2)) ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
      have hh := hTail M H hH Qc hQc (h+1)
      simpa only [T, s, mul_assoc] using hh
    have hZn := hTM (chaosSampleLaw M).toMeasure (T h) (hTm h) (hT0 h) s hs hs1 hg
    let Z : BilateralField d → ℝ := fun o => Real.exp (2*(T h o+s))-1
