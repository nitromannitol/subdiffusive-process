theorem aux_lem_band_U2N_qv_pos {d : ℕ} (i j : Fin d) :
    (0 : ℝ) < ∑ k, (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ) : Fin d → ℝ) k ^ 2 := by
  have h1 : (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ) : Fin d → ℝ) i ^ 2 ≤
      ∑ k, (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ) : Fin d → ℝ) k ^ 2 :=
    Finset.single_le_sum (fun k _ => sq_nonneg _) (Finset.mem_univ i)
  have h2 : (0 : ℝ) < (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ) : Fin d → ℝ) i ^ 2 := by
    simp only [Pi.add_apply, Pi.single_apply]
    split_ifs <;> norm_num
  linarith

theorem aux_lem_band_U2N_qv_le_four {d : ℕ} (i j : Fin d) :
    ∑ k, (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ) : Fin d → ℝ) k ^ 2 ≤ 4 := by
  have hsq1 : ∀ a : Fin d, ∑ k, ((Pi.single a (1 : ℝ) : Fin d → ℝ) k) ^ 2 = (1 : ℝ) := by
    intro a
    rw [Finset.sum_eq_single a]
    · simp
    · intro k _ hk; simp [hk]
    · intro h; exact absurd (Finset.mem_univ a) h
  have hb : ∀ k : Fin d, (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ) : Fin d → ℝ) k ^ 2 ≤
      2 * ((Pi.single i (1 : ℝ) : Fin d → ℝ) k) ^ 2 +
        2 * ((Pi.single j (1 : ℝ) : Fin d → ℝ) k) ^ 2 := by
    intro k
    simp only [Pi.add_apply]
    nlinarith [sq_nonneg ((Pi.single i (1 : ℝ) : Fin d → ℝ) k -
      (Pi.single j (1 : ℝ) : Fin d → ℝ) k)]
  calc ∑ k, (Pi.single i (1 : ℝ) + Pi.single j (1 : ℝ) : Fin d → ℝ) k ^ 2
      ≤ ∑ k, (2 * ((Pi.single i (1 : ℝ) : Fin d → ℝ) k) ^ 2 +
          2 * ((Pi.single j (1 : ℝ) : Fin d → ℝ) k) ^ 2) :=
        Finset.sum_le_sum (fun k _ => hb k)
    _ = 2 * (∑ k, ((Pi.single i (1 : ℝ) : Fin d → ℝ) k) ^ 2) +
        2 * (∑ k, ((Pi.single j (1 : ℝ) : Fin d → ℝ) k) ^ 2) := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ = 4 := by rw [hsq1, hsq1]; norm_num

