variable {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
theorem aux_lem_band_fine_envelope_budget (d Q1 : ℕ) (CH Cval E0 u0 u1 : ℝ)
    (hCH : 0 ≤ CH) (hE0 : 0 ≤ E0)
    (hu1 : u1 = (d:ℝ)*Real.log 3+Cval^2/4+(9/16)*E0)
    (hu0 : u0 = 3*Real.log 2+CH/4+(d:ℝ)*((Q1:ℝ)+2)*Real.log 3+Cval^2/4+(9/16)*E0) :
    0 ≤ u0 ∧ 0 ≤ u1 ∧
    Real.log 2+CH/4 ≤ u0 ∧
    Real.log 2+(d:ℝ)*((Q1:ℝ)+2)*Real.log 3+Cval^2/4 ≤ u0 ∧
    (d:ℝ)*Real.log 3+Cval^2/4 ≤ u1 ∧
    Real.log 2+(9/16)*E0 ≤ u0 ∧ (9/16)*E0 ≤ u1 := by
  have hlog2 : (0:ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlog3 : (0:ℝ) < Real.log 3 := Real.log_pos (by norm_num)
  have hu1nn : 0 ≤ u1 := by
    rw [hu1]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    linarith
  have hu0nn : 0 ≤ u0 := by
    rw [hu0]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    have h4 : (0 : ℝ) ≤ CH / 4 := by linarith [hCH]
    linarith
  have hu0a : Real.log 2 + CH / 4 ≤ u0 := by
    rw [hu0]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    linarith
  have hu0b : Real.log 2 + (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 + Cval ^ 2 / 4 ≤ u0 := by
    rw [hu0]
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    have h4 : (0 : ℝ) ≤ CH / 4 := by linarith [hCH]
    linarith
  have hu1b : (d : ℝ) * Real.log 3 + Cval ^ 2 / 4 ≤ u1 := by
    rw [hu1]
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    linarith
  have hu0c : Real.log 2 + (9 / 16) * E0 ≤ u0 := by
    rw [hu0]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h4 : (0 : ℝ) ≤ CH / 4 := by linarith [hCH]
    linarith
  have hu1c : (9 / 16) * E0 ≤ u1 := by
    rw [hu1]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    linarith
  exact ⟨hu0nn, hu1nn, hu0a, hu0b, hu1b, hu0c, hu1c⟩

theorem aux_lem_band_fine_envelope_exponent (delta tau u0 u1 : ℝ) (N : ℕ)
    (hd : 0 < delta) (hd1 : delta ≤ 1/2) (htau : tau ≤ delta^2)
    (hu0 : 0 ≤ u0) (hu1 : 0 ≤ u1) :
    (1/(4*delta)) * (2*((N:ℝ)+1)*tau + 4*delta*(Real.log 3+u0+u1*(N:ℝ))) ≤
      (1+Real.log 3+u0+u1)*((N:ℝ)+1) := by
  have hn : 0 ≤ (N:ℝ) := Nat.cast_nonneg N
  have hlog3 : (0:ℝ) < Real.log 3 := Real.log_pos (by norm_num)
  have he : (1/(4*delta)) * (2*((N:ℝ)+1)*delta^2 + 4*delta*(Real.log 3+u0+u1*(N:ℝ))) =
      ((N:ℝ)+1)*delta/2 + (Real.log 3+u0+u1*(N:ℝ)) := by
    field_simp
    ring
  calc _ ≤ (1/(4*delta))*(2*((N:ℝ)+1)*delta^2+4*delta*(Real.log 3+u0+u1*(N:ℝ))) := by
        exact mul_le_mul_of_nonneg_left
          (add_le_add (mul_le_mul_of_nonneg_left htau (by positivity)) le_rfl) (by positivity)
    _ = _ := he
    _ ≤ _ := by nlinarith [mul_nonneg hu0 hn, mul_nonneg hlog3.le hn]

theorem aux_lem_band_fine_log_envelope
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) :
    ∃ C : ℝ, 0 < C ∧ ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (_Rm : in_responses d M)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∃ V : ℕ → BilateralField d → ℝ,
        (∀ N, Measurable (V N)) ∧ (∀ N o, 0 ≤ V N o) ∧
        (∀ᵐ o ∂(chaosSampleLaw M).toMeasure, ∀ N x,
          x ∈ (closedCube z r hr : Set (SpatialCoordinates d)) →
          |Real.log (cutoffCoefficient M H o N x)| ≤ V N o) ∧
        ∀ N, Integrable (fun o => Real.exp (V N o / (4*M.delta))) (chaosSampleLaw M).toMeasure ∧
          (∫ o, Real.exp (V N o / (4*M.delta)) ∂(chaosSampleLaw M).toMeasure) ≤
            Real.exp (C*((N:ℝ)+1)) := by
  classical
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlog3 : (0 : ℝ) < Real.log 3 := Real.log_pos (by norm_num)
  have hr4 : (0 : ℝ) < r + 4 := by linarith
  set K : Compacts (SpatialCoordinates d) := closedCube z (r + 4) hr4 with hKdef
  set Bnd : ℝ := ‖z‖ + (r + 4) / 2 with hBnd
  have hKnorm : ∀ x : K, ‖(x : SpatialCoordinates d)‖ ≤ Bnd := by
    intro x
    have hx : dist (x : SpatialCoordinates d) z ≤ (r + 4) / 2 := x.2
    have hx' : ‖(x : SpatialCoordinates d) - z‖ ≤ (r + 4) / 2 := by
      rwa [dist_eq_norm] at hx
    calc ‖(x : SpatialCoordinates d)‖ = ‖z + ((x : SpatialCoordinates d) - z)‖ := by
          rw [add_sub_cancel]
      _ ≤ ‖z‖ + ‖(x : SpatialCoordinates d) - z‖ := norm_add_le _ _
      _ ≤ Bnd := by rw [hBnd]; linarith
  obtain ⟨Q1, hQ1⟩ := aux_finite_cutoff_log_abs_majorant_exists_pow_half (‖z‖ + r / 2)
  obtain ⟨CHf, hCHf0, hCHfb⟩ :=
    exists_uniform_compactExponentialMoment_of_infraredCharacterization hd
  obtain ⟨Vr, hVrmeas, hVr0, hVrdom, hVrle, hVrset⟩ :=
    aux_finite_negative_layer_log_lipschitz_majorant_continuous_ratio K
  obtain ⟨Q0, hQ0⟩ := aux_finite_cutoff_log_abs_majorant_exists_pow Bnd
  set Cval : ℝ := 6 * Homogenization.Book.Ch04.gammaSigmaIndependentSumConst 2 *
    ((1 + Real.log 2) ^ (2 : ℝ)⁻¹) with hCval
  set E0 : ℝ := 5 * (1 + Real.log 2 + (d : ℝ) * ((Q0 : ℝ) + 3) * Real.log 3) with hE0
  have hE0pos : 0 < E0 := by
    rw [hE0]
    have h : (0 : ℝ) ≤ (d : ℝ) * ((Q0 : ℝ) + 3) * Real.log 3 := by positivity
    linarith
  set u1 : ℝ := (d : ℝ) * Real.log 3 + Cval ^ 2 / 4 + (9 / 16) * E0 with hu1
  set u0 : ℝ := 3 * Real.log 2 + CHf K / 4 + (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 +
    Cval ^ 2 / 4 + (9 / 16) * E0 with hu0
  obtain ⟨hu0nn, hu1nn, hu0a, hu0b, hu1b, hu0c, hu1c⟩ :=
    aux_lem_band_fine_envelope_budget d Q1 (CHf K) Cval E0 u0 u1 (hCHf0 K) hE0pos.le hu1 hu0
  let C : ℝ := 1 + Real.log 3 + u0 + u1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro M Rm H hH
  have hdelta : 0 < M.delta := M.shellPrefix.delta_pos
  have hdhalf : M.delta ≤ 1/2 := M.shellPrefix.delta_le_half
  set t : ℝ := 1 / (4*M.delta) with ht
  set gpt : ℕ → (Fin d → ℤ) → SpatialCoordinates d := fun N q =>
    (3 : ℝ) ^ (-(N : ℤ)) • SubdiffusiveProcess.CoarseGrainingVocab.shellCoverCenter q with hgpt
  set Amax : ℕ → BilateralField d → ℝ := fun N om =>
    (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts d ((N : ℤ) + (Q1 : ℤ))).sup'
      (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ)))
      (fun q => |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|) with hAmax
  set Aosc : ℕ → BilateralField d → ℝ := fun N om =>
    (3 : ℝ) ^ (-(N : ℤ)) * ∑ j ∈ Finset.range (N + 1), Vr (om (-(Int.ofNat j))) with hAosc
  set Ah : BilateralField d → ℝ := fun om =>
    ‖(H om).restrict (K : Set (SpatialCoordinates d))‖ with hAh
  set VV : ℕ → BilateralField d → ℝ := fun N om =>
    2 * ((N : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P + Ah om + Amax N om + Aosc N om with hVV
                  
  have hevmeas : ∀ (j : ℤ) (y : SpatialCoordinates d),
      Measurable (fun om : BilateralField d => om j y) := by
    intro j y
    exact ((continuous_eval_const y).measurable).comp (measurable_pi_apply j)
  have hAhmeas : Measurable Ah :=
    aux_finite_cutoff_log_abs_majorant_restrict_measurable K H hH.1
  have hAmaxmeas : ∀ N, Measurable (Amax N) := by
    intro N
    have h0 : Measurable
        ((SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts d ((N : ℤ) + (Q1 : ℤ))).sup'
          (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ)))
          (fun q (om : BilateralField d) =>
            |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|)) := by
      refine Finset.measurable_sup' _ (fun q _ => ?_)
      exact (Finset.measurable_sum _ (fun j _ => hevmeas (-(Int.ofNat j)) (gpt N q))).abs
    have h1 : ((SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts d ((N : ℤ) + (Q1 : ℤ))).sup'
        (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ)))
        (fun q (om : BilateralField d) =>
          |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|)) = Amax N := by
      funext om
      exact Finset.sup'_apply _ _ om
    rwa [h1] at h0
  have hAoscmeas : ∀ N, Measurable (Aosc N) := by
    intro N
    refine measurable_const.mul (Finset.measurable_sum _ (fun j _ => ?_))
    exact hVrmeas.comp (measurable_pi_apply _)
  have hVVmeas : ∀ N, Measurable (VV N) := by
    intro N
    exact ((measurable_const.add hAhmeas).add (hAmaxmeas N)).add (hAoscmeas N)
  have hAmax0 : ∀ N om, 0 ≤ Amax N om := by
    intro N om
    obtain ⟨q, hq⟩ := SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ))
    exact le_trans (abs_nonneg _) (Finset.le_sup' (f := fun q =>
      |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|) hq)
  have hAosc0 : ∀ N om, 0 ≤ Aosc N om := by
    intro N om
    rw [hAosc]
    exact mul_nonneg (by positivity) (Finset.sum_nonneg (fun j _ => hVr0 _))
  have hVV0 : ∀ N om, 0 ≤ VV N om := by
    intro N om
    have htau : 0 ≤ _root_.SubdiffusiveProcess.Model.tauSq M.P := M.G4.tauSq_pos.le
    have h1 : 0 ≤ 2 * ((N : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P := by positivity
    have h2 : 0 ≤ Ah om := norm_nonneg _
    have := hAmax0 N om
    have := hAosc0 N om
    rw [hVV]
    simp only
    linarith
  set cN : ℕ → ℝ := fun N => 2 * ((N : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P +
    4 * M.delta * (Real.log 3 + u0 + u1 * (N : ℝ)) with hcN
  have hkey : ∀ N : ℕ,
      Integrable (fun om => Real.exp (t * VV N om)) (chaosSampleLaw M).toMeasure ∧
      (∫ om, Real.exp (t * VV N om) ∂(chaosSampleLaw M).toMeasure) ≤
        Real.exp (t * cN N) := by
    intro N
    exact aux_finite_cutoff_log_abs_majorant_moment M H K Bnd hKnorm Q0 Q1 hQ0 Vr hVr0 hVrle
      (CHf K) (hCHf0 K) (fun lam hlam => hCHfb M H hH K lam hlam) Cval E0 u0 u1 t
      hCval hE0 hu1nn hu0a hu0b hu1b hu0c hu1c ht Ah (fun om => rfl) hAhmeas
      Amax (fun N om => rfl) hAmaxmeas Aosc (fun N om => rfl) hAoscmeas N
  have hKcontains : ∀ u : SpatialCoordinates d, dist u z ≤ r / 2 + 1 →
      u ∈ (K : Set (SpatialCoordinates d)) := by
    intro u hu
    show dist u z ≤ (r + 4) / 2
    linarith
  refine ⟨VV, hVVmeas, hVV0, ?_, ?_⟩
  · exact aux_finite_cutoff_log_abs_majorant_envelope M Rm H z r hr K Bnd hKnorm
      hKcontains Q1 hQ1 Vr hVr0 hVrdom hVrset Ah (fun om => rfl) Amax (fun N om => rfl)
      Aosc (fun N om => rfl)
  · intro N
    have hh := hkey N
    have htau : _root_.SubdiffusiveProcess.Model.tauSq M.P ≤ M.delta^2 := by
      have hb := SubdiffusiveProcess.CoarseGrainingVocab.tauSq_le_delta_sq M
      have hl := Real.log_le_sub_one_of_pos (show (0:ℝ)<2 by norm_num)
      nlinarith [sq_nonneg M.delta]
    have hcNb : t * cN N ≤ C*((N:ℝ)+1) := by
      exact aux_lem_band_fine_envelope_exponent M.delta (_root_.SubdiffusiveProcess.Model.tauSq M.P)
        u0 u1 N hdelta hdhalf htau hu0nn hu1nn
    have he : (fun o => Real.exp (t*VV N o)) =
        (fun o => Real.exp (VV N o/(4*M.delta))) := by
      funext o
      congr 1
      rw [ht]
      ring
    refine ⟨?_, ?_⟩
    · rw [← he]; exact hh.1
    · rw [← he]; exact hh.2.trans (Real.exp_le_exp.mpr hcNb)

noncomputable def aux_lem_band_fine_layer {d : ℕ}
    (K : Compacts (SpatialCoordinates d)) (n : ℕ) (o : BilateralField d) : C(K, ℝ) :=
  (o ((n+1:ℕ):ℤ)).restrict (K : Set (SpatialCoordinates d)) -
    ContinuousMap.const K (o ((n+1:ℕ):ℤ) 0)

theorem aux_lem_band_fine_layer_orlicz {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (R : ℝ) (hR : 0 < R) :
    ∃ A : ℝ, 0 < A ∧ ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
      (K : Compacts (SpatialCoordinates d)),
      (∀ x ∈ (K : Set (SpatialCoordinates d)), ‖x‖ ≤ R) → ∀ n : ℕ,
      (∫⁻ o, ENNReal.ofReal (Real.exp
        ((‖aux_lem_band_fine_layer K n o‖ /
          (A*M.delta*(1/3:ℝ)^n))^2)) ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨m, hm, hroot⟩ := exists_gmc_anchored_contraction_exp_square (d := d) R hR
  refine ⟨R*(m:ℝ)/3, by positivity, ?_⟩
  intro M K hK n
  let : MeasurableSpace C(K, ℝ) := borel _
  let : BorelSpace C(K, ℝ) := ⟨rfl⟩
  let i : ℤ := ((n+1:ℕ):ℤ)
  let c : ℝ := (3:ℝ)^(-i)
  have hc0 : 0 < c := by dsimp [c]; positivity
  have hc1 : c ≤ 1 := by
    dsimp [c]
    calc (3:ℝ)^(-i) ≤ (3:ℝ)^(0:ℤ) :=
        zpow_le_zpow_right₀ (by norm_num) (by dsimp [i]; omega)
      _ = 1 := zpow_zero _
  have hscale : c*R*((m:ℝ)*M.delta) = R*(m:ℝ)/3*M.delta*(1/3:ℝ)^n := by
    dsimp [c, i]
    rw [_root_.zpow_neg, zpow_add₀ (by norm_num : (3:ℝ) ≠ 0), zpow_one,
      _root_.mul_inv_rev, zpow_natCast, ← inv_pow]
    ring
  let G : C(SpatialCoordinates d, ℝ) → ℝ≥0∞ := fun f =>
    ENNReal.ofReal (Real.exp ((‖f.restrict (K : Set (SpatialCoordinates d)) -
      ContinuousMap.const K (f 0)‖/(c*R*((m:ℝ)*M.delta)))^2))
  have hG : Measurable G := by
    apply ENNReal.measurable_ofReal.comp
    apply Real.measurable_exp.comp
    apply Measurable.pow_const
    apply Measurable.div_const
    exact ((ContinuousMap.continuous_restrict (K : Set (SpatialCoordinates d))).measurable.sub
      (ContinuousMap.continuous_const'.measurable.comp (continuous_eval_const (0:SpatialCoordinates d)).measurable)).norm
  let laws : ℤ → Measure C(SpatialCoordinates d, ℝ) := fun j =>
    (scaledLayerLaw d (chaosRootFieldLaw M) j).toMeasure
  have heval : (∫⁻ o : BilateralField d, G (o i) ∂(chaosSampleLaw M).toMeasure) =
      ∫⁻ f, G f ∂(laws i) :=
    (measurePreserving_eval_infinitePi laws i).lintegral_comp hG
  have hmap : (∫⁻ f, G f ∂(laws i)) =
      ∫⁻ f, G (layerScaling d i f) ∂(chaosRootFieldLaw M).toMeasure := by
    dsimp [laws]
    simp only [scaledLayerLaw, ProbabilityMeasure.toMeasure_map]
    exact lintegral_map hG (layerScaling d i).continuous.measurable
  have hh := hroot M K hK c hc0 hc1
  have heq f : G (layerScaling d i f) = ENNReal.ofReal (Real.exp
      ((‖(f.comp (⟨fun x : SpatialCoordinates d => c • x,
          (by fun_prop)⟩ : C(SpatialCoordinates d, SpatialCoordinates d))).restrict
            (K : Set (SpatialCoordinates d)) - ContinuousMap.const K (f 0)‖ /
          (c*R*((m:ℝ)*M.delta)))^2)) := by
    dsimp [G, layerScaling, c]
    simp only [ContinuousMap.compRightContinuousMap, ContinuousMap.coe_mk, ContinuousMap.comp_apply, smul_zero]
  rw [show (fun o => ENNReal.ofReal (Real.exp ((‖aux_lem_band_fine_layer K n o‖ /
      (R*(m:ℝ)/3*M.delta*(1/3:ℝ)^n))^2))) = (fun o => G (o i)) by
        funext o; dsimp [G, aux_lem_band_fine_layer, i]; rw [hscale]]
  rw [heval, hmap]
  simp_rw [heq]
  exact hh

theorem aux_lem_band_fine_series_orlicz {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [CompleteSpace E] [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (F : ℕ → Ω → E) (hFm : ∀ n, Measurable (F n))
    (A : ℝ) (hA : 0 < A)
    (hb : ∀ n, (∫⁻ o, ENNReal.ofReal (Real.exp
      ((‖F n o‖/(A*(1/3:ℝ)^n))^2)) ∂μ) ≤ 2) :
    (∀ᵐ o ∂μ, Summable (fun n => ‖F n o‖)) ∧
    ∀ h : ℕ, (∫⁻ o, ENNReal.ofReal (Real.exp
      ((‖∑' n, F (n+h) o‖ / ((3/2:ℝ)*A*(1/3:ℝ)^h))^2)) ∂μ) ≤ 2 := by
  obtain ⟨C, hC, hLp⟩ := exists_universal_orlicz_eLpNorm_constant
  have hnorm n : eLpNorm (F n) (2:ℝ≥0∞) μ ≤
      ENNReal.ofReal ((C*A*Real.sqrt 2)*(1/3:ℝ)^n) := by
    have hh := hLp μ (fun o => ‖F n o‖) (A*(1/3:ℝ)^n)
      (hFm n).norm (fun _ => norm_nonneg _) (by positivity) (hb n) 2 (by norm_num) le_rfl
    rw [eLpNorm_norm _ (hFm n).aestronglyMeasurable] at hh
    simpa only [ENNReal.toReal_ofNat, mul_assoc, mul_left_comm, mul_comm] using hh
  have hmem n : MemLp (F n) (2:ℝ≥0∞) μ :=
    (hnorm n).trans_lt ENNReal.ofReal_lt_top
  have hs := (memLp_geometric_tsum_tails μ (by norm_num : (1:ℝ≥0∞)≤2)
    (by norm_num) F hmem (by positivity : 0≤C*A*Real.sqrt 2)
    (by norm_num) (by norm_num) hnorm).1
  refine ⟨hs, ?_⟩
  intro h
  let a : ℕ → ℝ := fun n => A*(1/3:ℝ)^(n+h)
  have ha n : 0 < a n := by dsimp [a]; positivity
  have hseq : a = fun n => (A*(1/3:ℝ)^h)*(1/3:ℝ)^n := by
    funext n
    dsimp [a]
    rw [pow_add]
    ring
  have hsum : Summable a := by
    rw [hseq]
    exact (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left _
  have ht : (∑' n, a n) = (3/2:ℝ)*A*(1/3:ℝ)^h := by
    rw [hseq, tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    ring
  have hs' : ∀ᵐ o ∂μ, Summable (fun n => ‖F (n+h) o‖) :=
    hs.mono fun o ho => ho.comp_injective (fun _ _ he => Nat.add_right_cancel he)
  have hh := lintegral_exp_sq_norm_tsum_le μ (fun n o => F (n+h) o)
    (fun n => (hFm (n+h)).aestronglyMeasurable) a ha hsum hs' (fun n => hb (n+h))
  rwa [ht] at hh

