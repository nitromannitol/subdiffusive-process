      (fun R => Homogenization.Book.Ch02.coarseBMatrixNorm R F) =
      c * (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
        (fun R => Homogenization.Book.Ch02.coarseBMatrixNorm R G) := by
    intro n
    rw [Finset.sup'_congr (aux_lem_band_U2_D_nonempty n) rfl (fun R hR => hcell n R hR)]
    exact (Finset.mul₀_sup' hc.le _ _ _).symm
  rw [aux_lem_band_U2_LamF_eq, aux_lem_band_U2_LamF_eq, ← tsum_mul_left]
  refine tsum_congr (fun n => ?_)
  rw [hsup n]; ring

theorem aux_lem_band_U2_sigF_scaled {d : ℕ} (c : ℝ) (hc : 0 < c)
    (G F : Homogenization.Book.Ch02.TriadicCoeffFamily d) (h : aux_lem_band_U2_Scaled c G F)
