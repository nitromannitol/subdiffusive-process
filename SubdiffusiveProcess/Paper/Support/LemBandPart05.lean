theorem aux_lem_band_U2_lamF_scaled {d : ℕ} (sigma : ℝ) (c : ℝ) (hc : 0 < c)
    (G F : Homogenization.Book.Ch02.TriadicCoeffFamily d) (h : aux_lem_band_U2_Scaled c G F) :
    aux_lem_band_U2_lamF sigma F = c * aux_lem_band_U2_lamF sigma G := by
  have hcell : ∀ n (R : Homogenization.TriadicCube d), R ∈ aux_lem_band_U2_D (d := d) n →
      Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R F =
        c⁻¹ * Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R G := by
    intro n R hR
    unfold Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm
    rw [aux_lem_band_U2_sigmaStarInvCoarse_scaled c hc _ _ (h R (aux_lem_band_U2_desc_sub n R hR)),
      aux_lem_band_U2_matrixNorm_smul, abs_of_pos (inv_pos.mpr hc)]
  have hsup : ∀ n, (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
      (fun R => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R F) =
      c⁻¹ * (aux_lem_band_U2_D (d := d) n).sup' (aux_lem_band_U2_D_nonempty n)
        (fun R => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm R G) := by
    intro n
    rw [Finset.sup'_congr (aux_lem_band_U2_D_nonempty n) rfl (fun R hR => hcell n R hR)]
    exact (Finset.mul₀_sup' (inv_pos.mpr hc).le _ _ _).symm
  have hinv : (aux_lem_band_U2_lamF sigma F)⁻¹ = c⁻¹ * (aux_lem_band_U2_lamF sigma G)⁻¹ := by
    rw [aux_lem_band_U2_lamF_inv_eq, aux_lem_band_U2_lamF_inv_eq, ← tsum_mul_left]
    refine tsum_congr (fun n => ?_)
    rw [hsup n]; ring
  calc aux_lem_band_U2_lamF sigma F = ((aux_lem_band_U2_lamF sigma F)⁻¹)⁻¹ := (inv_inv _).symm
    _ = (c⁻¹ * (aux_lem_band_U2_lamF sigma G)⁻¹)⁻¹ := by rw [hinv]
    _ = c * aux_lem_band_U2_lamF sigma G := by rw [mul_inv, inv_inv, inv_inv]

theorem aux_lem_band_U2_LamF_scaled {d : ℕ} (sigma : ℝ) (c : ℝ) (hc : 0 < c)
    (G F : Homogenization.Book.Ch02.TriadicCoeffFamily d) (h : aux_lem_band_U2_Scaled c G F) :
    aux_lem_band_U2_LamF sigma F = c * aux_lem_band_U2_LamF sigma G := by
  have hcell : ∀ n (R : Homogenization.TriadicCube d), R ∈ aux_lem_band_U2_D (d := d) n →
      Homogenization.Book.Ch02.coarseBMatrixNorm R F =
        c * Homogenization.Book.Ch02.coarseBMatrixNorm R G := by
    intro n R hR
    unfold Homogenization.Book.Ch02.coarseBMatrixNorm
