      (fun o => Ch02.sigmaCoarse (Ch02.cubeDomain R)
        ((aux_lem_band_U2_unitChart I M (fun x => infraredPartialSum x (h+1)) o N).coeffOn R) i j) := by
  have hm := aux_lem_band_fine_chart_meas hd I M _ (aux_lem_band_fine_partial_meas (h+1)) N R hR i j
