theorem aux_lem_band_U2_sigStarInvF_eq_resp {d : ℕ} (F : Homogenization.Book.Ch02.TriadicCoeffFamily d)
    (i j : Fin d) :
    aux_lem_band_U2_sigStarInvF i j F =
      if i = j then (1 / 2 : ℝ) * aux_lem_band_U2_JN F i i
      else aux_lem_band_U2_JN F i j - (1 / 4 : ℝ) * aux_lem_band_U2_JN F i i - (1 / 4 : ℝ) * aux_lem_band_U2_JN F j j := by
