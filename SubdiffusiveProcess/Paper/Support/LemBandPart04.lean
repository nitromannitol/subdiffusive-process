          (1 - (3 : ℝ) ^ (-s)) * CqF p * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s))) :=
      heLpNorm_final.trans (heLpNorm_le.trans hBoundQ)
    have hmono := aux_lem_band_L1c_Cbound_mono s (CdF p) (Qf p) (CqF p) (CqF p) M.delta (delta0 p)
      hs0 (hCdFpos p).le (hQfpos p).le (hCqFpos p).le le_rfl hMdelta_nn hMdelta (hcondA0 p hp1)
    refine ⟨(htight.trans (ENNReal.ofReal_le_ofReal hmono)).trans_lt ENNReal.ofReal_lt_top, htight.trans (ENNReal.ofReal_le_ofReal hmono)⟩

