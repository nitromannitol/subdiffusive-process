  obtain ⟨hδC, hα, hκ0κ⟩ := hthr M' (aux_prop_growth_macro_energy_nativeSreg M') hδ'
  obtain ⟨H', hH'⟩ := exists_infraredCharacterization hd M'
  obtain ⟨Lm, hLm, hLpre, hLb⟩ := aux_lem_band_mac4_lmac_moment_uniform M'
    (aux_prop_growth_macro_energy_nativeSreg M') t (2 * q) κ0 ht0 (by linarith)
    hδC hα hκ0lam hκ0κ (r⁻¹ • z)
  have hLb' : ∀ n, eLpNorm (fun o => (3 : ℝ) ^ (t * (Lm n o : ℝ)))
      (ENNReal.ofReal (2 * (2 * q))) (chaosSampleLaw M').toMeasure ≤ BX := by
