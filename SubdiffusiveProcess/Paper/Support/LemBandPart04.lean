      (1 - (3 : ℝ) ^ (-s)) * Cq1 * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s)) ≤
    (1 - (3 : ℝ) ^ (-s)) * Cq2 /
        (1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2)) +
      (1 - (3 : ℝ) ^ (-s)) * Cq2 * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s)) := by
  have hsq : δ1 ^ 2 ≤ δ2 ^ 2 := pow_le_pow_left₀ hδ1 hle 2
  have hQ2nn : 0 ≤ Qfp + Qfp ^ 2 := by positivity
  have hcondA1 : CdFp * (Qfp + Qfp ^ 2) * δ1 ^ 2 ≤ (s / 4) * Real.log 3 := by
    have hmono : CdFp * (Qfp + Qfp ^ 2) * δ1 ^ 2 ≤ CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2 :=
      mul_le_mul_of_nonneg_left hsq (by positivity)
    linarith
  have h1lt : (3 : ℝ) ^ (-s) < 1 := aux_lane4_lambda_inv_moments_ratio_lt_one s hs0
  have hbase1 : (0:ℝ) < 1 - (3 : ℝ) ^ (-s) := by linarith
  have hlog3 : (0:ℝ) < Real.log 3 := Real.log_pos (by norm_num)
  have hexpneg : (s / 4) * Real.log 3 - (s / 2) * Real.log 3 < 0 := by nlinarith
  have hbound : Real.exp ((s / 4) * Real.log 3 - (s / 2) * Real.log 3) < 1 := by
    have h := Real.exp_lt_exp.mpr hexpneg
    rwa [Real.exp_zero] at h
  have hexp1 : Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ1 ^ 2) ≤
      Real.exp ((s / 4) * Real.log 3 - (s / 2) * Real.log 3) :=
    Real.exp_le_exp.mpr (by linarith)
  have hexp2 : Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2) ≤
      Real.exp ((s / 4) * Real.log 3 - (s / 2) * Real.log 3) :=
    Real.exp_le_exp.mpr (by linarith)
  have hden1pos : (0:ℝ) < 1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ1 ^ 2) := by
    linarith [hexp1.trans_lt hbound]
  have hden2pos : (0:ℝ) < 1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2) := by
    linarith [hexp2.trans_lt hbound]
  have hdenle : 1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2) ≤
      1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ1 ^ 2) := by
    gcongr
  have hterm1 : (1 - (3 : ℝ) ^ (-s)) * Cq1 /
      (1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ1 ^ 2)) ≤
      (1 - (3 : ℝ) ^ (-s)) * Cq2 /
      (1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2)) := by
    have hstep1 : (1 - (3 : ℝ) ^ (-s)) * Cq1 /
        (1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ1 ^ 2)) ≤
        (1 - (3 : ℝ) ^ (-s)) * Cq1 /
        (1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2)) :=
      div_le_div_of_nonneg_left (by positivity) hden2pos hdenle
    have hstep2 : (1 - (3 : ℝ) ^ (-s)) * Cq1 /
        (1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2)) ≤
        (1 - (3 : ℝ) ^ (-s)) * Cq2 /
        (1 - Real.exp (-(s / 2) * Real.log 3 + CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2)) := by
      gcongr
    exact hstep1.trans hstep2
  have hterm2 : (1 - (3 : ℝ) ^ (-s)) * Cq1 * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s)) ≤
      (1 - (3 : ℝ) ^ (-s)) * Cq2 * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s)) := by
    gcongr
