theorem aux_lem_band_rem_resolved_numeric
    (d : ℕ) (hd : 2 ≤ d) (t : ℝ) (ht_low : (d:ℝ)-1<t) (ht_high : t<(d:ℝ))
    (qord : ℝ) (hqord : 1 ≤ qord) :
    ∃ t1 t0 : ℝ, 0 ≤ t ∧ t < t1 ∧ t1 < (d:ℝ) ∧ (d:ℝ)-1<t0 ∧ t0<(d:ℝ) ∧
      0<t0-t1 ∧ t0-t1<t0-((d:ℝ)-1) ∧ 0<((d:ℝ)+2-t0)/2 ∧
      ((d:ℝ)+2-t0)/2<(d:ℝ)+2-t0 ∧
      1≤2*qord*max 1 t ∧ qord≤2*qord*max 1 t ∧
      1≤2*(2*qord*max 1 t) ∧
      2*(2*qord*max 1 t) ≤ max (2*(2*qord*max 1 t)) (((d:ℝ)+1)/(t0-t1)) ∧
      (d:ℝ) < max (2*(2*qord*max 1 t)) (((d:ℝ)+1)/(t0-t1))*(t0-t1) ∧
      2≤2+4*(d:ℝ)/((d:ℝ)-t) ∧
      t<(d:ℝ)-2*(d:ℝ)/(2+4*(d:ℝ)/((d:ℝ)-t)) := by
  have hdt : 0 < (d : ℝ) - t := by linarith
  have hd2 : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have ht_nn : 0 ≤ t := by linarith
  have hex1 : ∃ t1 : ℝ, t1 = t + ((d : ℝ) - t) / 3 := ⟨_, rfl⟩
  obtain ⟨t1, ht1⟩ := hex1
  have hex0 : ∃ t0 : ℝ, t0 = t + 2 * ((d : ℝ) - t) / 3 := ⟨_, rfl⟩
  obtain ⟨t0, ht0⟩ := hex0
  have htt1 : t < t1 := by rw [ht1]; linarith
  have ht1d : t1 < (d : ℝ) := by rw [ht1]; linarith
  have ht0_low : (d : ℝ) - 1 < t0 := by rw [ht0]; linarith
  have ht0_high : t0 < (d : ℝ) := by rw [ht0]; linarith
  have heta_pos : 0 < t0 - t1 := by rw [ht0, ht1]; linarith
  have heta_lt : t0 - t1 < t0 - ((d : ℝ) - 1) := by rw [ht0, ht1]; linarith
  have hetas_pos : 0 < ((d : ℝ) + 2 - t0) / 2 := by linarith
  have hetas_lt : ((d : ℝ) + 2 - t0) / 2 < (d : ℝ) + 2 - t0 := by linarith
  have hmax1 : (1 : ℝ) ≤ max 1 t := le_max_left _ _
  have hq1 : 1 ≤ 2 * qord * max 1 t := by nlinarith
  have hpq : qord ≤ 2 * qord * max 1 t := by nlinarith
  have hqmesh_p : 1 ≤ 2 * (2 * qord * max 1 t) := by linarith
  have hqmesh_q : 2 * (2 * qord * max 1 t) ≤
      max (2 * (2 * qord * max 1 t)) (((d : ℝ) + 1) / (t0 - t1)) := le_max_left _ _
  have hqmesh_eta : (d : ℝ) <
      max (2 * (2 * qord * max 1 t)) (((d : ℝ) + 1) / (t0 - t1)) * (t0 - t1) := by
    have h1 : ((d : ℝ) + 1) / (t0 - t1) * (t0 - t1) = (d : ℝ) + 1 := by
      field_simp
    have h2 : ((d : ℝ) + 1) / (t0 - t1) * (t0 - t1) ≤
        max (2 * (2 * qord * max 1 t)) (((d : ℝ) + 1) / (t0 - t1)) * (t0 - t1) :=
      mul_le_mul_of_nonneg_right (le_max_right _ _) heta_pos.le
    linarith
  have hp1 : (2 : ℝ) ≤ 2 + 4 * (d : ℝ) / ((d : ℝ) - t) := by
    have : 0 ≤ 4 * (d : ℝ) / ((d : ℝ) - t) := by positivity
    linarith
  have htp : t < (d : ℝ) - 2 * (d : ℝ) / (2 + 4 * (d : ℝ) / ((d : ℝ) - t)) := by
    have hp1pos : 0 < 2 + 4 * (d : ℝ) / ((d : ℝ) - t) := by linarith
    have hkey : 2 * (d : ℝ) / (2 + 4 * (d : ℝ) / ((d : ℝ) - t)) < ((d : ℝ) - t) / 2 := by
      rw [div_lt_iff₀ hp1pos]
      have h4 : ((d : ℝ) - t) * (4 * (d : ℝ) / ((d : ℝ) - t)) = 4 * (d : ℝ) := by
        field_simp
      nlinarith
    linarith
  exact ⟨t1, t0, ht_nn, htt1, ht1d, ht0_low, ht0_high, heta_pos, heta_lt,
    hetas_pos, hetas_lt, hq1, hpq, hqmesh_p, hqmesh_q, hqmesh_eta, hp1, htp⟩

theorem aux_lem_band_rem_bank_uniform_rem_resolved
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (_P : Paper.in_poincare d hd E)
    (_X : Paper.in_extension d hd E) (_W : SubdiffusiveProcess.Lane4.SmallPerturbationInput d)
    (D : @lane4_deterministic_good_scale_input d
      ⟨Nat.ne_of_gt (lt_of_lt_of_le (by decide) hd)⟩)
    (t : ℝ) (ht_low : (d : ℝ) - 1 < t) (ht_high : t < (d : ℝ))
    (qord : ℝ) (hqord : 1 ≤ qord) :
  ∃ delta0 : ℝ, 0 < delta0 ∧ ∃ Cbound : ℝ, 0 ≤ Cbound ∧
    ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
      (_Rm : in_responses d M) (Sreg : in_6_16 d M)
      (_It : in_iteration d M E Sreg)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
      InfraredCharacterization M H → M.delta ≤ delta0 →
    let Q : Opens (SpatialCoordinates d) := unitNeumannCube d
    let a : ℕ → BilateralField d → PositiveCoefficient Q :=
      fun N omega => cutoffPositiveCoefficient M H omega N
        (fun _ : Fin d => (1 / 2 : ℝ)) one_pos
    ∃ K : ℕ → BilateralField d → ℝ,
      (∀ N omega, 0 ≤ K N omega) ∧
      (∀ N, MemLp (K N) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure) ∧
      (∀ N, eLpNorm (K N) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal Cbound) ∧
      ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        (∀ N : ℕ,
          ∀ f : SpatialCoordinates d → ℝ,
            AEMeasurable f (volume.restrict (Q : Set (SpatialCoordinates d))) →
          ∀ Kf : ℝ, 0 ≤ Kf →
            (∀ᵐ y ∂volume.restrict (Q : Set (SpatialCoordinates d)),
              |f y| ≤ Kf) →
            (∫ y in (Q : Set (SpatialCoordinates d)), f y) = 0 →
          ∀ u : meanZeroSobolevGraph Q,
            SolvesNeumann (a N omega) f u →
          ∀ x : SpatialCoordinates d, x ∈ (Q : Set (SpatialCoordinates d)) →
          ∀ r : ℝ, 0 < r → r ≤ 1 →
            localGradientEnergy (a N omega)
              (s := Metric.ball x r ∩ (Q : Set (SpatialCoordinates d)))
              (Metric.isOpen_ball.inter Q.isOpen).measurableSet
              (sobolevGradient (u : SobolevData Q)) ≤
                K N omega *
                  (sobolevCoefficientForm (a N omega)
                    (u : SobolevData Q) (u : SobolevData Q) + Kf ^ 2) * r ^ t) ∧
        (∀ N : ℕ,
          ∀ rho : ℝ → ℝ, ContDiff ℝ ∞ rho →
            (∀ tau : ℝ, 0 ≤ rho tau) →
            (∀ tau : ℝ, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) →
            (∫ tau, rho tau) = 1 →
          ∀ pvec : Fin d → ℝ, (∑ i : Fin d, (pvec i) ^ 2) = 1 →
          ∀ Cρ : ℝ, 0 ≤ Cρ →
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
              ∀ y : SpatialCoordinates d, y ∈ (Q : Set (SpatialCoordinates d)) →
                |faceBump rho pvec eps y| ≤ Cρ * eps⁻¹) →
          ∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
          ∀ v : meanZeroSobolevGraph Q,
            SolvesNeumann (a N omega) (faceBump rho pvec eps) v →
          ∀ x : SpatialCoordinates d, x ∈ (Q : Set (SpatialCoordinates d)) →
          ∀ r : ℝ, 0 < r → r ≤ 1 →
            localGradientEnergy (a N omega)
              (s := Metric.ball x r ∩ (Q : Set (SpatialCoordinates d)))
              (Metric.isOpen_ball.inter Q.isOpen).measurableSet
              (sobolevGradient (v : SobolevData Q)) ≤
                K N omega *
                  (sobolevCoefficientForm (a N omega)
                    (v : SobolevData Q) (v : SobolevData Q) +
                    Cρ ^ 2 * eps ^ (-2 : ℝ)) * r ^ t) := by
  haveI : NeZero d := ⟨by omega⟩
  have hdt : 0 < (d : ℝ) - t := by linarith
  obtain ⟨t1, t0, ht_nn, htt1, ht1d, ht0_low, ht0_high, heta_pos, heta_lt,
    hetas_pos, hetas_lt, hq1, hpq, hqmesh_p, hqmesh_q, hqmesh_eta, hp1, htp⟩ :=
    aux_lem_band_rem_resolved_numeric d hd t ht_low ht_high qord hqord
  have hRpos : (0 : ℝ) < (3 : ℝ) ^ (-7 : ℤ) / 2 := by positivity
  have hRlt : (3 : ℝ) ^ (-7 : ℤ) / 2 < 1 / (100 * 10) := by norm_num
  have hRmem : (3 : ℝ) ^ (-7 : ℤ) / 2 ∈ Set.range (fun k : ℤ => (3 : ℝ) ^ k / 2) := ⟨-7, rfl⟩
  have hM := rem_resolved_meshes d hd 10 ((3 : ℝ) ^ (-7 : ℤ) / 2) t0 (t0 - t1)
    (((d : ℝ) + 2 - t0) / 2) (2 * (2 * qord * max 1 t))
    (max (2 * (2 * qord * max 1 t)) (((d : ℝ) + 1) / (t0 - t1))) (by norm_num) hRpos hRlt hRmem
    ht0_low ht0_high heta_pos heta_lt hetas_pos hetas_lt hqmesh_p hqmesh_q hqmesh_eta
  rcases hM with ⟨J, _, Cstep, c, Cm, delta0m, Cp, Kt, _, _, hCm, hdelta0m, hCp, _, Ccount, Cd,
    _, _, _, Cmom, Crate, _, _, hmesh⟩
  have hml := aux_rem_resolved_micro_local d hd _W (2 + 4 * (d : ℝ) / ((d : ℝ) - t)) t t1 hp1
    ht_low htt1 ht1d htp
  rcases hml with ⟨Cmic, hCmic, hmicL⟩
  have hX := aux_lem_extremes_compat d hd (fun _ => (1 / 2 : ℝ)) 1 one_pos (2 * qord * max 1 t) hq1
  rcases hX with ⟨Cpe, Cde, cde, hCpe, hCde, hcde, hextM⟩
  have hexr : ∃ rmax : ℝ,
      rmax = min (t1 - t) (min ((d : ℝ) + 2 - t) ((d : ℝ) - t)) * Real.log 3 := ⟨_, rfl⟩
  obtain ⟨rmax, hrmax_def⟩ := hexr
  have hrmax : 0 < rmax := by
    rw [hrmax_def]
    refine mul_pos (lt_min (by linarith) (lt_min (by linarith) hdt)) ?_
    exact Real.log_pos (by norm_num)
  obtain ⟨Bunif, hBunif0, hBunifMain⟩ := aux_lem_band_rem_bank_uniform_rem_resolved_Bunif
    d hd t t1 ht_low ht_high htt1 Cpe Cp rmax hCpe hCp hrmax_def
  have hA1 : 0 ≤ Cm * 2 ^ t1 := mul_nonneg hCm.le (Real.rpow_pos_of_pos (by norm_num) _).le
  have hA3 : 0 ≤ Cmic * 2 ^ t := mul_nonneg hCmic.le (Real.rpow_pos_of_pos (by norm_num) _).le
  have hA2 : 0 ≤ Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1) :=
    mul_nonneg hA3 (mul_nonneg hCm.le
      (Real.rpow_pos_of_pos (lt_of_lt_of_le one_pos (le_max_right _ _)) _).le)
  have hqpos : 0 < 2 * qord * max 1 t := by linarith
  have hCbound0 := aux_lem_band_rem_bank_uniform_rem_resolved_Cbound0
    Cm Cp Cmic t t1 Bunif hA1 hA2 hA3 hCp.le hBunif0
  have hδ0pos : 0 < min (min delta0m (cde / (2 * qord * max 1 t)))
      (min 1 (rmax / (4 * (Cde + Cpe)))) := by
    refine lt_min (lt_min hdelta0m (div_pos hcde hqpos)) (lt_min one_pos ?_)
    have h4pos : 0 < 4 * (Cde + Cpe) := by positivity
    exact div_pos hrmax h4pos
  exact aux_lem_band_rem_resolved_assembly d hd E _P _X D t qord hqord ht_nn t1 t0
    htt1 hq1 hpq J Cstep c Cm delta0m Cp Kt hCm hCp Cmom Crate hmesh Cmic hCmic hmicL
    Cpe Cde cde hCpe hCde hextM rmax hrmax Bunif hBunif0 hBunifMain hA1 hA3 hA2
    hCbound0 hδ0pos

theorem aux_lem_band_rb_ulm_thresholds (Cd q : ℝ) (hq : 1 ≤ q) (s : ℝ)
    (hs : s ∈ Set.Ioo (0 : ℝ) (1 / 4)) (hCd0 : 0 < Cd) :
    ∃ delta0A delta0B : ℝ, 0 < delta0A ∧ 0 < delta0B ∧
      (∀ δ : ℝ, 0 ≤ δ → δ ≤ delta0A → Cd * (q + q ^ 2) * δ ^ 2 ≤ (s / 4) * Real.log 3) ∧
      (∀ δ : ℝ, 0 ≤ δ → δ ≤ delta0B → Cd * δ * (1 + δ) ≤ s * Real.log 3) := by
  obtain ⟨hs0, _hs14⟩ := hs
  have hlog3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hqq2 : (0:ℝ) ≤ q + q ^ 2 := by nlinarith
  refine ⟨Real.sqrt (s * Real.log 3 / (4 * (Cd * (q + q ^ 2)) + 4)),
    min 1 (s * Real.log 3 / (2 * Cd + 1)), ?_, ?_, ?_, ?_⟩
  · apply Real.sqrt_pos.mpr
    apply div_pos (mul_pos hs0 hlog3)
    nlinarith [hCd0, hqq2]
  · apply lt_min one_pos
    apply div_pos (mul_pos hs0 hlog3)
    linarith [hCd0]
  · intro δ hδ hδle
    have hstep : δ ^ 2 ≤ Real.sqrt (s * Real.log 3 / (4 * (Cd * (q + q ^ 2)) + 4)) ^ 2 :=
      pow_le_pow_left₀ hδ hδle 2
    rw [Real.sq_sqrt (div_nonneg (mul_nonneg hs0.le hlog3.le)
      (by nlinarith [hCd0, hqq2] : (0:ℝ) ≤ 4 * (Cd * (q + q ^ 2)) + 4))] at hstep
    have := aux_lane4_lambda_inv_moments_condA_helper (Cd * (q + q ^ 2)) (s * Real.log 3)
      (δ ^ 2) (by nlinarith [hCd0, hqq2]) (by positivity) (sq_nonneg _) hstep
    linarith [this]
  · intro δ hδ hδle
    have hMle1 : δ ≤ 1 := hδle.trans (min_le_left _ _)
    have hMleZ : δ ≤ s * Real.log 3 / (2 * Cd + 1) := hδle.trans (min_le_right _ _)
    exact aux_lane4_lambda_inv_moments_condB_helper Cd (s * Real.log 3) δ hCd0.le
      (by positivity) hMle1 hδ hMleZ

theorem aux_lem_band_rb_ulm_Cplus_mono (d : ℕ) (r CJ B CR CHK CenvK q q' : ℝ) (ℓ : ℕ)
    (hr : 0 < r) (hCJ : 0 ≤ CJ) (hB : 0 ≤ B) (hCR : 0 ≤ CR)
    (hCHK : 0 ≤ CHK) (hCenvK : 0 ≤ CenvK) (hq0 : 0 < q) (hq'0 : 0 < q')
    (δ1 δ2 : ℝ) (hδ1 : 0 ≤ δ1) (hle : δ1 ≤ δ2) :
    aux_lane4_lambda_inv_cell_moment_Cplus d δ1 r CJ
        (Real.log 4 / (2 * q) + 4 * (2 * q) * CHK * δ1 ^ 2 + B * δ1 ^ 2) B CR
        (Real.log 4 / q' + 4 * q' * CenvK * δ1 ^ 2) ℓ ≤
      aux_lane4_lambda_inv_cell_moment_Cplus d δ2 r CJ
        (Real.log 4 / (2 * q) + 4 * (2 * q) * CHK * δ2 ^ 2 + B * δ2 ^ 2) B CR
        (Real.log 4 / q' + 4 * q' * CenvK * δ2 ^ 2) ℓ := by
  unfold aux_lane4_lambda_inv_cell_moment_Cplus
  set E0 : ℝ → ℝ := fun δ => Real.log 4 / q' + 4 * q' * CenvK * δ ^ 2 with hE0def
  set P0 : ℝ → ℝ := fun δ => Real.log 4 / (2 * q) + 4 * (2 * q) * CHK * δ ^ 2 + B * δ ^ 2
    with hP0def
  show Real.sqrt 3 ^ ℓ * Real.exp (E0 δ1 + CR * δ1 ^ 2 * ℓ) +
      8 * (d:ℝ) * (CJ + 1) * Real.exp (P0 δ1) * Real.exp (B * δ1 ^ 2 * ℓ) +
      (d:ℝ) * Real.sqrt 3 / r * Real.exp (E0 δ1) * Real.exp (CR * δ1 ^ 2) ≤
    Real.sqrt 3 ^ ℓ * Real.exp (E0 δ2 + CR * δ2 ^ 2 * ℓ) +
      8 * (d:ℝ) * (CJ + 1) * Real.exp (P0 δ2) * Real.exp (B * δ2 ^ 2 * ℓ) +
      (d:ℝ) * Real.sqrt 3 / r * Real.exp (E0 δ2) * Real.exp (CR * δ2 ^ 2)
  have hδ2 : 0 ≤ δ2 := hδ1.trans hle
  have hsq : δ1 ^ 2 ≤ δ2 ^ 2 := pow_le_pow_left₀ hδ1 hle 2
  have hE0mono : E0 δ1 ≤ E0 δ2 := by
    simp only [hE0def]
    have h1 : 4 * q' * CenvK * δ1 ^ 2 ≤ 4 * q' * CenvK * δ2 ^ 2 :=
      mul_le_mul_of_nonneg_left hsq (by positivity)
    linarith
  have hP0mono : P0 δ1 ≤ P0 δ2 := by
    simp only [hP0def]
    have h1 : 4 * (2 * q) * CHK * δ1 ^ 2 ≤ 4 * (2 * q) * CHK * δ2 ^ 2 :=
      mul_le_mul_of_nonneg_left hsq (by positivity)
    have h2 : B * δ1 ^ 2 ≤ B * δ2 ^ 2 := mul_le_mul_of_nonneg_left hsq hB
    linarith
  have hCRterm : CR * δ1 ^ 2 * (ℓ : ℝ) ≤ CR * δ2 ^ 2 * (ℓ : ℝ) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hsq hCR) (Nat.cast_nonneg ℓ)
  have hBterm : B * δ1 ^ 2 * (ℓ : ℝ) ≤ B * δ2 ^ 2 * (ℓ : ℝ) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hsq hB) (Nat.cast_nonneg ℓ)
  have hCR2 : CR * δ1 ^ 2 ≤ CR * δ2 ^ 2 := mul_le_mul_of_nonneg_left hsq hCR
  have hterm1 : Real.sqrt 3 ^ ℓ * Real.exp (E0 δ1 + CR * δ1 ^ 2 * (ℓ : ℝ)) ≤
      Real.sqrt 3 ^ ℓ * Real.exp (E0 δ2 + CR * δ2 ^ 2 * (ℓ : ℝ)) :=
    mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith)) (by positivity)
  have hterm2 : 8 * (d:ℝ) * (CJ + 1) * Real.exp (P0 δ1) * Real.exp (B * δ1 ^ 2 * (ℓ:ℝ)) ≤
      8 * (d:ℝ) * (CJ + 1) * Real.exp (P0 δ2) * Real.exp (B * δ2 ^ 2 * (ℓ:ℝ)) := by
    have hstep : Real.exp (P0 δ1) * Real.exp (B * δ1 ^ 2 * (ℓ:ℝ)) ≤
        Real.exp (P0 δ2) * Real.exp (B * δ2 ^ 2 * (ℓ:ℝ)) :=
      mul_le_mul (Real.exp_le_exp.mpr hP0mono) (Real.exp_le_exp.mpr hBterm)
        (Real.exp_pos _).le (Real.exp_pos _).le
    have h8 : (0:ℝ) ≤ 8 * (d:ℝ) * (CJ + 1) := by positivity
    calc 8 * (d:ℝ) * (CJ + 1) * Real.exp (P0 δ1) * Real.exp (B * δ1 ^ 2 * (ℓ:ℝ))
        = 8 * (d:ℝ) * (CJ + 1) * (Real.exp (P0 δ1) * Real.exp (B * δ1 ^ 2 * (ℓ:ℝ))) := by ring
      _ ≤ 8 * (d:ℝ) * (CJ + 1) * (Real.exp (P0 δ2) * Real.exp (B * δ2 ^ 2 * (ℓ:ℝ))) :=
          mul_le_mul_of_nonneg_left hstep h8
      _ = 8 * (d:ℝ) * (CJ + 1) * Real.exp (P0 δ2) * Real.exp (B * δ2 ^ 2 * (ℓ:ℝ)) := by ring
  have hterm3 : (d:ℝ) * Real.sqrt 3 / r * Real.exp (E0 δ1) * Real.exp (CR * δ1 ^ 2) ≤
      (d:ℝ) * Real.sqrt 3 / r * Real.exp (E0 δ2) * Real.exp (CR * δ2 ^ 2) := by
    have hstep : Real.exp (E0 δ1) * Real.exp (CR * δ1 ^ 2) ≤
        Real.exp (E0 δ2) * Real.exp (CR * δ2 ^ 2) :=
      mul_le_mul (Real.exp_le_exp.mpr hE0mono) (Real.exp_le_exp.mpr hCR2)
        (Real.exp_pos _).le (Real.exp_pos _).le
    have hpre : (0:ℝ) ≤ (d:ℝ) * Real.sqrt 3 / r := by positivity
    calc (d:ℝ) * Real.sqrt 3 / r * Real.exp (E0 δ1) * Real.exp (CR * δ1 ^ 2)
        = (d:ℝ) * Real.sqrt 3 / r * (Real.exp (E0 δ1) * Real.exp (CR * δ1 ^ 2)) := by ring
      _ ≤ (d:ℝ) * Real.sqrt 3 / r * (Real.exp (E0 δ2) * Real.exp (CR * δ2 ^ 2)) :=
          mul_le_mul_of_nonneg_left hstep hpre
      _ = (d:ℝ) * Real.sqrt 3 / r * Real.exp (E0 δ2) * Real.exp (CR * δ2 ^ 2) := by ring
  linarith [hterm1, hterm2, hterm3]

theorem aux_lem_band_rb_ulm_above_mono (D Q a C1 C2 δ1 δ2 : ℝ) (n : ℕ)
    (ha : 0 ≤ a) (hQ1 : 1 ≤ Q) (hC1 : 0 ≤ C1) (hC1C2 : C1 ≤ C2)
    (hδ1 : 0 ≤ δ1) (hle : δ1 ≤ δ2) :
    C1 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a * (Q + Q ^ 2) * δ1 ^ 2 * (n : ℝ)) ≤
      C2 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a * (Q + Q ^ 2) * δ2 ^ 2 * (n : ℝ)) := by
  have hQQ : 0 ≤ a * (Q + Q ^ 2) * (n : ℝ) := by
    have : (0:ℝ) ≤ Q + Q ^ 2 := by nlinarith
    positivity
  have hexp : Real.exp (a * (Q + Q ^ 2) * δ1 ^ 2 * (n : ℝ)) ≤
      Real.exp (a * (Q + Q ^ 2) * δ2 ^ 2 * (n : ℝ)) := by
    apply Real.exp_le_exp.mpr
    have hsq : δ1 ^ 2 ≤ δ2 ^ 2 := pow_le_pow_left₀ hδ1 hle 2
    nlinarith [mul_le_mul_of_nonneg_left hsq hQQ]
  have h3 : (0 : ℝ) ≤ (3 : ℝ) ^ (D * (n : ℝ) / Q) := by positivity
  have hC2 : 0 ≤ C2 := hC1.trans hC1C2
  calc C1 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a * (Q + Q ^ 2) * δ1 ^ 2 * (n : ℝ))
      = (3 : ℝ) ^ (D * (n : ℝ) / Q) *
          (C1 * Real.exp (a * (Q + Q ^ 2) * δ1 ^ 2 * (n : ℝ))) := by ring
    _ ≤ (3 : ℝ) ^ (D * (n : ℝ) / Q) *
          (C2 * Real.exp (a * (Q + Q ^ 2) * δ2 ^ 2 * (n : ℝ))) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul hC1C2 hexp (Real.exp_pos _).le hC2) h3
    _ = C2 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a * (Q + Q ^ 2) * δ2 ^ 2 * (n : ℝ)) := by
        ring

theorem aux_lem_band_rb_ulm_above_rate_mono (D Q a1 a2 C1 C2 δ : ℝ) (n : ℕ)
    (hQ1 : 1 ≤ Q) (ha1 : 0 ≤ a1) (ha1a2 : a1 ≤ a2) (hC1 : 0 ≤ C1) (hC1C2 : C1 ≤ C2)
    (hδ : 0 ≤ δ) :
    C1 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a1 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ)) ≤
      C2 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a2 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ)) := by
  have hQQ : (0 : ℝ) ≤ Q + Q ^ 2 := by nlinarith
  have hn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
  have hexp : Real.exp (a1 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ)) ≤
      Real.exp (a2 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ)) := by
    apply Real.exp_le_exp.mpr
    nlinarith [mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right ha1a2 hQQ)
      (mul_nonneg (sq_nonneg δ) hn)]
  have h3 : (0 : ℝ) ≤ (3 : ℝ) ^ (D * (n : ℝ) / Q) := by positivity
  have hC2 : 0 ≤ C2 := hC1.trans hC1C2
  calc C1 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a1 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ))
      = (3 : ℝ) ^ (D * (n : ℝ) / Q) *
          (C1 * Real.exp (a1 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ))) := by ring
    _ ≤ (3 : ℝ) ^ (D * (n : ℝ) / Q) *
          (C2 * Real.exp (a2 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul hC1C2 hexp (Real.exp_pos _).le hC2) h3
    _ = C2 * (3 : ℝ) ^ (D * (n : ℝ) / Q) * Real.exp (a2 * (Q + Q ^ 2) * δ ^ 2 * (n : ℝ)) := by
        ring

theorem aux_lem_band_rb_ulm_exp_mono (a b δ1 δ2 : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hδ1 : 0 ≤ δ1) (hle : δ1 ≤ δ2) :
    Real.exp (a * δ1 + b * δ1 ^ 2) ≤ Real.exp (a * δ2 + b * δ2 ^ 2) := by
  apply Real.exp_le_exp.mpr
  have h1 : δ1 ^ 2 ≤ δ2 ^ 2 := pow_le_pow_left₀ hδ1 hle 2
  nlinarith [mul_le_mul_of_nonneg_left hle ha, mul_le_mul_of_nonneg_left h1 hb]

theorem aux_lem_band_rb_ulm_below_mono (a1 b1 bb cc N δ1 δ2 : ℝ)
    (ha1 : 0 ≤ a1) (hb1 : 0 ≤ b1) (hbb : 0 ≤ bb) (hcc : 0 ≤ cc) (hN : 0 ≤ N)
    (hδ1 : 0 ≤ δ1) (hle : δ1 ≤ δ2) :
    Real.exp (a1 * δ1 + b1 * δ1 ^ 2) * Real.exp ((bb * δ1 + cc * δ1 ^ 2) * N) ≤
      Real.exp (a1 * δ2 + b1 * δ2 ^ 2) * Real.exp ((bb * δ2 + cc * δ2 ^ 2) * N) := by
  have h1 := aux_lem_band_rb_ulm_exp_mono a1 b1 δ1 δ2 ha1 hb1 hδ1 hle
  have h2 : Real.exp ((bb * δ1 + cc * δ1 ^ 2) * N) ≤ Real.exp ((bb * δ2 + cc * δ2 ^ 2) * N) := by
    rw [show (bb * δ1 + cc * δ1 ^ 2) * N = (bb * N) * δ1 + (cc * N) * δ1 ^ 2 by ring,
        show (bb * δ2 + cc * δ2 ^ 2) * N = (bb * N) * δ2 + (cc * N) * δ2 ^ 2 by ring]
    exact aux_lem_band_rb_ulm_exp_mono (bb * N) (cc * N) δ1 δ2 (by positivity) (by positivity)
      hδ1 hle
  exact mul_le_mul h1 h2 (Real.exp_pos _).le (Real.exp_pos _).le

theorem aux_lem_band_rb_ulm_below_rate_mono (b1 c1 b2 c2 δ N : ℝ)
    (hb1 : 0 ≤ b1) (hc1 : 0 ≤ c1) (hb1b2 : b1 ≤ b2) (hc1c2 : c1 ≤ c2)
    (hδ : 0 ≤ δ) (hN : 0 ≤ N) :
    Real.exp ((b1 * δ + c1 * δ ^ 2) * N) ≤ Real.exp ((b2 * δ + c2 * δ ^ 2) * N) := by
  apply Real.exp_le_exp.mpr
  have h1 : b1 * δ ≤ b2 * δ := mul_le_mul_of_nonneg_right hb1b2 hδ
  have h2 : c1 * δ ^ 2 ≤ c2 * δ ^ 2 := mul_le_mul_of_nonneg_right hc1c2 (sq_nonneg δ)
  nlinarith [mul_le_mul_of_nonneg_right (add_le_add h1 h2) hN]

theorem aux_lem_band_rb_uniform_cell_moment
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) (q : ℝ) (hq : 1 ≤ q) (s : ℝ) (hs : s ∈ Set.Ioo (0 : ℝ) (1 / 4))
    (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (hr1 : r ≤ 1) :
    ∃ delta0 Cd : ℝ, 0 < delta0 ∧ 0 < Cd ∧
      Cd * (q + q ^ 2) * delta0 ^ 2 ≤ (s / 4) * Real.log 3 ∧
      Cd * delta0 * (1 + delta0) ≤ s * Real.log 3 ∧
    ∃ Cq : ℝ, 0 < Cq ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (_Rm : in_responses d M)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        ∀ N n : ℕ,
          AEStronglyMeasurable (fun om =>
              Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
                (Homogenization.originCube d 0) (-(n : ℤ))
                (E.chart z r hr
                  (SubdiffusiveProcess.Lane4.cutoffPositiveCoefficient M H om N z hr) z r))
            (chaosSampleLaw M).toMeasure ∧
          eLpNorm (fun om =>
              Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
                (Homogenization.originCube d 0) (-(n : ℤ))
                (E.chart z r hr
                  (SubdiffusiveProcess.Lane4.cutoffPositiveCoefficient M H om N z hr) z r))
            (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal
              (Cq * (if n ≤ N then
                  (3 : ℝ) ^ ((d : ℝ) * (n : ℝ) / q) *
                    Real.exp (Cd * (q + q ^ 2) * delta0 ^ 2 * (n : ℝ))
                else
                  Real.exp ((Cd * delta0 + Cd * delta0 ^ 2) * (N : ℝ)))) := by
  haveI : NeZero d := ⟨by omega⟩
  have hq0 : 0 < q := by linarith
  obtain ⟨hs0, _hs14⟩ := hs
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlog3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hlog32 : 0 < Real.log (3 / 2) := Real.log_pos (by norm_num)
  have hlogs3 : 0 < Real.log (Real.sqrt 3) :=
    Real.log_pos (by rw [Real.lt_sqrt (by norm_num)]; norm_num)

  obtain ⟨δresp, CJ, hδresp, hCJ, hresp⟩ :=
    aux_lem_extension_cell_moment_matched_response hd E q hq
  obtain ⟨CH, hCH0, hpieceM⟩ := aux_lane4_lambda_inv_cell_moment_pieceG_moment hd
  obtain ⟨Cenv, hCenv0, henvM⟩ := aux_lane4_lambda_inv_cell_moment_envMax_moment hd
  obtain ⟨q', hq'⟩ : ∃ q' : ℝ, q' = max q (2 * d) := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = aux_lem_extension_cell_moment_aboveRate d (2 * q) := ⟨_, rfl⟩
  have hBpos : 0 < B := by
    rw [hB]; exact aux_lem_extension_cell_moment_aboveRate_pos d (2 * q) (by positivity)
  have hq'q : q ≤ q' := by rw [hq']; exact le_max_left _ _
  have hq'0 : 0 < q' := by linarith
  have hdq' : (d : ℝ) / q' ≤ 1 / 2 := by
    rw [div_le_iff₀ hq'0]
    have : 2 * (d : ℝ) ≤ q' := by rw [hq']; exact le_max_right _ _
    linarith
  have hCRpos : 0 < 2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 := by
    positivity
  obtain ⟨R, hR⟩ : ∃ R : ℝ,
      R = max B (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) :=
    ⟨_, rfl⟩
  have hBR : B ≤ R := by rw [hR]; exact le_max_left _ _
  have hCRR : 2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 ≤ R := by
    rw [hR]; exact le_max_right _ _
  have hR0 : 0 ≤ R := hBpos.le.trans hBR
  have hbb_nn : (0:ℝ) ≤ (d : ℝ) * Real.log 3 + (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 := by
    positivity
  have hcc_nn : (0:ℝ) ≤ 2 * Real.log 2 := by positivity
  obtain ⟨Cd, hCd_def⟩ : ∃ Cd : ℝ, Cd = 1 + R +
      ((d : ℝ) * Real.log 3 + (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) +
      2 * Real.log 2 := ⟨_, rfl⟩
  have hCd0 : 0 < Cd := by rw [hCd_def]; linarith
  have hRCd : R ≤ Cd := by rw [hCd_def]; linarith
  have hbbCd : (d : ℝ) * Real.log 3 + (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 ≤ Cd := by
    rw [hCd_def]; linarith
  have hccCd : (2:ℝ) * Real.log 2 ≤ Cd := by rw [hCd_def]; linarith
  obtain ⟨delta0A, delta0B, hdelta0A_pos, hdelta0B_pos, hcondA_of, hcondB_of⟩ :=
    aux_lem_band_rb_ulm_thresholds Cd q hq s ⟨hs0, _hs14⟩ hCd0
  obtain ⟨delta0, hdelta0_def⟩ : ∃ delta0 : ℝ, delta0 = min δresp (min (1 / q)
      (min (Real.sqrt (Real.log (3 / 2) / B))
        (min (Real.sqrt (Real.log (Real.sqrt 3) /
          (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)))
          (min delta0A delta0B))))
    := ⟨_, rfl⟩
  have hdelta0pos : 0 < delta0 := by
    rw [hdelta0_def]
    exact lt_min hδresp (lt_min (by positivity) (lt_min
      (Real.sqrt_pos.mpr (div_pos hlog32 hBpos))
      (lt_min (Real.sqrt_pos.mpr (div_pos hlogs3 hCRpos)) (lt_min hdelta0A_pos hdelta0B_pos))))
  have hdelta0_nn : 0 ≤ delta0 := hdelta0pos.le
  have hdelta0_resp : delta0 ≤ δresp := hdelta0_def ▸ min_le_left _ _
  have hdelta0_q : delta0 ≤ 1 / q := hdelta0_def ▸ (min_le_right _ _).trans (min_le_left _ _)
  have hdelta0_B : delta0 ≤ Real.sqrt (Real.log (3 / 2) / B) :=
    hdelta0_def ▸ (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  have hdelta0_C : delta0 ≤ Real.sqrt (Real.log (Real.sqrt 3) /
      (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)) :=
    hdelta0_def ▸ (min_le_right _ _).trans ((min_le_right _ _).trans
      ((min_le_right _ _).trans (min_le_left _ _)))
  have hdelta0_A' : delta0 ≤ delta0A := by
    rw [hdelta0_def]
    exact (min_le_right _ _).trans ((min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))))
  have hdelta0_B' : delta0 ≤ delta0B := by
    rw [hdelta0_def]
    exact (min_le_right _ _).trans ((min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _))))
  have hcondA : Cd * (q + q ^ 2) * delta0 ^ 2 ≤ (s / 4) * Real.log 3 :=
    hcondA_of delta0 hdelta0_nn hdelta0_A'
  have hcondB : Cd * delta0 * (1 + delta0) ≤ s * Real.log 3 :=
    hcondB_of delta0 hdelta0_nn hdelta0_B'
  obtain ⟨ℓ, hℓ⟩ := exists_pow_lt_of_lt_one hr (by norm_num : (1 / 3 : ℝ) < 1)
                                                                                    
  obtain ⟨Cq0, hCq0_def⟩ : ∃ Cq0 : ℝ, Cq0 = aux_lane4_lambda_inv_cell_moment_Cplus d delta0 r CJ
      (Real.log 4 / (2 * q) + 4 * (2 * q) * CH (aux_lane4_lambda_inv_cell_moment_rootK z) * delta0 ^ 2 + B * delta0 ^ 2) B
      (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)
      (Real.log 4 / q' + 4 * q' * Cenv (aux_lane4_lambda_inv_cell_moment_rootK z) * delta0 ^ 2) ℓ := ⟨_, rfl⟩
  obtain ⟨Cm0, hCm0_def⟩ : ∃ Cm0 : ℝ, Cm0 = Real.exp
      ((Real.log 4 + 4 * Cenv (aux_lane4_lambda_inv_cell_moment_rootK z) +
          ((d : ℝ) * Real.log 3 + (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)) *
        delta0 + (2 * Real.log 2) * delta0 ^ 2) := ⟨_, rfl⟩
  have hCq0_nn : 0 ≤ Cq0 := by
    rw [hCq0_def]; unfold aux_lane4_lambda_inv_cell_moment_Cplus; positivity
  have hCm0_nn : 0 ≤ Cm0 := by rw [hCm0_def]; exact (Real.exp_pos _).le
  refine ⟨delta0, Cd, hdelta0pos, hCd0, hcondA, hcondB, 1 + Cq0 + Cm0, by linarith, ?_⟩
  intro M _Rm H hH hMdelta N n
  have hδ0 : 0 ≤ M.delta := M.shellPrefix.delta_pos.le
  have hδresp' : M.delta ≤ δresp := hMdelta.trans hdelta0_resp
  have hδq : M.delta ≤ 1 / q := hMdelta.trans hdelta0_q
  have hBδ : B * M.delta ^ 2 ≤ Real.log (3 / 2) := by
    have hM_B : M.delta ≤ Real.sqrt (Real.log (3 / 2) / B) := hMdelta.trans hdelta0_B
    have h := pow_le_pow_left₀ hδ0 hM_B 2
    rw [Real.sq_sqrt (div_nonneg hlog32.le hBpos.le), le_div_iff₀ hBpos] at h
    linarith
  have hCRδ : (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) *
      M.delta ^ 2 ≤ Real.log (Real.sqrt 3) := by
    have hM_C : M.delta ≤ Real.sqrt (Real.log (Real.sqrt 3) /
        (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)) :=
      hMdelta.trans hdelta0_C
    have h := pow_le_pow_left₀ hδ0 hM_C 2
    rw [Real.sq_sqrt (div_nonneg hlogs3.le hCRpos.le), le_div_iff₀ hCRpos] at h
    linarith
  have hrespM := hresp M hδresp'
  rcases hrespM with ⟨family, J, hfamily, hJgreat, hJmeas, hJnorm⟩
  have hJ0 : ∀ N om, 0 ≤ J N om := by
    intro N om
    obtain ⟨e, _, he⟩ := (hJgreat N om).1
    rw [he]
    exact Homogenization.Book.Ch02.responseJ_nonneg _ _ _ _
  have hmeasYnn : AEStronglyMeasurable (fun om =>
      Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
        (Homogenization.originCube d 0) (-(n : ℤ))
        (E.chart z r hr (SubdiffusiveProcess.Lane4.cutoffPositiveCoefficient M H om N z hr) z r))
      (chaosSampleLaw M).toMeasure := by
    have h := aux_lem_extension_cell_moment_aesm_maxS_chart hd E M H hH.1 N z r hr z r hr
      Set.Subset.rfl n
    simpa [Homogenization.originCube] using h
  refine ⟨hmeasYnn, ?_⟩
  by_cases hnN : n ≤ N
  · have hcell : ∀ N' n' : ℕ, n' ≤ N' →
      ∀ Q ∈ Homogenization.descendantsAtScale (Homogenization.originCube d 0)
        ((Homogenization.originCube d 0).scale - (n' : ℤ)),
        eLpNorm (fun om => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm Q
          (E.chart z r hr (SubdiffusiveProcess.Lane4.cutoffPositiveCoefficient M H om N' z hr) z r))
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (aux_lane4_lambda_inv_cell_moment_Cplus d M.delta r CJ
          (Real.log 4 / (2 * q) + 4 * (2 * q) * CH (aux_lane4_lambda_inv_cell_moment_rootK z) * M.delta ^ 2 + B * M.delta ^ 2) B
          (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)
          (Real.log 4 / q' + 4 * q' * Cenv (aux_lane4_lambda_inv_cell_moment_rootK z) * M.delta ^ 2) ℓ *
            Real.exp (R * M.delta ^ 2 * n')) := fun N' n' hn'N' Q hQ => by
      have hQsub := Homogenization.openCubeSet_subset_of_mem_descendantsAtScale (by simp) hQ
      rw [← SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded (aux_lem_extension_cell_moment_aesm_coarseS_chart hd E M H hH.1 N' z r hr z r hr Set.Subset.rfl Q hQsub)]
      exact aux_lane4_lambda_inv_cell_moment_cell_moment hd E M H q q' hq hq'q hdq' Cenv (henvM M H hH) z r hr hr1
        family J ⟨hfamily, hJgreat, hJ0⟩ CJ
        (Real.log 4 / (2 * q) + 4 * (2 * q) * CH (aux_lane4_lambda_inv_cell_moment_rootK z) * M.delta ^ 2 + B * M.delta ^ 2) B R hCJ.le
        (fun N'' L w => hB ▸ hpieceM M H hH (aux_lane4_lambda_inv_cell_moment_rootK z) N'' J CJ q
          hCJ.le hq hJmeas hJnorm L w) hBR hCRR hBδ hCRδ ℓ hℓ.le N' n' hn'N' Q hQ
    have hCplus_Mδ_nn : 0 ≤ aux_lane4_lambda_inv_cell_moment_Cplus d M.delta r CJ
        (Real.log 4 / (2 * q) + 4 * (2 * q) * CH (aux_lane4_lambda_inv_cell_moment_rootK z) * M.delta ^ 2 + B * M.delta ^ 2) B
        (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)
        (Real.log 4 / q' + 4 * q' * Cenv (aux_lane4_lambda_inv_cell_moment_rootK z) * M.delta ^ 2) ℓ := by
      unfold aux_lane4_lambda_inv_cell_moment_Cplus; positivity
    have hactual := aux_lane4_lambda_inv_cell_moment_branch_above hd E M H hH.1 q hq
      z r hr _ R hCplus_Mδ_nn hR0 hcell N n hnN
    refine hactual.trans (ENNReal.ofReal_le_ofReal ?_)
    rw [if_pos hnN, show (1 + Cq0 + Cm0) *
        ((3 : ℝ) ^ ((d : ℝ) * (n : ℝ) / q) * Real.exp (Cd * (q + q ^ 2) * delta0 ^ 2 * (n : ℝ))) =
      (1 + Cq0 + Cm0) * (3 : ℝ) ^ ((d : ℝ) * (n : ℝ) / q) *
        Real.exp (Cd * (q + q ^ 2) * delta0 ^ 2 * (n : ℝ)) from by ring]
    have hCplus_mono := aux_lem_band_rb_ulm_Cplus_mono d r CJ B
      (2 * Real.log 2 + q' * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2)
      (CH (aux_lane4_lambda_inv_cell_moment_rootK z)) (Cenv (aux_lane4_lambda_inv_cell_moment_rootK z)) q q' ℓ hr hCJ.le hBpos.le hCRpos.le (hCH0 (aux_lane4_lambda_inv_cell_moment_rootK z)) (hCenv0 (aux_lane4_lambda_inv_cell_moment_rootK z)) hq0 hq'0
      M.delta delta0 hδ0 hMdelta
    have hstep1 := aux_lem_band_rb_ulm_above_mono (d : ℝ) q R _ Cq0 M.delta delta0 n hR0 hq
      hCplus_Mδ_nn (hCq0_def ▸ hCplus_mono) hδ0 hMdelta
    have hstep2 := aux_lem_band_rb_ulm_above_rate_mono (d : ℝ) q R Cd Cq0 (1 + Cq0 + Cm0)
      delta0 n hq hR0 hRCd hCq0_nn (by linarith) hdelta0_nn
    exact hstep1.trans hstep2
  · push_neg at hnN
