noncomputable def aux_lem_band_L1c_Cminus_fn (d : ℕ) (CenvK δ : ℝ) : ℝ :=
  Real.exp (Real.log 4 * δ + 4 * CenvK * δ +
    ((d * Real.log 3 + (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) * δ +
      2 * Real.log 2 * δ ^ 2))

noncomputable def aux_lem_band_L1c_Cq_fn (d : ℕ) (r CJ B CR CHK CenvK q q' δ : ℝ) (ℓ : ℕ) : ℝ :=
  1 + aux_lem_band_L1c_Cplus_fn d r CJ B CR CHK CenvK q q' δ ℓ + aux_lem_band_L1c_Cminus_fn d CenvK δ

noncomputable def aux_lem_band_L1c_Cd_fn (d : ℕ) (R : ℝ) : ℝ :=
