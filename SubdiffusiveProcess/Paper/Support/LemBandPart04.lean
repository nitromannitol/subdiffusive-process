    (min ((2 * ResidualModel.residualDisorderFactor d)⁻¹) 1)), B.toReal,
    lt_min hδg (lt_min (div_pos hdA hD) (lt_min (by positivity) one_pos)), ENNReal.toReal_nonneg, ?_⟩
  intro M Rm H hH hδ
