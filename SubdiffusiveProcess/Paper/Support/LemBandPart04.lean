  obtain ⟨B3, hB3, hE3⟩ := aux_lem_band_mac5_env_pow_quant d kk 3 (2 * q) 1 (by linarith) zero_le_one
  obtain ⟨B6, hB6, hE6⟩ := aux_lem_band_mac5_env_pow_quant d kk 6 (2 * q) 1 (by linarith) zero_le_one
  let Cn := aux_prop_growth_macro_energy_C d
