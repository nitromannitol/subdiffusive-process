    (fun N => (aux_rem_bank_response_moments_measurable_inverseResponse M H hIC.1 N z hr
      (killedResponseSpace hP) _).aestronglyMeasurable)
    (fun N => (hKmem N).norm)
    hLmem
    (fun N => by
      change eLpNorm (fun om => ‖K N om‖) (ENNReal.ofReal (max (3 * p) (2 * p)))
