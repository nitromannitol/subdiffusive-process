  obtain ⟨hRmeas, _, _⟩ := aux_aux_macro_moment_bank_reference hd M' H' hH'
    (closedCube (r⁻¹ • z) 1 one_pos) (2 * (2 * q)) (by linarith)
  have hRb : eLpNorm (aux_prop_growth_macro_energy_Rs H' z r)
      (ENNReal.ofReal (2 * (2 * q))) (chaosSampleLaw M').toMeasure ≤ ENNReal.ofReal CE :=
    hCEb M' H' hH' hδ'
  obtain ⟨Kg, hKg0, hKgm, hKgb, hKgs⟩ := hglob M Rm H hH hδgM
  let K := aux_prop_growth_macro_energy_Kfinal M kk r t Z Lm (aux_prop_growth_macro_energy_Rs H' z r) Kg
  have hKn : ∀ N, AEStronglyMeasurable (K N) (chaosSampleLaw M).toMeasure ∧
