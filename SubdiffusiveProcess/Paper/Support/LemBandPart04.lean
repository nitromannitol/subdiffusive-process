theorem aux_lem_band_rrpack_rem_resolved
    (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (t qord : ℝ)
    (delta0 : ℝ) (hδ0 : 0 < delta0) (Cbound : ℝ) (hCbound0 : 0 ≤ Cbound)
    (hmain : ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
      (_Rm : in_responses d M) (Sreg : in_6_16 d M)
      (_It : in_iteration d M E Sreg)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
      InfraredCharacterization M H → M.delta ≤ delta0 →
    let Q : Opens (SpatialCoordinates d) := unitNeumannCube d
    let a : ℕ → BilateralField d → PositiveCoefficient Q :=
      fun N omega => cutoffPositiveCoefficient M H omega N
        (fun _ : Fin d => (1 / 2 : ℝ)) one_pos
    ∃ K : ℕ → BilateralField d → ℝ,
      (∀ N omega, 0 ≤ K N omega) ∧
      (∀ N, MemLp (K N) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure) ∧
      (∀ N, eLpNorm (K N) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal Cbound) ∧
      ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        (∀ N : ℕ,
          ∀ f : SpatialCoordinates d → ℝ,
            AEMeasurable f (volume.restrict (Q : Set (SpatialCoordinates d))) →
          ∀ Kf : ℝ, 0 ≤ Kf →
            (∀ᵐ y ∂volume.restrict (Q : Set (SpatialCoordinates d)),
              |f y| ≤ Kf) →
            (∫ y in (Q : Set (SpatialCoordinates d)), f y) = 0 →
          ∀ u : meanZeroSobolevGraph Q,
            SolvesNeumann (a N omega) f u →
          ∀ x : SpatialCoordinates d, x ∈ (Q : Set (SpatialCoordinates d)) →
          ∀ r : ℝ, 0 < r → r ≤ 1 →
            localGradientEnergy (a N omega)
              (s := Metric.ball x r ∩ (Q : Set (SpatialCoordinates d)))
              (Metric.isOpen_ball.inter Q.isOpen).measurableSet
              (sobolevGradient (u : SobolevData Q)) ≤
                K N omega *
                  (sobolevCoefficientForm (a N omega)
                    (u : SobolevData Q) (u : SobolevData Q) + Kf ^ 2) * r ^ t) ∧
        (∀ N : ℕ,
          ∀ rho : ℝ → ℝ, ContDiff ℝ ∞ rho →
            (∀ tau : ℝ, 0 ≤ rho tau) →
            (∀ tau : ℝ, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) →
            (∫ tau, rho tau) = 1 →
          ∀ pvec : Fin d → ℝ, (∑ i : Fin d, (pvec i) ^ 2) = 1 →
          ∀ Cρ : ℝ, 0 ≤ Cρ →
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
              ∀ y : SpatialCoordinates d, y ∈ (Q : Set (SpatialCoordinates d)) →
                |faceBump rho pvec eps y| ≤ Cρ * eps⁻¹) →
          ∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
          ∀ v : meanZeroSobolevGraph Q,
            SolvesNeumann (a N omega) (faceBump rho pvec eps) v →
          ∀ x : SpatialCoordinates d, x ∈ (Q : Set (SpatialCoordinates d)) →
          ∀ r : ℝ, 0 < r → r ≤ 1 →
            localGradientEnergy (a N omega)
              (s := Metric.ball x r ∩ (Q : Set (SpatialCoordinates d)))
              (Metric.isOpen_ball.inter Q.isOpen).measurableSet
              (sobolevGradient (v : SobolevData Q)) ≤
                K N omega *
                  (sobolevCoefficientForm (a N omega)
                    (v : SobolevData Q) (v : SobolevData Q) +
                    Cρ ^ 2 * eps ^ (-2 : ℝ)) * r ^ t)) :
  ∃ delta0 : ℝ, 0 < delta0 ∧ ∃ Cbound : ℝ, 0 ≤ Cbound ∧
    ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
      (_Rm : in_responses d M) (Sreg : in_6_16 d M)
      (_It : in_iteration d M E Sreg)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
      InfraredCharacterization M H → M.delta ≤ delta0 →
    let Q : Opens (SpatialCoordinates d) := unitNeumannCube d
    let a : ℕ → BilateralField d → PositiveCoefficient Q :=
      fun N omega => cutoffPositiveCoefficient M H omega N
        (fun _ : Fin d => (1 / 2 : ℝ)) one_pos
    ∃ K : ℕ → BilateralField d → ℝ,
      (∀ N omega, 0 ≤ K N omega) ∧
      (∀ N, MemLp (K N) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure) ∧
      (∀ N, eLpNorm (K N) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal Cbound) ∧
      ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        (∀ N : ℕ,
          ∀ f : SpatialCoordinates d → ℝ,
            AEMeasurable f (volume.restrict (Q : Set (SpatialCoordinates d))) →
          ∀ Kf : ℝ, 0 ≤ Kf →
            (∀ᵐ y ∂volume.restrict (Q : Set (SpatialCoordinates d)),
              |f y| ≤ Kf) →
            (∫ y in (Q : Set (SpatialCoordinates d)), f y) = 0 →
          ∀ u : meanZeroSobolevGraph Q,
            SolvesNeumann (a N omega) f u →
          ∀ x : SpatialCoordinates d, x ∈ (Q : Set (SpatialCoordinates d)) →
          ∀ r : ℝ, 0 < r → r ≤ 1 →
            localGradientEnergy (a N omega)
              (s := Metric.ball x r ∩ (Q : Set (SpatialCoordinates d)))
              (Metric.isOpen_ball.inter Q.isOpen).measurableSet
              (sobolevGradient (u : SobolevData Q)) ≤
                K N omega *
                  (sobolevCoefficientForm (a N omega)
                    (u : SobolevData Q) (u : SobolevData Q) + Kf ^ 2) * r ^ t) ∧
        (∀ N : ℕ,
          ∀ rho : ℝ → ℝ, ContDiff ℝ ∞ rho →
            (∀ tau : ℝ, 0 ≤ rho tau) →
            (∀ tau : ℝ, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) →
            (∫ tau, rho tau) = 1 →
          ∀ pvec : Fin d → ℝ, (∑ i : Fin d, (pvec i) ^ 2) = 1 →
          ∀ Cρ : ℝ, 0 ≤ Cρ →
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
              ∀ y : SpatialCoordinates d, y ∈ (Q : Set (SpatialCoordinates d)) →
                |faceBump rho pvec eps y| ≤ Cρ * eps⁻¹) →
          ∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
          ∀ v : meanZeroSobolevGraph Q,
            SolvesNeumann (a N omega) (faceBump rho pvec eps) v →
          ∀ x : SpatialCoordinates d, x ∈ (Q : Set (SpatialCoordinates d)) →
          ∀ r : ℝ, 0 < r → r ≤ 1 →
            localGradientEnergy (a N omega)
              (s := Metric.ball x r ∩ (Q : Set (SpatialCoordinates d)))
              (Metric.isOpen_ball.inter Q.isOpen).measurableSet
              (sobolevGradient (v : SobolevData Q)) ≤
                K N omega *
                  (sobolevCoefficientForm (a N omega)
                    (v : SobolevData Q) (v : SobolevData Q) +
                    Cρ ^ 2 * eps ^ (-2 : ℝ)) * r ^ t) :=
  ⟨delta0, hδ0, Cbound, hCbound0, hmain⟩

theorem aux_lem_band_rem_bank_uniform_rem_resolved_Kbound
    (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (t t1 : ℝ) (qord : ℝ) (hqord : 1 ≤ qord) (ht_nn : 0 ≤ t) (hpq : qord ≤ 2 * qord * max 1 t)
    (Cm Cp Cmic Bunif : ℝ) (hCp : 0 ≤ Cp)
    (hA1 : 0 ≤ Cm * 2 ^ t1) (hA2 : 0 ≤ Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1))
    (hA3 : 0 ≤ Cmic * 2 ^ t) (hBunif0 : 0 ≤ Bunif)
    (U V De mlow mhigh : ℕ → BilateralField d → ℝ)
    (hU0 : ∀ N om, 0 ≤ U N om) (hV0 : ∀ N om, 0 ≤ V N om) (hDe0 : ∀ N om, 0 ≤ De N om)
    (hDeLp : ∀ N, MemLp (De N) (ENNReal.ofReal (2 * qord * max 1 t)) (chaosSampleLaw M).toMeasure)
    (hmLp : ∀ N, MemLp (fun om => mhigh N om + (mlow N om)⁻¹)
      (ENNReal.ofReal (2 * qord * max 1 t)) (chaosSampleLaw M).toMeasure)
    (hW : ∀ N : ℕ,
      MemLp (fun om => U N om * (1 + V N om)) (ENNReal.ofReal (2 * qord * max 1 t))
        (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun om => U N om * (1 + V N om)) (ENNReal.ofReal (2 * qord * max 1 t))
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (Cp * (1 + Cp)))
    (hstatM : ∀ N : ℕ,
      eLpNorm (fun om => (1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) *
          (U N om * (1 + V N om))) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal Bunif ∧
      eLpNorm (fun om => ‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bunif ∧
      eLpNorm (fun om => ‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) *
          (1 + De N om) ^ t) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal Bunif) :
    (∀ N om, 0 ≤ (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))) ∧
    (∀ N : ℕ,
      MemLp (fun om => (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure) ∧
    (∀ N : ℕ,
      eLpNorm (fun om => (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ((Cm * 2 ^ t1) * (Cp * (1 + Cp)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) * Bunif + (Cmic * 2 ^ t) * Bunif)) := by
  have hnn : ∀ N om, 0 ≤ (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
      (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
        ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
      (Cmic * 2 ^ t) *
        (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)) := by
    intro N om
    have h1 : 0 ≤ U N om * (1 + V N om) := mul_nonneg (hU0 N om) (by linarith [hV0 N om])
    have h2 : 0 ≤ (1 + De N om) ^ t := (Real.rpow_pos_of_pos (by linarith [hDe0 N om]) _).le
    have h3 : 0 ≤ ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) :=
      (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (by norm_num) _) _).le
    have h4 : 0 ≤ ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t) :=
      (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (by norm_num) _) _).le
    have h5 := norm_nonneg (mhigh N om + (mlow N om)⁻¹)
    exact add_nonneg (add_nonneg (mul_nonneg hA1 h1) (mul_nonneg hA2 (mul_nonneg (mul_nonneg h2 h3) h1)))
      (mul_nonneg hA3 (mul_nonneg h5 h4))
  have hmom : ∀ N : ℕ,
      MemLp (fun om => (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun om => (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ((Cm * 2 ^ t1) * (Cp * (1 + Cp)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) * Bunif + (Cmic * 2 ^ t) * Bunif) := by
    intro N
    have hBNN := hstatM N
    beta_reduce at hBNN
    have hWm := (hW N).1.aestronglyMeasurable
    have hDt := (aux_rem_resolved_microscopic_one_add_power_memLp (chaosSampleLaw M).toMeasure
      qord t hqord ht_nn (De N) (hDe0 N) (hDeLp N)).aestronglyMeasurable
    have hT1m : AEStronglyMeasurable (fun om =>
        (1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om)))
        (chaosSampleLaw M).toMeasure :=
      (hDt.mul aestronglyMeasurable_const).mul hWm
    have hT2m : AEStronglyMeasurable (fun om =>
        ‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
        (chaosSampleLaw M).toMeasure :=
      (hmLp N).norm.aestronglyMeasurable.mul aestronglyMeasurable_const
    have hWb : eLpNorm (fun om => U N om * (1 + V N om)) (ENNReal.ofReal qord)
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (Cp * (1 + Cp)) :=
      (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hpq)).trans (hW N).2
    exact aux_rem_resolved_three_term_moment (chaosSampleLaw M).toMeasure qord _ _ _
      (Cp * (1 + Cp)) Bunif hqord hA1 hA2 hA3 (by positivity) hBunif0 _ _ _ hWm hT1m hT2m hWb
      hBNN.1 hBNN.2.1 qord le_rfl
  exact ⟨hnn, fun N => (hmom N).1, fun N => (hmom N).2⟩

theorem aux_lem_band_rem_bank_uniform_rem_resolved_HW
    (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (t t1 qord : ℝ) (hqord : 1 ≤ qord) (ht_nn : 0 ≤ t) (hpq : qord ≤ 2 * qord * max 1 t)
    (hq1 : 1 ≤ 2 * qord * max 1 t)
    (Cm Cp Cmic : ℝ) (hCp0 : 0 ≤ Cp)
    (hA1 : 0 ≤ Cm * 2 ^ t1) (hA2 : 0 ≤ Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1))
    (hA3 : 0 ≤ Cmic * 2 ^ t)
    (Bunif : ℝ) (hBunif0 : 0 ≤ Bunif)
    (rmax Cde Cpe : ℝ)
    (hBunifMain : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P],
      ∀ p : ℝ, 1 ≤ p →
      let q := 2 * p * max 1 t
      ∀ D Mf mInv Kmac : ℕ → Ω → ℝ,
      ∀ aRate : ℝ, 0 ≤ aRate → aRate ≤ rmax / 2 →
      (∀ N w, 0 ≤ D N w ∧ 0 ≤ Mf N w ∧ 0 ≤ mInv N w ∧ 0 ≤ Kmac N w) →
      (∀ N, MemLp (D N) (ENNReal.ofReal q) P ∧ MemLp (Mf N) (ENNReal.ofReal q) P ∧
        MemLp (mInv N) (ENNReal.ofReal q) P ∧ MemLp (Kmac N) (ENNReal.ofReal q) P) →
      (∀ N, eLpNorm (D N) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (Cpe * Real.sqrt (1 + (N : ℝ)))) →
      (∀ N, eLpNorm (fun w => Mf N w + mInv N w) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (2 * Cpe * Real.exp (aRate * (N : ℝ)))) →
      (∀ N, eLpNorm (Kmac N) (ENNReal.ofReal q) P ≤ ENNReal.ofReal (Cp * (1 + Cp))) →
      ∀ N : ℕ,
        eLpNorm (fun w => (1 + D N w) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * Kmac N w)
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bunif ∧
        eLpNorm (fun w => mInv N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bunif ∧
        eLpNorm (fun w => Mf N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) * (1 + D N w) ^ t)
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bunif)
    (hrate1 : 0 ≤ Cde * M.delta + Cpe * M.delta ^ 2)
    (hrate2 : Cde * M.delta + Cpe * M.delta ^ 2 ≤ rmax / 2)
    (U V De mlow mhigh : ℕ → BilateralField d → ℝ)
    (hU0 : ∀ N om, 0 ≤ U N om) (hV0 : ∀ N om, 0 ≤ V N om) (hDe0 : ∀ N om, 0 ≤ De N om)
    (hULp : ∀ N, MemLp (U N) (ENNReal.ofReal (2 * (2 * qord * max 1 t)))
      (chaosSampleLaw M).toMeasure)
    (hVLp : ∀ N, MemLp (V N) (ENNReal.ofReal (2 * (2 * qord * max 1 t)))
      (chaosSampleLaw M).toMeasure)
    (hUb : ∀ N, eLpNorm (U N) (ENNReal.ofReal (2 * (2 * qord * max 1 t)))
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Cp)
    (hVb : ∀ N, eLpNorm (V N) (ENNReal.ofReal (2 * (2 * qord * max 1 t)))
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Cp)
    (hDeLp : ∀ N, MemLp (De N) (ENNReal.ofReal (2 * qord * max 1 t)) (chaosSampleLaw M).toMeasure)
    (hmLp : ∀ N, MemLp (fun om => mhigh N om + (mlow N om)⁻¹)
      (ENNReal.ofReal (2 * qord * max 1 t)) (chaosSampleLaw M).toMeasure)
    (hDeb : ∀ N, eLpNorm (De N) (ENNReal.ofReal (2 * qord * max 1 t))
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (Cpe * Real.sqrt (1 + (N : ℝ))))
    (hmb : ∀ N, eLpNorm (fun om => mhigh N om + (mlow N om)⁻¹)
      (ENNReal.ofReal (2 * qord * max 1 t)) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Cpe * Real.exp ((Cde * M.delta + Cpe * M.delta ^ 2) * (N : ℝ)))) :
    (∀ N om, 0 ≤ (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))) ∧
    (∀ N : ℕ,
      MemLp (fun om => (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure) ∧
    (∀ N : ℕ,
      eLpNorm (fun om => (Cm * 2 ^ t1) * (U N om * (1 + V N om)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) *
          ((1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U N om * (1 + V N om))) +
        (Cmic * 2 ^ t) *
          (‖mhigh N om + (mlow N om)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ((Cm * 2 ^ t1) * (Cp * (1 + Cp)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) * Bunif + (Cmic * 2 ^ t) * Bunif)) := by
  have hW : ∀ N : ℕ,
      MemLp (fun om => U N om * (1 + V N om)) (ENNReal.ofReal (2 * qord * max 1 t))
        (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun om => U N om * (1 + V N om)) (ENNReal.ofReal (2 * qord * max 1 t))
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (Cp * (1 + Cp)) := fun N =>
    aux_rem_resolved_UV_moment (chaosSampleLaw M).toMeasure (2 * qord * max 1 t) Cp hq1 hCp0
      (U N) (V N) (hULp N) (hVLp N) (hUb N) (hVb N)
  have hSb : ∀ N : ℕ,
      eLpNorm (fun om => ‖mhigh N om + (mlow N om)⁻¹‖ + ‖mhigh N om + (mlow N om)⁻¹‖)
        (ENNReal.ofReal (2 * qord * max 1 t)) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (2 * Cpe *
        Real.exp ((Cde * M.delta + Cpe * M.delta ^ 2) * (N : ℝ))) := by
    intro N
    have h2 : (fun om => ‖mhigh N om + (mlow N om)⁻¹‖ + ‖mhigh N om + (mlow N om)⁻¹‖) =
        fun om => 2 * ‖mhigh N om + (mlow N om)⁻¹‖ := by
      funext om; ring
    have hm := hmb N
    calc _ = ENNReal.ofReal 2 * eLpNorm (fun om => mhigh N om + (mlow N om)⁻¹)
            (ENNReal.ofReal (2 * qord * max 1 t)) (chaosSampleLaw M).toMeasure := by
          rw [h2, aux_rem_resolved_microscopic_nonneg_scalar_eLpNorm _ _ 2 (by norm_num),
            eLpNorm_norm _ (hmLp N).aestronglyMeasurable]
      _ ≤ ENNReal.ofReal 2 * ENNReal.ofReal
            (Cpe * Real.exp ((Cde * M.delta + Cpe * M.delta ^ 2) * (N : ℝ))) := by
          gcongr
      _ = _ := by rw [← ENNReal.ofReal_mul (by norm_num), mul_assoc]
  have hstatM : ∀ N : ℕ,
      eLpNorm (fun om => (1 + De N om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) *
          (U N om * (1 + V N om))) (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal Bunif ∧
      eLpNorm (fun om => ‖mhigh N om + (mlow N om)⁻¹‖ *
          ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bunif ∧
      eLpNorm (fun om => ‖mhigh N om + (mlow N om)⁻¹‖ *
          ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) * (1 + De N om) ^ t)
        (ENNReal.ofReal qord) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bunif := fun N =>
    hBunifMain (BilateralField d) (chaosSampleLaw M).toMeasure qord hqord De
      (fun N om => ‖mhigh N om + (mlow N om)⁻¹‖) (fun N om => ‖mhigh N om + (mlow N om)⁻¹‖)
      (fun N om => U N om * (1 + V N om)) (Cde * M.delta + Cpe * M.delta ^ 2)
      hrate1 hrate2
      (fun N om => ⟨hDe0 N om, norm_nonneg _, norm_nonneg _,
        mul_nonneg (hU0 N om) (by linarith [hV0 N om])⟩)
      (fun N => ⟨hDeLp N, (hmLp N).norm, (hmLp N).norm, (hW N).1⟩)
      hDeb hSb (fun N => (hW N).2) N
