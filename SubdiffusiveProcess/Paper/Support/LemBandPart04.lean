theorem aux_lem_band_rb_uniform_coercivity
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (P : Paper.in_poincare d hd E)
    (S : SubdiffusiveProcess.Lane4.SobolevFoundationalInput d hd)
    (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (hr1 : r ≤ 1) :
    ∃ delta0 : ℝ → ℝ, (∀ p : ℝ, 1 ≤ p → 0 < delta0 p) ∧
    ∃ Cbound : ℝ → ℝ, (∀ p : ℝ, 1 ≤ p → 0 ≤ Cbound p) ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H →
        ∃ K : ℕ → BilateralField d → ℝ,
          (∀ (N : ℕ) (om : BilateralField d),
            (∀ v : killedSobolevGraph (centeredCube z r hr),
              cubeFractionalL2Seminorm hd z r hr threeQuarterOrder
                  (fun _ : Fin 1 => (v : SobolevData (centeredCube z r hr)).1) < ⊤ ∧
              cubeFractionalSqNorm hd z r hr threeQuarterOrder
                  (v : SobolevData (centeredCube z r hr)).1 ≤
                K N om * sobolevCoefficientForm (cutoffPositiveCoefficient M H om N z hr)
                  (v : SobolevData (centeredCube z r hr))
                  (v : SobolevData (centeredCube z r hr))) ∧
            (∀ v : meanZeroSobolevGraph (centeredCube z r hr),
              cubeFractionalL2Seminorm hd z r hr threeQuarterOrder
                  (fun _ : Fin 1 => (v : SobolevData (centeredCube z r hr)).1) < ⊤ ∧
              cubeFractionalSqNorm hd z r hr threeQuarterOrder
                  (v : SobolevData (centeredCube z r hr)).1 ≤
                K N om * sobolevCoefficientForm (cutoffPositiveCoefficient M H om N z hr)
                  (v : SobolevData (centeredCube z r hr))
                  (v : SobolevData (centeredCube z r hr)))) ∧
          (∀ p : ℝ, 1 ≤ p → M.delta ≤ delta0 p →
            ∀ N, MemLp (K N) (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ∧
              eLpNorm (K N) (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
                ENNReal.ofReal (Cbound p)) := by
  obtain ⟨delta0, hdelta0pos, Cbound, hCbound0, hmoment⟩ :=
    aux_lem_band_rb_uniform_lambda_inv_moments d hd E z r hr hr1
  refine ⟨delta0, hdelta0pos, ?_⟩
  have hs : (1 / 8 : ℝ) ∈ Set.Ioo (0 : ℝ) (1 / 4) := by constructor <;> norm_num
  obtain ⟨C, hC, hunit⟩ := lane4_besov_h34_coercivity d hd E P S (1 / 8 : ℝ) hs
  have horigin :
      ∀ (h1 : (0 : ℝ) < 1)
        (a : PositiveCoefficient (centeredCube (0 : SpatialCoordinates d) 1 h1)),
        (∀ v : killedSobolevGraph (centeredCube (0 : SpatialCoordinates d) 1 h1),
          cubeFractionalSqNorm hd (0 : SpatialCoordinates d) 1 h1 threeQuarterOrder
              (v : SobolevData (centeredCube (0 : SpatialCoordinates d) 1 h1)).1 ≤
            C * (E.lam (0 : SpatialCoordinates d) 1 h1 a
              (0 : SpatialCoordinates d) 1 (1 / 8 : ℝ) 1)⁻¹ *
              sobolevCoefficientForm a
                (v : SobolevData (centeredCube (0 : SpatialCoordinates d) 1 h1))
                (v : SobolevData (centeredCube (0 : SpatialCoordinates d) 1 h1))) ∧
        (∀ v : meanZeroSobolevGraph (centeredCube (0 : SpatialCoordinates d) 1 h1),
          cubeFractionalSqNorm hd (0 : SpatialCoordinates d) 1 h1 threeQuarterOrder
              (v : SobolevData (centeredCube (0 : SpatialCoordinates d) 1 h1)).1 ≤
            C * (E.lam (0 : SpatialCoordinates d) 1 h1 a
              (0 : SpatialCoordinates d) 1 (1 / 8 : ℝ) 1)⁻¹ *
              sobolevCoefficientForm a
                (v : SobolevData (centeredCube (0 : SpatialCoordinates d) 1 h1))
                (v : SobolevData (centeredCube (0 : SpatialCoordinates d) 1 h1))) := by
    intro h1 a
    exact ⟨fun v => (hunit (0 : SpatialCoordinates d) h1 a).1 v |>.2,
      fun v => (hunit (0 : SpatialCoordinates d) h1 a).2 v |>.2⟩
  obtain ⟨C', hC', hcoercive⟩ :=
    lane4_coercivity_dilation d hd E (1 / 8 : ℝ) hs C hC horigin z r hr hr1
  refine ⟨fun p => C' * Cbound p, fun p hp => mul_nonneg hC'.le (hCbound0 p hp), ?_⟩
  intro M Rm H hH
  refine ⟨fun N om => C' * (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r
      (1 / 8 : ℝ) 1)⁻¹, ?_, ?_⟩
  · intro N om
    refine ⟨?_, ?_⟩
    · intro v
      have hu : (v : SobolevData (centeredCube z r hr)) ∈
          weakSobolevGraph (centeredCube z r hr) :=
        killedSobolevGraph_le_weakSobolevGraph v.property
      let u : weakSobolevGraph (centeredCube z r hr) :=
        ⟨(v : SobolevData (centeredCube z r hr)), hu⟩
      have hfinite := S.h1_fractional_finite z r hr u
      refine ⟨?_, ?_⟩
      · simpa [u] using hfinite
      · exact (hcoercive (cutoffPositiveCoefficient M H om N z hr)).1 v
    · intro v
      have hu : (v : SobolevData (centeredCube z r hr)) ∈
          weakSobolevGraph (centeredCube z r hr) :=
        (inf_le_left : meanZeroSobolevGraph (centeredCube z r hr) ≤
          weakSobolevGraph (centeredCube z r hr)) v.property
      let u : weakSobolevGraph (centeredCube z r hr) :=
        ⟨(v : SobolevData (centeredCube z r hr)), hu⟩
      have hfinite := S.h1_fractional_finite z r hr u
      refine ⟨?_, ?_⟩
      · simpa [u] using hfinite
      · exact (hcoercive (cutoffPositiveCoefficient M H om N z hr)).2 v
  · intro p hp hδ N
    obtain ⟨hmemp, hboundp⟩ := hmoment M Rm H hH p hp hδ N
    refine ⟨hmemp.const_mul C', ?_⟩
    show eLpNorm (fun om : BilateralField d => C' *
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r (1 / 8 : ℝ) 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (C' * Cbound p)
    rw [show (fun om : BilateralField d => C' *
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r (1 / 8 : ℝ) 1)⁻¹) =
        C' • (fun om : BilateralField d =>
          (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r (1 / 8 : ℝ) 1)⁻¹) from rfl,
      eLpNorm_const_smul, Real.enorm_eq_ofReal hC'.le, ENNReal.ofReal_mul hC'.le]
    gcongr

theorem aux_lem_band_gu_above_core_unif {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : in_J d) (p ε : ℝ) (hp : 1 ≤ p) (hε : 0 < ε) :
    ∃ δ0 C1 : ℝ, 0 < δ0 ∧ 0 < C1 ∧
      ∀ (z0 : SpatialCoordinates d) (R : ℝ) (hR : 0 < R),
      ∃ C0 : ℝ, 0 < C0 ∧
        ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
          (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
          InfraredCharacterization M H → M.delta ≤ δ0 →
        ∀ (w : SpatialCoordinates d) (N k : ℕ), k ≤ N →
          (centeredCube w ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR) →
        ∀ n : ℕ, k + n ≤ N →
        ∀ Q ∈ descendantsAtScale (originCube d 0) ((originCube d 0).scale - (n : ℤ)),
        ∀ a : BilateralField d → CoeffOn (cubeDomain Q),
          (∀ om, ∀ᵐ x ∂volumeMeasureOn (openCubeSet Q),
            (a om).toCoeffField x = scalarMatrix (cutoffCoefficient M H om N
              (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i))) →
          SubdiffusiveProcess.RawLp.eLpNorm (fun om => matrixNorm (Homogenization.Book.Ch02.bCoarse (cubeDomain Q) (a om)))
              (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (C0 * Real.exp (C1 * M.delta ^ 2 * k + ε * n)) ∧
          SubdiffusiveProcess.RawLp.eLpNorm (fun om => matrixNorm (Homogenization.Book.Ch02.sigmaStarInvCoarse
                (cubeDomain Q) (a om)))
              (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (C0 * Real.exp (C1 * M.delta ^ 2 * k + ε * n)) := by
  haveI : NeZero d := ⟨by omega⟩
  have hp0 : 0 < p := by linarith
  have hp2 : 0 < 2 * p := by positivity
  obtain ⟨δresp, CJ, hδresp, hCJ, hresponse⟩ :=
    aux_lem_extension_cell_moment_matched_response hd I p hp
  obtain ⟨CH, hCH, hHM⟩ := aux_lem_extension_cell_moment_aboveEnvelope_moment hd
  let B := aux_lem_extension_cell_moment_aboveRate d (2 * p)
  have hB : 0 < B := aux_lem_extension_cell_moment_aboveRate_pos d (2 * p) hp2
  let δrate := Real.sqrt (ε / B)
  have hδrate : 0 < δrate := Real.sqrt_pos.2 (div_pos hε hB)
  refine ⟨min δresp δrate, B, lt_min hδresp hδrate, hB, ?_⟩
  intro z0 R hR
  let K : Compacts (SpatialCoordinates d) := ⟨Metric.closedBall z0 R, isCompact_closedBall _ _⟩
  let Pu := Real.log 4 / (2 * p) + 4 * (2 * p) * CH K * (min δresp δrate) ^ 2 +
    B * (min δresp δrate) ^ 2
  let C0 := 2 * (CJ + 1) * Real.exp Pu
  refine ⟨C0, by dsimp [C0]; positivity, ?_⟩
  intro M H hH hδ w N k _hk hcell n habove Q hQ a ha
  have hrate : B * M.delta ^ 2 ≤ ε := by
    have hsq : M.delta ^ 2 ≤ δrate ^ 2 :=
      pow_le_pow_left₀ M.shellPrefix.delta_pos.le (hδ.trans (min_le_right _ _)) 2
    calc
      _ ≤ B * δrate ^ 2 := mul_le_mul_of_nonneg_left hsq hB.le
      _ = ε := by dsimp [δrate]; rw [Real.sq_sqrt (div_pos hε hB).le]; field_simp
  obtain ⟨family, J, hfamily, hJgreat, hJmeas, hJnorm⟩ :=
    hresponse M (hδ.trans (min_le_left _ _))
  let Pm := Real.log 4 / (2 * p) + 4 * (2 * p) * CH K * M.delta ^ 2 + B * M.delta ^ 2
  let m := k + n
  let c := w + (3 : ℝ) ^ (-(k : ℤ)) • cubeCenter Q
  let T := aux_lem_extension_cell_moment_zoom (m : ℤ) c
  have hT : MeasurePreserving T (chaosSampleLaw M).toMeasure (chaosSampleLaw M).toMeasure :=
    aux_lem_extension_cell_moment_zoom_measurePreserving M (m : ℤ) c
  let F : BilateralField d → ℝ := fun om =>
    Real.exp (aux_lem_extension_cell_moment_aboveLogEnvelope M H K m c om)
  let X : BilateralField d → ℝ := fun om => J (N - m) (T om) + 1
  have hJ0 : ∀ om, 0 ≤ J (N - m) (T om) := by
    intro om
    obtain ⟨e, _, he⟩ := (hJgreat (N - m) (T om)).1
    rw [he]
    exact Homogenization.Book.Ch02.responseJ_nonneg _ _ _ _
  have hX0 : ∀ om, 0 ≤ X om := fun om => by dsimp [X]; linarith [hJ0 om]
  have hJTm : AEStronglyMeasurable (fun om => J (N - m) (T om))
      (chaosSampleLaw M).toMeasure := (hJmeas (N - m)).comp_measurePreserving hT
  have hXm : AEStronglyMeasurable X (chaosSampleLaw M).toMeasure :=
    hJTm.add aestronglyMeasurable_const
  have hFm : AEStronglyMeasurable F (chaosSampleLaw M).toMeasure :=
    (aux_lem_extension_cell_moment_aboveEnvelope_measurable M H hH.1 K m c).exp.aestronglyMeasurable
  have hXnorm : eLpNorm X (ENNReal.ofReal (2 * p)) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (CJ + 1) := by
    have hJT : eLpNorm (fun om => J (N - m) (T om)) (ENNReal.ofReal (2 * p))
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal CJ := by
      change eLpNorm (J (N - m) ∘ T) (ENNReal.ofReal (2 * p))
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal CJ
      rw [eLpNorm_comp_measurePreserving (hJmeas (N - m)) hT]
      exact hJnorm (N - m)
    have hone : eLpNorm (fun _ : BilateralField d => (1 : ℝ)) (ENNReal.ofReal (2 * p))
        (chaosSampleLaw M).toMeasure = 1 := by
      rw [eLpNorm_const' _ (ENNReal.ofReal_ne_zero_iff.mpr hp2) ENNReal.ofReal_ne_top]
      simp
    have hpone : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 * p) := by
      simpa only [ENNReal.ofReal_one] using
        (ENNReal.ofReal_le_ofReal (show (1 : ℝ) ≤ 2 * p by linarith))
    have hadd := eLpNorm_add_le (μ := (chaosSampleLaw M).toMeasure) (f := fun om => J (N - m) (T om)) (g := fun _ => (1 : ℝ)) hpone
    refine hadd.trans ?_
    rw [hone, ENNReal.ofReal_add hCJ.le zero_le_one, ENNReal.ofReal_one]
    exact add_le_add hJT (le_refl _)
  have hFnorm : eLpNorm F (ENNReal.ofReal (2 * p)) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Real.exp (Pm + B * M.delta ^ 2 * m)) := hHM M H hH K m c (2 * p) hp2
  have hproduct : eLpNorm (fun om => F om * X om) (ENNReal.ofReal p)
      (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Real.exp (Pm + B * M.delta ^ 2 * m)) * ENNReal.ofReal (CJ + 1) :=
    (aux_lem_extension_cell_moment_eLpNorm_mul (chaosSampleLaw M).toMeasure p hp0 F X hFm hXm).trans
      (mul_le_mul' hFnorm hXnorm)
  have hKmem : ∀ x ∈ openCubeSet Q,
      (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) ∈ (K : Set (SpatialCoordinates d)) := by
    intro x hx
    have hxroot : x ∈ openCubeSet (originCube d 0) :=
      openCubeSet_subset_of_mem_descendantsAtScale (by simp) hQ hx
    have hyroot := hcell (aux_lem_extension_cell_moment_cellAffine_mem w _ (by positivity) hxroot)
    change dist (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) z0 ≤ R
    change dist (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) z0 < R / 2 at hyroot
    linarith
  have hpoint : ∀ om,
      matrixNorm (Homogenization.Book.Ch02.bCoarse (cubeDomain Q) (a om)) ≤ 2 * (F om * X om) ∧
        matrixNorm (Homogenization.Book.Ch02.sigmaStarInvCoarse (cubeDomain Q) (a om)) ≤
          2 * (F om * X om) := by
    intro om
    exact aux_lem_extension_cell_moment_above_coarse_pointwise M H K N k n habove Q hQ w hKmem
      om (a om) (ha om) ((family (N - m) (T om)).coeffOn (originCube d 0))
      (hfamily (N - m) (T om) (originCube d 0)) (J (N - m) (T om)) (hJgreat (N - m) (T om))
  have hgrowth : B * M.delta ^ 2 * (m : ℝ) ≤ B * M.delta ^ 2 * k + ε * n := by
    dsimp [m]
    rw [Nat.cast_add, mul_add]
    exact add_le_add (le_refl _) (mul_le_mul_of_nonneg_right hrate (by positivity))
  have hPmPu : Pm ≤ Pu := by
    have hsqd : M.delta ^ 2 ≤ (min δresp δrate) ^ 2 :=
      pow_le_pow_left₀ M.shellPrefix.delta_pos.le hδ 2
    have hCHK : 0 ≤ CH K := hCH K
    have h1 : 4 * (2 * p) * CH K * M.delta ^ 2 ≤ 4 * (2 * p) * CH K * (min δresp δrate) ^ 2 :=
      mul_le_mul_of_nonneg_left hsqd (by positivity)
    have h2 : B * M.delta ^ 2 ≤ B * (min δresp δrate) ^ 2 :=
      mul_le_mul_of_nonneg_left hsqd hB.le
    dsimp only [Pm, Pu]
    linarith
  have hCmle : 2 * (CJ + 1) * Real.exp Pm ≤ C0 := by
    dsimp only [C0]
    exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hPmPu) (by positivity)
  have hfinish : ENNReal.ofReal 2 *
      (ENNReal.ofReal (Real.exp (Pm + B * M.delta ^ 2 * m)) * ENNReal.ofReal (CJ + 1)) ≤
      ENNReal.ofReal (C0 * Real.exp (B * M.delta ^ 2 * k + ε * n)) := by
    rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← ENNReal.ofReal_mul (by norm_num)]
    apply ENNReal.ofReal_le_ofReal
    rw [Real.exp_add]
    calc
      2 * (Real.exp Pm * Real.exp (B * M.delta ^ 2 * m) * (CJ + 1))
          = (2 * (CJ + 1) * Real.exp Pm) * Real.exp (B * M.delta ^ 2 * m) := by ring
        _ ≤ C0 * Real.exp (B * M.delta ^ 2 * m) :=
          mul_le_mul_of_nonneg_right hCmle (Real.exp_pos _).le
        _ ≤ C0 * Real.exp (B * M.delta ^ 2 * k + ε * n) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hgrowth) (by dsimp [C0]; positivity)
  have hbound : ∀ Z : BilateralField d → ℝ, (∀ om, 0 ≤ Z om) →
      (∀ om, Z om ≤ 2 * (F om * X om)) →
      SubdiffusiveProcess.RawLp.eLpNorm Z (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (C0 * Real.exp (B * M.delta ^ 2 * k + ε * n)) := by
    intro Z hZ0 hZ
    have hz : SubdiffusiveProcess.RawLp.eLpNorm Z (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal 2 * eLpNorm (fun om => F om * X om) (ENNReal.ofReal p)
          (chaosSampleLaw M).toMeasure := by
      apply le_trans (SubdiffusiveProcess.RawLp.eLpNorm_mono_ae (g := fun om => 2 * (F om * X om)) ?_)
      · apply le_trans (SubdiffusiveProcess.RawLp.eLpNorm_le_guarded _ _ _)
        apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul
          (aestronglyMeasurable_const.mul (hFm.mul hXm))
        filter_upwards with om
        simp only [Pi.mul_apply]
        rw [Real.norm_of_nonneg (mul_nonneg (by norm_num) (mul_nonneg (Real.exp_pos _).le (hX0 om))), Real.norm_of_nonneg (mul_nonneg (Real.exp_pos _).le (hX0 om))]
      filter_upwards with om
      rw [Real.norm_of_nonneg (hZ0 om), Real.norm_of_nonneg (mul_nonneg (by norm_num) (mul_nonneg (Real.exp_pos _).le (hX0 om)))]
      exact hZ om
    exact (hz.trans (mul_le_mul_right hproduct _)).trans hfinish
  constructor
  · exact hbound _ (fun _ => matrixNorm_nonneg _) (fun om => (hpoint om).1)
  · exact hbound _ (fun _ => matrixNorm_nonneg _) (fun om => (hpoint om).2)

theorem aux_lem_band_gu_below_extremes_unif {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (p ε : ℝ) (hp : 0 < p) (hε : 0 < ε) :
    ∃ δ0 C1 : ℝ, 0 < δ0 ∧ 0 < C1 ∧
      ∀ (z0 : SpatialCoordinates d) (R : ℝ) (hR : 0 < R),
      ∃ C0 : ℝ, 0 < C0 ∧
        ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
          (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
          InfraredCharacterization M H → M.delta ≤ δ0 →
        ∀ (w : SpatialCoordinates d) (N k : ℕ), k ≤ N →
          (centeredCube w ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR) →
        ∀ n : ℕ, N < k + n →
        ∀ Q ∈ descendantsAtScale (originCube d 0) ((originCube d 0).scale - (n : ℤ)),
        ∃ lo hi : BilateralField d → ℝ,
          (∀ om, 0 < lo om ∧ lo om ≤ hi om ∧
            ∀ x ∈ openCubeSet Q,
              lo om ≤ cutoffCoefficient M H om N
                  (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) ∧
                cutoffCoefficient M H om N
                  (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) ≤ hi om) ∧
          eLpNorm (fun om => 4 * (d : ℝ) * (lo om)⁻¹ * hi om ^ 2 +
              4 * (d : ℝ) * (lo om)⁻¹)
              (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (C0 * Real.exp (C1 * M.delta ^ 2 * k + ε * n)) := by
  let B : ℝ := 6 * Real.log 2 + 9 * p *
    (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2
  have hB : 0 < B := by dsimp [B]; positivity
  let δ0 := Real.sqrt (ε / B)
  have hδ0 : 0 < δ0 := Real.sqrt_pos.2 (div_pos hε hB)
  obtain ⟨C, hC, hCM⟩ := aux_lem_extension_cell_moment_totalLogNorm_eLpNorm hd
  refine ⟨δ0, B, hδ0, hB, ?_⟩
  intro z0 R hR
  let K : Compacts (SpatialCoordinates d) := ⟨Metric.closedBall z0 R, isCompact_closedBall _ _⟩
  let Pu : ℝ := Real.log 4 / p + 36 * p * C K * δ0 ^ 2
  let C0 : ℝ := 8 * (d : ℝ) * Real.exp Pu
  have hdR : 0 < (d : ℝ) := by exact_mod_cast (show 0 < d by omega)
  refine ⟨C0, by dsimp [C0]; positivity, ?_⟩
  intro M H hH hδ w N k _hk hcell n hbelow Q hQ
  have hrate : B * M.delta ^ 2 ≤ ε := by
    have hsq : M.delta ^ 2 ≤ δ0 ^ 2 :=
      pow_le_pow_left₀ M.shellPrefix.delta_pos.le hδ 2
    calc
      B * M.delta ^ 2 ≤ B * δ0 ^ 2 := mul_le_mul_of_nonneg_left hsq hB.le
      _ = ε := by
        dsimp [δ0]
        rw [Real.sq_sqrt (div_pos hε hB).le]
        field_simp
  let Pm : ℝ := Real.log 4 / p + 36 * p * C K * M.delta ^ 2
  let z : SpatialCoordinates d :=
    (3 : ℝ) ^ (N : ℤ) • (w + (3 : ℝ) ^ (-(k : ℤ)) • Homogenization.cubeCenter Q)
  let G : BilateralField d → ℝ := fun om =>
    ‖(H om).restrict (K : Set (SpatialCoordinates d))‖ +
      aux_lem_extension_cell_moment_physicalLogNorm M N z om
  have hG0 : ∀ om, 0 ≤ G om := by
    intro om
    exact add_nonneg (norm_nonneg _) (norm_nonneg _)
  let lo : BilateralField d → ℝ := fun om => Real.exp (-G om)
  let hi : BilateralField d → ℝ := fun om => Real.exp (G om)
  have hloinv : ∀ om, (lo om)⁻¹ = hi om := by
    intro om
    dsimp [lo, hi]
    rw [Real.exp_neg, inv_inv]
  refine ⟨lo, hi, ?_, ?_⟩
  · intro om
    refine ⟨Real.exp_pos _, Real.exp_le_exp.mpr (by have := hG0 om; linarith), ?_⟩
    intro x hx
    let ξ : SpatialCoordinates d :=
      (3 : ℝ) ^ ((N : ℤ) - (k : ℤ)) • (x - Homogenization.cubeCenter Q)
    have hξ := aux_lem_extension_cell_moment_descendant_micro_mem N k n hbelow Q hQ x hx
    have hid := aux_lem_extension_cell_moment_descendant_micro_identity N k Q w x
    have hxroot : x ∈ Homogenization.openCubeSet (Homogenization.originCube d 0) :=
      Homogenization.openCubeSet_subset_of_mem_descendantsAtScale (by simp) hQ hx
    have hyroot : (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) ∈
        (centeredCube z0 R hR : Set (SpatialCoordinates d)) :=
      hcell (aux_lem_extension_cell_moment_cellAffine_mem w _ (by positivity) hxroot)
    have hyK : (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) ∈
        (K : Set (SpatialCoordinates d)) := by
      change dist (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) z0 ≤ R
      change dist (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) z0 < R / 2 at hyroot
      linarith
    have hHpt : |H om (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i)| ≤
        ‖(H om).restrict (K : Set (SpatialCoordinates d))‖ :=
      ContinuousMap.norm_coe_le_norm ((H om).restrict (K : Set (SpatialCoordinates d))) ⟨_, hyK⟩
    have hlog := aux_lem_extension_cell_moment_physicalLogNorm_bounds M H N z ξ hξ om
    rw [hid] at hlog
    have hbound : |Real.log (cutoffCoefficient M H om N
        (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i))| ≤ G om :=
      hlog.trans (add_le_add hHpt (le_refl _))
    have hpos : 0 < cutoffCoefficient M H om N
        (fun i => w i + (3 : ℝ) ^ (-(k : ℤ)) * x i) :=
      mul_pos (inv_pos.mpr (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M N)) (Real.exp_pos _)
    obtain ⟨hlo, hhi⟩ := abs_le.mp hbound
    constructor
    · exact (Real.exp_le_exp.mpr hlo).trans_eq (Real.exp_log hpos)
    · exact (Real.exp_log hpos).symm.trans_le (Real.exp_le_exp.mpr hhi)
  · have henv : ∀ om,
        4 * (d : ℝ) * (lo om)⁻¹ * hi om ^ 2 + 4 * (d : ℝ) * (lo om)⁻¹ ≤
          (8 * (d : ℝ)) * Real.exp (3 * G om) := by
      intro om
      have hh : hi om * hi om ^ 2 = Real.exp (3 * G om) := by
        change Real.exp (G om) * Real.exp (G om) ^ 2 = Real.exp (3 * G om)
        rw [show 3 * G om = G om + G om + G om by ring,
          Real.exp_add (G om + G om) (G om), Real.exp_add (G om) (G om)]
        ring
      have hh' : hi om ≤ Real.exp (3 * G om) :=
        Real.exp_le_exp.mpr (by have := hG0 om; linarith)
      rw [hloinv]
      calc
        _ = 4 * (d : ℝ) * (hi om * hi om ^ 2) + 4 * (d : ℝ) * hi om := by ring
        _ ≤ 4 * (d : ℝ) * Real.exp (3 * G om) + 4 * (d : ℝ) * Real.exp (3 * G om) := by
          rw [hh]
          exact add_le_add (le_refl _) (mul_le_mul_of_nonneg_left hh' (by positivity))
        _ = _ := by ring
    have hnorm : eLpNorm (fun om => 4 * (d : ℝ) * (lo om)⁻¹ * hi om ^ 2 +
        4 * (d : ℝ) * (lo om)⁻¹) (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (8 * (d : ℝ)) *
          eLpNorm (fun om => Real.exp (3 * G om)) (ENNReal.ofReal p)
            (chaosSampleLaw M).toMeasure := by
      have hGm : Measurable G :=
        (((ContinuousMap.continuous_restrict (K : Set (SpatialCoordinates d))).norm.measurable).comp hH.1).add
          (aux_lem_extension_cell_moment_physicalLogNorm_measurable M N z)
      have hhim := hGm.exp
      have hlom := hGm.neg.exp
      apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul
        ((measurable_const.mul hlom.inv).mul (hhim.pow_const 2) |>.add
          (measurable_const.mul hlom.inv)).aestronglyMeasurable
      filter_upwards with om
      rw [Real.norm_of_nonneg (by dsimp [lo, hi]; positivity),
        Real.norm_of_nonneg (Real.exp_pos _).le]
      exact henv om
    have hGe : eLpNorm (fun om => Real.exp (3 * G om)) (ENNReal.ofReal p)
        (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (Real.exp (Pm + B * M.delta ^ 2 * ((N : ℝ) + 1))) := by
      have h := hCM M H hH K N z 3 p (by norm_num) hp
      convert h using 2 <;> dsimp [G, Pm, B] <;> congr 1 <;> ring
    have hNl : (N : ℝ) + 1 ≤ (k : ℝ) + (n : ℝ) := by
      exact_mod_cast (show N + 1 ≤ k + n by omega)
    have hgrowth : B * M.delta ^ 2 * ((N : ℝ) + 1) ≤
        B * M.delta ^ 2 * k + ε * n := by
      calc
        _ ≤ B * M.delta ^ 2 * ((k : ℝ) + n) :=
          mul_le_mul_of_nonneg_left hNl (by positivity)
        _ = B * M.delta ^ 2 * k + (B * M.delta ^ 2) * n := by ring
        _ ≤ _ := add_le_add (le_refl _) (mul_le_mul_of_nonneg_right hrate (by positivity))
    have hPmPu : Pm ≤ Pu := by
      have hsqd : M.delta ^ 2 ≤ δ0 ^ 2 := pow_le_pow_left₀ M.shellPrefix.delta_pos.le hδ 2
      have hCK : 0 ≤ C K := hC K
      have h1 : 36 * p * C K * M.delta ^ 2 ≤ 36 * p * C K * δ0 ^ 2 :=
        mul_le_mul_of_nonneg_left hsqd (by positivity)
      dsimp only [Pm, Pu]
      linarith
    have hCmle : 8 * (d : ℝ) * Real.exp Pm ≤ C0 := by
      dsimp only [C0]
      exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hPmPu) (by positivity)
    calc
      _ ≤ ENNReal.ofReal (8 * (d : ℝ)) *
          ENNReal.ofReal (Real.exp (Pm + B * M.delta ^ 2 * ((N : ℝ) + 1))) :=
        hnorm.trans (mul_le_mul_right hGe _)
      _ = ENNReal.ofReal ((8 * (d : ℝ) * Real.exp Pm) *
          Real.exp (B * M.delta ^ 2 * ((N : ℝ) + 1))) := by
        rw [← ENNReal.ofReal_mul (by positivity), Real.exp_add]
        congr 1
        ring
      _ ≤ ENNReal.ofReal (C0 * Real.exp (B * M.delta ^ 2 * ((N : ℝ) + 1))) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hCmle (Real.exp_pos _).le)
      _ ≤ _ := ENNReal.ofReal_le_ofReal
        (mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hgrowth) (by dsimp [C0]; positivity))

theorem aux_lem_band_gu_descBridge_unif {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) (p ε : ℝ) (hp : 1 ≤ p) (hε : 0 < ε) :
    ∃ δ0 C1 : ℝ, 0 < δ0 ∧ 0 < C1 ∧
      ∀ (z0 : SpatialCoordinates d) (R : ℝ) (hR : 0 < R),
      ∃ C0 : ℝ, 0 < C0 ∧
        ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (_Rm : in_responses d M)
          (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
          InfraredCharacterization M H → M.delta ≤ δ0 →
        ∀ (w : SpatialCoordinates d) (N k : ℕ), k ≤ N →
          (centeredCube w ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR) →
        ∀ n : ℕ,
        ∀ Q ∈ Homogenization.descendantsAtScale (Homogenization.originCube d 0)
            ((Homogenization.originCube d 0).scale - (n : ℤ)),
        eLpNorm (fun om =>
            Homogenization.Book.Ch02.coarseBMatrixNorm Q
              (E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w
                ((3 : ℝ) ^ (-(k : ℤ)))))
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C0 * Real.exp (C1 * M.delta ^ 2 * k + ε * n)) ∧
        eLpNorm (fun om =>
            Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm Q
              (E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w
                ((3 : ℝ) ^ (-(k : ℤ)))))
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C0 * Real.exp (C1 * M.delta ^ 2 * k + ε * n)) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le one_pos hp
  obtain ⟨δa, Ca, hδa, hCa, hAcore⟩ := aux_lem_band_gu_above_core_unif hd E p ε hp hε
  obtain ⟨δb, Cb, hδb, hCb, hBext⟩ := aux_lem_band_gu_below_extremes_unif hd p ε hp0 hε
  refine ⟨min δa δb, max Ca Cb, lt_min hδa hδb, lt_max_of_lt_left hCa, ?_⟩
  intro z0 R hR
  obtain ⟨C0a, hC0a, hA⟩ := hAcore z0 R hR
  obtain ⟨C0b, hC0b, hB⟩ := hBext z0 R hR
  refine ⟨max C0a C0b, lt_max_of_lt_left hC0a, ?_⟩
  haveI : NeZero d := ⟨by omega⟩
  intro M _Rm H hH hδ w N k hk hcell n Q hQ
  have hmono : ∀ {C0' C1' : ℝ}, 0 ≤ C0' → C0' ≤ max C0a C0b → C1' ≤ max Ca Cb →
      ENNReal.ofReal (C0' * Real.exp (C1' * M.delta ^ 2 * k + ε * n)) ≤
        ENNReal.ofReal (max C0a C0b * Real.exp (max Ca Cb * M.delta ^ 2 * k + ε * n)) := by
    intro C0' C1' h0 hC0' hC1'
    refine ENNReal.ofReal_le_ofReal ?_
    have hδk : 0 ≤ M.delta ^ 2 * (k : ℝ) := by positivity
    have hexp : Real.exp (C1' * M.delta ^ 2 * k + ε * n) ≤
        Real.exp (max Ca Cb * M.delta ^ 2 * k + ε * n) := by
      refine Real.exp_le_exp.mpr ?_
      have := mul_le_mul_of_nonneg_right hC1' hδk
      nlinarith [this]
    exact mul_le_mul hC0' hexp (Real.exp_pos _).le (le_trans h0 hC0')
  rcases le_or_gt (k + n) N with hkn | hkn
  · have h1 := hA M H hH (hδ.trans (min_le_left _ _)) w N k hk hcell n hkn Q hQ
      (fun om => (E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w
        ((3 : ℝ) ^ (-(k : ℤ)))).coeffOn Q)
      (fun om => aux_lem_extension_cell_moment_chart_scalar_identity E M H om N z0 R hR w _
        (by positivity) hcell Q
        (Homogenization.openCubeSet_subset_of_mem_descendantsAtScale (by simp) hQ))
    have hQsub := Homogenization.openCubeSet_subset_of_mem_descendantsAtScale (by simp) hQ
    have hbm : AEStronglyMeasurable (fun om => matrixNorm (Homogenization.Book.Ch02.bCoarse (cubeDomain Q)
        ((E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w ((3 : ℝ) ^ (-(k : ℤ)))).coeffOn Q)))
        (chaosSampleLaw M).toMeasure := by
      simpa only [Homogenization.Book.Ch02.coarseBMatrixNorm] using!
        (aux_lem_extension_cell_moment_aesm_coarseB_chart hd E M H hH.1 N z0 R hR w _ (by positivity) hcell Q hQsub)
    have hsm : AEStronglyMeasurable (fun om => matrixNorm (Homogenization.Book.Ch02.sigmaStarInvCoarse (cubeDomain Q)
        ((E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w ((3 : ℝ) ^ (-(k : ℤ)))).coeffOn Q)))
        (chaosSampleLaw M).toMeasure := by
      simpa only [Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm] using!
        (aux_lem_extension_cell_moment_aesm_coarseS_chart hd E M H hH.1 N z0 R hR w _ (by positivity) hcell Q hQsub)
    rw [SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded hbm, SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded hsm] at h1
    exact ⟨h1.1.trans (hmono hC0a.le (le_max_left _ _) (le_max_left _ _)),
      h1.2.trans (hmono hC0a.le (le_max_left _ _) (le_max_left _ _))⟩
  · obtain ⟨lo, hi, hbd, hmom⟩ := hB M H hH (hδ.trans (min_le_right _ _)) w N k hk hcell n hkn Q hQ
    have hk' : (Homogenization.originCube d 0).scale - (n : ℤ) ≤
        (Homogenization.originCube d 0).scale := sub_le_self _ (by exact_mod_cast Nat.zero_le n)
    have hQsub := Homogenization.openCubeSet_subset_of_mem_descendantsAtScale hk' hQ
    have hsub : (centeredCube w ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) :
        Set (SpatialCoordinates d)) ⊆ (centeredCube z0 R hR : Set (SpatialCoordinates d)) :=
      hcell
    have henv := fun om => aux_lem_extension_cell_moment_chart_envelope E M H om N z0 R hR w
      ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) hsub Q hQsub (hbd om).1 (hbd om).2.1 (hbd om).2.2
    have hnn : ∀ om, 0 ≤ 4 * (d : ℝ) * (lo om)⁻¹ * hi om ^ 2 := fun om => by
      have := (hbd om).1
      positivity
    have hnn' : ∀ om, 0 ≤ 4 * (d : ℝ) * (lo om)⁻¹ := fun om => by
      have := (hbd om).1
      positivity
    constructor
    · refine le_trans (eLpNorm_mono_real (aux_lem_extension_cell_moment_aesm_coarseB_chart hd E M H hH.1 N z0 R hR w _ (by positivity) hsub Q hQsub) (fun om => ?_)) (hmom.trans
        (hmono hC0b.le (le_max_right _ _) (le_max_right _ _)))
      rw [Real.norm_of_nonneg (Homogenization.Book.Ch02.coarseBMatrixNorm_nonneg _ _)]
      linarith [(henv om).1, hnn' om]
    · refine le_trans (eLpNorm_mono_real (aux_lem_extension_cell_moment_aesm_coarseS_chart hd E M H hH.1 N z0 R hR w _ (by positivity) hsub Q hQsub) (fun om => ?_)) (hmom.trans
        (hmono hC0b.le (le_max_right _ _) (le_max_right _ _)))
      rw [Real.norm_of_nonneg (Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm_nonneg _ _)]
      linarith [(henv om).2, hnn om]

theorem aux_lem_band_gu_scaleBridge_unif {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) (p ε : ℝ) (hp : 1 ≤ p) (hε : 0 < ε) :
    ∃ δ0 C1 : ℝ, 0 < δ0 ∧ 0 < C1 ∧
      ∀ (z0 : SpatialCoordinates d) (R : ℝ) (hR : 0 < R),
      ∃ C0 : ℝ, 0 < C0 ∧
        ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (_Rm : in_responses d M)
          (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
          InfraredCharacterization M H → M.delta ≤ δ0 →
        ∀ (w : SpatialCoordinates d) (N k : ℕ), k ≤ N →
          (centeredCube w ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR) →
        ∀ n : ℕ,
        eLpNorm (fun om => Homogenization.Book.Ch02.maxDescendantBMatrixNormAtScale
              (Homogenization.originCube d 0)
              ((Homogenization.originCube d 0).scale - (n : ℤ))
              (E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w
                ((3 : ℝ) ^ (-(k : ℤ)))))
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C0 * Real.exp (C1 * M.delta ^ 2 * k + ε * n)) ∧
        eLpNorm (fun om => Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
              (Homogenization.originCube d 0)
              ((Homogenization.originCube d 0).scale - (n : ℤ))
              (E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w
                ((3 : ℝ) ^ (-(k : ℤ)))))
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C0 * Real.exp (C1 * M.delta ^ 2 * k + ε * n)) := by
  obtain ⟨δ0, C1, hδ0, hC1, hb⟩ :=
    aux_lem_band_gu_descBridge_unif hd E (max p (2 * d * Real.log 3 / ε)) (ε / 2)
      (le_trans hp (le_max_left _ _)) (by positivity)
  refine ⟨δ0, C1, hδ0, hC1, ?_⟩
  intro z0 R hR
  obtain ⟨C0, hC0, hc⟩ := hb z0 R hR
  refine ⟨C0, hC0, ?_⟩
  intro M _Rm H hH hδ w N k hk hcell n
  set p' : ℝ := max p (2 * d * Real.log 3 / ε) with hp'_def
  have hp'pos : 0 < p' := lt_of_lt_of_le (by linarith) (le_max_left _ _)
  have hpp' : ENNReal.ofReal p ≤ ENNReal.ofReal p' :=
    ENNReal.ofReal_le_ofReal (le_max_left _ _)
  have hsub : (centeredCube w ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) :
      Set (SpatialCoordinates d)) ⊆ (centeredCube z0 R hR : Set (SpatialCoordinates d)) := hcell
  have hk' : (Homogenization.originCube d 0).scale - (n : ℤ) ≤
      (Homogenization.originCube d 0).scale := sub_le_self _ (by exact_mod_cast Nat.zero_le n)
  have hcard := aux_lem_extension_cell_moment_card_rpow_le d n hε (le_max_right _ _) hp'pos
  set A : ℝ := C1 * M.delta ^ 2 * k with hAdef
  have key : ∀ X : Homogenization.TriadicCube d → BilateralField d → ℝ,
      (∀ Q ∈ Homogenization.descendantsAtScale (Homogenization.originCube d 0)
          ((Homogenization.originCube d 0).scale - (n : ℤ)),
        AEStronglyMeasurable (X Q) (chaosSampleLaw M).toMeasure) →
      (∀ Q ∈ Homogenization.descendantsAtScale (Homogenization.originCube d 0)
          ((Homogenization.originCube d 0).scale - (n : ℤ)),
        eLpNorm (X Q) (ENNReal.ofReal p') (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C0 * Real.exp (A + ε / 2 * n))) →
      AEStronglyMeasurable (fun om => Homogenization.Book.Ch02.finsetSupReal
          (Homogenization.descendantsAtScale (Homogenization.originCube d 0)
            ((Homogenization.originCube d 0).scale - (n : ℤ))) (fun Q => X Q om))
        (chaosSampleLaw M).toMeasure →
      eLpNorm (fun om => Homogenization.Book.Ch02.finsetSupReal
          (Homogenization.descendantsAtScale (Homogenization.originCube d 0)
            ((Homogenization.originCube d 0).scale - (n : ℤ))) (fun Q => X Q om))
        (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (C0 * Real.exp (A + ε * n)) := by
    intro X hX hXb hmax
    refine (eLpNorm_le_eLpNorm_of_exponent_le hpp').trans ?_
    refine (aux_lem_extension_cell_moment_eLpNorm_finsetSup_le _ X hX hp'pos hXb).trans ?_
    refine ENNReal.ofReal_le_ofReal ?_
    rw [aux_lem_extension_cell_moment_card_desc]
    calc ((((3 ^ d) ^ n : ℕ) : ℝ)) ^ (1 / p') * (C0 * Real.exp (A + ε / 2 * n))
        ≤ Real.exp (ε / 2 * n) * (C0 * Real.exp (A + ε / 2 * n)) :=
          mul_le_mul_of_nonneg_right hcard (by positivity)
      _ = C0 * Real.exp (A + ε * n) := by
          rw [mul_left_comm, ← Real.exp_add]
          congr 2
          ring
  have hdesc : ∀ Q ∈ Homogenization.descendantsAtScale (Homogenization.originCube d 0)
      ((Homogenization.originCube d 0).scale - (n : ℤ)),
      Homogenization.openCubeSet Q ⊆ Homogenization.openCubeSet (Homogenization.originCube d 0) :=
    fun Q hQ => Homogenization.openCubeSet_subset_of_mem_descendantsAtScale hk' hQ
  constructor
  · exact key (fun Q om => Homogenization.Book.Ch02.coarseBMatrixNorm Q
        (E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w ((3 : ℝ) ^ (-(k : ℤ)))))
      (fun Q hQ => aux_lem_extension_cell_moment_aesm_coarseB_chart hd E M H hH.1 N z0 R hR w
        _ (by positivity) hsub Q (hdesc Q hQ))
      (fun Q hQ => (hc M _Rm H hH hδ w N k hk hcell n Q hQ).1)
      (aux_lem_extension_cell_moment_aesm_maxB_chart hd E M H hH.1 N z0 R hR w _
        (by positivity) hsub n)
  · exact key (fun Q om => Homogenization.Book.Ch02.coarseSigmaStarInvMatrixNorm Q
        (E.chart z0 R hR (cutoffPositiveCoefficient M H om N z0 hR) w ((3 : ℝ) ^ (-(k : ℤ)))))
      (fun Q hQ => aux_lem_extension_cell_moment_aesm_coarseS_chart hd E M H hH.1 N z0 R hR w
        _ (by positivity) hsub Q (hdesc Q hQ))
      (fun Q hQ => (hc M _Rm H hH hδ w N k hk hcell n Q hQ).2)
      (aux_lem_extension_cell_moment_aesm_maxS_chart hd E M H hH.1 N z0 R hR w _
        (by positivity) hsub n)

theorem aux_lem_band_gu_of_scaleBridge_unif {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) {beta q : ℝ} (hbeta : beta ∈ Set.Ioo (1 / 2 : ℝ) 1) (hq : 1 ≤ q) :
    ∃ deltaq Cd : ℝ, 0 < deltaq ∧ 0 < Cd ∧
      ∀ (z0 : SpatialCoordinates d) (R : ℝ) (hR : 0 < R),
      ∃ Cq : ℝ, 0 < Cq ∧
        ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (_Rm : in_responses d M)
          (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
          InfraredCharacterization M H → M.delta ≤ deltaq →
        ∀ (J : ℕ) (origins : Fin J → SpatialCoordinates d),
        ∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ), k ≤ N →
          (centeredCube
              (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
              ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR) →
          eLpNorm
              (fun om =>
                E.Lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                    (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                    ((3 : ℝ) ^ (-(k : ℤ)))
                    ((beta - 1 / 2) / 4) 2 +
                  (E.lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                    (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                    ((3 : ℝ) ^ (-(k : ℤ)))
                    ((beta - 1 / 2) / 4) 2)⁻¹)
              (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal
              (Cq * Real.exp (Cd * (q + q ^ 2) * M.delta ^ 2 * (k : ℝ))) := by
  have hs := aux_lem_extension_cell_moment_order hbeta
  have hεpos : 0 < (beta - 1 / 2) / 4 * Real.log 3 := mul_pos hs.1 (Real.log_pos (by norm_num))
  obtain ⟨δ0, C1, hδ0, hC1, hb⟩ :=
    aux_lem_band_gu_scaleBridge_unif hd E q ((beta - 1 / 2) / 4 * Real.log 3) hq hεpos
  have hqq : 0 < q + q ^ 2 := by positivity
  refine ⟨δ0, C1 / (q + q ^ 2), hδ0, div_pos hC1 hqq, ?_⟩
  intro z0 R hR
  obtain ⟨C0, hC0, hc⟩ := hb z0 R hR
  set s : ℝ := (beta - 1 / 2) / 4 with hs_def
  set r : ℝ := Real.exp (-(s * Real.log 3)) with hr_def
  have hr1 : r < 1 := Real.exp_lt_one_iff.mpr
    (neg_neg_of_pos (mul_pos hs.1 (Real.log_pos (by norm_num))))
  have h1r : 0 < 1 - r := by linarith
  refine ⟨2 * (C0 * (1 - r)⁻¹), by positivity, ?_⟩
  intro M _Rm H hH hδ J origins N k index nidx hk hcell
  have hsub : (centeredCube (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
      ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) : Set (SpatialCoordinates d)) ⊆
      (centeredCube z0 R hR : Set (SpatialCoordinates d)) := hcell
  have hmain := aux_lem_extension_cell_moment_cell_bound_of_scale hd E M H hH.1 N z0 R hR
    (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i) ((3 : ℝ) ^ (-(k : ℤ)))
    (by positivity) hsub hs (p := q) hq (C0 := C0) (A := C1 * M.delta ^ 2 * k) hC0.le
    (fun n => by
      have := (hc M _Rm H hH hδ (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
        N k hk hcell n).1
      simpa only [mul_assoc, mul_comm, mul_left_comm] using this)
    (fun n => by
      have := (hc M _Rm H hH hδ (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
        N k hk hcell n).2
      simpa only [mul_assoc, mul_comm, mul_left_comm] using this)
  refine hmain.trans (le_of_eq ?_)
  congr 1
  have hCd : C1 / (q + q ^ 2) * (q + q ^ 2) * M.delta ^ 2 * (k : ℝ) =
      C1 * M.delta ^ 2 * k := by
    field_simp
  rw [hCd]
  ring

theorem aux_lem_band_gu_cell_moment_unif
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d)
    (beta q : ℝ) (hbeta : beta ∈ Set.Ioo (1 / 2 : ℝ) 1) (hq1 : 1 ≤ q) :
  ∃ deltaq Cd : ℝ, 0 < deltaq ∧ 0 < Cd ∧
    ∀ (z0 : SpatialCoordinates d) (R : ℝ) (hR : 0 < R),
    ∃ Cq : ℝ, 0 < Cq ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (_Rm : in_responses d M)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ deltaq →
      ∀ (J : ℕ) (origins : Fin J → SpatialCoordinates d),
      ∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ), k ≤ N →
        (centeredCube
            (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
            ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR) →
        AEStronglyMeasurable
            (fun om =>
              E.Lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                  (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                  ((3 : ℝ) ^ (-(k : ℤ)))
                  ((beta - 1 / 2) / 4) 2 +
                (E.lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                  (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                  ((3 : ℝ) ^ (-(k : ℤ)))
                  ((beta - 1 / 2) / 4) 2)⁻¹)
            (chaosSampleLaw M).toMeasure ∧
        eLpNorm
            (fun om =>
              E.Lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                  (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                  ((3 : ℝ) ^ (-(k : ℤ)))
                  ((beta - 1 / 2) / 4) 2 +
                (E.lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                  (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                  ((3 : ℝ) ^ (-(k : ℤ)))
                  ((beta - 1 / 2) / 4) 2)⁻¹)
            (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal
              (Cq * Real.exp (Cd * (q + q ^ 2) * M.delta ^ 2 * (k : ℝ))) := by
  obtain ⟨deltaq, Cd, hdeltaq, hCd, hbound⟩ := aux_lem_band_gu_of_scaleBridge_unif hd E hbeta hq1
  refine ⟨deltaq, Cd, hdeltaq, hCd, ?_⟩
  intro z0 R hR
  obtain ⟨Cq, hCq, hcellbound⟩ := hbound z0 R hR
  refine ⟨Cq, hCq, ?_⟩
  intro M _Rm H hH hδ J origins N k index nidx hk hcell
  exact ⟨aux_lem_extension_cell_moment_aestronglyMeasurable hd E M H hH _
    (aux_lem_extension_cell_moment_order hbeta) z0 R hR N _ _ _ hcell,
    hcellbound M _Rm H hH hδ J origins N k index nidx hk hcell⟩

theorem aux_lem_band_gu_grid_assembly_unif :
  ∀ (d J : ℕ) (eta p q : ℝ), 0 < eta → 1 ≤ p → p ≤ q → q * eta > (d : ℝ) →
    ∀ (Cgrid : ℕ) (Ccell growth : ℝ),
      0 ≤ Ccell → 0 ≤ growth → growth < (eta - (d : ℝ) / q) * Real.log 3 →
    ∃ Cbound : ℝ, 0 ≤ Cbound ∧
      ∀ (Ω : Type) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
        (admissible : ℕ → Fin J → (Fin d → ℤ) → Prop)
        (F : ℕ → ℕ → Fin J → (Fin d → ℤ) → Ω → ℝ),
      (∀ (k : ℕ) (index : Fin J),
        ∃ S : Finset (Fin d → ℤ),
          (∀ nidx, nidx ∈ S ↔ admissible k index nidx) ∧
          S.card ≤ Cgrid * 3 ^ (d * k)) →
      (∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ), k ≤ N →
        admissible k index nidx →
        AEStronglyMeasurable (F N k index nidx) μ) →
      (∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ), k ≤ N →
        admissible k index nidx →
        eLpNorm (F N k index nidx) (ENNReal.ofReal q) μ ≤
          ENNReal.ofReal (Ccell * Real.exp (growth * (k : ℝ)))) →
    ∃ (K : ℕ → Ω → ℝ),
      (∀ N, MemLp (K N) (ENNReal.ofReal p) μ) ∧
      (∀ N, eLpNorm (K N) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal Cbound) ∧
      ∀ᵐ om ∂μ,
        ∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ), k ≤ N →
          admissible k index nidx →
          F N k index nidx om ≤
            K N om * ((3 : ℝ) ^ (-(k : ℤ))) ^ (-eta) := by
  classical
  intro d J eta p q heta hp hpq hqeta Cgrid Ccell growth hCcell hgrowth hmargin
  have hqpos : 0 < q := by
    nlinarith [hqeta]
  have hq1 : 1 ≤ q := le_trans hp hpq
  have hlog : 0 < Real.log (3 : ℝ) := Real.log_pos (by norm_num)
  have hqeta' : (d : ℝ) < q * (eta - growth / Real.log 3) := by
    have htmp : growth / Real.log 3 < eta - (d : ℝ) / q :=
      (div_lt_iff₀ hlog).2 hmargin
    have htmp' : (d : ℝ) / q < eta - growth / Real.log 3 := by
      linarith
    have htmp'' := (div_lt_iff₀ hqpos).mp htmp'
    simpa [mul_comm] using htmp''
  have hgap_grow :
      (d : ℝ) * Real.log 3 + (ENNReal.ofReal q).toReal * growth <
        (ENNReal.ofReal q).toReal * eta * Real.log 3 := by
    rw [ENNReal.toReal_ofReal hqpos.le]
    calc
      (d : ℝ) * Real.log 3 + q * growth <
          (d : ℝ) * Real.log 3 + q * ((eta - (d : ℝ) / q) * Real.log 3) := by
            simpa [add_comm] using
              (add_lt_add_right (mul_lt_mul_of_pos_left hmargin hqpos)
                ((d : ℝ) * Real.log 3))
      _ = q * eta * Real.log 3 := by
        field_simp [ne_of_gt hqpos]
        ring
  let m : ℕ → ℕ := fun k => Cgrid * 3 ^ (d * k)
  have hmcard : ∀ n : ℕ, (m n : ℝ) ≤
      (Cgrid : ℝ) * ((n : ℝ) + 1) ^ (0 : ℕ) *
        (3 : ℝ) ^ ((d : ℝ) * (n : ℝ)) := by
    intro n
    dsimp [m]
    rw [Nat.cast_mul, Nat.cast_pow]
    rw [show (d : ℝ) * (n : ℝ) = ((d * n : ℕ) : ℝ) by norm_num]
    rw [Real.rpow_natCast]
    norm_num
  let Kq : ℝ≥0∞ := ENNReal.ofReal Ccell
  let H : ℝ≥0∞ := ∑' n : ℕ,
      ENNReal.ofReal (Real.exp (growth * (n : ℝ)) *
        (3 : ℝ) ^ (-eta * (n : ℝ))) *
        (m n : ℝ≥0∞) ^ (1 / (ENNReal.ofReal q).toReal)
  let htermReal : ℕ → ℝ := fun n =>
      Real.exp (growth * (n : ℝ)) * (3 : ℝ) ^ (-eta * (n : ℝ)) *
        (m n : ℝ) ^ (1 / q)
  have hseries : Summable htermReal := by
    have hs := SubdiffusiveProcess.summable_triadic_mesh_cardinality
      m d 0 Cgrid q (eta - growth / Real.log 3) (by positivity) hq1 hqeta' hmcard
    apply hs.congr
    intro n
    dsimp [htermReal]
    have heq : Real.exp (growth * (n : ℝ)) *
        (3 : ℝ) ^ (-eta * (n : ℝ)) =
          (3 : ℝ) ^ (-(eta - growth / Real.log 3) * (n : ℝ)) := by
      rw [Real.rpow_def_of_pos (by norm_num),
        Real.rpow_def_of_pos (by norm_num), ← Real.exp_add]
      congr 1
      field_simp [ne_of_gt hlog]
      ring
    rw [heq]
  have hterm_nonneg : ∀ n, 0 ≤ htermReal n := by
    intro n
    dsimp [htermReal]
    positivity
  have hterm_enn : ∀ (n : ℕ), ENNReal.ofReal (Real.exp (growth * (n : ℝ)) *
        (3 : ℝ) ^ (-eta * (n : ℝ))) *
        (m n : ℝ≥0∞) ^ (1 / (ENNReal.ofReal q).toReal) =
      ENNReal.ofReal (htermReal n) := by
    intro n
    have hqto : (ENNReal.ofReal q).toReal = q :=
      ENNReal.toReal_ofReal hqpos.le
    have hmto : (m n : ℝ≥0∞) = ENNReal.ofReal (m n : ℝ) := by
      norm_num
    rw [hqto, hmto, ENNReal.ofReal_rpow_of_nonneg (Nat.cast_nonneg _) (by positivity)]
    rw [← ENNReal.ofReal_mul (by positivity)]
  have hH : H = ENNReal.ofReal (∑' n, htermReal n) := by
    dsimp [H]
    calc
      (∑' n : ℕ,
          ENNReal.ofReal (Real.exp (growth * (n : ℝ)) *
            (3 : ℝ) ^ (-eta * (n : ℝ))) *
            (m n : ℝ≥0∞) ^ (1 / (ENNReal.ofReal q).toReal)) =
          ∑' n : ℕ, ENNReal.ofReal (htermReal n) :=
            tsum_congr hterm_enn
      _ = ENNReal.ofReal (∑' n, htermReal n) :=
        (ENNReal.ofReal_tsum_of_nonneg hterm_nonneg hseries).symm
  have hHtop : H ≠ ⊤ := by
    rw [hH]
    exact ENNReal.ofReal_ne_top
  have htotal : H * Kq ≠ ⊤ := by
    exact ENNReal.mul_ne_top hHtop (by simp [Kq])
  let Cbound : ℝ := ((J : ℝ≥0∞) * (H * Kq)).toReal
  have hCbound : ENNReal.ofReal Cbound = (J : ℝ≥0∞) * (H * Kq) := by
    dsimp [Cbound]
    exact ENNReal.ofReal_toReal (by
      exact ENNReal.mul_ne_top (by simp) htotal)
  refine ⟨Cbound, ENNReal.toReal_nonneg, ?_⟩
  intro Ω mΩ μ hμ admissible F hcard hmeas hmoment
  choose S hS_spec using hcard
  let Z : ℕ → Fin J → (n : ℕ) → Fin (m n) → Ω → ℝ := fun N index n i om =>
    if hn : n ≤ N then
      if hi : i.val < (S n index).card then
        F N n index ((S n index).equivFin.symm ⟨i.val, hi⟩) om
      else 0
    else 0
  have hZ : ∀ (N : ℕ) (index : Fin J) (n : ℕ) (i : Fin (m n)),
      AEStronglyMeasurable (Z N index n i) μ := by
    intro N index n i
    by_cases hn : n ≤ N
    · by_cases hi : i.val < (S n index).card
      · simp only [Z, dif_pos hn, dif_pos hi]
        apply hmeas N n index _ hn
        exact ((hS_spec n index).1 _).mp
          ((S n index).equivFin.symm ⟨i.val, hi⟩).property
      · simpa [Z, hn, hi] using
          (stronglyMeasurable_const.aestronglyMeasurable :
            AEStronglyMeasurable (fun _ : Ω => (0 : ℝ)) μ)
    · simpa [Z, hn] using
        (stronglyMeasurable_const.aestronglyMeasurable :
          AEStronglyMeasurable (fun _ : Ω => (0 : ℝ)) μ)
  have hK : ∀ (N : ℕ) (index : Fin J) (n : ℕ) (i : Fin (m n)),
      eLpNorm (Z N index n i) (ENNReal.ofReal q) μ ≤
        Kq * ENNReal.ofReal (Real.exp (growth * (n : ℝ))) := by
    intro N index n i
    by_cases hn : n ≤ N
    · by_cases hi : i.val < (S n index).card
      · have hadm : admissible n index
            ((S n index).equivFin.symm ⟨i.val, hi⟩) :=
          ((hS_spec n index).1 _).mp
            ((S n index).equivFin.symm ⟨i.val, hi⟩).property
        have hFbound := hmoment N n index
          ((S n index).equivFin.symm ⟨i.val, hi⟩) hn hadm
        calc
          eLpNorm (Z N index n i) (ENNReal.ofReal q) μ =
              eLpNorm (F N n index
                ((S n index).equivFin.symm ⟨i.val, hi⟩))
                (ENNReal.ofReal q) μ := by simp [Z, hn, hi]
          _ ≤ ENNReal.ofReal (Ccell * Real.exp (growth * (n : ℝ))) := hFbound
          _ = Kq * ENNReal.ofReal (Real.exp (growth * (n : ℝ))) := by
            rw [ENNReal.ofReal_mul hCcell]
      · simp [Z, hn, hi, Kq]
    · simp [Z, hn, Kq]
  have henv : ∀ (N : ℕ) (index : Fin J), ∃ W : Ω → ℝ,
      MemLp W (ENNReal.ofReal p) μ ∧
        (∀ᵐ om ∂μ, 0 ≤ W om ∧ ∀ (n : ℕ) (i : Fin (m n)),
          |Z N index n i om| ≤ W om * (3 : ℝ) ^ (eta * (n : ℝ))) ∧
        eLpNorm W (ENNReal.ofReal p) μ ≤ H * Kq := by
    intro N index
    obtain ⟨W, hW, hWae, hWnorm⟩ :=
      SubdiffusiveProcess.exists_triadic_mesh_envelope_of_exponential_growth
        μ m d 0 (Cgrid : ℝ) eta growth (by positivity) hgrowth
        (by
          rw [← ENNReal.ofReal_one]
          exact ENNReal.ofReal_le_ofReal hp)
        (ENNReal.ofReal_le_ofReal hpq) (by simp) hgap_grow hmcard
        (Z N index) (hZ N index) Kq (by simp [Kq]) (hK N index)
    refine ⟨W, hW, hWae, ?_⟩
    simpa [H, Kq] using hWnorm
  choose W hW using henv
  let K : ℕ → Ω → ℝ := fun N om => ∑ i : Fin J, W N i om
  have hK_eq : ∀ N, K N = ∑ i : Fin J, W N i := by
    intro N
    funext om
    simp [K]
  have hKmem : ∀ N, MemLp (K N) (ENNReal.ofReal p) μ := by
    intro N
    rw [hK_eq N]
    exact memLp_finset_sum' (p := ENNReal.ofReal p) (μ := μ)
      (Finset.univ : Finset (Fin J)) (fun i hi => (hW N i).1)
  have hKnorm : ∀ N, eLpNorm (K N) (ENNReal.ofReal p) μ ≤
      (J : ℝ≥0∞) * (H * Kq) := by
    intro N
    rw [hK_eq N]
    calc
      eLpNorm (∑ i : Fin J, W N i) (ENNReal.ofReal p) μ ≤
          ∑ i : Fin J, eLpNorm (W N i) (ENNReal.ofReal p) μ := by
            apply eLpNorm_sum_le
            rw [← ENNReal.ofReal_one]
            exact ENNReal.ofReal_le_ofReal hp
      _ ≤ ∑ _i : Fin J, H * Kq := by
        gcongr
        exact (hW N _).2.2
      _ = (J : ℝ≥0∞) * (H * Kq) := by simp
  have hdom : ∀ᵐ om ∂μ, ∀ (N : ℕ) (index : Fin J),
      0 ≤ W N index om ∧ ∀ (n : ℕ) (i : Fin (m n)),
        |Z N index n i om| ≤ W N index om * (3 : ℝ) ^ (eta * (n : ℝ)) := by
    apply ae_all_iff.2
    intro N
    apply ae_all_iff.2
    intro index
    exact (hW N index).2.1
  refine ⟨K, hKmem, ?_, ?_⟩
  · intro N
    exact (hKnorm N).trans_eq hCbound.symm
  · filter_upwards [hdom] with om hω
    intro N k index nidx hk hadm
    have hnmem : nidx ∈ S k index := ((hS_spec k index).1 nidx).mpr hadm
    let i0 : Fin (S k index).card := (S k index).equivFin ⟨nidx, hnmem⟩
    have hi0 : i0.val < (m k) := by
      exact lt_of_lt_of_le i0.isLt ((hS_spec k index).2.trans_eq (by rfl))
    let i : Fin (m k) := ⟨i0.val, hi0⟩
    have hsub : (⟨i.val, (show i.val < (S k index).card by simpa [i, i0])⟩ :
        Fin (S k index).card) = i0 := by
      apply Fin.ext
      rfl
    have hget : ((S k index).equivFin.symm
        ⟨i.val, (show i.val < (S k index).card by simpa [i, i0])⟩).val = nidx := by
      rw [hsub]
      exact congrArg Subtype.val
        ((S k index).equivFin.symm_apply_apply ⟨nidx, hnmem⟩)
    have hFi : |F N k index nidx om| ≤
        W N index om * (3 : ℝ) ^ (eta * (k : ℝ)) := by
      simpa [Z, hk, i, i0, hget] using (hω N index).2 k i
    have hWle : W N index om ≤ K N om := by
      dsimp [K]
      exact Finset.single_le_sum
        (fun j _ => (hω N j).1) (Finset.mem_univ index)
    have hpow : 0 ≤ (3 : ℝ) ^ (eta * (k : ℝ)) := by positivity
    have hsum : W N index om * (3 : ℝ) ^ (eta * (k : ℝ)) ≤
        K N om * (3 : ℝ) ^ (eta * (k : ℝ)) :=
      mul_le_mul_of_nonneg_right hWle hpow
    have hfactor : ((3 : ℝ) ^ (-(k : ℤ))) ^ (-eta) =
        (3 : ℝ) ^ (eta * (k : ℝ)) := by
      rw [_root_.zpow_neg, zpow_natCast]
      rw [Real.rpow_def_of_pos (by positivity)]
      rw [Real.log_inv, Real.log_pow]
      rw [Real.rpow_def_of_pos (by norm_num)]
      congr 1
      ring
    calc
      F N k index nidx om ≤ |F N k index nidx om| := le_abs_self _
      _ ≤ W N index om * (3 : ℝ) ^ (eta * (k : ℝ)) := hFi
      _ ≤ K N om * (3 : ℝ) ^ (eta * (k : ℝ)) := hsum
      _ = K N om * ((3 : ℝ) ^ (-(k : ℤ))) ^ (-eta) := by rw [hfactor]

theorem aux_lem_band_gu_extension_grid_uniform
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) :
  ∀ (eta p : ℝ), 0 < eta → 1 ≤ p →
    ∀ (beta : ℝ), beta ∈ Set.Ioo (1 / 2 : ℝ) 1 →
    ∃ delta0 : ℝ, 0 < delta0 ∧
      ∀ (z0 : SpatialCoordinates d) (R : ℝ) (hR : 0 < R)
        (J : ℕ) (origins : Fin J → SpatialCoordinates d),
      ∃ Cbound : ℝ, 0 ≤ Cbound ∧
        ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (_Rm : in_responses d M)
          (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
          InfraredCharacterization M H → M.delta ≤ delta0 →
        ∃ (K : ℕ → BilateralField d → ℝ),
          (∀ N, MemLp (K N) (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure) ∧
          (∀ N, eLpNorm (K N) (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal Cbound) ∧
          ∀ᵐ om ∂(chaosSampleLaw M).toMeasure,
            ∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ), k ≤ N →
              (centeredCube (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR) →
              E.Lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                  (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                    ((3 : ℝ) ^ (-(k : ℤ))) ((beta - 1 / 2) / 4) 2 +
                (E.lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
                  (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
                    ((3 : ℝ) ^ (-(k : ℤ))) ((beta - 1 / 2) / 4) 2)⁻¹ ≤
                K N om * ((3 : ℝ) ^ (-(k : ℤ))) ^ (-eta) := by
  intro eta p heta hp beta hbeta
  let q : ℝ := p + ((d : ℝ) + 1) / eta
  have hqpos : 0 < q := by
    dsimp [q]
    have : 0 ≤ ((d : ℝ) + 1) / eta := div_nonneg (by positivity) heta.le
    linarith
  have hpq : p ≤ q := by
    dsimp [q]
    have : 0 ≤ ((d : ℝ) + 1) / eta := div_nonneg (by positivity) heta.le
    linarith
  have hq1 : 1 ≤ q := le_trans hp hpq
  have hqeta : (d : ℝ) < q * eta := by
    dsimp [q]
    have hcancel : ((d : ℝ) + 1) / eta * eta = (d : ℝ) + 1 :=
      div_mul_cancel₀ _ (ne_of_gt heta)
    nlinarith [mul_nonneg (by linarith : 0 ≤ p) heta.le]
  obtain ⟨deltaq, Cd, hdeltaq, hCd, hcell⟩ := aux_lem_band_gu_cell_moment_unif d hd E beta q hbeta hq1
  obtain ⟨delta0, hdelta0, hsmall, hgrowth⟩ :=
    aux_lem_extension_choose_growth_threshold d eta q deltaq Cd hqpos hqeta hdeltaq hCd
  refine ⟨delta0, hdelta0, ?_⟩
  intro z0 R hR J origins
  obtain ⟨Cq, hCq, hcellroot⟩ := hcell z0 R hR
  obtain ⟨Cgrid, hgrid⟩ := lem_extension_grid_cardinality d hd z0 R hR J origins
  let growth_unif : ℝ := Cd * (q + q ^ 2) * delta0 ^ 2
  have hgrowth_unif := hgrowth delta0 hdelta0.le (le_refl delta0)
  obtain ⟨Cbound, hCbound0, hassembly⟩ :=
    aux_lem_band_gu_grid_assembly_unif d J eta p q heta hp hpq hqeta Cgrid Cq growth_unif
      hCq.le hgrowth_unif.1 hgrowth_unif.2
  refine ⟨Cbound, hCbound0, ?_⟩
  intro M _Rm H hH hM
  let admissible : ℕ → Fin J → (Fin d → ℤ) → Prop := fun k index nidx =>
    centeredCube (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
      ((3 : ℝ) ^ (-(k : ℤ))) (by positivity) ≤ centeredCube z0 R hR
  let F : ℕ → ℕ → Fin J → (Fin d → ℤ) → BilateralField d → ℝ :=
    fun N k index nidx om =>
      E.Lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
        (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
          ((3 : ℝ) ^ (-(k : ℤ))) ((beta - 1 / 2) / 4) 2 +
      (E.lam z0 R hR (cutoffPositiveCoefficient M H om N z0 hR)
        (fun i => origins index i + (3 : ℝ) ^ (-(k : ℤ)) * nidx i)
          ((3 : ℝ) ^ (-(k : ℤ))) ((beta - 1 / 2) / 4) 2)⁻¹
  have hMd : 0 ≤ M.delta := M.shellPrefix.delta_pos.le
  have hgmono : ∀ (k : ℕ), Cd * (q + q ^ 2) * M.delta ^ 2 * (k : ℝ) ≤ growth_unif * (k : ℝ) := by
    intro k
    have hsq : M.delta ^ 2 ≤ delta0 ^ 2 := pow_le_pow_left₀ hMd hM 2
    have hCqq : 0 ≤ Cd * (q + q ^ 2) := by positivity
    have h1 : Cd * (q + q ^ 2) * M.delta ^ 2 ≤ Cd * (q + q ^ 2) * delta0 ^ 2 :=
      mul_le_mul_of_nonneg_left hsq hCqq
    exact mul_le_mul_of_nonneg_right h1 (Nat.cast_nonneg k)
  have hmeasure : ∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ),
      k ≤ N → admissible k index nidx →
      AEStronglyMeasurable (F N k index nidx) (chaosSampleLaw M).toMeasure := by
    intro N k index nidx hkn had
    exact (hcellroot M _Rm H hH (hM.trans hsmall) J origins N k index nidx hkn had).1
  have hmoment : ∀ (N k : ℕ) (index : Fin J) (nidx : Fin d → ℤ),
      k ≤ N → admissible k index nidx →
      eLpNorm (F N k index nidx) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (Cq * Real.exp (growth_unif * (k : ℝ))) := by
    intro N k index nidx hkn had
    refine (hcellroot M _Rm H hH (hM.trans hsmall) J origins N k index nidx hkn had).2.trans (ENNReal.ofReal_le_ofReal ?_)
    exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (hgmono k)) hCq.le
  simpa only [F, admissible] using
    hassembly (BilateralField d) (chaosSampleLaw M).toMeasure admissible F hgrid hmeasure hmoment

theorem aux_lem_band_macro_global_energy
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) (P : in_poincare d hd E) (X : in_extension d hd E)
    (S : SobolevFoundationalInput d hd)
    (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (hr1 : r ≤ 1)
    (q : ℝ) (hq : 1 ≤ q) :
    ∃ δ0 C : ℝ, 0 < δ0 ∧ 0 ≤ C ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
      InfraredCharacterization M H → M.delta ≤ δ0 →
      ∃ K : ℕ → BilateralField d → ℝ,
        (∀ N o, 0 ≤ K N o) ∧
        (∀ N, MemLp (K N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure) ∧
        (∀ N, eLpNorm (K N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal C) ∧
        ∀ᵐ o ∂(chaosSampleLaw M).toMeasure,
        ∀ (N : ℕ) (F : SpatialCoordinates d → ℝ) (Kf : ℝ),
          0 ≤ Kf →
          AEMeasurable F (volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d))) →
          (∀ᵐ x ∂volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d)), |F x| ≤ Kf) →
        ∀ (phi : SpatialCoordinates d → ℝ) (Cphi : ℝ),
          ContDiff ℝ 2 phi → c2Norm (closedCube z r hr : Set (SpatialCoordinates d)) phi ≤ Cphi →
        ∀ (b u : weakSobolevGraph (centeredCube z r hr)),
          ((b : SobolevData (centeredCube z r hr)).1 : SpatialCoordinates d → ℝ)
            =ᵐ[volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d))] phi →
          SolvesDirichlet (cutoffPositiveCoefficient M H o N z hr) F b u →
          sobolevCoefficientForm (cutoffPositiveCoefficient M H o N z hr)
            (u : SobolevData (centeredCube z r hr)) (u : SobolevData (centeredCube z r hr)) ≤
            K N o * (Kf + Cphi) ^ 2 := by
  obtain ⟨δc, hδc, Cc, hCc, hcoer⟩ := aux_lem_band_rb_uniform_coercivity d hd E P S z r hr hr1
  obtain ⟨δg, hδg, hgrid⟩ := aux_lem_band_gu_extension_grid_uniform d hd E
    (1 / 8) q (by norm_num) hq (5 / 8) ⟨by norm_num, by norm_num⟩
  obtain ⟨Cg, hCg, hgrid⟩ := hgrid z 1 one_pos 1 (fun _ => z)
  obtain ⟨Cext, hCext, hext⟩ := (lem_extension d hd E X S).1 (3 / 4) ⟨by norm_num, by norm_num⟩
  let Ce := aux_aux_macro_moment_bank_Cstar d Cext
  have hCe : 0 ≤ Ce := aux_aux_macro_moment_bank_Cstar_nonneg d Cext hCext.le
  let c2 : ℝ := ((measureUnivNNReal (volume.restrict
    (centeredCube z r hr : Set (SpatialCoordinates d))) : ℝ) ^ ((2 : ℝ≥0∞).toReal⁻¹)) ^ 2 *
      volume.real (centeredCube z r hr : Set (SpatialCoordinates d))
  have hc2 : 0 ≤ c2 := by dsimp [c2]; positivity
  refine ⟨min (δc q) δg, Ce * Cg + c2 * Cc q, lt_min (hδc q hq) hδg,
    add_nonneg (mul_nonneg hCe hCg) (mul_nonneg hc2 (hCc q hq)), ?_⟩
  intro M Rm H hH hδ
  obtain ⟨Kco, hKco, hKcom⟩ := hcoer M Rm H hH
  have hKm := hKcom q hq (hδ.trans (min_le_left _ _))
  obtain ⟨Kgrid, hGm, hGn, hGa⟩ := hgrid M Rm H hH (hδ.trans (min_le_right _ _))
  let Ke : ℕ → BilateralField d → ℝ := fun N o => Ce * Kgrid N o
  have hKeb := fun N => aux_aux_macro_moment_bank_const_mul_moment (chaosSampleLaw M).toMeasure
    (ENNReal.ofReal q) Ce hCe (Kgrid N) Cg (hGm N) (hGn N)
  let K : ℕ → BilateralField d → ℝ := fun N o => |Ke N o| + c2 * |Kco N o|
  have hKn : ∀ N, eLpNorm (K N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Ce * Cg + c2 * Cc q) := by
    intro N
    have hh := aux_aux_macro_moment_bank_bracket_moment (chaosSampleLaw M).toMeasure q hq
      (fun _ => 0) (Ke N) (Kco N) 1 c2 (Ce * Cg) (Cc q) zero_le_one hc2
      aestronglyMeasurable_const (hKeb N).1.aestronglyMeasurable (hKm N).1.aestronglyMeasurable (hKeb N).2 (hKm N).2
    simpa only [K, zero_add, one_mul, eLpNorm_zero', ENNReal.ofReal_one,
      ← ENNReal.ofReal_mul hc2,
      ← ENNReal.ofReal_add (mul_nonneg hCe hCg) (mul_nonneg hc2 (hCc q hq))] using hh
  refine ⟨K, fun N o => add_nonneg (abs_nonneg _) (mul_nonneg hc2 (abs_nonneg _)), ?_, hKn, ?_⟩
  · intro N
    exact (hKn N).trans_lt ENNReal.ofReal_lt_top
  · have hBd := aux_aux_macro_moment_bank_hBd hd E Cext hCext hext M H z r hr hr1 Kgrid hGa
    filter_upwards [hBd] with o ho
    intro N F Kf hKf hFm hFb phi Cphi hphi hCphi b u hb hsolve
    have hP := aux_aux_macro_moment_bank_killed_poincare hd z r hr
    exact aux_aux_macro_moment_bank_energy_le_bd hd z r hr hr1 hP
      (cutoffPositiveCoefficient M H o N z hr) (Kco N o) (fun v => ((hKco N o).1 v).2)
      F Kf hKf hFm hFb phi Cphi hphi hCphi b u hsolve (Ke N o)
      (ho N hP phi Cphi hphi hCphi b hb)

theorem aux_lem_band_mac4_delta_sq_log_mono {δ D : ℝ} (hδ0 : 0 < δ) (hδD : δ ≤ D)
    (hD1 : D ≤ Real.exp (-(1/2 : ℝ))) :
    δ ^ 2 * |Real.log δ| ≤ D ^ 2 * |Real.log D| := by
  set X : ℝ := Real.exp (-(1/2 : ℝ)) with hXdef
  have hX0 : 0 < X := Real.exp_pos _
  have hX1 : X < 1 := by
    rw [hXdef]
    calc Real.exp (-(1/2:ℝ)) < Real.exp 0 := Real.exp_lt_exp.mpr (by norm_num)
      _ = 1 := Real.exp_zero
  set g : ℝ → ℝ := fun x => -(x ^ 2 * Real.log x) with hgdef
  have hderiv : ∀ x ∈ Set.Ioo (0:ℝ) X, HasDerivAt g (x * (-2 * Real.log x - 1)) x := by
    intro x hx
    have hx0 : x ≠ 0 := ne_of_gt hx.1
    have h1 : HasDerivAt Real.log x⁻¹ x := Real.hasDerivAt_log hx0
    have h2 : HasDerivAt (fun y : ℝ => y ^ 2) (2 * x) x := by
      simpa using (hasDerivAt_pow 2 x)
    have h3 : HasDerivAt (fun y : ℝ => y ^ 2 * Real.log y) (2 * x * Real.log x + x ^ 2 * x⁻¹) x :=
      h2.fun_mul h1
    have h4 := h3.fun_neg
    convert h4 using 1
    have hxx : x ^ 2 * x⁻¹ = x := by field_simp
    rw [hxx]; ring
  have hcont : ContinuousOn g (Set.Ioc (0:ℝ) X) := by
    apply ContinuousOn.neg
    apply ContinuousOn.mul (continuous_pow 2).continuousOn
    intro x hx
    exact (Real.continuousAt_log (ne_of_gt hx.1)).continuousWithinAt
  have hdiffOn : DifferentiableOn ℝ g (interior (Set.Ioc (0:ℝ) X)) := by
    rw [interior_Ioc]
    intro x hx
    exact (hderiv x hx).differentiableAt.differentiableWithinAt
  have hmono : MonotoneOn g (Set.Ioc (0:ℝ) X) := by
    apply monotoneOn_of_deriv_nonneg (convex_Ioc _ _) hcont hdiffOn
    rw [interior_Ioc]
    intro x hx
    rw [(hderiv x hx).deriv]
    have hlogx : Real.log x ≤ -(1/2 : ℝ) := by
      have h := (Real.log_le_log_iff hx.1 hX0).mpr hx.2.le
      rw [hXdef, Real.log_exp] at h
      exact h
    have hxpos : 0 < x := hx.1
    nlinarith
  have hδlt1 : δ < 1 := lt_of_le_of_lt (hδD.trans hD1) hX1
  have hDlt1 : D < 1 := lt_of_le_of_lt hD1 hX1
  have hδmem : δ ∈ Set.Ioc (0:ℝ) X := ⟨hδ0, hδD.trans hD1⟩
  have hDmem : D ∈ Set.Ioc (0:ℝ) X := ⟨lt_of_lt_of_le hδ0 hδD, hD1⟩
  have hg := hmono hδmem hDmem hδD
  have habsδ : |Real.log δ| = -Real.log δ := abs_of_neg (Real.log_neg hδ0 hδlt1)
  have habsD : |Real.log D| = -Real.log D :=
    abs_of_neg (Real.log_neg (lt_of_lt_of_le hδ0 hδD) hDlt1)
  rw [habsδ, habsD, show δ ^ 2 * -Real.log δ = g δ by rw [hgdef]; ring,
    show D ^ 2 * -Real.log D = g D by rw [hgdef]; ring]
  exact hg

theorem aux_lem_band_mac4_threshold_uniform {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (t1 Pexp : ℝ) (ht1 : (d : ℝ) - 1 < t1) (ht1' : t1 < d) (ht10 : 0 ≤ t1) (hP1 : 1 ≤ Pexp) :
    ∃ dA : ℝ, 0 < dA ∧
    ∃ κ0 : ℝ, 2 * Pexp * t1 * Real.log 3 < κ0 ∧
    ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Sreg : in_6_16 d M),
      M.delta ≤ dA →
      M.delta ≤ Sreg.C⁻¹ ∧ 1 - ((d : ℝ) - t1) / 4 ∈ Sreg.alphaRange ∧
        κ0 ≤ (1 - (1 - ((d : ℝ) - t1) / 4)) ^ 2 / (Sreg.C * M.delta ^ 2 * |Real.log M.delta|) := by
  obtain ⟨Cd, hCd⟩ : ∃ Cd : ℝ, Cd = ((d : ℝ) + 1) ^ 2 *
      max 1 (Classical.choose (SubdiffusiveProcess.Frozen.Section6.cutoff_holder_regularity d)) := ⟨_, rfl⟩
  have hCd1 : 1 ≤ Cd := by
    rw [hCd]
    have h1 : (1 : ℝ) ≤ ((d : ℝ) + 1) ^ 2 := by
      have : (1 : ℝ) ≤ (d : ℝ) + 1 := by linarith [(Nat.cast_nonneg d : (0 : ℝ) ≤ d)]
      nlinarith
    have h2 : (1 : ℝ) ≤
        max 1 (Classical.choose (SubdiffusiveProcess.Frozen.Section6.cutoff_holder_regularity d)) :=
      le_max_left _ _
    nlinarith
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = ((d : ℝ) - t1) / 4 := ⟨_, rfl⟩
  have ha0 : 0 < a := by rw [ha]; linarith
  have ha1 : a < 1 / 4 := by rw [ha]; linarith
  obtain ⟨lam, hlamdef⟩ : ∃ lam : ℝ, lam = 2 * Pexp * t1 * Real.log 3 := ⟨_, rfl⟩
  have hlam : 0 ≤ lam := by
    rw [hlamdef]
    have hlog3 : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num : (1 : ℝ) ≤ 3)
    have hPnn : (0 : ℝ) ≤ Pexp := by linarith
    positivity
  have hCd0 : 0 < Cd := by linarith
  set dA : ℝ := min (min (1 / 2) Cd⁻¹) (min ((a / Cd) ^ 2) (a ^ 2 / (2 * Cd * (lam + 1))))
    with hdAdef
  have hdA0 : 0 < dA := by
    rw [hdAdef]
    refine lt_min (lt_min (by norm_num) (inv_pos.2 hCd0)) (lt_min (by positivity) ?_)
    have : 0 < 2 * Cd * (lam + 1) := by positivity
    positivity
  have hdAhalf : dA ≤ (1 / 2 : ℝ) := (min_le_left _ _).trans (min_le_left _ _)
  have hdAX : dA ≤ Real.exp (-(1/2:ℝ)) := by
    have hhalf : (1/2:ℝ) ≤ Real.exp (-(1/2:ℝ)) := by
      have := Real.add_one_le_exp (-(1/2:ℝ))
      linarith
    exact hdAhalf.trans hhalf
  obtain ⟨hδCA, hαA, hκlamA⟩ :=
    aux_aux_macro_moment_bank_delta_facts Cd a lam dA hCd1 ha0 ha1 hlam hdA0 (le_refl dA)
  refine ⟨dA, hdA0, (1 - (1 - a)) ^ 2 / (Cd * dA ^ 2 * |Real.log dA|), ?_, ?_⟩
  · rwa [← hlamdef]
  · intro M Sreg hδA
    have hδ0 : 0 < M.delta := M.shellPrefix.delta_pos
    have hCeq : Sreg.C = Cd := by rw [Sreg.C_eq_dimensional, hCd]
    obtain ⟨hδC, hα, _⟩ :=
      aux_aux_macro_moment_bank_delta_facts Cd a lam M.delta hCd1 ha0 ha1 hlam hδ0 hδA
    rw [← hCeq] at hδC hα
    rw [← Sreg.alphaRange_eq, ha] at hα
    refine ⟨hδC, hα, ?_⟩
    have hmono := aux_lem_band_mac4_delta_sq_log_mono hδ0 hδA hdAX
    have hbc : Cd * M.delta ^ 2 * |Real.log M.delta| ≤ Cd * dA ^ 2 * |Real.log dA| := by
      calc Cd * M.delta ^ 2 * |Real.log M.delta| = Cd * (M.delta ^ 2 * |Real.log M.delta|) := by
            ring
        _ ≤ Cd * (dA ^ 2 * |Real.log dA|) := mul_le_mul_of_nonneg_left hmono hCd0.le
        _ = Cd * dA ^ 2 * |Real.log dA| := by ring
    have hδlt1 : M.delta < 1 := lt_of_le_of_lt (hδA.trans hdAhalf) (by norm_num)
    have hcpos : 0 < Cd * M.delta ^ 2 * |Real.log M.delta| := by
      have hlogne : Real.log M.delta < 0 := Real.log_neg hδ0 hδlt1
      have habspos : 0 < |Real.log M.delta| := abs_pos.mpr hlogne.ne
      positivity
    rw [hCeq, ← ha]
    exact div_le_div_of_nonneg_left (sq_nonneg _) hcpos hbc

theorem aux_lem_band_mac4_eLpNorm_of_exp_bound
    {Om : Type} [MeasurableSpace Om] (P : Measure Om) [IsProbabilityMeasure P]
    {p B c R : ℝ} {Y X : Om → ℝ}
    (hp : 0 < p) (hB : 0 ≤ B) (hR : 0 ≤ R)
    (hY0 : ∀ omega, 0 ≤ Y omega)
    (hpoint : ∀ omega, Y omega ^ p ≤ B * Real.exp (c * X omega))
    (hExp : Integrable (fun omega => Real.exp (c * X omega)) P)
    (hInt : B * (∫ omega, Real.exp (c * X omega) ∂P) ≤ R ^ p) :
    SubdiffusiveProcess.RawLp.eLpNorm Y (ENNReal.ofReal p) P ≤ ENNReal.ofReal R := by
  have hp0 : (ENNReal.ofReal p).toReal = p := ENNReal.toReal_ofReal hp.le
  have hlin :
      (∫⁻ omega, ‖Y omega‖ₑ ^ (ENNReal.ofReal p).toReal ∂P) ≤
        ENNReal.ofReal (B * (∫ omega, Real.exp (c * X omega) ∂P)) := by
    calc
      (∫⁻ omega, ‖Y omega‖ₑ ^ (ENNReal.ofReal p).toReal ∂P) ≤
          ∫⁻ omega, ENNReal.ofReal (B * Real.exp (c * X omega)) ∂P := by
            refine lintegral_mono (fun omega => ?_)
            rw [hp0, Real.enorm_eq_ofReal (hY0 omega),
              ENNReal.ofReal_rpow_of_nonneg (hY0 omega) hp.le]
            exact ENNReal.ofReal_le_ofReal (hpoint omega)
      _ = ENNReal.ofReal (B * (∫ omega, Real.exp (c * X omega) ∂P)) := by
        symm
        rw [← integral_const_mul]
        exact ofReal_integral_eq_lintegral_ofReal (hExp.const_mul B)
          (ae_of_all _ (fun omega => mul_nonneg hB (Real.exp_nonneg _)))
  rw [SubdiffusiveProcess.RawLp.eLpNorm_eq_raw_integral (ENNReal.ofReal_pos.mpr hp).ne'
    ENNReal.ofReal_ne_top]
  calc
    (∫⁻ omega, ‖Y omega‖ₑ ^ (ENNReal.ofReal p).toReal ∂P) ^
          (1 / (ENNReal.ofReal p).toReal) ≤
        (ENNReal.ofReal (B * (∫ omega, Real.exp (c * X omega) ∂P))) ^
          (1 / (ENNReal.ofReal p).toReal) :=
      ENNReal.rpow_le_rpow hlin (by positivity)
    _ ≤ (ENNReal.ofReal (R ^ p)) ^ (1 / p) := by
      rw [hp0]
      exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hInt) (one_div_nonneg.mpr hp.le)
    _ = ENNReal.ofReal R := by
      rw [← ENNReal.ofReal_rpow_of_nonneg hR hp.le]
      rw [← ENNReal.rpow_mul]
      have hpne : p ≠ 0 := ne_of_gt hp
      field_simp
      simp

theorem aux_lem_band_mac4_exp_restrict_uniform {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (K : Compacts (SpatialCoordinates d)) (q : ℝ) (hq : 0 < q)
    (delta0 : ℝ) (hdelta0 : 0 ≤ delta0) :
    ∃ CEu : ℝ, 0 ≤ CEu ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        eLpNorm (fun om => Real.exp ‖(H om).restrict (K : Set (SpatialCoordinates d))‖)
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal CEu := by
  classical
  obtain ⟨C, hCnn, hCM⟩ := exists_uniform_compactExponentialMoment_of_infraredCharacterization
    (d := d) hd
  set Rbound : ℝ := 2 * Real.exp (C K * q ^ 2 * delta0 ^ 2) with hRbounddef
  have hRbound0 : 0 ≤ Rbound := by rw [hRbounddef]; positivity
  refine ⟨Rbound ^ q⁻¹, Real.rpow_nonneg hRbound0 _, ?_⟩
  intro M H hH hδ
  obtain ⟨hIntK, hBndK⟩ := hCM M H hH K q hq.le
  have hMdelta0 : 0 ≤ M.delta := M.shellPrefix.delta_pos.le
  have hsq : M.delta ^ 2 ≤ delta0 ^ 2 := pow_le_pow_left₀ hMdelta0 hδ 2
  have hCKnn : 0 ≤ C K * q ^ 2 := mul_nonneg (hCnn K) (sq_nonneg q)
  have hexpmono : Real.exp (C K * q ^ 2 * M.delta ^ 2) ≤ Real.exp (C K * q ^ 2 * delta0 ^ 2) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hsq hCKnn)
  have hIntBound : (∫ om, Real.exp (q * ‖(H om).restrict (K : Set (SpatialCoordinates d))‖)
      ∂(chaosSampleLaw M).toMeasure) ≤ Rbound := by
    refine hBndK.trans ?_
    rw [hRbounddef]
    exact mul_le_mul_of_nonneg_left hexpmono (by norm_num)
  have hYm : AEStronglyMeasurable (fun om => Real.exp ‖(H om).restrict (K : Set (SpatialCoordinates d))‖) (chaosSampleLaw M).toMeasure := by
    simpa only [Function.comp_apply] using! (((ContinuousMap.continuous_restrict (K : Set (SpatialCoordinates d))).norm.measurable).comp hH.1).exp.aestronglyMeasurable
  rw [← SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded hYm]
  refine aux_lem_band_mac4_eLpNorm_of_exp_bound (chaosSampleLaw M).toMeasure
    (p := q) (B := 1) (c := q)
    (Y := fun om => Real.exp ‖(H om).restrict (K : Set (SpatialCoordinates d))‖)
    (X := fun om => ‖(H om).restrict (K : Set (SpatialCoordinates d))‖)
    hq (by norm_num) (Real.rpow_nonneg hRbound0 _) (fun om => (Real.exp_pos _).le) ?_ hIntK ?_
  · intro om
    have heq : Real.exp ‖(H om).restrict (K : Set (SpatialCoordinates d))‖ ^ q =
        1 * Real.exp (q * ‖(H om).restrict (K : Set (SpatialCoordinates d))‖) := by
      rw [one_mul, ← Real.exp_mul, mul_comm]
    exact le_of_eq heq
  · rw [one_mul, Real.rpow_inv_rpow hRbound0 hq.ne']
    exact hIntBound

theorem aux_lem_band_mac5_exp_zero_quant {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (c : ℝ)
    (hc : 0 ≤ c) :
    Integrable (fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d => Real.exp (c * |g 0|))
      (SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure ∧
    (∫ g, Real.exp (c * |g 0|) ∂(SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure) ≤
      2 * Real.exp ((c * M.delta) ^ 2 / 4) := by
  have hdelta : 0 < M.delta := M.shellPrefix.delta_pos
  set E : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d → ℝ :=
    SubdiffusiveProcess.Frozen.Assumptions.PotentialField.g2Observable with hEdef
  set Z : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d → ℝ := fun g =>
    Real.exp ((M.delta⁻¹ * max (E g) 0) ^ (2 : ℝ)) with hZdef
  have hZOG := M.G2.regularity_expectation
  have hZint : Integrable Z (SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure := by
    simpa [hZdef, hEdef, SubdiffusiveProcess.OGammaLE] using hZOG.1
  have hZbound : (∫ g, Z g ∂(SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure) ≤ 2 := by
    simpa [hZdef, hEdef, SubdiffusiveProcess.OGammaLE] using hZOG.2
  have h0 : (0 : Homogenization.Vec d) ∈ Metric.closedBall
      (Homogenization.cubeCenter (Homogenization.originCube d 0))
      (Homogenization.cubeRadius (Homogenization.originCube d 0)) := by
    have hc0 : Homogenization.cubeCenter (Homogenization.originCube d 0) = 0 := by
      funext i
      simp [Homogenization.cubeCenter, Homogenization.originCube]
    rw [hc0]
    exact Metric.mem_closedBall_self (Homogenization.cubeRadius_pos _).le
  have hmeasEv : Measurable fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d => g 0 := by
    have hforget : Continuous fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d =>
        (g.1.1 : C(SpatialCoordinates d, ℝ)) := continuous_subtype_val.fst
    exact ((continuous_eval_const (0 : SpatialCoordinates d)).comp hforget).measurable
  have hmeas : Measurable fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d =>
      Real.exp (c * |g 0|) := (measurable_const.mul (continuous_abs.measurable.comp hmeasEv)).exp
  have hdom : ∀ g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d,
      Real.exp (c * |g 0|) ≤ Real.exp ((c * M.delta) ^ 2 / 4) * Z g := by
    intro g
    have hE0 : 0 ≤ E g := SubdiffusiveProcess.Frozen.Assumptions.PotentialField.g2Observable_nonneg g
    have hg0 : |g 0| ≤ E g :=
      SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.abs_apply_le_g2Observable_of_mem_closedBall g h0
    have hZg : Z g = Real.exp ((M.delta⁻¹ * E g) ^ (2 : ℕ)) := by
      simp only [hZdef, max_eq_left hE0]
      congr 1
      rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
    rw [hZg, ← Real.exp_add]
    refine Real.exp_le_exp.mpr ?_
    have hexpand : (c * M.delta) ^ 2 / 4 + (M.delta⁻¹ * E g) ^ (2 : ℕ) - c * E g
        = (E g - c * M.delta ^ 2 / 2) ^ 2 / M.delta ^ 2 := by
      field_simp
      ring
    have h2 : 0 ≤ (c * M.delta) ^ 2 / 4 + (M.delta⁻¹ * E g) ^ (2 : ℕ) - c * E g := by
      rw [hexpand]; positivity
    have h3 : c * |g 0| ≤ c * E g := mul_le_mul_of_nonneg_left hg0 hc
    linarith
  have hInt : Integrable (fun g => Real.exp (c * |g 0|))
      (SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure :=
    (hZint.const_mul (Real.exp ((c * M.delta) ^ 2 / 4))).mono'
      hmeas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun g => by
        rw [Real.norm_eq_abs, abs_of_nonneg (Real.exp_pos _).le]
        exact hdom g)
  refine ⟨hInt, ?_⟩
  calc (∫ g, Real.exp (c * |g 0|) ∂(SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure)
      ≤ ∫ g, Real.exp ((c * M.delta) ^ 2 / 4) * Z g
          ∂(SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure :=
        integral_mono hInt (hZint.const_mul _) hdom
    _ = Real.exp ((c * M.delta) ^ 2 / 4) *
        ∫ g, Z g ∂(SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure := integral_const_mul _ _
    _ ≤ Real.exp ((c * M.delta) ^ 2 / 4) * 2 :=
        mul_le_mul_of_nonneg_left hZbound (Real.exp_pos _).le
    _ = 2 * Real.exp ((c * M.delta) ^ 2 / 4) := by ring

theorem aux_lem_band_mac5_potentialField_forget_measurable (d : ℕ)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)] :
    Measurable (fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d =>
      (g.1.1 : C(SpatialCoordinates d, ℝ))) := by
  let forget : C(SubdiffusiveProcess.Frozen.Assumptions.PotentialField d, C(SpatialCoordinates d, ℝ)) :=
    ⟨fun g => g.1.1, continuous_subtype_val.fst⟩
  exact forget.continuous.measurable

theorem aux_lem_band_mac5_exp_layer_quant {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (m : ℤ) (c : ℝ) (hc : 0 ≤ c) :
    Integrable (fun om : BilateralField d => Real.exp (c * |om m 0|)) (chaosSampleLaw M).toMeasure ∧
    (∫ om, Real.exp (c * |om m 0|) ∂(chaosSampleLaw M).toMeasure) ≤
      2 * Real.exp ((c * M.delta) ^ 2 / 4) := by
  have hzero := aux_lem_band_mac5_exp_zero_quant M c hc
  set laws : ℤ → Measure C(SpatialCoordinates d, ℝ) := fun n =>
    (scaledLayerLaw d (chaosRootFieldLaw M) n : Measure C(SpatialCoordinates d, ℝ)) with hlaws
  have hSL : (chaosSampleLaw M).toMeasure = Measure.infinitePi laws := rfl
  set F : C(SpatialCoordinates d, ℝ) → ℝ := fun f => Real.exp (c * |f 0|) with hF
  have hFm : Measurable F :=
    (measurable_const.mul (continuous_abs.measurable.comp
      (continuous_eval_const (0 : SpatialCoordinates d)).measurable)).exp
  have hforgetMeas : Measurable (fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d =>
      (g.1.1 : C(SpatialCoordinates d, ℝ))) :=
    aux_lem_band_mac5_potentialField_forget_measurable d
  have hcompPt : ∀ f, F (layerScaling d m f) = F f := by
    intro f; simp [hF, layerScaling]
  have hcomp : F ∘ (layerScaling d m) = F := funext hcompPt
  have hforgetcompPt : ∀ g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d,
      F g.1.1 = Real.exp (c * |g 0|) := by
    intro g; simp [hF]
  have hforgetcomp : F ∘ (fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d => g.1.1) =
      fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d => Real.exp (c * |g 0|) :=
    funext hforgetcompPt
  have hlawsMeq : laws m = Measure.map (layerScaling d m)
      (chaosRootFieldLaw M : Measure C(SpatialCoordinates d, ℝ)) := by
    simp [hlaws, scaledLayerLaw, ProbabilityMeasure.toMeasure_map]
  have hrootMeq : (chaosRootFieldLaw M : Measure C(SpatialCoordinates d, ℝ)) =
      Measure.map (fun g : SubdiffusiveProcess.Frozen.Assumptions.PotentialField d => g.1.1)
        (SubdiffusiveProcess.Frozen.Assumptions.zeroPotentialLaw M.P).toMeasure := by
    simp only [chaosRootFieldLaw, ProbabilityMeasure.toMeasure_map]
    congr 1
  have hIntF : Integrable F (laws m) := by
    rw [hlawsMeq, integrable_map_measure hFm.aestronglyMeasurable
      (layerScaling d m).continuous.measurable.aemeasurable, hcomp, hrootMeq,
      integrable_map_measure hFm.aestronglyMeasurable hforgetMeas.aemeasurable, hforgetcomp]
    exact hzero.1
  have hIntBound : (∫ f, F f ∂(laws m)) ≤ 2 * Real.exp ((c * M.delta) ^ 2 / 4) := by
    rw [hlawsMeq, MeasureTheory.integral_map
      (layerScaling d m).continuous.measurable.aemeasurable hFm.aestronglyMeasurable]
    simp only [hcompPt]
    rw [hrootMeq, MeasureTheory.integral_map hforgetMeas.aemeasurable hFm.aestronglyMeasurable]
    simp only [hforgetcompPt]
    exact hzero.2
  have hev := measurePreserving_eval_infinitePi laws m
  have hFinf : Integrable (fun om : ℤ → C(SpatialCoordinates d, ℝ) => F (om m))
      (Measure.infinitePi laws) := (hev.integrable_comp hFm.aestronglyMeasurable).2 hIntF
  have hintkey : (∫ f, F f ∂(laws m)) = ∫ om, F (om m) ∂(Measure.infinitePi laws) := by
    rw [← hev.map_eq]
    exact MeasureTheory.integral_map hev.measurable.aemeasurable hFm.aestronglyMeasurable
  rw [hSL]
  exact ⟨hFinf, hintkey ▸ hIntBound⟩

theorem aux_lem_band_mac5_exp_lowAnchor_quant {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (k : ℕ) (c : ℝ) (hc : 0 ≤ c) :
    Integrable (fun om : BilateralField d => Real.exp (c * |MacroAllCube.lowAnchor (d := d) k om|))
      (chaosSampleLaw M).toMeasure ∧
    (∫ om, Real.exp (c * |MacroAllCube.lowAnchor (d := d) k om|) ∂(chaosSampleLaw M).toMeasure) ≤
      1 + 2 * (k : ℝ) * Real.exp ((c * (k : ℝ) * M.delta) ^ 2 / 4) := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simp only [MacroAllCube.lowAnchor, Finset.range_zero, Finset.sum_empty, abs_zero, mul_zero,
      Real.exp_zero]
    refine ⟨integrable_const _, ?_⟩
    simp
  · have hmeas : Measurable fun om : BilateralField d =>
        Real.exp (c * |MacroAllCube.lowAnchor (d := d) k om|) :=
      (measurable_const.mul (continuous_abs.measurable.comp
        (aux_prop_growth_macro_energy_measurable_lowAnchor k))).exp
    have hsum : Integrable (fun om : BilateralField d => ∑ n ∈ Finset.range k,
        Real.exp (c * k * |om (-(Int.ofNat n)) 0|)) (chaosSampleLaw M).toMeasure :=
      integrable_finset_sum _ fun n _ =>
        (aux_lem_band_mac5_exp_layer_quant M (-(Int.ofNat n)) (c * k) (by positivity)).1
    have hsumbound : (∫ om, ∑ n ∈ Finset.range k,
        Real.exp (c * k * |om (-(Int.ofNat n)) 0|) ∂(chaosSampleLaw M).toMeasure) ≤
        (k : ℝ) * (2 * Real.exp ((c * (k : ℝ) * M.delta) ^ 2 / 4)) := by
      rw [integral_finset_sum _ fun n _ =>
        (aux_lem_band_mac5_exp_layer_quant M (-(Int.ofNat n)) (c * k) (by positivity)).1]
      calc (∑ n ∈ Finset.range k, ∫ om, Real.exp (c * k * |om (-(Int.ofNat n)) 0|)
              ∂(chaosSampleLaw M).toMeasure)
          ≤ ∑ n ∈ Finset.range k, 2 * Real.exp ((c * (k : ℝ) * M.delta) ^ 2 / 4) :=
            Finset.sum_le_sum fun n _ =>
              (aux_lem_band_mac5_exp_layer_quant M (-(Int.ofNat n)) (c * k) (by positivity)).2
        _ = (k : ℝ) * (2 * Real.exp ((c * (k : ℝ) * M.delta) ^ 2 / 4)) := by
            rw [Finset.sum_const, Finset.card_range]; ring
    have hpoint : ∀ om : BilateralField d, Real.exp (c * |MacroAllCube.lowAnchor (d := d) k om|) ≤
        ∑ n ∈ Finset.range k, Real.exp (c * k * |om (-(Int.ofNat n)) 0|) := by
      intro om
      calc Real.exp (c * |MacroAllCube.lowAnchor (d := d) k om|)
          ≤ Real.exp (c * ∑ n ∈ Finset.range k, |om (-(Int.ofNat n)) 0|) := by
            apply Real.exp_le_exp.2
            exact mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _) hc
        _ ≤ _ := aux_prop_growth_macro_energy_exp_mul_sum_le
            (fun n => |om (-(Int.ofNat n)) 0|) c hc k hk
    have hInt : Integrable (fun om => Real.exp (c * |MacroAllCube.lowAnchor (d := d) k om|))
        (chaosSampleLaw M).toMeasure :=
      hsum.mono' hmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun om => by
        rw [Real.norm_eq_abs, abs_of_nonneg (Real.exp_pos _).le]
        exact hpoint om)
    refine ⟨hInt, ?_⟩
    calc (∫ om, Real.exp (c * |MacroAllCube.lowAnchor (d := d) k om|)
            ∂(chaosSampleLaw M).toMeasure)
        ≤ ∫ om, ∑ n ∈ Finset.range k, Real.exp (c * k * |om (-(Int.ofNat n)) 0|)
            ∂(chaosSampleLaw M).toMeasure := integral_mono hInt hsum hpoint
      _ ≤ (k : ℝ) * (2 * Real.exp ((c * (k : ℝ) * M.delta) ^ 2 / 4)) := hsumbound
      _ ≤ 1 + 2 * (k : ℝ) * Real.exp ((c * (k : ℝ) * M.delta) ^ 2 / 4) := by
          nlinarith [Real.exp_pos ((c * (k : ℝ) * M.delta) ^ 2 / 4)]

theorem aux_lem_band_mac5_env_pow_quant (d : ℕ)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (kk j : ℕ) (q delta0 : ℝ) (hq : 0 < q) (hdelta0 : 0 ≤ delta0) :
    ∃ Bnv : ℝ, 0 ≤ Bnv ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ delta0 →
        eLpNorm (fun om : BilateralField d => aux_prop_growth_macro_energy_env M kk om ^ j)
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bnv := by
  set B : ℝ := Real.exp ((j : ℝ) * q * 3 * (kk : ℝ) * (Real.log 2 / 2) * delta0 ^ 2) with hBdef
  have hB0 : 0 ≤ B := (Real.exp_pos _).le
  set Rbound : ℝ := B * (1 + 2 * (kk : ℝ) *
      Real.exp (((j : ℝ) * q * (kk : ℝ) * delta0) ^ 2 / 4)) with hRbounddef
  have hRbound0 : 0 ≤ Rbound := by rw [hRbounddef]; positivity
  refine ⟨Rbound ^ q⁻¹, Real.rpow_nonneg hRbound0 _, ?_⟩
  intro M hδ
  have hlA := aux_lem_band_mac5_exp_lowAnchor_quant M kk ((j : ℝ) * q) (by positivity)
  have htauM : SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P ≤ (Real.log 2 / 2) * delta0 ^ 2 := by
    have h1 := SubdiffusiveProcess.CoarseGrainingVocab.tauSq_le_delta_sq M
    have h2 : M.delta ^ 2 ≤ delta0 ^ 2 := pow_le_pow_left₀ M.shellPrefix.delta_pos.le hδ 2
    have h3 : 0 ≤ Real.log 2 / 2 := by positivity
    nlinarith
  have htauabs : |SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P| = SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P :=
    abs_of_pos M.G4.tauSq_pos
  have hYm : AEStronglyMeasurable (fun om => aux_prop_growth_macro_energy_env M kk om ^ j) (chaosSampleLaw M).toMeasure := by
    simpa only [aux_prop_growth_macro_energy_env, Function.comp_apply] using! (measurable_const.add (aux_prop_growth_macro_energy_measurable_lowAnchor (d := d) kk).abs).exp.pow_const j |>.aestronglyMeasurable
  rw [← SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded hYm]
  refine aux_lem_band_mac4_eLpNorm_of_exp_bound (chaosSampleLaw M).toMeasure
    (p := q) (B := B) (c := (j : ℝ) * q)
    (Y := fun om => aux_prop_growth_macro_energy_env M kk om ^ j)
    (X := fun om => |MacroAllCube.lowAnchor (d := d) kk om|)
    hq hB0 (Real.rpow_nonneg hRbound0 _)
    (fun om => (pow_pos (Real.exp_pos _) j).le) ?_ hlA.1 ?_
  · intro om
    have hexp_eq : (aux_prop_growth_macro_energy_env M kk om ^ j) ^ q =
        Real.exp ((j : ℝ) * q * (3 * (kk : ℝ) * |SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P|)) *
          Real.exp ((j : ℝ) * q * |MacroAllCube.lowAnchor (d := d) kk om|) := by
      unfold aux_prop_growth_macro_energy_env
      rw [← Real.exp_nat_mul, ← Real.exp_mul, ← Real.exp_add]
      congr 1
      ring
    rw [hexp_eq, htauabs]
    have hcoeff : (0 : ℝ) ≤ (j : ℝ) * q * (3 * (kk : ℝ)) := by positivity
    have hstep : (j : ℝ) * q * (3 * (kk : ℝ) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) ≤
        (j : ℝ) * q * (3 * (kk : ℝ) * ((Real.log 2 / 2) * delta0 ^ 2)) := by
      have := mul_le_mul_of_nonneg_left htauM hcoeff
      nlinarith [this]
    calc Real.exp ((j : ℝ) * q * (3 * (kk : ℝ) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P)) *
          Real.exp ((j : ℝ) * q * |MacroAllCube.lowAnchor (d := d) kk om|)
        ≤ Real.exp ((j : ℝ) * q * (3 * (kk : ℝ) * ((Real.log 2 / 2) * delta0 ^ 2))) *
            Real.exp ((j : ℝ) * q * |MacroAllCube.lowAnchor (d := d) kk om|) :=
          mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr hstep) (Real.exp_pos _).le
      _ = B * Real.exp ((j : ℝ) * q * |MacroAllCube.lowAnchor (d := d) kk om|) := by
          rw [hBdef]; ring_nf
  · rw [Real.rpow_inv_rpow hRbound0 hq.ne']
    have hlAdelta0 : 1 + 2 * (kk : ℝ) * Real.exp (((j : ℝ) * q * (kk : ℝ) * M.delta) ^ 2 / 4) ≤
        1 + 2 * (kk : ℝ) * Real.exp (((j : ℝ) * q * (kk : ℝ) * delta0) ^ 2 / 4) := by
      have hd2 : |(j : ℝ) * q * (kk : ℝ) * M.delta| ≤ |(j : ℝ) * q * (kk : ℝ) * delta0| := by
        rw [abs_of_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (Nat.cast_nonneg j) hq.le)
              (Nat.cast_nonneg kk)) M.shellPrefix.delta_pos.le),
          abs_of_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (Nat.cast_nonneg j) hq.le)
              (Nat.cast_nonneg kk)) hdelta0)]
        exact mul_le_mul_of_nonneg_left hδ
          (mul_nonneg (mul_nonneg (Nat.cast_nonneg j) hq.le) (Nat.cast_nonneg kk))
      have hsqle : ((j : ℝ) * q * (kk : ℝ) * M.delta) ^ 2 ≤
          ((j : ℝ) * q * (kk : ℝ) * delta0) ^ 2 := by
        rw [← sq_abs ((j : ℝ) * q * (kk : ℝ) * M.delta), ← sq_abs ((j : ℝ) * q * (kk : ℝ) * delta0)]
        exact pow_le_pow_left₀ (abs_nonneg _) hd2 2
      have hexple : Real.exp (((j : ℝ) * q * (kk : ℝ) * M.delta) ^ 2 / 4) ≤
          Real.exp (((j : ℝ) * q * (kk : ℝ) * delta0) ^ 2 / 4) :=
        Real.exp_le_exp.mpr (by linarith)
      nlinarith [hexple, (Nat.cast_nonneg kk : (0 : ℝ) ≤ (kk : ℝ))]
    calc B * (∫ om, Real.exp ((j : ℝ) * q * |MacroAllCube.lowAnchor (d := d) kk om|)
