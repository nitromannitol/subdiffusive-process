  have hZ : 0 ≤ Z := aux_aux_macro_energy_recurrence_Z_nonneg _ _ _ _
  let BX : ℝ≥0∞ := ENNReal.ofReal
    (Real.exp ((2 * (2 * q) * t * Real.log 3) * ((⌈Cn⌉₊ + 1 : ℕ) : ℝ)) *
      (((⌈Cn⌉₊ + 1 : ℕ) : ℝ) + Cn *
        Real.exp (κ0 * (Cn + 1 - ((⌈Cn⌉₊ + 1 : ℕ) : ℝ))) *
        (1 - Real.exp ((2 * (2 * q) * t * Real.log 3) - κ0))⁻¹)) ^ (1 / (2 * (2 * q)))
  have hBX : BX ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top
  let B : ℝ≥0∞ :=
    ENNReal.ofReal ((3 : ℝ) ^ ((kk : ℝ) * t) * r ^ (-t)) * ENNReal.ofReal Cg +
      (ENNReal.ofReal (18 * Z * (3 : ℝ) ^ t * (r ^ d * (r⁻¹) ^ 2 * r ^ (-t))) *
        (ENNReal.ofReal B3 * (BX * ENNReal.ofReal CE)) +
      ENNReal.ofReal (18 * Z * (3 : ℝ) ^ t * (r ^ d * (r⁻¹) ^ 2 * r ^ (-t)) *
        ((r⁻¹) ^ d * (r⁻¹) ^ 2)) * (ENNReal.ofReal B6 * (BX * ENNReal.ofReal Cg)))
  have hB : B ≠ ⊤ := by
    dsimp [B]
