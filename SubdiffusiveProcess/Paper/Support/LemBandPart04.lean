theorem aux_lem_band_rb_ulm_key
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (hr1 : r ≤ 1)
    (s : ℝ) (hs0 : 0 < s) (hs1 : s ≤ 1)
    (Q Cd Cqv dl p : ℝ) (hQ1 : 1 ≤ Q) (hpQ : p ≤ Q) (hDQ : 2 * (d : ℝ) ≤ s * Q)
    (hCd0 : 0 < Cd) (hCqv0 : 0 < Cqv)
    (hdlnn : 0 ≤ dl)
    (hcondA : Cd * (Q + Q ^ 2) * dl ^ 2 ≤ (s / 4) * Real.log 3)
    (hcondB : Cd * dl * (1 + dl) ≤ s * Real.log 3)
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (N : ℕ)
    (hYmeasN : ∀ n : ℕ, AEStronglyMeasurable (fun om =>
        Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
          (Homogenization.originCube d 0) (-(n : ℤ))
          (E.chart z r hr (cutoffPositiveCoefficient M H om N z hr) z r))
        (chaosSampleLaw M).toMeasure)
    (hYboundN : ∀ n : ℕ, eLpNorm (fun om =>
        Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
          (Homogenization.originCube d 0) (-(n : ℤ))
          (E.chart z r hr (cutoffPositiveCoefficient M H om N z hr) z r))
        (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Cqv * (if n ≤ N then (3 : ℝ) ^ ((d : ℝ) * (n : ℝ) / Q) *
            Real.exp (Cd * (Q + Q ^ 2) * dl ^ 2 * (n : ℝ))
          else Real.exp ((Cd * dl + Cd * dl ^ 2) * (N : ℝ))))) :
    MemLp (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ∧
    eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal
      ((1 - (3 : ℝ) ^ (-s)) * Cqv /
          (1 - Real.exp (-(s / 2) * Real.log 3 + Cd * (Q + Q ^ 2) * dl ^ 2)) +
        (1 - (3 : ℝ) ^ (-s)) * Cqv * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s))) := by
  have hQpge : ENNReal.ofReal p ≤ ENNReal.ofReal Q := ENNReal.ofReal_le_ofReal hpQ
  set YN : ℕ → BilateralField d → ℝ := fun n om =>
    Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
      (Homogenization.originCube d 0) (-(n : ℤ))
      (E.chart z r hr (cutoffPositiveCoefficient M H om N z hr) z r) with hYN_def
  have hYNnn : ∀ n om, 0 ≤ YN n om := fun n om => aux_lane4_lambda_inv_moments_Y_nonneg _ _
  obtain ⟨hMemLpQ, hBoundQ, hSummableAE⟩ :=
    aux_lane4_lambda_inv_moments_series_bound (chaosSampleLaw M).toMeasure s (d : ℝ) Q
      Cd Cqv dl N hs0 (Nat.cast_nonneg d) hDQ hQ1 hCd0 hCqv0
      hdlnn hcondA hcondB YN hYNnn hYmeasN hYboundN
  have hae_dom : ∀ᵐ om ∂(chaosSampleLaw M).toMeasure,
      (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹ ≤
        ∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight s 1 n * YN n om := by
    filter_upwards [hSummableAE] with om hom_summable
    obtain ⟨Ssum0, hSsum0nn, hsqrt_summable, hSsum0eq, hlam_inv_eq⟩ :=
      aux_lane4_lambda_inv_moments_lam_inv_eq E z r hr (cutoffPositiveCoefficient M H om N z hr)
        s hs0 hs1
    have hYnn' : ∀ n : ℕ, 0 ≤ YN n om := fun n => hYNnn n om
    have hcs := aux_lane4_lambda_inv_moments_cs hs0 0 (fun n => YN n om) hYnn'
      (by simpa using hsqrt_summable) (by simpa using hom_summable)
    simp only [Finset.range_zero, Finset.sum_empty, zero_add, Nat.add_zero] at hcs
    rw [hlam_inv_eq, hSsum0eq]
    exact hcs
  have hsqrt_summable_all : ∀ om : BilateralField d, Summable (fun n : ℕ =>
      Homogenization.Book.Ch02.geometricWeight s 1 n * Real.rpow (YN n om) (1 / 2)) := by
    intro om
    obtain ⟨_, _, hs', _, _⟩ := aux_lane4_lambda_inv_moments_lam_inv_eq E z r hr
      (cutoffPositiveCoefficient M H om N z hr) s hs0 hs1
    exact hs'
  have hSsum_meas : AEStronglyMeasurable (fun om => ∑' n : ℕ,
      Homogenization.Book.Ch02.geometricWeight s 1 n * Real.rpow (YN n om) (1 / 2))
      (chaosSampleLaw M).toMeasure :=
    aux_lane4_lambda_inv_moments_Ssum_meas (chaosSampleLaw M).toMeasure s YN hYmeasN
      hsqrt_summable_all
  have hlam_inv_meas : AEStronglyMeasurable (fun om : BilateralField d =>
      (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (chaosSampleLaw M).toMeasure := by
    have heq : (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹) =
        (fun om => (∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight s 1 n *
          Real.rpow (YN n om) (1 / 2)) ^ 2) := by
      funext om
      obtain ⟨Ssum0, _, _, hSsum0eq, hlam_inv_eq⟩ := aux_lane4_lambda_inv_moments_lam_inv_eq E z r hr
        (cutoffPositiveCoefficient M H om N z hr) s hs0 hs1
      rw [hlam_inv_eq, hSsum0eq]
    rw [heq]
    exact (continuous_pow 2).comp_aestronglyMeasurable hSsum_meas
  have hlam_nn : ∀ om : BilateralField d, 0 ≤
      (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹ := fun om =>
    le_of_lt (inv_pos.mpr (E.lam_pos _ _ _ _ _ _ _ _))
  have heLpNorm_le : eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure ≤
      eLpNorm (fun om => ∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight s 1 n * YN n om)
        (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure := by
    apply eLpNorm_mono_ae_real hlam_inv_meas
    filter_upwards [hae_dom] with om hom
    rwa [Real.norm_of_nonneg (hlam_nn om)]
  have heLpNorm_final : eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      eLpNorm (fun om : BilateralField d =>
          (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
        (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure :=
    eLpNorm_le_eLpNorm_of_exponent_le hQpge
  have hfinal_bound : eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal
      ((1 - (3 : ℝ) ^ (-s)) * Cqv /
          (1 - Real.exp (-(s / 2) * Real.log 3 + Cd * (Q + Q ^ 2) * dl ^ 2)) +
        (1 - (3 : ℝ) ^ (-s)) * Cqv * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s))) :=
    heLpNorm_final.trans (heLpNorm_le.trans hBoundQ)
  exact ⟨hfinal_bound.trans_lt ENNReal.ofReal_lt_top, hfinal_bound⟩

theorem aux_lem_band_rem_bank_uniform_neumann_growth_Kbound
    (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (p PC Cres ClamF6p Dr Cp : ℝ)
    (hp : 2 ≤ p) (hDr : 0 ≤ Dr) (hCp0 : 0 ≤ Cp)
    (hCpdef : Cp = max (max Cres (PC ^ 2 * ClamF6p)) 0)
    (Kres Lam : ℕ → BilateralField d → ℝ)
    (hKresMem : ∀ N, MemLp (Kres N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure)
    (hKresBd : ∀ N, eLpNorm (Kres N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal Cres)
    (hLamMem' : ∀ N, MemLp (Lam N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure)
    (hLamBd' : ∀ N, eLpNorm (Lam N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ClamF6p) :
    ∀ N, MemLp (fun om => Dr ^ 2 * (Kres N om * (1 + PC ^ 2 * Lam N om)))
        (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun om => Dr ^ 2 * (Kres N om * (1 + PC ^ 2 * Lam N om)))
        (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (Dr ^ 2 * (Cp * (1 + Cp))) := by
  have hq1 : (1 : ℝ) ≤ 3 * p := by linarith
  intro N
  have hV : MemLp (fun om => PC ^ 2 * Lam N om) (ENNReal.ofReal (2 * (3 * p)))
      (chaosSampleLaw M).toMeasure := (hLamMem' N).const_mul _
  have hUb : eLpNorm (Kres N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal Cp := by
    refine (hKresBd N).trans ?_
    rw [hCpdef]
    exact ENNReal.ofReal_le_ofReal ((le_max_left _ _).trans (le_max_left _ _))
  have hVb : eLpNorm (fun om => PC ^ 2 * Lam N om) (ENNReal.ofReal (2 * (3 * p)))
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Cp := by
    have hs1 :
        eLpNorm (fun om => PC ^ 2 * Lam N om) (ENNReal.ofReal (2 * (3 * p)))
            (chaosSampleLaw M).toMeasure ≤
          ‖PC ^ 2‖ₑ * eLpNorm (Lam N) (ENNReal.ofReal (2 * (3 * p)))
            (chaosSampleLaw M).toMeasure :=
      eLpNorm_const_smul_le (c := PC ^ 2) (f := Lam N) (p := ENNReal.ofReal (2 * (3 * p)))
        (μ := (chaosSampleLaw M).toMeasure)
    have hs2 :
        ‖PC ^ 2‖ₑ * eLpNorm (Lam N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
          ‖PC ^ 2‖ₑ * ENNReal.ofReal ClamF6p :=
      mul_le_mul_right (hLamBd' N) _
    have hs3 : ‖PC ^ 2‖ₑ * ENNReal.ofReal ClamF6p = ENNReal.ofReal (PC ^ 2 * ClamF6p) := by
      rw [Real.enorm_eq_ofReal (by positivity)]
      exact (ENNReal.ofReal_mul (by positivity)).symm
    have hs4 : ENNReal.ofReal (PC ^ 2 * ClamF6p) ≤ ENNReal.ofReal Cp := by
      rw [hCpdef]
      exact ENNReal.ofReal_le_ofReal ((le_max_right _ _).trans (le_max_left _ _))
    exact ((hs1.trans hs2).trans_eq hs3).trans hs4
  obtain ⟨hUVmem, hUVb⟩ := aux_rem_resolved_UV_moment (chaosSampleLaw M).toMeasure (3 * p) Cp
    hq1 hCp0 (Kres N) (fun om => PC ^ 2 * Lam N om) (hKresMem N) hV hUb hVb
  refine ⟨hUVmem.const_mul (Dr ^ 2), ?_⟩
  have ht1 :
      eLpNorm (fun om => Dr ^ 2 * (Kres N om * (1 + PC ^ 2 * Lam N om)))
          (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
        ‖Dr ^ 2‖ₑ * eLpNorm (fun om => Kres N om * (1 + PC ^ 2 * Lam N om))
          (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure :=
    eLpNorm_const_smul_le (c := Dr ^ 2) (f := fun om => Kres N om * (1 + PC ^ 2 * Lam N om))
      (p := ENNReal.ofReal (3 * p)) (μ := (chaosSampleLaw M).toMeasure)
  have ht2 :
      ‖Dr ^ 2‖ₑ * eLpNorm (fun om => Kres N om * (1 + PC ^ 2 * Lam N om))
          (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
        ‖Dr ^ 2‖ₑ * ENNReal.ofReal (Cp * (1 + Cp)) :=
    mul_le_mul_right hUVb _
  have ht3 : ‖Dr ^ 2‖ₑ * ENNReal.ofReal (Cp * (1 + Cp)) =
      ENNReal.ofReal (Dr ^ 2 * (Cp * (1 + Cp))) := by
    rw [Real.enorm_eq_ofReal (by positivity)]
    exact (ENNReal.ofReal_mul (by positivity)).symm
  exact (ht1.trans ht2).trans_eq ht3

