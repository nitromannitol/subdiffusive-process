      Lm hLm BX hLb' (aux_prop_growth_macro_energy_Rs H' z r) hRmeas (ENNReal.ofReal CE) hRb
      Kg (ENNReal.ofReal Cg) (fun N => (hKgm N).aestronglyMeasurable) hKgb N
    refine ⟨hh.1, hh.2.trans ?_⟩
    rw [ENNReal.ofReal_toReal hB]
