  have htau : SubdiffusiveProcess.Frozen.Assumptions.tauSq M'.P = SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P :=
    ResidualModel.residualModel_tauSq M hk1.le hk3 hδD
  have hshift : ∀ n o, aux_prop_growth_macro_energy_shiftC M M' kk n o ≤
      aux_prop_growth_macro_energy_env M kk o ∧
