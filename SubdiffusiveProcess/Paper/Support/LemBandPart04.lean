        ≤ B * (1 + 2 * (kk : ℝ) * Real.exp (((j : ℝ) * q * (kk : ℝ) * M.delta) ^ 2 / 4)) :=
          mul_le_mul_of_nonneg_left hlA.2 hB0
      _ ≤ B * (1 + 2 * (kk : ℝ) * Real.exp (((j : ℝ) * q * (kk : ℝ) * delta0) ^ 2 / 4)) :=
          mul_le_mul_of_nonneg_left hlAdelta0 hB0
      _ = Rbound := hRbounddef.symm

theorem aux_lem_band_mac4_lintegral_exp_le_uniform {α : Type*} [MeasurableSpace α]
    (μ : Measure α) [IsProbabilityMeasure μ] (L : α → ℕ) (hL : Measurable L)
    (Cc κ0 κ lam : ℝ) (hCc : 1 ≤ Cc) (hlam : 0 ≤ lam) (hκ0lam : lam < κ0) (hκ0κ : κ0 ≤ κ)
    (n0 : ℕ) (hn0 : Cc + 1 ≤ (n0 : ℝ))
    (htail : ∀ k : ℕ, μ {om : α | k < L om} ≤
      ENNReal.ofReal (Cc * Real.exp (κ * Cc) * Real.exp (-κ * k))) :
    ∫⁻ om, ENNReal.ofReal (Real.exp (lam * (L om : ℝ))) ∂μ ≤
      ENNReal.ofReal (Real.exp (lam * (n0 : ℝ)) *
        ((n0 : ℝ) + Cc * Real.exp (κ0 * (Cc + 1 - (n0 : ℝ))) * (1 - Real.exp (lam - κ0))⁻¹)) := by
  have hκ00 : 0 < κ0 := lt_of_le_of_lt hlam hκ0lam
  have hκpos : 0 < κ := lt_of_lt_of_le hκ00 hκ0κ
  have hn01 : (1 : ℝ) ≤ (n0 : ℝ) := le_trans (by linarith) hn0
  have hn0pos : 1 ≤ n0 := by exact_mod_cast hn01
  have hρlt : Real.exp (lam - κ) < 1 := by
    rw [Real.exp_lt_one_iff]; linarith
  have hρ0lt : Real.exp (lam - κ0) < 1 := by
    rw [Real.exp_lt_one_iff]; linarith
  have hρnn : (0:ℝ) ≤ Real.exp (lam - κ) := (Real.exp_pos _).le
  have hden0 : (0:ℝ) < 1 - Real.exp (lam - κ) := by linarith
  have hden00 : (0:ℝ) < 1 - Real.exp (lam - κ0) := by linarith
  have hdenmono : Real.exp (lam - κ) ≤ Real.exp (lam - κ0) := by
    apply Real.exp_le_exp.mpr; linarith
  have hinvmono : (1 - Real.exp (lam - κ))⁻¹ ≤ (1 - Real.exp (lam - κ0))⁻¹ := by
    rw [← one_div, ← one_div]
    exact one_div_le_one_div_of_le hden00 (by linarith)
  have hexpmono : Real.exp (κ * (Cc + 1 - (n0:ℝ))) ≤ Real.exp (κ0 * (Cc + 1 - (n0:ℝ))) := by
    apply Real.exp_le_exp.mpr
    have hnn : Cc + 1 - (n0:ℝ) ≤ 0 := by linarith
    nlinarith
  have hlint : ∫⁻ om, ENNReal.ofReal (Real.exp (lam * (L om : ℝ))) ∂μ =
      ∑' n : ℕ, ENNReal.ofReal (Real.exp (lam * n)) * μ (L ⁻¹' {n}) := by
    have hg : Measurable (fun n : ℕ => ENNReal.ofReal (Real.exp (lam * n))) :=
      measurable_from_nat
    rw [← lintegral_map hg hL, lintegral_countable']
    congr 1
    funext n
    rw [Measure.map_apply hL (measurableSet_singleton n)]
  rw [hlint]
  set f : ℕ → ℝ≥0∞ := fun n => ENNReal.ofReal (Real.exp (lam * (n : ℝ))) * μ (L ⁻¹' {n}) with hfdef
                                                                         
  have hbranch : ∀ n : ℕ, n0 ≤ n →
      f n ≤ ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
        ENNReal.ofReal (Real.exp ((lam - κ) * n)) := by
    intro n hn
    have hn1 : 1 ≤ n := le_trans hn0pos hn
    have hset : L ⁻¹' {n} ⊆ {om : α | (n - 1) < L om} := by
      intro om hom
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hom
      simp only [Set.mem_setOf_eq, hom]
      omega
    have htailn := (measure_mono hset).trans (htail (n - 1))
    have hcast : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
      push_cast [Nat.cast_sub hn1]; ring
    rw [hcast] at htailn
    have heq : Cc * Real.exp (κ * Cc) * Real.exp (-κ * ((n : ℝ) - 1)) =
        Cc * Real.exp (κ * (Cc + 1)) * Real.exp (-κ * (n : ℝ)) := by
      rw [show κ * (Cc + 1) = κ * Cc + κ by ring,
        show (-κ * ((n : ℝ) - 1)) = -κ * (n : ℝ) + κ by ring, Real.exp_add, Real.exp_add]
      ring
    rw [heq] at htailn
    rw [hfdef]
    refine (mul_le_mul_right htailn _).trans (le_of_eq ?_)
    rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show Real.exp (lam * n) * (Cc * Real.exp (κ * (Cc + 1)) * Real.exp (-κ * (n : ℝ))) =
        Cc * Real.exp (κ * (Cc + 1)) * (Real.exp (lam * n) * Real.exp (-κ * (n : ℝ))) by ring,
      ← Real.exp_add]
    congr 2
    ring
  have hsplit : (∑ i ∈ Finset.range n0, f i) + ∑' i : ℕ, f (i + n0) = ∑' n, f n :=
    (ENNReal.summable (f := fun n : ℕ => f (n + n0))).sum_add_tsum_nat_add'
  rw [← hsplit]
                                                           
  have hhead : (∑ i ∈ Finset.range n0, f i) ≤ ENNReal.ofReal ((n0 : ℝ) * Real.exp (lam * (n0:ℝ))) := by
    have hb : (∑ i ∈ Finset.range n0, f i) ≤
        ∑ _i ∈ Finset.range n0, ENNReal.ofReal (Real.exp (lam * (n0 : ℝ))) := by
      apply Finset.sum_le_sum
      intro i hi
      have h1 : μ (L ⁻¹' {i}) ≤ 1 := prob_le_one
      have h2 : f i ≤ ENNReal.ofReal (Real.exp (lam * i)) := by
        rw [hfdef]
        calc ENNReal.ofReal (Real.exp (lam * (i:ℝ))) * μ (L ⁻¹' {i})
            ≤ ENNReal.ofReal (Real.exp (lam * (i:ℝ))) * 1 := mul_le_mul_right h1 _
          _ = ENNReal.ofReal (Real.exp (lam * (i:ℝ))) := mul_one _
      have h3 : Real.exp (lam * i) ≤ Real.exp (lam * (n0 : ℝ)) := by
        apply Real.exp_le_exp.mpr
        apply mul_le_mul_of_nonneg_left _ hlam
        exact_mod_cast (Finset.mem_range.mp hi).le
      exact h2.trans (ENNReal.ofReal_le_ofReal h3)
    refine hb.trans (le_of_eq ?_)
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, ← ENNReal.ofReal_natCast n0,
      ← ENNReal.ofReal_mul (Nat.cast_nonneg n0)]
                                                                
  have htailsum : (∑' i : ℕ, f (i + n0)) ≤
      ENNReal.ofReal (Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ))) * Real.exp (lam * (n0:ℝ)) *
        (1 - Real.exp (lam - κ0))⁻¹) := by
    have hstep1 : (∑' i : ℕ, f (i + n0)) ≤
        ∑' i : ℕ, ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
          ENNReal.ofReal (Real.exp ((lam - κ) * (i + n0 : ℕ))) :=
      ENNReal.tsum_le_tsum fun i => hbranch (i + n0) (Nat.le_add_left n0 i)
    have hstep2 : (∑' i : ℕ, ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
        ENNReal.ofReal (Real.exp ((lam - κ) * (i + n0 : ℕ)))) =
        ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ))) *
          ENNReal.ofReal (1 - Real.exp (lam - κ))⁻¹ := by
      have hfun : (fun i : ℕ => ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1))) *
          ENNReal.ofReal (Real.exp ((lam - κ) * (i + n0 : ℕ)))) =
          fun i : ℕ => ENNReal.ofReal (Cc * Real.exp (κ * (Cc + 1) + (lam - κ) * (n0:ℝ))) *
            ENNReal.ofReal (Real.exp (lam - κ) ^ i) := by
        funext i
        have hexppow : Real.exp ((lam - κ) * (i:ℝ)) = Real.exp (lam - κ) ^ i := by
          rw [show (lam - κ) * (i:ℝ) = (i:ℝ) * (lam - κ) by ring, Real.exp_nat_mul]
        have hreal : Cc * Real.exp (κ * (Cc + 1)) * Real.exp ((lam - κ) * ((i + n0 : ℕ):ℝ)) =
            Cc * Real.exp (κ * (Cc + 1) + (lam - κ) * (n0:ℝ)) * Real.exp (lam - κ) ^ i := by
          push_cast
          rw [show (lam - κ) * ((i:ℝ) + (n0:ℝ)) = (lam - κ) * (n0:ℝ) + (lam - κ) * (i:ℝ) by ring,
            Real.exp_add, Real.exp_add, hexppow]
          ring
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity), hreal]
      rw [hfun, ENNReal.tsum_mul_left, ← ENNReal.ofReal_tsum_of_nonneg
        (fun i => pow_nonneg (Real.exp_pos _).le i)
        (summable_geometric_of_lt_one (Real.exp_pos _).le hρlt),
        tsum_geometric_of_lt_one (Real.exp_pos _).le hρlt]
      congr 2
      ring
    refine hstep1.trans (hstep2.trans_le ?_)
    rw [← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_ofReal
    have hexpmono' : Real.exp (κ * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) ≤
        Real.exp (κ0 * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) := by
      apply Real.exp_le_exp.mpr
      have : κ * (Cc + 1 - (n0:ℝ)) ≤ κ0 * (Cc + 1 - (n0:ℝ)) := by
        have hnn : Cc + 1 - (n0:ℝ) ≤ 0 := by linarith
        nlinarith
      linarith
    calc Cc * Real.exp (κ * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) * (1 - Real.exp (lam - κ))⁻¹
        ≤ Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) * (1 - Real.exp (lam - κ))⁻¹ := by
          gcongr
      _ ≤ Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ)) + lam * (n0:ℝ)) * (1 - Real.exp (lam - κ0))⁻¹ := by
          gcongr
      _ = Cc * Real.exp (κ0 * (Cc + 1 - (n0:ℝ))) * Real.exp (lam * (n0:ℝ)) *
            (1 - Real.exp (lam - κ0))⁻¹ := by rw [Real.exp_add]; ring
  refine (add_le_add hhead htailsum).trans (le_of_eq ?_)
  rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 1
  ring

