theorem aux_lem_band_L1c_Cbound_mono (s CdFp Qfp Cq1 Cq2 δ1 δ2 : ℝ)
    (hs0 : 0 < s) (hCdF : 0 ≤ CdFp) (hQf : 0 ≤ Qfp) (hCq1 : 0 ≤ Cq1) (hCqle : Cq1 ≤ Cq2)
    (hδ1 : 0 ≤ δ1) (hle : δ1 ≤ δ2)
    (hcondA2 : CdFp * (Qfp + Qfp ^ 2) * δ2 ^ 2 ≤ (s / 4) * Real.log 3) :
    (1 - (3 : ℝ) ^ (-s)) * Cq1 /
