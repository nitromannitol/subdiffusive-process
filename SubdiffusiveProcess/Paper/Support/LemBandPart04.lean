      (hU0 N om) (hV0 N om) (hDe0 N om) (hω2 N).2.1 (hω2 N).2.2 (hω2 N).1
      (hmicL ((3 : ℝ) ^ (-(N : ℝ))) (Real.rpow_pos_of_pos (by norm_num) _)
