  have hδD := hδ.trans ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
  have hδ1 := hδ.trans ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
  let M' := ResidualModel.residualModel M hk1.le hk3 hδD
  have hT : MeasurePreserving (MacroAllCube.residualShift (d := d) r kk)
