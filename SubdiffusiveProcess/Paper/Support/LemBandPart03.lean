    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (hprim : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
      primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (N m : ℕ) (w : Vec d) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, Rraw N m w omega ≠ ⊤ := by
  filter_upwards [hprim] with omega hω
  obtain ⟨_, _, _, _, _, _, hR, _⟩ := hω N
  have hRmw := hR m w
  dsimp only at hRmw
  rw [hRmw]
  exact aux_psf_Rsc_ne_top M s m w (eta N omega)

theorem aux_lem_band_poly_le_exp (margin : ℝ) (hmargin : 0 < margin) :
    ∃ Const : ℝ, 0 ≤ Const ∧ ∀ h : ℕ, (2 * (h : ℝ) + 3) ≤ Const * (3 : ℝ) ^ (margin * (h : ℝ)) := by
  set b : ℝ := (3 : ℝ) ^ margin with hbdef
  have hb1 : 1 < b := by
    rw [hbdef]
    exact Real.one_lt_rpow_iff_of_pos (by norm_num) |>.mpr (Or.inl ⟨by norm_num, hmargin⟩)
  set t : ℝ := b - 1 with htdef
  have ht0 : 0 < t := by rw [htdef]; linarith
  refine ⟨2 / t + 3, by positivity, fun h => ?_⟩
  have hbern := one_add_mul_le_pow (by linarith : (-2 : ℝ) ≤ t) h
  have hbpow : (1 + t) ^ h = b ^ h := by rw [htdef]; ring_nf
  rw [hbpow] at hbern
  have hb1h : (1 : ℝ) ≤ b ^ h := one_le_pow₀ hb1.le
  have hnt : (h : ℝ) * t ≤ b ^ h := by linarith
  have hn_le : (h : ℝ) ≤ b ^ h / t := by rw [le_div_iff₀ ht0]; linarith
  have hpoweq : (3 : ℝ) ^ (margin * (h : ℝ)) = b ^ h := by
    rw [hbdef, ← Real.rpow_natCast b h, ← Real.rpow_mul (by norm_num), mul_comm]
  rw [hpoweq]
  have hfin : (2 * (h : ℝ) + 3) ≤ 2 * (b ^ h / t) + 3 * b ^ h := by linarith [hn_le]
  calc (2 * (h : ℝ) + 3) ≤ 2 * (b ^ h / t) + 3 * b ^ h := hfin
    _ = (2 / t + 3) * b ^ h := by ring

theorem aux_lem_band_trunc_tail {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (s : ℝ)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (q' b : ℝ) (hq'1 : 1 ≤ q') (hsq' : 8 * (d : ℝ) < s * q')
    (hbank : ∀ (n : ℕ) (x : Vec d),
      eLpNorm (fun η : _root_.SubdiffusiveProcess.Model.PotentialSample d => (aux_psf_Jval M n η x).toReal)
        (ENNReal.ofReal q') M.P.toMeasure ≤ ENNReal.ofReal b) (hb : 0 ≤ b)
    (N m : ℕ) (w : Vec d) (H' : ℕ) (hH'm : H' ≤ m) :
    eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) m w H').toReal)
      (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (aux_prefix_rraw_K d s q' * aux_prefix_rraw_rho d s q' ^ (H' + 1) * b) := by
  have hstep1 : eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) m w H').toReal)
      (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
      eLpNorm (fun omega => (aux_prefix_rraw_tail M s (eta N omega) m w H').toReal)
        (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure := by
    have hmR : AEStronglyMeasurable (fun omega =>
        (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal) (chaosSampleLaw M).toMeasure :=
      ((aux_lem_prefix_limit_actual_Rsc_meas M s m w).comp_aemeasurable
        (prefix_eta_aemeasurable M eta heta N)).ennreal_toReal.aestronglyMeasurable
    have hmS : AEStronglyMeasurable (fun omega =>
        (aux_prefix_rraw_shallow M s (eta N omega) m w H').toReal) (chaosSampleLaw M).toMeasure :=
      ((aux_prefix_rraw_shallow_measurable M s m w H').comp_aemeasurable
        (prefix_eta_aemeasurable M eta heta N)).ennreal_toReal.aestronglyMeasurable
    refine eLpNorm_mono_ae_real (hmR.sub hmS) (Eventually.of_forall fun omega => ?_)
    change ‖(aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
      (aux_prefix_rraw_shallow M s (eta N omega) m w H').toReal‖ ≤ _
    rw [Real.norm_eq_abs]
    exact aux_prefix_rraw_abs_Rset_sub_shallow_le M s (eta N omega) m w H' hH'm
  exact hstep1.trans ((aux_prefix_rraw_tail_eLpNorm_le M s eta heta q' b hq'1 hbank N m w H').trans
    (aux_prefix_rraw_tail_numeric d s q' (by linarith) hsq' b hb H' m))

theorem aux_lem_band_trunc_retained
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I) (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.deterministic_good_scale_input d) (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s : ℝ) (hs0 : 0 < s)
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (hRm : Rm.C ≤ Cresp)
    (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg)
    (Hif : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M Hif)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (q' : ℝ) (hq'1 : 1 ≤ q')
    (hMdelta_rcJ : M.delta ≤
      aux_lem_band_rcJ_delta0 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
        q' hq'1)
    (N : ℕ) (n : ℤ) (z : Vec d) (hn : n ≤ (N : ℤ))
    (Hgrid Wgrid : ℕ) (hHW : Hgrid ≤ Wgrid) (hHm : Hgrid ≤ ((N : ℤ) - n).toNat) :
    ∃ Rtrunc : BilateralField d → ℝ,
      AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] Rtrunc (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega =>
          (aux_prefix_rraw_shallow M s (eta N omega) ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z)
              Hgrid).toReal - Rtrunc omega)
        (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal
        ((((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q') *
          aux_lem_band_rcJ_C hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q'
            hq'1 *
          M.delta ^ (aux_lem_band_rcJ_c1 hd I _Poincare _Extension _Perturbation _Sobolev D
              Cresp hCresp) *
          (3 : ℝ) ^ (-(aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D
              Cresp hCresp * ((Wgrid - Hgrid : ℕ) : ℝ)))) ∧
      ∀ omega, 0 ≤ Rtrunc omega := by
  classical
  have : IsProbabilityMeasure (chaosSampleLaw M).toMeasure := inferInstance
  set m : ℕ := ((N : ℤ) - n).toNat with hmdef
  set w : Vec d := (3 : ℝ) ^ N • z with hwdef
  set a1 := aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
    with ha1def
  set c1 := aux_lem_band_rcJ_c1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
    with hc1def
  set Cq' := aux_lem_band_rcJ_C hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
      hCresp q' hq'1 with hCq'def
  have hmeq : (m : ℤ) = (N : ℤ) - n := by rw [hmdef]; exact Int.toNat_of_nonneg (by omega)
  set hp' : ℕ := Wgrid - Hgrid with hp'def
  have hp'eq : (hp' : ℤ) = (Wgrid : ℤ) - Hgrid := by
    rw [hp'def]; exact Nat.cast_sub hHW
  set G := aux_prefix_rraw_G d Hgrid with hGdef
  have hrmem : ∀ rk ∈ G, 2 ≤ rk.1 ∧ rk.1 ≤ Hgrid := by
    intro rk hrk
    simp only [hGdef, aux_prefix_rraw_G, Finset.mem_filter, Finset.mem_product,
      Finset.mem_Icc] at hrk
    exact hrk.1.1
  have hrm : ∀ rk ∈ G, rk.1 ≤ m := fun rk hrk => (hrmem rk hrk).2.trans hHm
  have hlreq : ∀ rk ∈ G, ((m - rk.1 : ℕ) : ℤ) = (m : ℤ) - rk.1 := fun rk hrk =>
    Nat.cast_sub (hrm rk hrk)
                                                                            
  have hex : ∀ rk ∈ G, ∃ Jb : BilateralField d → ℝ,
      AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (((m - rk.1 : ℕ) : ℤ) - N - hp') (((m - rk.1 : ℕ) : ℤ) - N) =>
            omega (j : ℤ)) inferInstance] Jb (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega =>
          (aux_lem_band_Jcell M (m - rk.1) (aux_psf_Rpoint (m - rk.1) w rk.2)
              (eta N omega)).toReal - Jb omega)
        (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (Cq' * M.delta ^ c1 * (3 : ℝ) ^ (-(a1 * (hp' : ℝ)))) := by
    intro rk hrk
    exact ((aux_lem_band_rcJ_qspec hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
      hCresp q' hq'1).2.2 M hMdelta_rcJ Rm hRm Sreg _It Hif hH eta heta N (m - rk.1)
      (aux_psf_Rpoint (m - rk.1) w rk.2) hp').2
  let Jb : ℕ × (Fin d → ℤ) → BilateralField d → ℝ :=
    fun rk => if h : rk ∈ G then (hex rk h).choose else 0
  have hJbmeas : ∀ rk ∈ G, AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (((m - rk.1 : ℕ) : ℤ) - N - hp') (((m - rk.1 : ℕ) : ℤ) - N) =>
            omega (j : ℤ)) inferInstance] (Jb rk) (chaosSampleLaw M).toMeasure := by
    intro rk hrk
    simp only [Jb, dite_eq_left hrk]
    exact (hex rk hrk).choose_spec.1
  have hJbbound : ∀ rk ∈ G, eLpNorm (fun omega =>
          (aux_lem_band_Jcell M (m - rk.1) (aux_psf_Rpoint (m - rk.1) w rk.2)
              (eta N omega)).toReal - Jb rk omega)
        (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (Cq' * M.delta ^ c1 * (3 : ℝ) ^ (-(a1 * (hp' : ℝ)))) := by
    intro rk hrk
    simp only [Jb, dite_eq_left hrk]
    exact (hex rk hrk).choose_spec.2
                                                                          
  have hcontain : ∀ rk ∈ G, MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (((m - rk.1 : ℕ) : ℤ) - N - hp') (((m - rk.1 : ℕ) : ℤ) - N) =>
            omega (j : ℤ)) inferInstance ≤
        MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance := by
    intro rk hrk
    have hr2H := hrmem rk hrk
    have hlr := hlreq rk hrk
    refine aux_lem_band_comap_icc_mono ?_ ?_
    · have : ((m - rk.1 : ℕ) : ℤ) - N - hp' = -n - rk.1 - hp' := by rw [hlr, hmeq]; ring
      rw [this, hp'eq]; omega
    · have : ((m - rk.1 : ℕ) : ℤ) - N = -n - rk.1 := by rw [hlr, hmeq]; ring
      rw [this]; omega
  have hambient : MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance ≤ (inferInstance : MeasurableSpace (BilateralField d)) := by
    have hrestriction : Measurable (fun omega : BilateralField d =>
        fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ)) := by
      apply measurable_pi_iff.mpr
      intro j
      exact measurable_pi_apply (j : ℤ)
    exact hrestriction.comap_le
  have hJbmeas_target : ∀ rk ∈ G, AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] (Jb rk) (chaosSampleLaw M).toMeasure := fun rk hrk =>
    aux_lem_band_aesm_mono _ _ _ (Jb rk) (hJbmeas rk hrk) (hcontain rk hrk)
  have hJbmeas_ambient : ∀ rk ∈ G,
      AEStronglyMeasurable (Jb rk) (chaosSampleLaw M).toMeasure := fun rk hrk =>
    aux_lem_band_aesm_mono _ _ _ (Jb rk) (hJbmeas_target rk hrk) hambient
              
  set RtruncE : BilateralField d → ℝ≥0∞ :=
    fun omega => G.sup (fun rk => aux_prefix_rraw_c s rk.1 * ENNReal.ofReal (Jb rk omega))
    with hRtruncEdef
  have hRtruncE_full : AEStronglyMeasurable RtruncE (chaosSampleLaw M).toMeasure := by
    rw [hRtruncEdef]
    refine aux_lem_band_aesm_finset_sup _ _ G _ (fun rk hrk => ?_)
    exact (ENNReal.continuous_const_mul (aux_prefix_rraw_c_ne_top s rk.1)).comp_aestronglyMeasurable
      (ENNReal.continuous_ofReal.comp_aestronglyMeasurable (hJbmeas_ambient rk hrk))
  refine ⟨fun omega => (RtruncE omega).toReal, ?_, ?_, fun omega => ENNReal.toReal_nonneg⟩
  · have hsup_meas : AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] RtruncE (chaosSampleLaw M).toMeasure := by
      rw [hRtruncEdef]
      refine aux_lem_band_aesm_finset_sup _ _ G _ (fun rk hrk => ?_)
      have hofReal : AEStronglyMeasurable[MeasurableSpace.comap
          (fun omega : BilateralField d =>
            fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
          inferInstance] (fun omega => ENNReal.ofReal (Jb rk omega))
          (chaosSampleLaw M).toMeasure :=
        ENNReal.continuous_ofReal.comp_aestronglyMeasurable (hJbmeas_target rk hrk)
      exact (ENNReal.continuous_const_mul (aux_prefix_rraw_c_ne_top s rk.1)).comp_aestronglyMeasurable
        hofReal
    have hne_top : ∀ omega, RtruncE omega ≠ ⊤ := by
      intro omega
      rw [hRtruncEdef]
      refine aux_prefix_rraw_finset_sup_ne_top _ _ fun rk => ?_
      exact ENNReal.mul_ne_top (aux_prefix_rraw_c_ne_top s rk.1) ENNReal.ofReal_ne_top
    obtain ⟨g, hg_sm, hg_eq⟩ := hsup_meas
    have hg_meas : Measurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] g := hg_sm.measurable
    have hcomp_meas : Measurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] (fun omega => (g omega).toReal) :=
      ENNReal.measurable_toReal.comp hg_meas
    exact ⟨fun omega => (g omega).toReal, hcomp_meas.stronglyMeasurable,
      hg_eq.fun_comp ENNReal.toReal⟩
  · set E : ℕ × (Fin d → ℤ) → BilateralField d → ℝ≥0∞ := fun rk omega =>
      ENNReal.ofReal |(aux_lem_band_Jcell M (m - rk.1) (aux_psf_Rpoint (m - rk.1) w rk.2)
          (eta N omega)).toReal - Jb rk omega| with hEdef
    have hAeq : ∀ (rk : ℕ × (Fin d → ℤ)) (omega : BilateralField d),
        aux_lem_band_Jcell M (m - rk.1) (aux_psf_Rpoint (m - rk.1) w rk.2) (eta N omega) =
        aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2 := fun rk omega => rfl
                                     
    have hpointwise : ∀ omega, |(aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal -
        (RtruncE omega).toReal| ≤ (G.sup (fun rk => E rk omega)).toReal := by
      intro omega
      have hlip := aux_lem_band_abs_toReal_sup_sub_le_sup G
        (fun rk => aux_prefix_rraw_c s rk.1 * aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2)
        (fun rk => aux_prefix_rraw_c s rk.1 * ENNReal.ofReal (Jb rk omega))
        (fun rk => ENNReal.mul_ne_top (aux_prefix_rraw_c_ne_top s rk.1)
          (aux_prefix_rraw_A_ne_top M (eta N omega) m w rk.1 rk.2))
        (fun rk => ENNReal.mul_ne_top (aux_prefix_rraw_c_ne_top s rk.1) ENNReal.ofReal_ne_top)
      refine hlip.trans (le_trans (ENNReal.toReal_mono ?_ ?_) le_rfl)
      · exact aux_prefix_rraw_finset_sup_ne_top _ _ fun rk => ENNReal.ofReal_ne_top
      · refine Finset.sup_mono_fun (fun rk _ => ?_)
        have hcnn : (0 : ℝ) ≤ (aux_prefix_rraw_c s rk.1).toReal := ENNReal.toReal_nonneg
        have hcle1 : (aux_prefix_rraw_c s rk.1).toReal ≤ 1 := by
          rw [aux_prefix_rraw_c, ENNReal.toReal_ofReal (by positivity)]
          refine Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) ?_
          have hrnn : (0:ℝ) ≤ (rk.1:ℝ) := Nat.cast_nonneg _
          nlinarith [hs0]
        have hAnn : (0:ℝ) ≤ (aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal :=
          ENNReal.toReal_nonneg
        have htoreal_mul1 : (aux_prefix_rraw_c s rk.1 *
            aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal =
            (aux_prefix_rraw_c s rk.1).toReal *
              (aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal :=
          ENNReal.toReal_mul
        have htoreal_mul2 : (aux_prefix_rraw_c s rk.1 * ENNReal.ofReal (Jb rk omega)).toReal =
            (aux_prefix_rraw_c s rk.1).toReal * max (Jb rk omega) 0 := by
          rw [ENNReal.toReal_mul]
          rcases le_or_gt 0 (Jb rk omega) with hj | hj
          · rw [ENNReal.toReal_ofReal hj, max_eq_left hj]
          · rw [ENNReal.ofReal_of_nonpos hj.le, ENNReal.toReal_zero, max_eq_right hj.le]
        have habsmax : |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal -
            max (Jb rk omega) 0| ≤
            |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega| := by
          rcases le_or_gt 0 (Jb rk omega) with hj | hj
          · rw [max_eq_left hj]
          · rw [max_eq_right hj.le, sub_zero, abs_of_nonneg hAnn,
              abs_of_pos (by linarith : (0:ℝ) <
                (aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega)]
            linarith
        have hkey : |(aux_prefix_rraw_c s rk.1 *
              aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal -
            (aux_prefix_rraw_c s rk.1 * ENNReal.ofReal (Jb rk omega)).toReal| ≤
            |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega| := by
          rw [htoreal_mul1, htoreal_mul2, ← mul_sub, abs_mul, abs_of_nonneg hcnn]
          calc (aux_prefix_rraw_c s rk.1).toReal *
                |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - max (Jb rk omega) 0|
              ≤ 1 * |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal -
                  max (Jb rk omega) 0| := by
                gcongr
            _ ≤ 1 * |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega| := by
                gcongr
            _ = |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega| := by
                ring
        calc ENNReal.ofReal |(aux_prefix_rraw_c s rk.1 *
              aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal -
            (aux_prefix_rraw_c s rk.1 * ENNReal.ofReal (Jb rk omega)).toReal|
            ≤ ENNReal.ofReal
              |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega| :=
              ENNReal.ofReal_le_ofReal hkey
          _ = E rk omega := by simp only [hEdef, hAeq]
                                            
    have hLq_le : eLpNorm (fun omega =>
          (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal - (RtruncE omega).toReal)
        (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
        eLpNorm (fun omega => (G.sup (fun rk => E rk omega)).toReal) (ENNReal.ofReal q')
          (chaosSampleLaw M).toMeasure :=
      eLpNorm_mono_ae_real
        ((((aux_prefix_rraw_shallow_measurable M s m w Hgrid).comp_aemeasurable
          (prefix_eta_aemeasurable M eta heta N)).ennreal_toReal.aestronglyMeasurable).sub
          hRtruncE_full.aemeasurable.ennreal_toReal.aestronglyMeasurable)
        (Eventually.of_forall fun omega => by
          change ‖(aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal -
            (RtruncE omega).toReal‖ ≤ _
          rw [Real.norm_eq_abs]; exact hpointwise omega)
    have hq'0 : 0 < q' := by linarith
    have hXne : ∀ rk : ℕ × (Fin d → ℤ), ∀ omega, E rk omega ≠ ⊤ := fun rk omega => by
      rw [hEdef]; exact ENNReal.ofReal_ne_top
    have hXm : ∀ rk ∈ G, AEMeasurable (E rk) (chaosSampleLaw M).toMeasure := by
      intro rk hrk
      have h2 : AEMeasurable (fun omega =>
          (aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal)
          (chaosSampleLaw M).toMeasure :=
        (ENNReal.measurable_toReal.comp (aux_prefix_rraw_A_measurable M m w rk.1 rk.2))
          |>.comp_aemeasurable' (prefix_eta_aemeasurable M eta heta N)
      have h3 : AEMeasurable (Jb rk) (chaosSampleLaw M).toMeasure :=
        (hJbmeas_ambient rk hrk).aemeasurable
      have h4 : AEMeasurable (fun omega =>
          (aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega)
          (chaosSampleLaw M).toMeasure := h2.sub h3
      have h5 : AEMeasurable (fun omega =>
          |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega|)
          (chaosSampleLaw M).toMeasure :=
        continuous_abs.measurable.comp_aemeasurable' h4
      have h6 : AEMeasurable (fun omega => E rk omega) (chaosSampleLaw M).toMeasure := by
        have h7 : AEMeasurable (fun omega => ENNReal.ofReal
            |(aux_prefix_rraw_A M (eta N omega) m w rk.1 rk.2).toReal - Jb rk omega|)
            (chaosSampleLaw M).toMeasure :=
          ENNReal.measurable_ofReal.comp_aemeasurable' h5
        simpa [hEdef, hAeq] using h7
      exact h6
    have hXB : ∀ rk ∈ G, eLpNorm (fun omega => (E rk omega).toReal) (ENNReal.ofReal q')
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (Cq' * M.delta ^ c1 *
          (3 : ℝ) ^ (-(a1 * (hp' : ℝ)))) := by
      intro rk hrk
      have heq1 : (fun omega => (E rk omega).toReal) = (fun omega =>
          |(aux_lem_band_Jcell M (m - rk.1) (aux_psf_Rpoint (m - rk.1) w rk.2)
              (eta N omega)).toReal - Jb rk omega|) := by
        funext omega; rw [hEdef]; exact ENNReal.toReal_ofReal (abs_nonneg _)
      rw [heq1]
      have heq2 : eLpNorm (fun omega => |(aux_lem_band_Jcell M (m - rk.1)
              (aux_psf_Rpoint (m - rk.1) w rk.2) (eta N omega)).toReal - Jb rk omega|)
          (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure =
          eLpNorm (fun omega => (aux_lem_band_Jcell M (m - rk.1)
              (aux_psf_Rpoint (m - rk.1) w rk.2) (eta N omega)).toReal - Jb rk omega)
            (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure :=
        by
          have hm := aestronglyMeasurable_of_eLpNorm_ne_top
            (ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hJbbound rk hrk))
          simpa only [Real.norm_eq_abs] using eLpNorm_norm _ hm
      rw [heq2]
      exact hJbbound rk hrk
    have hcard_bound : (aux_prefix_rraw_G d Hgrid).card ≤
        (Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d := by
      calc (aux_prefix_rraw_G d Hgrid).card
          ≤ ((Finset.Icc 2 Hgrid) ×ˢ aux_psf_Rindex d Hgrid).card :=
            Finset.card_filter_le _ _
        _ = (Finset.Icc 2 Hgrid).card * (aux_psf_Rindex d Hgrid).card := Finset.card_product _ _
        _ ≤ (Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d := by
            have h1 : (Finset.Icc 2 Hgrid).card ≤ Hgrid + 1 := by rw [Nat.card_Icc]; omega
            have h2 : (aux_psf_Rindex d Hgrid).card ≤ (3 ^ (Hgrid + 2)) ^ d :=
              (aux_prefix_rraw_Rindex_card_le d Hgrid).trans
                (Nat.pow_le_pow_left (Nat.pow_le_pow_right (by norm_num) (by omega)) d)
            exact Nat.mul_le_mul h1 h2
    have hsupbound := aux_prefix_rraw_eLpNorm_finset_sup_le (chaosSampleLaw M).toMeasure G E
      hXne hXm q' hq'0 (ENNReal.ofReal (Cq' * M.delta ^ c1 * (3 : ℝ) ^ (-(a1 * (hp' : ℝ))))) hXB
    refine hLq_le.trans (hsupbound.trans ?_)
    have hcardENN : ((G.card : ℝ≥0∞)) ≤ (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ≥0∞) := by
      exact_mod_cast hcard_bound
    have hcardENN' : ((G.card : ℝ≥0∞)) ^ (1 / q') ≤
        (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ≥0∞) ^ (1 / q') :=
      ENNReal.rpow_le_rpow hcardENN (by positivity)
    refine (mul_le_mul_left hcardENN' _).trans (le_of_eq ?_)
    rw [show ((((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ≥0∞)) =
        ENNReal.ofReal ((((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ)) by
      rw [ENNReal.ofReal_natCast]]
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    ring

theorem aux_lem_band_retained_rate (d : ℕ) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1)
    (hq1 : 1 ≤ q) (h8dq : 8 * (d : ℝ) ≤ a1 * q) (Cq : ℝ) (hCq : 0 ≤ Cq) :
    ∃ Cret : ℝ, 0 ≤ Cret ∧
      ∀ (Hgrid Wgrid h : ℕ), Hgrid ≤ 2 * (h + 1) → 2 * (h + 1) ≤ Wgrid - Hgrid →
      (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
          (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
        Cret * (3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ))) := by
  have hq0 : 0 < q := by linarith
  set a0final : ℝ := min a1 s / 16 with ha0def
  have ha0pos : 0 < a0final := by rw [ha0def]; have := lt_min ha1 hs0; positivity
  obtain ⟨Cpoly, hCpolynn, hCpoly⟩ := aux_lem_band_poly_le_exp (7 * a1 / 4 - a0final) (by
    rw [ha0def]; nlinarith [min_le_left a1 s, ha1])
  refine ⟨Cq * Cpoly, by positivity, ?_⟩
  intro Hgrid Wgrid h hHle hWH
  have hpolyfinal := hCpoly h
  have hcard_mono : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ≤
      (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) := by
    have h1 : Hgrid + 1 ≤ 2 * h + 3 := by omega
    have h2 : (3 ^ (Hgrid + 2) : ℕ) ≤ 3 ^ (2 * h + 4) := Nat.pow_le_pow_right (by norm_num) (by omega)
    have h3 : (3 ^ (Hgrid + 2) : ℕ) ^ d ≤ (3 ^ (2 * h + 4)) ^ d := Nat.pow_le_pow_left h2 d
    exact_mod_cast Nat.mul_le_mul h1 h3
  have hcard_pow_mono : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) ≤
      (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) ^ (1 / q) :=
    Real.rpow_le_rpow (by positivity) hcard_mono (by positivity)
  have hexp_mono : (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ))) ≤
      (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) := by
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have : (2 * (h + 1) : ℝ) ≤ ((Wgrid - Hgrid : ℕ) : ℝ) := by exact_mod_cast hWH
    nlinarith [this, ha1.le]
  have hstep1 : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
      (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
      (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) ^ (1 / q) *
        (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) :=
    mul_le_mul hcard_pow_mono (mul_le_mul_of_nonneg_left hexp_mono hCq)
      (by positivity) (by positivity)
  have hcast : (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) =
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((2 * h + 4) * d : ℕ) := by
    have hpoweq : ((3 ^ (2 * h + 4)) ^ d : ℕ) = 3 ^ ((2 * h + 4) * d) := by rw [← pow_mul]
    rw [hpoweq]; push_cast; ring
  have hrpoweq : ((3 : ℝ) ^ ((2 * h + 4) * d : ℕ) : ℝ) ^ (1 / q) =
      (3 : ℝ) ^ (((2 * h + 4) * d : ℕ) * (1 / q) : ℝ) := by
    rw [← Real.rpow_natCast (3 : ℝ) ((2 * h + 4) * d), ← Real.rpow_mul (by norm_num)]
  have hprodrpow : ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((2 * h + 4) * d : ℕ)) ^ (1 / q) =
      (2 * (h : ℝ) + 3) ^ (1 / q) * ((3 : ℝ) ^ ((2 * h + 4) * d : ℕ)) ^ (1 / q) :=
    Real.mul_rpow (by positivity) (by positivity)
  have hpolyle : (2 * (h : ℝ) + 3) ^ (1 / q) ≤ 2 * (h : ℝ) + 3 := by
    have hx1 : (1 : ℝ) ≤ 2 * (h : ℝ) + 3 := by have := Nat.cast_nonneg (α := ℝ) h; linarith
    calc (2 * (h : ℝ) + 3) ^ (1 / q) ≤ (2 * (h : ℝ) + 3) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hx1 (by rw [div_le_one hq0]; linarith)
      _ = 2 * (h : ℝ) + 3 := Real.rpow_one _
  have hexppart : (((2 * h + 4) * d : ℕ) : ℝ) * (1 / q) ≤ (a1 / 8) * ((2 * h + 4 : ℕ) : ℝ) := by
    have hdq : (d : ℝ) / q ≤ a1 / 8 := by
      rw [div_le_div_iff₀ hq0 (by norm_num : (0 : ℝ) < 8)]
      nlinarith [h8dq]
    have heq : (((2 * h + 4) * d : ℕ) : ℝ) * (1 / q) = ((2 * h + 4 : ℕ) : ℝ) * ((d : ℝ) / q) := by
      push_cast; ring
    rw [heq]
    have h2h4 : (0 : ℝ) ≤ ((2 * h + 4 : ℕ) : ℝ) := by positivity
    nlinarith [mul_le_mul_of_nonneg_left hdq h2h4]
  have hexpsplit : (3 : ℝ) ^ (((2 * h + 4) * d : ℕ) * (1 / q) : ℝ) ≤
      (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) hexppart
  have hcombine1 : (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) ^ (1 / q) ≤
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) := by
    rw [hcast, hprodrpow, hrpoweq]
    exact mul_le_mul hpolyle hexpsplit (by positivity) (by positivity)
  have hexpeq : (a1 / 8) * ((2 * h + 4 : ℕ) : ℝ) + (-(a1 * (2 * (h + 1) : ℝ))) =
      -(7 * a1 / 4) * (h : ℝ) - (3 * a1 / 2) := by push_cast; ring
  have hstep2 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
      (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) ≤
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) := by
    rw [mul_assoc, ← Real.rpow_add (by norm_num), hexpeq]
    have hle : -(7 * a1 / 4) * (h : ℝ) - (3 * a1 / 2) ≤ -(7 * a1 / 4) * (h : ℝ) := by
      nlinarith [ha1.le]
    have hrpowle : (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ) - (3 * a1 / 2)) ≤
        (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) hle
    have h2h3nn : (0 : ℝ) ≤ 2 * (h : ℝ) + 3 := by positivity
    exact mul_le_mul_of_nonneg_left hrpowle h2h3nn
  have hexpid3 : (7 * a1 / 4 - a0final) * (h : ℝ) + (-(7 * a1 / 4) * (h : ℝ)) =
      -(a0final * (h : ℝ)) := by ring
  have hstep3 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) ≤
      Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by
    have h1 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) ≤
        (Cpoly * (3 : ℝ) ^ ((7 * a1 / 4 - a0final) * (h : ℝ))) *
          (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) := by
      have hrpownn : (0 : ℝ) ≤ (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) := by positivity
      exact mul_le_mul_of_nonneg_right hpolyfinal hrpownn
    refine h1.trans (le_of_eq ?_)
    rw [mul_assoc, ← Real.rpow_add (by norm_num), hexpid3]
  have hfinal1 : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
      (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
        (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) :=
    hstep1.trans (mul_le_mul_of_nonneg_right hcombine1 (by positivity))
  have hfinal2 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
      (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) =
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
        (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) * Cq := by ring
  have hfinal3 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
      (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) * Cq ≤
      ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ))) * Cq :=
    mul_le_mul_of_nonneg_right hstep2 hCq
  have hfinal4 : ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ))) * Cq ≤
      (Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ)))) * Cq :=
    mul_le_mul_of_nonneg_right hstep3 hCq
  calc (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
        (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ))))
      ≤ (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
          (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) := hfinal1
    _ = (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
          (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) * Cq := hfinal2
    _ ≤ ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ))) * Cq := hfinal3
    _ ≤ (Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ)))) * Cq := hfinal4
    _ = Cq * Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by ring

def aux_lem_band_Cret (d : ℕ) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1) (hq1 : 1 ≤ q)
    (h8dq : 8 * (d : ℝ) ≤ a1 * q) (Cq : ℝ) (hCq : 0 ≤ Cq) : ℝ :=
  (aux_lem_band_retained_rate d s a1 q hs0 ha1 hq1 h8dq Cq hCq).choose

theorem aux_lem_band_Cret_spec (d : ℕ) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1) (hq1 : 1 ≤ q)
    (h8dq : 8 * (d : ℝ) ≤ a1 * q) (Cq : ℝ) (hCq : 0 ≤ Cq) :
    0 ≤ aux_lem_band_Cret d s a1 q hs0 ha1 hq1 h8dq Cq hCq ∧
      ∀ (Hgrid Wgrid h : ℕ), Hgrid ≤ 2 * (h + 1) → 2 * (h + 1) ≤ Wgrid - Hgrid →
        (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
            (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
          aux_lem_band_Cret d s a1 q hs0 ha1 hq1 h8dq Cq hCq *
            (3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ))) :=
  (aux_lem_band_retained_rate d s a1 q hs0 ha1 hq1 h8dq Cq hCq).choose_spec

def aux_lem_band_Ctrunc (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I) (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.deterministic_good_scale_input d) (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s q : ℝ) (hs0 : 0 < s) (hq1 : 1 ≤ q)
    (hq_a1 : 8 * (d : ℝ) / aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
        hCresp ≤ q) : ℝ :=
  aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q)) +
    aux_lem_band_Cret d s
      (aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp) q hs0
      (aux_lem_band_rcJ_a1_pos hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp) hq1
      (by
        have ha1pos := aux_lem_band_rcJ_a1_pos hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
          hCresp
        rw [mul_comm (aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp)
          q]
        exact (div_le_iff₀ ha1pos).mp hq_a1)
      (aux_lem_band_rcJ_C hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q hq1)
      (aux_lem_band_rcJ_qspec hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q hq1).2.1

theorem aux_lem_band_Ctrunc_nonneg (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d) (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I) (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.deterministic_good_scale_input d) (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s q : ℝ) (hs0 : 0 < s) (hq1 : 1 ≤ q)
    (hq_a1 : 8 * (d : ℝ) / aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
        hCresp ≤ q)
    (hsqq : 8 * (d : ℝ) < s * q) :
    0 ≤ aux_lem_band_Ctrunc d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp s q
        hs0 hq1 hq_a1 := by
  unfold aux_lem_band_Ctrunc
  have hq0 : 0 < q := by linarith
  have hKnn : 0 ≤ aux_prefix_rraw_K d s q := aux_prefix_rraw_K_nonneg d s q hq0 hsqq
  have hClognn : 0 ≤ aux_prefix_rraw_C d * q * Real.log (2 + q) := by
    have hClog := (aux_prefix_rraw_C_spec d).1
