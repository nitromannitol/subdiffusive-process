      (fun j => ∑ i ∈ Finset.Icc (m - j) (m + j),
        aux_lem_band_piece_field_normOn (translatedCube d (m + 1 + j) w)
          (fun x : Vec d => |(eta N omega) i x| + (3 : ℝ) ^ (i : ℝ) *
            Homogenization.euclideanNorm (shellGradient ((eta N omega) i) x))) Hnat
  have hTruncle : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, Ftrunc_ENNReal omega ≤ F N m w omega := by
    filter_upwards [hFeq] with omega hFeqomega
    rw [hFeqomega]
