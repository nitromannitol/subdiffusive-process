  obtain ⟨Dband, hDbandmeas, hDbandbound''⟩ := aux_lem_band_piece_field_Dcombine M Draw N m w
    CD q p hpq hq1 (hCD q hq1) hDmemlp hDbase a1_gap C_gap (min (s / 64) (a1_gap / 2)) h
    (min_le_right _ _) hCgap_nn hMdelta_pos hMdelta_le_one n Dtrunc hDtruncmeas hDtrunc

  set Hnat : ℕ := 4 * (h + 1) with hHnat_def
  have half_pos : (0 : ℝ) < s / 2 := by linarith only [hs.1]
  have hFeq : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      F N m w omega = sSup {v : ENNReal | ∃ j : ℕ,
