    rw [hCqF_def]
    have h1 : (0 : ℝ) ≤ (eps / 2)⁻¹ := by positivity
    have h2 : (0 : ℝ) ≤ 1 + (d : ℝ) := by positivity
    exact mul_nonneg (mul_nonneg h1 h2) hseriesF_nonneg
  set seriesFhalf : ℝ := ∑' j : ℕ, (3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8)) * ((2 * j + 1 : ℕ) : ℝ) *
    (2 * ((qnat : ℝ) + 1 + prefix_log_card d j)) with hseriesFhalf_def
  have hseriesFhalf_nonneg : 0 ≤ seriesFhalf := by
    rw [hseriesFhalf_def]
    refine tsum_nonneg (fun j => ?_)
    have hL := prefix_log_card_nonneg d j
    positivity
  set CF2 : ℝ := (eps / 2)⁻¹ * (1 + (d : ℝ)) * seriesFhalf with hCF2_def
  have hCF2_nonneg : 0 ≤ CF2 := by
    rw [hCF2_def]
    have h1 : (0 : ℝ) ≤ (eps / 2)⁻¹ := by positivity
    have h2 : (0 : ℝ) ≤ 1 + (d : ℝ) := by positivity
    exact mul_nonneg (mul_nonneg h1 h2) hseriesFhalf_nonneg
  refine ⟨min (1 / 2) delta0_gap, weight 0 * (2 * Real.sqrt (CD q * C_gap)) + weight 1 * CF2,
    lt_min (by norm_num) hdelta0_gap, ?_, ?_⟩
  · have h0 := hweight 0
    have h1 := hweight 1
    have hCDCgap0 : 0 ≤ Real.sqrt (CD q * C_gap) := Real.sqrt_nonneg _
    positivity
  intro M hMdelta Rm hRm Sreg _It H hInfrared eta heta F Praw Rraw Draw Z rawGood hprim
    hDbaseline sidePos unitA hunita kappa retained reference eramp _h12q N n z hn hoffset h hh
  set m : ℕ := ((N : ℤ) - n).toNat with hm_def
  set w : SpatialCoordinates d := (3 : ℝ) ^ N • z with hw_def
  have hMdelta_pos : 0 < M.delta := M.shellPrefix.delta_pos
  have hMdelta_le_half : M.delta ≤ 1 / 2 := M.shellPrefix.delta_le_half
  have hMdelta_le_gap : M.delta ≤ delta0_gap := le_trans hMdelta (min_le_right _ _)
  have hMdelta_le_one : M.delta ≤ 1 := by linarith only [hMdelta_le_half]
  have hle : MeasurableSpace.comap
      (fun omega : BilateralField d =>
        fun j : Set.Icc (-n - (4 * (h + 1) : ℕ)) (-n + (4 * (h + 1) : ℕ)) => omega (j : ℤ))
      inferInstance ≤ (inferInstance : MeasurableSpace (BilateralField d)) :=
    (Set.measurable_restrict _).comap_le
  have h2qnat : ENNReal.ofReal p ≤ ((2 * qnat : ℕ) : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_natCast]
    refine ENNReal.ofReal_le_ofReal ?_
    have hqqnat : q ≤ 2 * (qnat : ℝ) := by linarith only [hqle_qnat, hq1]
