def aux_lem_band_rcJ_probe {d : ℕ} (i j : Fin d) : Fin d → ℝ :=
  if i = j then (Pi.single i 1 : Fin d → ℝ)
  else (Real.sqrt 2)⁻¹ • ((Pi.single i 1 : Fin d → ℝ) + Pi.single j 1)

def aux_lem_band_rcJ_entry {d : ℕ} (R : (Fin d → ℝ) → ℝ) (i j : Fin d) : ℝ :=
  if i = j then R (aux_lem_band_rcJ_probe i i)
  else R (aux_lem_band_rcJ_probe i j) - (1 / 2 : ℝ) * R (aux_lem_band_rcJ_probe i i) -
    (1 / 2 : ℝ) * R (aux_lem_band_rcJ_probe j j)

def aux_lem_band_rcJ_X {d : ℕ} [NeZero d] (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (l : ℕ)
    (om : BilateralField d) : (Fin d × Fin d) ⊕ (Fin d × Fin d) → ℝ :=
  Sum.elim (fun ij => aux_lem_band_rcJ_entry (aux_lem_band_rcJ_RD M l om) ij.1 ij.2)
    (fun ij => aux_lem_band_rcJ_entry (aux_lem_band_rcJ_RN M l om) ij.1 ij.2)

theorem aux_lem_band_rcJ_quad_single {d : ℕ} (A : Fin d → Fin d → ℝ) (i j : Fin d) :
    ∑ a, ∑ b, A a b * (Pi.single i (1 : ℝ) : Fin d → ℝ) a * (Pi.single j (1 : ℝ) : Fin d → ℝ) b =
      A i j := by
  simp [Pi.single_apply]

theorem aux_lem_band_rcJ_quad_bilin {d : ℕ} (A : Fin d → Fin d → ℝ) (s : ℝ) (u v : Fin d → ℝ) :
    ∑ a, ∑ b, A a b * (s • (u + v)) a * (s • (u + v)) b =
      s * s * ((∑ a, ∑ b, A a b * u a * u b) + (∑ a, ∑ b, A a b * u a * v b) +
        (∑ a, ∑ b, A a b * v a * u b) + (∑ a, ∑ b, A a b * v a * v b)) := by
  have e : ∀ a b, A a b * (s • (u + v)) a * (s • (u + v)) b = s * s * (A a b * u a * u b +
      A a b * u a * v b + A a b * v a * u b + A a b * v a * v b) := by
    intro a b; simp only [Pi.smul_apply, Pi.add_apply, smul_eq_mul]; ring
  simp only [e, ← Finset.mul_sum, Finset.sum_add_distrib]

theorem aux_lem_band_rcJ_quad_probe {d : ℕ} (A : Fin d → Fin d → ℝ) (i j : Fin d) (hij : i ≠ j) :
    ∑ a, ∑ b, A a b * aux_lem_band_rcJ_probe i j a * aux_lem_band_rcJ_probe i j b =
      (1 / 2 : ℝ) * (A i i + A i j + A j i + A j j) := by
  have hs : (Real.sqrt 2)⁻¹ * (Real.sqrt 2)⁻¹ = (1 / 2 : ℝ) := by
    rw [← mul_inv, Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 2)]; norm_num
  have hp : aux_lem_band_rcJ_probe i j = (Real.sqrt 2)⁻¹ • ((Pi.single i 1 : Fin d → ℝ) + Pi.single j 1) := by
    unfold aux_lem_band_rcJ_probe; rw [ite_eq_right hij]
  rw [hp, aux_lem_band_rcJ_quad_bilin, hs, aux_lem_band_rcJ_quad_single, aux_lem_band_rcJ_quad_single, aux_lem_band_rcJ_quad_single,
    aux_lem_band_rcJ_quad_single]

theorem aux_lem_band_rcJ_entry_eq {d : ℕ} (R : (Fin d → ℝ) → ℝ) (A : Fin d → Fin d → ℝ)
    (hA : ∀ i j, A i j = A j i) (hR : ∀ e, R e = ∑ i, ∑ j, A i j * e i * e j) (i j : Fin d) :
    aux_lem_band_rcJ_entry R i j = A i j := by
  have hdiag : ∀ k : Fin d, R (aux_lem_band_rcJ_probe k k) = A k k := by
    intro k
    rw [hR]
    unfold aux_lem_band_rcJ_probe
    rw [ite_eq_left rfl]
    exact aux_lem_band_rcJ_quad_single A k k
  unfold aux_lem_band_rcJ_entry
  split_ifs with hij
  · subst hij; exact hdiag i
  · rw [hdiag, hdiag, hR, aux_lem_band_rcJ_quad_probe A i j hij, hA j i]
    ring

theorem aux_lem_band_rcJ_RD_quadratic {d : ℕ} [NeZero d] (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (l : ℕ) (om : BilateralField d) (e : Fin d → ℝ) :
    aux_lem_band_rcJ_RD M l om e = ∑ i, ∑ j, aux_lem_band_rcJ_entry (aux_lem_band_rcJ_RD M l om) i j * e i * e j := by
  obtain ⟨A, hA, hR⟩ := aux_lem_band_rcJ_bridge_B2_dirichlet_quadratic (aux_lem_band_rcJ_unit_bdd d)
    (aux_lem_band_rcJ_unit_poincare d).1 (aux_lem_band_rcJ_aN M l om)
  have hR' : ∀ e, aux_lem_band_rcJ_RD M l om e = ∑ i, ∑ j, A i j * e i * e j := fun e => hR e
  rw [hR' e]
  refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
  rw [aux_lem_band_rcJ_entry_eq _ A hA hR' i j]

theorem aux_lem_band_rcJ_RN_quadratic {d : ℕ} [NeZero d] (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (l : ℕ) (om : BilateralField d) (e : Fin d → ℝ) :
    aux_lem_band_rcJ_RN M l om e = ∑ i, ∑ j, aux_lem_band_rcJ_entry (aux_lem_band_rcJ_RN M l om) i j * e i * e j := by
  obtain ⟨A, hA, hR⟩ := aux_lem_band_rcJ_bridge_B2_neumann_quadratic (aux_lem_band_rcJ_unit_poincare d).2
    (aux_lem_band_rcJ_aN M l om)
  have hR' : ∀ e, aux_lem_band_rcJ_RN M l om e = ∑ i, ∑ j, A i j * e i * e j := fun e => hR e
  rw [hR' e]
  refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
  rw [aux_lem_band_rcJ_entry_eq _ A hA hR' i j]

theorem aux_lem_band_rcJ_defect_eq {d : ℕ} [NeZero d] (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (l : ℕ)
    (om : BilateralField d) (e : Homogenization.Vec d) (he : Homogenization.vecNormSq e = 1) :
    affineDiagonalDefect (aux_lem_band_rcJ_unit_bdd d) (aux_lem_band_rcJ_unit_vol_pos d) (aux_lem_band_rcJ_unit_poincare d).1
        (aux_lem_band_rcJ_unit_poincare d).2 (aux_lem_band_rcJ_aN M l om) e =
      (1 / 2 : ℝ) * ∑ i, ∑ j, e i * e j *
        (aux_lem_band_rcJ_X M l om (Sum.inl (i, j)) + aux_lem_band_rcJ_X M l om (Sum.inr (i, j))) - 1 := by
  have hsq : (∑ i : Fin d, (e i) ^ 2) = 1 := by
    rw [← he, Homogenization.vecNormSq, Homogenization.vecDot]
    exact Finset.sum_congr rfl fun i _ => sq (e i)
  have hD := aux_lem_band_rcJ_RD_quadratic M l om e
  have hN := aux_lem_band_rcJ_RN_quadratic M l om e
  unfold aux_lem_band_rcJ_RD at hD
  unfold aux_lem_band_rcJ_RN at hN
  unfold affineDiagonalDefect
  rw [aux_lem_band_rcJ_unit_vol, hsq, hD, hN]
  simp only [aux_lem_band_rcJ_X, Sum.elim_inl, Sum.elim_inr]
  rw [← Finset.sum_add_distrib, Finset.mul_sum]
  congr 1
  rw [mul_one, div_eq_mul_inv, Finset.sum_mul]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [← Finset.sum_add_distrib, Finset.sum_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  unfold aux_lem_band_rcJ_RD aux_lem_band_rcJ_RN
  ring

theorem aux_lem_band_rcJ_sSup_toReal_eq_PG {d : ℕ} (f : Homogenization.Vec d → ℝ)
    (x : (Fin d × Fin d) ⊕ (Fin d × Fin d) → ℝ)
    (hf : ∀ e : Homogenization.Vec d, Homogenization.vecNormSq e = 1 →
      f e = (1 / 2 : ℝ) * ∑ i, ∑ j, e i * e j * (x (Sum.inl (i, j)) + x (Sum.inr (i, j))) - 1) :
    (sSup {v : ENNReal | ∃ e : Homogenization.Vec d, Homogenization.vecNormSq e = 1 ∧
        v = ENNReal.ofReal (f e)}).toReal = aux_lem_band_U2_PG x := by
  have hset : {v : ENNReal | ∃ e : Homogenization.Vec d, Homogenization.vecNormSq e = 1 ∧
        v = ENNReal.ofReal (f e)} =
      Set.range (fun e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1} =>
        ENNReal.ofReal (f e.1)) := by
    ext v
    constructor
    · rintro ⟨e, he, rfl⟩; exact ⟨⟨e, he⟩, rfl⟩
    · rintro ⟨⟨e, he⟩, rfl⟩; exact ⟨e, he, rfl⟩
  rw [hset, sSup_range, ENNReal.toReal_iSup (fun _ => ENNReal.ofReal_ne_top)]
  unfold aux_lem_band_U2_PG
  rw [← sSup_range]
  congr 1
  ext v
  simp only [Set.mem_range]
  constructor
  · rintro ⟨e, rfl⟩
    refine ⟨e, ?_⟩
    rw [ENNReal.toReal_ofReal', hf e.1 e.2, max_comm]
  · rintro ⟨e, rfl⟩
    refine ⟨e, ?_⟩
    rw [ENNReal.toReal_ofReal', hf e.1 e.2, max_comm]

