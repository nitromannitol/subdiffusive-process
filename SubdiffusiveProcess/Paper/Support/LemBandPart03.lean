    fun N eps heps => ⟨(hb M hMb Rm hRm N eps heps).1, (hb M hMb Rm hRm N eps heps).2.trans hBb'⟩,
    fun N => ⟨(hymom N).1, (hymom N).2.trans hBy'⟩, fun N eps heps => ?_⟩
  refine (hc M hMc Rm hRm N eps heps).trans (ENNReal.ofReal_le_ofReal ?_)
