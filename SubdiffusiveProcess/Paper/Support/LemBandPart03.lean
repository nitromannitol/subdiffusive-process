    (CTail : ℝ) (hCTailnn : 0 ≤ CTail)
    (hTailbound : eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega)
          ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z)).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z)
