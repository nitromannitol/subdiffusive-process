            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure := hFhalf_le_sum_eLp
      _ ≤ eLpNorm (fun omega => (∑' j : ℕ, prefix_bank_Fmaj (s / 2) m w j (eta N omega)).toReal)
