    (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s sigma eps : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1)
    (heps : eps ∈ Set.Ioo (0 : ℝ) 1)
    (T : ℕ) (offset : Fin T → ℤ) (_shift : Fin T → SpatialCoordinates d)
    (weight : Fin 4 → ℝ) (hweight : ∀ i, 0 ≤ weight i)
    (Klip : ℝ≥0)
    (Phi : (Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ) → ℝ)
    (_hPhiLip : LipschitzWith Klip Phi) (_hPhi0 : Phi 0 = 0)
    (_hPhiNonneg : ∀ x, 0 ≤ Phi x)
    (CD : ℝ → ℝ) (_hCD : ∀ p, 1 ≤ p → 0 < CD p) :
    ∃ a0 c0 : ℝ, ∃ w0 : ℕ,
      0 < a0 ∧ 0 < c0 ∧ 0 < w0 ∧
      ∀ p : ℝ, 1 ≤ p →
        ∃ qmin : ℝ,
          ∀ q : ℝ, qmin ≤ q →
            ∃ delta0 C0 : ℝ, 0 < delta0 ∧ 0 ≤ C0 ∧
              ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
              ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
              ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
              ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
                InfraredCharacterization M H →
              ∀ (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d),
                (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
                  ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
                    omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
              ∀ (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
                (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
                (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop),
                (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
                  primitive_scores d M s eps (eta N omega)
                    (fun m y => F N m y omega) (fun m y => Praw N m y omega)
                    (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
                    (fun m y => Z N m y omega) (fun m y => rawGood N m y omega)) →
                (hDbaseline : ∀ (N n : ℕ) (z : Vec d),
                  MemLp (fun omega => (Draw N n z omega).toReal)
                    (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
                  eLpNorm (fun omega => (Draw N n z omega).toReal)
                    (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
                    ENNReal.ofReal (CD q * M.delta ^ (1 / 2 : ℝ))) →
              ∀ (sidePos : ∀ n : ℤ, 0 < (3 : ℝ) ^ (-n))
                (unitA : ∀ (n : ℤ) (z : SpatialCoordinates d),
                  PositiveCoefficient (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n))),
                (∀ n z, (unitA n z).val =ᵐ[volume.restrict
                  (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n) : Set (SpatialCoordinates d))]
                    (fun _ => (1 : ℝ))) →
              let kappa : ℕ → ℝ := fun J =>
                Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M J
              let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
                fun n z omega => if 0 ≤ n then ∑ j ∈ Finset.Ico (0 : ℤ) n, omega (-j) z
                  else -∑ j ∈ Finset.Ico n (0 : ℤ), omega (-j) z
              let _reference : ℕ → ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
                fun N n z omega => kappa ((N : ℤ) - n).toNat / kappa N *
                  Real.exp (H omega z + retained n z omega)
              let eramp : ℝ → ℝ → ENNReal → ℝ := fun lo hi x =>
                (min (1 : ENNReal) ((x - ENNReal.ofReal lo) /
                  ENNReal.ofReal (hi - lo))).toReal
              12 * q ≤ Cresp⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹ →
              ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) →
                (∀ i : Fin T, n + offset i ≤ (N : ℤ)) →
                ∀ h : ℕ, 1 ≤ h →
                  ∃ Yband : BilateralField d → ℝ,
                    AEStronglyMeasurable[MeasurableSpace.comap
                      (fun omega : BilateralField d =>
                        fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ))
                          (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ))
                      inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
                    eLpNorm (fun omega =>
                        weight 3 * eramp (eps ^ 2 / 4) (eps ^ 2)
                          (Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega)
                          - Yband omega)
                      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
                      ENNReal.ofReal (C0 * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))))
  := by

  set a1 := aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
    with ha1def
  have ha1pos : 0 < a1 :=
    aux_lem_band_rcJ_a1_pos hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
  refine ⟨min a1 s / 32, 1, 4, by have := lt_min ha1pos hs.1; positivity, one_pos, by norm_num,
    ?_⟩
  intro p hp

  refine ⟨max (max (2 * p) (32 * (d : ℝ) / min s sigma)) (8 * (d : ℝ) / a1), ?_⟩
  intro q hqmin
  have hq_bound : max (2 * p) (32 * (d : ℝ) / min s sigma) ≤ q := le_trans (le_max_left _ _) hqmin
  have hq_a1 : 8 * (d : ℝ) / a1 ≤ q := le_trans (le_max_right _ _) hqmin
  have hq1 : (1 : ℝ) ≤ q :=
    le_trans (by linarith : (1 : ℝ) ≤ 2 * p) (le_trans (le_max_left _ _) hq_bound)
  set moments : Finset ℝ := ({q} : Finset ℝ) with hmomdef
  set Kc : ℝ := aux_prefix_rraw_K d s (aux_prefix_rraw_q d s moments) with hKcdef
  set rhoc : ℝ := aux_prefix_rraw_rho d s (aux_prefix_rraw_q d s moments) with hrhocdef
  set Cc : ℝ := aux_prefix_rraw_C d * aux_prefix_rraw_q d s moments *
      Real.log (2 + aux_prefix_rraw_q d s moments) with hCcdef
  set Cbase0 : ℝ := (4 / (3 * eps ^ 2)) * (Kc * rhoc * Cc) with hCbase0def
                                                                                              
  have hdelta0rcJ_pos : 0 < aux_lem_band_rcJ_delta0 hd I _Poincare _Extension _Perturbation _Sobolev D
      Cresp hCresp q hq1 :=
    (aux_lem_band_rcJ_qspec hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q hq1).1
  have hdelta0tailq_pos : 0 < aux_lem_band_tailq_delta0 d q hq1 :=
    (aux_lem_band_tailq_delta0_spec d q hq1).1

  have hq0 : 0 < q := by linarith
  have hqs32d : 32 * (d : ℝ) ≤ s * q := by
    have h1 : 32 * (d : ℝ) / min s sigma ≤ q := le_trans (le_max_right _ _) hq_bound
    have h3 : (0 : ℝ) < min s sigma := lt_min hs.1 hsigma.1
    have h4 : 32 * (d : ℝ) ≤ q * min s sigma := by rw [div_le_iff₀ h3] at h1; linarith
    have h5 : min s sigma ≤ s := min_le_left _ _
    nlinarith [h4, h5, hq0.le]
  have hsqq_lit : 8 * (d : ℝ) < s * q := by
    nlinarith [hqs32d, Nat.cast_nonneg (α := ℝ) d, mul_pos hs.1 hq0]
  set Cp : ℝ := weight 3 * (4 / (3 * eps ^ 2)) *
      aux_lem_band_Ctrunc d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
        hCresp s q hs.1 hq1 hq_a1 with hCpdef
  have hCp : 0 ≤ Cp := by
    rw [hCpdef]
    exact mul_nonneg (mul_nonneg (hweight 3) (by positivity))
      (aux_lem_band_Ctrunc_nonneg d hd I _Poincare _Extension
        _Perturbation _Sobolev D Cresp hCresp s q hs.1 hq1 hq_a1 hsqq_lit)
  refine ⟨min (min 1 (aux_prefix_rraw_delta0 d s moments))
        (min (aux_lem_band_rcJ_delta0 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q
              hq1)
          (aux_lem_band_tailq_delta0 d q hq1)),
      2 * Real.sqrt ((weight 3 * Cbase0) * Cp),
      lt_min (lt_min one_pos (aux_prefix_rraw_delta0_pos d s moments))
        (lt_min hdelta0rcJ_pos hdelta0tailq_pos),
      by positivity, ?_⟩
  intro M hMdelta Rm hRm Sreg _It H hH eta heta F Praw Rraw Draw Z rawGood hprim
    hDbaseline sidePos unitA hunita kappa retained reference eramp h12q N n z hn hoffset h hh
  have hMr : M.delta ≤ aux_prefix_rraw_delta0 d s moments :=
    (hMdelta.trans (min_le_left _ _)).trans (min_le_right _ _)
  have hM1 : M.delta ≤ 1 :=
    (hMdelta.trans (min_le_left _ _)).trans (min_le_left _ _)
  have hMdelta_rcJ : M.delta ≤ aux_lem_band_rcJ_delta0 hd I _Poincare _Extension _Perturbation _Sobolev D
      Cresp hCresp q hq1 :=
    (hMdelta.trans (min_le_right _ _)).trans (min_le_left _ _)
  have hMdelta_tailq : M.delta ≤ aux_lem_band_tailq_delta0 d q hq1 :=
    (hMdelta.trans (min_le_right _ _)).trans (min_le_right _ _)
  have hMdnn : (0 : ℝ) ≤ M.delta := M.shellPrefix.delta_pos.le
  have hbase := aux_lem_band_piece_response_baseline M s eps hs.1 heps.1 (weight 3)
    (hweight 3) eta heta F Praw Rraw Draw Z rawGood hprim p q hp
    (le_trans (by linarith : p ≤ 2 * p) (le_trans (le_max_left _ _) hq_bound)) hMr hM1 N n z hn
  obtain ⟨Ytrunc, hYtruncmeas, htrunc⟩ :=
    aux_lem_band_piece_response_truncation d hd I _Poincare _Extension _Perturbation _Sobolev D
      Cresp s sigma eps hCresp hs hsigma heps p q hp hq_bound hq1 hq_a1 M Rm hRm Sreg _It H hH eta
      heta F Praw Rraw Draw Z rawGood hprim h12q hM1 hMr hMdelta_rcJ hMdelta_tailq (weight 3)
      (hweight 3) N n z hn h hh
  have hbase' : eLpNorm (fun omega => weight 3 * (min (1 : ENNReal)
        ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
            ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal - 0)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ((weight 3 * Cbase0) * M.delta ^ 2) := by
    simp only [sub_zero]
    refine hbase.trans (ENNReal.ofReal_le_ofReal (le_of_eq ?_))
    rw [hCbase0def]
    ring
  have hq2 : 2 ≤ aux_prefix_rraw_q d s moments := aux_prefix_rraw_two_le_q d s moments
  have hq'0 : 0 < aux_prefix_rraw_q d s moments := by linarith
  have hsqq : 8 * (d : ℝ) < s * aux_prefix_rraw_q d s moments :=
    aux_prefix_rraw_margin d s hs.1 moments
  have hKcnn : 0 ≤ Kc := by
    rw [hKcdef]; exact aux_prefix_rraw_K_nonneg d s _ hq'0 hsqq
  have hrhocnn : 0 ≤ rhoc := by
    rw [hrhocdef]; exact (aux_prefix_rraw_rho_pos d s _).le
  have hClogpos : 0 < aux_prefix_rraw_C d := (aux_prefix_rraw_C_spec d).1
  have hCcnn : 0 ≤ Cc := by
    rw [hCcdef]
    have hlognn : 0 ≤ Real.log (2 + aux_prefix_rraw_q d s moments) :=
      Real.log_nonneg (by linarith)
    positivity
  have hCbase0nn : 0 ≤ Cbase0 := by rw [hCbase0def]; positivity
  obtain ⟨Yband, hYbandmeas, hYbandbound⟩ := aux_lem_band_err_case_split
    (fun omega => weight 3 * (min (1 : ENNReal)
        ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
            ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal)
    0 Ytrunc hYtruncmeas (ENNReal.ofReal p)
    (weight 3 * Cbase0) Cp M.delta ((3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ)))) 2
    (mul_nonneg (hweight 3) hCbase0nn) hCp hMdnn (by positivity)
    hbase' htrunc
  refine ⟨Yband, ?_, ?_⟩
  · simpa using hYbandmeas
  · refine hYbandbound.trans (ENNReal.ofReal_le_ofReal (le_of_eq ?_))
    have hsplit : Real.sqrt (M.delta ^ 2 * (3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ)))) =
        M.delta * (3 : ℝ) ^ (-(min a1 s / 32 * (h : ℝ))) := by
      rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hMdnn]
      congr 1
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
      congr 1
      ring
    rw [hsplit, Real.rpow_one]
    ring

theorem aux_lem_band_piece_coords_band_widen
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (mu : Measure (BilateralField d)) (n : ℤ) (h w1 w0 : ℕ) (hw : w1 ≤ w0)
    {f : BilateralField d → ℝ}
    (hf : AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (w1 * (h + 1) : ℕ)) (-n + (w1 * (h + 1) : ℕ)) => omega (j : ℤ))
        inferInstance] f mu) :
    AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ))
        inferInstance] f mu := by
  set lo1 : ℤ := -n - (w1 * (h + 1) : ℕ) with hlo1def
  set hi1 : ℤ := -n + (w1 * (h + 1) : ℕ) with hhi1def
  set lo0 : ℤ := -n - (w0 * (h + 1) : ℕ) with hlo0def
  set hi0 : ℤ := -n + (w0 * (h + 1) : ℕ) with hhi0def
  have hwnat : (w1 * (h + 1) : ℕ) ≤ (w0 * (h + 1) : ℕ) := Nat.mul_le_mul_right _ hw
  have hlo : lo0 ≤ lo1 := by
    rw [hlo0def, hlo1def]
    have : ((w1 * (h + 1) : ℕ) : ℤ) ≤ ((w0 * (h + 1) : ℕ) : ℤ) := by exact_mod_cast hwnat
    omega
  have hhi : hi1 ≤ hi0 := by
    rw [hhi0def, hhi1def]
    have : ((w1 * (h + 1) : ℕ) : ℤ) ≤ ((w0 * (h + 1) : ℕ) : ℤ) := by exact_mod_cast hwnat
    omega
  set projSmall : BilateralField d → (Set.Icc lo1 hi1 → C(SpatialCoordinates d, ℝ)) :=
    fun omega j => omega (j : ℤ) with hprojSmalldef
  set projBig : BilateralField d → (Set.Icc lo0 hi0 → C(SpatialCoordinates d, ℝ)) :=
    fun omega j => omega (j : ℤ) with hprojBigdef
  set incl : Set.Icc lo1 hi1 → Set.Icc lo0 hi0 :=
    fun j => ⟨j.1, ⟨hlo.trans j.2.1, j.2.2.trans hhi⟩⟩ with hincldef
  set restrict : (Set.Icc lo0 hi0 → C(SpatialCoordinates d, ℝ)) →
      (Set.Icc lo1 hi1 → C(SpatialCoordinates d, ℝ)) :=
    fun g j => g (incl j) with hrestrictdef
  have hrestrict_meas : Measurable restrict :=
    Measurable.of_eval (fun j => measurable_pi_apply (incl j))
  have hfactor : projSmall = restrict ∘ projBig := by
    funext omega j
    rfl
  have hmono : MeasurableSpace.comap projSmall inferInstance ≤
      MeasurableSpace.comap projBig inferInstance := by
    calc MeasurableSpace.comap projSmall inferInstance
        = MeasurableSpace.comap (restrict ∘ projBig) inferInstance := by rw [hfactor]
      _ = MeasurableSpace.comap projBig (MeasurableSpace.comap restrict inferInstance) :=
          (MeasurableSpace.comap_comp).symm
      _ ≤ MeasurableSpace.comap projBig inferInstance :=
          MeasurableSpace.comap_mono hrestrict_meas.comap_le
  obtain ⟨g, hg, hfg⟩ := hf
  exact ⟨g, hg.mono hmono, hfg⟩

theorem aux_lem_band_piece_coords_K7_ahom_ratio_bound {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (A B : ℕ)
    (hAB : A ≤ B) :
    Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A))) ≤ ahom M B / ahom M A ∧
      ahom M B / ahom M A ≤ 1 := by
  have hApos := ahom_pos M A
  rcases eq_or_lt_of_le hAB with heq | hlt
  · subst heq
    simp [div_self (ne_of_gt hApos)]
  · obtain ⟨h1, h2⟩ := Rm.ahom_ordering A B hlt
    refine ⟨?_, (div_le_one hApos).mpr h1⟩
    rw [le_div_iff₀ hApos, mul_comm]
    have hE : Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A)) *
        Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A))) = 1 := by
      rw [← Real.exp_add]; simp
    calc ahom M A * Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A)))
        ≤ (Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A)) * ahom M B) *
            Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A))) :=
          mul_le_mul_of_nonneg_right h2 (Real.exp_pos _).le
      _ = ahom M B * (Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A)) *
            Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A)))) := by ring
      _ = ahom M B := by rw [hE, mul_one]

theorem aux_lem_band_piece_coords_K7_ratio_inv_env {x c : ℝ} (hx0 : 0 < x)
    (hlo : Real.exp (-c) ≤ x) (hhi : x ≤ 1) :
    (1 : ℝ) ≤ x⁻¹ ∧ x⁻¹ ≤ Real.exp c := by
  constructor
  · rw [show x⁻¹ = 1 / x from (one_div x).symm, le_div_iff₀ hx0]
    linarith
  · rw [show x⁻¹ = 1 / x from (one_div x).symm, div_le_iff₀ hx0]
    calc (1 : ℝ) = Real.exp c * Real.exp (-c) := by rw [← Real.exp_add]; simp
      _ ≤ Real.exp c * x := mul_le_mul_of_nonneg_left hlo (Real.exp_pos _).le

theorem aux_lem_band_piece_coords_K7_ahom_ratio_bound_any {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (A B : ℕ) :
    Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * |(A : ℝ) - B|)) ≤ ahom M A / ahom M B ∧
      ahom M A / ahom M B ≤ Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * |(A : ℝ) - B|) := by
  have htau : 0 ≤ _root_.SubdiffusiveProcess.Model.tauSq M.P := (tauSq_pos_of_G4 M).le
  rcases le_total A B with hAB | hAB
  · obtain ⟨hlo, hhi⟩ := aux_lem_band_piece_coords_K7_ahom_ratio_bound M Rm A B hAB
    have hApos := ahom_pos M A
    have hcast : (A : ℝ) ≤ B := by exact_mod_cast hAB
    have habs : |(A : ℝ) - B| = (B : ℝ) - A := by rw [abs_of_nonpos (by linarith)]; ring
    have hratio_pos : (0 : ℝ) < ahom M B / ahom M A := div_pos (ahom_pos M B) hApos
    obtain ⟨hi1, hi2⟩ := aux_lem_band_piece_coords_K7_ratio_inv_env
      (x := ahom M B / ahom M A)
      (c := 2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A)) hratio_pos hlo hhi
    rw [inv_div] at hi1 hi2
    rw [habs]
    have hone : Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((B : ℝ) - A))) ≤ 1 := by
      rw [← Real.exp_zero]; exact Real.exp_le_exp.mpr (by nlinarith [htau, hcast])
    exact ⟨le_trans hone hi1, hi2⟩
  · obtain ⟨hlo, hhi⟩ := aux_lem_band_piece_coords_K7_ahom_ratio_bound M Rm B A hAB
    have hcast : (B : ℝ) ≤ A := by exact_mod_cast hAB
    have habs : |(A : ℝ) - B| = (A : ℝ) - B := abs_of_nonneg (by linarith)
    rw [habs]
    have hone : (1 : ℝ) ≤ Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * ((A : ℝ) - B)) := by
      rw [← Real.exp_zero]; exact Real.exp_le_exp.mpr (by nlinarith [htau, hcast])
    exact ⟨hlo, hhi.trans hone⟩

theorem aux_lem_band_piece_coords_K7_exp_env_mul {u v c1 c2 : ℝ}
    (hu1 : Real.exp (-c1) ≤ u) (hu2 : u ≤ Real.exp c1)
    (hv1 : Real.exp (-c2) ≤ v) (hv2 : v ≤ Real.exp c2) :
    Real.exp (-(c1 + c2)) ≤ u * v ∧ u * v ≤ Real.exp (c1 + c2) := by
  have hu0 : 0 < u := lt_of_lt_of_le (Real.exp_pos _) hu1
  have hv0 : 0 < v := lt_of_lt_of_le (Real.exp_pos _) hv1
  constructor
  · calc Real.exp (-(c1 + c2)) = Real.exp (-c1) * Real.exp (-c2) := by
          rw [← Real.exp_add]; ring_nf
      _ ≤ u * v := mul_le_mul hu1 hv1 (Real.exp_pos _).le hu0.le
  · calc u * v ≤ Real.exp c1 * Real.exp c2 := mul_le_mul hu2 hv2 hv0.le (Real.exp_pos _).le
      _ = Real.exp (c1 + c2) := by rw [← Real.exp_add]

theorem aux_lem_band_piece_coords_K7_toNat_diff_le (N : ℕ) (nn mm : ℤ) :
    |(((N : ℤ) - nn).toNat : ℝ) - (((N : ℤ) - mm).toNat : ℝ)| ≤ |(mm : ℝ) - nn| := by
  rcases le_total nn mm with h | h
  · have h1 : ((N : ℤ) - mm).toNat ≤ ((N : ℤ) - nn).toNat := by omega
    have h2 : (((N : ℤ) - nn).toNat : ℤ) - (((N : ℤ) - mm).toNat : ℤ) ≤ mm - nn := by omega
    have h1' : (((N : ℤ) - mm).toNat : ℝ) ≤ (((N : ℤ) - nn).toNat : ℝ) := by exact_mod_cast h1
    have h2' : (((N : ℤ) - nn).toNat : ℝ) - (((N : ℤ) - mm).toNat : ℝ) ≤ (mm : ℝ) - nn := by
      exact_mod_cast h2
    rw [abs_of_nonneg (by linarith), abs_of_nonneg (by exact_mod_cast sub_nonneg.mpr h)]
    linarith
  · have h1 : ((N : ℤ) - nn).toNat ≤ ((N : ℤ) - mm).toNat := by omega
    have h2 : (((N : ℤ) - mm).toNat : ℤ) - (((N : ℤ) - nn).toNat : ℤ) ≤ nn - mm := by omega
    have h1' : (((N : ℤ) - nn).toNat : ℝ) ≤ (((N : ℤ) - mm).toNat : ℝ) := by exact_mod_cast h1
    have h2' : (((N : ℤ) - mm).toNat : ℝ) - (((N : ℤ) - nn).toNat : ℝ) ≤ (nn : ℝ) - mm := by
      exact_mod_cast h2
    rw [abs_of_nonpos (by linarith), abs_of_nonpos (by exact_mod_cast sub_nonpos.mpr h)]
    linarith

theorem aux_lem_band_piece_coords_K7_kappa_ratio_bounded {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (nn mm : ℤ) (N : ℕ)
    (_hnnN : nn ≤ (N : ℤ)) (_hmmN : mm ≤ (N : ℤ)) :
    let kappa : ℕ → ℝ := fun J =>
      Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M J
    kappa ((N : ℤ) - nn).toNat / kappa ((N : ℤ) - mm).toNat ∈
      Set.Icc (0 : ℝ) (Real.exp (3 * _root_.SubdiffusiveProcess.Model.tauSq M.P * |(mm : ℝ) - nn|)) := by
  intro kappa
  set k : ℝ := |(mm : ℝ) - nn| with hkdef
  have hk0 : 0 ≤ k := abs_nonneg _
  set A : ℕ := ((N : ℤ) - nn).toNat with hAdef
  set B : ℕ := ((N : ℤ) - mm).toNat with hBdef
  have hApos := ahom_pos M A
  have hBpos := ahom_pos M B
  have hkAB_pos : 0 < kappa A / kappa B :=
    div_pos (mul_pos (Real.exp_pos _) hApos) (mul_pos (Real.exp_pos _) hBpos)
  refine ⟨hkAB_pos.le, ?_⟩
  have hdiff : |(A : ℝ) - B| ≤ k := aux_lem_band_piece_coords_K7_toNat_diff_le N nn mm
  obtain ⟨hle1, hle2⟩ := abs_le.mp hdiff
  have htau : 0 ≤ _root_.SubdiffusiveProcess.Model.tauSq M.P := (tauSq_pos_of_G4 M).le
  have hexp_arg : ((A : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P -
      (((B : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) =
      _root_.SubdiffusiveProcess.Model.tauSq M.P * ((A : ℝ) - B) := by ring
  have hkeq : kappa A / kappa B =
      Real.exp (_root_.SubdiffusiveProcess.Model.tauSq M.P * ((A : ℝ) - B)) * (ahom M A / ahom M B) := by
    show (Real.exp (((A : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M A) /
        (Real.exp (((B : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M B) = _
    rw [← div_mul_div_comm, ← Real.exp_sub, hexp_arg]
  rw [hkeq]
  have hexp_env : Real.exp (-(_root_.SubdiffusiveProcess.Model.tauSq M.P * k)) ≤
        Real.exp (_root_.SubdiffusiveProcess.Model.tauSq M.P * ((A : ℝ) - B)) ∧
      Real.exp (_root_.SubdiffusiveProcess.Model.tauSq M.P * ((A : ℝ) - B)) ≤
        Real.exp (_root_.SubdiffusiveProcess.Model.tauSq M.P * k) := by
    constructor <;> apply Real.exp_le_exp.mpr <;> nlinarith [hle1, hle2, htau]
  have hahom_env := aux_lem_band_piece_coords_K7_ahom_ratio_bound_any M Rm A B
  have hwiden : Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * k)) ≤
        Real.exp (-(2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * |(A : ℝ) - B|)) ∧
      Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * |(A : ℝ) - B|) ≤
        Real.exp (2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * k) := by
    constructor <;> apply Real.exp_le_exp.mpr <;> nlinarith [hdiff, htau]
  obtain ⟨e1, e2⟩ := aux_lem_band_piece_coords_K7_exp_env_mul
      (c1 := _root_.SubdiffusiveProcess.Model.tauSq M.P * k)
      (c2 := 2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * k)
      hexp_env.1 hexp_env.2 (hwiden.1.trans hahom_env.1) (hahom_env.2.trans hwiden.2)
  calc Real.exp (_root_.SubdiffusiveProcess.Model.tauSq M.P * ((A : ℝ) - B)) * (ahom M A / ahom M B)
      ≤ Real.exp (_root_.SubdiffusiveProcess.Model.tauSq M.P * k +
          2 * _root_.SubdiffusiveProcess.Model.tauSq M.P * k) := e2
    _ ≤ Real.exp (3 * _root_.SubdiffusiveProcess.Model.tauSq M.P * k) := by
        apply Real.exp_le_exp.mpr; nlinarith

theorem aux_lem_band_piece_coords_K7_value_ref_ratio_eq {d : ℕ}
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (nn mm : ℤ)
    (z w : SpatialCoordinates d) (N : ℕ) (_hnnN : nn ≤ (N : ℤ)) (_hmmN : mm ≤ (N : ℤ))
    (omega : BilateralField d) :
    let kappa : ℕ → ℝ := fun J =>
      Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M J
    let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
      fun n zz omega => if 0 ≤ n then ∑ j ∈ Finset.Ico (0 : ℤ) n, omega (-j) zz
        else -∑ j ∈ Finset.Ico n (0 : ℤ), omega (-j) zz
    let reference : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
      fun n zz omega => kappa ((N : ℤ) - n).toNat / kappa N *
        Real.exp (H omega zz + retained n zz omega)
    reference nn z omega / reference mm w omega =
      (kappa ((N : ℤ) - nn).toNat / kappa ((N : ℤ) - mm).toNat) *
        Real.exp (H omega z + retained nn z omega - (H omega w + retained mm w omega)) := by
  intro kappa retained reference
  have hkN : kappa N ≠ 0 := ne_of_gt (mul_pos (Real.exp_pos _) (ahom_pos M N))
  have hkmm : kappa ((N : ℤ) - mm).toNat ≠ 0 :=
    ne_of_gt (mul_pos (Real.exp_pos _) (ahom_pos M _))
  show (kappa ((N : ℤ) - nn).toNat / kappa N * Real.exp (H omega z + retained nn z omega)) /
      (kappa ((N : ℤ) - mm).toNat / kappa N * Real.exp (H omega w + retained mm w omega)) = _
  rw [Real.exp_sub]
  field_simp

theorem aux_lem_band_piece_coords_K7_tail_pos_root_exp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∃ m : ℕ, 0 < m ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
        (u δ : SpatialCoordinates d) (c : ℝ) (_hc0 : 0 < c) (_hc1 : c ≤ 1)
        (_hδ : ‖δ‖ ≤ (3 / 2 : ℝ) * c),
        (∫⁻ f, ENNReal.ofReal (Real.exp
            ((|f (u + δ) - f u| /
              (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta))) ^ 2))
          ∂(chaosRootFieldLaw M).toMeasure) ≤ 2 := by
  obtain ⟨m, hm, hexp⟩ :=
    exists_gmc_anchored_contraction_exp_square (d := d) (3 / 2 : ℝ) (by norm_num)
  refine ⟨m, hm, ?_⟩
  intro M u δ c hc0 hc1 hδ
  let K0 : Compacts (SpatialCoordinates d) :=
    ⟨Metric.closedBall (0 : SpatialCoordinates d) (3 / 2 : ℝ),
      isCompact_closedBall _ _⟩
  have hK0 : ∀ x ∈ (K0 : Set (SpatialCoordinates d)), ‖x‖ ≤ (3 / 2 : ℝ) := by
    intro x hx
    simpa [K0, Metric.mem_closedBall, dist_eq_norm] using hx
  have hbase := hexp M K0 hK0 c hc0 hc1
  dsimp only at hbase
  let dilation : C(SpatialCoordinates d, SpatialCoordinates d) :=
    ⟨fun x => c • x, by fun_prop⟩
  let Φ : C(SpatialCoordinates d, ℝ) → ℝ≥0∞ := fun f =>
    ENNReal.ofReal (Real.exp
      ((‖(f.comp dilation).restrict (K0 : Set (SpatialCoordinates d)) -
          ContinuousMap.const K0 (f 0)‖ /
        (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta))) ^ 2))
  have hΦmeas : Measurable Φ := by
    have hcomp : Continuous (fun f : C(SpatialCoordinates d, ℝ) => f.comp dilation) :=
      ContinuousMap.continuous_precomp dilation
    have hrestrict : Continuous (fun f : C(SpatialCoordinates d, ℝ) =>
        (f.comp dilation).restrict (K0 : Set (SpatialCoordinates d))) :=
      (ContinuousMap.continuous_restrict (K0 : Set (SpatialCoordinates d))).comp hcomp
    have hanchor : Continuous (fun f : C(SpatialCoordinates d, ℝ) =>
        ContinuousMap.const K0 (f 0)) :=
      ContinuousMap.continuous_const'.comp (continuous_eval_const 0)
    have hnorm : Continuous (fun f : C(SpatialCoordinates d, ℝ) =>
        ‖(f.comp dilation).restrict (K0 : Set (SpatialCoordinates d)) -
          ContinuousMap.const K0 (f 0)‖) := continuous_norm.comp (hrestrict.sub hanchor)
    have hcont : Continuous Φ := by
      apply ENNReal.continuous_ofReal.comp
      apply Real.continuous_exp.comp
      exact (hnorm.div_const _).pow 2
    exact hcont.measurable
  let ν : ProbabilityMeasure C(SpatialCoordinates d, ℝ) := chaosRootFieldLaw M
  let translate : C(C(SpatialCoordinates d, ℝ), C(SpatialCoordinates d, ℝ)) :=
    ContinuousMap.compRightContinuousMap ℝ
      (⟨fun x : SpatialCoordinates d => x + u,
        continuous_id.add continuous_const⟩ : C(SpatialCoordinates d, SpatialCoordinates d))
  have hstat : MeasurePreserving translate (ν : Measure C(SpatialCoordinates d, ℝ))
      (ν : Measure C(SpatialCoordinates d, ℝ)) := by
    exact gmc_zero_field_law_stationary M u
  have htranslated :
      (∫⁻ f, Φ (translate f) ∂(ν : Measure C(SpatialCoordinates d, ℝ))) ≤ 2 := by
    calc (∫⁻ f, Φ (translate f) ∂(ν : Measure C(SpatialCoordinates d, ℝ)))
        = ∫⁻ f, Φ f ∂Measure.map translate (ν : Measure C(SpatialCoordinates d, ℝ)) :=
          (lintegral_map hΦmeas hstat.measurable).symm
      _ = ∫⁻ f, Φ f ∂(ν : Measure C(SpatialCoordinates d, ℝ)) := by rw [hstat.map_eq]
      _ ≤ 2 := by
          exact hbase
  have hx0 : (1 / c) • δ ∈ (K0 : Set (SpatialCoordinates d)) := by
    change dist ((1 / c) • δ) (0 : SpatialCoordinates d) ≤ (3 / 2 : ℝ)
    rw [dist_eq_norm, sub_zero, norm_smul, Real.norm_eq_abs,
      abs_of_pos (show (0 : ℝ) < 1 / c by positivity)]
    rw [one_div, ← div_eq_inv_mul, div_le_iff₀ hc0]
    linarith [hδ]
  have hcancel : c • ((1 / c) • δ) = δ := by
    rw [smul_smul]
    rw [show c * (1 / c) = 1 by field_simp]
    exact one_smul ℝ δ
  have hpoint : ∀ f : C(SpatialCoordinates d, ℝ),
      |f (u + δ) - f u| ≤
        ‖((translate f).comp dilation).restrict (K0 : Set (SpatialCoordinates d)) -
          ContinuousMap.const K0 ((translate f) 0)‖ := by
    intro f
    have hnc := ContinuousMap.norm_coe_le_norm
      (((translate f).comp dilation).restrict (K0 : Set (SpatialCoordinates d)) -
        ContinuousMap.const K0 ((translate f) 0)) ⟨(1 / c) • δ, hx0⟩
    have heq : (((translate f).comp dilation).restrict (K0 : Set (SpatialCoordinates d)) -
        ContinuousMap.const K0 ((translate f) 0)) ⟨(1 / c) • δ, hx0⟩ =
        f (u + δ) - f u := by
      show (translate f) (dilation ((1 / c) • δ)) - (translate f) 0 = f (u + δ) - f u
      show (translate f) (c • ((1 / c) • δ)) - (translate f) 0 = f (u + δ) - f u
      rw [hcancel]
      show f (δ + u) - f (0 + u) = f (u + δ) - f u
      rw [zero_add, add_comm δ u]
    rw [heq] at hnc
    exact hnc
  have hmono : ∀ f : C(SpatialCoordinates d, ℝ),
      ENNReal.ofReal (Real.exp
          ((|f (u + δ) - f u| /
            (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta))) ^ 2)) ≤
        Φ (translate f) := by
    intro f
    apply ENNReal.ofReal_mono
    apply Real.exp_le_exp.mpr
    have hA : 0 < c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta) :=
      mul_pos (mul_pos hc0 (by norm_num)) (mul_pos (by exact_mod_cast hm) (M.shellPrefix.delta_pos))
    have hle : |f (u + δ) - f u| ≤
        ‖((translate f).comp dilation).restrict (K0 : Set (SpatialCoordinates d)) -
          ContinuousMap.const K0 ((translate f) 0)‖ := hpoint f
    have h1 : 0 ≤ |f (u + δ) - f u| / (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta)) :=
      div_nonneg (abs_nonneg _) hA.le
    have h2 : 0 ≤ ‖((translate f).comp dilation).restrict (K0 : Set (SpatialCoordinates d)) -
          ContinuousMap.const K0 ((translate f) 0)‖ /
        (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta)) := div_nonneg (norm_nonneg _) hA.le
    apply (sq_le_sq₀ h1 h2).2
    gcongr
  calc (∫⁻ f, ENNReal.ofReal (Real.exp
          ((|f (u + δ) - f u| /
            (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta))) ^ 2))
        ∂(chaosRootFieldLaw M).toMeasure)
      ≤ ∫⁻ f, Φ (translate f) ∂(chaosRootFieldLaw M).toMeasure :=
        lintegral_mono hmono
    _ ≤ 2 := htranslated

theorem aux_lem_band_piece_coords_K7_tail_pos_layer_exp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∃ m : ℕ, 0 < m ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (i : ℤ)
        (z off : SpatialCoordinates d) (c : ℝ) (_hc0 : 0 < c) (_hc1 : c ≤ 1)
        (_hδ : ‖((3 : ℝ) ^ (-i)) • off‖ ≤ (3 / 2 : ℝ) * c),
        (∫⁻ omega : BilateralField d, ENNReal.ofReal (Real.exp
            ((|omega i z - omega i (z + off)| /
              (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta))) ^ 2))
          ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨m, hm, hroot⟩ := aux_lem_band_piece_coords_K7_tail_pos_root_exp (d := d)
  refine ⟨m, hm, ?_⟩
  intro M i z off c hc0 hc1 hδ
  set u : SpatialCoordinates d := (3 : ℝ) ^ (-i) • z with hudef
  set δ : SpatialCoordinates d := (3 : ℝ) ^ (-i) • off with hδdef
  set A : ℝ := c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta) with hAdef
  set G : C(SpatialCoordinates d, ℝ) → ℝ≥0∞ := fun f =>
    ENNReal.ofReal (Real.exp ((|f z - f (z + off)| / A) ^ 2)) with hGdef
  have hGmeas : Measurable G := by
    have hc : Continuous (fun f : C(SpatialCoordinates d, ℝ) => |f z - f (z + off)|) :=
      ((continuous_eval_const z).sub (continuous_eval_const (z + off))).abs
    have : Continuous G := by
      apply ENNReal.continuous_ofReal.comp
      apply Real.continuous_exp.comp
      exact (hc.div_const _).pow 2
    exact this.measurable
  let laws : ℤ → Measure C(SpatialCoordinates d, ℝ) :=
    fun j => (scaledLayerLaw d (chaosRootFieldLaw M) j : Measure C(SpatialCoordinates d, ℝ))
  have hP : (chaosSampleLaw M).toMeasure = Measure.infinitePi laws := by rfl
  have heval := measurePreserving_eval_infinitePi laws i
  have hstep1 : (∫⁻ omega : BilateralField d, G (omega i) ∂(chaosSampleLaw M).toMeasure) =
      ∫⁻ f, G f ∂(laws i) := by
    rw [hP]
    exact heval.lintegral_comp hGmeas
  have hstep2 : (∫⁻ f, G f ∂(laws i)) =
      ∫⁻ g, G (layerScaling d i g) ∂(chaosRootFieldLaw M).toMeasure := by
    show (∫⁻ f, G f ∂(scaledLayerLaw d (chaosRootFieldLaw M) i : Measure _)) = _
    simp only [scaledLayerLaw, ProbabilityMeasure.toMeasure_map]
    exact lintegral_map hGmeas (layerScaling d i).continuous.measurable
  have hval : ∀ g : C(SpatialCoordinates d, ℝ),
      G (layerScaling d i g) = ENNReal.ofReal (Real.exp ((|g u - g (u + δ)| / A) ^ 2)) := by
    intro g
    have h1 : (layerScaling d i g) z = g u := by
      show g ((3 : ℝ) ^ (-i) • z) = g u
      rw [hudef]
    have h2 : (layerScaling d i g) (z + off) = g (u + δ) := by
      show g ((3 : ℝ) ^ (-i) • (z + off)) = g (u + δ)
      rw [hudef, hδdef, smul_add]
    rw [hGdef]
    dsimp only
    rw [h1, h2]
  calc (∫⁻ omega : BilateralField d, ENNReal.ofReal (Real.exp
          ((|omega i z - omega i (z + off)| / A) ^ 2))
        ∂(chaosSampleLaw M).toMeasure)
      = ∫⁻ omega : BilateralField d, G (omega i) ∂(chaosSampleLaw M).toMeasure := by
        apply lintegral_congr
        intro omega
        rw [hGdef]
    _ = ∫⁻ f, G f ∂(laws i) := hstep1
    _ = ∫⁻ g, G (layerScaling d i g) ∂(chaosRootFieldLaw M).toMeasure := hstep2
    _ = ∫⁻ g, ENNReal.ofReal (Real.exp ((|g u - g (u + δ)| / A) ^ 2))
          ∂(chaosRootFieldLaw M).toMeasure := by
        apply lintegral_congr
        exact hval
    _ = ∫⁻ g, ENNReal.ofReal (Real.exp ((|g (u + δ) - g u| / A) ^ 2))
          ∂(chaosRootFieldLaw M).toMeasure := by
        apply lintegral_congr
        intro g
        rw [abs_sub_comm]
    _ ≤ 2 := hroot M u δ c hc0 hc1 hδ

theorem aux_lem_band_piece_coords_K7_tail_pos_layer_lp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∃ m : ℕ, 0 < m ∧ ∃ C : ℝ, 0 < C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (i : ℤ)
        (z off : SpatialCoordinates d) (c : ℝ) (_hc0 : 0 < c) (_hc1 : c ≤ 1)
        (_hδ : ‖((3 : ℝ) ^ (-i)) • off‖ ≤ (3 / 2 : ℝ) * c)
        (p : ℝ) (_hp : 1 ≤ p),
        eLpNorm (fun omega : BilateralField d => omega i z - omega i (z + off))
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C * (c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta)) * Real.sqrt p) := by
  obtain ⟨m, hm, hexp⟩ := aux_lem_band_piece_coords_K7_tail_pos_layer_exp (d := d)
  obtain ⟨C0, hC0, hOrlicz⟩ := exists_universal_orlicz_eLpNorm_constant
  refine ⟨m, hm, C0 * Real.sqrt 2, by positivity, ?_⟩
  intro M i z off c hc0 hc1 hδ p hp
  set μ : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure with hμdef
  set A : ℝ := c * (3 / 2 : ℝ) * ((m : ℝ) * M.delta) with hAdef
  have hApos : 0 < A := by
    have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
    rw [hAdef]; positivity
  set X : BilateralField d → ℝ := fun omega => |omega i z - omega i (z + off)| with hXdef
  have hXmeas : Measurable X := by
    have hz : Continuous (fun omega : BilateralField d => omega i z) :=
      (continuous_eval_const z).comp (continuous_apply i)
    have hzoff : Continuous (fun omega : BilateralField d => omega i (z + off)) :=
      (continuous_eval_const (z + off)).comp (continuous_apply i)
    have : Continuous (fun omega : BilateralField d => omega i z - omega i (z + off)) :=
      hz.sub hzoff
    exact this.abs.measurable
  have hXnonneg : ∀ omega, 0 ≤ X omega := fun omega => abs_nonneg _
  have hXexp : (∫⁻ omega, ENNReal.ofReal (Real.exp ((X omega / A) ^ 2)) ∂μ) ≤ 2 := by
    rw [hμdef]
    exact hexp M i z off c hc0 hc1 hδ
  have hp2case : ∀ q : ℝ≥0∞, q ≠ (⊤ : ℝ≥0∞) → 2 ≤ q →
      eLpNorm X q μ ≤ ENNReal.ofReal (C0 * A * Real.sqrt q.toReal) :=
    hOrlicz μ X A hXmeas hXnonneg hApos hXexp
  have hXeq2 : X = fun omega : BilateralField d => ‖omega i z - omega i (z + off)‖ := by
    funext omega
    rw [hXdef]
    exact (Real.norm_eq_abs _).symm
  have hXeq : eLpNorm (fun omega : BilateralField d => omega i z - omega i (z + off))
      (ENNReal.ofReal p) μ = eLpNorm X (ENNReal.ofReal p) μ := by
    rw [hXeq2]
    have hm : AEStronglyMeasurable (fun omega : BilateralField d =>
        omega i z - omega i (z + off)) μ :=
      (((continuous_eval_const z).comp (continuous_apply i)).measurable.aestronglyMeasurable).sub
        (((continuous_eval_const (z + off)).comp (continuous_apply i)).measurable.aestronglyMeasurable)
    exact (eLpNorm_norm _ hm).symm
  rw [hXeq]
  by_cases hp2 : 2 ≤ p
  · have hqle : (2 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
      rw [← ENNReal.ofReal_ofNat]
      exact ENNReal.ofReal_le_ofReal hp2
    have hbound := hp2case (ENNReal.ofReal p) ENNReal.ofReal_ne_top hqle
    have hpr : (ENNReal.ofReal p).toReal = p := ENNReal.toReal_ofReal (by linarith)
    rw [hpr] at hbound
    refine hbound.trans (ENNReal.ofReal_le_ofReal ?_)
    have h1le2 : (1 : ℝ) ≤ Real.sqrt 2 := by
      rw [show (1 : ℝ) = Real.sqrt 1 by simp]
      exact Real.sqrt_le_sqrt (by norm_num)
    have hstep : C0 ≤ C0 * Real.sqrt 2 := le_mul_of_one_le_right hC0.le h1le2
    calc C0 * A * Real.sqrt p = C0 * (A * Real.sqrt p) := by ring
      _ ≤ (C0 * Real.sqrt 2) * (A * Real.sqrt p) :=
          mul_le_mul_of_nonneg_right hstep (by positivity)
      _ = C0 * Real.sqrt 2 * A * Real.sqrt p := by ring
  · push Not at hp2
    have hmono : eLpNorm X (ENNReal.ofReal p) μ ≤ eLpNorm X 2 μ := by
      apply eLpNorm_le_eLpNorm_of_exponent_le _
      rw [← ENNReal.ofReal_ofNat]
      exact ENNReal.ofReal_le_ofReal hp2.le
    have hbound2 := hp2case 2 (by norm_num) le_rfl
    have hpr2 : (2 : ℝ≥0∞).toReal = 2 := by norm_num
    rw [hpr2] at hbound2
    refine hmono.trans (hbound2.trans (ENNReal.ofReal_le_ofReal ?_))
    have hsqrtp1 : (1 : ℝ) ≤ Real.sqrt p := by
      rw [show (1 : ℝ) = Real.sqrt 1 by simp]
      exact Real.sqrt_le_sqrt (by linarith)
    calc C0 * A * Real.sqrt 2 = (C0 * Real.sqrt 2 * A) * 1 := by ring
      _ ≤ (C0 * Real.sqrt 2 * A) * Real.sqrt p :=
          mul_le_mul_of_nonneg_left hsqrtp1 (by positivity)
      _ = C0 * Real.sqrt 2 * A * Real.sqrt p := by ring

theorem aux_lem_band_piece_coords_K7_tail_pos_tail_lp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∃ m : ℕ, 0 < m ∧ ∃ C : ℝ, 0 < C ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (z off : SpatialCoordinates d) (κ : ℕ)
        (_hκ : (2 / 3 : ℝ) * (‖off‖ + 1) ≤ (3 : ℝ) ^ (κ + 1 : ℕ))
        (p : ℝ) (_hp : 1 ≤ p),
        MemLp (fun omega : BilateralField d =>
            ∑' k : ℕ, (omega (((κ : ℤ) + 1 + k)) z - omega ((κ : ℤ) + 1 + k) (z + off)))
          (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (fun omega : BilateralField d =>
            ∑' k : ℕ, (omega ((κ : ℤ) + 1 + k) z - omega ((κ : ℤ) + 1 + k) (z + off)))
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (C * (‖off‖ + 1) * (m : ℝ) * M.delta * Real.sqrt p *
            (3 : ℝ) ^ (-(κ : ℤ))) := by
  obtain ⟨m, hm, C0, hC0, hlp⟩ := aux_lem_band_piece_coords_K7_tail_pos_layer_lp (d := d)
  refine ⟨m, hm, C0 / 2, by positivity, ?_⟩
  intro M z off κ hκ p hp
  set μ : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure with hμdef
  set F : ℕ → BilateralField d → ℝ := fun k omega =>
    omega ((κ : ℤ) + 1 + k) z - omega ((κ : ℤ) + 1 + k) (z + off) with hFdef
  set c : ℕ → ℝ := fun k => (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1 + k)) with hcdef
  have hcpos : ∀ k, 0 < c k := fun k => by
    rw [hcdef]; positivity
  have hc1 : ∀ k, c k ≤ 1 := by
    intro k
    rw [hcdef]
    have hmono : (3 : ℝ) ^ (-((κ : ℤ) + 1 + k)) ≤ (3 : ℝ) ^ (-((κ : ℤ) + 1)) := by
      apply zpow_le_zpow_right₀ (by norm_num : (1:ℝ) ≤ 3)
      omega
    have hbase : (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1)) ≤ 1 := by
      have hzpoweq : (3 : ℝ) ^ (-((κ : ℤ) + 1)) = 1 / (3 : ℝ) ^ (κ + 1 : ℕ) := by
        rw [show (-(((κ : ℤ) + 1))) = -((κ + 1 : ℕ) : ℤ) by push_cast; ring, _root_.zpow_neg,
          zpow_natCast, one_div]
      rw [hzpoweq, mul_one_div, div_le_one (by positivity : (0:ℝ) < (3:ℝ) ^ (κ + 1 : ℕ))]
      exact hκ
    calc (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1 + k))
        ≤ (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1)) := by
          apply mul_le_mul_of_nonneg_left hmono (by positivity)
      _ ≤ 1 := hbase
  have hδ : ∀ k, ‖((3 : ℝ) ^ (-((κ : ℤ) + 1 + (k : ℕ)))) • off‖ ≤ (3 / 2 : ℝ) * c k := by
    intro k
    rw [hcdef, norm_smul, Real.norm_eq_abs,
      abs_of_pos (by positivity : (0:ℝ) < (3:ℝ) ^ (-((κ:ℤ)+1+(k:ℕ))))]
    nlinarith [norm_nonneg off, (by positivity : (0:ℝ) < (3:ℝ) ^ (-((κ:ℤ)+1+(k:ℕ))))]
  set B : ℝ := C0 * ((‖off‖ + 1) * (m : ℝ) * M.delta) * Real.sqrt p *
      (3 : ℝ) ^ (-((κ : ℤ) + 1)) with hBdef
  have hBnonneg : 0 ≤ B := by
    have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
    rw [hBdef]; positivity
  have hzpow : ∀ k : ℕ, (3 : ℝ) ^ (-((κ : ℤ) + 1 + (k : ℕ))) =
      (3 : ℝ) ^ (-((κ : ℤ) + 1)) * (1 / 3 : ℝ) ^ k := by
    intro k
    have h1 : (1 / 3 : ℝ) ^ k = (3 : ℝ) ^ (-(k : ℤ)) := by
      rw [_root_.zpow_neg, zpow_natCast, one_div, inv_pow]
    rw [h1, ← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]
    congr 1
    ring
  have hbound : ∀ k, eLpNorm (F k) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (B * (1 / 3 : ℝ) ^ k) := by
    intro k
    have hb := hlp M ((κ : ℤ) + 1 + (k : ℕ)) z off (c k) (hcpos k) (hc1 k) (hδ k) p hp
    have heq : C0 * (c k * (3 / 2 : ℝ) * ((m : ℝ) * M.delta)) * Real.sqrt p =
        B * (1 / 3 : ℝ) ^ k := by
      rw [hcdef]
      dsimp only
      rw [hzpow k, hBdef]
      ring
    rwa [heq] at hb
  have hFmeas : ∀ k, Measurable (F k) := by
    intro k
    have hz : Continuous (fun omega : BilateralField d => omega ((κ : ℤ) + 1 + (k:ℕ)) z) :=
      (continuous_eval_const z).comp (continuous_apply ((κ : ℤ) + 1 + (k:ℕ)))
    have hzoff : Continuous
        (fun omega : BilateralField d => omega ((κ : ℤ) + 1 + (k:ℕ)) (z + off)) :=
      (continuous_eval_const (z + off)).comp (continuous_apply ((κ : ℤ) + 1 + (k:ℕ)))
    exact (hz.sub hzoff).measurable
  have hFmem : ∀ k, MemLp (F k) (ENNReal.ofReal p) μ :=
    fun k => (hbound k).trans_lt ENNReal.ofReal_lt_top
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [show (1:ℝ≥0∞) = ENNReal.ofReal 1 by simp]
    exact ENNReal.ofReal_le_ofReal hp
  obtain ⟨-, htail⟩ := memLp_geometric_tsum_tails μ hp1 ENNReal.ofReal_ne_top
    F hFmem hBnonneg (by norm_num : (0:ℝ) ≤ (1/3:ℝ)) (by norm_num : (1/3:ℝ) < 1) hbound
  obtain ⟨hmem0, hnorm0⟩ := htail 0
  refine ⟨?_, ?_⟩
  · simpa only [add_zero] using hmem0
  · have hrhs : B * (1 / 3 : ℝ) ^ (0:ℕ) / (1 - 1 / 3 : ℝ) = (C0 / 2 : ℝ) * (‖off‖ + 1) *
        (m : ℝ) * M.delta * Real.sqrt p * (3 : ℝ) ^ (-(κ : ℤ)) := by
      rw [hBdef]
      have hsplit : (3 : ℝ) ^ (-((κ : ℤ) + 1)) = (3 : ℝ) ^ (-(κ : ℤ)) * (1 / 3 : ℝ) := by
        rw [show (1 / 3 : ℝ) = (3 : ℝ) ^ (-1 : ℤ) by rw [_root_.zpow_neg_one]; norm_num,
          ← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]
        congr 1; ring
      rw [hsplit]; ring
    simpa only [add_zero, hrhs] using hnorm0

theorem aux_lem_band_piece_coords_K7_tail_uniform_tail_exp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] :
    ∃ m : ℕ, 0 < m ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (z sh : SpatialCoordinates d)
        (n edge : ℤ)
        (_hedge : (2 / 3 : ℝ) * (‖sh‖ + 1) ≤ (3 : ℝ) ^ (edge + n + 1)),
        (∫⁻ omega : BilateralField d, ENNReal.ofReal (Real.exp
            ((‖∑' k : ℕ, (omega (edge + 1 + (k : ℤ)) z -
                omega (edge + 1 + (k : ℤ)) (z + ((3 : ℝ) ^ (-n)) • sh))‖ /
              ((1 / 2 : ℝ) * (m : ℝ) * M.delta * (‖sh‖ + 1) * (3 : ℝ) ^ (-(edge + n)))) ^ 2))
          ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨m, hm, hlp⟩ := aux_lem_band_piece_coords_K7_tail_pos_layer_exp (d := d)
  refine ⟨m, hm, ?_⟩
  intro M z sh n edge hedge
  set μ : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure with hμdef
  set off : SpatialCoordinates d := (3 : ℝ) ^ (-n) • sh with hoffdef
  set F : ℕ → BilateralField d → ℝ := fun k omega =>
    omega (edge + 1 + (k : ℤ)) z - omega (edge + 1 + (k : ℤ)) (z + off) with hFdef
  set c : ℕ → ℝ := fun k =>
    (2 / 3 : ℝ) * (‖sh‖ + 1) * (3 : ℝ) ^ (-(edge + 1 + (k : ℤ) + n)) with hcdef
  have hcpos : ∀ k, 0 < c k := fun k => by rw [hcdef]; positivity
  have hc1 : ∀ k, c k ≤ 1 := by
    intro k
    rw [hcdef]
    have hmono : (3 : ℝ) ^ (-(edge + 1 + (k : ℤ) + n)) ≤ (3 : ℝ) ^ (-(edge + n + 1)) := by
      apply zpow_le_zpow_right₀ (by norm_num : (1 : ℝ) ≤ 3)
      omega
    have hbase : (2 / 3 : ℝ) * (‖sh‖ + 1) * (3 : ℝ) ^ (-(edge + n + 1)) ≤ 1 := by
      have hzpoweq : (3 : ℝ) ^ (-(edge + n + 1)) = 1 / (3 : ℝ) ^ (edge + n + 1) := by
        rw [_root_.zpow_neg, one_div]
      rw [hzpoweq, mul_one_div, div_le_one (by positivity : (0:ℝ) < (3:ℝ) ^ (edge + n + 1))]
      exact hedge
    calc (2 / 3 : ℝ) * (‖sh‖ + 1) * (3 : ℝ) ^ (-(edge + 1 + (k : ℤ) + n))
        ≤ (2 / 3 : ℝ) * (‖sh‖ + 1) * (3 : ℝ) ^ (-(edge + n + 1)) := by
          apply mul_le_mul_of_nonneg_left hmono (by positivity)
      _ ≤ 1 := hbase
  have hδ : ∀ k : ℕ, ‖((3 : ℝ) ^ (-(edge + 1 + (k : ℤ)))) • off‖ ≤ (3 / 2 : ℝ) * c k := by
    intro k
    have hrw : ((3 : ℝ) ^ (-(edge + 1 + (k : ℤ)))) • off =
        ((3 : ℝ) ^ (-(edge + 1 + (k : ℤ) + n))) • sh := by
      rw [hoffdef, smul_smul, ← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]
      congr 2
      ring
    rw [hrw, hcdef, norm_smul, Real.norm_eq_abs,
      abs_of_pos (by positivity : (0:ℝ) < (3:ℝ) ^ (-(edge + 1 + (k : ℤ) + n)))]
    nlinarith [norm_nonneg sh,
      (by positivity : (0:ℝ) < (3:ℝ) ^ (-(edge + 1 + (k : ℤ) + n)))]
  set a : ℕ → ℝ := fun k => (m : ℝ) * M.delta * (‖sh‖ + 1) *
      (3 : ℝ) ^ (-(edge + 1 + (k : ℤ) + n)) with hadef
  have hbound : ∀ k, (∫⁻ omega, ENNReal.ofReal (Real.exp ((‖F k omega‖ / a k) ^ 2)) ∂μ) ≤ 2 := by
    intro k
    have hb := hlp M (edge + 1 + (k : ℤ)) z off (c k) (hcpos k) (hc1 k) (hδ k)
    have heq : c k * (3 / 2 : ℝ) * ((m : ℝ) * M.delta) = a k := by
      rw [hcdef, hadef]; ring
    have hFeq : ∀ omega, ‖F k omega‖ = |omega (edge + 1 + (k:ℤ)) z - omega (edge + 1 + (k:ℤ)) (z + off)| := by
      intro omega
      rw [hFdef]
      exact Real.norm_eq_abs _
    simp_rw [hFeq]
    rwa [heq] at hb
  have hapos : ∀ k, 0 < a k := fun k => by
    have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
    rw [hadef]; positivity
  have hzpow : ∀ k : ℕ, (3 : ℝ) ^ (-(edge + 1 + (k : ℤ) + n)) =
      (3 : ℝ) ^ (-(edge + n + 1)) * (1 / 3 : ℝ) ^ k := by
    intro k
    have h1 : (1 / 3 : ℝ) ^ k = (3 : ℝ) ^ (-(k : ℤ)) := by
      rw [_root_.zpow_neg, zpow_natCast, one_div, inv_pow]
    rw [h1, ← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]
    congr 1; ring
  have hsuma : Summable a := by
    have heq2 : a = fun k => ((m:ℝ)*M.delta*(‖sh‖+1)*(3:ℝ)^(-(edge+n+1))) * (1/3:ℝ)^k := by
      funext k; rw [hadef]; dsimp only; rw [hzpow k]; ring
    rw [heq2]
    exact (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left _
  have hFmeas : ∀ k, AEStronglyMeasurable (F k) μ := by
    intro k
    have hz : Continuous (fun omega : BilateralField d => omega (edge+1+(k:ℤ)) z) :=
      (continuous_eval_const z).comp (continuous_apply (edge+1+(k:ℤ)))
    have hzoff : Continuous (fun omega : BilateralField d => omega (edge+1+(k:ℤ)) (z+off)) :=
      (continuous_eval_const (z+off)).comp (continuous_apply (edge+1+(k:ℤ)))
    exact (hz.sub hzoff).aestronglyMeasurable
  have hck0 : ∀ k : ℕ, c k = c 0 * (1 / 3 : ℝ) ^ k := by
    intro k
    rw [hcdef]
    dsimp only
    rw [show (-(edge + 1 + (k : ℤ) + n)) = (-(edge + 1 + (0 : ℤ) + n)) + (-(k : ℤ)) by ring,
      zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0),
      show (3 : ℝ) ^ (-(k : ℤ)) = (1 / 3 : ℝ) ^ k by
        rw [_root_.zpow_neg, zpow_natCast, one_div, inv_pow]]
    ring
  have hsumF : ∀ᵐ omega ∂μ, Summable (fun k => ‖F k omega‖) := by
    obtain ⟨m', hm', C0', hC0', hlp'⟩ := aux_lem_band_piece_coords_K7_tail_pos_layer_lp (d := d)
    set B2 : ℝ := C0' * (c 0 * (3 / 2 : ℝ) * ((m' : ℝ) * M.delta)) * Real.sqrt 2 with hB2def
    have hB2 : 0 ≤ B2 := by
      have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
      rw [hB2def]; positivity
    have h2eq : (2 : ℝ≥0∞) = ENNReal.ofReal (2 : ℝ) := by norm_num
    have hF2mem : ∀ k, MemLp (F k) (2 : ℝ≥0∞) μ := by
      intro k
      rw [h2eq]
      simp only [hFdef]
      have hbb := hlp' M (edge + 1 + (k : ℤ)) z off (c k) (hcpos k) (hc1 k) (hδ k) 2 (by norm_num)
      exact lt_of_le_of_lt hbb ENNReal.ofReal_lt_top
    have hF2bound : ∀ k, eLpNorm (F k) (2 : ℝ≥0∞) μ ≤
        ENNReal.ofReal (B2 * (1 / 3 : ℝ) ^ k) := by
      intro k
      rw [h2eq]
      simp only [hFdef]
      have hbb := hlp' M (edge + 1 + (k : ℤ)) z off (c k) (hcpos k) (hc1 k) (hδ k) 2 (by norm_num)
      refine hbb.trans (ENNReal.ofReal_le_ofReal ?_)
      rw [hB2def, hck0 k]
      exact le_of_eq (by ring)
    obtain ⟨hae, -⟩ := memLp_geometric_tsum_tails μ (by norm_num : (1:ℝ≥0∞) ≤ 2)
      (by norm_num : (2:ℝ≥0∞) ≠ ⊤) F hF2mem hB2
      (by norm_num : (0:ℝ) ≤ (1/3:ℝ)) (by norm_num : (1/3:ℝ) < 1) hF2bound
    exact hae
  have hmain := lintegral_exp_sq_norm_tsum_le μ F hFmeas a hapos hsuma hsumF hbound
  have hσ : (∑' k : ℕ, a k) = (1/2:ℝ)*(m:ℝ)*M.delta*(‖sh‖+1)*(3:ℝ)^(-(edge+n)) := by
    have heq2 : a = fun k => ((m:ℝ)*M.delta*(‖sh‖+1)*(3:ℝ)^(-(edge+n+1))) * (1/3:ℝ)^k := by
      funext k; rw [hadef]; dsimp only; rw [hzpow k]; ring
    rw [heq2, tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    have hsplit : (3 : ℝ) ^ (-(edge + n + 1)) = (3 : ℝ) ^ (-(edge+n)) * (1/3:ℝ) := by
      rw [show (1/3:ℝ) = (3:ℝ)^(-1:ℤ) by rw [_root_.zpow_neg_one]; norm_num,
        ← zpow_add₀ (by norm_num : (3:ℝ) ≠ 0)]
      congr 1; ring
    rw [hsplit]; ring
  rw [hσ] at hmain
  exact hmain

theorem aux_lem_band_piece_coords_K7_tail_w0
    {d : ℕ} (off : ℤ) (sh : SpatialCoordinates d) :
    ∃ w0 : ℕ, 0 < w0 ∧ |off| < (w0 : ℤ) ∧
      ∀ h : ℕ, 1 ≤ h →
        (2 / 3 : ℝ) * (‖sh‖ + 1) ≤ (3 : ℝ) ^ ((w0 : ℤ) * ((h : ℤ) + 1) + 1) := by
  obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ((2 / 3 : ℝ) * (‖sh‖ + 1)) (by norm_num : (1 : ℝ) < 3)
  set w0 : ℕ := max (k + 1) (off.natAbs + 1) with hw0def
  have hwk : k ≤ w0 := le_trans (Nat.le_succ k) (le_max_left _ _)
  have hwoff : off.natAbs + 1 ≤ w0 := le_max_right _ _
  refine ⟨w0, lt_of_lt_of_le (Nat.succ_pos k) (le_max_left _ _), ?_, ?_⟩
  · have h2 : |off| = (off.natAbs : ℤ) := Int.abs_eq_natAbs off
    rw [h2]
    have hcast : (off.natAbs : ℤ) + 1 ≤ (w0 : ℤ) := by exact_mod_cast hwoff
    omega
  · intro h hh
    have hexp : w0 ≤ 2 * w0 + 1 := by omega
    have hpow1 : (3 : ℝ) ^ w0 ≤ (3 : ℝ) ^ (2 * w0 + 1) :=
      pow_le_pow_right₀ (by norm_num) hexp
    have hexp2 : (2 * w0 + 1 : ℤ) ≤ (w0 : ℤ) * ((h : ℤ) + 1) + 1 := by
      have h1 : (1 : ℤ) ≤ (h : ℤ) := by exact_mod_cast hh
      nlinarith
    have hpow2 : (3 : ℝ) ^ (2 * w0 + 1) ≤ (3 : ℝ) ^ ((w0 : ℤ) * ((h : ℤ) + 1) + 1) := by
      have heq : (3 : ℝ) ^ (2 * w0 + 1) = (3 : ℝ) ^ ((2 * w0 + 1 : ℕ) : ℤ) := by
        rw [zpow_natCast]
      rw [heq]
      exact zpow_le_zpow_right₀ (by norm_num) hexp2
    calc (2 / 3 : ℝ) * (‖sh‖ + 1) ≤ (3 : ℝ) ^ k := hk.le
      _ ≤ (3 : ℝ) ^ w0 := pow_le_pow_right₀ (by norm_num) hwk
      _ ≤ (3 : ℝ) ^ (2 * w0 + 1) := hpow1
      _ ≤ (3 : ℝ) ^ ((w0 : ℤ) * ((h : ℤ) + 1) + 1) := hpow2

theorem aux_lem_band_K7_pos_tail_summable
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (z off : SpatialCoordinates d) (κ : ℕ)
    (hκ : (2 / 3 : ℝ) * (‖off‖ + 1) ≤ (3 : ℝ) ^ (κ + 1 : ℕ)) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Summable (fun k : ℕ => ‖omega ((κ : ℤ) + 1 + k) z - omega ((κ : ℤ) + 1 + k) (z + off)‖) := by
  obtain ⟨m, hm, C0, hC0, hlp⟩ := aux_lem_band_piece_coords_K7_tail_pos_layer_lp (d := d)
  let p : ℝ := 2
  have hp : 1 ≤ p := by norm_num [p]
  set μ : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure with hμdef
  set F : ℕ → BilateralField d → ℝ := fun k omega =>
    omega ((κ : ℤ) + 1 + k) z - omega ((κ : ℤ) + 1 + k) (z + off) with hFdef
  set c : ℕ → ℝ := fun k => (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1 + k)) with hcdef
  have hcpos : ∀ k, 0 < c k := fun k => by
    rw [hcdef]; positivity
  have hc1 : ∀ k, c k ≤ 1 := by
    intro k
    rw [hcdef]
    have hmono : (3 : ℝ) ^ (-((κ : ℤ) + 1 + k)) ≤ (3 : ℝ) ^ (-((κ : ℤ) + 1)) := by
      apply zpow_le_zpow_right₀ (by norm_num : (1:ℝ) ≤ 3)
      omega
    have hbase : (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1)) ≤ 1 := by
      have hzpoweq : (3 : ℝ) ^ (-((κ : ℤ) + 1)) = 1 / (3 : ℝ) ^ (κ + 1 : ℕ) := by
        rw [show (-(((κ : ℤ) + 1))) = -((κ + 1 : ℕ) : ℤ) by push_cast; ring, _root_.zpow_neg,
          zpow_natCast, one_div]
      rw [hzpoweq, mul_one_div, div_le_one (by positivity : (0:ℝ) < (3:ℝ) ^ (κ + 1 : ℕ))]
      exact hκ
    calc (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1 + k))
        ≤ (2 / 3 : ℝ) * (‖off‖ + 1) * (3 : ℝ) ^ (-((κ : ℤ) + 1)) := by
          apply mul_le_mul_of_nonneg_left hmono (by positivity)
      _ ≤ 1 := hbase
  have hδ : ∀ k, ‖((3 : ℝ) ^ (-((κ : ℤ) + 1 + (k : ℕ)))) • off‖ ≤ (3 / 2 : ℝ) * c k := by
    intro k
    rw [hcdef, norm_smul, Real.norm_eq_abs,
      abs_of_pos (by positivity : (0:ℝ) < (3:ℝ) ^ (-((κ:ℤ)+1+(k:ℕ))))]
    nlinarith [norm_nonneg off, (by positivity : (0:ℝ) < (3:ℝ) ^ (-((κ:ℤ)+1+(k:ℕ))))]
  set B : ℝ := C0 * ((‖off‖ + 1) * (m : ℝ) * M.delta) * Real.sqrt p *
      (3 : ℝ) ^ (-((κ : ℤ) + 1)) with hBdef
  have hBnonneg : 0 ≤ B := by
    have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
    rw [hBdef]; positivity
  have hzpow : ∀ k : ℕ, (3 : ℝ) ^ (-((κ : ℤ) + 1 + (k : ℕ))) =
      (3 : ℝ) ^ (-((κ : ℤ) + 1)) * (1 / 3 : ℝ) ^ k := by
    intro k
    have h1 : (1 / 3 : ℝ) ^ k = (3 : ℝ) ^ (-(k : ℤ)) := by
      rw [_root_.zpow_neg, zpow_natCast, one_div, inv_pow]
    rw [h1, ← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]
    congr 1
    ring
  have hbound : ∀ k, eLpNorm (F k) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (B * (1 / 3 : ℝ) ^ k) := by
    intro k
    have hb := hlp M ((κ : ℤ) + 1 + (k : ℕ)) z off (c k) (hcpos k) (hc1 k) (hδ k) p hp
    have heq : C0 * (c k * (3 / 2 : ℝ) * ((m : ℝ) * M.delta)) * Real.sqrt p =
        B * (1 / 3 : ℝ) ^ k := by
      rw [hcdef]
      dsimp only
      rw [hzpow k, hBdef]
      ring
    rwa [heq] at hb
  have hFmeas : ∀ k, Measurable (F k) := by
    intro k
    have hz : Continuous (fun omega : BilateralField d => omega ((κ : ℤ) + 1 + (k:ℕ)) z) :=
      (continuous_eval_const z).comp (continuous_apply ((κ : ℤ) + 1 + (k:ℕ)))
    have hzoff : Continuous
        (fun omega : BilateralField d => omega ((κ : ℤ) + 1 + (k:ℕ)) (z + off)) :=
      (continuous_eval_const (z + off)).comp (continuous_apply ((κ : ℤ) + 1 + (k:ℕ)))
    exact (hz.sub hzoff).measurable
  have hFmem : ∀ k, MemLp (F k) (ENNReal.ofReal p) μ :=
    fun k => (hbound k).trans_lt ENNReal.ofReal_lt_top
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [show (1:ℝ≥0∞) = ENNReal.ofReal 1 by simp]
    exact ENNReal.ofReal_le_ofReal hp
  exact ( memLp_geometric_tsum_tails μ hp1 ENNReal.ofReal_ne_top
    F hFmem hBnonneg (by norm_num : (0:ℝ) ≤ (1/3:ℝ)) (by norm_num : (1/3:ℝ) < 1) hbound).1

theorem aux_lem_band_retained_Ico {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ)
    (hretained : retained = fun k y omega =>
      if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
      else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y)
    (k l : ℤ) (hkl : k ≤ l) (y : SpatialCoordinates d) (omega : BilateralField d) :
    retained l y omega - retained k y omega = ∑ j ∈ Finset.Ico k l, omega (-j) y := by
  simp only [hretained]
  by_cases hk : 0 ≤ k
  · by_cases hl : 0 ≤ l
    · rw [ite_eq_left hk, ite_eq_left hl]
      have h := Finset.sum_union (s₁ := Finset.Ico (0:ℤ) k) (s₂ := Finset.Ico k l)
        (f := fun j => omega (-j) y) (Finset.Ico_disjoint_Ico_consecutive (0:ℤ) k l)
      rw [Finset.Ico_union_Ico_eq_Ico hk hkl] at h
      linarith
    · rw [ite_eq_left hk, ite_eq_right hl]
      linarith
  · by_cases hl : 0 ≤ l
    · rw [ite_eq_right hk, ite_eq_left hl]
      have hk0 : k ≤ 0 := le_of_lt (not_le.mp hk)
      have h := Finset.sum_union (s₁ := Finset.Ico k 0) (s₂ := Finset.Ico (0:ℤ) l)
        (f := fun j => omega (-j) y) (Finset.Ico_disjoint_Ico_consecutive k 0 l)
      rw [Finset.Ico_union_Ico_eq_Ico hk0 hl] at h
      linarith
    · rw [ite_eq_right hk, ite_eq_right hl]
      have hl0 : l ≤ 0 := le_of_lt (not_le.mp hl)
      have h := Finset.sum_union (s₁ := Finset.Ico k l) (s₂ := Finset.Ico l 0)
        (f := fun j => omega (-j) y) (Finset.Ico_disjoint_Ico_consecutive k l 0)
      rw [Finset.Ico_union_Ico_eq_Ico hkl hl0] at h
      linarith

theorem aux_lem_band_K7_window_tendsto_nonneg {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (hH : InfraredCharacterization M H) (z w : SpatialCoordinates d) (c : ℕ) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Tendsto (fun L : ℕ => ∑ n ∈ Finset.range L,
          (omega ((n : ℤ) + (c : ℤ) + 1) z - omega ((n : ℤ) + (c : ℤ) + 1) w)) atTop
        (𝓝 ((H omega) z - (H omega) w -
          ∑ n ∈ Finset.range c, (omega ((n : ℤ) + 1) z - omega ((n : ℤ) + 1) w))) := by
  filter_upwards [hH.2] with omega homega
  have hconv : Tendsto
      (fun L : ℕ => ∑ n ∈ Finset.range L,
        (omega ((n : ℤ) + 1) z - omega ((n : ℤ) + 1) w))
      atTop (𝓝 ((H omega) z - (H omega) w)) := by
    have hz : Tendsto (fun L : ℕ => (infraredPartialSum omega L) z) atTop (𝓝 ((H omega) z)) :=
      ((continuous_eval_const (F := C(SpatialCoordinates d, ℝ)) z).tendsto (H omega)).comp homega
    have hw : Tendsto (fun L : ℕ => (infraredPartialSum omega L) w) atTop (𝓝 ((H omega) w)) :=
      ((continuous_eval_const (F := C(SpatialCoordinates d, ℝ)) w).tendsto (H omega)).comp homega
    refine Tendsto.congr' ?_ (Tendsto.sub hz hw)
    filter_upwards with L
    simp only [infraredPartialSum, ContinuousMap.sum_apply, ContinuousMap.const_apply,
      ContinuousMap.sub_apply, Finset.sum_sub_distrib, Int.ofNat_eq_natCast, Nat.cast_add,
      Nat.cast_one]
    ring
  have key : ∀ (f : ℤ → ℝ) (a : ℝ) (e : ℕ),
      Tendsto (fun L : ℕ => ∑ n ∈ Finset.range L, f ((n : ℤ) + 1)) atTop (𝓝 a) →
      Tendsto (fun L : ℕ => ∑ n ∈ Finset.range L, f ((n : ℤ) + (e : ℤ) + 1)) atTop
        (𝓝 (a - ∑ n ∈ Finset.range e, f ((n : ℤ) + 1))) := by
    intro f a e hf
    have hsplit : ∀ L : ℕ, (∑ n ∈ Finset.range (L + e), f ((n : ℤ) + 1))
        = (∑ n ∈ Finset.range e, f ((n : ℤ) + 1))
          + ∑ n ∈ Finset.range L, f ((n : ℤ) + (e : ℤ) + 1) := by
      intro L
      rw [show L + e = e + L from Nat.add_comm L e, Finset.sum_range_add]
      congr 1
      apply Finset.sum_congr rfl
      intro x _
      congr 1
      push_cast
      ring
    have h1 : Tendsto (fun L : ℕ => ∑ n ∈ Finset.range (L + e), f ((n : ℤ) + 1))
        atTop (𝓝 a) :=
      hf.comp (tendsto_add_atTop_nat e)
    have hfin := h1.sub_const (∑ n ∈ Finset.range e, f ((n : ℤ) + 1))
    refine Tendsto.congr' ?_ hfin
    filter_upwards with L
    rw [hsplit L]
    abel
  exact key (fun j => omega j z - omega j w) ((H omega) z - (H omega) w) c hconv

theorem aux_lem_band_K7_window_tendsto_nonpos {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (hH : InfraredCharacterization M H) (z w : SpatialCoordinates d) (c : ℕ) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Tendsto (fun L : ℕ => ∑ n ∈ Finset.range L,
          (omega ((n : ℤ) + 1 - (c : ℤ)) z - omega ((n : ℤ) + 1 - (c : ℤ)) w)) atTop
        (𝓝 ((H omega) z - (H omega) w +
          ∑ n ∈ Finset.range c, (omega (-(n : ℤ)) z - omega (-(n : ℤ)) w))) := by
  filter_upwards [hH.2] with omega homega
  have key : ∀ (f : ℤ → ℝ) (a : ℝ) (e : ℕ),
      Tendsto (fun L : ℕ => ∑ n ∈ Finset.range L, f (Int.ofNat (n + 1))) atTop (𝓝 a) →
      Tendsto (fun L : ℕ => ∑ n ∈ Finset.range L, f ((n : ℤ) + 1 - (e : ℤ))) atTop
        (𝓝 (a + ∑ n ∈ Finset.range e, f (-(n : ℤ)))) := by
    intro f a e hf
    have h1 : (∑ x ∈ Finset.range e, f ((x : ℤ) + 1 - (e : ℤ)))
        = ∑ n ∈ Finset.range e, f (-(n : ℤ)) := by
      rw [← Finset.sum_range_reflect (fun n : ℕ => f (-(n : ℤ))) e]
      apply Finset.sum_congr rfl
      intro x hx
      rw [Finset.mem_range] at hx
      congr 1
      have hxe : x ≤ e - 1 := Nat.le_sub_one_of_lt hx
      have he1 : 1 ≤ e := by omega
      rw [Nat.cast_sub hxe, Nat.cast_sub he1]
      ring
    have h2 : ∀ m : ℕ, (∑ x ∈ Finset.range m, f (((e + x : ℕ) : ℤ) + 1 - (e : ℤ)))
        = ∑ n ∈ Finset.range m, f (Int.ofNat (n + 1)) := by
      intro m
      apply Finset.sum_congr rfl
      intro x _
      congr 1
      simp only [Int.ofNat_eq_natCast, Nat.cast_add, Nat.cast_one]
      ring
    have hshift : Tendsto (fun L : ℕ => ∑ n ∈ Finset.range (L - e), f (Int.ofNat (n + 1)))
        atTop (𝓝 a) := hf.comp (tendsto_sub_atTop_nat e)
    have hS : Tendsto (fun L : ℕ => (∑ n ∈ Finset.range (L - e), f (Int.ofNat (n + 1)))
        + ∑ n ∈ Finset.range e, f (-(n : ℤ))) atTop
        (𝓝 (a + ∑ n ∈ Finset.range e, f (-(n : ℤ)))) := hshift.add_const _
    refine Tendsto.congr' ?_ hS
    filter_upwards [Filter.eventually_ge_atTop e] with L hL
    have hsplit : (∑ n ∈ Finset.range L, f ((n : ℤ) + 1 - (e : ℤ)))
        = (∑ x ∈ Finset.range e, f ((x : ℤ) + 1 - (e : ℤ)))
          + ∑ x ∈ Finset.range (L - e), f (((e + x : ℕ) : ℤ) + 1 - (e : ℤ)) := by
      conv_lhs => rw [← Nat.add_sub_of_le hL]
      rw [Finset.sum_range_add]
    rw [hsplit, h1, h2 (L - e), add_comm]
  have hconv : Tendsto
      (fun L : ℕ => ∑ n ∈ Finset.range L,
        (omega (Int.ofNat (n + 1)) z - omega (Int.ofNat (n + 1)) w))
      atTop (𝓝 ((H omega) z - (H omega) w)) := by
    have hz : Tendsto (fun L : ℕ => (infraredPartialSum omega L) z) atTop (𝓝 ((H omega) z)) :=
      ((continuous_eval_const (F := C(SpatialCoordinates d, ℝ)) z).tendsto (H omega)).comp homega
    have hw : Tendsto (fun L : ℕ => (infraredPartialSum omega L) w) atTop (𝓝 ((H omega) w)) :=
      ((continuous_eval_const (F := C(SpatialCoordinates d, ℝ)) w).tendsto (H omega)).comp homega
    refine Tendsto.congr' ?_ (Tendsto.sub hz hw)
    filter_upwards with L
    simp only [infraredPartialSum, ContinuousMap.sum_apply, ContinuousMap.const_apply,
      ContinuousMap.sub_apply, Finset.sum_sub_distrib]
    ring
  exact key (fun j => omega j z - omega j w) ((H omega) z - (H omega) w) c hconv

lemma aux_lem_band_K7_tail_summable
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (z w : SpatialCoordinates d) (edge : ℤ) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Summable (fun k : ℕ => omega (edge + 1 + k) z - omega (edge + 1 + k) w) := by
  obtain ⟨b, hb⟩ := pow_unbounded_of_one_lt ((2 / 3 : ℝ) * (‖w - z‖ + 1))
    (by norm_num : (1 : ℝ) < 3)
  let κ := max b edge.toNat
  have hκ : (2 / 3 : ℝ) * (‖w - z‖ + 1) ≤ (3 : ℝ) ^ (κ + 1) :=
    hb.le.trans (pow_le_pow_right₀ (by norm_num) (by dsimp [κ]; omega))
  have heκ : edge ≤ (κ : ℤ) := by
    have : edge ≤ (edge.toNat : ℤ) := Int.self_le_toNat edge
    have : edge.toNat ≤ κ := le_max_right _ _
    omega
  let shift := ((κ : ℤ) - edge).toNat
  have hshift : (shift : ℤ) = (κ : ℤ) - edge := Int.toNat_of_nonneg (by omega)
  filter_upwards [aux_lem_band_K7_pos_tail_summable M z (w - z) κ hκ] with omega homega
  apply (summable_nat_add_iff shift).mp
  have hterm : (fun k : ℕ => omega (edge + 1 + (k + shift : ℕ)) z -
      omega (edge + 1 + (k + shift : ℕ)) w) =
      (fun k : ℕ => omega ((κ : ℤ) + 1 + k) z - omega ((κ : ℤ) + 1 + k) (z + (w - z))) := by
    funext k
    have hi : edge + 1 + ((k + shift : ℕ) : ℤ) = (κ : ℤ) + 1 + k := by
      push_cast
      rw [hshift]
      ring
    rw [hi, add_sub_cancel]
  rw [hterm]
  exact homega.of_norm

lemma aux_lem_band_K7_ret_nat (f : ℤ → ℝ) (e : ℕ) :
    (if 0 ≤ (e : ℤ) then ∑ j ∈ Finset.Ico (0 : ℤ) e, f (-j)
      else -∑ j ∈ Finset.Ico (e : ℤ) 0, f (-j)) =
        ∑ k ∈ Finset.range e, f (-(k : ℤ)) := by
  rw [ite_eq_left (Int.natCast_nonneg e)]
  refine Finset.sum_nbij' (fun j : ℤ => j.toNat) (fun k : ℕ => (k : ℤ)) ?_ ?_ ?_ ?_ ?_
  · intro j hj
    simp only [Finset.mem_Ico, Finset.mem_range] at *
    omega
  · intro k hk
    simp only [Finset.mem_Ico, Finset.mem_range] at *
    omega
  · intro j hj
    simp only [Finset.mem_Ico] at hj
    exact Int.toNat_of_nonneg hj.1
  · intro k hk
    exact Int.toNat_natCast k
  · intro j hj
    simp only [Finset.mem_Ico] at hj
    rw [Int.toNat_of_nonneg hj.1]

lemma aux_lem_band_K7_ret_neg_nat (f : ℤ → ℝ) (e : ℕ) :
    (if 0 ≤ -(e : ℤ) then ∑ j ∈ Finset.Ico (0 : ℤ) (-e), f (-j)
      else -∑ j ∈ Finset.Ico (-(e : ℤ)) 0, f (-j)) =
        -∑ k ∈ Finset.range e, f ((k : ℤ) + 1) := by
  by_cases he : e = 0
  · subst e
    simp
  rw [ite_eq_right (by omega)]
  congr 1
  refine Finset.sum_nbij' (fun j : ℤ => (-j - 1).toNat)
    (fun k : ℕ => -((k : ℤ) + 1)) ?_ ?_ ?_ ?_ ?_
  · intro j hj
    simp only [Finset.mem_Ico, Finset.mem_range] at *
    omega
  · intro k hk
    simp only [Finset.mem_Ico, Finset.mem_range] at *
    omega
  · intro j hj
    simp only [Finset.mem_Ico] at hj
    omega
  · intro k hk
    omega
  · intro j hj
    simp only [Finset.mem_Ico] at hj
    congr 1
    omega

lemma aux_lem_band_K7_tail_eq
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (z w : SpatialCoordinates d) (edge : ℤ)
    (retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ)
    (hretained : retained = fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
      else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      (∑' k : ℕ, (omega (edge + 1 + k) z - omega (edge + 1 + k) w)) =
        H omega z - H omega w + retained (-edge) z omega - retained (-edge) w omega := by
  by_cases he : 0 ≤ edge
  · let c := edge.toNat
    have hc : (c : ℤ) = edge := Int.toNat_of_nonneg he
    filter_upwards [aux_lem_band_K7_window_tendsto_nonneg M H hH z w c,
      aux_lem_band_K7_tail_summable M z w edge] with omega hlim hsum
    have hf : (fun k : ℕ => omega (edge + 1 + k) z - omega (edge + 1 + k) w) =
        (fun k : ℕ => omega ((k : ℤ) + c + 1) z - omega ((k : ℤ) + c + 1) w) := by
      funext k
      rw [hc]
      congr 2 <;> ring
    have ht := hsum.hasSum.tendsto_sum_nat
    rw [hf] at ht
    have hv := tendsto_nhds_unique ht hlim
    rw [hf, hv, ← hc, hretained]
    dsimp only
    rw [aux_lem_band_K7_ret_neg_nat (fun j => omega j z),
      aux_lem_band_K7_ret_neg_nat (fun j => omega j w), Finset.sum_sub_distrib]
    ring
  · let c := (-edge).toNat
    have hc : (c : ℤ) = -edge := Int.toNat_of_nonneg (by omega)
    filter_upwards [aux_lem_band_K7_window_tendsto_nonpos M H hH z w c,
      aux_lem_band_K7_tail_summable M z w edge] with omega hlim hsum
    have hf : (fun k : ℕ => omega (edge + 1 + k) z - omega (edge + 1 + k) w) =
        (fun k : ℕ => omega ((k : ℤ) + 1 - c) z - omega ((k : ℤ) + 1 - c) w) := by
      funext k
      rw [hc]
      congr 2 <;> ring
    have ht := hsum.hasSum.tendsto_sum_nat
    rw [hf] at ht
    have hv := tendsto_nhds_unique ht hlim
    rw [hf, hv, ← hc, hretained]
    dsimp only
    rw [aux_lem_band_K7_ret_nat (fun j => omega j z),
      aux_lem_band_K7_ret_nat (fun j => omega j w), Finset.sum_sub_distrib]
    ring

theorem aux_lem_band_piece_coords_K7_tail_split
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (off n : ℤ) (z sh : SpatialCoordinates d)
    (m : ℤ) (hm : m = n + off)
    (w : SpatialCoordinates d) (_hw : w = z + ((3 : ℝ) ^ (-n)) • sh)
    (retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ)
    (hretained : retained = fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
      else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y)
    (w0 : ℕ) (hw0pos : 0 < w0) (hw0off : |off| < (w0 : ℤ))
    (h : ℕ) (_hh : 1 ≤ h) :
    ∃ Yband : BilateralField d → ℝ,
      AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) =>
            omega (j : ℤ))
        inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
      ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        Real.exp (H omega z + retained n z omega - (H omega w + retained m w omega)) =
          Yband omega * Real.exp (∑' k : ℕ,
            (omega ((-n + (w0 * (h + 1) : ℕ)) + 1 + (k : ℤ)) z -
              omega ((-n + (w0 * (h + 1) : ℕ)) + 1 + (k : ℤ)) w))  := by
  classical
  let W : ℤ := (w0 * (h + 1) : ℕ)
  let edge : ℤ := -n + W
  have hwle : (w0 : ℤ) ≤ W := by
    dsimp [W]
    have : (0 : ℤ) ≤ h := Int.natCast_nonneg h
    nlinarith [Int.natCast_nonneg w0]
  have hWpos : 0 < W := lt_of_lt_of_le (by exact_mod_cast hw0pos) hwle
  have hWoff : |off| < W := hw0off.trans_le hwle
  have hn : -edge ≤ n := by dsimp [edge]; omega
  have hm' : -edge ≤ m := by
    have := neg_abs_le off
    dsimp [edge]
    omega
  have hmupper : m ≤ n + W := by
    have := le_abs_self off
    omega
  let proj : BilateralField d → (Set.Icc (-n - W) (-n + W) → C(SpatialCoordinates d, ℝ)) :=
    fun omega j => omega (j : ℤ)
  let mB := MeasurableSpace.comap proj inferInstance
  have hproj : Measurable[mB] proj := Measurable.of_comap_le le_rfl
  have hsm (k : ℤ) (y : SpatialCoordinates d) (hk : k ≤ n + W) :
      Measurable[mB] (fun omega : BilateralField d =>
        ∑ j ∈ Finset.Ico (-edge) k, omega (-j) y) := by
    refine Finset.measurable_sum _ fun j hj => ?_
    have hj' : -j ∈ Set.Icc (-n - W) (-n + W) := by
      simp only [Finset.mem_Ico] at hj
      dsimp [edge] at hj
      constructor <;> omega
    exact (continuous_eval_const y).measurable.comp
      ((measurable_pi_apply (⟨-j, hj'⟩ : Set.Icc (-n - W) (-n + W))).comp hproj)
  refine ⟨fun omega => Real.exp ((∑ j ∈ Finset.Ico (-edge) n, omega (-j) z) -
      ∑ j ∈ Finset.Ico (-edge) m, omega (-j) w),
    ((hsm n z (by omega)).sub (hsm m w hmupper)).exp.aestronglyMeasurable, ?_⟩
  filter_upwards [aux_lem_band_K7_tail_eq M H hH z w edge retained hretained] with omega htail
  have hn' := aux_lem_band_retained_Ico retained hretained (-edge) n hn z omega
  have hm'' := aux_lem_band_retained_Ico retained hretained (-edge) m hm' w omega
  rw [htail, ← Real.exp_add]
  congr 1
  linarith

lemma aux_lem_band_K7_root_point_exp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (z : SpatialCoordinates d) :
    (∫⁻ f, ENNReal.ofReal (Real.exp ((|f z| / M.delta) ^ 2))
      ∂(chaosRootFieldLaw M).toMeasure) ≤ 2 := by
  let F : C(SpatialCoordinates d, ℝ) → ENNReal :=
    fun f => ENNReal.ofReal (Real.exp ((|f 0| / M.delta) ^ 2))
  have hFm : Measurable F := by
    have hv : Measurable (fun f : C(SpatialCoordinates d, ℝ) => f 0) :=
      (continuous_eval_const 0).measurable
    simpa only [F, Real.norm_eq_abs] using
      (((hv.norm.div_const M.delta).pow_const 2).exp).ennreal_ofReal
  have hzero : (∫⁻ f, F f ∂(chaosRootFieldLaw M).toMeasure) ≤ 2 := by
    let forget : C(_root_.SubdiffusiveProcess.Model.PotentialField d, C(SpatialCoordinates d, ℝ)) :=
      ⟨fun g => g.1.1, continuous_subtype_val.fst⟩
    change (∫⁻ f, F f ∂Measure.map forget (_root_.SubdiffusiveProcess.Model.zeroPotentialLaw M.P).toMeasure) ≤ 2
    rw [lintegral_map hFm forget.continuous.measurable]
    have h := ogammaLE_abs_zeroPotential_at_zero M
    have hInt : Integrable (fun g : _root_.SubdiffusiveProcess.Model.PotentialField d =>
        Real.exp ((|g 0| / M.delta) ^ (2 : ℕ)))
        (_root_.SubdiffusiveProcess.Model.zeroPotentialLaw M.P).toMeasure := by
      simpa only [SubdiffusiveProcess.OGammaLE, max_eq_left (abs_nonneg (_ : ℝ)),
        Real.rpow_two, div_eq_mul_inv, mul_comm] using h.1
    have hbound : (∫ g : _root_.SubdiffusiveProcess.Model.PotentialField d,
        Real.exp ((|g 0| / M.delta) ^ (2 : ℕ))
        ∂(_root_.SubdiffusiveProcess.Model.zeroPotentialLaw M.P).toMeasure) ≤ 2 := by
      simpa only [SubdiffusiveProcess.OGammaLE, max_eq_left (abs_nonneg (_ : ℝ)),
        Real.rpow_two, div_eq_mul_inv, mul_comm] using h.2
    have hl := ofReal_integral_eq_lintegral_ofReal hInt
      (ae_of_all _ fun _ => (Real.exp_pos _).le)
    change (∫⁻ g : _root_.SubdiffusiveProcess.Model.PotentialField d,
        ENNReal.ofReal (Real.exp ((|g 0| / M.delta) ^ (2 : ℕ)))
        ∂(_root_.SubdiffusiveProcess.Model.zeroPotentialLaw M.P).toMeasure) ≤ 2
    rw [← hl]
    exact_mod_cast ENNReal.ofReal_le_ofReal hbound
  let translate : C(C(SpatialCoordinates d, ℝ), C(SpatialCoordinates d, ℝ)) :=
    ContinuousMap.compRightContinuousMap ℝ
      ⟨fun x : SpatialCoordinates d => x + z, continuous_id.add continuous_const⟩
  have hstat : MeasurePreserving translate (chaosRootFieldLaw M).toMeasure
      (chaosRootFieldLaw M).toMeasure := by
    exact gmc_zero_field_law_stationary M z
  have heq := hstat.lintegral_comp hFm
  simpa [F, translate] using heq.le.trans hzero

lemma aux_lem_band_K7_layer_point_exp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (j : ℤ) (z : SpatialCoordinates d) :
    (∫⁻ omg : BilateralField d, ENNReal.ofReal (Real.exp ((|omg j z| / M.delta) ^ 2))
      ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  let F : C(SpatialCoordinates d, ℝ) → ENNReal :=
    fun f => ENNReal.ofReal (Real.exp ((|f z| / M.delta) ^ 2))
  have hFm : Measurable F := by
    have hv : Measurable (fun f : C(SpatialCoordinates d, ℝ) => f z) :=
      (continuous_eval_const z).measurable
    simpa only [F, Real.norm_eq_abs] using
      (((hv.norm.div_const M.delta).pow_const 2).exp).ennreal_ofReal
  let laws : ℤ → Measure C(SpatialCoordinates d, ℝ) :=
    fun k => (scaledLayerLaw d (chaosRootFieldLaw M) k).toMeasure
  have hm := measurePreserving_eval_infinitePi laws j
  change (∫⁻ omg : BilateralField d, F (omg j) ∂Measure.infinitePi laws) ≤ 2
  rw [hm.lintegral_comp hFm]
  change (∫⁻ f, F f ∂Measure.map (layerScaling d j) (chaosRootFieldLaw M).toMeasure) ≤ 2
  rw [lintegral_map hFm (layerScaling d j).continuous.measurable]
  exact aux_lem_band_K7_root_point_exp M ((3 : ℝ) ^ (-j) • z)

lemma aux_lem_band_K7_orlicz_mono
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (X Y : Ω → ℝ) (A B : ℝ) (hA : 0 < A) (hAB : A ≤ B)
    (hXY : ∀ᵐ omg ∂μ, |X omg| ≤ Y omg)
    (h : (∫⁻ omg, ENNReal.ofReal (Real.exp ((Y omg / A) ^ 2)) ∂μ) ≤ 2) :
    (∫⁻ omg, ENNReal.ofReal (Real.exp ((|X omg| / B) ^ 2)) ∂μ) ≤ 2 := by
  apply le_trans (lintegral_mono_ae _) h
  filter_upwards [hXY] with omg hω
  apply ENNReal.ofReal_le_ofReal
  apply Real.exp_le_exp.mpr
  apply pow_le_pow_left₀ (div_nonneg (abs_nonneg _) (hA.le.trans hAB))
  exact div_le_div₀ ((abs_nonneg _).trans hω) hω hA hAB

lemma aux_lem_band_K7_finset_point_exp
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    {ι : Type*} [DecidableEq ι] (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (S : Finset ι) (hS : S.Nonempty) (idx : ι → ℤ) (z : ι → SpatialCoordinates d) :
    (∫⁻ ω : BilateralField d, ENNReal.ofReal (Real.exp
      (((∑ i ∈ S, |ω (idx i) (z i)|) / ((S.card : ℝ) * M.delta)) ^ 2))
      ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  have hm (i : ι) : Measurable (fun ω : BilateralField d => |ω (idx i) (z i)|) := by
    have hv : Measurable (fun f : C(SpatialCoordinates d, ℝ) => f (z i)) :=
      (continuous_eval_const (z i)).measurable
    have he : Measurable (fun ω : BilateralField d => ω (idx i)) := measurable_pi_apply (idx i)
    simpa only [Function.comp_def, Real.norm_eq_abs] using (hv.comp he).norm
  have h := lintegral_exp_sq_finset_sum_le (chaosSampleLaw M).toMeasure S
    (fun i ω => |ω (idx i) (z i)|) (fun _ => M.delta) hS
    (fun i _ => (hm i).aestronglyMeasurable)
    (fun _ _ => ae_of_all _ fun _ => abs_nonneg _)
    (fun _ _ => M.shellPrefix.delta_pos)
    (fun i _ => aux_lem_band_K7_layer_point_exp M (idx i) (z i))
  simpa using h

lemma aux_lem_band_exp_difference (x t : ℝ) :
    |Real.exp x - Real.exp (x - t)| ≤
      |t| * (Real.exp |x| * Real.exp |t|) := by
  have h1 (u : ℝ) : |Real.exp u - 1| ≤ |u| * Real.exp |u| := by
    by_cases hu : 0 ≤ u
    · rw [abs_of_nonneg (sub_nonneg.mpr (Real.one_le_exp_iff.mpr hu)), abs_of_nonneg hu]
      have hh := Real.add_one_le_exp (-u)
      have hh' := mul_le_mul_of_nonneg_left hh (Real.exp_pos u).le
      rw [← Real.exp_add, add_neg_cancel, Real.exp_zero] at hh'
      nlinarith
    · have hu' : u ≤ 0 := le_of_not_ge hu
      rw [abs_of_nonpos (sub_nonpos.mpr (Real.exp_le_one_iff.mpr hu')), abs_of_nonpos hu']
      have hh := Real.add_one_le_exp u
      have hexp : 1 ≤ Real.exp (-u) := Real.one_le_exp_iff.mpr (neg_nonneg.mpr hu')
      nlinarith
  have heq : Real.exp x - Real.exp (x - t) = Real.exp x * (1 - Real.exp (-t)) := by
    rw [sub_eq_add_neg x t, Real.exp_add]; ring
  rw [heq, abs_mul, abs_of_pos (Real.exp_pos x), abs_sub_comm]
  calc Real.exp x * |Real.exp (-t) - 1| ≤
      Real.exp |x| * (|-t| * Real.exp |-t|) :=
        mul_le_mul (Real.exp_le_exp.mpr (le_abs_self x)) (h1 (-t))
          (abs_nonneg _) (Real.exp_pos _).le
    _ = |t| * (Real.exp |x| * Real.exp |t|) := by rw [abs_neg]; ring

lemma aux_lem_band_orlicz_exp_norm
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → ℝ) (hX : Measurable X) (σ B q : ℝ)
    (hσ : 0 < σ) (hσB : σ ≤ B) (hq : 0 < q)
    (h : (∫⁻ omg, ENNReal.ofReal (Real.exp ((|X omg| / σ) ^ 2)) ∂μ) ≤ 2) :
    eLpNorm (fun omg => Real.exp |X omg|) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal ((2 * Real.exp (q ^ 2 * B ^ 2 / 4)) ^ (1 / q)) := by
  have hlin := aux_prefix_praw_exp_lin μ (fun omg => |X omg|) hX.norm σ hσ h q
  have hm : AEStronglyMeasurable (fun omg => Real.exp |X omg|) μ :=
    hX.abs.exp.aestronglyMeasurable
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_pos.mpr hq).ne'
    ENNReal.ofReal_ne_top hm, ENNReal.toReal_ofReal hq.le]
  have heq : (fun omg => ‖Real.exp |X omg|‖ₑ ^ q) =
      (fun omg => ENNReal.ofReal (Real.exp (q * |X omg|))) := by
    funext omg
    rw [Real.enorm_eq_ofReal (Real.exp_pos _).le,
      ENNReal.ofReal_rpow_of_nonneg (Real.exp_pos _).le hq.le,
      Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp]
    congr 2; ring
  rw [heq]
  calc (∫⁻ omg, ENNReal.ofReal (Real.exp (q * |X omg|)) ∂μ) ^ (1 / q) ≤
      (ENNReal.ofReal (Real.exp (q ^ 2 * σ ^ 2 / 4)) * 2) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hlin (by positivity)
    _ ≤ (ENNReal.ofReal (2 * Real.exp (q ^ 2 * B ^ 2 / 4))) ^ (1 / q) := by
      apply ENNReal.rpow_le_rpow _ (by positivity)
      rw [← ENNReal.ofReal_ofNat, ← ENNReal.ofReal_mul (Real.exp_pos _).le]
      apply ENNReal.ofReal_le_ofReal
      have hs : σ ^ 2 ≤ B ^ 2 := pow_le_pow_left₀ hσ.le hσB 2
      have he : Real.exp (q ^ 2 * σ ^ 2 / 4) ≤ Real.exp (q ^ 2 * B ^ 2 / 4) :=
        Real.exp_le_exp.mpr (by nlinarith [sq_nonneg q])
      nlinarith
    _ = _ := ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)

theorem aux_lem_band_eLpNorm_mul_double
    {Omega : Type*} [MeasurableSpace Omega] {mu : Measure Omega}
    {q : ℝ} (hq : 0 < q) {X Y : Omega → ℝ}
    (hX : AEStronglyMeasurable X mu) (hY : AEStronglyMeasurable Y mu) :
    eLpNorm (fun omega ↦ X omega * Y omega) (ENNReal.ofReal q) mu ≤
      eLpNorm X (ENNReal.ofReal (2 * q)) mu *
        eLpNorm Y (ENNReal.ofReal (2 * q)) mu := by
  have hholderReal : Real.HolderTriple (2 * q) (2 * q) q := by
    constructor
    · field_simp
      ring
    · positivity
    · positivity
  let : ENNReal.HolderTriple (2 * ENNReal.ofReal q)
      (2 * ENNReal.ofReal q) (ENNReal.ofReal q) := by
    simpa only [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
      ENNReal.ofReal_ofNat] using hholderReal.ennrealOfReal
  simpa using
    (eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm
      (fun x y : ℝ ↦ x * y) 1 (by fun_prop) hX hY
      (Filter.Eventually.of_forall fun _ ↦ by simp))

lemma aux_lem_band_orlicz_exp_difference :
    ∃ C : ℝ, 0 < C ∧
    ∀ {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (S T : Ω → ℝ) (_hS : Measurable S) (_hT : Measurable T)
    (σ τ B A p : ℝ) (_hσ : 0 < σ) (_hτ : 0 < τ)
    (_hσB : σ ≤ B) (_hτA : τ ≤ A) (_hp : 1 ≤ p)
    (_hSg : (∫⁻ ω, ENNReal.ofReal (Real.exp ((|S ω| / σ) ^ 2)) ∂μ) ≤ 2)
    (_hTg : (∫⁻ ω, ENNReal.ofReal (Real.exp ((|T ω| / τ) ^ 2)) ∂μ) ≤ 2),
      eLpNorm (fun ω => Real.exp (S ω) - Real.exp (S ω - T ω)) (ENNReal.ofReal p) μ ≤
        ENNReal.ofReal (C * τ * Real.sqrt (2 * p) *
          ((2 * Real.exp ((4 * p) ^ 2 * B ^ 2 / 4)) ^ (1 / (4 * p))) *
          ((2 * Real.exp ((4 * p) ^ 2 * A ^ 2 / 4)) ^ (1 / (4 * p)))) := by
  obtain ⟨C, hC, hOrlicz⟩ := exists_universal_orlicz_eLpNorm_constant
  refine ⟨C, hC, ?_⟩
  intro Ω _ μ _ S T hS hT σ τ B A p hσ hτ hσB hτA hp hSg hTg
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have ht := hOrlicz μ (fun ω => |T ω|) τ hT.norm (fun _ => abs_nonneg _) hτ hTg
    (ENNReal.ofReal (2 * p)) ENNReal.ofReal_ne_top
    (by rw [← ENNReal.ofReal_ofNat]; exact ENNReal.ofReal_le_ofReal (by linarith))
  rw [ENNReal.toReal_ofReal (by positivity)] at ht
  have hsExp := aux_lem_band_orlicz_exp_norm μ S hS σ B (4 * p) hσ hσB (by positivity) hSg
  have htExp := aux_lem_band_orlicz_exp_norm μ T hT τ A (4 * p) hτ hτA (by positivity) hTg
  have hprod := aux_lem_band_eLpNorm_mul_double (mu := μ) (by positivity : 0 < 2 * p)
    hS.norm.exp.aestronglyMeasurable hT.norm.exp.aestronglyMeasurable
  rw [show 2 * (2 * p) = 4 * p by ring] at hprod
  calc eLpNorm _ (ENNReal.ofReal p) μ ≤
      eLpNorm (fun ω => |T ω| * (Real.exp |S ω| * Real.exp |T ω|)) (ENNReal.ofReal p) μ := by
        apply eLpNorm_mono (hS.exp.sub (hS.sub hT).exp).aestronglyMeasurable
        intro ω
        change ‖Real.exp (S ω) - Real.exp (S ω - T ω)‖ ≤ _
        simpa only [Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤
          |T ω| * (Real.exp |S ω| * Real.exp |T ω|))] using aux_lem_band_exp_difference (S ω) (T ω)
    _ ≤ eLpNorm (fun ω => |T ω|) (ENNReal.ofReal (2 * p)) μ *
        eLpNorm (fun ω => Real.exp |S ω| * Real.exp |T ω|) (ENNReal.ofReal (2 * p)) μ :=
      aux_lem_band_eLpNorm_mul_double hp0
        hT.norm.aestronglyMeasurable (hS.norm.exp.mul hT.norm.exp).aestronglyMeasurable
    _ ≤ _ := by
      calc _ ≤ ENNReal.ofReal (C * τ * Real.sqrt (2 * p)) *
          (ENNReal.ofReal ((2 * Real.exp ((4 * p) ^ 2 * B ^ 2 / 4)) ^ (1 / (4 * p))) *
           ENNReal.ofReal ((2 * Real.exp ((4 * p) ^ 2 * A ^ 2 / 4)) ^ (1 / (4 * p)))) :=
            mul_le_mul' ht (hprod.trans (mul_le_mul' hsExp htExp))
        _ = _ := by rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]; congr 1; ring

lemma aux_lem_band_K7_retained_meas
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ)
    (hr : retained = fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
      else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y)
    (k : ℤ) (y : SpatialCoordinates d) : Measurable (retained k y) := by
  subst retained
  dsimp only
  split_ifs
  · exact Finset.measurable_sum _ fun i _ =>
      ((continuous_eval_const y).comp (continuous_apply (-i))).measurable
  · exact (Finset.measurable_sum _ fun i _ =>
      ((continuous_eval_const y).comp (continuous_apply (-i))).measurable).neg

lemma aux_lem_band_K7_full_log_orlicz
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (off : ℤ) (sh : SpatialCoordinates d) (w0 : ℕ) (hw0 : 0 < w0)
    (hoff : |off| < (w0 : ℤ))
    (hgrowth : (2 / 3 : ℝ) * (‖sh‖ + 1) ≤ (3 : ℝ) ^ ((w0 : ℤ) * 2 + 1)) :
    ∃ B : ℝ, 0 < B ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ),
        retained = (fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
          else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y) →
      ∀ (n : ℤ) (z : SpatialCoordinates d),
        let w := z + ((3 : ℝ) ^ (-n)) • sh
        (∫⁻ omega, ENNReal.ofReal (Real.exp
          ((|H omega z + retained n z omega -
            (H omega w + retained (n + off) w omega)| / (B * M.delta)) ^ 2))
          ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨m, hm, htail⟩ := aux_lem_band_piece_coords_K7_tail_uniform_tail_exp (d := d)
  let A : ℝ := (1 / 2 : ℝ) * m * (‖sh‖ + 1)
  have hA : 0 < A := by dsimp [A]; positivity
  have hwR : 0 < (w0 : ℝ) := by exact_mod_cast hw0
  refine ⟨6 * w0 + A, by positivity, ?_⟩
  intro M H hH retained hr n z w
  have hδpos := M.shellPrefix.delta_pos
  let μ := (chaosSampleLaw M).toMeasure
  let edge : ℤ := -n + 2 * w0
  let lo : ℤ := -edge
  let T : BilateralField d → ℝ := fun omega =>
    ∑' k : ℕ, (omega (edge + 1 + k) z - omega (edge + 1 + k) w)
  let head (y : SpatialCoordinates d) (k : ℤ) : BilateralField d → ℝ :=
    fun omega => ∑ j ∈ Finset.Ico lo k, omega (-j) y
  have hlo : lo < n ∧ lo < n + off := by
    have := abs_lt.mp hoff
    dsimp [lo, edge]
    omega
  have hTrep := aux_lem_band_K7_tail_eq M H hH z w edge retained hr
  have hTmeas : AEStronglyMeasurable T μ := by
    have hz := (continuous_eval_const z).measurable.comp hH.1
    have hw := (continuous_eval_const w).measurable.comp hH.1
    have hm' := ((hz.sub hw).add (aux_lem_band_K7_retained_meas retained hr (-edge) z)).sub
      (aux_lem_band_K7_retained_meas retained hr (-edge) w)
    apply hm'.aestronglyMeasurable.congr
    filter_upwards [hTrep] with omega heq
    exact heq.symm
  have hhMeas (y : SpatialCoordinates d) (k : ℤ) : Measurable (head y k) :=
    Finset.measurable_sum _ fun j _ =>
      ((continuous_eval_const y).comp (continuous_apply (-j))).measurable
  have hhead (k : ℤ) (y : SpatialCoordinates d) (hlk : lo < k) (hkn : k ≤ n + w0) :
      (∫⁻ omega, ENNReal.ofReal (Real.exp
        ((|head y k omega| / (3 * w0 * M.delta)) ^ 2)) ∂μ) ≤ 2 := by
    let S := Finset.Ico lo k
    have hS : S.Nonempty := ⟨lo, Finset.mem_Ico.mpr ⟨le_rfl, hlk⟩⟩
    have hc : (S.card : ℝ) ≤ 3 * w0 := by
      have hn : S.card ≤ 3 * w0 := by
        dsimp [S]
        rw [Int.card_Ico]
        dsimp [lo, edge] at hlk ⊢
        omega
      exact_mod_cast hn
    apply aux_lem_band_K7_orlicz_mono μ (head y k)
      (fun omega => ∑ j ∈ S, |omega (-j) y|)
      ((S.card : ℝ) * M.delta) (3 * w0 * M.delta)
      (mul_pos (by exact_mod_cast Finset.card_pos.mpr hS) M.shellPrefix.delta_pos)
      (mul_le_mul_of_nonneg_right hc M.shellPrefix.delta_pos.le)
      (ae_of_all _ fun omega => Finset.abs_sum_le_sum_abs _ _) 
    exact aux_lem_band_K7_finset_point_exp M S hS (fun j => -j) (fun _ => y)
  have hnhead := hhead n z hlo.1 (by omega)
  have hmhead := hhead (n + off) w hlo.2 (by have := abs_lt.mp hoff; omega)
  have hscale : (3 : ℝ) ^ (-(edge + n)) ≤ 1 := by
    apply zpow_le_one_of_nonpos₀ (by norm_num) (by dsimp [edge]; omega)
  have hTg : (∫⁻ omega, ENNReal.ofReal (Real.exp
      ((|T omega| / (A * M.delta)) ^ 2)) ∂μ) ≤ 2 := by
    have he : (2 / 3 : ℝ) * (‖sh‖ + 1) ≤ (3 : ℝ) ^ (edge + n + 1) := by
      convert hgrowth using 1
      dsimp [edge]
      congr 1; ring
    have h := htail M z sh n edge he
    apply aux_lem_band_K7_orlicz_mono μ T (fun omega => |T omega|)
      ((1 / 2 : ℝ) * m * M.delta * (‖sh‖ + 1) * (3 : ℝ) ^ (-(edge + n)))
      (A * M.delta) (by positivity)
      (by
        have hz : 0 ≤ (1 / 2 : ℝ) * m * M.delta * (‖sh‖ + 1) := by positivity
        have hs := mul_le_mul_of_nonneg_left hscale hz
        dsimp [A]
        nlinarith only [hs])
      (ae_of_all _ fun _ => le_rfl)
    simpa only [Real.norm_eq_abs] using h
  let F : Fin 3 → BilateralField d → ℝ := ![
    fun omega => |head z n omega|,
    fun omega => |head w (n + off) omega|,
    fun omega => |T omega|]
  let a : Fin 3 → ℝ := ![3 * w0 * M.delta, 3 * w0 * M.delta, A * M.delta]
  have hF : ∀ i : Fin 3, AEStronglyMeasurable (F i) μ := by
    intro i
    fin_cases i
    · exact (hhMeas z n).norm.aestronglyMeasurable
    · exact (hhMeas w (n + off)).norm.aestronglyMeasurable
    · exact hTmeas.norm
  have hF0 : ∀ (i : Fin 3) omega, 0 ≤ F i omega := by
    intro i omega; fin_cases i <;> exact abs_nonneg _
  have ha : ∀ i : Fin 3, 0 < a i := by
    intro i; fin_cases i <;> dsimp [a] <;> positivity
  have hg : ∀ i : Fin 3,
      (∫⁻ omega, ENNReal.ofReal (Real.exp ((F i omega / a i) ^ 2)) ∂μ) ≤ 2 := by
    intro i
    fin_cases i
    · exact hnhead
    · exact hmhead
    · exact hTg
  have hsum := lintegral_exp_sq_finset_sum_le μ Finset.univ F a Finset.univ_nonempty
    (fun i _ => hF i) (fun i _ => ae_of_all _ (hF0 i)) (fun i _ => ha i) (fun i _ => hg i)
  have hden : ∑ i : Fin 3, a i = (6 * w0 + A) * M.delta := by
    simp [a, Fin.sum_univ_succ]
    ring
  rw [hden] at hsum
  apply aux_lem_band_K7_orlicz_mono μ _ (fun omega => ∑ i : Fin 3, F i omega)
    ((6 * w0 + A) * M.delta) ((6 * w0 + A) * M.delta) (by positivity) le_rfl _ hsum
  filter_upwards [hTrep] with omega ht
  have h1 := aux_lem_band_retained_Ico retained hr lo n hlo.1.le z omega
  have h2 := aux_lem_band_retained_Ico retained hr lo (n + off) hlo.2.le w omega
  have hval : H omega z + retained n z omega -
      (H omega w + retained (n + off) w omega) = head z n omega - head w (n + off) omega + T omega := by
    change T omega = H omega z - H omega w + retained lo z omega - retained lo w omega at ht
    change retained n z omega - retained lo z omega = head z n omega at h1
    change retained (n + off) w omega - retained lo w omega = head w (n + off) omega at h2
    linarith
  rw [hval]
  calc |head z n omega - head w (n + off) omega + T omega| ≤
      |head z n omega| + |head w (n + off) omega| + |T omega| :=
        (abs_add_le _ _).trans (add_le_add (abs_sub _ _) le_rfl)
    _ = ∑ i : Fin 3, F i omega := by simp [F, Fin.sum_univ_succ, add_assoc]

theorem aux_lem_band_piece_coords_K7_tail_quant
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (off : ℤ) (sh : SpatialCoordinates d) (w0 : ℕ) (hw0pos : 0 < w0)
    (hw0off : |off| < (w0 : ℤ))
    (hw0growth : ∀ h : ℕ, 1 ≤ h →
      (2 / 3 : ℝ) * (‖sh‖ + 1) ≤ (3 : ℝ) ^ ((w0 : ℤ) * ((h : ℤ) + 1) + 1)) :
    ∀ p : ℝ, 1 ≤ p → ∃ delta0 C0 : ℝ, 0 < delta0 ∧ 0 ≤ C0 ∧
    ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
    ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
    ∀ (n : ℤ) (z : SpatialCoordinates d),
    ∀ (m : ℤ), m = n + off →
    ∀ (w : SpatialCoordinates d), w = z + ((3 : ℝ) ^ (-n)) • sh →
    ∀ (retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ),
      retained = (fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
        else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y) →
    ∀ (h : ℕ), 1 ≤ h →
    ∀ (Aexp : BilateralField d → ℝ),
      Aexp = (fun omega =>
        Real.exp (H omega z + retained n z omega - (H omega w + retained m w omega))) →
    ∀ (Yband : BilateralField d → ℝ),
      AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) =>
            omega (j : ℤ))
        inferInstance] Yband (chaosSampleLaw M).toMeasure →
      (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        Aexp omega = Yband omega * Real.exp (∑' k : ℕ,
          (omega ((-n + (w0 * (h + 1) : ℕ)) + 1 + (k : ℤ)) z -
            omega ((-n + (w0 * (h + 1) : ℕ)) + 1 + (k : ℤ)) w))) →
      eLpNorm (fun omega => Aexp omega - Yband omega) (ENNReal.ofReal p)
          (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (C0 * M.delta ^ (1 : ℝ) * (3 : ℝ) ^ (-((w0 : ℝ) * (h : ℝ)))) := by
  intro p hp
  obtain ⟨B, hB, hSg⟩ := aux_lem_band_K7_full_log_orlicz off sh w0 hw0pos hw0off
    (by simpa using hw0growth 1 le_rfl)
  obtain ⟨m, hm, hTail⟩ := aux_lem_band_piece_coords_K7_tail_uniform_tail_exp (d := d)
  obtain ⟨C, hC, hdiff⟩ := aux_lem_band_orlicz_exp_difference
  let A : ℝ := (1 / 2 : ℝ) * m * (‖sh‖ + 1)
  have hA : 0 < A := by dsimp [A]; positivity
  let Dp (u : ℝ) := (2 * Real.exp ((4 * p) ^ 2 * u ^ 2 / 4)) ^ (1 / (4 * p))
  refine ⟨1, C * A * Real.sqrt (2 * p) * Dp B * Dp A, by norm_num, by positivity, ?_⟩
  intro M hM H hH n z m' hm' w hw retained hr h hh Aexp hAexp Yband _hYm hfactor
  subst m' w Aexp
  have hδpos := M.shellPrefix.delta_pos
  let μ := (chaosSampleLaw M).toMeasure
  let w := z + ((3 : ℝ) ^ (-n)) • sh
  let S : BilateralField d → ℝ := fun omega =>
    H omega z + retained n z omega - (H omega w + retained (n + off) w omega)
  let W : ℕ := w0 * (h + 1)
  let edge : ℤ := -n + W
  let T : BilateralField d → ℝ := fun omega =>
    ∑' k : ℕ, (omega (edge + 1 + k) z - omega (edge + 1 + k) w)
  have hSm : Measurable S :=
    (((continuous_eval_const z).measurable.comp hH.1).add
      (aux_lem_band_K7_retained_meas retained hr n z)).sub
      (((continuous_eval_const w).measurable.comp hH.1).add
        (aux_lem_band_K7_retained_meas retained hr (n + off) w))
  have hTeq := aux_lem_band_K7_tail_eq M H hH z w edge retained hr
  have hTm : AEStronglyMeasurable T μ := by
    have h := ((((continuous_eval_const z).measurable.comp hH.1).sub
      ((continuous_eval_const w).measurable.comp hH.1)).add
      (aux_lem_band_K7_retained_meas retained hr (-edge) z)).sub
      (aux_lem_band_K7_retained_meas retained hr (-edge) w)
    apply h.aestronglyMeasurable.congr
    filter_upwards [hTeq] with omega heq
    exact heq.symm
  let Tm := hTm.mk T
  have hTmm : Measurable Tm := hTm.measurable_mk
  let τ : ℝ := A * M.delta * (3 : ℝ) ^ (-((w0 : ℝ) * (h + 1)))
  have hτ : 0 < τ := by dsimp [τ]; positivity
  have hscale : (3 : ℝ) ^ (-((w0 : ℝ) * (h + 1))) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (by positivity))
  have hτA : τ ≤ A := by
    calc τ ≤ A * M.delta := by
          dsimp [τ]
          exact mul_le_of_le_one_right (by positivity) hscale
      _ ≤ A := mul_le_of_le_one_right hA.le hM
  have he : (2 / 3 : ℝ) * (‖sh‖ + 1) ≤ (3 : ℝ) ^ (edge + n + 1) := by
    convert hw0growth h hh using 1
    dsimp [edge, W]
    congr 1
    ring
  have htail := hTail M z sh n edge he
  have htailScale : (1 / 2 : ℝ) * m * M.delta * (‖sh‖ + 1) *
      (3 : ℝ) ^ (-(edge + n)) = τ := by
    dsimp [τ, A]
    have hexp : (3 : ℝ) ^ (-(edge + n)) = (3 : ℝ) ^ (-((w0 : ℝ) * (h + 1))) := by
      rw [← Real.rpow_intCast]
      congr 1
      dsimp [edge, W]
      push_cast
      ring
    rw [hexp]
    ring
  rw [htailScale] at htail
  have hTg : (∫⁻ omega, ENNReal.ofReal (Real.exp ((|Tm omega| / τ) ^ 2)) ∂μ) ≤ 2 := by
    calc _ = ∫⁻ omega, ENNReal.ofReal (Real.exp ((|T omega| / τ) ^ 2)) ∂μ := by
          apply lintegral_congr_ae
          filter_upwards [hTm.ae_eq_mk] with omega heq
          rw [heq]
      _ ≤ 2 := by simpa only [Real.norm_eq_abs] using htail
  have hσ : 0 < B * M.delta := mul_pos hB M.shellPrefix.delta_pos
  have hσB : B * M.delta ≤ B := mul_le_of_le_one_right hB.le hM
  have hmain := hdiff μ S Tm hSm hTmm (B * M.delta) τ B A p hσ hτ hσB hτA hp
    (hSg M H hH retained hr n z) hTg
  have hae : (fun omega => Real.exp (S omega) - Yband omega) =ᵐ[μ]
      (fun omega => Real.exp (S omega) - Real.exp (S omega - Tm omega)) := by
    filter_upwards [hfactor, hTm.ae_eq_mk] with omega hf htm
    change Real.exp (S omega) = Yband omega * Real.exp (T omega) at hf
    have hY : Yband omega = Real.exp (S omega - T omega) := by
      rw [Real.exp_sub]
      exact (eq_div_iff (Real.exp_ne_zero _)).mpr hf.symm
    rw [hY, htm]
  change eLpNorm (fun omega => Real.exp (S omega) - Yband omega) _ μ ≤ _
  rw [eLpNorm_congr_ae hae]
  refine hmain.trans (ENNReal.ofReal_le_ofReal ?_)
  rw [Real.rpow_one]
  have hscale' : (3 : ℝ) ^ (-((w0 : ℝ) * (h + 1))) ≤
      (3 : ℝ) ^ (-((w0 : ℝ) * h)) := by
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have hwR : 0 ≤ (w0 : ℝ) := by positivity
    nlinarith
  have hτ' : τ ≤ A * M.delta * (3 : ℝ) ^ (-((w0 : ℝ) * h)) :=
    mul_le_mul_of_nonneg_left hscale' (by positivity)
  calc C * τ * Real.sqrt (2 * p) * Dp B * Dp A ≤
      C * (A * M.delta * (3 : ℝ) ^ (-((w0 : ℝ) * h))) * Real.sqrt (2 * p) * Dp B * Dp A := by
        gcongr
    _ = _ := by ring

theorem aux_lem_band_piece_coords_K7_tail
    (d : ℕ) (_hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (off : ℤ) (sh : SpatialCoordinates d) :
    ∃ a0 c0 : ℝ, 0 < a0 ∧ 0 < c0 ∧ ∃ w0 : ℕ, 0 < w0 ∧
      ∀ p : ℝ, 1 ≤ p → ∃ delta0 C0 : ℝ, 0 < delta0 ∧ 0 ≤ C0 ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) → n + off ≤ (N : ℤ) →
      let m : ℤ := n + off
      let w : SpatialCoordinates d := z + ((3 : ℝ) ^ (-n)) • sh
      let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
        fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
          else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y
      ∀ h : ℕ, 1 ≤ h →
        ∃ Yband : BilateralField d → ℝ,
          AEStronglyMeasurable[MeasurableSpace.comap
            (fun omega : BilateralField d =>
              fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) =>
                omega (j : ℤ))
            inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
          eLpNorm (fun omega =>
              Real.exp (H omega z + retained n z omega - (H omega w + retained m w omega)) -
                Yband omega)
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (C0 * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
  obtain ⟨w0, hw0pos, hw0off, hw0growth⟩ := aux_lem_band_piece_coords_K7_tail_w0 off sh
  refine ⟨(w0 : ℝ), 1, by exact_mod_cast hw0pos, one_pos, w0, hw0pos, ?_⟩
  intro p hp
  obtain ⟨delta0, C0, hdelta0, hC0, hquant⟩ :=
    aux_lem_band_piece_coords_K7_tail_quant off sh w0 hw0pos hw0off hw0growth p hp
  refine ⟨delta0, C0, hdelta0, hC0, ?_⟩
  intro M hMdelta H hH N n z hnN hmN m w retained h hh
  obtain ⟨Yband, hYmeas, hYid⟩ :=
    aux_lem_band_piece_coords_K7_tail_split M H hH off n z sh m rfl w rfl retained rfl
      w0 hw0pos hw0off h hh
  refine ⟨Yband, hYmeas, ?_⟩
  exact hquant M hMdelta H hH n z m rfl w rfl retained rfl h hh
    (fun omega => Real.exp (H omega z + retained n z omega - (H omega w + retained m w omega)))
    rfl Yband hYmeas hYid

theorem aux_lem_band_piece_coords_K7
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (off : ℤ) (sh : SpatialCoordinates d) :
    ∃ a0 c0 : ℝ, 0 < a0 ∧ 0 < c0 ∧ ∃ w0 : ℕ, 0 < w0 ∧
      ∀ p : ℝ, 1 ≤ p → ∃ delta0 C0 : ℝ, 0 < delta0 ∧ 0 ≤ C0 ∧
      ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
      ∀ (_Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) → n + off ≤ (N : ℤ) →
      let kappa : ℕ → ℝ := fun J =>
        Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M J
      let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
        fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
          else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y
      let reference : ℕ → ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
        fun N k y omega => kappa ((N : ℤ) - k).toNat / kappa N *
          Real.exp (H omega y + retained k y omega)
      let m : ℤ := n + off
      let w : SpatialCoordinates d := z + ((3 : ℝ) ^ (-n)) • sh
      ∀ h : ℕ, 1 ≤ h →
        ∃ Yband : BilateralField d → ℝ,
          AEStronglyMeasurable[MeasurableSpace.comap
            (fun omega : BilateralField d =>
              fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) =>
                omega (j : ℤ))
            inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
          eLpNorm (fun omega =>
              reference N n z omega / reference N m w omega - 1 - Yband omega)
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (C0 * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
  obtain ⟨a0, c0, ha0, hc0, w0, hw0, htail⟩ :=
    aux_lem_band_piece_coords_K7_tail d hd off sh
  refine ⟨a0, c0, ha0, hc0, w0, hw0, ?_⟩
  intro p hp
  obtain ⟨delta0, C0tail, hdelta0, hC0tail, htail'⟩ := htail p hp
  set Cdet : ℝ := Real.exp (3 * (Real.log 2 / 2) * delta0 ^ 2 * |(off : ℝ)|) with hCdetdef
  have hCdetpos : 0 < Cdet := Real.exp_pos _
  refine ⟨delta0, Cdet * C0tail, hdelta0, mul_nonneg hCdetpos.le hC0tail, ?_⟩
  intro M hMdelta Rm H hH N n z hnN hmN kappa retained reference m w h hh
  obtain ⟨Yband0, hYband0meas, hYband0bound⟩ := htail' M hMdelta H hH N n z hnN hmN h hh
                                         
  have hkr := aux_lem_band_piece_coords_K7_kappa_ratio_bounded M Rm n m N hnN hmN
  have hoffabs : |(m : ℝ) - n| = |(off : ℝ)| := by
    show |((n + off : ℤ) : ℝ) - n| = |(off : ℝ)|
    push_cast; ring_nf
  simp only [hoffabs] at hkr
  obtain ⟨hkr0, hkr1⟩ := hkr
  set c : ℝ := kappa ((N : ℤ) - n).toNat / kappa ((N : ℤ) - m).toNat with hcdef
  have htauB : _root_.SubdiffusiveProcess.Model.tauSq M.P ≤ (Real.log 2 / 2) * delta0 ^ 2 := by
    have h1 := SubdiffusiveProcess.CoarseGrainingVocab.tauSq_le_delta_sq M
    have h2 : M.delta ^ 2 ≤ delta0 ^ 2 :=
      pow_le_pow_left₀ M.shellPrefix.delta_pos.le hMdelta 2
    calc _root_.SubdiffusiveProcess.Model.tauSq M.P ≤ (Real.log 2 / 2) * M.delta ^ 2 := h1
      _ ≤ (Real.log 2 / 2) * delta0 ^ 2 := mul_le_mul_of_nonneg_left h2 (by positivity)
  have hcbound : c ≤ Cdet := by
    refine hkr1.trans ?_
    rw [hCdetdef]
    apply Real.exp_le_exp.mpr
    apply mul_le_mul_of_nonneg_right _ (abs_nonneg _)
    linarith [htauB]
  have hc0 : 0 ≤ c := hkr0
                 
  have hident := aux_lem_band_piece_coords_K7_value_ref_ratio_eq M H n m z w N hnN hmN
  refine ⟨fun omega => c * Yband0 omega - 1, ?_, ?_⟩
  · exact (hYband0meas.const_mul c).sub aestronglyMeasurable_const
  · have hfun_eq : (fun omega => reference N n z omega / reference N m w omega - 1 -
        (c * Yband0 omega - 1)) =
        fun omega => c * (Real.exp (H omega z + retained n z omega -
          (H omega w + retained m w omega)) - Yband0 omega) := by
      funext omega
      have := hident omega
      show reference N n z omega / reference N m w omega - 1 - (c * Yband0 omega - 1) = _
      rw [this]
      show c * Real.exp (H omega z + retained n z omega -
        (H omega w + retained m w omega)) - 1 - (c * Yband0 omega - 1) = _
      ring
    rw [hfun_eq]
    have hae : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        ‖c * (Real.exp (H omega z + retained n z omega -
          (H omega w + retained m w omega)) - Yband0 omega)‖ ≤
        |c| * ‖Real.exp (H omega z + retained n z omega -
          (H omega w + retained m w omega)) - Yband0 omega‖ :=
      Filter.Eventually.of_forall (fun omega => (abs_mul _ _).le)
    calc eLpNorm (fun omega => c * (Real.exp (H omega z + retained n z omega -
          (H omega w + retained m w omega)) - Yband0 omega)) (ENNReal.ofReal p)
          (chaosSampleLaw M).toMeasure
        ≤ ENNReal.ofReal |c| * eLpNorm (fun omega => Real.exp (H omega z + retained n z omega -
            (H omega w + retained m w omega)) - Yband0 omega) (ENNReal.ofReal p)
            (chaosSampleLaw M).toMeasure :=
          by
            change eLpNorm (c • (fun omega => Real.exp (H omega z + retained n z omega -
              (H omega w + retained m w omega)) - Yband0 omega)) _ _ ≤ _
            rw [eLpNorm_const_smul, Real.enorm_eq_ofReal_abs]
      _ ≤ ENNReal.ofReal |c| * ENNReal.ofReal (C0tail * M.delta ^ c0 * (3 : ℝ) ^
            (-(a0 * (h : ℝ)))) := by
          gcongr
      _ = ENNReal.ofReal (|c| * (C0tail * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))))) := by
          rw [← ENNReal.ofReal_mul (abs_nonneg _)]
      _ ≤ ENNReal.ofReal (Cdet * C0tail * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
          apply ENNReal.ofReal_le_ofReal
          rw [abs_of_nonneg hc0]
          have hpow_nonneg : (0:ℝ) ≤ M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) :=
            mul_nonneg (Real.rpow_nonneg M.shellPrefix.delta_pos.le c0)
              (Real.rpow_nonneg (by norm_num) _)
          nlinarith [mul_le_mul_of_nonneg_right hcbound (mul_nonneg hC0tail hpow_nonneg)]


end SubdiffusiveProcess.Paper
