    ∃ Ytrunc : BilateralField d → ℝ,
      AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] Ytrunc (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega =>
          weight3 * (min (1 : ENNReal)
