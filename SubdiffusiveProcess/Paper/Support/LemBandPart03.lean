    ↥(Set.Icc a b) → C(SpatialCoordinates d, ℝ) := fun j => om (j : ℤ)

section BandTransfer

variable {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]

theorem aux_lem_band_transport_window_measurable (a b : ℤ) :
    Measurable (aux_lem_band_transport_window (d := d) a b) :=
  (continuous_pi fun j : Set.Icc a b => continuous_apply (j : ℤ)).measurable

theorem aux_lem_band_transport_window_le_top (a b : ℤ) :
    MeasurableSpace.comap (aux_lem_band_transport_window (d := d) a b) inferInstance ≤
      (inferInstance : MeasurableSpace (BilateralField d)) :=
  (aux_lem_band_transport_window_measurable a b).comap_le

def aux_lem_band_transport_reindex {d : ℕ} (m : ℤ) (w : SpatialCoordinates d) (a b : ℤ)
    (g : ↥(Set.Icc (a - m) (b - m)) → C(SpatialCoordinates d, ℝ)) :
    ↥(Set.Icc a b) → C(SpatialCoordinates d, ℝ) :=
  fun j => (g ⟨(j : ℤ) - m, by
      have hj := j.2
      rw [Set.mem_Icc] at hj ⊢
      omega⟩).comp (aux_lem_band_transport_cellMap m w)

theorem aux_lem_band_transport_reindex_measurable (m : ℤ) (w : SpatialCoordinates d) (a b : ℤ) :
    Measurable (aux_lem_band_transport_reindex (d := d) m w a b) := by
  refine Measurable.of_eval fun j => ?_
  have hc : Measurable fun f : C(SpatialCoordinates d, ℝ) =>
      f.comp (aux_lem_band_transport_cellMap m w) := by fun_prop
  exact hc.comp (measurable_pi_apply _)

theorem aux_lem_band_transport_window_comp_S (m : ℤ) (w : SpatialCoordinates d) (a b : ℤ)
    (om : BilateralField d) :
    aux_lem_band_transport_window a b (aux_lem_band_transport_S m w om) =
      aux_lem_band_transport_reindex m w a b (aux_lem_band_transport_window (a - m) (b - m) om) := by
  let leftMap :
      {f : BilateralField d → (↥(Set.Icc a b) → C(SpatialCoordinates d, ℝ)) // Measurable f} :=
    ⟨fun omega => aux_lem_band_transport_window a b (aux_lem_band_transport_S m w omega),
      (aux_lem_band_transport_window_measurable a b).comp
        (aux_lem_band_transport_S_measurable m w)⟩
  let rightMap :
      {f : BilateralField d → (↥(Set.Icc a b) → C(SpatialCoordinates d, ℝ)) // Measurable f} :=
    ⟨fun omega => aux_lem_band_transport_reindex m w a b
        (aux_lem_band_transport_window (a - m) (b - m) omega),
      (aux_lem_band_transport_reindex_measurable m w a b).comp
        (aux_lem_band_transport_window_measurable (a - m) (b - m))⟩
  have hmap : leftMap = rightMap := by
    apply Subtype.ext
    funext omega j
    simp only [leftMap, rightMap, aux_lem_band_transport_window,
      aux_lem_band_transport_reindex, aux_lem_band_transport_S]
  exact congrFun (congrArg Subtype.val hmap) om

theorem aux_lem_band_transport_comap_le (m : ℤ) (w : SpatialCoordinates d) (a b : ℤ) :
    (MeasurableSpace.comap (aux_lem_band_transport_window (d := d) a b) inferInstance).comap
        (aux_lem_band_transport_S m w) ≤
      MeasurableSpace.comap (aux_lem_band_transport_window (d := d) (a - m) (b - m)) inferInstance := by
  rw [MeasurableSpace.comap_comp]
  have hfac : aux_lem_band_transport_window a b ∘ aux_lem_band_transport_S m w =
      aux_lem_band_transport_reindex m w a b ∘ aux_lem_band_transport_window (a - m) (b - m) := by
    funext om
    exact aux_lem_band_transport_window_comp_S m w a b om
  rw [hfac, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (aux_lem_band_transport_reindex_measurable m w a b).comap_le

theorem aux_lem_band_transport_S_measurable_window (m : ℤ) (w : SpatialCoordinates d) (a b : ℤ) :
    Measurable[MeasurableSpace.comap (aux_lem_band_transport_window (d := d) (a - m) (b - m))
        inferInstance,
      MeasurableSpace.comap (aux_lem_band_transport_window (d := d) a b) inferInstance]
      (aux_lem_band_transport_S m w) :=
  Measurable.of_comap_le (aux_lem_band_transport_comap_le m w a b)

theorem aux_lem_band_transport_band_aestronglyMeasurable (model : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (m : ℤ) (w : SpatialCoordinates d) (a b : ℤ) {Y : BilateralField d → ℝ}
    (hY : AEStronglyMeasurable[MeasurableSpace.comap (aux_lem_band_transport_window (d := d) a b)
        inferInstance] Y (chaosSampleLaw model).toMeasure) :
    AEStronglyMeasurable[MeasurableSpace.comap
        (aux_lem_band_transport_window (d := d) (a - m) (b - m)) inferInstance]
      (Y ∘ aux_lem_band_transport_S m w) (chaosSampleLaw model).toMeasure := by
  obtain ⟨g, hg_sm, hg_eq⟩ := hY
  refine ⟨g ∘ aux_lem_band_transport_S m w,
    hg_sm.comp_measurable (aux_lem_band_transport_S_measurable_window m w a b), ?_⟩
  exact (aux_lem_band_transport_S_measurePreserving model m w).quasiMeasurePreserving.ae hg_eq

theorem aux_lem_band_transport_band_eLpNorm (model : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (m : ℤ) (w : SpatialCoordinates d) (a b : ℤ) (p : ℝ≥0∞) {Y : BilateralField d → ℝ}
    (hY : AEStronglyMeasurable[MeasurableSpace.comap (aux_lem_band_transport_window (d := d) a b)
        inferInstance] Y (chaosSampleLaw model).toMeasure) :
    eLpNorm (Y ∘ aux_lem_band_transport_S m w) p (chaosSampleLaw model).toMeasure =
      eLpNorm Y p (chaosSampleLaw model).toMeasure := by
  obtain ⟨g, hg_sm, hg_eq⟩ := hY
  have hYamb : AEStronglyMeasurable Y (chaosSampleLaw model).toMeasure :=
    ⟨g, hg_sm.mono (aux_lem_band_transport_window_le_top a b), hg_eq⟩
  exact eLpNorm_comp_measurePreserving hYamb (aux_lem_band_transport_S_measurePreserving model m w)

