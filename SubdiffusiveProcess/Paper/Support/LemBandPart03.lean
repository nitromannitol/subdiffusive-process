theorem aux_lem_band_piece_response_baseline
    {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (s eps : ℝ) (hs : 0 < s) (heps : 0 < eps)
    (weight3 : ℝ) (hweight3 : 0 ≤ weight3)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (hprim : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
      primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (p q : ℝ) (_hp1 : 1 ≤ p) (hpq : p ≤ q)
    (hMr : M.delta ≤ aux_prefix_rraw_delta0 d s ({q} : Finset ℝ)) (hM1 : M.delta ≤ 1)
    (N : ℕ) (n : ℤ) (z : Vec d) (hn : n ≤ (N : ℤ)) :
    eLpNorm (fun omega =>
        weight3 * (min (1 : ENNReal)
          ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
              ENNReal.ofReal (eps ^ 2 / 4)) /
            ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
    ENNReal.ofReal (weight3 * (4 / (3 * eps ^ 2)) *
      (aux_prefix_rraw_K d s (aux_prefix_rraw_q d s ({q} : Finset ℝ)) *
        aux_prefix_rraw_rho d s (aux_prefix_rraw_q d s ({q} : Finset ℝ)) *
        (aux_prefix_rraw_C d * aux_prefix_rraw_q d s ({q} : Finset ℝ) *
          Real.log (2 + aux_prefix_rraw_q d s ({q} : Finset ℝ)) * M.delta ^ 2))) := by
  have : IsProbabilityMeasure (chaosSampleLaw M).toMeasure := inferInstance
  set moments : Finset ℝ := ({q} : Finset ℝ) with hmomdef
  set q' : ℝ := aux_prefix_rraw_q d s moments with hq'def
  have hq2 := aux_prefix_rraw_two_le_q d s moments
  have hq'1 : 1 ≤ q' := by rw [hq'def]; linarith
  have hq'0 : 0 < q' := by rw [hq'def]; linarith
  have hsq := aux_prefix_rraw_margin d s hs moments
  have hdeltapos : 0 < M.delta := M.shellPrefix.delta_pos
  have hbank := (aux_prefix_rraw_delta0_spec d s moments).2 M hdeltapos hMr
  have hClog := (aux_prefix_rraw_C_spec d).1
  have hlog : 0 ≤ Real.log (2 + q') := Real.log_nonneg (by rw [hq'def]; linarith)
  have hb : 0 ≤ aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2 := by positivity
  have hgood : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega =
        aux_prefix_rraw_Rset M s (eta N omega) ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) := by
    filter_upwards [hprim] with omega hω
    obtain ⟨_, _, _, _, _, _, hR, _⟩ := hω N
    exact hR _ _
  have htail := (aux_prefix_rraw_tail_eLpNorm_le M s eta heta _ _ hq'1 hbank N
    ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) 0).trans
    (aux_prefix_rraw_tail_numeric d s _ hq'0 hsq _ hb 0 ((N : ℤ) - n).toNat)
  simp only [zero_add, pow_one] at htail
  have hRmeas : AEStronglyMeasurable
      (fun omega => (Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal)
      (chaosSampleLaw M).toMeasure := by
    have hfull := (aux_lem_prefix_limit_raw_Rraw_bound M s eps hs moments hMr hM1 eta heta
      F Praw Rraw Draw Z rawGood hprim N n z).1
    simpa only [ite_eq_left hn] using hfull
  have hRq' : eLpNorm (fun omega => (Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal)
      (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (aux_prefix_rraw_K d s q' * aux_prefix_rraw_rho d s q' *
        (aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2)) := by
    refine (eLpNorm_mono_ae_real hRmeas ?_).trans htail
    filter_upwards [hgood] with omega hω
    rw [hω, Real.norm_of_nonneg ENNReal.toReal_nonneg]
    exact aux_prefix_rraw_Rset_toReal_le_tail_zero M s _ _ _
  have hRne : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega ≠ ⊤ := by
    filter_upwards [hgood] with omega hω
    rw [hω]
    unfold aux_prefix_rraw_Rset
    exact aux_psf_Rsc_ne_top M s _ _ (eta N omega)
  have hqq' : q ≤ q' := by
    have h1 : (0 : ℝ) ≤ |16 * (d : ℝ) / s| := abs_nonneg _
    have h2 : q ≤ |q| := le_abs_self q
    have h3 : |q| ≤ ∑ x ∈ moments, |x| := by rw [hmomdef, Finset.sum_singleton]
    rw [hq'def]
    unfold aux_prefix_rraw_q
    linarith
  have hpq'' : p ≤ q' := hpq.trans hqq'
  have hpq' : ENNReal.ofReal p ≤ ENNReal.ofReal q' := ENNReal.ofReal_le_ofReal hpq''
  have hRp : eLpNorm (fun omega => (Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (aux_prefix_rraw_K d s q' * aux_prefix_rraw_rho d s q' *
        (aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2)) :=
    (eLpNorm_le_eLpNorm_of_exponent_le hpq').trans hRq'
  have hlohi : eps ^ 2 / 4 < eps ^ 2 := by nlinarith
  have key := aux_lem_band_eramp_guarded_le (ENNReal.ofReal p) (eps ^ 2 / 4) (eps ^ 2)
    (by positivity) hlohi
    (fun omega => Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega) (fun _ => (0 : ENNReal))
    hRne (Eventually.of_forall (fun _ => by simp)) hRmeas aestronglyMeasurable_const
  have heq0 : (min (1 : ENNReal) (((0 : ENNReal) - ENNReal.ofReal (eps ^ 2 / 4)) /
      ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal = 0 := by simp
  simp only [heq0, ENNReal.toReal_zero, sub_zero] at key
  have hscaled : (fun omega : BilateralField d => weight3 *
      (min (1 : ENNReal) ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
          ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal)
      = weight3 • (fun omega => (min (1 : ENNReal)
          ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
              ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal) := by
    funext omega; simp [smul_eq_mul]
  rw [hscaled, eLpNorm_const_smul, Real.enorm_eq_ofReal hweight3]
  have hinvnn : (0 : ℝ) ≤ (eps ^ 2 - eps ^ 2 / 4)⁻¹ :=
    inv_nonneg.mpr (by nlinarith)
  have hchain : ENNReal.ofReal weight3 *
      eLpNorm (fun omega => (min (1 : ENNReal)
          ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
              ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal)
        (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal weight3 *
        (ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4)⁻¹ *
          ENNReal.ofReal (aux_prefix_rraw_K d s q' * aux_prefix_rraw_rho d s q' *
            (aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2))) :=
    mul_le_mul_right (key.trans (mul_le_mul_right hRp _)) _
  refine hchain.trans (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul hinvnn, ← ENNReal.ofReal_mul hweight3]
  congr 1
  have hinv : (eps ^ 2 - eps ^ 2 / 4)⁻¹ = 4 / (3 * eps ^ 2) := by
    have heq34 : eps ^ 2 - eps ^ 2 / 4 = 3 * eps ^ 2 / 4 := by ring
    rw [heq34]
    field_simp
  rw [hinv]
  ring

theorem aux_lem_band_tail_rate {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (hq1 : 1 ≤ q) (hq0 : 0 < q) (hsqq : 8 * (d : ℝ) < s * q) (hd_q : (d : ℝ) / q ≤ s / 32)
    (hM1 : M.delta ≤ 1) (hMdelta_tailq : M.delta ≤ aux_lem_band_tailq_delta0 d q hq1)
    (N m : ℕ) (w : Vec d) (h : ℕ) :

      eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
          (aux_prefix_rraw_shallow M s (eta N omega) m w (min (2 * (h + 1)) m)).toReal)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal ((aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q))) *
          (3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ)))) := by
  have hdelta2le1 : M.delta ^ 2 ≤ 1 := pow_le_one₀ M.shellPrefix.delta_pos.le hM1
  set a0final := min a1 s / 16 with ha0def
  have ha0pos : 0 < a0final := by rw [ha0def]; have := lt_min ha1 hs0; positivity
  set Hgrid : ℕ := min (2 * (h + 1)) m with hHdef
  have hHm : Hgrid ≤ m := min_le_right _ _
  rcases le_or_gt (2 * (h + 1)) m with hcase | hcase
  · have hHeq : Hgrid = 2 * (h + 1) := by rw [hHdef]; omega
    have hbankq : ∀ (n' : ℕ) (x : Vec d),
        eLpNorm (fun omega : _root_.SubdiffusiveProcess.Model.PotentialSample d =>
            (aux_psf_Jval M n' omega x).toReal) (ENNReal.ofReal q) M.P.toMeasure ≤
          ENNReal.ofReal (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) :=
      fun n' x => (aux_lem_band_tailq_delta0_spec d q hq1).2 M M.shellPrefix.delta_pos
        hMdelta_tailq n' x
    have hBnn : 0 ≤ aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2 := by
      have hClog := (aux_prefix_rraw_C_spec d).1
      have hlog : 0 ≤ Real.log (2 + q) := Real.log_nonneg (by linarith)
      positivity
    have htailraw := aux_lem_band_trunc_tail M s eta heta q
      (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) hq1 hsqq hbankq hBnn N m w
      Hgrid hHm
    have hKnn : 0 ≤ aux_prefix_rraw_K d s q := aux_prefix_rraw_K_nonneg d s q hq0 hsqq
    have hrhopos := aux_prefix_rraw_rho_pos d s q
    have hrhole : aux_prefix_rraw_rho d s q ≤ (3 : ℝ) ^ (-(3 * s / 32)) := by
      unfold aux_prefix_rraw_rho
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      nlinarith [hd_q]
    have hHeq2 : Hgrid + 1 = 2 * h + 3 := by omega
    have hpow_le : aux_prefix_rraw_rho d s q ^ (Hgrid + 1) ≤
        (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) := by
      rw [hHeq2]
      calc aux_prefix_rraw_rho d s q ^ (2 * h + 3) ≤ ((3 : ℝ) ^ (-(3 * s / 32))) ^ (2 * h + 3) :=
            pow_le_pow_left₀ hrhopos.le hrhole _
        _ = (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) := by
            rw [← Real.rpow_natCast ((3 : ℝ) ^ (-(3 * s / 32))) (2 * h + 3),
              ← Real.rpow_mul (by norm_num)]
    have hfinal_exp_tail : (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) ≤
        (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have h1 : a0final ≤ 3 * s / 16 := by rw [ha0def]; nlinarith [min_le_right a1 s]
      push_cast
      nlinarith [h1, Nat.cast_nonneg (α := ℝ) h]
    refine htailraw.trans (ENNReal.ofReal_le_ofReal ?_)
    have hClognn : 0 ≤ aux_prefix_rraw_C d * q * Real.log (2 + q) := by
      have hClog := (aux_prefix_rraw_C_spec d).1
      have hlog : 0 ≤ Real.log (2 + q) := Real.log_nonneg (by linarith)
      positivity
    calc aux_prefix_rraw_K d s q * aux_prefix_rraw_rho d s q ^ (Hgrid + 1) *
          (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2)
        ≤ aux_prefix_rraw_K d s q * (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) *
            (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hpow_le hKnn) hBnn
      _ ≤ aux_prefix_rraw_K d s q * (3 : ℝ) ^ (-(a0final * (h : ℝ))) *
            (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hfinal_exp_tail hKnn) hBnn
      _ = aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) *
            (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by ring
      _ ≤ aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q) * 1) *
            (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by
          have hrate_nn : (0 : ℝ) ≤ (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by positivity
          have hstep : aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2 ≤
              aux_prefix_rraw_C d * q * Real.log (2 + q) * 1 :=
            mul_le_mul_of_nonneg_left hdelta2le1 hClognn
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hstep hKnn) hrate_nn
      _ = aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q)) *
            (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by ring
  · have hzero : ∀ omega, (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal = 0 := by
      intro omega
      have htail0 : aux_prefix_rraw_tail M s (eta N omega) m w Hgrid = 0 := by
        unfold aux_prefix_rraw_tail
        rw [Finset.Ico_eq_empty (by omega)]
        simp
      have hb := aux_prefix_rraw_abs_Rset_sub_shallow_le M s (eta N omega) m w Hgrid hHm
      rw [htail0, ENNReal.toReal_zero] at hb
      exact abs_eq_zero.mp (le_antisymm hb (abs_nonneg _))
    have heq0 : (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal) = fun _ => (0 : ℝ) :=
      funext hzero
    rw [heq0]
    have hz : eLpNorm (fun _ => (0 : ℝ)) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure = 0 := by
      simp
    rw [hz]
    exact zero_le

theorem aux_lem_band_piece_response_assemble
