    linarith only [hpq, hqqnat]

  obtain ⟨Dtrunc, hDtruncmeas, hDtrunc⟩ :=
    hMgap M hMdelta_le_gap Rm hRm Sreg _It H hInfrared eta heta F Praw Rraw Draw Z rawGood hprim
