          ∀ (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d),
            (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
              ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
                omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
          ∀ (N l : ℕ) (x : Vec d) (h : ℕ),
            (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
              aux_lem_band_Jcell M l x (eta N omega) ≠ ⊤) ∧
            ∃ Jb : BilateralField d → ℝ,
              AEStronglyMeasurable[MeasurableSpace.comap
                (fun omega : BilateralField d =>
                  fun j : Set.Icc ((l : ℤ) - N - h) ((l : ℤ) - N) => omega (j : ℤ))
                inferInstance] Jb (chaosSampleLaw M).toMeasure ∧
              eLpNorm (fun omega => (aux_lem_band_Jcell M l x (eta N omega)).toReal - Jb omega)
                (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
                ENNReal.ofReal (C * M.delta ^ c1 * (3 : ℝ) ^ (-(a1 * (h : ℝ)))) := by
  obtain ⟨a1, c1, ha1, hc1, hfine⟩ :=
    aux_lem_band_rcJ_fine_bound d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
