  aux_lem_band_transport_S ((N : ℤ) - (l : ℤ)) (aux_lem_band_rcJ_w N l x) om

theorem aux_lem_band_rcJ_value_transport {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (omega : BilateralField d) (N l : ℕ) (x : SpatialCoordinates d)
    (heta : ∀ (i : ℕ) (y : SpatialCoordinates d),
      eta N omega i y = omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (z : SpatialCoordinates d) :
    _root_.SubdiffusiveProcess.Model.aCutoff M l
        (SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega))
        ((3 : ℝ) ^ (l : ℤ) • (z - fun _ => (1 / 2 : ℝ))) =
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M l *
        cutoffCoefficient M (fun _ => 0) (aux_lem_band_rcJ_shift N l x omega) l z := by
  have hahom : SubdiffusiveProcess.CoarseGrainingVocab.ahom M l ≠ 0 := (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M l).ne'
  have h3ne : (3 : ℝ) ≠ 0 := by norm_num
  have hpt : (3 : ℝ) ^ (-(N : ℤ)) • ((3 : ℝ) ^ (l : ℤ) • (z - fun _ => (1 / 2 : ℝ)) + x) =
      aux_lem_band_rcJ_w N l x + (3 : ℝ) ^ (-((N : ℤ) - (l : ℤ))) • z := by
    have h3 : (3 : ℝ) ^ (-(N : ℤ)) * (3 : ℝ) ^ (l : ℤ) = (3 : ℝ) ^ ((l : ℤ) - (N : ℤ)) := by
      rw [← zpow_add₀ h3ne]; congr 1; ring
    have h4 : (-((N : ℤ) - (l : ℤ))) = (l : ℤ) - (N : ℤ) := by ring
    rw [h4]
    unfold aux_lem_band_rcJ_w
    rw [smul_add, smul_smul, h3, smul_sub]
    abel
  set F : ℕ → ℝ := fun k => SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega) k
    ((3 : ℝ) ^ (l : ℤ) • (z - fun _ => (1 / 2 : ℝ))) with hF
  have hterm : ∀ j ∈ Finset.range (l + 1),
      aux_lem_band_rcJ_shift N l x omega (-(Int.ofNat j)) z = F (l - j) := by
    intro j hj
    have hjl : j ≤ l := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    unfold aux_lem_band_rcJ_shift
    rw [aux_lem_band_transport_S_apply, hF]
    show _ = _root_.SubdiffusiveProcess.Model.PotentialField.translate x (eta N omega (l - j)) _
    rw [_root_.SubdiffusiveProcess.Model.PotentialField.translate_apply, heta, hpt]
    congr 2
    rw [Int.ofNat_eq_natCast, Nat.cast_sub hjl]
    ring
  have hrefl : ∑ j ∈ Finset.range (l + 1), F (l - j) = ∑ j ∈ Finset.range (l + 1), F j := by
    have h := Finset.sum_range_reflect F (l + 1)
    simp only [Nat.add_sub_cancel] at h
    exact h
  rw [SubdiffusiveProcess.CoarseGrainingVocab.aCutoff_eq_exp_sub]
  unfold cutoffCoefficient cutoffPotential
  simp only [ContinuousMap.zero_apply, zero_add]
  rw [Finset.sum_congr rfl hterm, hrefl, ← mul_assoc, mul_inv_cancel₀ hahom, one_mul]

theorem aux_lem_band_rcJ_geom {d : ℕ} (g : Homogenization.Vec d → ℝ) (hg : Continuous g)
    (hgpos : ∀ u, 0 < g u) (l : ℕ)
    (A : Homogenization.Book.Ch02.CoeffOn
      (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d (l : ℤ))))
    (hA : A.toCoeffField = SubdiffusiveProcess.CoarseGrainingVocab.scalarCoeffField g)
    (datac : SubdiffusiveProcess.CoarseGrainingVocab.ScalarCoeffOnData (aux_lem_band_rcJ_unitDomain d)
      (fun z => g ((3 : ℝ) ^ (l : ℤ) • (z - fun _ => (1 / 2 : ℝ)))))
    (p q : Homogenization.Vec d) :
    Homogenization.Book.Ch02.responseJ
        (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d (l : ℤ))) A p q =
      Homogenization.Book.Ch02.responseJ (aux_lem_band_rcJ_unitDomain d) datac.toCoeffOn p q := by
  let f0 : Homogenization.Vec d → ℝ := fun y => g ((3 : ℝ) ^ (l : ℤ) • y)
  have hf0 : Continuous f0 := hg.comp (continuous_const_smul _)
  let data0 := Classical.choice
    (SubdiffusiveProcess.CoarseGrainingVocab.Section5Support.exists_scalarCoeffOnData_of_continuous_pos hf0
      (fun y => hgpos _) (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0)))
  have hc0 : Homogenization.cubeCenter (Homogenization.originCube d (l : ℤ)) = 0 := by
    funext i; simp [Homogenization.cubeCenter, Homogenization.originCube]
  have hAe : A.toCoeffField =ᵐ[Homogenization.volumeMeasureOn
      (Homogenization.openCubeSet (Homogenization.originCube d (l : ℤ)))]
      (fun u => Homogenization.scalarMatrix (g u)) := by
    rw [hA]; exact Filter.EventuallyEq.rfl
  have hBe : data0.toCoeffOn.toCoeffField =ᵐ[Homogenization.volumeMeasureOn
      (Homogenization.openCubeSet (Homogenization.originCube d 0))]
      (fun y => Homogenization.scalarMatrix (g (Homogenization.cubeCenter
        (Homogenization.originCube d (l : ℤ)) +
          Homogenization.cubeScaleFactor (Homogenization.originCube d (l : ℤ)) • y))) := by
    rw [hc0, Homogenization.cubeScaleFactor_originCube]
    refine Filter.Eventually.of_forall (fun y => ?_)
    exact (congrArg (fun t => Homogenization.scalarMatrix (g t)) (zero_add _)).symm
  have h1 := aux_rechart_responseJ_eq A data0.toCoeffOn
    (fun u => Homogenization.scalarMatrix (g u)) hAe hBe p q
  rw [h1, Homogenization.Internal.Ch02.book_responseJ_eq_ResponseJ,
    Homogenization.Internal.Ch02.book_responseJ_eq_ResponseJ]
  have hF : data0.toCoeffOn.toCoeffField =
      Homogenization.translateCoeffField (fun _ : Fin d => (1 / 2 : ℝ))
        datac.toCoeffOn.toCoeffField := by
    funext y
    show Homogenization.scalarMatrix (g ((3 : ℝ) ^ (l : ℤ) • y)) =
      Homogenization.scalarMatrix (g ((3 : ℝ) ^ (l : ℤ) •
        ((fun i => y i + (fun _ : Fin d => (1 / 2 : ℝ)) i) - fun _ => (1 / 2 : ℝ))))
    congr 3
    funext i
    simp
  rw [hF, ← Homogenization.ResponseJ_translateSet_eq_translateCoeffField]
  congr 1
  rw [Homogenization.Book.Ch02.cubeDomain_coe]
  exact (aux_lem_band_rcJ_unit_set d).symm

theorem aux_lem_band_rcJ_aCutoffFamily_field {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (l : ℕ)
    (ω0 : _root_.SubdiffusiveProcess.Model.PotentialSample d) (Q : Homogenization.TriadicCube d) :
    ((SubdiffusiveProcess.CoarseGrainingVocab.aCutoffFamily M l ω0).coeffOn Q).toCoeffField =
