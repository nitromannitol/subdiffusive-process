      MeasurableSpace.comap (aux_lem_band_transport_window (d := d) (-(h : ℤ)) (h : ℤ)) inferInstance := by
    rw [_root_.SubdiffusiveProcess.ResponseMoments.bandSigma_eq_comap]; rfl
  have hfac : aux_lem_band_transport_window (d := d) (-(h : ℤ)) 0 =
