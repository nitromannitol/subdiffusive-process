section BandProjection
variable {X : Type*} [MeasurableSpace X]

lemma aux_lem_band_threeBlock_left (p q : ℤ → Prop) [DecidablePred p] [DecidablePred q] :
    leftMiddleSigma.comap (threeBlockEquiv (X := fun _ : ℤ => X) p q) =
      (inferInstance : MeasurableSpace ({i : ℤ // p i} → X)).comap ({i | p i}.domRestrict (π := fun _ : ℤ => X)) := by
  erw [comap_restrict_eq_iSup]
  simp only [leftMiddleSigma, MeasurableSpace.comap_comp]
  change (inferInstance : MeasurableSpace
    (({i : Subtype p // q i} → X) × ({i : Subtype p // ¬q i} → X))).comap
      (fun omega : ℤ → X => ((fun i => omega i.1.1), (fun i => omega i.1.1))) = _
  dsimp only [Prod.instMeasurableSpace]
  rw [MeasurableSpace.comap_prodMk]
  simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  change (⨆ i : {i : Subtype p // q i}, (inferInstance : MeasurableSpace X).comap
      (fun omega : ℤ → X => omega i.1.1)) ⊔
    (⨆ i : {i : Subtype p // ¬q i}, (inferInstance : MeasurableSpace X).comap
      (fun omega : ℤ → X => omega i.1.1)) = _
  apply le_antisymm
  · refine sup_le (iSup_le fun i => ?_) (iSup_le fun i => ?_)
    · exact le_iSup_of_le i.1.1 (le_iSup_of_le i.1.2 le_rfl)
    · exact le_iSup_of_le i.1.1 (le_iSup_of_le i.1.2 le_rfl)
  · refine iSup₂_le fun i hi => ?_
    by_cases hq : q i
    · exact le_sup_of_le_left (le_iSup_of_le ⟨⟨i, hi⟩, hq⟩ le_rfl)
    · exact le_sup_of_le_right (le_iSup_of_le ⟨⟨i, hi⟩, hq⟩ le_rfl)

lemma aux_lem_band_threeBlock_middle (p q : ℤ → Prop) [DecidablePred p] [DecidablePred q] :
    middleSigma.comap (threeBlockEquiv (X := fun _ : ℤ => X) p q) =
      (inferInstance : MeasurableSpace ({i : ℤ // p i ∧ ¬q i} → X)).comap
        ({i | p i ∧ ¬q i}.domRestrict (π := fun _ : ℤ => X)) := by
  erw [comap_restrict_eq_iSup]
  simp only [middleSigma, MeasurableSpace.comap_comp, MeasurableSpace.pi,
    MeasurableSpace.comap_iSup]
  change (⨆ i : {i : Subtype p // ¬q i}, (inferInstance : MeasurableSpace X).comap
      (fun omega : ℤ → X => omega i.1.1)) = _
  apply le_antisymm
  · refine iSup_le fun i => ?_
    exact le_iSup_of_le i.1.1 (le_iSup_of_le ⟨i.1.2, i.2⟩ le_rfl)
  · refine iSup₂_le fun i hi => ?_
    exact le_iSup_of_le ⟨⟨i, hi.1⟩, hi.2⟩ le_rfl

lemma aux_lem_band_threeBlock_middleRight (p q : ℤ → Prop) [DecidablePred p] [DecidablePred q] :
    middleRightSigma.comap (threeBlockEquiv (X := fun _ : ℤ => X) p q) =
      (inferInstance : MeasurableSpace ({i : ℤ // (p i ∧ ¬q i) ∨ ¬p i} → X)).comap
        ({i | (p i ∧ ¬q i) ∨ ¬p i}.domRestrict (π := fun _ : ℤ => X)) := by
  erw [comap_restrict_eq_iSup]
  simp only [middleRightSigma, MeasurableSpace.comap_comp]
  change (inferInstance : MeasurableSpace
    (({i : Subtype p // ¬q i} → X) × ({i : ℤ // ¬p i} → X))).comap
      (fun omega : ℤ → X => ((fun i => omega i.1.1), (fun i => omega i.1))) = _
  dsimp only [Prod.instMeasurableSpace]
  rw [MeasurableSpace.comap_prodMk]
  simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  change (⨆ i : {i : Subtype p // ¬q i}, (inferInstance : MeasurableSpace X).comap
      (fun omega : ℤ → X => omega i.1.1)) ⊔
    (⨆ i : {i : ℤ // ¬p i}, (inferInstance : MeasurableSpace X).comap
      (fun omega : ℤ → X => omega i.1)) = _
  apply le_antisymm
  · refine sup_le (iSup_le fun i => ?_) (iSup_le fun i => ?_)
    · exact le_iSup_of_le i.1.1 (le_iSup_of_le (Or.inl ⟨i.1.2, i.2⟩) le_rfl)
    · exact le_iSup_of_le i.1 (le_iSup_of_le (Or.inr i.2) le_rfl)
  · refine iSup₂_le fun i hi => ?_
    rcases hi with hi | hi
    · exact le_sup_of_le_left (le_iSup_of_le ⟨⟨i, hi.1⟩, hi.2⟩ le_rfl)
    · exact le_sup_of_le_right (le_iSup_of_le ⟨i, hi⟩ le_rfl)

lemma aux_lem_band_aesm_equiv {Ω Ξ : Type*} {m : MeasurableSpace Ξ}
    [MeasurableSpace Ω] [MeasurableSpace Ξ]
    {μ : Measure Ω} {ν : Measure Ξ} (e : Ω ≃ Ξ) (he : MeasurePreserving e.symm ν μ)
    {f : Ω → ℝ} (hf : AEStronglyMeasurable[m.comap e] f μ) :
    AEStronglyMeasurable[m] (f ∘ e.symm) ν := by
  refine ⟨hf.mk f ∘ e.symm, ?_, he.quasiMeasurePreserving.ae_eq_comp hf.ae_eq_mk⟩
  apply hf.stronglyMeasurable_mk.comp_measurable
  apply Measurable.of_comap_le
  simp only [MeasurableSpace.comap_comp, Function.comp_def, e.apply_symm_apply]
  exact (@measurable_id Ξ m).comap_le

lemma aux_lem_band_condexp_fine_only (laws : ℤ → Measure X)
    [∀ j, IsProbabilityMeasure (laws j)] (N h : ℕ) (Y : (ℤ → X) → ℝ)
    (hY : AEStronglyMeasurable[(inferInstance : MeasurableSpace (Set.Icc (-(N : ℤ)) 0 → X)).comap
      ((Set.Icc (-(N : ℤ)) 0).domRestrict (π := fun _ : ℤ => X))] Y (Measure.infinitePi laws)) :
    (Measure.infinitePi laws)[Y | (inferInstance : MeasurableSpace (Set.Icc (-(h : ℤ)) h → X)).comap
      ((Set.Icc (-(h : ℤ)) h).domRestrict (π := fun _ : ℤ => X))] =ᵐ[Measure.infinitePi laws]
    (Measure.infinitePi laws)[Y | (inferInstance : MeasurableSpace (Set.Icc (-(h : ℤ)) 0 → X)).comap
      ((Set.Icc (-(h : ℤ)) 0).domRestrict (π := fun _ : ℤ => X))] := by
  classical
  let μ := Measure.infinitePi laws
  by_cases hYi : Integrable Y μ
  swap
  · have hYi0 : ¬ Integrable Y (Measure.infinitePi laws) := hYi
    simp only [condExp_of_not_integrable hYi0]
    exact Filter.EventuallyEq.rfl
  let p : ℤ → Prop := fun j => j ≤ 0 ∨ (h : ℤ) < j
  let q : ℤ → Prop := fun j => j < -(h : ℤ) ∨ (h : ℤ) < j
  let e := threeBlockEquiv (X := fun _ : ℤ => X) p q
  let ν := ((Measure.infinitePi fun i : {i : Subtype p // q i} => laws i.1.1).prod
      (Measure.infinitePi fun i : {i : Subtype p // ¬q i} => laws i.1.1)).prod
      (Measure.infinitePi fun i : {i : ℤ // ¬p i} => laws i.1)
  have he : MeasurePreserving e μ ν := measurePreserving_infinitePi_threeBlock laws p q
  have hm : middleSigma.comap e =
      (inferInstance : MeasurableSpace (Set.Icc (-(h : ℤ)) 0 → X)).comap
        ((Set.Icc (-(h : ℤ)) 0).domRestrict (π := fun _ : ℤ => X)) := by
    rw [aux_lem_band_threeBlock_middle]
    have hs : {i : ℤ | p i ∧ ¬q i} = Set.Icc (-(h : ℤ)) 0 := by
      ext i
      simp only [mem_ofPred_eq, Set.mem_Icc, p, q]
      omega
    erw [comap_restrict_eq_iSup, comap_restrict_eq_iSup, hs]
  have hmr : middleRightSigma.comap e =
      (inferInstance : MeasurableSpace (Set.Icc (-(h : ℤ)) h → X)).comap
        ((Set.Icc (-(h : ℤ)) h).domRestrict (π := fun _ : ℤ => X)) := by
    rw [aux_lem_band_threeBlock_middleRight]
    have hs : {i : ℤ | (p i ∧ ¬q i) ∨ ¬p i} = Set.Icc (-(h : ℤ)) h := by
      ext i
      simp only [mem_ofPred_eq, Set.mem_Icc, p, q]
      omega
    erw [comap_restrict_eq_iSup, comap_restrict_eq_iSup, hs]
  have hYleft : AEStronglyMeasurable[leftMiddleSigma.comap e] Y μ := by
    apply hY.mono
    erw [aux_lem_band_threeBlock_left, comap_restrict_eq_iSup, comap_restrict_eq_iSup]
    refine iSup₂_le fun i hi => ?_
    exact le_iSup_of_le i (le_iSup_of_le (Or.inl hi.2) le_rfl)
  have hYi' : Integrable (Y ∘ e.symm) ν := (he.symm e).integrable_comp_of_integrable hYi
  have hl : ν[Y ∘ e.symm | leftMiddleSigma] =ᵐ[ν] Y ∘ e.symm :=
    condExp_of_aestronglyMeasurable' measurable_fst.comap_le
      (aux_lem_band_aesm_equiv e.toEquiv (he.symm e) hYleft) hYi'
  have hid : ν[Y ∘ e.symm | middleRightSigma] =ᵐ[ν]
      ν[Y ∘ e.symm | middleSigma] :=
    (condExp_congr_ae hl).symm.trans (condExp_middleRight_condExp_leftMiddle hYi')
  have h1 := condExp_comp_measurableEquiv (m := middleRightSigma) e he
    (((measurable_snd.comp measurable_fst).prodMk measurable_snd).comap_le)
    (f := Y ∘ e.symm) hYi'
  have h2 := condExp_comp_measurableEquiv (m := middleSigma) e he
    ((measurable_snd.comp measurable_fst).comap_le) (f := Y ∘ e.symm) hYi'
  have hfun : (Y ∘ e.symm) ∘ e = Y := by funext omega; simp only [Function.comp_apply, e.symm_apply_apply]
  rw [hfun, hmr] at h1
  rw [hfun, hm] at h2
  exact h1.trans ((he.quasiMeasurePreserving.ae_eq_comp hid).trans h2.symm)

end BandProjection

