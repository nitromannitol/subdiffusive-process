  have hgood : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Rraw N m w omega = aux_prefix_rraw_Rset M s (eta N omega) m w := by
    filter_upwards [hprim] with omega hω
    obtain ⟨_, _, _, _, _, _, hR, _⟩ := hω N
    exact hR m w
  have hRmeas : AEStronglyMeasurable (fun omega => (Rraw N m w omega).toReal)
      (chaosSampleLaw M).toMeasure := by
    have hfull := (aux_lem_prefix_limit_raw_Rraw_bound M s eps hs0 ({q} : Finset ℝ) hMr hM1 eta
      heta F Praw Rraw Draw Z rawGood hprim N n z).1
