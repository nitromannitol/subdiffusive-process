  have hFtop : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, F N m w omega ≠ ⊤ :=
    prefix_eta_raw_Fsc_ae_finite M s eps hs.1 eta heta F Praw Rraw Draw Z rawGood hprim N m w
  have hFtrunctop : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, Ftrunc_ENNReal omega ≠ ⊤ := by
    filter_upwards [hTruncle, hFtop] with omega h1 h2
    exact ne_top_of_le_ne_top h2 h1
  have hFhalfle_bank : ∀ omega, Fhalf_ENNReal omega ≤
      ∑' j : ℕ, prefix_bank_Fmaj (s / 2) m w j (eta N omega) := by
    intro omega
    refine sSup_le ?_
    rintro v ⟨j, rfl⟩
    exact (aux_lem_band_piece_field_term_le_bank (s / 2) m j w (eta N omega)).trans
      (ENNReal.le_tsum (f := fun j => prefix_bank_Fmaj (s / 2) m w j (eta N omega)) j)
  have hbank_ae := prefix_bank_Fmaj_tsum_ae M (s / 2) half_pos m w
  have hpush : ∀ᵐ potential ∂Measure.map (eta N) (chaosSampleLaw M).toMeasure,
      (∑' j : ℕ, prefix_bank_Fmaj (s / 2) m w j potential) ≠ ⊤ := by
    rw [prefix_eta_law M eta heta N]; exact hbank_ae
  have htailfin : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      (∑' j : ℕ, prefix_bank_Fmaj (s / 2) m w j (eta N omega)) ≠ ⊤ :=
    ae_of_ae_map (prefix_eta_aemeasurable M eta heta N) hpush
  have hFhalftop : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, Fhalf_ENNReal omega ≠ ⊤ := by
    filter_upwards [htailfin] with omega hom
    exact ne_top_of_le_ne_top hom (hFhalfle_bank omega)
  have hpoint_real : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      0 ≤ (F N m w omega).toReal - (Ftrunc_ENNReal omega).toReal ∧
      (F N m w omega).toReal - (Ftrunc_ENNReal omega).toReal ≤
        (3 : ℝ) ^ (-(s * (Hnat : ℝ) / 16)) * (Fhalf_ENNReal omega).toReal := by
    filter_upwards [htail_ae, hTruncle, hFtop, hFtrunctop, hFhalftop] with
