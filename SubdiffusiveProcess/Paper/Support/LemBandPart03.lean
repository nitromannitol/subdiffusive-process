  have hbridge := responseJ_eq_affineDiagonalDefect (aux_lem_band_rcJ_unitDomain d) (unitNeumannCube d)
    rfl (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M l) datac (aux_lem_band_rcJ_unit_bdd d) (aux_lem_band_rcJ_unit_vol_pos d)
    (aux_lem_band_rcJ_unit_poincare d).1 (aux_lem_band_rcJ_unit_poincare d).2
    (aux_lem_band_rcJ_aN M l (aux_lem_band_rcJ_shift N l x omega)) (aux_lem_band_rcJ_haQ M eta omega N l x heta) e he
