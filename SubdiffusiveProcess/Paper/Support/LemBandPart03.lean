      _ = eLpNorm (fun omega => ∑' j : ℕ, prefix_real_Fmaj (s / 2) m w j (eta N omega))
            ((2 * qnat : ℕ) : ℝ≥0∞) (chaosSampleLaw M).toMeasure := eLpNorm_congr_ae hcongr_real
      _ ≤ ∑' j : ℕ, ENNReal.ofReal (prefix_even_series_bound M (s / 2) qnat j) :=
