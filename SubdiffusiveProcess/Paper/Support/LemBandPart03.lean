          (fun omega'' => T1 omega'' + T2 omega'' + T3 omega'' + T4 omega'') omega' =
          (aux_lem_band_DT1 M s m w (eta N omega')).toReal +
            (aux_lem_band_DT2 s m w (eta N omega')).toReal +
            (aux_lem_band_DT3 s m w (eta N omega')).toReal +
            (aux_lem_band_DT4 m w (eta N omega')).toReal -
          (T1 omega' + T2 omega' + T3 omega' + T4 omega') := by
      filter_upwards [hDraw_eq] with omega' heq
      show (Draw N m w omega').toReal - (T1 omega' + T2 omega' + T3 omega' + T4 omega') = _
      rw [heq]
    rw [eLpNorm_congr_ae hDraw_eq']
    have hle : MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc ((m : ℤ) - N - (4 * (h + 1) : ℕ)) ((m : ℤ) - N + (4 * (h + 1) : ℕ)) =>
            omega (j : ℤ))
        inferInstance ≤ (inferInstance : MeasurableSpace (BilateralField d)) :=
      (Set.measurable_restrict _).comap_le
    have hT1meas' : AEStronglyMeasurable T1 (chaosSampleLaw M).toMeasure := hT1meas.mono hle
    have hT2meas' : AEStronglyMeasurable T2 (chaosSampleLaw M).toMeasure := hT2meas.mono hle
    have hT3meas' : AEStronglyMeasurable T3 (chaosSampleLaw M).toMeasure := hT3meas.mono hle
    have hT4meas' : AEStronglyMeasurable T4 (chaosSampleLaw M).toMeasure := hT4meas.mono hle
    have hDT1meas : AEStronglyMeasurable
        (fun omega' => (aux_lem_band_DT1 M s m w (eta N omega')).toReal)
        (chaosSampleLaw M).toMeasure :=
      (ENNReal.measurable_toReal.comp_aemeasurable
        ((aux_lem_prefix_limit_actual_Dsc_first_meas M s m w).comp_aemeasurable
          (prefix_eta_aemeasurable M eta heta N))).aestronglyMeasurable
    have hDT2meas : AEStronglyMeasurable
        (fun omega' => (aux_lem_band_DT2 s m w (eta N omega')).toReal)
        (chaosSampleLaw M).toMeasure :=
      (ENNReal.measurable_toReal.comp_aemeasurable
        ((aux_dsc_block_meas s m w).comp_aemeasurable
          (prefix_eta_aemeasurable M eta heta N))).aestronglyMeasurable
    have hDT3meas : AEStronglyMeasurable
        (fun omega' => (aux_lem_band_DT3 s m w (eta N omega')).toReal)
        (chaosSampleLaw M).toMeasure :=
      (ENNReal.measurable_toReal.comp_aemeasurable
        ((dsc_third_summand_meas s m w).comp_aemeasurable
          (prefix_eta_aemeasurable M eta heta N))).aestronglyMeasurable
    have hDT4meas : AEStronglyMeasurable
        (fun omega' => (aux_lem_band_DT4 m w (eta N omega')).toReal)
        (chaosSampleLaw M).toMeasure :=
      (ENNReal.measurable_toReal.comp_aemeasurable
        ((dsc_fourth_summand_meas m w).comp_aemeasurable
          (prefix_eta_aemeasurable M eta heta N))).aestronglyMeasurable
    have heq2 : (fun omega' => (aux_lem_band_DT1 M s m w (eta N omega')).toReal +
        (aux_lem_band_DT2 s m w (eta N omega')).toReal +
        (aux_lem_band_DT3 s m w (eta N omega')).toReal +
        (aux_lem_band_DT4 m w (eta N omega')).toReal -
        (T1 omega' + T2 omega' + T3 omega' + T4 omega')) =
        (fun omega' => ((aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega') +
          ((aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega') +
          ((aux_lem_band_DT3 s m w (eta N omega')).toReal - T3 omega') +
          ((aux_lem_band_DT4 m w (eta N omega')).toReal - T4 omega')) := by
      funext omega'; ring
    rw [heq2]
    have hp' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hq1
    have hstepA : eLpNorm (fun omega' => ((aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega') +
        ((aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega') +
        ((aux_lem_band_DT3 s m w (eta N omega')).toReal - T3 omega'))
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        eLpNorm (fun omega' => ((aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega') +
          ((aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega'))
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure +
        eLpNorm (fun omega' => (aux_lem_band_DT3 s m w (eta N omega')).toReal - T3 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure :=
      eLpNorm_add_le hp'
    have hstepB : eLpNorm (fun omega' => ((aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega') +
        ((aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega'))
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        eLpNorm (fun omega' => (aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure +
        eLpNorm (fun omega' => (aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure :=
      eLpNorm_add_le hp'
    have hstepC : eLpNorm (fun omega' => (((aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega') +
        ((aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega') +
        ((aux_lem_band_DT3 s m w (eta N omega')).toReal - T3 omega')) +
        ((aux_lem_band_DT4 m w (eta N omega')).toReal - T4 omega'))
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        eLpNorm (fun omega' => ((aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega') +
          ((aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega') +
          ((aux_lem_band_DT3 s m w (eta N omega')).toReal - T3 omega'))
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure +
        eLpNorm (fun omega' => (aux_lem_band_DT4 m w (eta N omega')).toReal - T4 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure :=
      eLpNorm_add_le hp'
    have hfin : eLpNorm (fun omega' => ((aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega') +
        ((aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega') +
        ((aux_lem_band_DT3 s m w (eta N omega')).toReal - T3 omega') +
        ((aux_lem_band_DT4 m w (eta N omega')).toReal - T4 omega'))
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        eLpNorm (fun omega' => (aux_lem_band_DT1 M s m w (eta N omega')).toReal - T1 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure +
        eLpNorm (fun omega' => (aux_lem_band_DT2 s m w (eta N omega')).toReal - T2 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure +
        eLpNorm (fun omega' => (aux_lem_band_DT3 s m w (eta N omega')).toReal - T3 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure +
        eLpNorm (fun omega' => (aux_lem_band_DT4 m w (eta N omega')).toReal - T4 omega')
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure :=
      le_trans hstepC (add_le_add (le_trans hstepA (add_le_add hstepB le_rfl)) le_rfl)
    refine hfin.trans ?_
    refine le_trans (add_le_add (add_le_add (add_le_add hT1bound hT2bound) hT3bound) hT4bound) ?_
    have hCeq : ENNReal.ofReal (C1 * (3 : ℝ) ^ (-(a1D * (h : ℝ)))) +
        ENNReal.ofReal (C2 * (3 : ℝ) ^ (-(a2 * (h : ℝ)))) +
        ENNReal.ofReal (C3 * (3 : ℝ) ^ (-(a3 * (h : ℝ)))) +
        ENNReal.ofReal (C4 * (3 : ℝ) ^ (-(a4 * (h : ℝ)))) =
        ENNReal.ofReal (C1 * (3 : ℝ) ^ (-(a1D * (h : ℝ))) + C2 * (3 : ℝ) ^ (-(a2 * (h : ℝ))) +
          C3 * (3 : ℝ) ^ (-(a3 * (h : ℝ))) + C4 * (3 : ℝ) ^ (-(a4 * (h : ℝ)))) := by
      rw [ENNReal.ofReal_add (by positivity) (by positivity),
        ENNReal.ofReal_add (by positivity) (by positivity),
        ENNReal.ofReal_add (by positivity) (by positivity)]
    rw [hCeq]
    apply ENNReal.ofReal_le_ofReal
    have hweaken1 : (3 : ℝ) ^ (-(a1D * (h : ℝ))) ≤
        (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have : min a1D (min a2 (min a3 a4)) ≤ a1D := min_le_left _ _
      nlinarith [this, Nat.cast_nonneg (α := ℝ) h]
    have hweaken2 : (3 : ℝ) ^ (-(a2 * (h : ℝ))) ≤
        (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have : min a1D (min a2 (min a3 a4)) ≤ a2 := le_trans (min_le_right _ _) (min_le_left _ _)
      nlinarith [this, Nat.cast_nonneg (α := ℝ) h]
    have hweaken3 : (3 : ℝ) ^ (-(a3 * (h : ℝ))) ≤
        (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have : min a1D (min a2 (min a3 a4)) ≤ a3 :=
        le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
      nlinarith [this, Nat.cast_nonneg (α := ℝ) h]
    have hweaken4 : (3 : ℝ) ^ (-(a4 * (h : ℝ))) ≤
        (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have : min a1D (min a2 (min a3 a4)) ≤ a4 :=
        le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
      nlinarith [this, Nat.cast_nonneg (α := ℝ) h]
    calc C1 * (3 : ℝ) ^ (-(a1D * (h : ℝ))) + C2 * (3 : ℝ) ^ (-(a2 * (h : ℝ))) +
          C3 * (3 : ℝ) ^ (-(a3 * (h : ℝ))) + C4 * (3 : ℝ) ^ (-(a4 * (h : ℝ)))
        ≤ C1 * (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) +
          C2 * (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) +
          C3 * (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) +
          C4 * (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) := by
          gcongr
      _ = (C1 + C2 + C3 + C4) * (3 : ℝ) ^ (-(min a1D (min a2 (min a3 a4)) * (h : ℝ))) := by ring

theorem aux_lem_band_eramp_abs_le (lo hi : ℝ) (hlo : 0 ≤ lo) (hlohi : lo < hi) {x y : ℝ≥0∞}
    (hx : x ≠ ⊤) (hy : y ≠ ⊤) :
    |(min (1 : ℝ≥0∞) ((x - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
      (min (1 : ℝ≥0∞) ((y - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal|
    ≤ (hi - lo)⁻¹ * |x.toReal - y.toReal| := by
  have hcpos : 0 < hi - lo := sub_pos.mpr hlohi
  have hval : ∀ (z : ℝ≥0∞), z ≠ ⊤ →
      (min (1 : ℝ≥0∞) ((z - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal
        = max (min 1 ((z.toReal - lo) / (hi - lo))) 0 := by
    intro z hz
    have hsub : z - ENNReal.ofReal lo = ENNReal.ofReal (z.toReal - lo) := by
      conv_lhs => rw [← ENNReal.ofReal_toReal hz]
      rw [← ENNReal.ofReal_sub z.toReal hlo]
    have hdiv : ENNReal.ofReal (z.toReal - lo) / ENNReal.ofReal (hi - lo)
        = ENNReal.ofReal ((z.toReal - lo) / (hi - lo)) :=
      (ENNReal.ofReal_div_of_pos hcpos).symm
    rw [hsub, hdiv, ← ENNReal.ofReal_one, ← ENNReal.ofReal_min, ENNReal.toReal_ofReal']
  rw [hval x hx, hval y hy]
  have h1 : |max (min 1 ((x.toReal - lo) / (hi - lo))) 0 -
        max (min 1 ((y.toReal - lo) / (hi - lo))) 0| ≤
      |min 1 ((x.toReal - lo) / (hi - lo)) - min 1 ((y.toReal - lo) / (hi - lo))| :=
    abs_max_sub_max_le_abs _ _ _
  have h2 : |min 1 ((x.toReal - lo) / (hi - lo)) - min 1 ((y.toReal - lo) / (hi - lo))| ≤
      |(x.toReal - lo) / (hi - lo) - (y.toReal - lo) / (hi - lo)| := by
    have h := abs_min_sub_min_le_max (1 : ℝ) ((x.toReal - lo) / (hi - lo)) 1
      ((y.toReal - lo) / (hi - lo))
    rwa [sub_self, abs_zero, max_eq_right (abs_nonneg _)] at h
  have h3 : |(x.toReal - lo) / (hi - lo) - (y.toReal - lo) / (hi - lo)|
      = (hi - lo)⁻¹ * |x.toReal - y.toReal| := by
    rw [div_sub_div_same,
      show (x.toReal - lo) - (y.toReal - lo) = x.toReal - y.toReal from by ring]
    rw [abs_div, abs_of_pos hcpos, div_eq_mul_inv, mul_comm]
  exact le_trans h1 (le_trans h2 (le_of_eq h3))

theorem aux_lem_band_eramp_continuous (lo hi : ℝ) (hlohi : lo < hi) :
    Continuous (fun x : ℝ≥0∞ =>
      (min (1 : ℝ≥0∞) ((x - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal) := by
  have hpos : (0 : ℝ) < hi - lo := sub_pos.mpr hlohi
  have hne : ENNReal.ofReal (hi - lo) ≠ 0 :=
    ENNReal.ofReal_eq_zero.not.mpr (not_le.mpr hpos)
  have hf : Continuous (fun x : ℝ≥0∞ =>
      min (1 : ℝ≥0∞) ((x - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))) :=
    continuous_const.min
      ((ENNReal.continuous_div_const _ hne).comp (ENNReal.continuous_sub_right _))
  exact ENNReal.continuousOn_toReal.comp_continuous hf (fun x =>
    ne_top_of_lt (lt_of_le_of_lt (min_le_left _ _) ENNReal.one_lt_top))

theorem aux_lem_band_eramp_eLpNorm_le {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (p : ℝ≥0∞) (lo hi : ℝ) (hlo : 0 ≤ lo) (hlohi : lo < hi)
    (F G : Ω → ℝ≥0∞) (hF : ∀ᵐ ω ∂μ, F ω ≠ ⊤) (hG : ∀ᵐ ω ∂μ, G ω ≠ ⊤) :
    RawLp.eLpNorm (fun ω =>
        (min (1 : ℝ≥0∞) ((F ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
        (min (1 : ℝ≥0∞) ((G ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal) p μ ≤
      ENNReal.ofReal (hi - lo)⁻¹ * RawLp.eLpNorm (fun ω => (F ω).toReal - (G ω).toReal) p μ := by
  exact aux_lem_band_piece_product_eramp_eLpNorm_le p lo hi hlo hlohi F G hF hG

theorem aux_lem_band_eramp_guarded_le {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (p : ℝ≥0∞) (lo hi : ℝ) (hlo : 0 ≤ lo) (hlohi : lo < hi)
    (F G : Ω → ℝ≥0∞) (hF : ∀ᵐ ω ∂μ, F ω ≠ ⊤) (hG : ∀ᵐ ω ∂μ, G ω ≠ ⊤)
    (hFm : AEStronglyMeasurable (fun ω => (F ω).toReal) μ)
    (hGm : AEStronglyMeasurable (fun ω => (G ω).toReal) μ) :
    eLpNorm (fun ω =>
        (min (1 : ℝ≥0∞) ((F ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
        (min (1 : ℝ≥0∞) ((G ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal) p μ ≤
      ENNReal.ofReal (hi - lo)⁻¹ * eLpNorm (fun ω => (F ω).toReal - (G ω).toReal) p μ := by
  have full (X : Ω → ENNReal) (hX : ∀ᵐ ω ∂μ, X ω ≠ ⊤)
      (hm : AEStronglyMeasurable (fun ω => (X ω).toReal) μ) : AEMeasurable X μ :=
    hm.aemeasurable.ennreal_ofReal.congr (hX.mono fun ω h => ENNReal.ofReal_toReal h)
  exact aux_lem_band_piece_product_eramp_guarded_le p lo hi hlo hlohi F G hF hG
    (full F hF hFm) (full G hG hGm)

def aux_lem_band_piece_field_normOn {d : ℕ} (W : Set (Vec d)) (f : Vec d → ℝ) : ENNReal :=
  sSup {v : ENNReal | ∃ x : Vec d, x ∈ W ∧ v = ENNReal.ofReal |f x|}

def aux_lem_band_piece_field_term {d : ℕ} (s : ℝ) (m : ℕ) (z : Vec d)
    (potential : _root_.SubdiffusiveProcess.Model.PotentialSample d) (j : ℕ) : ENNReal :=
  ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
    ∑ i ∈ Finset.Icc (m - j) (m + j),
      aux_lem_band_piece_field_normOn (translatedCube d (m + 1 + j) z)
        (fun x : Vec d => |potential i x| + (3 : ℝ) ^ (i : ℝ) *
          Homogenization.euclideanNorm (shellGradient (potential i) x))

theorem aux_lem_band_piece_field_term_le_bank {d : ℕ}
    (s : ℝ) (m j : ℕ) (z : Vec d) (potential : _root_.SubdiffusiveProcess.Model.PotentialSample d) :
    aux_lem_band_piece_field_term s m z potential j ≤ prefix_bank_Fmaj s m z j potential := by
  exact prefix_raw_field_term_le_bank s m j z potential

theorem aux_lem_band_piece_field_tail_dominance
    (s : ℝ) (hs : 0 < s) (S : ℕ → ENNReal) (H : ℕ) :
    (sSup {v : ENNReal | ∃ j : ℕ,
        v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * S j}) ≤
      (sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
          v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * S j}) +
      ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
        (sSup {v : ENNReal | ∃ j : ℕ,
          v = ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * S j}) := by
  refine sSup_le ?_
  rintro v ⟨j, rfl⟩
  rcases le_or_gt j H with hjH | hjH
  · have hmem : ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * S j ≤
        sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
          v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * S j} :=
      le_sSup ⟨j, hjH, rfl⟩
    exact hmem.trans (le_add_of_nonneg_right (zero_le))
  · have hhalf_le : ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * S j ≤
        sSup {v : ENNReal | ∃ j : ℕ,
          v = ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * S j} :=
      le_sSup ⟨j, rfl⟩
    have hsplit : ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) =
        ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 16))) *
          ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) := by
      rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _),
        ← Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
      congr 2
      ring
    have hrate_mono : ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 16))) ≤
        ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) := by
      refine ENNReal.ofReal_le_ofReal ?_
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 3)
      have hHj : (H : ℝ) ≤ (j : ℝ) := by exact_mod_cast hjH.le
      nlinarith
    have hterm_le : ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * S j ≤
        ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
          (sSup {v : ENNReal | ∃ j : ℕ,
            v = ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * S j}) := by
      calc ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * S j
          = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 16))) *
              (ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * S j) := by
            rw [hsplit, mul_assoc]
        _ ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
              (ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * S j) := by gcongr
        _ ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
              (sSup {v : ENNReal | ∃ j : ℕ,
                v = ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * S j}) := by gcongr
    exact hterm_le.trans (le_add_of_nonneg_left (zero_le))

theorem aux_lem_band_piece_field_inner_meas {d : ℕ} (i : ℕ) (cubeIdx : ℤ) (z : Vec d) :
    Measurable (fun omega : _root_.SubdiffusiveProcess.Model.PotentialSample d =>
      sSup {w : ENNReal | ∃ x ∈ translatedCube d cubeIdx z,
        w = ENNReal.ofReal |(|omega i x| + (3 : ℝ) ^ (i : ℝ) *
          Homogenization.euclideanNorm (shellGradient (omega i) x))|}) := by
  have hcont : ∀ omega : _root_.SubdiffusiveProcess.Model.PotentialSample d, Continuous (fun x : Vec d =>
      ENNReal.ofReal |(|omega i x| + (3 : ℝ) ^ (i : ℝ) *
        Homogenization.euclideanNorm (shellGradient (omega i) x))|) := by
    intro omega
    exact ENNReal.continuous_ofReal.comp
      (((_root_.SubdiffusiveProcess.Model.PotentialField.contDiff_one (omega i)).continuous.abs.add
        (continuous_const.mul
          (SubdiffusiveProcess.CoarseGrainingVocab.Section6CutoffRegularity.continuous_euclideanNorm.comp
            (SubdiffusiveProcess.CoarseGrainingVocab.Section6CutoffRegularity.continuous_shellGradient
              (omega i))))).abs)
  have hmeas : ∀ x : Vec d, Measurable (fun omega : _root_.SubdiffusiveProcess.Model.PotentialSample d =>
      ENNReal.ofReal |(|omega i x| + (3 : ℝ) ^ (i : ℝ) *
        Homogenization.euclideanNorm (shellGradient (omega i) x))|) := by
    intro x
    exact (continuous_abs.measurable.comp
      ((continuous_abs.measurable.comp
        ((_root_.SubdiffusiveProcess.Model.PotentialField.measurable_eval x).comp
          (_root_.SubdiffusiveProcess.Model.measurable_potentialCoordinate i))).add
        (measurable_const.mul
          (SubdiffusiveProcess.CoarseGrainingVocab.Section6CutoffRegularity.continuous_euclideanNorm.measurable.comp
            (SubdiffusiveProcess.CoarseGrainingVocab.Section6CutoffRegularity.measurable_shellGradient_eval
              x i))))).ennreal_ofReal
  have h := aux_lem_band_piece_field_spatial_sup_meas
    (SubdiffusiveProcess.CoarseGrainingVocab.Section6CutoffRegularity.isOpen_translatedCube d cubeIdx z)
    (fun (omega : _root_.SubdiffusiveProcess.Model.PotentialSample d) x => ENNReal.ofReal
      |(|omega i x| + (3 : ℝ) ^ (i : ℝ) *
        Homogenization.euclideanNorm (shellGradient (omega i) x))|)
    hcont hmeas
  convert h using 1

theorem aux_lem_band_piece_field_trunc_meas {d : ℕ} (s : ℝ) (m : ℕ) (z : Vec d) (H : ℕ) :
    Measurable (fun potential : _root_.SubdiffusiveProcess.Model.PotentialSample d =>
      sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = aux_lem_band_piece_field_term s m z potential j}) := by
  have hterm : ∀ k : Fin (H + 1),
      Measurable (fun potential : _root_.SubdiffusiveProcess.Model.PotentialSample d =>
        ENNReal.ofReal ((3 : ℝ) ^ (-(s * ((k : ℕ) : ℝ) / 8))) *
          ∑ i ∈ Finset.Icc (m - (k : ℕ)) (m + (k : ℕ)),
            aux_lem_band_piece_field_normOn (translatedCube d (m + 1 + (k : ℕ)) z)
              (fun x : Vec d => |potential i x| + (3 : ℝ) ^ (i : ℝ) *
                Homogenization.euclideanNorm (shellGradient (potential i) x))) := by
    intro k
    apply Measurable.const_mul
    apply Finset.measurable_sum
    intro i _
    change Measurable (fun potential : _root_.SubdiffusiveProcess.Model.PotentialSample d =>
      sSup {w : ENNReal | ∃ x ∈ translatedCube d (m + 1 + (k : ℕ)) z,
        w = ENNReal.ofReal |(|potential i x| + (3 : ℝ) ^ (i : ℝ) *
          Homogenization.euclideanNorm (shellGradient (potential i) x))|})
    exact aux_lem_band_piece_field_inner_meas i (m + 1 + (k : ℕ)) z
  have heq : (fun potential : _root_.SubdiffusiveProcess.Model.PotentialSample d =>
      sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = aux_lem_band_piece_field_term s m z potential j}) =
      (fun potential => sSup (Set.range (fun k : Fin (H + 1) =>
        aux_lem_band_piece_field_term s m z potential (k : ℕ)))) := by
    funext potential
    congr 1
    ext v
    simp only [mem_ofPred_eq, Set.mem_range]
    constructor
    · rintro ⟨j, hj, rfl⟩
      exact ⟨⟨j, by omega⟩, rfl⟩
    · rintro ⟨⟨j, hj⟩, rfl⟩
      exact ⟨j, by omega, rfl⟩
  rw [heq]
  exact Measurable.iSup hterm

def aux_lem_band_piece_field_Gval {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (s : ℝ) (m N : ℕ) (n : ℤ) (H : ℕ) (w : Vec d)
    (layers : Set.Icc (-n - (H : ℕ)) (-n + (H : ℕ)) → C(SpatialCoordinates d, ℝ)) : ENNReal :=
  sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
    v = aux_lem_band_piece_field_term s m w (aux_lem_band_piece_field_reconstruct N n H layers) j}

theorem aux_lem_band_piece_field_Gval_measurable {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (s : ℝ) (m N : ℕ) (n : ℤ) (H : ℕ) (w : Vec d) :
    Measurable (aux_lem_band_piece_field_Gval s m N n H w) :=
  (aux_lem_band_piece_field_trunc_meas s m w H).comp
    (aux_lem_band_piece_field_reconstruct_measurable N n H)

theorem aux_lem_band_piece_field_footprint
    (N m : ℕ) (n : ℤ) (H j i : ℕ)
    (hn : n ≤ (N : ℤ)) (hm : m = ((N : ℤ) - n).toNat)
    (hjH : j ≤ H) (hi1 : m - j ≤ i) (hi2 : i ≤ m + j) :
    (i : ℤ) - (N : ℤ) ∈ Set.Icc (-n - (H : ℕ)) (-n + (H : ℕ)) := by
  have hNn_nonneg : (0 : ℤ) ≤ (N : ℤ) - n := by linarith
  have hm' : (m : ℤ) = (N : ℤ) - n := by rw [hm]; exact Int.toNat_of_nonneg hNn_nonneg
  simp only [Set.mem_Icc]
  omega

theorem aux_lem_band_piece_field_Ftrunc_measurable
    {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (s : ℝ) (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (N m : ℕ) (w : Vec d) (n : ℤ) (H : ℕ)
    (hn : n ≤ (N : ℤ)) (hm : m = ((N : ℤ) - n).toNat) :
    AEStronglyMeasurable[MeasurableSpace.comap
      (fun omega : BilateralField d =>
        fun j : Set.Icc (-n - (H : ℕ)) (-n + (H : ℕ)) => omega (j : ℤ))
      inferInstance]
      (fun omega : BilateralField d => sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = aux_lem_band_piece_field_term s m w (eta N omega) j})
      (chaosSampleLaw M).toMeasure := by
  show AEStronglyMeasurable[MeasurableSpace.comap (aux_lem_band_piece_field_proj (d := d) n H)
      inferInstance]
    (fun omega : BilateralField d => sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
      v = aux_lem_band_piece_field_term s m w (eta N omega) j})
    (chaosSampleLaw M).toMeasure
  have hGmeas : Measurable[MeasurableSpace.comap (aux_lem_band_piece_field_proj (d := d) n H)
      inferInstance]
      (aux_lem_band_piece_field_Gval s m N n H w ∘ aux_lem_band_piece_field_proj (d := d) n H) :=
    (aux_lem_band_piece_field_Gval_measurable s m N n H w).comp
      (comap_measurable (aux_lem_band_piece_field_proj (d := d) n H))
  have hae : (fun omega : BilateralField d => sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = aux_lem_band_piece_field_term s m w (eta N omega) j}) =ᵐ[(chaosSampleLaw M).toMeasure]
      (aux_lem_band_piece_field_Gval s m N n H w ∘ aux_lem_band_piece_field_proj (d := d) n H) := by
    filter_upwards [aux_lem_band_piece_field_eta_eq M eta heta] with omega hw
    have hpf_eq : ∀ i : ℕ, (i : ℤ) - (N : ℤ) ∈ Set.Icc (-n - (H : ℕ)) (-n + (H : ℕ)) →
        eta N omega i =
          aux_lem_band_piece_field_reconstruct N n H
            (aux_lem_band_piece_field_proj n H omega) i := by
      intro i hmem
      unfold aux_lem_band_piece_field_reconstruct aux_lem_band_piece_field_extend
      rw [dite_eq_left hmem]
      exact hw N i
    have hterm_eq : ∀ j : ℕ, j ≤ H →
        aux_lem_band_piece_field_term s m w (eta N omega) j =
        aux_lem_band_piece_field_term s m w
          (aux_lem_band_piece_field_reconstruct N n H
            (aux_lem_band_piece_field_proj n H omega)) j := by
      intro j hjH
      unfold aux_lem_band_piece_field_term
      have hsum_eq : (∑ i ∈ Finset.Icc (m - j) (m + j),
          aux_lem_band_piece_field_normOn (translatedCube d (m + 1 + j) w)
            (fun x : Vec d => |eta N omega i x| + (3 : ℝ) ^ (i : ℝ) *
              Homogenization.euclideanNorm (shellGradient (eta N omega i) x))) =
          (∑ i ∈ Finset.Icc (m - j) (m + j),
          aux_lem_band_piece_field_normOn (translatedCube d (m + 1 + j) w)
            (fun x : Vec d => |aux_lem_band_piece_field_reconstruct N n H
                (aux_lem_band_piece_field_proj n H omega) i x| + (3 : ℝ) ^ (i : ℝ) *
              Homogenization.euclideanNorm (shellGradient
                (aux_lem_band_piece_field_reconstruct N n H
                  (aux_lem_band_piece_field_proj n H omega) i) x))) := by
        refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi1 : m - j ≤ i := (Finset.mem_Icc.mp hi).1
        have hi2 : i ≤ m + j := (Finset.mem_Icc.mp hi).2
        have hmem := aux_lem_band_piece_field_footprint N m n H j i hn hm hjH hi1 hi2
        rw [hpf_eq i hmem]
      rw [hsum_eq]
    show sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = aux_lem_band_piece_field_term s m w (eta N omega) j} =
      aux_lem_band_piece_field_Gval s m N n H w (aux_lem_band_piece_field_proj n H omega)
    unfold aux_lem_band_piece_field_Gval
    congr 1
    ext v
    simp only [mem_ofPred_eq]
    constructor
    · rintro ⟨j, hjH, rfl⟩
      exact ⟨j, hjH, hterm_eq j hjH⟩
    · rintro ⟨j, hjH, rfl⟩
      exact ⟨j, hjH, (hterm_eq j hjH).symm⟩
  exact hGmeas.aestronglyMeasurable.congr hae.symm

theorem aux_lem_band_piece_field_F_baseline
    {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (s eps : ℝ) (hs : 0 < s)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (hprim : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
      primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (N m : ℕ) (z : Vec d) (qnat : ℕ) (hq : 1 ≤ qnat) :
    eLpNorm (fun omega => (F N m z omega).toReal) ((2 * qnat : ℕ) : ℝ≥0∞)
      (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (aux_psf_sigma M * ∑' j : ℕ,
        (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) * ((2 * j + 1 : ℕ) : ℝ) *
          (2 * ((qnat : ℝ) + 1 + prefix_log_card d j))) := by
  have hm := (aux_lem_prefix_limit_actual_Fsc_raw_aemeas M s eps (chaosSampleLaw M).toMeasure
    eta (fun N => prefix_eta_aemeasurable M eta heta N) F Praw Rraw Draw Z rawGood hprim N m z).aestronglyMeasurable
  rw [← RawLp.eLpNorm_eq_guarded hm]
  refine (prefix_eta_raw_Fsc_eLpNorm_even M s eps hs eta heta F Praw Rraw Draw Z rawGood hprim
    N m z qnat hq).trans ?_
  have heq : (∑' j : ℕ, prefix_even_series_bound M s qnat j) =
      aux_psf_sigma M * ∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) * ((2 * j + 1 : ℕ) : ℝ) *
        (2 * ((qnat : ℝ) + 1 + prefix_log_card d j)) := by
    rw [← tsum_mul_left]
    congr 1
    funext j
    show prefix_even_series_bound M s qnat j = _
    unfold prefix_even_series_bound
    ring
  have hfinal : (∑' j : ℕ, ENNReal.ofReal (prefix_even_series_bound M s qnat j)) =
      ENNReal.ofReal (aux_psf_sigma M * ∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) *
        ((2 * j + 1 : ℕ) : ℝ) * (2 * ((qnat : ℝ) + 1 + prefix_log_card d j))) := by
    rw [← ENNReal.ofReal_tsum_of_nonneg (prefix_even_series_bound_nonneg M s qnat)
      (prefix_even_series_bound_summable M s hs qnat), heq]
  exact le_of_eq hfinal

theorem aux_lem_band_piece_field_Dcombine {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (N m : ℕ) (w : Vec d)
    (CD : ℝ → ℝ) (q p : ℝ) (hpq : p ≤ q) (_hq1 : (1 : ℝ) ≤ q)
    (hCDq : 0 < CD q)
    (hDmemlp : MemLp (fun omega => (Draw N m w omega).toReal)
      (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure)
    (hDbase : eLpNorm (fun omega => (Draw N m w omega).toReal)
      (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (CD q * M.delta ^ (1 / 2 : ℝ)))
    (a1_gap C_gap a0 : ℝ) (h : ℕ)
    (ha0 : a0 ≤ a1_gap / 2) (hCgap_nn : 0 ≤ C_gap)
    (hMdelta_pos : 0 < M.delta) (hMdelta_le_one : M.delta ≤ 1)
    (n : ℤ)
    (Dtrunc : BilateralField d → ℝ)
    (hDtruncmeas : AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (4 * (h + 1) : ℕ)) (-n + (4 * (h + 1) : ℕ)) => omega (j : ℤ))
        inferInstance] Dtrunc (chaosSampleLaw M).toMeasure)
    (hDtrunc : eLpNorm (fun omega => (Draw N m w omega).toReal - Dtrunc omega)
      (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (C_gap * (3 : ℝ) ^ (-(a1_gap * (h : ℝ))))) :
    ∃ Dband : BilateralField d → ℝ, AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (4 * (h + 1) : ℕ)) (-n + (4 * (h + 1) : ℕ)) => omega (j : ℤ))
        inferInstance] Dband (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega => (Draw N m w omega).toReal - Dband omega)
        (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (2 * Real.sqrt (CD q * C_gap) * (M.delta ^ (1 / 4 : ℝ) *
          (3 : ℝ) ^ (-(a0 * (h : ℝ))))) := by
  have hle : MeasurableSpace.comap
      (fun omega : BilateralField d =>
        fun j : Set.Icc (-n - (4 * (h + 1) : ℕ)) (-n + (4 * (h + 1) : ℕ)) => omega (j : ℤ))
      inferInstance ≤ (inferInstance : MeasurableSpace (BilateralField d)) :=
    (Set.measurable_restrict _).comap_le
  have hDrawmeas : AEStronglyMeasurable (fun omega => (Draw N m w omega).toReal)
      (chaosSampleLaw M).toMeasure := hDmemlp.aestronglyMeasurable
  have hpq' : ENNReal.ofReal p ≤ ENNReal.ofReal q := ENNReal.ofReal_le_ofReal hpq
  have hDbase0 : eLpNorm (fun omega => (Draw N m w omega).toReal - 0) (ENNReal.ofReal p)
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (CD q * (M.delta ^ (1 / 2 : ℝ)) ^ (1 : ℕ)) := by
    have hcast : (fun omega => (Draw N m w omega).toReal - (0 : ℝ))
        = fun omega => (Draw N m w omega).toReal := by funext omega; ring
    rw [hcast, pow_one]
    exact (eLpNorm_le_eLpNorm_of_exponent_le hpq').trans hDbase
  have hDtruncmeas' : AEStronglyMeasurable Dtrunc (chaosSampleLaw M).toMeasure :=
    hDtruncmeas.mono hle
  have hDtrunc' : eLpNorm (fun omega => (Draw N m w omega).toReal - Dtrunc omega)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (C_gap * (3 : ℝ) ^ (-(a1_gap * (h : ℝ)))) :=
    (eLpNorm_le_eLpNorm_of_exponent_le hpq').trans hDtrunc
  obtain ⟨Dband, hDbandmeas, hDbandbound⟩ := aux_lem_band_err_case_split
    (fun omega => (Draw N m w omega).toReal) 0 Dtrunc hDtruncmeas
    (ENNReal.ofReal p) (CD q) C_gap (M.delta ^ (1 / 2 : ℝ)) ((3 : ℝ) ^ (-(a1_gap * (h : ℝ)))) 1
    hCDq.le hCgap_nn (Real.rpow_nonneg hMdelta_pos.le _)
    (Real.rpow_nonneg (by norm_num) _) hDbase0 hDtrunc'
  refine ⟨Dband, hDbandmeas, ?_⟩
  have hDrw : 2 * Real.sqrt (CD q * C_gap) *
      Real.sqrt ((M.delta ^ (1 / 2 : ℝ)) ^ (1 : ℕ) * (3 : ℝ) ^ (-(a1_gap * (h : ℝ)))) =
      2 * Real.sqrt (CD q * C_gap) * M.delta ^ (1 / 4 : ℝ) *
        (3 : ℝ) ^ (-(a1_gap / 2 * (h : ℝ))) := by
    rw [pow_one, Real.sqrt_mul (Real.rpow_nonneg hMdelta_pos.le _)]
    have hd4 : Real.sqrt (M.delta ^ (1 / 2 : ℝ)) = M.delta ^ (1 / 4 : ℝ) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hMdelta_pos.le]; norm_num
    have h3a : Real.sqrt ((3 : ℝ) ^ (-(a1_gap * (h : ℝ)))) = (3 : ℝ) ^ (-(a1_gap / 2 * (h : ℝ))) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
      congr 1; ring
    rw [hd4, h3a]; ring
  have hDbandbound' : eLpNorm (fun omega => (Draw N m w omega).toReal - Dband omega)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (2 * Real.sqrt (CD q * C_gap) * M.delta ^ (1 / 4 : ℝ) *
        (3 : ℝ) ^ (-(a1_gap / 2 * (h : ℝ)))) := by
    rw [← hDrw]; exact hDbandbound
  exact aux_lem_band_piece_field_weaken (fun omega => (Draw N m w omega).toReal - Dband omega)
    (ENNReal.ofReal p) (2 * Real.sqrt (CD q * C_gap)) M.delta (1 / 4) (1 / 4)
    (a1_gap / 2) a0 h hMdelta_pos hMdelta_le_one le_rfl ha0 (by positivity) hDbandbound'

theorem aux_lem_band_piece_field_combine2 {Omega : Type*} [MeasurableSpace Omega]
    {mu : Measure Omega}
    (wD wF : ℝ) (hwD : 0 ≤ wD) (hwF : 0 ≤ wF)
    (X Y Dband Fband : Omega → ℝ) (p : ℝ≥0∞) (hp' : 1 ≤ p)
    (CDcoef CFcoef rate : ℝ) (hrate_nonneg : 0 ≤ rate)
    (hCDcoef_nonneg : 0 ≤ CDcoef) (hCFcoef_nonneg : 0 ≤ CFcoef)
    (hDrawmeas : AEStronglyMeasurable X mu) (hErampmeas : AEStronglyMeasurable Y mu)
    (hDbandmeas' : AEStronglyMeasurable Dband mu) (hFbandmeas' : AEStronglyMeasurable Fband mu)
    (hDbound : eLpNorm (fun om => X om - Dband om) p mu ≤ ENNReal.ofReal (CDcoef * rate))
    (hFbound : eLpNorm (fun om => Y om - Fband om) p mu ≤ ENNReal.ofReal (CFcoef * rate)) :
    eLpNorm (fun om => (wD * X om + wF * Y om) - (wD * Dband om + wF * Fband om)) p mu ≤
      ENNReal.ofReal ((wD * CDcoef + wF * CFcoef) * rate) := by
  have hDscaledmeas : AEStronglyMeasurable (fun om => wD * (X om - Dband om)) mu :=
    (hDrawmeas.sub hDbandmeas').const_mul _
  have hFscaledmeas : AEStronglyMeasurable (fun om => wF * (Y om - Fband om)) mu :=
    (hErampmeas.sub hFbandmeas').const_mul _
  have hDpart : eLpNorm (fun om => wD * (X om - Dband om)) p mu ≤
      ENNReal.ofReal (wD * (CDcoef * rate)) :=
    aux_lem_band_piece_field_scale wD hwD (fun om => X om - Dband om) p (CDcoef * rate) hDbound
  have hFpart : eLpNorm (fun om => wF * (Y om - Fband om)) p mu ≤
      ENNReal.ofReal (wF * (CFcoef * rate)) :=
    aux_lem_band_piece_field_scale wF hwF (fun om => Y om - Fband om) p (CFcoef * rate) hFbound
  have hkey : (fun om => (wD * X om + wF * Y om) - (wD * Dband om + wF * Fband om))
      = (fun om => wD * (X om - Dband om) + wF * (Y om - Fband om)) := by funext om; ring
  rw [hkey]
  calc eLpNorm (fun om => wD * (X om - Dband om) + wF * (Y om - Fband om)) p mu
      ≤ eLpNorm (fun om => wD * (X om - Dband om)) p mu +
          eLpNorm (fun om => wF * (Y om - Fband om)) p mu :=
      eLpNorm_add_le hp'
    _ ≤ ENNReal.ofReal (wD * (CDcoef * rate)) + ENNReal.ofReal (wF * (CFcoef * rate)) :=
      add_le_add hDpart hFpart
    _ = ENNReal.ofReal (wD * (CDcoef * rate) + wF * (CFcoef * rate)) := by
        rw [← ENNReal.ofReal_add (mul_nonneg hwD (mul_nonneg hCDcoef_nonneg hrate_nonneg))
          (mul_nonneg hwF (mul_nonneg hCFcoef_nonneg hrate_nonneg))]
    _ = ENNReal.ofReal ((wD * CDcoef + wF * CFcoef) * rate) := by ring_nf

theorem aux_lem_band_piece_field
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d)
    (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (D : _root_.SubdiffusiveProcess.Paper.deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s sigma eps : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (_hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1)
    (heps : eps ∈ Set.Ioo (0 : ℝ) 1)
    (T : ℕ) (offset : Fin T → ℤ) (_shift : Fin T → SpatialCoordinates d)
    (weight : Fin 4 → ℝ) (hweight : ∀ i, 0 ≤ weight i)
    (Klip : ℝ≥0)
    (Phi : (Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ) → ℝ)
    (_hPhiLip : LipschitzWith Klip Phi) (_hPhi0 : Phi 0 = 0)
    (_hPhiNonneg : ∀ x, 0 ≤ Phi x)
    (CD : ℝ → ℝ) (hCD : ∀ p, 1 ≤ p → 0 < CD p) :
    ∃ a0 c0 : ℝ, ∃ w0 : ℕ,
      0 < a0 ∧ 0 < c0 ∧ 0 < w0 ∧
      ∀ p : ℝ, 1 ≤ p →
        ∃ qmin : ℝ,
          ∀ q : ℝ, qmin ≤ q →
            ∃ delta0 C0 : ℝ, 0 < delta0 ∧ 0 ≤ C0 ∧
              ∀ (M : _root_.SubdiffusiveProcess.Model.GMCModel d), M.delta ≤ delta0 →
              ∀ (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M), Rm.C ≤ Cresp →
              ∀ (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg),
              ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
                InfraredCharacterization M H →
              ∀ (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d),
                (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
                  ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
                    omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
              ∀ (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
                (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
                (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop),
                (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
                  primitive_scores d M s eps (eta N omega)
                    (fun m y => F N m y omega) (fun m y => Praw N m y omega)
                    (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
                    (fun m y => Z N m y omega) (fun m y => rawGood N m y omega)) →
                (∀ (N n : ℕ) (z : Vec d),
                  MemLp (fun omega => (Draw N n z omega).toReal)
                    (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
                  eLpNorm (fun omega => (Draw N n z omega).toReal)
                    (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
                    ENNReal.ofReal (CD q * M.delta ^ (1 / 2 : ℝ))) →
              ∀ (sidePos : ∀ n : ℤ, 0 < (3 : ℝ) ^ (-n))
                (unitA : ∀ (n : ℤ) (z : SpatialCoordinates d),
                  PositiveCoefficient (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n))),
                (∀ n z, (unitA n z).val =ᵐ[volume.restrict
                  (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n) : Set (SpatialCoordinates d))]
                    (fun _ => (1 : ℝ))) →
              let kappa : ℕ → ℝ := fun J =>
                Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M J
              let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
                fun n z omega => if 0 ≤ n then ∑ j ∈ Finset.Ico (0 : ℤ) n, omega (-j) z
                  else -∑ j ∈ Finset.Ico n (0 : ℤ), omega (-j) z
              let _reference : ℕ → ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
                fun N n z omega => kappa ((N : ℤ) - n).toNat / kappa N *
                  Real.exp (H omega z + retained n z omega)
              let eramp : ℝ → ℝ → ENNReal → ℝ := fun lo hi x =>
                (min (1 : ENNReal) ((x - ENNReal.ofReal lo) /
                  ENNReal.ofReal (hi - lo))).toReal
              12 * q ≤ Cresp⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹ →
              ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) →
                (∀ i : Fin T, n + offset i ≤ (N : ℤ)) →
                ∀ h : ℕ, 1 ≤ h →
                  ∃ Yband : BilateralField d → ℝ,
                    AEStronglyMeasurable[MeasurableSpace.comap
                      (fun omega : BilateralField d =>
                        fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ))
                          (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ))
                      inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
                    eLpNorm (fun omega =>
                        (weight 0 * (Draw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal +
                          weight 1 * eramp (eps / 2) eps
                            (F N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega)) - Yband omega)
                      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
                      ENNReal.ofReal (C0 * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
  obtain ⟨a1_gap, ha1_gap, qmin_gap, hgap⟩ := aux_lem_band_piece_field_gap
    d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp s eps hs.1
  refine ⟨min (s / 64) (a1_gap / 2), 1 / 4, 4,
    lt_min (by linarith only [hs.1]) (by linarith only [ha1_gap]), by norm_num, by norm_num, ?_⟩
  intro p hp
  refine ⟨max (max p 1) qmin_gap, ?_⟩
  intro q hqmin
  have hpq1 : max p 1 ≤ q := le_trans (le_max_left (max p 1) qmin_gap) hqmin
  have hqgap : qmin_gap ≤ q := le_trans (le_max_right (max p 1) qmin_gap) hqmin
  have hpq : p ≤ q := le_trans (le_max_left p 1) hpq1
  have hq1 : (1 : ℝ) ≤ q := le_trans (le_max_right p 1) hpq1
  obtain ⟨delta0_gap, C_gap, hdelta0_gap, hCgap_nn, hMgap⟩ := hgap q hqgap
  set qnat : ℕ := ⌈q⌉₊ with hqnat_def
  have hqnat1 : 1 ≤ qnat := Nat.ceil_pos.mpr (by linarith only [hq1])
  have hqle_qnat : q ≤ (qnat : ℝ) := Nat.le_ceil q
  set seriesF : ℝ := ∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) * ((2 * j + 1 : ℕ) : ℝ) *
    (2 * ((qnat : ℝ) + 1 + prefix_log_card d j)) with hseriesF_def
  have hseriesF_nonneg : 0 ≤ seriesF := by
    rw [hseriesF_def]
    refine tsum_nonneg (fun j => ?_)
    have hL := prefix_log_card_nonneg d j
    positivity
  set CqF : ℝ := (eps / 2)⁻¹ * (1 + (d : ℝ)) * seriesF with hCqF_def
  have hepspos : 0 < eps := heps.1
