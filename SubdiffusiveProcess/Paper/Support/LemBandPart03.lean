    have hz : (fun omega => (aux_lem_band_Jcell M l x (eta N omega)).toReal -
        (aux_lem_band_Jcell M l x (eta N omega)).toReal) = (fun _ : BilateralField d => (0 : ℝ)) := by
      funext omega; ring
    rw [hz, eLpNorm_fun_zero]
