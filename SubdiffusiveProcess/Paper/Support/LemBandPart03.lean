theorem aux_lem_band_U2_aesm_comp_pi {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (mB : MeasurableSpace Ω) {ι : Type*} [Fintype ι]
    (Y : ι → Ω → ℝ) (hY : ∀ i, AEStronglyMeasurable[mB] (Y i) P)
    (G : (ι → ℝ) → ℝ) (hG : Continuous G) :
    AEStronglyMeasurable[mB] (fun o => G (fun i => Y i o)) P := by
  refine ⟨fun o => G (fun i => (hY i).mk (Y i) o), ?_, ?_⟩
  · have hm : Measurable[mB] (fun o => fun i => (hY i).mk (Y i) o) :=
      Measurable.of_eval (fun i => (hY i).stronglyMeasurable_mk.measurable)
    exact (hG.measurable.comp hm).stronglyMeasurable
  · have hall : ∀ᵐ o ∂P, ∀ i, Y i o = (hY i).mk (Y i) o :=
      ae_all_iff.mpr (fun i => (hY i).ae_eq_mk)
    filter_upwards [hall] with o ho
    simp only [ho]

theorem aux_lem_band_U2_lip {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (mB : MeasurableSpace Ω) (hmB : mB ≤ mΩ) {ι : Type*} [Fintype ι]
    (X : ι → Ω → ℝ) (x0 : ι → ℝ) (hXm : ∀ i, AEStronglyMeasurable[mΩ] (X i) P)
    (F : (ι → ℝ) → ℝ) (L : ℝ) (hL : 0 ≤ L) (hF : ∀ x y, |F x - F y| ≤ L * ∑ i, |x i - y i|)
    (v : ℝ) (hv : F x0 = v)
    (q : ℝ) (hq : 1 ≤ q) (εm εb : ℝ) (hεm : 0 ≤ εm) (hεb : 0 ≤ εb) :
    AEStronglyMeasurable[mΩ] (fun o => F (fun i => X i o)) P ∧
    ((∀ i, eLpNorm (fun o => X i o - x0 i) (ENNReal.ofReal q) P ≤ ENNReal.ofReal εm) →
      eLpNorm (fun o => F (fun i => X i o) - v) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (L * (Fintype.card ι : ℝ) * εm)) ∧
    ((∀ i, ∃ Y : Ω → ℝ, AEStronglyMeasurable[mB] Y P ∧
        eLpNorm (fun o => X i o - x0 i - Y o) (ENNReal.ofReal q) P ≤ ENNReal.ofReal εb) →
      ∃ Z : Ω → ℝ, AEStronglyMeasurable[mB] Z P ∧
        eLpNorm (fun o => F (fun i => X i o) - v - Z o) (ENNReal.ofReal q) P ≤
          ENNReal.ofReal (L * (Fintype.card ι : ℝ) * εb)) := by
  let : MeasurableSpace Ω := mΩ
                                                
  have hFc : Continuous F := by
    have hLip : LipschitzWith (Real.toNNReal (L * Fintype.card ι)) F := by
      refine LipschitzWith.of_dist_le_mul (fun x y => ?_)
      rw [Real.dist_eq]
      refine (hF x y).trans ?_
      have hsum : ∑ i, |x i - y i| ≤ (Fintype.card ι : ℝ) * dist x y := by
        have : ∀ i, |x i - y i| ≤ dist x y := fun i => by
          rw [← Real.dist_eq]; exact dist_le_pi_dist x y i
        calc ∑ i, |x i - y i| ≤ ∑ _i : ι, dist x y := Finset.sum_le_sum (fun i _ => this i)
          _ = (Fintype.card ι : ℝ) * dist x y := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      rw [Real.coe_toNNReal _ (mul_nonneg hL (Nat.cast_nonneg _))]
      calc L * ∑ i, |x i - y i| ≤ L * ((Fintype.card ι : ℝ) * dist x y) :=
            mul_le_mul_of_nonneg_left hsum hL
        _ = L * (Fintype.card ι : ℝ) * dist x y := by ring
    exact hLip.continuous
  have hFX : AEStronglyMeasurable[mΩ] (fun o => F (fun i => X i o)) P :=
    aux_lem_band_U2_aesm_comp_pi P mΩ X hXm F hFc
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := ENNReal.one_le_ofReal.mpr hq
                                  
  have hsumbound : ∀ (G : ι → Ω → ℝ) (ε : ℝ), 0 ≤ ε → (∀ i, AEStronglyMeasurable[mΩ] (G i) P) →
      (∀ i, eLpNorm (G i) (ENNReal.ofReal q) P ≤ ENNReal.ofReal ε) →
      eLpNorm (fun o => ∑ i, |G i o|) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal ((Fintype.card ι : ℝ) * ε) := by
    intro G ε hε hGm hG
    have h1 : eLpNorm (fun o => ∑ i, |G i o|) (ENNReal.ofReal q) P ≤
        ∑ i, eLpNorm (fun o => |G i o|) (ENNReal.ofReal q) P := by
      have := eLpNorm_sum_le (μ := P) (s := Finset.univ) (f := fun i o => |G i o|)
        hq1
      have heq : (fun o => ∑ i, |G i o|) = ∑ i, (fun o => |G i o|) := by
        funext o; simp only [Finset.sum_apply]
      rw [heq]; exact this
    refine h1.trans ?_
    calc ∑ i, eLpNorm (fun o => |G i o|) (ENNReal.ofReal q) P
        = ∑ i, eLpNorm (G i) (ENNReal.ofReal q) P := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          have : (fun o => |G i o|) = fun o => ‖G i o‖ := by
            funext o; rw [Real.norm_eq_abs]
          rw [this]
          exact eLpNorm_norm _ (hGm i)
      _ ≤ ∑ _i : ι, ENNReal.ofReal ε := Finset.sum_le_sum (fun i _ => hG i)
      _ = ENNReal.ofReal ((Fintype.card ι : ℝ) * ε) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ENNReal.ofReal_mul (Nat.cast_nonneg _),
            ENNReal.ofReal_natCast]
  refine ⟨hFX, ?_, ?_⟩
  · intro hmom
    have hG := hsumbound (fun i o => X i o - x0 i) εm hεm (fun i => (hXm i).sub aestronglyMeasurable_const) hmom
    have hpt : ∀ o, ‖F (fun i => X i o) - v‖ ≤ ‖L * ∑ i, |X i o - x0 i|‖ := by
      intro o
      rw [← hv, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hL
        (Finset.sum_nonneg (fun i _ => abs_nonneg _)))]
      exact hF _ _
    calc eLpNorm (fun o => F (fun i => X i o) - v) (ENNReal.ofReal q) P
        ≤ eLpNorm (fun o => L * ∑ i, |X i o - x0 i|) (ENNReal.ofReal q) P :=
          eLpNorm_mono (hFX.sub aestronglyMeasurable_const) hpt
      _ = ENNReal.ofReal L * eLpNorm (fun o => ∑ i, |X i o - x0 i|) (ENNReal.ofReal q) P := by
          have : (fun o => L * ∑ i, |X i o - x0 i|) = L • (fun o => ∑ i, |X i o - x0 i|) := by
            funext o; simp [smul_eq_mul]
          rw [this, eLpNorm_const_smul, Real.enorm_eq_ofReal_abs, abs_of_nonneg hL]
      _ ≤ ENNReal.ofReal L * ENNReal.ofReal ((Fintype.card ι : ℝ) * εm) := mul_le_mul_right hG _
      _ = ENNReal.ofReal (L * (Fintype.card ι : ℝ) * εm) := by
          rw [← ENNReal.ofReal_mul hL]; ring_nf
  · intro hband
    choose Y hYm hYb using hband
    have hYa : ∀ i, AEStronglyMeasurable[mΩ] (Y i) P := fun i => (hYm i).mono hmB
    refine ⟨fun o => F (fun i => x0 i + Y i o) - v, ?_, ?_⟩
    · exact (aux_lem_band_U2_aesm_comp_pi P mB (fun i o => x0 i + Y i o)
        (fun i => aestronglyMeasurable_const.add (hYm i)) F hFc).sub aestronglyMeasurable_const
    · have hG := hsumbound (fun i o => X i o - x0 i - Y i o) εb hεb
        (fun i => ((hXm i).sub aestronglyMeasurable_const).sub (hYa i)) hYb
      have hpt : ∀ o, ‖F (fun i => X i o) - v - (F (fun i => x0 i + Y i o) - v)‖ ≤
          ‖L * ∑ i, |X i o - x0 i - Y i o|‖ := by
        intro o
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hL
          (Finset.sum_nonneg (fun i _ => abs_nonneg _))), sub_sub_sub_cancel_right]
        refine (hF _ _).trans (le_of_eq ?_)
        congr 1
        refine Finset.sum_congr rfl (fun i _ => ?_)
        congr 1; ring
      calc eLpNorm (fun o => F (fun i => X i o) - v - (F (fun i => x0 i + Y i o) - v))
            (ENNReal.ofReal q) P
          ≤ eLpNorm (fun o => L * ∑ i, |X i o - x0 i - Y i o|) (ENNReal.ofReal q) P :=
            eLpNorm_mono ((hFX.sub aestronglyMeasurable_const).sub
              ((aux_lem_band_U2_aesm_comp_pi P mΩ (fun i o => x0 i + Y i o)
                (fun i => aestronglyMeasurable_const.add (hYa i)) F hFc).sub
                  aestronglyMeasurable_const)) hpt
        _ = ENNReal.ofReal L * eLpNorm (fun o => ∑ i, |X i o - x0 i - Y i o|)
              (ENNReal.ofReal q) P := by
            have : (fun o => L * ∑ i, |X i o - x0 i - Y i o|) =
                L • (fun o => ∑ i, |X i o - x0 i - Y i o|) := by
              funext o; simp [smul_eq_mul]
            rw [this, eLpNorm_const_smul, Real.enorm_eq_ofReal_abs, abs_of_nonneg hL]
        _ ≤ ENNReal.ofReal L * ENNReal.ofReal ((Fintype.card ι : ℝ) * εb) := mul_le_mul_right hG _
        _ = ENNReal.ofReal (L * (Fintype.card ι : ℝ) * εb) := by
            rw [← ENNReal.ofReal_mul hL]; ring_nf

def aux_lem_band_U2_PG {d : ℕ} (x : (Fin d × Fin d) ⊕ (Fin d × Fin d) → ℝ) : ℝ :=
  sSup (Set.range fun e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1} =>
    max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j * (x (Sum.inl (i, j)) + x (Sum.inr (i, j))) - 1))

theorem aux_lem_band_U2_unit_coord_le {d : ℕ} (e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1})
    (i : Fin d) : |e.1 i| ≤ 1 := by
  have h1 : e.1 i ^ 2 ≤ ∑ k, e.1 k ^ 2 :=
    Finset.single_le_sum (f := fun k => e.1 k ^ 2) (fun k _ => sq_nonneg _) (Finset.mem_univ i)
  have h2 : ∑ k, e.1 k ^ 2 = 1 := by
    have := e.2
    unfold Homogenization.vecNormSq Homogenization.vecDot at this
    simpa [sq] using this
  rw [h2] at h1
  exact abs_le_one_iff_mul_self_le_one.mpr (by nlinarith)

theorem aux_lem_band_U2_PG_term_lip {d : ℕ} (x y : (Fin d × Fin d) ⊕ (Fin d × Fin d) → ℝ)
    (e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1}) :
    |max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j * (x (Sum.inl (i, j)) + x (Sum.inr (i, j))) - 1) -
      max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j * (y (Sum.inl (i, j)) + y (Sum.inr (i, j))) - 1)|
      ≤ ∑ k, |x k - y k| := by
  have hmax : ∀ A B : ℝ, |max 0 A - max 0 B| ≤ |A - B| := by
    intro A B
    rw [max_comm 0 A, max_comm 0 B]
    exact abs_max_sub_max_le_abs A B 0
  refine (hmax _ _).trans ?_
  have e1 : (1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j * (x (Sum.inl (i, j)) + x (Sum.inr (i, j))) - 1 -
      ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j * (y (Sum.inl (i, j)) + y (Sum.inr (i, j))) - 1) =
      (1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j *
        ((x (Sum.inl (i, j)) - y (Sum.inl (i, j))) + (x (Sum.inr (i, j)) - y (Sum.inr (i, j)))) := by
    simp only [mul_add, mul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib]
    ring
  rw [e1]
  have hsumk : ∑ k, |x k - y k| = ∑ i, ∑ j, (|x (Sum.inl (i, j)) - y (Sum.inl (i, j))| +
      |x (Sum.inr (i, j)) - y (Sum.inr (i, j))|) := by
    rw [Fintype.sum_sum_type, Fintype.sum_prod_type, Fintype.sum_prod_type,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← Finset.sum_add_distrib]
  rw [hsumk, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
  have hb : |∑ i, ∑ j, e.1 i * e.1 j *
      ((x (Sum.inl (i, j)) - y (Sum.inl (i, j))) + (x (Sum.inr (i, j)) - y (Sum.inr (i, j))))| ≤
      ∑ i, ∑ j, (|x (Sum.inl (i, j)) - y (Sum.inl (i, j))| +
        |x (Sum.inr (i, j)) - y (Sum.inr (i, j))|) := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun i _ => ?_))
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun j _ => ?_))
    rw [abs_mul, abs_mul]
    have hi := aux_lem_band_U2_unit_coord_le e i
    have hj := aux_lem_band_U2_unit_coord_le e j
    have hij : |e.1 i| * |e.1 j| ≤ 1 := by
      calc |e.1 i| * |e.1 j| ≤ 1 * 1 := mul_le_mul hi hj (abs_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    calc |e.1 i| * |e.1 j| * |x (Sum.inl (i, j)) - y (Sum.inl (i, j)) +
          (x (Sum.inr (i, j)) - y (Sum.inr (i, j)))|
        ≤ 1 * (|x (Sum.inl (i, j)) - y (Sum.inl (i, j))| +
            |x (Sum.inr (i, j)) - y (Sum.inr (i, j))|) :=
          mul_le_mul hij (abs_add_le _ _) (abs_nonneg _) zero_le_one
      _ = _ := one_mul _
  have hnn : 0 ≤ ∑ i, ∑ j, (|x (Sum.inl (i, j)) - y (Sum.inl (i, j))| +
      |x (Sum.inr (i, j)) - y (Sum.inr (i, j))|) := by positivity
  linarith

theorem aux_lem_band_U2_PG_bdd {d : ℕ} (x : (Fin d × Fin d) ⊕ (Fin d × Fin d) → ℝ) :
    BddAbove (Set.range fun e : {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1} =>
      max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j * (x (Sum.inl (i, j)) + x (Sum.inr (i, j))) - 1)) := by
  refine ⟨∑ k, |x k - (fun _ => (0 : ℝ)) k|, ?_⟩
  rintro _ ⟨e, rfl⟩
  have h := aux_lem_band_U2_PG_term_lip x (fun _ => (0 : ℝ)) e
  have h0 : max 0 ((1 / 2 : ℝ) * ∑ i : Fin d, ∑ j : Fin d, e.1 i * e.1 j * ((0 : ℝ) + 0) - 1) = 0 := by
    simp
  rw [h0, sub_zero] at h
  exact (le_abs_self _).trans h

theorem aux_lem_band_U2_PG_lip {d : ℕ} (x y : (Fin d × Fin d) ⊕ (Fin d × Fin d) → ℝ) :
    |aux_lem_band_U2_PG x - aux_lem_band_U2_PG y| ≤ 1 * ∑ k, |x k - y k| := by
  rw [one_mul]
  unfold aux_lem_band_U2_PG
  rcases isEmpty_or_nonempty {e : Homogenization.Vec d // Homogenization.vecNormSq e = 1} with hE | hE
  · simp only [Set.range_eq_empty, Real.sSup_empty, sub_self, abs_zero]
    positivity
  · rw [abs_sub_le_iff]
    constructor
    · rw [sub_le_iff_le_add]
      refine csSup_le (Set.range_nonempty _) ?_
      rintro _ ⟨e, rfl⟩
      have h1 := aux_lem_band_U2_PG_term_lip x y e
      have h2 := le_csSup (aux_lem_band_U2_PG_bdd y) ⟨e, rfl⟩
      have h3 := le_abs_self (max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j *
        (x (Sum.inl (i, j)) + x (Sum.inr (i, j))) - 1) - max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j,
          e.1 i * e.1 j * (y (Sum.inl (i, j)) + y (Sum.inr (i, j))) - 1))
      linarith
    · rw [sub_le_iff_le_add]
      refine csSup_le (Set.range_nonempty _) ?_
      rintro _ ⟨e, rfl⟩
      have h1 := aux_lem_band_U2_PG_term_lip x y e
      have h2 := le_csSup (aux_lem_band_U2_PG_bdd x) ⟨e, rfl⟩
      have h3 := neg_abs_le (max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j, e.1 i * e.1 j *
        (x (Sum.inl (i, j)) + x (Sum.inr (i, j))) - 1) - max 0 ((1 / 2 : ℝ) * ∑ i, ∑ j,
          e.1 i * e.1 j * (y (Sum.inl (i, j)) + y (Sum.inr (i, j))) - 1))
      linarith

theorem aux_lem_band_U2_lge_inter {d : ℕ} {Ω : Opens (SpatialCoordinates d)} (a : PositiveCoefficient Ω)
    (x : SpatialCoordinates d) (ρ : ℝ) (g : HilbertGradient Ω) :
    localGradientEnergy a (s := Metric.ball x ρ ∩ (Ω : Set (SpatialCoordinates d)))
        (Metric.isOpen_ball.inter Ω.isOpen).measurableSet g =
      localGradientEnergy a (s := Metric.ball x ρ) Metric.isOpen_ball.measurableSet g := by
  simp only [localGradientEnergy_eq_integral]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Measure.restrict_restrict (Metric.isOpen_ball.inter Ω.isOpen).measurableSet,
    Measure.restrict_restrict Metric.isOpen_ball.measurableSet, Set.inter_assoc, Set.inter_self]

def aux_lem_band_U2_aD (d : ℕ) : ℝ :=
  ((d : ℝ) - 1 / 2) * (((d : ℝ) - 1 / 2) - (d : ℝ) + 1) / (((d : ℝ) - 1 / 2) + 1) /
    (8 * Real.log 3)

theorem aux_lem_band_U2_aD_pos (d : ℕ) (hd : 2 ≤ d) : 0 < aux_lem_band_U2_aD d := by
  unfold aux_lem_band_U2_aD
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hl : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have h1 : 0 < (d : ℝ) - 1 / 2 := by linarith
  have h2 : 0 < ((d : ℝ) - 1 / 2) - (d : ℝ) + 1 := by linarith
  have h3 : 0 < ((d : ℝ) - 1 / 2) + 1 := by linarith
  positivity

@[instance_reducible]
def aux_lem_band_U2_band (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)] (lo hi : ℤ) :
    MeasurableSpace (BilateralField d) :=
  MeasurableSpace.comap
    (fun omega : BilateralField d => fun j : Set.Icc lo hi => omega (j : ℤ)) inferInstance

def aux_lem_band_U2_BandApprox {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (P : Measure (BilateralField d)) (lo hi : ℤ) (p : ℝ) (X : BilateralField d → ℝ) (ε : ℝ) :
    Prop :=
  ∃ Y : BilateralField d → ℝ, AEStronglyMeasurable[aux_lem_band_U2_band d lo hi] Y P ∧
    eLpNorm (fun omega => X omega - Y omega) (ENNReal.ofReal p) P ≤ ENNReal.ofReal ε

theorem aux_lem_band_U2_band_le_ambient {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)] (lo hi : ℤ) :
    aux_lem_band_U2_band d lo hi ≤ (inferInstance : MeasurableSpace (BilateralField d)) := by
  unfold aux_lem_band_U2_band
  exact Measurable.comap_le (Measurable.of_eval (fun j => measurable_pi_apply (j : ℤ)))

theorem aux_lem_band_U2_BA_mono {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {lo hi : ℤ} {p : ℝ} {X : BilateralField d → ℝ} {ε ε' : ℝ}
    (hεε : ε ≤ ε') (hX : aux_lem_band_U2_BandApprox P lo hi p X ε) : aux_lem_band_U2_BandApprox P lo hi p X ε' := by
  obtain ⟨Y, hYm, hYb⟩ := hX
  exact ⟨Y, hYm, hYb.trans (ENNReal.ofReal_le_ofReal hεε)⟩

theorem aux_lem_band_U2_BA_add_const {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {lo hi : ℤ} {p : ℝ} {X : BilateralField d → ℝ} {ε : ℝ}
    (b : ℝ) (hX : aux_lem_band_U2_BandApprox P lo hi p X ε) :
    aux_lem_band_U2_BandApprox P lo hi p (fun omega => X omega + b) ε := by
  obtain ⟨Y, hYm, hYb⟩ := hX
  refine ⟨fun omega => Y omega + b, hYm.add aestronglyMeasurable_const, ?_⟩
  have : (fun omega => X omega + b - (Y omega + b)) = fun omega => X omega - Y omega := by
    funext omega; ring
  rw [this]; exact hYb

theorem aux_lem_band_U2_BA_const_mul {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {lo hi : ℤ} {p : ℝ} {X : BilateralField d → ℝ} {ε : ℝ}
    (c : ℝ) (hX : aux_lem_band_U2_BandApprox P lo hi p X ε) :
    aux_lem_band_U2_BandApprox P lo hi p (fun omega => c * X omega) (|c| * ε) := by
  obtain ⟨Y, hYm, hYb⟩ := hX
  refine ⟨fun omega => c * Y omega, hYm.const_mul c, ?_⟩
  have : (fun omega => c * X omega - c * Y omega) = c • (fun omega => X omega - Y omega) := by
    funext omega; simp only [Pi.smul_apply, smul_eq_mul]; ring
  rw [this, eLpNorm_const_smul, Real.enorm_eq_ofReal_abs, ENNReal.ofReal_mul (abs_nonneg c)]
  exact mul_le_mul_right hYb _

theorem aux_lem_band_U2_BA_add {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {lo hi : ℤ} {p : ℝ} (hp : 1 ≤ p)
    {X Z : BilateralField d → ℝ} {ε1 ε2 : ℝ} (hε1 : 0 ≤ ε1) (hε2 : 0 ≤ ε2)
    (_hXm : AEStronglyMeasurable X P) (_hZm : AEStronglyMeasurable Z P)
    (hX : aux_lem_band_U2_BandApprox P lo hi p X ε1) (hZ : aux_lem_band_U2_BandApprox P lo hi p Z ε2) :
    aux_lem_band_U2_BandApprox P lo hi p (fun omega => X omega + Z omega) (ε1 + ε2) := by
  obtain ⟨Y1, hY1m, hY1b⟩ := hX
  obtain ⟨Y2, hY2m, hY2b⟩ := hZ
  refine ⟨fun omega => Y1 omega + Y2 omega, hY1m.add hY2m, ?_⟩
  have hY1a : AEStronglyMeasurable Y1 P := hY1m.mono (aux_lem_band_U2_band_le_ambient lo hi)
  have hY2a : AEStronglyMeasurable Y2 P := hY2m.mono (aux_lem_band_U2_band_le_ambient lo hi)
  have heq : (fun omega => X omega + Z omega - (Y1 omega + Y2 omega)) =
      (fun omega => X omega - Y1 omega) + (fun omega => Z omega - Y2 omega) := by
    funext omega; simp only [Pi.add_apply]; ring
  rw [heq]
  calc eLpNorm ((fun omega => X omega - Y1 omega) + (fun omega => Z omega - Y2 omega))
        (ENNReal.ofReal p) P
      ≤ eLpNorm (fun omega => X omega - Y1 omega) (ENNReal.ofReal p) P +
          eLpNorm (fun omega => Z omega - Y2 omega) (ENNReal.ofReal p) P :=
        eLpNorm_add_le (ENNReal.one_le_ofReal.mpr hp)
    _ ≤ ENNReal.ofReal ε1 + ENNReal.ofReal ε2 := add_le_add hY1b hY2b
    _ = ENNReal.ofReal (ε1 + ε2) := (ENNReal.ofReal_add hε1 hε2).symm

theorem aux_lem_band_U2_BA_lin3 {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {lo hi : ℤ} {p : ℝ} (hp : 1 ≤ p)
    {X1 X2 X3 : BilateralField d → ℝ} {ε : ℝ} (hε : 0 ≤ ε)
    (hm1 : AEStronglyMeasurable X1 P) (hm2 : AEStronglyMeasurable X2 P)
    (hm3 : AEStronglyMeasurable X3 P)
    (h1 : aux_lem_band_U2_BandApprox P lo hi p X1 ε) (h2 : aux_lem_band_U2_BandApprox P lo hi p X2 ε)
    (h3 : aux_lem_band_U2_BandApprox P lo hi p X3 ε) (c1 c2 c3 b : ℝ) :
    aux_lem_band_U2_BandApprox P lo hi p (fun omega => c1 * X1 omega + c2 * X2 omega + c3 * X3 omega + b)
      ((|c1| + |c2| + |c3|) * ε) := by
  have g1 := aux_lem_band_U2_BA_const_mul c1 h1
  have g2 := aux_lem_band_U2_BA_const_mul c2 h2
  have g3 := aux_lem_band_U2_BA_const_mul c3 h3
  have g12 := aux_lem_band_U2_BA_add hp (mul_nonneg (abs_nonneg c1) hε) (mul_nonneg (abs_nonneg c2) hε)
    (hm1.const_mul c1) (hm2.const_mul c2) g1 g2
  have g123 := aux_lem_band_U2_BA_add hp
    (add_nonneg (mul_nonneg (abs_nonneg c1) hε) (mul_nonneg (abs_nonneg c2) hε))
    (mul_nonneg (abs_nonneg c3) hε)
    ((hm1.const_mul c1).add (hm2.const_mul c2)) (hm3.const_mul c3) g12 g3
  have g := aux_lem_band_U2_BA_add_const b g123
  have he : |c1| * ε + |c2| * ε + |c3| * ε = (|c1| + |c2| + |c3|) * ε := by ring
  rw [he] at g
  exact g

theorem aux_lem_band_rcJ_unit_set (d : ℕ) :
    (unitNeumannCube d : Set (SpatialCoordinates d)) =
      Homogenization.translateSet (fun _ : Fin d => (1 / 2 : ℝ))
        (Homogenization.openCubeSet (Homogenization.originCube d 0)) := by
  ext x
  rw [Homogenization.mem_translateSet_iff_sub_mem, Homogenization.mem_openCubeSet_originCube_iff]
  change x ∈ (centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
    Set (SpatialCoordinates d)) ↔ _
  rw [centeredCube_eq_pi]
  simp only [Set.mem_pi, Set.mem_univ, true_implies, Set.mem_Ioo, Pi.sub_apply, zpow_zero,
    mul_one]
  constructor
  · intro h i
    have hi := h i
    constructor <;> linarith [hi.1, hi.2]
  · intro h i
    have hi := h i
    constructor <;> linarith [hi.1, hi.2]

