theorem aux_lem_band_rcJ_haQ {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (omega : BilateralField d) (N l : ℕ) (x : SpatialCoordinates d)
    (heta : ∀ (i : ℕ) (y : SpatialCoordinates d),
      eta N omega i y = omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) :
    ((aux_lem_band_rcJ_aN M l (aux_lem_band_rcJ_shift N l x omega)).val : SpatialCoordinates d → ℝ)
      =ᵐ[volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))]
        fun z => _root_.SubdiffusiveProcess.Model.aCutoff M l
          (SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega))
          ((3 : ℝ) ^ (l : ℤ) • (z - fun _ => (1 / 2 : ℝ))) / SubdiffusiveProcess.CoarseGrainingVocab.ahom M l := by
  have : Fact ((centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos :
      Set (SpatialCoordinates d)) ⊆ closedCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos) :=
    ⟨centeredCube_subset_closedCube _ one_pos⟩
  have h0 := normalizedContinuousPositiveCoefficient_coeFn
    (Ω := centeredCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)
    (closedCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos)
    (cutoffCoefficientCM M (fun _ => 0) (aux_lem_band_rcJ_shift N l x omega) l
      (fun _ => (1 / 2 : ℝ)) one_pos)
    (cutoffCoefficientCM_pos M (fun _ => 0) (aux_lem_band_rcJ_shift N l x omega) l
      (fun _ => (1 / 2 : ℝ)) one_pos) 1 one_pos
  filter_upwards [h0, ae_restrict_mem (unitNeumannCube d).isOpen.measurableSet] with z hz hzm
  have hz' := hz hzm
  have hA : SubdiffusiveProcess.CoarseGrainingVocab.ahom M l ≠ 0 := (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M l).ne'
  rw [aux_lem_band_rcJ_value_transport M eta omega N l x heta z, mul_div_cancel_left₀ _ hA]
  change (cutoffPositiveCoefficient M (fun _ => 0) (aux_lem_band_rcJ_shift N l x omega) l
    (fun _ => (1 / 2 : ℝ)) one_pos).val z = _
  unfold cutoffPositiveCoefficient
  rw [hz', div_one]
  rfl

