  intro q hq
  obtain ⟨delta0, C, hdelta0, hC, hbound⟩ := hfine q hq
  refine ⟨delta0, C, hdelta0, hC, ?_⟩
  intro M hM Rm hRC Sreg It H hInfra eta heta N l x h
  have hne := aux_lem_band_rcJ_ne_top d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
