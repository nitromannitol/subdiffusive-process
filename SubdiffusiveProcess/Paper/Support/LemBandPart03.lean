theorem aux_lem_band_comap_icc_mono {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {lo hi lo' hi' : ℤ} (hlo : lo' ≤ lo) (hhi : hi ≤ hi') :
    MeasurableSpace.comap
        (fun omega : BilateralField d => fun j : Set.Icc lo hi => omega (j : ℤ))
        (inferInstance : MeasurableSpace (Set.Icc lo hi → C(SpatialCoordinates d, ℝ))) ≤
      MeasurableSpace.comap
        (fun omega : BilateralField d => fun j : Set.Icc lo' hi' => omega (j : ℤ))
        (inferInstance : MeasurableSpace (Set.Icc lo' hi' → C(SpatialCoordinates d, ℝ))) := by
  have hsub : Set.Icc lo hi ⊆ Set.Icc lo' hi' := fun j hj =>
    ⟨hlo.trans hj.1, hj.2.trans hhi⟩
  let inc : Set.Icc lo hi → Set.Icc lo' hi' := fun j => ⟨j.1, hsub j.2⟩
  let project : (Set.Icc lo' hi' → C(SpatialCoordinates d, ℝ)) →
      (Set.Icc lo hi → C(SpatialCoordinates d, ℝ)) := fun x j => x (inc j)
  have hproject : Measurable project := measurable_pi_iff.mpr fun j => measurable_pi_apply (inc j)
  have hfactor : (fun omega : BilateralField d => fun j : Set.Icc lo hi => omega (j : ℤ)) =
      project ∘ (fun omega : BilateralField d => fun j : Set.Icc lo' hi' => omega (j : ℤ)) := rfl
  rw [hfactor, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono hproject.comap_le

theorem aux_lem_band_aesm_finset_sup {Ω ι : Type*} {m₀ : MeasurableSpace Ω} (mb : MeasurableSpace Ω)
    (μ : @Measure Ω m₀) (s : Finset ι) (X : ι → Ω → ℝ≥0∞)
    (hX : ∀ i ∈ s, AEStronglyMeasurable[mb] (X i) μ) :
    AEStronglyMeasurable[mb] (fun ω => s.sup (fun i => X i ω)) μ := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using aestronglyMeasurable_const
  | insert i s hi ih =>
    obtain ⟨gi, hgi, hgi_eq⟩ := hX i (Finset.mem_insert_self _ _)
    obtain ⟨gs, hgs, hgs_eq⟩ := ih fun j hj => hX j (Finset.mem_insert_of_mem hj)
    refine ⟨fun ω => gi ω ⊔ gs ω, hgi.sup hgs, ?_⟩
    filter_upwards [hgi_eq, hgs_eq] with ω h1 h2
    simp only [Finset.sup_insert]
    rw [h1, h2]

theorem aux_lem_band_abs_toReal_sup_sub_le_sup {ι : Type*} (s : Finset ι)
    (a b : ι → ℝ≥0∞) (ha : ∀ i, a i ≠ ⊤) (hb : ∀ i, b i ≠ ⊤) :
    |(s.sup a).toReal - (s.sup b).toReal| ≤
      (s.sup (fun i => ENNReal.ofReal |(a i).toReal - (b i).toReal|)).toReal := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih =>
    have hsa : s.sup a ≠ ⊤ := aux_prefix_rraw_finset_sup_ne_top _ _ ha
    have hsb : s.sup b ≠ ⊤ := aux_prefix_rraw_finset_sup_ne_top _ _ hb
    have hsd : s.sup (fun i => ENNReal.ofReal |(a i).toReal - (b i).toReal|) ≠ ⊤ :=
      aux_prefix_rraw_finset_sup_ne_top _ _ fun i => ENNReal.ofReal_ne_top
    rw [Finset.sup_insert, Finset.sup_insert, Finset.sup_insert,
      ENNReal.toReal_max (ha i) hsa, ENNReal.toReal_max (hb i) hsb,
      ENNReal.toReal_max ENNReal.ofReal_ne_top hsd, ENNReal.toReal_ofReal (abs_nonneg _)]
    exact (abs_max_sub_max_le_max _ _ _ _).trans (max_le_max le_rfl ih)

theorem aux_lem_band_piece_response_Rraw_ne_top
    {d : ℕ} [NeZero d]
