  obtain ⟨δa, Ba, hδa, hBa, ha⟩ := aux_lem_band_des3_neumann_H0_growth_It d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp rho hrho hrho0 hrhos hrhoi pvec hpvec hP fL2 hfL2 t p ht0
