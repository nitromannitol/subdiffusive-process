  have hFhalf_series_bound : eLpNorm (fun omega => (Fhalf_ENNReal omega).toReal)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (aux_psf_sigma M * ∑' j : ℕ, (3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8)) *
