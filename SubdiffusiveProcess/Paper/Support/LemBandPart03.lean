theorem aux_lem_band_rcJ_bridge_B1a_translate_eta_eq_transport {d : ℕ}
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (omega : BilateralField d) (N : ℕ) (x : SpatialCoordinates d)
    (heta : ∀ (i : ℕ) (y : SpatialCoordinates d),
      eta N omega i y = omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) :
    ∀ (k : ℕ) (y : SpatialCoordinates d),
      SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega) k y =
        aux_lem_band_transport_S (N : ℤ) ((3 : ℝ) ^ (-(N : ℤ)) • x) omega (k : ℤ) y := by
  intro k y
  have h1 : SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega) k y =
      eta N omega k (y + x) := by
    show _root_.SubdiffusiveProcess.Model.PotentialField.translate x (eta N omega k) y = _
    exact _root_.SubdiffusiveProcess.Model.PotentialField.translate_apply x (eta N omega k) y
  rw [h1, heta k (y + x), aux_lem_band_transport_S_apply]
  congr 1
  rw [smul_add, add_comm]

theorem aux_lem_band_rcJ_bridge_B1b_aCutoff_normalization_exists {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (omega : BilateralField d) (N l : ℕ)
    (x : SpatialCoordinates d)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ (i : ℕ) (y : SpatialCoordinates d),
      eta N omega i y = omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) :
    ∃ psi : BilateralField d,
      ∀ y : SpatialCoordinates d,
        _root_.SubdiffusiveProcess.Model.aCutoff M l
            (SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega)) y =
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M l * cutoffCoefficient M (fun _ => 0) psi l y := by
  refine ⟨fun i : ℤ => aux_lem_band_transport_S (N : ℤ) ((3 : ℝ) ^ (-(N : ℤ)) • x) omega (-i), fun y => ?_⟩
  have hB1a := aux_lem_band_rcJ_bridge_B1a_translate_eta_eq_transport eta omega N x heta
  have hahom : SubdiffusiveProcess.CoarseGrainingVocab.ahom M l ≠ 0 :=
    (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M l).ne'
  have hsum : (∑ k ∈ Finset.range (l + 1),
      SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega) k y) =
      ∑ j ∈ Finset.range (l + 1),
        (fun i : ℤ => aux_lem_band_transport_S (N : ℤ) ((3 : ℝ) ^ (-(N : ℤ)) • x) omega (-i))
          (-(Int.ofNat j)) y := by
    refine Finset.sum_congr rfl (fun j _ => ?_)
    show SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega) j y =
        aux_lem_band_transport_S (N : ℤ) ((3 : ℝ) ^ (-(N : ℤ)) • x) omega (-(-(Int.ofNat j))) y
    have hidx : (j : ℤ) = -(-(Int.ofNat j)) := by
      rw [neg_neg, Int.ofNat_eq_natCast]
    rw [hB1a j y, hidx]
  rw [SubdiffusiveProcess.CoarseGrainingVocab.aCutoff_eq_exp_sub, hsum]
  unfold cutoffCoefficient cutoffPotential
  simp only [ContinuousMap.zero_apply, zero_add]
  rw [← mul_assoc, mul_inv_cancel₀ hahom, one_mul]

def aux_lem_band_transport_h0_ret (m : ℤ) (f : ℤ → ℝ) : ℝ :=
  if 0 ≤ m then ∑ j ∈ Finset.Ico (0 : ℤ) m, f (-j) else -∑ j ∈ Finset.Ico m (0 : ℤ), f (-j)

def aux_lem_band_transport_h0_retained {d : ℕ} (n : ℤ) (z : SpatialCoordinates d) (om : BilateralField d) :
    ℝ :=
  aux_lem_band_transport_h0_ret n (fun j => om j z)

theorem aux_lem_band_transport_h0_sum_range_shift (G : ℤ → ℝ) (a : ℤ) (t : ℕ) :
    ∑ k ∈ Finset.range t, G (a + k) = ∑ j ∈ Finset.Ico a (a + t), G j := by
  refine Finset.sum_nbij' (fun k : ℕ => a + (k : ℤ)) (fun j : ℤ => (j - a).toNat) ?_ ?_ ?_ ?_ ?_
  · intro k hk; simp only [Finset.mem_range] at hk
    simp only [Finset.mem_Ico]; omega
  · intro j hj; simp only [Finset.mem_Ico] at hj
    simp only [Finset.mem_range]; omega
  · intro k _; simp
  · intro j hj; simp only [Finset.mem_Ico] at hj; omega
  · intro k _; rfl

theorem aux_lem_band_transport_h0_potential_sum (f : ℤ → ℝ) (N : ℕ) (m : ℤ) (hm : m ≤ (N : ℤ)) :
    ∑ j ∈ Finset.range (N + 1), f (-(Int.ofNat j)) =
      ∑ k ∈ Finset.range (((N : ℤ) - m).toNat + 1), f (-(Int.ofNat k) - m) +
        aux_lem_band_transport_h0_ret m f := by
  have hL : ∑ j ∈ Finset.range (N + 1), f (-(Int.ofNat j)) =
      ∑ j ∈ Finset.Ico (0 : ℤ) ((N : ℤ) + 1), f (-j) := by
    have := aux_lem_band_transport_h0_sum_range_shift (fun j => f (-j)) 0 (N + 1)
    simpa using this
  have hR : ∑ k ∈ Finset.range (((N : ℤ) - m).toNat + 1), f (-(Int.ofNat k) - m) =
      ∑ j ∈ Finset.Ico m ((N : ℤ) + 1), f (-j) := by
    have h1 := aux_lem_band_transport_h0_sum_range_shift (fun j => f (-j)) m (((N : ℤ) - m).toNat + 1)
    have h2 : m + ((((N : ℤ) - m).toNat + 1 : ℕ) : ℤ) = (N : ℤ) + 1 := by omega
    rw [h2] at h1
    rw [← h1]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    congr 1; simp; ring
  rw [hL, hR]
  unfold aux_lem_band_transport_h0_ret
  by_cases h0 : 0 ≤ m
  · rw [ite_eq_left h0]
    have hU : Finset.Ico (0 : ℤ) ((N : ℤ) + 1) =
        Finset.Ico (0 : ℤ) m ∪ Finset.Ico m ((N : ℤ) + 1) := by
      ext x; simp only [Finset.mem_Ico, Finset.mem_union]; omega
    have hD : Disjoint (Finset.Ico (0 : ℤ) m) (Finset.Ico m ((N : ℤ) + 1)) :=
      Finset.disjoint_left.2 (by intro x hx hx'; simp only [Finset.mem_Ico] at hx hx'; omega)
    rw [hU, Finset.sum_union hD]; ring
  · rw [ite_eq_right h0]
    have hU : Finset.Ico m ((N : ℤ) + 1) =
        Finset.Ico m (0 : ℤ) ∪ Finset.Ico (0 : ℤ) ((N : ℤ) + 1) := by
      ext x; simp only [Finset.mem_Ico, Finset.mem_union]; omega
    have hD : Disjoint (Finset.Ico m (0 : ℤ)) (Finset.Ico (0 : ℤ) ((N : ℤ) + 1)) :=
      Finset.disjoint_left.2 (by intro x hx hx'; simp only [Finset.mem_Ico] at hx hx'; omega)
    rw [hU, Finset.sum_union hD]; ring

def aux_lem_band_transport_h0_kappa {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (J : ℕ) : ℝ :=
  Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * SubdiffusiveProcess.CoarseGrainingVocab.ahom M J

theorem aux_lem_band_transport_h0_kappa_pos {d : ℕ} (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (J : ℕ) :
    0 < aux_lem_band_transport_h0_kappa M J :=
  mul_pos (Real.exp_pos _) (SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M J)

theorem aux_lem_band_transport_h0_coefficient {d : ℕ}
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (m : ℤ) (w : SpatialCoordinates d)
    (N : ℕ) (hm : m ≤ (N : ℤ)) (om : BilateralField d) (y : SpatialCoordinates d) :
    cutoffCoefficient M (fun _ => 0) om N (w + (3 : ℝ) ^ (-m) • y) =
      (aux_lem_band_transport_h0_kappa M (((N : ℤ) - m).toNat) / aux_lem_band_transport_h0_kappa M N *
          Real.exp (aux_lem_band_transport_h0_retained m (w + (3 : ℝ) ^ (-m) • y) om)) *
        cutoffCoefficient M (fun _ => 0) (aux_lem_band_transport_S m w om) (((N : ℤ) - m).toNat) y := by
  set x := w + (3 : ℝ) ^ (-m) • y with hx
  set K := ((N : ℤ) - m).toNat with hKdef
  have hSk : ∀ k : ℕ, (aux_lem_band_transport_S m w om) (-(Int.ofNat k)) y = om (-(Int.ofNat k) - m) x :=
    fun k => aux_lem_band_transport_S_apply m w om (-(Int.ofNat k)) y
  have hshift := aux_lem_band_transport_h0_potential_sum (fun j => om j x) N m hm
  have hpsum : ∑ k ∈ Finset.range (K + 1), (aux_lem_band_transport_S m w om) (-(Int.ofNat k)) y =
      ∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) x - aux_lem_band_transport_h0_retained m x om := by
    rw [show (∑ k ∈ Finset.range (K + 1), (aux_lem_band_transport_S m w om) (-(Int.ofNat k)) y) =
        ∑ k ∈ Finset.range (K + 1), om (-(Int.ofNat k) - m) x from
      Finset.sum_congr rfl (fun k _ => hSk k)]
    have hret : aux_lem_band_transport_h0_ret m (fun j => om j x) = aux_lem_band_transport_h0_retained m x om := rfl
    rw [hret] at hshift
    linarith [hshift]
  have hpotL : cutoffPotential (fun _ => 0) om N x =
      ∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) x := by
    simp only [cutoffPotential, ContinuousMap.zero_apply, zero_add]
  have hpotR : cutoffPotential (fun _ => 0) (aux_lem_band_transport_S m w om) K y =
      ∑ k ∈ Finset.range (K + 1), (aux_lem_band_transport_S m w om) (-(Int.ofNat k)) y := by
    simp only [cutoffPotential, ContinuousMap.zero_apply, zero_add]
  have hpot : cutoffPotential (fun _ => 0) om N x =
      cutoffPotential (fun _ => 0) (aux_lem_band_transport_S m w om) K y +
        aux_lem_band_transport_h0_retained m x om := by
    rw [hpotL, hpotR, hpsum]; ring
  have hposK : 0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M K := SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M K
  have hposN : 0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M N
  have hne1 : SubdiffusiveProcess.CoarseGrainingVocab.ahom M N ≠ 0 := hposN.ne'
  have hne2 : SubdiffusiveProcess.CoarseGrainingVocab.ahom M K ≠ 0 := hposK.ne'
  have hL1 : cutoffCoefficient M (fun _ => 0) om N x *
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
      Real.exp (((N : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) =
      Real.exp (cutoffPotential (fun _ => 0) om N x) := by
    unfold cutoffCoefficient
    rw [Real.exp_sub]
    field_simp
  have hR1 : cutoffCoefficient M (fun _ => 0) (aux_lem_band_transport_S m w om) K y *
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M K *
      Real.exp (((K : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) =
      Real.exp (cutoffPotential (fun _ => 0) (aux_lem_band_transport_S m w om) K y) := by
    unfold cutoffCoefficient
    rw [Real.exp_sub]
    field_simp
  have hexppot : Real.exp (cutoffPotential (fun _ => 0) om N x) =
      Real.exp (cutoffPotential (fun _ => 0) (aux_lem_band_transport_S m w om) K y) *
        Real.exp (aux_lem_band_transport_h0_retained m x om) := by
    rw [hpot, ← Real.exp_add]
  have hcombine : cutoffCoefficient M (fun _ => 0) om N x *
      SubdiffusiveProcess.CoarseGrainingVocab.ahom M N *
      Real.exp (((N : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) =
      (cutoffCoefficient M (fun _ => 0) (aux_lem_band_transport_S m w om) K y *
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M K *
          Real.exp (((K : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P)) *
        Real.exp (aux_lem_band_transport_h0_retained m x om) := by
    rw [hL1, hR1, hexppot]
  unfold aux_lem_band_transport_h0_kappa
  have hexpN : Real.exp (((N : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) ≠ 0 :=
    (Real.exp_pos _).ne'
  rw [div_mul_eq_mul_div, div_mul_eq_mul_div, eq_div_iff (mul_ne_zero hexpN hne1)]
  linear_combination hcombine

theorem aux_lem_band_rcJ_bridge_h0_coefficient_transport {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (omega : BilateralField d) (N l : ℕ)
    (x : SpatialCoordinates d)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ (i : ℕ) (y : SpatialCoordinates d),
      eta N omega i y = omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (m : ℤ) (hm : m ≤ (l : ℤ)) (w : SpatialCoordinates d) (y : SpatialCoordinates d) :
    ∃ psi : BilateralField d,
      (∀ z : SpatialCoordinates d,
        _root_.SubdiffusiveProcess.Model.aCutoff M l
            (SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega)) z =
          SubdiffusiveProcess.CoarseGrainingVocab.ahom M l * cutoffCoefficient M (fun _ => 0) psi l z) ∧
      _root_.SubdiffusiveProcess.Model.aCutoff M l
          (SubdiffusiveProcess.CoarseGrainingVocab.translatePotentialSample x (eta N omega))
          (w + (3 : ℝ) ^ (-m) • y) =
        SubdiffusiveProcess.CoarseGrainingVocab.ahom M l *
          (aux_lem_band_transport_h0_kappa M ((l : ℤ) - m).toNat / aux_lem_band_transport_h0_kappa M l *
              Real.exp (aux_lem_band_transport_h0_retained m (w + (3 : ℝ) ^ (-m) • y) psi)) *
            cutoffCoefficient M (fun _ => 0) (aux_lem_band_transport_S m w psi) (((l : ℤ) - m).toNat) y := by
  obtain ⟨psi, hpsi⟩ := aux_lem_band_rcJ_bridge_B1b_aCutoff_normalization_exists M omega N l x eta heta
  refine ⟨psi, hpsi, ?_⟩
  rw [hpsi (w + (3 : ℝ) ^ (-m) • y), aux_lem_band_transport_h0_coefficient M m w l hm psi y]
  ring

theorem aux_lem_band_rcJ_bridge_B2_polarization {d : ℕ}
    (A A' : Fin d → Fin d → ℝ) (_hA : ∀ i j, A i j = A j i) (_hA' : ∀ i j, A' i j = A' j i)
    (f f' : Vec d → ℝ)
    (hf : ∀ e : Vec d, f e = ∑ i, ∑ j, A i j * e i * e j)
    (hf' : ∀ e : Vec d, f' e = ∑ i, ∑ j, A' i j * e i * e j)
    (eps : ℝ) (_heps : ∀ i j, |A i j - A' i j| ≤ eps) :
    |sSup {v : ℝ | ∃ e : Vec d, vecNormSq e = 1 ∧ v = f e} -
      sSup {v : ℝ | ∃ e : Vec d, vecNormSq e = 1 ∧ v = f' e}| ≤
      (d : ℝ) ^ 2 * eps := by
  set S : Set ℝ := {v : ℝ | ∃ e : Vec d, vecNormSq e = 1 ∧ v = f e} with hSdef
  set S' : Set ℝ := {v : ℝ | ∃ e : Vec d, vecNormSq e = 1 ∧ v = f' e} with hS'def
  have he_le : ∀ (e : Vec d), vecNormSq e = 1 → ∀ i, |e i| ≤ 1 := by
    intro e he i
    have hsq : e i ^ 2 ≤ vecNormSq e := sq_apply_le_vecNormSq e i
    rw [he] at hsq
    exact (sq_le_one_iff_abs_le_one (e i)).mp hsq
  have hterm_le : ∀ (c : ℝ) (e : Vec d), vecNormSq e = 1 → ∀ i j : Fin d,
      |c * e i * e j| ≤ |c| := by
    intro c e he i j
    have h2 : |e i| ≤ 1 := he_le e he i
    have h3 : |e j| ≤ 1 := he_le e he j
    have hc0 : 0 ≤ |c| := abs_nonneg _
    rw [abs_mul, abs_mul]
    calc |c| * |e i| * |e j| ≤ |c| * 1 * 1 :=
          mul_le_mul (mul_le_mul_of_nonneg_left h2 hc0) h3 (abs_nonneg _) (by positivity)
      _ = |c| := by ring
  have hclose : ∀ e : Vec d, vecNormSq e = 1 → |f e - f' e| ≤ (d : ℝ) ^ 2 * eps := by
    intro e he
    have hdiff : f e - f' e = ∑ i, ∑ j, (A i j - A' i j) * e i * e j := by
      rw [hf e, hf' e, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    rw [hdiff]
    calc |∑ i, ∑ j, (A i j - A' i j) * e i * e j|
        ≤ ∑ i : Fin d, |∑ j, (A i j - A' i j) * e i * e j| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin d, ∑ j : Fin d, |(A i j - A' i j) * e i * e j| :=
          Finset.sum_le_sum (fun i _ => Finset.abs_sum_le_sum_abs _ _)
      _ ≤ ∑ i : Fin d, ∑ j : Fin d, eps :=
          Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun j _ =>
            (hterm_le (A i j - A' i j) e he i j).trans (_heps i j)))
      _ = (d : ℝ) ^ 2 * eps := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          ring
  have hbdd : ∀ (B : Fin d → Fin d → ℝ) (g : Vec d → ℝ),
      (∀ e : Vec d, g e = ∑ i, ∑ j, B i j * e i * e j) →
      BddAbove {v : ℝ | ∃ e : Vec d, vecNormSq e = 1 ∧ v = g e} := by
    intro B g hg
    refine ⟨∑ i : Fin d, ∑ j : Fin d, |B i j|, ?_⟩
    rintro v ⟨e, he, rfl⟩
    rw [hg e]
    calc ∑ i, ∑ j, B i j * e i * e j
        ≤ |∑ i, ∑ j, B i j * e i * e j| := le_abs_self _
      _ ≤ ∑ i : Fin d, |∑ j, B i j * e i * e j| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin d, ∑ j : Fin d, |B i j * e i * e j| :=
          Finset.sum_le_sum (fun i _ => Finset.abs_sum_le_sum_abs _ _)
      _ ≤ ∑ i : Fin d, ∑ j : Fin d, |B i j| :=
          Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun j _ => hterm_le (B i j) e he i j))
  have hbddS : BddAbove S := hbdd A f hf
  have hbddS' : BddAbove S' := hbdd A' f' hf'
  by_cases hne : ∃ e : Vec d, vecNormSq e = 1
  · obtain ⟨e0, he0⟩ := hne
    have hSne : S.Nonempty := ⟨f e0, e0, he0, rfl⟩
    have hS'ne : S'.Nonempty := ⟨f' e0, e0, he0, rfl⟩
    have hdir1 : sSup S ≤ sSup S' + (d : ℝ) ^ 2 * eps := by
      refine csSup_le hSne (fun v hv => ?_)
      obtain ⟨e, he, rfl⟩ := hv
      have h1 := (abs_le.mp (hclose e he)).2
      have h2 : f' e ≤ sSup S' := le_csSup hbddS' ⟨e, he, rfl⟩
      linarith
    have hdir2 : sSup S' ≤ sSup S + (d : ℝ) ^ 2 * eps := by
      refine csSup_le hS'ne (fun v hv => ?_)
      obtain ⟨e, he, rfl⟩ := hv
      have h1 := (abs_le.mp (hclose e he)).1
      have h2 : f e ≤ sSup S := le_csSup hbddS ⟨e, he, rfl⟩
      linarith
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  · have hSempty : S = ∅ := Set.eq_empty_of_forall_notMem (fun v ⟨e, he, _⟩ => hne ⟨e, he⟩)
    have hS'empty : S' = ∅ := Set.eq_empty_of_forall_notMem (fun v ⟨e, he, _⟩ => hne ⟨e, he⟩)
    rw [hSempty, hS'empty, Real.sSup_empty, sub_zero, abs_zero]
    rcases Nat.eq_zero_or_pos d with hd0 | hdpos
    · subst hd0
      norm_num
    · exfalso
      apply hne
      refine ⟨(fun i => if i = (⟨0, hdpos⟩ : Fin d) then (1 : ℝ) else 0), ?_⟩
      unfold vecNormSq vecDot
      dsimp only
      rw [Finset.sum_eq_single_of_mem (⟨0, hdpos⟩ : Fin d) (Finset.mem_univ _)
        (fun b _ hb => by simp [ite_eq_right hb])]
      simp

theorem aux_lem_band_rcJ_bridge_B2_quadratic_of_linear {d : ℕ} {V : Type*} [AddCommGroup V] [Module ℝ V]
    (M : (Fin d → ℝ) → V)
    (hMadd : ∀ p q, M (p + q) = M p + M q)
    (hMsmul : ∀ (r : ℝ) (p : Fin d → ℝ), M (r • p) = r • M p)
    (bil : V → V → ℝ)
    (hbil_add_l : ∀ u v w, bil (u + v) w = bil u w + bil v w)
    (hbil_smul_l : ∀ (r : ℝ) u w, bil (r • u) w = r * bil u w)
    (hbil_add_r : ∀ u v w, bil u (v + w) = bil u v + bil u w)
    (hbil_smul_r : ∀ (r : ℝ) u w, bil u (r • w) = r * bil u w)
    (e : Fin d → ℝ) :
    bil (M e) (M e) =
      ∑ i : Fin d, ∑ j : Fin d, bil (M ((Pi.single i 1 : Fin d → ℝ))) (M ((Pi.single j 1 : Fin d → ℝ))) * e i * e j := by
  classical
  have hM0 : M 0 = 0 := by simpa using hMsmul 0 0
  have hbil0l : ∀ w, bil 0 w = 0 := by
    intro w
    have h := hbil_add_l 0 0 w
    simpa using h
  have hbil0r : ∀ u, bil u 0 = 0 := by
    intro u
    have h := hbil_add_r u 0 0
    simpa using h
  have hMsum : ∀ (s : Finset (Fin d)) (c : Fin d → ℝ),
      M (∑ i ∈ s, c i • (Pi.single i 1 : Fin d → ℝ)) = ∑ i ∈ s, c i • M ((Pi.single i 1 : Fin d → ℝ)) := by
    intro s c
    induction s using Finset.induction with
    | empty => simpa using hM0
    | insert a s' hx ih =>
      rw [Finset.sum_insert hx, Finset.sum_insert hx, hMadd, hMsmul, ih]
  have hbilsum_l : ∀ (s : Finset (Fin d)) (v : Fin d → V) (w : V),
      bil (∑ i ∈ s, v i) w = ∑ i ∈ s, bil (v i) w := by
    intro s v w
    induction s using Finset.induction with
    | empty => simpa using hbil0l w
    | insert a s' hx ih =>
      rw [Finset.sum_insert hx, Finset.sum_insert hx, hbil_add_l, ih]
  have hbilsum_r : ∀ (s : Finset (Fin d)) (u : V) (v : Fin d → V),
      bil u (∑ j ∈ s, v j) = ∑ j ∈ s, bil u (v j) := by
    intro s u v
    induction s using Finset.induction with
    | empty => simpa using hbil0r u
    | insert a s' hx ih =>
      rw [Finset.sum_insert hx, Finset.sum_insert hx, hbil_add_r, ih]
  have he : e = ∑ i : Fin d, e i • Pi.single (M := fun _ : Fin d => ℝ) i 1 := pi_eq_sum_univ' e
  have hMe : M e = ∑ i : Fin d, e i • M ((Pi.single i 1 : Fin d → ℝ)) := by
    conv_lhs => rw [he]
    exact hMsum Finset.univ e
  rw [hMe, hbilsum_l Finset.univ (fun i => e i • M ((Pi.single i 1 : Fin d → ℝ))) (∑ j, e j • M ((Pi.single j 1 : Fin d → ℝ)))]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [hbil_smul_l, hbilsum_r Finset.univ (M ((Pi.single i 1 : Fin d → ℝ))) (fun j => e j • M ((Pi.single j 1 : Fin d → ℝ)))]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hbil_smul_r]
  ring

section NeumannLinearity

variable {d : ℕ} {Ω : Opens (SpatialCoordinates d)}
  [IsFiniteMeasure (volume.restrict (Ω : Set (SpatialCoordinates d)))]

theorem aux_lem_band_rcJ_bridge_B2_domainConstantL2_add (c1 c2 : ℝ) :
    domainConstantL2 (Ω := Ω) (c1 + c2) = domainConstantL2 c1 + domainConstantL2 c2 := by
  unfold domainConstantL2
  have hfun : (fun _ : SpatialCoordinates d => c1 + c2) =
      (fun _ : SpatialCoordinates d => c1) + (fun _ : SpatialCoordinates d => c2) := by
    funext x; simp
  rw [MemLp.toLp_congr (memLp_const (c1 + c2)) ((memLp_const c1).add (memLp_const c2))
    (Filter.EventuallyEq.of_eq hfun), MemLp.toLp_add]

theorem aux_lem_band_rcJ_bridge_B2_domainConstantL2_smul (r c : ℝ) :
    domainConstantL2 (Ω := Ω) (r * c) = r • domainConstantL2 c := by
  unfold domainConstantL2
  have hfun : (fun _ : SpatialCoordinates d => r * c) = r • (fun _ : SpatialCoordinates d => c) := by
    funext x; simp
  rw [MemLp.toLp_congr (memLp_const (r * c)) ((memLp_const c).const_smul r)
    (Filter.EventuallyEq.of_eq hfun), MemLp.toLp_const_smul]

theorem aux_lem_band_rcJ_bridge_B2_affineNeumannLoad_add (p q : Fin d → ℝ) :
    affineNeumannLoad (Ω := Ω) (p + q) = affineNeumannLoad p + affineNeumannLoad q := by
  unfold affineNeumannLoad
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Pi.add_apply, aux_lem_band_rcJ_bridge_B2_domainConstantL2_add, map_add, ContinuousLinearMap.add_comp]

theorem aux_lem_band_rcJ_bridge_B2_affineNeumannLoad_smul (r : ℝ) (p : Fin d → ℝ) :
    affineNeumannLoad (Ω := Ω) (r • p) = r • affineNeumannLoad p := by
  apply ContinuousLinearMap.ext
  intro g
  rw [_root_.smul_apply, affineNeumannLoad_apply, affineNeumannLoad_apply,
    smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Pi.smul_apply, smul_eq_mul, ← MeasureTheory.integral_const_mul]
  congr 1
  funext x
  ring

end NeumannLinearity

section NeumannQuadratic

variable {d : ℕ} {Ω : Opens (SpatialCoordinates d)}
  [IsFiniteMeasure (volume.restrict (Ω : Set (SpatialCoordinates d)))]

theorem aux_lem_band_rcJ_bridge_B2_neumann_quadratic
    (hP : ∃ K : ℝ≥0, ∀ z : meanZeroSobolevGraph Ω,
      ‖(z : SobolevData Ω).1‖ ≤ K * ‖subspaceGradient (meanZeroSobolevGraph Ω) z‖)
    (a : PositiveCoefficient Ω) :
    ∃ A : Fin d → Fin d → ℝ, (∀ i j, A i j = A j i) ∧
      ∀ e : Fin d → ℝ,
        affineInverseNeumannResponse hP a e = ∑ i : Fin d, ∑ j : Fin d, A i j * e i * e j := by
  set S := meanZeroResponseSpace hP with hSdef
  let L : (Fin d → ℝ) → (S.space →L[ℝ] ℝ) :=
    fun p => (affineNeumannLoad p).comp (subspaceGradient (meanZeroSobolevGraph Ω))
  let M : (Fin d → ℝ) → S.space := fun p => responseSolution S a (L p)
  have hLadd : ∀ p q, L (p + q) = L p + L q := by
    intro p q
    show (affineNeumannLoad (p + q)).comp (subspaceGradient (meanZeroSobolevGraph Ω)) = _
    rw [aux_lem_band_rcJ_bridge_B2_affineNeumannLoad_add, ContinuousLinearMap.add_comp]
    rfl
  have hLsmul : ∀ (r : ℝ) p, L (r • p) = r • L p := by
    intro r p
    show (affineNeumannLoad (r • p)).comp (subspaceGradient (meanZeroSobolevGraph Ω)) = _
    rw [aux_lem_band_rcJ_bridge_B2_affineNeumannLoad_smul, ContinuousLinearMap.smul_comp]
    rfl
  have hMadd : ∀ p q, M (p + q) = M p + M q := by
    intro p q
    show responseSolution S a (L (p + q)) = _
    rw [hLadd, responseSolution_add]
  have hMsmul : ∀ (r : ℝ) p, M (r • p) = r • M p := by
    intro r p
    show responseSolution S a (L (r • p)) = _
    rw [hLsmul, responseSolution_smul]
  have hbil_add_l : ∀ u v w : S.space, responseForm S a (u + v) w =
      responseForm S a u w + responseForm S a v w := by
    intro u v w; simp only [map_add, _root_.add_apply]
  have hbil_smul_l : ∀ (r : ℝ) (u w : S.space),
      responseForm S a (r • u) w = r * responseForm S a u w := by
    intro r u w; simp only [map_smul, _root_.smul_apply, smul_eq_mul]
  have hbil_add_r : ∀ u v w : S.space, responseForm S a u (v + w) =
      responseForm S a u v + responseForm S a u w := by
    intro u v w; simp only [map_add]
  have hbil_smul_r : ∀ (r : ℝ) (u w : S.space),
      responseForm S a u (r • w) = r * responseForm S a u w := by
    intro r u w; simp only [map_smul, smul_eq_mul]
  refine ⟨fun i j => responseForm S a (M (Pi.single i 1)) (M (Pi.single j 1)), fun i j => ?_,
    fun e => ?_⟩
  · exact responseForm_symm S a _ _
  · have hq := aux_lem_band_rcJ_bridge_B2_quadratic_of_linear M hMadd hMsmul
      (fun u v => responseForm S a u v) hbil_add_l hbil_smul_l hbil_add_r hbil_smul_r e
    unfold affineInverseNeumannResponse inverseResponse
    exact hq

end NeumannQuadratic

section DirichletQuadratic

variable {d : ℕ} {Ω : Opens (SpatialCoordinates d)}
  [IsFiniteMeasure (volume.restrict (Ω : Set (SpatialCoordinates d)))]

theorem aux_lem_band_rcJ_bridge_B2_affineL2_add (hΩ : Bornology.IsBounded (Ω : Set (SpatialCoordinates d)))
    (p q : Fin d → ℝ) :
    affineL2 hΩ (p + q) 0 = affineL2 hΩ p 0 + affineL2 hΩ q 0 := by
  unfold affineL2
  have hfun : (fun x => affineSlope (p + q) x + 0) =
      (fun x => affineSlope p x + 0) + (fun x => affineSlope q x + 0) := by
    funext x
    simp only [Pi.add_apply, affineSlope_apply, add_zero]
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i _ => by ring)
  rw [MemLp.toLp_congr (affine_memLp hΩ (p + q) 0) ((affine_memLp hΩ p 0).add (affine_memLp hΩ q 0))
    (Filter.EventuallyEq.of_eq hfun), MemLp.toLp_add]

theorem aux_lem_band_rcJ_bridge_B2_affineL2_smul (hΩ : Bornology.IsBounded (Ω : Set (SpatialCoordinates d)))
    (r : ℝ) (p : Fin d → ℝ) :
    affineL2 hΩ (r • p) 0 = r • affineL2 hΩ p 0 := by
  unfold affineL2
  have hfun : (fun x => affineSlope (r • p) x + 0) = r • (fun x => affineSlope p x + 0) := by
    funext x
    simp only [Pi.smul_apply, affineSlope_apply, add_zero, smul_eq_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => by ring)
  rw [MemLp.toLp_congr (affine_memLp hΩ (r • p) 0) ((affine_memLp hΩ p 0).const_smul r)
    (Filter.EventuallyEq.of_eq hfun), MemLp.toLp_const_smul]

theorem aux_lem_band_rcJ_bridge_B2_affineSobolev_add
    (hΩ : Bornology.IsBounded (Ω : Set (SpatialCoordinates d))) (p q : Fin d → ℝ) :
    affineSobolev hΩ (p + q) 0 = affineSobolev hΩ p 0 + affineSobolev hΩ q 0 := by
  apply Subtype.ext
  show affineSobolevData hΩ (p + q) 0 =
      (affineSobolev hΩ p 0 : SobolevData Ω) + (affineSobolev hΩ q 0 : SobolevData Ω)
  show affineSobolevData hΩ (p + q) 0 = affineSobolevData hΩ p 0 + affineSobolevData hΩ q 0
  unfold affineSobolevData
  apply Prod.ext
  · exact aux_lem_band_rcJ_bridge_B2_affineL2_add hΩ p q
  · funext i
    show domainConstantL2 ((p + q) i) = domainConstantL2 (p i) + domainConstantL2 (q i)
    rw [Pi.add_apply]
    exact aux_lem_band_rcJ_bridge_B2_domainConstantL2_add (p i) (q i)

theorem aux_lem_band_rcJ_bridge_B2_affineSobolev_smul
    (hΩ : Bornology.IsBounded (Ω : Set (SpatialCoordinates d))) (r : ℝ) (p : Fin d → ℝ) :
    affineSobolev hΩ (r • p) 0 = r • affineSobolev hΩ p 0 := by
  apply Subtype.ext
  show affineSobolevData hΩ (r • p) 0 = r • (affineSobolev hΩ p 0 : SobolevData Ω)
  show affineSobolevData hΩ (r • p) 0 = r • affineSobolevData hΩ p 0
  unfold affineSobolevData
  apply Prod.ext
  · exact aux_lem_band_rcJ_bridge_B2_affineL2_smul hΩ r p
  · funext i
    show domainConstantL2 (Ω := Ω) ((r • p) i) = r • domainConstantL2 (Ω := Ω) (p i)
    rw [Pi.smul_apply, smul_eq_mul]
    exact aux_lem_band_rcJ_bridge_B2_domainConstantL2_smul r (p i)

end DirichletQuadratic

section DirichletQuadraticFinal

variable {d : ℕ} {Ω : Opens (SpatialCoordinates d)}
  [IsFiniteMeasure (volume.restrict (Ω : Set (SpatialCoordinates d)))]

theorem aux_lem_band_rcJ_bridge_B2_dirichlet_quadratic
    (hΩ : Bornology.IsBounded (Ω : Set (SpatialCoordinates d)))
    (hP : ∃ K : ℝ≥0, ∀ z : killedSobolevGraph Ω,
      ‖(z : SobolevData Ω).1‖ ≤ K * ‖subspaceGradient (killedSobolevGraph Ω) z‖)
    (a : PositiveCoefficient Ω) :
    ∃ A : Fin d → Fin d → ℝ, (∀ i j, A i j = A j i) ∧
      ∀ e : Fin d → ℝ,
        affineDirichletResponse hΩ hP a e = ∑ i : Fin d, ∑ j : Fin d, A i j * e i * e j := by
  set S := killedResponseSpace hP with hSdef
  let Mv : (Fin d → ℝ) → SobolevData Ω :=
    fun p => (dirichletMinimizer S a (affineSobolev hΩ p 0) : SobolevData Ω)
  have hMvadd : ∀ p q, Mv (p + q) = Mv p + Mv q := by
    intro p q
    show (dirichletMinimizer S a (affineSobolev hΩ (p + q) 0) : SobolevData Ω) = _
    rw [aux_lem_band_rcJ_bridge_B2_affineSobolev_add hΩ, dirichletMinimizer_add]
    rfl
  have hMvsmul : ∀ (r : ℝ) p, Mv (r • p) = r • Mv p := by
    intro r p
    show (dirichletMinimizer S a (affineSobolev hΩ (r • p) 0) : SobolevData Ω) = _
    rw [aux_lem_band_rcJ_bridge_B2_affineSobolev_smul hΩ, dirichletMinimizer_smul]
    rfl
  have hbil_add_l : ∀ u v w : SobolevData Ω, sobolevCoefficientForm a (u + v) w =
      sobolevCoefficientForm a u w + sobolevCoefficientForm a v w := by
    intro u v w; simp only [map_add, _root_.add_apply]
  have hbil_smul_l : ∀ (r : ℝ) (u w : SobolevData Ω),
      sobolevCoefficientForm a (r • u) w = r * sobolevCoefficientForm a u w := by
    intro r u w; simp only [map_smul, _root_.smul_apply, smul_eq_mul]
  have hbil_add_r : ∀ u v w : SobolevData Ω, sobolevCoefficientForm a u (v + w) =
      sobolevCoefficientForm a u v + sobolevCoefficientForm a u w := by
    intro u v w; simp only [map_add]
  have hbil_smul_r : ∀ (r : ℝ) (u w : SobolevData Ω),
      sobolevCoefficientForm a u (r • w) = r * sobolevCoefficientForm a u w := by
    intro r u w; simp only [map_smul, smul_eq_mul]
  refine ⟨fun i j => sobolevCoefficientForm a (Mv (Pi.single i 1)) (Mv (Pi.single j 1)),
    fun i j => ?_, fun e => ?_⟩
  · exact sobolevCoefficientForm_symm a _ _
  · have hq := aux_lem_band_rcJ_bridge_B2_quadratic_of_linear Mv hMvadd hMvsmul
      (fun u v => sobolevCoefficientForm a u v) hbil_add_l hbil_smul_l hbil_add_r hbil_smul_r e
    unfold affineDirichletResponse dirichletResponse
    exact hq

end DirichletQuadraticFinal

theorem aux_lem_band_rcJ_bridge_B3a_window_le_bandSigma {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] (h : ℕ) :
