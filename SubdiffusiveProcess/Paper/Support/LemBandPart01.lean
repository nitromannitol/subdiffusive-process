    rw [Real.sqrt_eq_rpow]
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have hqnat1 : (1:ℝ) ≤ (qnat:ℝ) := by exact_mod_cast hqnat
    have h2q : (2:ℝ) ≤ 2 * qnat := by nlinarith
    exact one_div_le_one_div_of_le (by norm_num) h2q
  rw [hsplit, hsecond] at hpow
  calc (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤
      (2:ℝ) ^ ((1:ℝ) / (2 * qnat)) * Real.sqrt (A + B * gap) := hpow
    _ ≤ Real.sqrt 2 * Real.sqrt (A + B * gap) := by
        apply mul_le_mul_of_nonneg_right hfirst (Real.sqrt_nonneg _)

