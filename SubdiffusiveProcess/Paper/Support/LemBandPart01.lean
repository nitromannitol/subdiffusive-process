def aux_lem_band_gapD_T1index (dd gap : ℕ) : Finset (Fin dd → ℤ) :=
  Fintype.piFinset (fun _ : Fin dd => Finset.Icc (-(3 ^ gap : ℤ)) (3 ^ gap))

theorem aux_lem_band_gapD_T1index_mono (dd : ℕ) {gap1 gap2 : ℕ} (h : gap1 ≤ gap2) :
    aux_lem_band_gapD_T1index dd gap1 ⊆ aux_lem_band_gapD_T1index dd gap2 := by
  intro kidx hkidx
  rw [aux_lem_band_gapD_T1index, Fintype.mem_piFinset] at hkidx ⊢
  intro i
  have hi := hkidx i
  rw [Finset.mem_Icc] at hi ⊢
  have hp : (3 : ℤ) ^ gap1 ≤ (3 : ℤ) ^ gap2 := pow_le_pow_right₀ (by norm_num) h
  exact ⟨by linarith [hi.1], by linarith [hi.2]⟩

theorem aux_lem_band_gapD_T1index_card_le (dd gap : ℕ) :
    (aux_lem_band_gapD_T1index dd gap).card ≤ (2 * 3 ^ gap + 1) ^ dd := by
  have hcard : (aux_lem_band_gapD_T1index dd gap).card = (2 * 3 ^ gap + 1) ^ dd := by
    rw [aux_lem_band_gapD_T1index, Fintype.card_piFinset]
    have h1 : ∀ _ : Fin dd, (Finset.Icc (-(3 ^ gap : ℤ)) (3 ^ gap)).card = 2 * 3 ^ gap + 1 := by
      intro _
      rw [Int.card_Icc]
      have heq : (3 : ℤ) ^ gap + 1 - (-(3 ^ gap : ℤ)) = ((2 * 3 ^ gap + 1 : ℕ) : ℤ) := by
        push_cast; ring
      rw [heq, Int.toNat_natCast]
    rw [Finset.prod_congr rfl (fun i _ => h1 i), Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
  exact hcard.le

def aux_lem_band_gapD_T1point {d : ℕ} (l : ℕ) (z : Vec d) (kidx : Fin d → ℤ) : Vec d :=
