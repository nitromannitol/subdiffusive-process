      (ENNReal.toReal_sub_of_le (hrestr_le_Praw omega) hfinS).symm
    have hnn : (0 : ℝ) ≤ (aux_lem_band_piece_product_Praw d s m z omega).toReal -
        (restr omega).toReal := by
      rw [heqtoreal]; exact ENNReal.toReal_nonneg
    rw [Real.norm_eq_abs, abs_of_nonneg hnn, heqtoreal]
    have hfinPscF2 : aux_lem_band_piece_product_Praw d (s / 2) m z omega ≠ ⊤ := by
