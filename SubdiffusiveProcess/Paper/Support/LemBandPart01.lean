theorem aux_lem_band_min_le_sqrt_mul (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    min a b ≤ Real.sqrt (a * b) := by
  rw [Real.le_sqrt (le_min ha hb) (mul_nonneg ha hb)]
  rw [sq]
  exact mul_le_mul (min_le_left a b) (min_le_right a b) (le_min ha hb) ha

theorem aux_lem_band_sqrt_mul_four (C1 C2 r1 r2 : ℝ) (hC1 : 0 ≤ C1) (hC2 : 0 ≤ C2) :
    Real.sqrt (C1 * r1 * (C2 * r2)) = Real.sqrt (C1 * C2) * Real.sqrt (r1 * r2) := by
  rw [show C1 * r1 * (C2 * r2) = (C1 * C2) * (r1 * r2) by ring,
    Real.sqrt_mul (mul_nonneg hC1 hC2)]

theorem aux_lem_band_disorder_geometric_mean (Cp Cq delta rho : ℝ) (b : ℕ)
    (hCp : 0 ≤ Cp) (hCq : 0 ≤ Cq) (hdelta : 0 ≤ delta) (hrho : 0 ≤ rho) :
    min (Cp * delta ^ b) (Cq * rho) ≤
      2 * Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := by
  have hnonneg1 : 0 ≤ Cp * delta ^ b := mul_nonneg hCp (pow_nonneg hdelta b)
  have hnonneg2 : 0 ≤ Cq * rho := mul_nonneg hCq hrho
  have hmin_le_sqrt : min (Cp * delta ^ b) (Cq * rho) ≤
      Real.sqrt ((Cp * delta ^ b) * (Cq * rho)) :=
    aux_lem_band_min_le_sqrt_mul (Cp * delta ^ b) (Cq * rho) hnonneg1 hnonneg2
  have hsqrt_eq : Real.sqrt ((Cp * delta ^ b) * (Cq * rho)) =
      Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := by
    calc
      Real.sqrt ((Cp * delta ^ b) * (Cq * rho)) =
          Real.sqrt (Cp * delta ^ b * (Cq * rho)) := by ring
      _ = Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) :=
        aux_lem_band_sqrt_mul_four Cp Cq (delta ^ b) rho hCp hCq
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    min (Cp * delta ^ b) (Cq * rho) ≤ Real.sqrt ((Cp * delta ^ b) * (Cq * rho)) := hmin_le_sqrt
    _ = Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := hsqrt_eq
    _ ≤ 2 * (Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho)) :=
      le_mul_of_one_le_left hsqrt_nonneg (by norm_num : (1 : ℝ) ≤ 2)
    _ = 2 * Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := by ring

theorem aux_lem_band_err_case_split
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {mb : MeasurableSpace Ω}
    (X : Ω → ℝ) (x0 : ℝ) (Xtrunc : Ω → ℝ)
    (hXtruncmeas : AEStronglyMeasurable[mb] Xtrunc μ)
    (p : ℝ≥0∞) (Cq Cp delta rho : ℝ) (b : ℕ)
    (hCq : 0 ≤ Cq) (hCp : 0 ≤ Cp) (hdelta : 0 ≤ delta) (hrho : 0 ≤ rho)
    (hbase : eLpNorm (fun ω => X ω - x0) p μ ≤ ENNReal.ofReal (Cq * delta ^ b))
    (htrunc : eLpNorm (fun ω => X ω - Xtrunc ω) p μ ≤ ENNReal.ofReal (Cp * rho)) :
    ∃ Xband : Ω → ℝ, AEStronglyMeasurable[mb] Xband μ ∧
      eLpNorm (fun ω => X ω - Xband ω) p μ ≤
        ENNReal.ofReal (2 * Real.sqrt (Cq * Cp) * Real.sqrt (delta ^ b * rho)) := by
  rcases le_or_gt (Cq * delta ^ b) (Cp * rho) with hle | hlt
  · refine ⟨fun _ => x0, aestronglyMeasurable_const, hbase.trans (ENNReal.ofReal_le_ofReal ?_)⟩
    calc Cq * delta ^ b = min (Cq * delta ^ b) (Cp * rho) := (min_eq_left hle).symm
      _ ≤ 2 * Real.sqrt (Cq * Cp) * Real.sqrt (delta ^ b * rho) :=
        aux_lem_band_disorder_geometric_mean Cq Cp delta rho b hCq hCp hdelta hrho
  · refine ⟨Xtrunc, hXtruncmeas, htrunc.trans (ENNReal.ofReal_le_ofReal ?_)⟩
    calc Cp * rho = min (Cq * delta ^ b) (Cp * rho) := (min_eq_right hlt.le).symm
      _ ≤ 2 * Real.sqrt (Cq * Cp) * Real.sqrt (delta ^ b * rho) :=
        aux_lem_band_disorder_geometric_mean Cq Cp delta rho b hCq hCp hdelta hrho

theorem aux_lem_band_piece_field_scale {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (c : ℝ) (hc : 0 ≤ c) (g : Ω → ℝ) (p : ℝ≥0∞) (b : ℝ)
    (hg : eLpNorm g p μ ≤ ENNReal.ofReal b) :
    eLpNorm (fun ω => c * g ω) p μ ≤ ENNReal.ofReal (c * b) := by
  have hrw : (fun ω => c * g ω) = c • g := rfl
  rw [hrw, eLpNorm_const_smul, Real.enorm_eq_ofReal hc, ENNReal.ofReal_mul hc]
  exact mul_le_mul_right hg _

theorem aux_lem_band_piece_field_weaken {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (Y : Ω → ℝ) (p : ℝ≥0∞) (C delta c1 c0 a1 a0 : ℝ) (h : ℕ)
    (hdelta_pos : 0 < delta) (hdelta_le_one : delta ≤ 1)
    (hc0 : c0 ≤ c1) (ha0 : a0 ≤ a1) (hC : 0 ≤ C)
    (hY : eLpNorm Y p μ ≤ ENNReal.ofReal (C * delta ^ c1 * (3 : ℝ) ^ (-(a1 * (h : ℝ))))) :
    eLpNorm Y p μ ≤ ENNReal.ofReal (C * (delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))))) := by
  refine hY.trans (ENNReal.ofReal_le_ofReal ?_)
  have hweakc : delta ^ c1 ≤ delta ^ c0 :=
    Real.rpow_le_rpow_of_exponent_ge hdelta_pos hdelta_le_one hc0
  have hweaka : (3 : ℝ) ^ (-(a1 * (h : ℝ))) ≤ (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 3)
    have hh0 : (0 : ℝ) ≤ (h : ℝ) := Nat.cast_nonneg h
    nlinarith only [ha0, hh0]
  calc C * delta ^ c1 * (3 : ℝ) ^ (-(a1 * (h : ℝ)))
      ≤ C * delta ^ c0 * (3 : ℝ) ^ (-(a1 * (h : ℝ))) := by
        apply mul_le_mul_of_nonneg_right _ (by positivity)
        exact mul_le_mul_of_nonneg_left hweakc hC
    _ ≤ C * delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by
        apply mul_le_mul_of_nonneg_left hweaka
        positivity
    _ = C * (delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by ring

theorem aux_lem_band_piece_field_weaken_const {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (Y : Ω → ℝ) (p : ℝ≥0∞) (C1 C0 rate : ℝ)
    (hC1 : 0 ≤ C1) (hC0 : C1 ≤ C0)
    (hY : eLpNorm Y p μ ≤ ENNReal.ofReal (C1 * rate)) (hrate : 0 ≤ rate) :
    eLpNorm Y p μ ≤ ENNReal.ofReal (C0 * rate) :=
  hY.trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hC0 hrate))

theorem aux_lem_band_T234_nat_le_rpow_div (r : ℝ) (hr : 1 < r) (n : ℕ) :
    (n : ℝ) ≤ r ^ n / (r - 1) := by
  have ht : (0:ℝ) < r - 1 := by linarith
  have hbern : 1 + (n:ℝ) * (r - 1) ≤ (1 + (r-1)) ^ n :=
    one_add_mul_le_pow (by linarith : (-2:ℝ) ≤ r - 1) n
  have hbern' : 1 + (n:ℝ) * (r - 1) ≤ r ^ n := by
    have heq : (1 + (r-1) : ℝ) = r := by ring
    rwa [heq] at hbern
  rw [le_div_iff₀ ht]
  nlinarith [hbern']

theorem aux_lem_band_T234_affine_le_rpow (a P Q : ℝ) (ha : 0 < a) (hP : 0 ≤ P) (hQ : 0 ≤ Q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ, P + Q * (n:ℝ) ≤ C * (3:ℝ) ^ (a * (n:ℝ)) := by
  set r : ℝ := (3:ℝ) ^ a with hr_def
  have hr1 : 1 < r := by
    rw [hr_def]; exact Real.one_lt_rpow (by norm_num) ha
  have hrpos : 0 < r - 1 := by linarith
  refine ⟨P + Q / (r - 1), by positivity, ?_⟩
  intro n
  have hrn : (n:ℝ) ≤ r ^ n / (r - 1) := aux_lem_band_T234_nat_le_rpow_div r hr1 n
  have h1le : (1:ℝ) ≤ r ^ n := one_le_pow₀ hr1.le
  have hstep : P + Q * (n:ℝ) ≤ P * r ^ n + (Q / (r-1)) * r ^ n := by
    have hQn : Q * (n:ℝ) ≤ (Q / (r-1)) * r ^ n := by
      rw [div_mul_eq_mul_div, le_div_iff₀ hrpos]
      calc Q * (n:ℝ) * (r-1) ≤ Q * (r^n/(r-1)) * (r-1) := by
            apply mul_le_mul_of_nonneg_right _ hrpos.le
            exact mul_le_mul_of_nonneg_left hrn hQ
        _ = Q * r^n := by field_simp
    have hPn : P ≤ P * r ^ n := by
      calc P = P * 1 := by ring
        _ ≤ P * r ^ n := by apply mul_le_mul_of_nonneg_left h1le hP
    linarith
  have hrpow : r ^ n = (3:ℝ) ^ (a * (n:ℝ)) := by
    rw [hr_def, ← Real.rpow_natCast ((3:ℝ) ^ a) n, ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 3)]
  calc P + Q * (n:ℝ) ≤ P * r ^ n + (Q / (r-1)) * r ^ n := hstep
    _ = (P + Q / (r - 1)) * r ^ n := by ring
    _ = (P + Q / (r - 1)) * (3:ℝ) ^ (a * (n:ℝ)) := by rw [hrpow]

theorem aux_lem_band_T234_sq_le_rpow (a : ℝ) (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ, (n : ℝ) ^ 2 ≤ C * (3 : ℝ) ^ (a * (n : ℝ)) := by
  obtain ⟨C1, hC10, hC1⟩ := aux_lem_band_T234_affine_le_rpow (a / 2) 0 1 (by linarith) le_rfl zero_le_one
  refine ⟨C1 ^ 2, by positivity, fun n => ?_⟩
  have h1 : (n : ℝ) ≤ C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ)) := by simpa using hC1 n
  have hn0 : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
  have hsq : (n : ℝ) * (n : ℝ) ≤
      (C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ))) * (C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ))) :=
    mul_le_mul h1 h1 hn0 (by positivity)
  have heq : C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ)) * (C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ))) =
      C1 ^ 2 * (3 : ℝ) ^ (a * (n : ℝ)) := by
    rw [show C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ)) * (C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ))) =
        C1 ^ 2 * ((3 : ℝ) ^ (a / 2 * (n : ℝ)) * (3 : ℝ) ^ (a / 2 * (n : ℝ))) by ring,
      ← Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
    congr 2
    ring
  calc (n : ℝ) ^ 2 = (n : ℝ) * (n : ℝ) := by ring
    _ ≤ (C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ))) * (C1 * (3 : ℝ) ^ (a / 2 * (n : ℝ))) := hsq
    _ = C1 ^ 2 * (3 : ℝ) ^ (a * (n : ℝ)) := heq

theorem aux_lem_band_T234_sqrt_add_le (A B : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B) :
    Real.sqrt (A + B) ≤ Real.sqrt A + Real.sqrt B := by
  have hnn : (0:ℝ) ≤ Real.sqrt A + Real.sqrt B := by positivity
  have hsqle : A + B ≤ (Real.sqrt A + Real.sqrt B) ^ 2 := by
    nlinarith [Real.sq_sqrt hA, Real.sq_sqrt hB, Real.sqrt_nonneg A, Real.sqrt_nonneg B]
  calc Real.sqrt (A + B) ≤ Real.sqrt ((Real.sqrt A + Real.sqrt B) ^ 2) := Real.sqrt_le_sqrt hsqle
    _ = Real.sqrt A + Real.sqrt B := Real.sqrt_sq hnn

theorem aux_lem_band_T234_sqrt_nat_le (n : ℕ) : Real.sqrt (n:ℝ) ≤ (1 + (n:ℝ)) / 2 := by
  nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ (n:ℝ) by positivity), Real.sqrt_nonneg (n:ℝ),
    sq_nonneg (Real.sqrt (n:ℝ) - 1)]

theorem aux_lem_band_T234_sqrt_affine_le_rpow (a A B : ℝ) (ha : 0 < a) (hA : 0 ≤ A) (hB : 0 ≤ B) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ, Real.sqrt (A + B * (n:ℝ)) ≤ C * (3:ℝ) ^ (a * (n:ℝ)) := by
  obtain ⟨C, hC0, hC⟩ := aux_lem_band_T234_affine_le_rpow a (Real.sqrt A + Real.sqrt B / 2) (Real.sqrt B / 2)
    ha (by positivity) (by positivity)
  refine ⟨C, hC0, fun n => ?_⟩
  have hsub : Real.sqrt (A + B * (n:ℝ)) ≤ Real.sqrt A + Real.sqrt (B * (n:ℝ)) :=
    aux_lem_band_T234_sqrt_add_le A (B * (n:ℝ)) hA (by positivity)
  have hsn : Real.sqrt (B * (n:ℝ)) = Real.sqrt B * Real.sqrt (n:ℝ) := Real.sqrt_mul hB _
  have hamgm := aux_lem_band_T234_sqrt_nat_le n
  calc Real.sqrt (A + B * (n:ℝ)) ≤ Real.sqrt A + Real.sqrt (B * (n:ℝ)) := hsub
    _ = Real.sqrt A + Real.sqrt B * Real.sqrt (n:ℝ) := by rw [hsn]
    _ ≤ Real.sqrt A + Real.sqrt B * ((1 + (n:ℝ)) / 2) := by
        gcongr
    _ = (Real.sqrt A + Real.sqrt B / 2) + (Real.sqrt B / 2) * (n:ℝ) := by ring
    _ ≤ C * (3:ℝ) ^ (a * (n:ℝ)) := hC n

theorem aux_lem_band_T234_geom_sum_range_le (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (n : ℕ) :
    ∑ i ∈ Finset.range n, r ^ i ≤ 1 / (1 - r) := by
  have hne : r ≠ 1 := ne_of_lt hr1
  have hpos : (0:ℝ) < 1 - r := by linarith
  have heq : ∑ i ∈ Finset.range n, r ^ i = (1 - r ^ n) / (1 - r) := by
    rw [geom_sum_eq hne n, show r ^ n - 1 = -(1 - r ^ n) by ring,
      show r - 1 = -(1 - r) by ring, neg_div_neg_eq]
  rw [heq]
  have hrn : (0:ℝ) ≤ r ^ n := pow_nonneg hr0 n
  gcongr
  linarith

theorem aux_lem_band_T234_geom_tail_range (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (c n : ℕ) :
    ∑ j ∈ Finset.range n, r ^ (c + (n - 1 - j)) ≤ r ^ c / (1 - r) := by
  have hreflect : ∑ j ∈ Finset.range n, r ^ (c + (n - 1 - j))
      = ∑ j ∈ Finset.range n, r ^ c * r ^ j := by
    rw [← Finset.sum_range_reflect (fun j => r ^ c * r ^ j) n]
    apply Finset.sum_congr rfl
    intro j _
    rw [pow_add]
  rw [hreflect, ← Finset.mul_sum]
  have hsum := aux_lem_band_T234_geom_sum_range_le r hr0 hr1 n
  have hrc : (0:ℝ) ≤ r ^ c := pow_nonneg hr0 c
  calc r ^ c * ∑ j ∈ Finset.range n, r ^ j ≤ r ^ c * (1 / (1 - r)) :=
        mul_le_mul_of_nonneg_left hsum hrc
    _ = r ^ c / (1 - r) := by ring

theorem aux_lem_band_T234_sigma_le {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) :
    aux_psf_sigma M ≤ (1 + (d:ℝ)) / 2 := by
  unfold aux_psf_sigma
  have h := M.shellPrefix.delta_le_half
  have hd : (0:ℝ) ≤ 1 + (d:ℝ) := by positivity
  nlinarith

theorem aux_lem_band_T234_bank_even_moment_log {d : ℕ}
