  have hf_le : ∀ᵐ omega ∂M.P.toMeasure,
      ‖(aux_lem_band_piece_product_Praw d s m z omega).toReal - (restr omega).toReal‖ ≤
        (3 : ℝ) ^ (-(s * (H : ℝ) / 16)) *
          (aux_lem_band_piece_product_Praw d (s / 2) m z omega).toReal := by
    filter_upwards [hPfinS, hPfin2] with omega hfinS hfin2'
    have hpt := aux_lem_band_piece_product_depth_bound d m z omega s hs.1 H
    have heqtoreal : (aux_lem_band_piece_product_Praw d s m z omega).toReal -
