    have hcast : ((m : ℤ) + 1 + (j : ℤ)) = (((m + 1 + j : ℕ)) : ℤ) := by push_cast; ring
    have hxA : x ∈ translatedCube d ((m : ℤ) + 1 + (j : ℤ)) z := by rw [hcast]; exact hx
    exact add_le_add (aux_prefix_praw_prod_le_Amaj m j z x omega hxA)
