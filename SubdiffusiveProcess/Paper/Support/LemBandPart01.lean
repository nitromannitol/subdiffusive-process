theorem aux_lem_band_piece_product_trunc_geom_sum_bound (p s : ℝ) (hp0 : 0 < p) (hs0 : 0 < s)
    (hs1 : s ≤ 1) (H : ℕ) :
    ∑ j ∈ Finset.range (H + 1), (3 : ℝ) ^ (-(s * p * (j : ℝ) / 8) - p * ((H - j : ℕ) : ℝ)) ≤
      ((3 : ℝ) ^ (p * (1 - s / 8)) / ((3 : ℝ) ^ (p * (1 - s / 8)) - 1)) *
        (3 : ℝ) ^ (-(s * p * (H : ℝ) / 8)) := by
  set rho : ℝ := (3 : ℝ) ^ (p * (1 - s / 8)) with hrhodef
  have hexp_pos : 0 < p * (1 - s / 8) := by
    have h78 : (0 : ℝ) < 1 - s / 8 := by linarith
    positivity
  have hrho1 : 1 < rho := by
    rw [hrhodef]
    calc (1 : ℝ) = (3 : ℝ) ^ (0 : ℝ) := (Real.rpow_zero 3).symm
      _ < (3 : ℝ) ^ (p * (1 - s / 8)) := Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hexp_pos
  have hkey : (3 : ℝ) ^ (-(p * (H : ℝ))) * rho ^ H = (3 : ℝ) ^ (-(s * p * (H : ℝ) / 8)) := by
    rw [hrhodef, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3),
      ← Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
    congr 1
    ring
  have hterm_eq : ∀ j ∈ Finset.range (H + 1),
      (3 : ℝ) ^ (-(s * p * (j : ℝ) / 8) - p * ((H - j : ℕ) : ℝ)) =
        (3 : ℝ) ^ (-(p * (H : ℝ))) * rho ^ j := by
    intro j hj
    rw [Finset.mem_range] at hj
    have hjH : j ≤ H := by omega
    have hcast : ((H - j : ℕ) : ℝ) = (H : ℝ) - (j : ℝ) := by
      rw [Nat.cast_sub hjH]
    rw [hcast, hrhodef, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3),
      ← Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
    congr 1
    ring
  rw [Finset.sum_congr rfl hterm_eq, ← Finset.mul_sum]
  have hsum_eq : ∑ j ∈ Finset.range (H + 1), rho ^ j = (rho ^ (H + 1) - 1) / (rho - 1) :=
    geom_sum_eq hrho1.ne' (H + 1)
  rw [hsum_eq]
  have hrhosub_pos : (0 : ℝ) < rho - 1 := by linarith
  have hnum : (3 : ℝ) ^ (-(p * (H : ℝ))) * (rho ^ (H + 1) - 1) ≤
      rho * (3 : ℝ) ^ (-(s * p * (H : ℝ) / 8)) := by
    have heq2 : (3 : ℝ) ^ (-(p * (H : ℝ))) * rho ^ (H + 1) =
        rho * (3 : ℝ) ^ (-(s * p * (H : ℝ) / 8)) := by
      rw [pow_succ, ← mul_assoc, hkey]; ring
    have h3pos : (0 : ℝ) < (3 : ℝ) ^ (-(p * (H : ℝ))) := by positivity
    nlinarith [heq2, h3pos]
  calc (3 : ℝ) ^ (-(p * (H : ℝ))) * ((rho ^ (H + 1) - 1) / (rho - 1))
      = ((3 : ℝ) ^ (-(p * (H : ℝ))) * (rho ^ (H + 1) - 1)) / (rho - 1) := by ring
    _ ≤ (rho * (3 : ℝ) ^ (-(s * p * (H : ℝ) / 8))) / (rho - 1) :=
        div_le_div_of_nonneg_right hnum hrhosub_pos.le
    _ = ((3 : ℝ) ^ (p * (1 - s / 8)) / ((3 : ℝ) ^ (p * (1 - s / 8)) - 1)) *
          (3 : ℝ) ^ (-(s * p * (H : ℝ) / 8)) := by
        rw [← hrhodef]; ring

