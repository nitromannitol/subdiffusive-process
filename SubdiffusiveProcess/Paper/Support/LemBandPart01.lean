  refine hfinal.trans ?_
  rw [Real.enorm_eq_ofReal (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (H : ℝ) / 16)))]
  calc ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
