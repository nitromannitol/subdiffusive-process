      (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i z|)) +
        sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := by
    have h2 : (2 : ENNReal) = 1 + 1 := by norm_num
    rw [h2]; exact add_le_add hA hB
  refine hsum.trans (le_sSup ⟨z, ?_, rfl⟩)
  rw [aux_psf_mem_translatedCube_iff]
  intro i
  simp only [sub_self, abs_zero]
  positivity

