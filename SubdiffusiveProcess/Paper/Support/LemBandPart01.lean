  have hpow : (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤
      (2 * (A + B * gap) ^ qnat) ^ ((1:ℝ) / (2 * qnat)) := by
    apply Real.rpow_le_rpow (by positivity) ?_ (by positivity)
    gcongr
