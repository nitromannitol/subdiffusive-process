  have hs2 : s / 2 ∈ Set.Ioc (0 : ℝ) 1 := ⟨by linarith [hs.1], by linarith [hs.2]⟩
  obtain ⟨CB2, delta02, hCB2nn, hdelta02pos, hbase2⟩ :=
    aux_lem_band_piece_product_baseline_c1_PscF_centered_eLpNorm_le hd2 (s / 2) hs2 p hp
