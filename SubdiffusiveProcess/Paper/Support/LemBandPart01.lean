theorem aux_lem_band_DT1_comap_mono_of_subset {Ω κ β : Type*} [MeasurableSpace Ω]
    [MeasurableSpace β] (f : Ω → κ → β) {A B : Set κ} (hAB : A ⊆ B) :
    MeasurableSpace.comap (fun omega : Ω => fun j : A => f omega (j : κ)) inferInstance ≤
    MeasurableSpace.comap (fun omega : Ω => fun j : B => f omega (j : κ)) inferInstance := by
  let proj : (B → β) → (A → β) := fun g => fun j : A => g ⟨(j : κ), hAB j.2⟩
  have hfactor : (fun omega : Ω => fun j : A => f omega (j : κ)) =
      proj ∘ (fun omega : Ω => fun j : B => f omega (j : κ)) := by
    funext omega j
    rfl
  rw [hfactor]
  calc MeasurableSpace.comap (proj ∘ (fun omega : Ω => fun j : B => f omega (j : κ)))
        inferInstance
      = MeasurableSpace.comap (fun omega : Ω => fun j : B => f omega (j : κ))
          (MeasurableSpace.comap proj inferInstance) := by
        rw [MeasurableSpace.comap_comp]
    _ ≤ MeasurableSpace.comap (fun omega : Ω => fun j : B => f omega (j : κ)) inferInstance := by
        apply MeasurableSpace.comap_mono
        exact (measurable_pi_iff.mpr fun j => measurable_pi_apply _).comap_le

