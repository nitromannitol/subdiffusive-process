    rw [aux_lem_band_piece_product_Praw_eq_PscF]
    ring
  have hMdeltapos : (0 : ℝ) ≤ M.delta := M.shellPrefix.delta_pos.le
  have hconst2 : eLpNorm (fun _ : PotentialSample d => (2 : ℝ)) (ENNReal.ofReal p) M.P.toMeasure =
      ENNReal.ofReal 2 := by
    rw [eLpNorm_const _ (by simpa using hp0) (NeZero.ne _)]
    simp [Real.enorm_eq_ofReal]
  have hPscF_bound : eLpNorm (fun omega : PotentialSample d =>
      (aux_lem_band_piece_product_Praw d (s / 2) m z omega).toReal)
