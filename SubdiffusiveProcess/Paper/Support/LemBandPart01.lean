  have h2' : (((2 * 3 ^ gap + 1) ^ d : ℕ) : ℝ) ≤ (((3 ^ (gap + 1)) ^ d : ℕ) : ℝ) := by
    exact_mod_cast h2
  calc (((2 * 3 ^ gap + 1) ^ d : ℕ) : ℝ) ≤ (((3 ^ (gap + 1)) ^ d : ℕ) : ℝ) := h2'
