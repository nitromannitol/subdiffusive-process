theorem aux_lem_band_piece_product_baseline_c1_M_sigma_facts (d : ℕ) (R delta0 : ℝ) (hR0 : 0 < R) (hR1 : 1 ≤ R)
    (hd0def : delta0 = 1 / ((1 + (d : ℝ)) * R)) (M : GMCModel d) (hMdelta : M.delta ≤ delta0) :
    R * aux_psf_sigma M ≤ 1 ∧
    (R + (aux_psf_sigma M)⁻¹) ^ 2 * aux_psf_sigma M ^ 2 ≤ 4 ∧
    (6 * ((aux_psf_sigma M)⁻¹ + R) + 1) * aux_psf_sigma M ≤ 13 ∧
    0 < (aux_psf_sigma M)⁻¹ + R := by
  set σ : ℝ := aux_psf_sigma M with hσdef
  set mu : ℝ := σ⁻¹ with hmudef
  have hσpos := aux_psf_sigma_pos M
  have hσeq : σ = (1 + (d : ℝ)) * M.delta := rfl
  have hRσ : R * σ ≤ 1 := by
    have h2 : σ ≤ 1 / R := by
      have heq : delta0 * (1 + (d : ℝ)) = 1 / R := by rw [hd0def]; field_simp
      have h1 : σ ≤ delta0 * (1 + (d : ℝ)) := by rw [hσeq]; nlinarith [hMdelta]
      rwa [heq] at h1
    calc R * σ ≤ R * (1 / R) := by gcongr
      _ = 1 := by field_simp
  have hσ1 : σ ≤ 1 := by
    nlinarith [hRσ, mul_nonneg (by linarith : (0 : ℝ) ≤ R - 1) hσpos.le]
  have hmuσ : mu * σ = 1 := by rw [hmudef, inv_mul_cancel₀ hσpos.ne']
  have hmuRσ : (R + mu) * σ ≤ 2 := by nlinarith [hmuσ, hRσ]
  refine ⟨hRσ, ?_, ?_, by nlinarith [hmuσ]⟩
  · have hnn2 : 0 ≤ (R + mu) * σ := by positivity
    have heq2 : (R + mu) ^ 2 * σ ^ 2 = ((R + mu) * σ) ^ 2 := by ring
    rw [heq2]; nlinarith [hmuRσ, hnn2]
  · nlinarith [hmuRσ, hσ1, hσpos.le]

theorem aux_lem_band_piece_product_baseline_c1_T_rpow_bound (M : GMCModel d) (s : ℝ) (m : ℕ) (z : Vec d) (R : ℝ)
