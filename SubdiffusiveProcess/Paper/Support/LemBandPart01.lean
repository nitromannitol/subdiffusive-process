      (Real.exp (aux_prefix_praw_bank i (m + 1 + j) z omega)) ∂M.P.toMeasure) ≤
      ((7 ^ d : ℕ) : ℝ≥0∞) * (ENNReal.ofReal (Real.exp (1 ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2) := by
    refine hlin.trans ?_
    gcongr
  simp only [one_pow, one_mul] at hlin'
  calc (∫⁻ omega, ENNReal.ofReal ((aux_prefix_praw_bank i (m + 1 + j) z omega) ^ r)
      ∂M.P.toMeasure) ≤
      ∫⁻ omega, ENNReal.ofReal ((r / Real.exp 1) ^ r) *
        ENNReal.ofReal (Real.exp (aux_prefix_praw_bank i (m + 1 + j) z omega)) ∂M.P.toMeasure :=
      lintegral_mono hpt
    _ = ENNReal.ofReal ((r / Real.exp 1) ^ r) *
        ∫⁻ omega, ENNReal.ofReal (Real.exp (aux_prefix_praw_bank i (m + 1 + j) z omega))
          ∂M.P.toMeasure :=
      lintegral_const_mul _
        (Measurable.ennreal_ofReal (Real.measurable_exp.comp
          (aux_prefix_praw_bank_measurable i (m + 1 + j) z)))
    _ ≤ _ := by gcongr

theorem aux_lem_band_piece_product_Tpow_bound (d : ℕ) [NeZero d] (M : GMCModel d) (m j a : ℕ)
    (haj : m + j ≤ a) (z : Vec d) (L : ℝ) (hLpos : 0 < L)
    (hL : ∀ K : ℕ, ∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i ≤ L)
    (r : ℝ) (hr : 1 ≤ r) :
    (∫⁻ omega, (⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K),
        aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) ^ r
        ∂M.P.toMeasure) ≤
      ENNReal.ofReal (L ^ r) * ENNReal.ofReal ((r / Real.exp 1) ^ r) *
        (((7 ^ d : ℕ) : ℝ≥0∞) * (ENNReal.ofReal (Real.exp (aux_psf_sigma M ^ 2 / 4)) * 2)) := by
  have hr0 : (0 : ℝ) < r := by linarith
  set g : ℕ → PotentialSample d → ℝ≥0∞ := fun K omega =>
    ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K),
      aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega) with hgdef
  have hgmeas : ∀ K, Measurable (g K) := by
    intro K
    exact Measurable.ennreal_ofReal (Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _))
  have hgmono : Monotone g := by
    intro K K' hKK' omega
    refine ENNReal.ofReal_le_ofReal ?_
    refine Finset.sum_le_sum_of_subset_of_nonneg (Finset.Icc_subset_Icc_right (by omega)) ?_
    intro i _ _
    have := aux_prefix_praw_bank_nonneg i (m + 1 + j) z omega
    have := (aux_psf_lam_pos m j i).le
    positivity
  have hpmono : Monotone (fun K omega => (g K omega) ^ r) := by
    intro K K' hKK' omega
    exact ENNReal.rpow_le_rpow (hgmono hKK' omega) hr0.le
  have hterm : ∀ K : ℕ, (∫⁻ omega, (g K omega) ^ r ∂M.P.toMeasure) ≤
      ENNReal.ofReal (L ^ r) * ENNReal.ofReal ((r / Real.exp 1) ^ r) *
        (((7 ^ d : ℕ) : ℝ≥0∞) * (ENNReal.ofReal (Real.exp (aux_psf_sigma M ^ 2 / 4)) * 2)) := by
    intro K
    have hcpos : ∀ i ∈ Finset.Icc a (a + K), 0 < aux_psf_lam m j i :=
      fun i _ => aux_psf_lam_pos m j i
    have hCpos : 0 < ∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i := by
      rcases Finset.eq_empty_or_nonempty (Finset.Icc a (a + K)) with he | hne
      · exfalso
        have : a ∈ Finset.Icc a (a + K) := Finset.mem_Icc.mpr ⟨le_refl a, Nat.le_add_right a K⟩
        rw [he] at this; exact absurd this (Finset.notMem_empty a)
      · exact Finset.sum_pos (fun i hi => aux_psf_lam_pos m j i) hne
    have hpt : ∀ omega : PotentialSample d, (g K omega) ^ r ≤
        ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ^ (r - 1) *
          ∑ i ∈ Finset.Icc a (a + K), ENNReal.ofReal (aux_psf_lam m j i) *
            ENNReal.ofReal (aux_prefix_praw_bank i (m + 1 + j) z omega) ^ r := by
      intro omega
      have hkey := aux_lem_band_piece_product_weighted_pow_sum (Finset.Icc a (a + K))
        (aux_psf_lam m j) (fun i => ENNReal.ofReal (aux_prefix_praw_bank i (m + 1 + j) z omega))
        hcpos hCpos r hr
      have heq : (∑ i ∈ Finset.Icc a (a + K), ENNReal.ofReal (aux_psf_lam m j i) *
          ENNReal.ofReal (aux_prefix_praw_bank i (m + 1 + j) z omega)) = g K omega := by
        simp only [hgdef]
        rw [ENNReal.ofReal_sum_of_nonneg (fun i _ => mul_nonneg (aux_psf_lam_pos m j i).le
          (aux_prefix_praw_bank_nonneg i (m + 1 + j) z omega))]
        exact Finset.sum_congr rfl (fun i _ => (ENNReal.ofReal_mul (aux_psf_lam_pos m j i).le).symm)
      rwa [heq] at hkey
    refine (lintegral_mono hpt).trans ?_
    have hrw : (fun omega : PotentialSample d => ENNReal.ofReal
        (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ^ (r - 1) *
          ∑ i ∈ Finset.Icc a (a + K), ENNReal.ofReal (aux_psf_lam m j i) *
            ENNReal.ofReal (aux_prefix_praw_bank i (m + 1 + j) z omega) ^ r) =
        (fun omega => ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ^ (r - 1) *
          ∑ i ∈ Finset.Icc a (a + K), ENNReal.ofReal (aux_psf_lam m j i) *
            ENNReal.ofReal ((aux_prefix_praw_bank i (m + 1 + j) z omega) ^ r)) := by
      funext omega
      congr 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      congr 1
      exact ENNReal.ofReal_rpow_of_nonneg (aux_prefix_praw_bank_nonneg i (m + 1 + j) z omega) hr0.le
    rw [hrw, lintegral_const_mul' _ _ (by
      refine ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top)]
    rw [lintegral_finset_sum _ (fun i _ => Measurable.const_mul
      (Measurable.ennreal_ofReal ((aux_prefix_praw_bank_measurable i (m + 1 + j) z).pow_const r))
      _)]
    have hsum_le : (∑ i ∈ Finset.Icc a (a + K),
        ∫⁻ omega, ENNReal.ofReal (aux_psf_lam m j i) *
          ENNReal.ofReal ((aux_prefix_praw_bank i (m + 1 + j) z omega) ^ r)
          ∂M.P.toMeasure) ≤
        ∑ i ∈ Finset.Icc a (a + K), ENNReal.ofReal (aux_psf_lam m j i) *
          (ENNReal.ofReal ((r / Real.exp 1) ^ r) *
            (((7 ^ d : ℕ) : ℝ≥0∞) * (ENNReal.ofReal (Real.exp (aux_psf_sigma M ^ 2 / 4)) * 2))) := by
      refine Finset.sum_le_sum (fun i hi => ?_)
      have hi' : m + j ≤ i := haj.trans (Finset.mem_Icc.1 hi).1
      rw [lintegral_const_mul _ (Measurable.ennreal_ofReal
        ((aux_prefix_praw_bank_measurable i (m + 1 + j) z).pow_const r))]
      exact mul_le_mul_right (aux_lem_band_piece_product_bank_poly_moment d M m j i hi' z r hr0) _
    refine (mul_le_mul_right hsum_le _).trans ?_
    rw [← Finset.sum_mul,
      ← ENNReal.ofReal_sum_of_nonneg (fun i _ => (aux_psf_lam_pos m j i).le)]
    set Kbound : ℝ≥0∞ := ENNReal.ofReal ((r / Real.exp 1) ^ r) *
      (((7 ^ d : ℕ) : ℝ≥0∞) * (ENNReal.ofReal (Real.exp (aux_psf_sigma M ^ 2 / 4)) * 2))
      with hKbdef
    have hxne0 : ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ≠ 0 :=
      (ENNReal.ofReal_pos.mpr hCpos).ne'
    have hxnetop : ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ≠ ⊤ :=
      ENNReal.ofReal_ne_top
    have hxr : ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ^ (r - 1) *
        ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) =
        ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ^ r := by
      conv_rhs => rw [show r = (r - 1) + 1 by ring]
      rw [ENNReal.rpow_add _ _ hxne0 hxnetop, ENNReal.rpow_one]
    have hcomb : ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ^ (r - 1) *
        (ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) * Kbound) =
        ENNReal.ofReal (∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i) ^ r * Kbound := by
      rw [← mul_assoc, hxr]
    rw [hcomb, mul_assoc]
    refine mul_le_mul_left ?_ Kbound
    rw [ENNReal.ofReal_rpow_of_nonneg hCpos.le hr0.le]
    exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow hCpos.le (hL K) hr0.le)
  calc (∫⁻ omega, (⨆ K : ℕ, g K omega) ^ r ∂M.P.toMeasure)
      = ∫⁻ omega, ⨆ K : ℕ, (g K omega) ^ r ∂M.P.toMeasure := by
        refine lintegral_congr (fun omega => ?_)
        have hmono' : Monotone (fun K => g K omega) := fun K K' hKK' => hgmono hKK' omega
        exact aux_lem_band_piece_product_iSup_rpow hmono' r hr0.le
    _ = ⨆ K : ℕ, ∫⁻ omega, (g K omega) ^ r ∂M.P.toMeasure :=
        lintegral_iSup (fun K => (hgmeas K).pow_const r) hpmono
    _ ≤ _ := iSup_le hterm

theorem aux_lem_band_piece_product_Y_sub_one_le (X : ℕ → ℝ) (hX : ∀ K, 0 ≤ X K) :
    (⨆ K : ℕ, ENNReal.ofReal (Real.exp (X K))) - 1 ≤
      (⨆ K : ℕ, ENNReal.ofReal (X K)) * (⨆ K : ℕ, ENNReal.ofReal (Real.exp (X K))) := by
  rw [ENNReal.iSup_sub]
  refine iSup_le (fun K => ?_)
  have hstep : ENNReal.ofReal (Real.exp (X K)) - 1 ≤
      ENNReal.ofReal (X K) * ENNReal.ofReal (Real.exp (X K)) := by
    rw [tsub_le_iff_right, ← ENNReal.ofReal_one, ← ENNReal.ofReal_mul (hX K),
      ← ENNReal.ofReal_add (mul_nonneg (hX K) (Real.exp_pos _).le) (by norm_num : (0 : ℝ) ≤ 1)]
    refine ENNReal.ofReal_le_ofReal ?_
    have := aux_lem_band_piece_product_exp_sub_one_le (X K)
    linarith
  refine hstep.trans ?_
  exact mul_le_mul' (le_iSup (fun K => ENNReal.ofReal (X K)) K)
    (le_iSup (fun K => ENNReal.ofReal (Real.exp (X K))) K)

theorem aux_lem_band_piece_product_three_factor_lintegral_le {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (A B C : Ω → ENNReal) (hA : AEMeasurable A μ) (hB : AEMeasurable B μ)
    (hC : AEMeasurable C μ) (p : ℝ) (hp : 0 < p) :
    (∫⁻ omega, (A omega * B omega * C omega) ^ p ∂μ) ≤
      (∫⁻ omega, (A omega) ^ (3 * p) ∂μ) ^ (1 / 3 : ℝ) *
        (∫⁻ omega, (B omega) ^ (3 * p) ∂μ) ^ (1 / 3 : ℝ) *
        (∫⁻ omega, (C omega) ^ (3 * p) ∂μ) ^ (1 / 3 : ℝ) := by
  have hAB : (∫⁻ omega, (A omega * B omega) ^ (3 * p / 2) ∂μ) ^ (1 / (3 * p / 2)) ≤
      (∫⁻ omega, (A omega) ^ (3 * p) ∂μ) ^ (1 / (3 * p)) *
        (∫⁻ omega, (B omega) ^ (3 * p) ∂μ) ^ (1 / (3 * p)) :=
    ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (by positivity) (by linarith) (by ring) μ hA hB
  have hABC : (∫⁻ omega, (A omega * B omega * C omega) ^ p ∂μ) ^ (1 / p) ≤
      (∫⁻ omega, (A omega * B omega) ^ (3 * p / 2) ∂μ) ^ (1 / (3 * p / 2)) *
        (∫⁻ omega, (C omega) ^ (3 * p) ∂μ) ^ (1 / (3 * p)) :=
    ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr hp (by linarith) (by ring) μ (hA.mul hB) hC
  have hcombine : (∫⁻ omega, (A omega * B omega * C omega) ^ p ∂μ) ^ (1 / p) ≤
      (∫⁻ omega, (A omega) ^ (3 * p) ∂μ) ^ (1 / (3 * p)) *
        (∫⁻ omega, (B omega) ^ (3 * p) ∂μ) ^ (1 / (3 * p)) *
        (∫⁻ omega, (C omega) ^ (3 * p) ∂μ) ^ (1 / (3 * p)) := by
    refine hABC.trans ?_
    exact mul_le_mul_left hAB _
  have hfin := ENNReal.rpow_le_rpow hcombine hp.le
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ hp.le, ENNReal.mul_rpow_of_nonneg _ _ hp.le,
    ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul] at hfin
  have h13 : (1 / (3 * p)) * p = 1 / 3 := by
    rw [div_mul_eq_mul_div, one_mul, mul_comm 3 p, ← div_div, div_self hp.ne']
  rwa [h13] at hfin

theorem aux_lem_band_piece_product_sSup_eq_iSup {ι : Type*} (f : ι → ENNReal) :
    sSup {u : ENNReal | ∃ i, u = f i} = ⨆ i, f i := by
  congr 1
  exact Set.ext (fun u => exists_congr (fun i => eq_comm))

theorem aux_lem_band_piece_product_Bexcess_pointwise (m j H : ℕ) (hjH : j ≤ H)
    (Xfun : ℕ → ℝ) (hXnn : ∀ i, 0 ≤ Xfun i) :
    (⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + K), Xfun i))) -
      ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H), Xfun i)) ≤
    ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H), Xfun i)) *
      ((⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i)) *
        (⨆ K : ℕ,
          ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i)))) := by
  have hsplit := aux_lem_band_piece_product_Ktrunc_split Xfun hXnn (m + j) (m + H)
    (by omega)
  have hconv1 : sSup {u : ENNReal | ∃ K : ℕ,
      u = ∏ i ∈ Finset.Icc (m + j) (m + j + K), ENNReal.ofReal (Real.exp (Xfun i))} =
      ⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + K), Xfun i)) := by
    rw [aux_lem_band_piece_product_sSup_eq_iSup]
    exact iSup_congr (fun K => aux_psf_prod_ofReal_exp _ _)
  have hconv2 : sSup {u : ENNReal | ∃ K : ℕ,
      u = ∏ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), ENNReal.ofReal (Real.exp (Xfun i))} =
      ⨆ K : ℕ,
        ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i)) := by
    rw [aux_lem_band_piece_product_sSup_eq_iSup]
    exact iSup_congr (fun K => aux_psf_prod_ofReal_exp _ _)
  rw [hconv1, hconv2, aux_psf_prod_ofReal_exp] at hsplit
  set BjH : ENNReal := ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H), Xfun i))
    with hBjHdef
  set YH : ENNReal := ⨆ K : ℕ,
    ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i)) with hYHdef
  set TH : ENNReal := ⨆ K : ℕ,
    ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i) with hTHdef
  have hstep1 := tsub_le_tsub_right hsplit BjH
  have hBjHfin : BjH ≠ ⊤ := ENNReal.ofReal_ne_top
  have hstep2 : BjH * YH - BjH = BjH * (YH - 1) := by
    rw [ENNReal.mul_sub (fun _ _ => hBjHfin), mul_one]
  have hYsub := aux_lem_band_piece_product_Y_sub_one_le
    (fun K => ∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i)
    (fun K => Finset.sum_nonneg (fun i _ => hXnn i))
  rw [← hYHdef, ← hTHdef] at hYsub
  calc (⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + K), Xfun i))) - BjH
      ≤ BjH * YH - BjH := hstep1
    _ = BjH * (YH - 1) := hstep2
    _ ≤ BjH * (TH * YH) := mul_le_mul_right hYsub BjH

theorem aux_lem_band_piece_product_Bexcess_factor1 (d : ℕ) [NeZero d] (M : GMCModel d)
    (m j H : ℕ) (hjH : j ≤ H) (z : Vec d) (p : ℝ) (hp : 1 ≤ p) :
    (∫⁻ omega, (ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H),
        aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))) ^ (3 * p)
        ∂M.P.toMeasure) ≤
      (((7 ^ d : ℕ) : ℝ≥0∞) *
        (ENNReal.ofReal (Real.exp ((18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ^
          (3 * p * 9 / (18 * p + 1)) := by
  have hp0 : (0 : ℝ) < p := by linarith
  refine le_trans (lintegral_mono (fun omega => ?_))
    (aux_lem_band_piece_product_bank_pow_bound d M m z j (m + j) le_rfl 9 (by norm_num)
      (fun K => aux_psf_lam_sum m j K) (3 * p) (18 * p + 1) (by linarith) (by linarith))
  refine ENNReal.rpow_le_rpow ?_ (by linarith)
  have heq : (∑ i ∈ Finset.Icc (m + j) (m + H), aux_psf_lam m j i *
      aux_prefix_praw_bank i (m + 1 + j) z omega) =
      (∑ i ∈ Finset.Icc (m + j) (m + j + (H - j)), aux_psf_lam m j i *
        aux_prefix_praw_bank i (m + 1 + j) z omega) := by congr 2; omega
  rw [heq]
  exact le_iSup (fun K => ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + K),
    aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))) (H - j)

theorem aux_lem_band_piece_product_Bexcess_factor3 (d : ℕ) [NeZero d] (M : GMCModel d)
    (m j H : ℕ) (hjH : j ≤ H) (z : Vec d) (p : ℝ) (hp : 1 ≤ p) :
    (∫⁻ omega, (⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
        aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))) ^ (3 * p)
        ∂M.P.toMeasure) ≤
      (((7 ^ d : ℕ) : ℝ≥0∞) *
        (ENNReal.ofReal (Real.exp ((18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ^
          (3 * p * 3 / (18 * p + 1)) := by
  have hp0 : (0 : ℝ) < p := by linarith
  refine le_trans
    (aux_lem_band_piece_product_bank_pow_bound d M m z j (m + H + 1) (by omega)
      (3 * ((3 : ℝ) ^ (H - j))⁻¹) (by positivity)
      (fun K => aux_lem_band_piece_product_lam_shifted_sum m j H K hjH)
      (3 * p) (18 * p + 1) (by linarith) (by linarith)) ?_
  have hC1 : (1 : ℝ≥0∞) ≤ ((7 ^ d : ℕ) : ℝ≥0∞) *
      (ENNReal.ofReal (Real.exp ((18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2) := by
    have h7 : (1 : ℝ≥0∞) ≤ ((7 ^ d : ℕ) : ℝ≥0∞) := by
      exact_mod_cast Nat.one_le_pow d 7 (by norm_num)
    have hexp : (1 : ℝ≥0∞) ≤
        ENNReal.ofReal (Real.exp ((18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)) := by
      rw [← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal (Real.one_le_exp (by positivity))
    have h2 : (1 : ℝ≥0∞) ≤
        ENNReal.ofReal (Real.exp ((18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2 := by
      have := mul_le_mul' hexp (by norm_num : (1 : ℝ≥0∞) ≤ 2)
      simpa using this
    have := mul_le_mul' h7 h2
    simpa using this
  refine ENNReal.rpow_le_rpow_of_exponent_le hC1 ?_
  have hLle : 3 * ((3 : ℝ) ^ (H - j))⁻¹ ≤ 3 := by
    have h1 : (1 : ℝ) ≤ (3 : ℝ) ^ (H - j) := one_le_pow₀ (by norm_num)
    have h2 : ((3 : ℝ) ^ (H - j))⁻¹ ≤ 1 := inv_le_one_of_one_le₀ h1
    nlinarith
  gcongr

theorem aux_lem_band_piece_product_Bexcess_moment_bound (d : ℕ) [NeZero d] (M : GMCModel d)
    (m j H : ℕ) (hjH : j ≤ H) (z : Vec d) (p : ℝ) (hp : 1 ≤ p) :
    ∃ CP : ℝ, 0 ≤ CP ∧
    (∫⁻ omega,
        ((⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + K),
            aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))) -
          ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H),
            aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))) ^ p
        ∂M.P.toMeasure) ≤ ENNReal.ofReal (CP * (3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) := by
  have hp0 : (0 : ℝ) < p := by linarith
  set theta : ℝ := 18 * p + 1 with hthetadef
  have hthetagt : 3 * p * 6 < theta := by rw [hthetadef]; linarith
  set Xfun : ℕ → PotentialSample d → ℝ := fun i omega =>
    aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega with hXfundef
  set BjH : PotentialSample d → ENNReal := fun omega =>
    ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H), Xfun i omega)) with hBjHdef
  set TH : PotentialSample d → ENNReal := fun omega =>
    ⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i omega)
    with hTHdef
  set YH : PotentialSample d → ENNReal := fun omega =>
    ⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i omega))
    with hYHdef
  set L : ℝ := 3 * ((3 : ℝ) ^ (H - j))⁻¹ with hLdef
  have hLpos : 0 < L := by rw [hLdef]; positivity
  have hBjHmeas : Measurable BjH := by
    refine Measurable.ennreal_ofReal (Real.measurable_exp.comp ?_)
    exact Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _)
  have hTHmeas : Measurable TH := by
    refine Measurable.iSup (fun K => Measurable.ennreal_ofReal ?_)
    exact Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _)
  have hYHmeas : Measurable YH := by
    refine Measurable.iSup (fun K => Measurable.ennreal_ofReal (Real.measurable_exp.comp ?_))
    exact Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _)
  have hpt : ∀ omega : PotentialSample d,
      ((⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + K),
            Xfun i omega))) - BjH omega) ≤ BjH omega * (TH omega * YH omega) := by
    intro omega
    have hnn : ∀ i, 0 ≤ Xfun i omega := by
      intro i
      rw [hXfundef]
      exact mul_nonneg (aux_psf_lam_pos m j i).le
        (aux_prefix_praw_bank_nonneg i (m + 1 + j) z omega)
    exact aux_lem_band_piece_product_Bexcess_pointwise m j H hjH (fun i => Xfun i omega) hnn
  have hstep1 : (∫⁻ omega,
      ((⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + K),
            Xfun i omega))) - BjH omega) ^ p ∂M.P.toMeasure) ≤
      ∫⁻ omega, (BjH omega * (TH omega * YH omega)) ^ p ∂M.P.toMeasure :=
    lintegral_mono (fun omega => ENNReal.rpow_le_rpow (hpt omega) hp0.le)
  have hstep2 := aux_lem_band_piece_product_three_factor_lintegral_le M.P.toMeasure
    BjH TH YH hBjHmeas.aemeasurable hTHmeas.aemeasurable hYHmeas.aemeasurable p hp0
  have hfactor1 := aux_lem_band_piece_product_Bexcess_factor1 d M m j H hjH z p hp
  have hfactor2 := aux_lem_band_piece_product_Tpow_bound d M m j (m + H + 1) (by omega) z L hLpos
    (fun K => aux_lem_band_piece_product_lam_shifted_sum m j H K hjH) (3 * p) (by linarith)
  have hfactor3 := aux_lem_band_piece_product_Bexcess_factor3 d M m j H hjH z p hp
  set K1 : ℝ≥0∞ := (((7 ^ d : ℕ) : ℝ≥0∞) *
    (ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ^
      (3 * p * 9 / theta) with hK1def
  set K2 : ℝ≥0∞ := ((7 ^ d : ℕ) : ℝ≥0∞) *
    (ENNReal.ofReal (Real.exp (aux_psf_sigma M ^ 2 / 4)) * 2) with hK2def
  set K3 : ℝ≥0∞ := (((7 ^ d : ℕ) : ℝ≥0∞) *
    (ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ^
      (3 * p * 3 / theta) with hK3def
  have hcombine : (∫⁻ omega, (BjH omega * (TH omega * YH omega)) ^ p ∂M.P.toMeasure) ≤
      K1 ^ (1 / 3 : ℝ) *
        (ENNReal.ofReal (L ^ (3 * p)) * ENNReal.ofReal ((3 * p / Real.exp 1) ^ (3 * p)) * K2)
          ^ (1 / 3 : ℝ) * K3 ^ (1 / 3 : ℝ) := by
    have hassoc : (∫⁻ omega, (BjH omega * (TH omega * YH omega)) ^ p ∂M.P.toMeasure) =
        ∫⁻ omega, (BjH omega * TH omega * YH omega) ^ p ∂M.P.toMeasure :=
      lintegral_congr (fun omega => by rw [mul_assoc])
    rw [hassoc]
    refine hstep2.trans ?_
    gcongr
                                                                                                               
  have hLp : L ^ p = (3 : ℝ) ^ p * (3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ))) := by
    rw [hLdef, Real.mul_rpow (by norm_num) (by positivity)]
    congr 1
    rw [← Real.rpow_natCast (3 : ℝ) (H - j), Real.inv_rpow (by norm_num),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3), ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 3)]
    congr 1
    ring
  have hL3p : (ENNReal.ofReal (L ^ (3 * p))) ^ (1 / 3 : ℝ) =
      ENNReal.ofReal ((3 : ℝ) ^ p) * ENNReal.ofReal ((3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hLpos.le _) (by norm_num : (0:ℝ) ≤ 1/3),
      ← Real.rpow_mul hLpos.le, show (3 : ℝ) * p * (1 / 3) = p by ring, hLp,
      ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 3),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 3), hL3p] at hcombine
  set Cbig : ℝ≥0∞ := K1 ^ (1 / 3 : ℝ) * (ENNReal.ofReal ((3 : ℝ) ^ p) *
      (ENNReal.ofReal ((3 * p / Real.exp 1) ^ (3 * p))) ^ (1 / 3 : ℝ) * K2 ^ (1 / 3 : ℝ)) *
      K3 ^ (1 / 3 : ℝ) with hCbigdef
  have hCbigeq : K1 ^ (1 / 3 : ℝ) *
      (ENNReal.ofReal ((3 : ℝ) ^ p) * ENNReal.ofReal ((3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) *
        (ENNReal.ofReal ((3 * p / Real.exp 1) ^ (3 * p))) ^ (1 / 3 : ℝ) * K2 ^ (1 / 3 : ℝ)) *
      K3 ^ (1 / 3 : ℝ) = Cbig * ENNReal.ofReal ((3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) := by
    rw [hCbigdef]; ring
  rw [hCbigeq] at hcombine
  have hK1fin : K1 ≠ ⊤ := by
    rw [hK1def]
    refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (by norm_num))
  have hK2fin : K2 ≠ ⊤ := by
    rw [hK2def]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (by norm_num))
  have hK3fin : K3 ≠ ⊤ := by
    rw [hK3def]
    refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (by norm_num))
  have hCbigfin : Cbig ≠ ⊤ := by
    rw [hCbigdef]
    refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) ?_
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hK1fin
    · refine ENNReal.mul_ne_top ?_ ?_
      · refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
        exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hK2fin
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hK3fin
  refine ⟨Cbig.toReal, ENNReal.toReal_nonneg, ?_⟩
  refine (hstep1.trans hcombine).trans (le_of_eq ?_)
  conv_lhs => rw [← ENNReal.ofReal_toReal hCbigfin]
  rw [← ENNReal.ofReal_mul ENNReal.toReal_nonneg]

theorem aux_lem_band_piece_product_Praw_eq_PscF (d : ℕ) (s' : ℝ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) :
    aux_lem_band_piece_product_Praw d s' m z omega = aux_prefix_praw_PscF s' m z omega := rfl

theorem aux_lem_band_piece_product_iSup_sub_iSup_le {ι : Type*} (f g : ι → ENNReal) :
    (⨆ i, f i) - (⨆ i, g i) ≤ ⨆ i, (f i - g i) := by
  rw [tsub_le_iff_left]
  refine iSup_le fun i => ?_
  calc f i ≤ g i + (f i - g i) := tsub_le_iff_left.mp le_rfl
    _ ≤ (⨆ i, g i) + ⨆ i, (f i - g i) := add_le_add (le_iSup g i) (le_iSup (fun i => f i - g i) i)

theorem aux_lem_band_piece_product_boundedSup_sub_le (H : ℕ) (f g : ℕ → ENNReal) :
    sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧ v = f j} - sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧ v = g j}
      ≤ sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧ v = f j - g j} := by
  rw [tsub_le_iff_left]
  refine sSup_le ?_
  rintro v ⟨j, hjH, rfl⟩
  calc f j ≤ g j + (f j - g j) := tsub_le_iff_left.mp le_rfl
    _ ≤ sSup {v : ENNReal | ∃ j, j ≤ H ∧ v = g j} + sSup {v : ENNReal | ∃ j, j ≤ H ∧ v = f j - g j} :=
      add_le_add (le_sSup ⟨j, hjH, rfl⟩) (le_sSup ⟨j, hjH, rfl⟩)

theorem aux_lem_band_piece_product_boundedSup_eq_finsetSup' (H : ℕ) (Y : ℕ → ENNReal) :
    sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧ v = Y j} =
      (Finset.range (H + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.succ_pos H)⟩ Y := by
  apply le_antisymm
  · refine sSup_le ?_
    rintro v ⟨j, hjH, rfl⟩
    exact Finset.le_sup' Y (Finset.mem_range.mpr (by omega))
  · refine Finset.sup'_le _ _ ?_
    intro j hj
    rw [Finset.mem_range] at hj
    exact le_sSup ⟨j, by omega, rfl⟩

theorem aux_lem_band_piece_product_finsetSup'_pow_le_sum {s : Finset ℕ} (hs : s.Nonempty)
    (Y : ℕ → ENNReal) (p : ℝ) :
    (s.sup' hs Y) ^ p ≤ ∑ j ∈ s, (Y j) ^ p := by
  obtain ⟨j0, hj0, heq⟩ := Finset.exists_mem_eq_sup' hs Y
  rw [heq]
  exact Finset.single_le_sum (f := fun j => (Y j) ^ p) (fun j _ => zero_le) hj0

theorem aux_lem_band_piece_product_BTY_moment_bound (d : ℕ) [NeZero d] (M : GMCModel d)
    (m j H : ℕ) (hjH : j ≤ H) (z : Vec d) (p : ℝ) (hp : 1 ≤ p) :
    ∃ CP : ℝ, 0 ≤ CP ∧
    (∫⁻ omega,
        (ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H),
            aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) *
          ((⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
              aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) *
            (⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
              aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))))) ^ p
        ∂M.P.toMeasure) ≤ ENNReal.ofReal (CP * (3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) := by
  have hp0 : (0 : ℝ) < p := by linarith
  set theta : ℝ := 18 * p + 1 with hthetadef
  have hthetagt : 3 * p * 6 < theta := by rw [hthetadef]; linarith
  set Xfun : ℕ → PotentialSample d → ℝ := fun i omega =>
    aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega with hXfundef
  set BjH : PotentialSample d → ENNReal := fun omega =>
    ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H), Xfun i omega)) with hBjHdef
  set TH : PotentialSample d → ENNReal := fun omega =>
    ⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i omega)
    with hTHdef
  set YH : PotentialSample d → ENNReal := fun omega =>
    ⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xfun i omega))
    with hYHdef
  set L : ℝ := 3 * ((3 : ℝ) ^ (H - j))⁻¹ with hLdef
  have hLpos : 0 < L := by rw [hLdef]; positivity
  have hBjHmeas : Measurable BjH := by
    refine Measurable.ennreal_ofReal (Real.measurable_exp.comp ?_)
    exact Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _)
  have hTHmeas : Measurable TH := by
    refine Measurable.iSup (fun K => Measurable.ennreal_ofReal ?_)
    exact Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _)
  have hYHmeas : Measurable YH := by
    refine Measurable.iSup (fun K => Measurable.ennreal_ofReal (Real.measurable_exp.comp ?_))
    exact Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _)
  have hstep2 := aux_lem_band_piece_product_three_factor_lintegral_le M.P.toMeasure
    BjH TH YH hBjHmeas.aemeasurable hTHmeas.aemeasurable hYHmeas.aemeasurable p hp0
  have hfactor1 := aux_lem_band_piece_product_Bexcess_factor1 d M m j H hjH z p hp
  have hfactor2 := aux_lem_band_piece_product_Tpow_bound d M m j (m + H + 1) (by omega) z L hLpos
    (fun K => aux_lem_band_piece_product_lam_shifted_sum m j H K hjH) (3 * p) (by linarith)
  have hfactor3 := aux_lem_band_piece_product_Bexcess_factor3 d M m j H hjH z p hp
  set K1 : ℝ≥0∞ := (((7 ^ d : ℕ) : ℝ≥0∞) *
    (ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ^
      (3 * p * 9 / theta) with hK1def
  set K2 : ℝ≥0∞ := ((7 ^ d : ℕ) : ℝ≥0∞) *
    (ENNReal.ofReal (Real.exp (aux_psf_sigma M ^ 2 / 4)) * 2) with hK2def
  set K3 : ℝ≥0∞ := (((7 ^ d : ℕ) : ℝ≥0∞) *
    (ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ^
      (3 * p * 3 / theta) with hK3def
  have hcombine : (∫⁻ omega, (BjH omega * (TH omega * YH omega)) ^ p ∂M.P.toMeasure) ≤
      K1 ^ (1 / 3 : ℝ) *
        (ENNReal.ofReal (L ^ (3 * p)) * ENNReal.ofReal ((3 * p / Real.exp 1) ^ (3 * p)) * K2)
          ^ (1 / 3 : ℝ) * K3 ^ (1 / 3 : ℝ) := by
    have hassoc : (∫⁻ omega, (BjH omega * (TH omega * YH omega)) ^ p ∂M.P.toMeasure) =
        ∫⁻ omega, (BjH omega * TH omega * YH omega) ^ p ∂M.P.toMeasure :=
      lintegral_congr (fun omega => by rw [mul_assoc])
    rw [hassoc]
    refine hstep2.trans ?_
    gcongr
  have hLp : L ^ p = (3 : ℝ) ^ p * (3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ))) := by
    rw [hLdef, Real.mul_rpow (by norm_num) (by positivity)]
    congr 1
    rw [← Real.rpow_natCast (3 : ℝ) (H - j), Real.inv_rpow (by norm_num),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3), ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 3)]
    congr 1
    ring
  have hL3p : (ENNReal.ofReal (L ^ (3 * p))) ^ (1 / 3 : ℝ) =
      ENNReal.ofReal ((3 : ℝ) ^ p) * ENNReal.ofReal ((3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hLpos.le _) (by norm_num : (0:ℝ) ≤ 1/3),
      ← Real.rpow_mul hLpos.le, show (3 : ℝ) * p * (1 / 3) = p by ring, hLp,
      ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 3),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 3), hL3p] at hcombine
  set Cbig : ℝ≥0∞ := K1 ^ (1 / 3 : ℝ) * (ENNReal.ofReal ((3 : ℝ) ^ p) *
      (ENNReal.ofReal ((3 * p / Real.exp 1) ^ (3 * p))) ^ (1 / 3 : ℝ) * K2 ^ (1 / 3 : ℝ)) *
      K3 ^ (1 / 3 : ℝ) with hCbigdef
  have hCbigeq : K1 ^ (1 / 3 : ℝ) *
      (ENNReal.ofReal ((3 : ℝ) ^ p) * ENNReal.ofReal ((3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) *
        (ENNReal.ofReal ((3 * p / Real.exp 1) ^ (3 * p))) ^ (1 / 3 : ℝ) * K2 ^ (1 / 3 : ℝ)) *
      K3 ^ (1 / 3 : ℝ) = Cbig * ENNReal.ofReal ((3 : ℝ) ^ (-(p * ((H - j : ℕ) : ℝ)))) := by
    rw [hCbigdef]; ring
  rw [hCbigeq] at hcombine
  have hK1fin : K1 ≠ ⊤ := by
    rw [hK1def]
    refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (by norm_num))
  have hK2fin : K2 ≠ ⊤ := by
    rw [hK2def]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (by norm_num))
  have hK3fin : K3 ≠ ⊤ := by
    rw [hK3def]
    refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (by norm_num))
  have hCbigfin : Cbig ≠ ⊤ := by
    rw [hCbigdef]
    refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) ?_
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hK1fin
    · refine ENNReal.mul_ne_top ?_ ?_
      · refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
        exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hK2fin
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hK3fin
  refine ⟨Cbig.toReal, ENNReal.toReal_nonneg, ?_⟩
  refine hcombine.trans (le_of_eq ?_)
  conv_lhs => rw [← ENNReal.ofReal_toReal hCbigfin]
  rw [← ENNReal.ofReal_mul ENNReal.toReal_nonneg]

def aux_lem_band_piece_product_Pj (d : ℕ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) (H j : ℕ) : ENNReal :=
  sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d (m + 1 + j) z ∧
    w = (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
        (∏ i ∈ Finset.Icc (m + j) (m + H), ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|)))}

theorem aux_lem_band_piece_product_Pj_le_Tj (d : ℕ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) (H j : ℕ) (hjH : j ≤ H) :
    aux_lem_band_piece_product_Pj d m z omega H j ≤ aux_lem_band_piece_product_Tj d m z omega j := by
  unfold aux_lem_band_piece_product_Pj aux_lem_band_piece_product_Tj
  refine sSup_le ?_
  rintro w ⟨x, hx, rfl⟩
  have heq : m + H = m + j + (H - j) := by omega
  have hstep : (∏ i ∈ Finset.Icc (m + j) (m + H),
      ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))) ≤
      sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
        ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))} := by
    rw [heq]
    exact le_sSup ⟨H - j, rfl⟩
  calc (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
        (∏ i ∈ Finset.Icc (m + j) (m + H), ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|)))
      ≤ (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
        sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))} := add_le_add_right hstep _
    _ ≤ aux_lem_band_piece_product_Tj d m z omega j := by
        apply le_sSup
        exact ⟨x, hx, rfl⟩

theorem aux_lem_band_piece_product_Tj_sub_Pj_le (d : ℕ) [NeZero d] (hd : (1 : ℝ) ≤ (d : ℝ))
    (m : ℕ) (z : Vec d) (omega : PotentialSample d) (H j : ℕ) (hjH : j ≤ H) :
    aux_lem_band_piece_product_Tj d m z omega j - aux_lem_band_piece_product_Pj d m z omega H j ≤
      ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H),
          aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) *
        ((⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
            aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) *
          (⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
            aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)))) := by
  set RHS : ENNReal := ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H),
      aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) *
    ((⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
        aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) *
      (⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
        aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)))) with hRHSdef
  rw [tsub_le_iff_left]
  unfold aux_lem_band_piece_product_Tj aux_lem_band_piece_product_Pj
  refine sSup_le ?_
  rintro w ⟨x, hx, rfl⟩
  set Xx : ℕ → ℝ := fun i => 4 * |omega i x - omega i z| with hXxdef
  have hXxnn : ∀ i, 0 ≤ Xx i := fun i => by positivity
  have hsplit := aux_lem_band_piece_product_Ktrunc_split Xx hXxnn (m + j) (m + H) (by omega)
  set Bfix : ENNReal := ∏ i ∈ Finset.Icc (m + j) (m + H), ENNReal.ofReal (Real.exp (Xx i))
    with hBfixdef
  set YHx : ENNReal := sSup {u : ENNReal | ∃ K' : ℕ,
      u = ∏ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K'), ENNReal.ofReal (Real.exp (Xx i))}
    with hYHxdef
  have hBfull_le : sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (Xx i))} ≤ Bfix * YHx := hsplit
  set THx : ENNReal := sSup {t : ENNReal | ∃ K' : ℕ,
      t = ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K'), Xx i)}
    with hTHxdef
  have hYsub : YHx - 1 ≤ THx * YHx := by
    have h := aux_lem_band_piece_product_Y_sub_one_le
      (fun K => ∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xx i)
      (fun K => Finset.sum_nonneg (fun i _ => hXxnn i))
    have hconv : (⨆ K : ℕ, ENNReal.ofReal (Real.exp
        (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), Xx i))) = YHx := by
      rw [hYHxdef, aux_lem_band_piece_product_sSup_eq_iSup]
      exact iSup_congr (fun K => (aux_psf_prod_ofReal_exp _ _).symm)
    rw [hconv] at h
    rw [hTHxdef, aux_lem_band_piece_product_sSup_eq_iSup]
    exact h
  have hBfixfin : Bfix ≠ ⊤ := by
    rw [hBfixdef]
    exact ENNReal.prod_ne_top (fun i _ => ENNReal.ofReal_ne_top)
  have hexcess : sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (Xx i))} - Bfix ≤ Bfix * (THx * YHx) := by
    calc sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
        ENNReal.ofReal (Real.exp (Xx i))} - Bfix ≤ Bfix * YHx - Bfix :=
        tsub_le_tsub_right hBfull_le Bfix
      _ = Bfix * (YHx - 1) := by rw [ENNReal.mul_sub (fun _ _ => hBfixfin), mul_one]
      _ ≤ Bfix * (THx * YHx) := mul_le_mul_right hYsub Bfix
  have hperikey : ∀ i, 4 * |omega i x - omega i z| ≤
      aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega := by
    intro i
    have hb := aux_prefix_praw_diff_le_bank hd i (m + 1 + j) z x omega hx
    have hlam : aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega =
        4 * (((3 : ℝ) ^ i)⁻¹ * aux_prefix_praw_bank i (m + 1 + j) z omega *
          ((3 : ℝ) ^ ((m + 1 + j : ℕ) : ℤ) / 2)) := by
      unfold aux_psf_lam
      rw [zpow_natCast]
      ring
    rw [hlam]
    linarith
  have hBfix_le : Bfix ≤ ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H),
      aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) := by
    rw [hBfixdef, aux_psf_prod_ofReal_exp]
    refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.2 ?_)
    exact Finset.sum_le_sum (fun i _ => hperikey i)
  have hTHx_le : THx ≤ ⨆ K : ℕ, ENNReal.ofReal (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
      aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega) := by
    rw [hTHxdef, aux_lem_band_piece_product_sSup_eq_iSup]
    refine iSup_le (fun K => ?_)
    refine le_iSup_of_le K (ENNReal.ofReal_le_ofReal ?_)
    exact Finset.sum_le_sum (fun i _ => hperikey i)
  have hYHx_le : YHx ≤ ⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K),
      aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) := by
    rw [hYHxdef, aux_lem_band_piece_product_sSup_eq_iSup]
    refine iSup_le (fun K => ?_)
    refine le_iSup_of_le K ?_
    rw [aux_psf_prod_ofReal_exp]
    exact ENNReal.ofReal_le_ofReal (Real.exp_le_exp.2 (Finset.sum_le_sum (fun i _ => hperikey i)))
  have hfinal : sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (Xx i))} - Bfix ≤ RHS :=
    hexcess.trans ((mul_le_mul' hBfix_le (mul_le_mul' hTHx_le hYHx_le)).trans (le_of_eq hRHSdef.symm))
  have hfinal2 : sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (Xx i))} ≤ Bfix + RHS := tsub_le_iff_left.mp hfinal
  calc (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
        sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (Xx i))}
      ≤ (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) + (Bfix + RHS) :=
        add_le_add_right hfinal2 _
    _ = ((∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) + Bfix) + RHS := by
        rw [add_assoc]
    _ ≤ (sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d (m + 1 + j) z ∧
          w = (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
              (∏ i ∈ Finset.Icc (m + j) (m + H),
                ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|)))})
        + RHS := by
        refine add_le_add_left ?_ _
        refine le_sSup ⟨x, hx, ?_⟩
        simp only [hBfixdef, hXxdef]

theorem aux_lem_band_piece_product_trunc_spatialSup_meas {d : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    {W : Set (Vec d)} (hWopen : IsOpen W)
    (F : Ω → Vec d → ENNReal)
    (hcont : ∀ omega, Continuous (F omega))
    (hmeas : ∀ x, Measurable (fun omega => F omega x)) :
    Measurable (fun omega => sSup {v : ENNReal | ∃ x ∈ W, v = F omega x}) := by
  obtain ⟨Q, hQcount, hQdense⟩ := TopologicalSpace.exists_countable_dense (Vec d)
  haveI : Countable ↥(W ∩ Q) :=
    (hQcount.mono Set.inter_subset_right).to_subtype
  have heq : ∀ omega,
      sSup {v : ENNReal | ∃ x ∈ W, v = F omega x} =
        ⨆ x : ↥(W ∩ Q), F omega x := by
    intro omega
    apply le_antisymm
    · refine sSup_le ?_
      rintro v ⟨x, hx, rfl⟩
      let c : ENNReal := ⨆ y : ↥(W ∩ Q), F omega y
      have hc : IsClosed {y : Vec d | F omega y ≤ c} :=
        isClosed_le (hcont omega) continuous_const
      have hsub : W ∩ Q ⊆ {y : Vec d | F omega y ≤ c} := by
        intro y hy
        exact le_iSup (fun y : ↥(W ∩ Q) => F omega y) ⟨y, hy⟩
      have hdense : W ⊆ closure (W ∩ Q) :=
        hQdense.open_subset_closure_inter hWopen
      exact hc.closure_subset_iff.mpr hsub (hdense hx)
    · refine iSup_le fun y => ?_
      exact le_sSup ⟨y.1, y.2.1, rfl⟩
  simp_rw [heq]
  exact Measurable.iSup (fun y => hmeas y)

