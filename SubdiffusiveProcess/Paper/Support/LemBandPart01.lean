    conv_lhs => rw [hAeq]
    rw [ENNReal.ofReal_rpow_of_nonneg (by linarith) (by linarith)]
  rw [hApow, ← ENNReal.ofReal_mul (by positivity)]
  exact ENNReal.ofReal_le_ofReal (aux_lem_band_piece_product_baseline_c1_centered_rpow_le A.toReal hAreal R mu hR hmu)

