  refine sSup_le ?_
  rintro v ⟨j, l, hjk, hlk, hlj, x, hgrid, hann, rfl⟩
  have h1 : ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) ≤ 1 := by
    rw [← ENNReal.ofReal_one]
    refine ENNReal.ofReal_le_ofReal ?_
    refine Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) ?_
    have hlk' : (l : ℝ) ≤ (k : ℝ) := by exact_mod_cast hlk
    nlinarith
  have h2 : (min (aux_lem_band_Jcell M l x omega) 1) ^ (1 / 2 : ℝ) ≤ 1 :=
    ENNReal.rpow_le_one (min_le_right _ _) (by norm_num)
  calc ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) *
      (min (aux_lem_band_Jcell M l x omega) 1) ^ (1 / 2 : ℝ) ≤ 1 * 1 :=
        mul_le_mul' h1 h2
    _ = 1 := by ring

theorem aux_lem_band_DT1_ne_top {d : ℕ} [NeZero d] (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (s : ℝ) (hs : 0 < s) (k : ℕ) (z : Vec d)
