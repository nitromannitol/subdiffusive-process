      _ = (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1)) *
          ((∑' j : ℕ, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
              ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)))) +
            ∑' j : ℕ, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj)) := by
          rw [ENNReal.tsum_mul_left, ENNReal.tsum_add]
      _ ≤ ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1) *
          (ENNReal.ofReal SA + ENNReal.ofReal SB) := by
          gcongr
          · rw [← ENNReal.ofReal_tsum_of_nonneg hAnn hAsummable]
            exact ENNReal.ofReal_le_ofReal hAseries
          · rw [← ENNReal.ofReal_tsum_of_nonneg hBnn hBsummable]
            exact ENNReal.ofReal_le_ofReal hBseries
  refine step1.trans (le_of_eq ?_)
  have hSAnn : 0 ≤ SA := le_trans (tsum_nonneg hAnn) hAseries
  have hSBnn : 0 ≤ SB := le_trans (tsum_nonneg hBnn) hBseries
  have h2eq : (2 : ENNReal) = ENNReal.ofReal (2 : ℝ) := by rw [ENNReal.ofReal_ofNat]
  have h2ofReal : (2 : ENNReal) ^ (R - 1) = ENNReal.ofReal ((2 : ℝ) ^ (R - 1)) := by
    rw [h2eq, ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by linarith)]
  rw [h2ofReal, ← ENNReal.ofReal_add hSAnn hSBnn, ← ENNReal.ofReal_mul (by positivity),
    ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [hC2def,
    show (R * σ / Real.exp 1) ^ R = (R / Real.exp 1) ^ R * σ ^ R from by
      rw [show R * σ / Real.exp 1 = (R / Real.exp 1) * σ from by ring,
        Real.mul_rpow (by positivity) hσpos.le]]
  ring

theorem aux_lem_band_piece_product_baseline_c1_PscF_centered_eLpNorm_le (hd2 : 2 ≤ d) (s : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (p : ℝ) (hp : 1 ≤ p) :
    ∃ CB delta0 : ℝ, 0 ≤ CB ∧ 0 < delta0 ∧
      ∀ (M : GMCModel d), M.delta ≤ delta0 →
      ∀ (m : ℕ) (z : Vec d),
        (∀ᵐ omega ∂M.P.toMeasure, aux_prefix_praw_PscF s m z omega ≠ ⊤) ∧
        eLpNorm (fun omega => (aux_prefix_praw_PscF s m z omega).toReal - 2)
          (ENNReal.ofReal p) M.P.toMeasure ≤ ENNReal.ofReal (CB * M.delta) := by
  obtain ⟨hs0, hs1⟩ := hs
  have hdR : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast (by omega : 1 ≤ d)
  set R : ℝ := 32 * ((d : ℝ) + 1) / s + p + 1 with hRdef
  have hR1 : (1 : ℝ) ≤ R := by
    have h0 : (0 : ℝ) ≤ 32 * ((d : ℝ) + 1) / s := by positivity
    rw [hRdef]; linarith
  have hR0 : 0 < R := by linarith
  set delta0 : ℝ := 1 / ((1 + (d : ℝ)) * R) with hd0def
  have hd0pos : 0 < delta0 := by rw [hd0def]; positivity
  have hsR : 32 * ((d : ℝ) + 1) ≤ s * R := by
    rw [hRdef]
    have hsne : s ≠ 0 := hs0.ne'
    field_simp
    nlinarith [hp]
  set K : ℝ := 2 * Real.exp 1 with hKdef
  set ρA : ℝ := (3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d * K ^ 2 with hρAdef
  obtain ⟨hAsummable, hAseries⟩ := aux_lem_band_piece_product_baseline_c1_Aseries_le d s R hsR
  set Cbmaj : ℝ := ((7 : ℝ) ^ d * (Real.exp (169 / 4) * 2)) ^ (3 / 2 : ℝ) with hCbmajdef
  have hCbmaj0 : 0 ≤ Cbmaj := by rw [hCbmajdef]; positivity
  obtain ⟨hBsummable, hBseries⟩ := aux_lem_band_piece_product_baseline_c1_Bseries_le s R hs0 hR0 Cbmaj hCbmaj0
  set SA : ℝ := ((9 : ℝ) ^ d * K) * (1 - ρA)⁻¹ with hSAdef
  set SB : ℝ := Cbmaj * (1 - (3 : ℝ) ^ (-(s * R / 8)))⁻¹ with hSBdef
  set C2 : ℝ := 2 ^ (R - 1) * (R / Real.exp 1) ^ R * (SA + SB) with hC2def
  have hC2nn : 0 ≤ C2 := by
    have hSAnn : 0 ≤ SA := by
      rw [hSAdef]
      have hρA1 : ρA < 1 := aux_lem_band_piece_product_baseline_c1_Aterm_ratio_lt_one d s R hsR
      have : 0 ≤ (1 - ρA)⁻¹ := by
        rw [inv_nonneg]; linarith
      positivity
    have hSBnn : 0 ≤ SB := by
      rw [hSBdef]
      have hρ1 : (3 : ℝ) ^ (-(s * R / 8)) < 1 := by
        rw [show (1 : ℝ) = (3 : ℝ) ^ (0 : ℝ) from (Real.rpow_zero 3).symm]
        exact Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by nlinarith)
      have : 0 ≤ (1 - (3 : ℝ) ^ (-(s * R / 8)))⁻¹ := by rw [inv_nonneg]; linarith
      positivity
    rw [hC2def]; positivity
  set CB1 : ℝ := C2 ^ (1 / R) * (1 + (d : ℝ)) with hCB1def
  have hCB1nn : 0 ≤ CB1 := by rw [hCB1def]; positivity
  refine ⟨CB1, delta0, hCB1nn, hd0pos, ?_⟩
  intro M hMdelta m z
  obtain ⟨hRσ, hsq4, h6, hmuRpos⟩ := aux_lem_band_piece_product_baseline_c1_M_sigma_facts d R delta0 hR0 hR1 hd0def M hMdelta
  set σ : ℝ := aux_psf_sigma M with hσdef
  have hσpos := aux_psf_sigma_pos M
  have hσeq : σ = (1 + (d : ℝ)) * M.delta := rfl
  have hCbmaj_ge : aux_prefix_praw_CB M (σ⁻¹ + R) ≤ Cbmaj :=
    (aux_lem_band_piece_product_baseline_c1_CB_bound M (σ⁻¹ + R) hmuRpos h6).trans (by rw [hCbmajdef])
  have hg_j : ∀ j : ℕ, (∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
      ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
      ∂M.P.toMeasure) ≤
      ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8))) * (2 : ENNReal) ^ (R - 1) *
        (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) *
          (ENNReal.ofReal ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) +
            ENNReal.ofReal Cbmaj)) := fun j =>
    aux_lem_band_piece_product_baseline_c1_gterm_bound M s m z R hR0 hR1 K Cbmaj hKdef hsq4 hCbmaj_ge j
  have hK0 : 0 ≤ K := by rw [hKdef]; positivity
  have hTbound := aux_lem_band_piece_product_baseline_c1_T_rpow_bound M s m z R hR0 hR1 K Cbmaj SA SB C2 hK0 hCbmaj0 hg_j
    hAsummable hAseries hBsummable hBseries hC2def
  set Tfun : PotentialSample d → ENNReal := fun omega =>
    ∑' j : ℕ, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
      ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
    with hTfundef
  have hPscF_le : ∀ omega, aux_prefix_praw_PscF s m z omega ≤ 2 + (Tfun omega) ^ (1 / R) :=
    fun omega => aux_lem_band_piece_product_baseline_c1_PscF_le_two_add_lR hdR s hs0.le m z omega R hR0
  have hPscF_ge : ∀ omega, (2 : ENNReal) ≤ aux_prefix_praw_PscF s m z omega :=
    fun omega => aux_lem_band_piece_product_baseline_c1_PscF_ge_two s m z omega
  have hTmeas : Measurable Tfun :=
    Measurable.ennreal_tsum (fun j => (Measurable.pow_const (measurable_const.mul
      (((aux_prefix_praw_Amaj_measurable m j z).sub measurable_const).add
        ((aux_prefix_praw_Bmaj_measurable m j z).sub measurable_const))) R))
  have hTfin : (∫⁻ omega, Tfun omega ∂M.P.toMeasure) ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hTbound
  have hTae : ∀ᵐ omega ∂M.P.toMeasure, Tfun omega ≠ ⊤ := by
    filter_upwards [ae_lt_top' hTmeas.aemeasurable hTfin] with omega h
    exact h.ne
  have hPscFfin : ∀ᵐ omega ∂M.P.toMeasure, aux_prefix_praw_PscF s m z omega ≠ ⊤ := by
    filter_upwards [hTae] with omega hTne
    have hsum_fin : (2 : ENNReal) + (Tfun omega) ^ (1 / R) ≠ ⊤ :=
      ENNReal.add_ne_top.mpr ⟨by norm_num,
        ENNReal.rpow_ne_top_of_nonneg (by positivity) hTne⟩
    exact ne_top_of_le_ne_top hsum_fin (hPscF_le omega)
  refine ⟨hPscFfin, ?_⟩
  set f : PotentialSample d → ℝ := fun omega => (aux_prefix_praw_PscF s m z omega).toReal - 2
    with hfdef
  have hfmeas : Measurable f :=
    (ENNReal.measurable_toReal.comp (aux_lem_prefix_limit_actual_Psc_meas s m z)).sub
      measurable_const
  have hf_enorm_le : ∀ᵐ omega ∂M.P.toMeasure, (‖f omega‖ₑ : ENNReal) ≤ (Tfun omega) ^ (1 / R) := by
    filter_upwards [hPscFfin] with omega hfin
    have hsub_le : aux_prefix_praw_PscF s m z omega - 2 ≤ (Tfun omega) ^ (1 / R) :=
      tsub_le_iff_left.mpr (hPscF_le omega)
    have hfnn : (0 : ℝ) ≤ f omega := by
      rw [hfdef]
      have h2 : (2 : ℝ) ≤ (aux_prefix_praw_PscF s m z omega).toReal := by
        have := ENNReal.toReal_mono hfin (hPscF_ge omega)
        simpa using this
      linarith
    have heq : f omega = (aux_prefix_praw_PscF s m z omega - 2).toReal := by
      rw [hfdef]
      rw [ENNReal.toReal_sub_of_le (hPscF_ge omega) hfin]
      norm_num
    have hsubfin : aux_prefix_praw_PscF s m z omega - 2 ≠ ⊤ :=
      (lt_of_le_of_lt tsub_le_self (lt_top_iff_ne_top.mpr hfin)).ne
    rw [Real.enorm_of_nonneg hfnn, heq, ENNReal.ofReal_toReal hsubfin]
    exact hsub_le
  have hpR : p ≤ R := by
    have h0 : (0 : ℝ) ≤ 32 * ((d : ℝ) + 1) / s := by positivity
    rw [hRdef]; linarith
  have hR_lyap : eLpNorm f (ENNReal.ofReal p) M.P.toMeasure ≤
      eLpNorm f (ENNReal.ofReal R) M.P.toMeasure :=
    eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hpR)
  have hReq : eLpNorm f (ENNReal.ofReal R) M.P.toMeasure = (∫⁻ omega, ‖f omega‖ₑ ^ R
      ∂M.P.toMeasure) ^ (1 / R) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hR0) ENNReal.ofReal_ne_top hfmeas.aestronglyMeasurable,
      ENNReal.toReal_ofReal hR0.le]
  have hRbound : (∫⁻ omega, ‖f omega‖ₑ ^ R ∂M.P.toMeasure) ≤ ENNReal.ofReal (C2 * σ ^ R) := by
    refine le_trans ?_ hTbound
    refine lintegral_mono_ae (hf_enorm_le.mono fun omega h => ?_)
    calc (‖f omega‖ₑ : ENNReal) ^ R ≤ ((Tfun omega) ^ (1 / R)) ^ R :=
          ENNReal.rpow_le_rpow h hR0.le
      _ = Tfun omega := by
          rw [← ENNReal.rpow_mul, one_div_mul_cancel hR0.ne', ENNReal.rpow_one]
  have hRfinal : eLpNorm f (ENNReal.ofReal R) M.P.toMeasure ≤
      ENNReal.ofReal (C2 ^ (1 / R) * σ) := by
    rw [hReq]
    refine (ENNReal.rpow_le_rpow hRbound (by positivity)).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [Real.mul_rpow hC2nn (by positivity)]
    rw [show (σ ^ R) ^ (1 / R) = σ from by
      rw [← Real.rpow_mul hσpos.le, mul_one_div_cancel hR0.ne', Real.rpow_one]]
  refine hR_lyap.trans (hRfinal.trans (le_of_eq ?_))
  rw [hCB1def]
  congr 1
  rw [hσeq]
  ring

theorem aux_lem_band_piece_product_baseline_c1_baseline (d : ℕ) (hd2 : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (s eps : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (p : ℝ) (hp : 1 ≤ p) :
    ∃ CB delta0 : ℝ, 0 ≤ CB ∧ 0 < delta0 ∧
      ∀ (M : GMCModel d), M.delta ≤ delta0 →
      ∀ (eta : ℕ → BilateralField d → PotentialSample d),
        (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
          ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
            omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
      ∀ (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
        (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
        (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop),
        (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
          primitive_scores d M s eps (eta N omega)
            (fun m y => F N m y omega) (fun m y => Praw N m y omega)
            (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
            (fun m y => Z N m y omega) (fun m y => rawGood N m y omega)) →
      ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) →
        (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
          Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega ≠ ⊤) ∧
        eLpNorm (fun omega =>
            (Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal - 2)
          (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (CB * M.delta) := by
  obtain ⟨CB, delta0, hCB0, hdelta0, hmain⟩ := aux_lem_band_piece_product_baseline_c1_PscF_centered_eLpNorm_le hd2 s hs p hp
  refine ⟨CB, delta0, hCB0, hdelta0, ?_⟩
  intro M hMdelta eta hEta F Praw Rraw Draw Z rawGood hPrimitive N n z hnN
  set m : ℕ := ((N : ℤ) - n).toNat with hmdef
  set w : Vec d := (3 : ℝ) ^ N • z with hwdef
  obtain ⟨hfin_M, hbound_M⟩ := hmain M hMdelta m w
  have hae := aux_prefix_praw_actual_ae_eq M s eps eta F Praw Rraw Draw Z rawGood hPrimitive N m w
  have hmeasEta : AEMeasurable (eta N) (chaosSampleLaw M).toMeasure :=
    prefix_eta_aemeasurable M eta hEta N
  have hlaw : Measure.map (eta N) (chaosSampleLaw M).toMeasure = M.P.toMeasure :=
    prefix_eta_law M eta hEta N
  constructor
  · have hfin_pullback : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        aux_prefix_praw_PscF s m w (eta N omega) ≠ ⊤ := by
      have := ae_of_ae_map (μ := (chaosSampleLaw M).toMeasure) hmeasEta
        (p := fun g => aux_prefix_praw_PscF s m w g ≠ ⊤)
      rw [hlaw] at this
      exact this hfin_M
    filter_upwards [hae, hfin_pullback] with omega heq hfin
    rw [heq]; exact hfin
  · have hgmeas : Measurable (fun g : PotentialSample d => (aux_prefix_praw_PscF s m w g).toReal - 2) :=
      (ENNReal.measurable_toReal.comp (aux_lem_prefix_limit_actual_Psc_meas s m w)).sub
        measurable_const
    have hmap_eq : eLpNorm (fun g : PotentialSample d => (aux_prefix_praw_PscF s m w g).toReal - 2)
        (ENNReal.ofReal p) M.P.toMeasure =
        eLpNorm (fun omega => (aux_prefix_praw_PscF s m w (eta N omega)).toReal - 2)
          (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure := by
      rw [← hlaw]
      exact eLpNorm_map_measure hgmeas.aestronglyMeasurable hmeasEta
    have hcongr : eLpNorm (fun omega => (aux_prefix_praw_PscF s m w (eta N omega)).toReal - 2)
        (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure =
        eLpNorm (fun omega => (Praw N m w omega).toReal - 2)
          (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure := by
      refine eLpNorm_congr_ae ?_
      filter_upwards [hae] with omega heq
      rw [heq]
    rw [← hcongr, ← hmap_eq]
    exact hbound_M

theorem aux_lem_band_piece_product_rpow_le_exp (r : ℝ) (hr : 0 < r) (t : ℝ) (ht : 0 ≤ t) :
    t ^ r ≤ (r / Real.exp 1) ^ r * Real.exp t := by
  have h1 : (t / r - 1) + 1 ≤ Real.exp (t / r - 1) := Real.add_one_le_exp _
  have h2 : t / r ≤ Real.exp (t / r - 1) := by linarith
  have h3 : Real.exp (t / r - 1) = Real.exp (t / r) * (Real.exp 1)⁻¹ := by
    rw [show t / r - 1 = t / r + (-1) by ring, Real.exp_add, Real.exp_neg]
  rw [h3] at h2
  have hep : 0 < Real.exp 1 := Real.exp_pos 1
  have h4 : t / r * Real.exp 1 ≤ Real.exp (t / r) := by
    have h2' : t / r * Real.exp 1 ≤ Real.exp (t / r) * (Real.exp 1)⁻¹ * Real.exp 1 :=
      mul_le_mul_of_nonneg_right h2 hep.le
    rwa [show Real.exp (t / r) * (Real.exp 1)⁻¹ * Real.exp 1
        = Real.exp (t / r) * ((Real.exp 1)⁻¹ * Real.exp 1) by ring,
      inv_mul_cancel₀ hep.ne', mul_one] at h2'
  have h5 : (t / r * Real.exp 1) ^ r ≤ (Real.exp (t / r)) ^ r :=
    Real.rpow_le_rpow (by positivity) h4 hr.le
  have h6 : (Real.exp (t / r)) ^ r = Real.exp t := by
    rw [Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp]
    congr 1
    field_simp
  have h8 : (t / r * Real.exp 1) ^ r = (Real.exp 1 / r) ^ r * t ^ r := by
    rw [show t / r * Real.exp 1 = (Real.exp 1 / r) * t by ring,
      Real.mul_rpow (by positivity) ht]
  rw [h8, h6] at h5
  have hAB : (Real.exp 1 / r) ^ r * (r / Real.exp 1) ^ r = 1 := by
    rw [← Real.mul_rpow (by positivity) (by positivity),
      show (Real.exp 1 / r) * (r / Real.exp 1) = 1 by field_simp, Real.one_rpow]
  have hBnn : (0 : ℝ) ≤ (r / Real.exp 1) ^ r := Real.rpow_nonneg (by positivity) r
  have h5' := mul_le_mul_of_nonneg_left h5 hBnn
  rw [← mul_assoc, mul_comm ((r / Real.exp 1) ^ r) ((Real.exp 1 / r) ^ r), hAB, one_mul] at h5'
  exact h5'

theorem aux_lem_band_piece_product_weighted_pow_sum {ι : Type*} (s : Finset ι) (c : ι → ℝ)
    (X : ι → ENNReal) (hc : ∀ i ∈ s, 0 < c i) (hCpos : 0 < ∑ i ∈ s, c i) (r : ℝ) (hr : 1 ≤ r) :
    (∑ i ∈ s, ENNReal.ofReal (c i) * X i) ^ r ≤
      ENNReal.ofReal (∑ i ∈ s, c i) ^ (r - 1) * ∑ i ∈ s, ENNReal.ofReal (c i) * X i ^ r := by
  set C : ℝ := ∑ i ∈ s, c i with hCdef
  set w : ι → ENNReal := fun i => ENNReal.ofReal (c i / C) with hwdef
  have hrnn : (0 : ℝ) ≤ r := by linarith
  have hw' : ∑ i ∈ s, w i = 1 := by
    have hsum : ∑ i ∈ s, c i / C = 1 := by
      rw [← Finset.sum_div, ← hCdef, div_self hCpos.ne']
    rw [hwdef, ← ENNReal.ofReal_sum_of_nonneg
      (fun i hi => div_nonneg (hc i hi).le hCpos.le), hsum, ENNReal.ofReal_one]
  have hmean := ENNReal.rpow_arith_mean_le_arith_mean_rpow s w X hw' hr
  have hweq : ∀ i ∈ s, w i = ENNReal.ofReal C⁻¹ * ENNReal.ofReal (c i) := by
    intro i hi
    simp only [hwdef]
    rw [show c i / C = C⁻¹ * c i by ring, ENNReal.ofReal_mul (by positivity)]
  have hlhs : ∑ i ∈ s, w i * X i = ENNReal.ofReal C⁻¹ * ∑ i ∈ s, ENNReal.ofReal (c i) * X i := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i hi => by rw [hweq i hi, mul_assoc])
  have hrhs : ∑ i ∈ s, w i * X i ^ r
      = ENNReal.ofReal C⁻¹ * ∑ i ∈ s, ENNReal.ofReal (c i) * X i ^ r := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i hi => by rw [hweq i hi, mul_assoc])
  rw [hlhs, hrhs, ENNReal.mul_rpow_of_nonneg _ _ hrnn] at hmean
                                                       
  have hCr : (ENNReal.ofReal C) ^ r * (ENNReal.ofReal C⁻¹) ^ r = 1 := by
    rw [← ENNReal.mul_rpow_of_nonneg _ _ hrnn, ← ENNReal.ofReal_mul hCpos.le,
      mul_inv_cancel₀ hCpos.ne', ENNReal.ofReal_one, ENNReal.one_rpow]
  have key : (∑ i ∈ s, ENNReal.ofReal (c i) * X i) ^ r
      ≤ (ENNReal.ofReal C) ^ r * (ENNReal.ofReal C⁻¹ * ∑ i ∈ s, ENNReal.ofReal (c i) * X i ^ r) := by
    calc (∑ i ∈ s, ENNReal.ofReal (c i) * X i) ^ r
        = 1 * (∑ i ∈ s, ENNReal.ofReal (c i) * X i) ^ r := (one_mul _).symm
      _ = ((ENNReal.ofReal C) ^ r * (ENNReal.ofReal C⁻¹) ^ r)
            * (∑ i ∈ s, ENNReal.ofReal (c i) * X i) ^ r := by rw [hCr]
      _ = (ENNReal.ofReal C) ^ r
            * ((ENNReal.ofReal C⁻¹) ^ r * (∑ i ∈ s, ENNReal.ofReal (c i) * X i) ^ r) := by ring
      _ ≤ (ENNReal.ofReal C) ^ r * (ENNReal.ofReal C⁻¹ * ∑ i ∈ s, ENNReal.ofReal (c i) * X i ^ r) :=
          mul_le_mul_right hmean _
  have hCr1 : (ENNReal.ofReal C) ^ r * ENNReal.ofReal C⁻¹ = (ENNReal.ofReal C) ^ (r - 1) := by
    rw [ENNReal.ofReal_rpow_of_pos hCpos, ← ENNReal.ofReal_mul (Real.rpow_nonneg hCpos.le r),
      show C ^ r * C⁻¹ = C ^ (r - 1) from by
        rw [Real.rpow_sub hCpos, Real.rpow_one, div_eq_mul_inv],
      ENNReal.ofReal_rpow_of_pos hCpos]
  rwa [← mul_assoc, hCr1] at key

theorem aux_lem_band_piece_product_iSup_rpow {f : ℕ → ENNReal} (hmono : Monotone f) (r : ℝ)
    (hr : 0 ≤ r) : (⨆ K, f K) ^ r = ⨆ K, (f K) ^ r := by
  have h1 : Filter.Tendsto f Filter.atTop (nhds (⨆ K, f K)) := tendsto_atTop_iSup hmono
  have h2 : Filter.Tendsto (fun K => (f K) ^ r) Filter.atTop (nhds ((⨆ K, f K) ^ r)) :=
    (ENNReal.continuous_rpow_const.tendsto _).comp h1
  have hmono2 : Monotone (fun K => (f K) ^ r) := fun a b hab => ENNReal.rpow_le_rpow (hmono hab) hr
  have h3 : Filter.Tendsto (fun K => (f K) ^ r) Filter.atTop (nhds (⨆ K, (f K) ^ r)) :=
    tendsto_atTop_iSup hmono2
  exact tendsto_nhds_unique h2 h3

theorem aux_lem_band_piece_product_bank_pow_bound (d : ℕ) [NeZero d] (M : GMCModel d) (m : ℕ)
    (z : Vec d) (j a : ℕ)
    (haj : m + j ≤ a) (L : ℝ) (hLnn : 0 ≤ L)
    (hL : ∀ K : ℕ, ∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i ≤ L)
    (R theta : ℝ) (hR : 0 < R) (htheta : R * 6 < theta) :
    (∫⁻ omega, (⨆ K : ℕ, ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc a (a + K),
        aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))) ^ R
        ∂M.P.toMeasure) ≤
      (((7 ^ d : ℕ) : ℝ≥0∞) *
        (ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ^
          (R * L / theta) := by
  have hth0 : (0 : ℝ) < theta := lt_of_le_of_lt (by positivity) htheta
  set C : ℝ≥0∞ := ((7 ^ d : ℕ) : ℝ≥0∞) *
    (ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2) with hC
  have hC1 : (1 : ℝ≥0∞) ≤ C := by
    have h7 : (1 : ℝ≥0∞) ≤ ((7 ^ d : ℕ) : ℝ≥0∞) := by
      exact_mod_cast Nat.one_le_pow d 7 (by norm_num)
    have hexp : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) := by
      rw [← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal (Real.one_le_exp (by positivity))
    have h2 : (1 : ℝ≥0∞) ≤
        ENNReal.ofReal (Real.exp (theta ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2 := by
      have := mul_le_mul' hexp (by norm_num : (1 : ℝ≥0∞) ≤ 2)
      simpa using this
    have := mul_le_mul' h7 h2
    simpa [hC] using this
  have hC0 : C ≠ 0 := by
    intro h; rw [h] at hC1; exact absurd hC1 (by simp)
  have hCt : C ≠ ⊤ := by
    rw [hC]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (by norm_num))
  let G : ℕ → PotentialField d → ℝ≥0∞ := fun i h =>
    ENNReal.ofReal (Real.exp ((R * aux_psf_lam m j i) *
      (aux_psf_cells d (m + 1 + j - i)).sup' (aux_psf_cells_nonempty d _)
        (fun k => aux_prefix_praw_obs (PotentialField.spatialScale ((3 : ℝ) ^ i)
          (PotentialField.translate
            (((3 : ℝ) ^ i) • aux_psf_center (m + 1 + j - i) (((3 : ℝ) ^ (-(i : ℤ))) • z) k)
            h)))))
  have hG : ∀ i, Measurable (G i) := by
    intro i
    refine (((Measurable.const_mul ?_ _).exp).ennreal_ofReal)
    have h : Measurable ((aux_psf_cells d (m + 1 + j - i)).sup' (aux_psf_cells_nonempty d _)
        (fun k (h : PotentialField d) => aux_prefix_praw_obs
          (PotentialField.spatialScale ((3 : ℝ) ^ i) (PotentialField.translate
            (((3 : ℝ) ^ i) • aux_psf_center (m + 1 + j - i) (((3 : ℝ) ^ (-(i : ℤ))) • z) k)
            h)))) :=
      Finset.measurable_sup' _ (fun k _ =>
        aux_prefix_praw_obs_measurable.comp (aux_prefix_praw_translate_measurable i _))
    convert h using 1
    funext h
    rw [Finset.sup'_apply]
  have hGbank : ∀ (i : ℕ) (omega : PotentialSample d), G i (omega i) =
      ENNReal.ofReal (Real.exp ((R * aux_psf_lam m j i) *
        aux_prefix_praw_bank i (m + 1 + j) z omega)) := fun _ _ => rfl
  set f : ℕ → PotentialSample d → ℝ≥0∞ := fun K omega =>
    ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc a (a + K),
      aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega)) with hf
  have hfmeas : ∀ K, Measurable (f K) := by
    intro K
    refine Measurable.ennreal_ofReal (Real.measurable_exp.comp ?_)
    exact Finset.measurable_sum _ (fun i _ =>
      (aux_prefix_praw_bank_measurable i (m + 1 + j) z).const_mul _)
  have hmono : Monotone f := by
    intro K K' hKK' omega
    refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.2 ?_)
    refine Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_
    · exact Finset.Icc_subset_Icc_right (by omega)
    · intro i _ _
      have := aux_prefix_praw_bank_nonneg i (m + 1 + j) z omega
      have := (aux_psf_lam_pos m j i).le
      positivity
  have hgmono : Monotone (fun K omega => (f K omega) ^ R) := by
    intro K K' hKK' omega
    exact ENNReal.rpow_le_rpow (hmono hKK' omega) hR.le
  have hterm : ∀ K : ℕ, (∫⁻ omega, (f K omega) ^ R ∂M.P.toMeasure) ≤ C ^ (R * L / theta) := by
    intro K
    have hsplit : ∀ omega : PotentialSample d, (f K omega) ^ R =
        ∏ i ∈ Finset.Icc a (a + K), G i (omega i) := by
      intro omega
      simp only [hf, hGbank]
      rw [aux_psf_ofReal_exp_rpow]
      rw [show (∑ i ∈ Finset.Icc a (a + K),
          aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega) * R
          = ∑ i ∈ Finset.Icc a (a + K),
              (R * aux_psf_lam m j i) * aux_prefix_praw_bank i (m + 1 + j) z omega by
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl (fun i _ => by ring)]
      exact (aux_psf_prod_ofReal_exp _ _).symm
    simp only [hsplit]
    rw [ProbabilityTheory.lintegral_prod_eq_prod_lintegral_of_indepFun _ _
      (aux_prefix_praw_indep M G hG)
      (fun i => (hG i).comp (measurable_potentialCoordinate (d := d) i))]
    calc
      ∏ i ∈ Finset.Icc a (a + K), ∫⁻ omega, G i (omega i) ∂M.P.toMeasure ≤
          ∏ i ∈ Finset.Icc a (a + K), C ^ ((R * aux_psf_lam m j i) / theta) := by
        refine Finset.prod_le_prod' (fun i hi => ?_)
        have hi' : m + j ≤ i := haj.trans (Finset.mem_Icc.1 hi).1
        simp only [hGbank]
        apply aux_prefix_praw_bank_exp_holder M m j i hi' z
        · exact mul_pos hR (aux_psf_lam_pos m j i)
        · have := aux_psf_lam_le_six m j i hi'
          nlinarith
      _ = C ^ (∑ i ∈ Finset.Icc a (a + K), (R * aux_psf_lam m j i) / theta) :=
        aux_psf_prod_rpow C hC0 hCt _ _
      _ ≤ C ^ (R * L / theta) := by
        refine ENNReal.rpow_le_rpow_of_exponent_le hC1 ?_
        have hlam := hL K
        calc
          ∑ i ∈ Finset.Icc a (a + K), (R * aux_psf_lam m j i) / theta =
              (R / theta) * ∑ i ∈ Finset.Icc a (a + K), aux_psf_lam m j i := by
            rw [Finset.mul_sum]; congr 1; ext i; ring
          _ ≤ (R / theta) * L := by gcongr
          _ = R * L / theta := by ring
  calc (∫⁻ omega, (⨆ K : ℕ, f K omega) ^ R ∂M.P.toMeasure)
      = ∫⁻ omega, ⨆ K : ℕ, (f K omega) ^ R ∂M.P.toMeasure := by
        refine lintegral_congr (fun omega => ?_)
        have hmono' : Monotone (fun K => f K omega) := by
          intro K K' hKK'; exact hmono hKK' omega
        exact aux_lem_band_piece_product_iSup_rpow hmono' R hR.le
    _ = ⨆ K : ℕ, ∫⁻ omega, (f K omega) ^ R ∂M.P.toMeasure :=
        lintegral_iSup (fun K => (hfmeas K).pow_const R) hgmono
    _ ≤ C ^ (R * L / theta) := iSup_le hterm

theorem aux_lem_band_piece_product_exp_sub_one_le (t : ℝ) :
    Real.exp t - 1 ≤ t * Real.exp t := by
  have h1 : (-t) + 1 ≤ Real.exp (-t) := Real.add_one_le_exp (-t)
  have h2 : Real.exp (-t) = (Real.exp t)⁻¹ := by rw [← Real.exp_neg]
  rw [h2] at h1
  have hep : 0 < Real.exp t := Real.exp_pos t
  have h3 : ((-t) + 1) * Real.exp t ≤ (Real.exp t)⁻¹ * Real.exp t :=
    mul_le_mul_of_nonneg_right h1 hep.le
  rw [inv_mul_cancel₀ hep.ne'] at h3
  nlinarith [h3]

theorem aux_lem_band_piece_product_bank_poly_moment (d : ℕ) [NeZero d] (M : GMCModel d)
    (m j i : ℕ) (hi : m + j ≤ i) (z : Vec d) (r : ℝ) (hr : 0 < r) :
