      (aux_prefix_praw_Amaj m j z omega) ^ (mu + R)) :=
    (aux_prefix_praw_Amaj_measurable m j z).pow_const _
  calc (∫⁻ omega, (aux_prefix_praw_Amaj m j z omega - 1) ^ R ∂M.P.toMeasure) ≤
      ∫⁻ omega, ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) *
        (aux_prefix_praw_Amaj m j z omega) ^ (mu + R) ∂M.P.toMeasure := lintegral_mono hpt
    _ = ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) *
        ∫⁻ omega, (aux_prefix_praw_Amaj m j z omega) ^ (mu + R) ∂M.P.toMeasure :=
        lintegral_const_mul _ hmeas
