  have hA : (1 : ENNReal) ≤
      ∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i z|) := by
    rw [aux_psf_prod_ofReal_exp, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (Real.one_le_exp
      (Finset.sum_nonneg (fun i _ => abs_nonneg _)))
  have hB : (1 : ENNReal) ≤ sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := by
    have hmem0 : (∏ i ∈ Finset.Icc (m + j) (m + j + 0),
        ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))) ∈
        {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
