        ENNReal.ofReal ((3 : ℝ) ^ (-(s * ((k : ℕ) : ℝ) / 8))) *
          aux_lem_band_piece_product_Pj d m z omega H (k : ℕ)))) := by
    funext omega
    unfold aux_lem_band_piece_product_trunc_Pcand
    congr 1
    ext v
