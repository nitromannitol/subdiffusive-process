theorem aux_lem_band_gapD_T1point_mem {d : ℕ} (l jj : ℕ) (hlj : l ≤ jj) (z x : Vec d)
    (hgrid : OnTriadicGrid l (x - z)) (hx : x - z ∈ cube d (jj : ℤ)) :
    ∃ kidx ∈ aux_lem_band_gapD_T1index d (jj - l), x = aux_lem_band_gapD_T1point l z kidx := by
  choose c hc using hgrid
  have hl3 : (0 : ℝ) < (3 : ℝ) ^ l := by positivity
  have hxmem : ∀ i, (-(1 / 2 : ℝ)) * (3 : ℝ) ^ (jj : ℤ) < x i - z i ∧
      x i - z i < (1 / 2 : ℝ) * (3 : ℝ) ^ (jj : ℤ) := by
    intro i
    rw [cube, Homogenization.mem_openCubeSet_originCube_iff] at hx
    have := hx i
    simpa [Pi.sub_apply] using this
  have hsplit : ∀ i, |(c i : ℝ)| < (3 : ℝ) ^ ((jj : ℤ) - (l : ℤ)) := by
    intro i
    have hbound := hxmem i
    have hci : x i - z i = (3 : ℝ) ^ l * ((c i : ℤ) : ℝ) := by
      simpa [Pi.sub_apply] using hc i
    rw [hci] at hbound
    have hzpoweq : (3 : ℝ) ^ (jj : ℤ) = (3 : ℝ) ^ l * (3 : ℝ) ^ ((jj : ℤ) - (l : ℤ)) := by
      rw [← zpow_natCast (3 : ℝ) l, ← zpow_add₀ (by norm_num : (3 : ℝ) ≠ 0)]
      congr 1
      omega
    rw [hzpoweq] at hbound
    have habs : |(3 : ℝ) ^ l * ((c i : ℤ) : ℝ)| <
        (3 : ℝ) ^ l * (3 : ℝ) ^ ((jj : ℤ) - (l : ℤ)) := by
      rw [abs_lt]
      constructor <;> linarith [hbound.1, hbound.2]
    rw [abs_mul, abs_of_pos hl3] at habs
    exact lt_of_mul_lt_mul_left habs hl3.le
  refine ⟨c, ?_, ?_⟩
  · rw [aux_lem_band_gapD_T1index, Fintype.mem_piFinset]
    intro i
    rw [Finset.mem_Icc]
    have hb := hsplit i
    have hzcast : (3 : ℝ) ^ ((jj : ℤ) - (l : ℤ)) = (((3 ^ (jj - l) : ℤ)) : ℝ) := by
      rw [show (jj : ℤ) - (l : ℤ) = ((jj - l : ℕ) : ℤ) by omega, zpow_natCast]
      push_cast; ring
    rw [hzcast] at hb
    have hb' : |c i| < (3 ^ (jj - l) : ℤ) := by exact_mod_cast hb
    exact abs_le.mp hb'.le
  · funext i
    have hci := hc i
    simp only [Pi.sub_apply] at hci
    simp only [aux_lem_band_gapD_T1point]
    linarith

theorem aux_lem_band_DT1_cube_mono {d : ℕ} {j l : ℤ} (hjl : j ≤ l) :
