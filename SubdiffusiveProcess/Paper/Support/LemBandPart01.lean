    refine hPscF_bound.trans (ENNReal.ofReal_le_ofReal ?_)
    nlinarith [mul_le_mul_of_nonneg_left hMdelta hCB2nn]
  set restr : PotentialSample d → ENNReal := fun omega =>
    sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
      v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * aux_lem_band_piece_product_Tj d m z omega j}
    with hrestrdef
  have hrestr_le_Praw : ∀ omega, restr omega ≤ aux_lem_band_piece_product_Praw d s m z omega := by
    intro omega
