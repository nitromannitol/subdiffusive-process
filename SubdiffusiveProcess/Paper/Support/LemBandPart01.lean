    intro omega
    rw [← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal
      (aux_lem_band_piece_product_rpow_le_exp r hr _ (aux_prefix_praw_bank_nonneg i _ z omega))
  have hcard : ((aux_psf_cells d (m + 1 + j - i)).card : ℝ≥0∞) ≤ ((7 ^ d : ℕ) : ℝ≥0∞) := by
    rw [aux_psf_cells_card]
    have hgap : m + 1 + j - i ≤ 1 := by omega
    have h3 : 2 * 3 ^ (m + 1 + j - i) + 1 ≤ 7 := by
      have : 3 ^ (m + 1 + j - i) ≤ 3 ^ 1 := Nat.pow_le_pow_right (by norm_num) hgap
      omega
    exact_mod_cast Nat.pow_le_pow_left h3 d
  have hlin := aux_prefix_praw_bank_exp_lin M i (m + 1 + j) z 1
  simp only [one_mul] at hlin
