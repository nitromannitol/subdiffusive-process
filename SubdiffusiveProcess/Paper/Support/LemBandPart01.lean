    aux_lem_band_DT1 M s k z omega ≠ ⊤ :=
  ne_top_of_le_ne_top (by norm_num) (aux_lem_band_DT1_le_one M s hs k z omega)

theorem aux_lem_band_DT1_band {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (s : ℝ) (hs : 0 < s) (a1rc c1 : ℝ) (ha1rc : 0 < a1rc) (hc1 : 0 < c1) :
    ∃ a1 : ℝ, 0 < a1 ∧ ∀ q : ℝ, 1 ≤ q → ∃ q' : ℝ, 1 ≤ q' ∧ ∀ Crc : ℝ, 0 ≤ Crc →
      ∃ C1 : ℝ, 0 ≤ C1 ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
        (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d),
        (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ (N i : ℕ) (y : Vec d),
          eta N omega i y = omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
        (∀ (N l : ℕ) (x : Vec d), ∀ h' : ℕ,
          ∃ Jb : BilateralField d → ℝ,
            AEStronglyMeasurable[MeasurableSpace.comap
              (fun omega : BilateralField d =>
                fun j : Set.Icc ((l : ℤ) - N - h') ((l : ℤ) - N) => omega (j : ℤ))
              inferInstance] Jb (chaosSampleLaw M).toMeasure ∧
            eLpNorm (fun omega => (aux_lem_band_Jcell M l x (eta N omega)).toReal - Jb omega)
              (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
              ENNReal.ofReal (Crc * M.delta ^ c1 * (3 : ℝ) ^ (-(a1rc * (h' : ℝ))))) →
        ∀ (N k : ℕ) (z : Vec d) (h : ℕ),
          ∃ T : BilateralField d → ℝ,
            AEStronglyMeasurable[aux_lem_band_bandSig ((k : ℤ) - N) (4 * (h + 1))] T
              (chaosSampleLaw M).toMeasure ∧
            eLpNorm (fun omega => (aux_lem_band_DT1 M s k z (eta N omega)).toReal - T omega)
              (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
              ENNReal.ofReal (C1 * (3 : ℝ) ^ (-(a1 * (h : ℝ)))) := by
  classical
  let a := min (s / 2) a1rc
  have ha : 0 < a := lt_min (by positivity) ha1rc
  refine ⟨a, ha, ?_⟩
  intro q hq
  let Q := max q (((d : ℝ) + 1) / a1rc)
  have hQ : 1 ≤ Q := hq.trans (le_max_left _ _)
  have hQpos : 0 < Q := lt_of_lt_of_le zero_lt_one hQ
  refine ⟨Q, hQ, ?_⟩
  intro Crc hCrc
  refine ⟨1 + Real.sqrt Crc, by positivity, ?_⟩
  intro M eta heta hcell N k z h
  let μ := (chaosSampleLaw M).toMeasure
  choose Jb hJbm hJbn using hcell N
  let T := aux_lem_band_DT1_T_E s k h z Jb
  let Err := aux_lem_band_DT1_CellErr M k h z eta Jb N
  let S := aux_lem_band_DT1_catalog d k h
  have hS : S.Nonempty := aux_lem_band_DT1_catalog_nonempty d k h
  let g := fun c : ℕ × (Fin d → ℤ) =>
    fun omega => (aux_lem_band_DT1_diffTerm M k h z eta Jb N c omega) ^ (1 / 2 : ℝ)
  have hEm : AEMeasurable Err μ := by
    have hg : ∀ c ∈ S, AEStronglyMeasurable (g c) μ := by
      intro c _
      have hJ : AEMeasurable
          (fun omega => aux_lem_band_Jcell M c.1 (aux_lem_band_gapD_T1point c.1 z c.2)
            (eta N omega)) μ :=
        (aux_lem_prefix_limit_actual_J_meas M c.1 _).comp_aemeasurable
          (prefix_eta_aemeasurable M eta heta N)
      have hBm : AEStronglyMeasurable (Jb c.1 (aux_lem_band_gapD_T1point c.1 z c.2)
          (3 * (h + 1))) μ := by
        apply (hJbm c.1 _ (3 * (h + 1))).mono
        exact (Measurable.of_eval fun j => measurable_pi_apply _).comap_le
      exact (ENNReal.continuous_rpow_const.comp_aestronglyMeasurable
        (ENNReal.continuous_ofReal.comp_aestronglyMeasurable
          ((hJ.ennreal_toReal.aestronglyMeasurable.sub hBm).norm)))
    have hex : Err = S.sup' hS g := by funext omega; simp [Err, S, g, aux_lem_band_DT1_CellErr]
    rw [hex]
    exact (aux_lem_band_DT1_aestronglyMeasurable_sup' hS hg).aemeasurable
  have hEfin : ∀ omega, Err omega ≠ ∞ := by
    intro omega
    apply ne_of_lt
    apply (Finset.sup'_lt_iff _).mpr
    intro c _
    exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
  have hTfin : ∀ omega, T omega ≠ ∞ := by
    intro omega
    exact ne_top_of_le_ne_top
      (ENNReal.add_ne_top.mpr ⟨aux_lem_band_DT1_ne_top M s hs k z _, hEfin omega⟩)
      (aux_lem_band_DT1_directionB M s hs k h z eta Jb N omega)
  have hTm := aux_lem_band_DT1_T_E_aestronglyMeasurable M s k h N z Jb
    (fun l x => hJbm l x (3 * (h + 1)))
  have hTreal : AEStronglyMeasurable[aux_lem_band_bandSig ((k : ℤ) - N) (4 * (h + 1))]
      (fun omega => (T omega).toReal) μ := by
    refine ⟨fun omega => (hTm.mk _ omega).toReal,
      hTm.stronglyMeasurable_mk.measurable.ennreal_toReal.stronglyMeasurable, ?_⟩
    filter_upwards [hTm.ae_eq_mk] with omega heq
    exact congrArg ENNReal.toReal heq
  refine ⟨fun omega => (T omega).toReal, hTreal, ?_⟩
  let b := (3 : ℝ) ^ (-(s / 2) * h)
  have hb : 0 ≤ b := by positivity
  have hpt (omega : BilateralField d) :
      |(aux_lem_band_DT1 M s k z (eta N omega)).toReal - (T omega).toReal| ≤
        b + (Err omega).toReal := by
    have ha' := ENNReal.toReal_mono
      (ENNReal.add_ne_top.mpr ⟨hTfin omega,
        ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, hEfin omega⟩⟩)
      (aux_lem_band_DT1_directionA M s hs k h z eta Jb N omega)
    have hb' := ENNReal.toReal_mono
      (ENNReal.add_ne_top.mpr ⟨aux_lem_band_DT1_ne_top M s hs k z _, hEfin omega⟩)
      (aux_lem_band_DT1_directionB M s hs k h z eta Jb N omega)
    change _ ≤ (T omega + (ENNReal.ofReal b + Err omega)).toReal at ha'
    change _ ≤ (aux_lem_band_DT1 M s k z (eta N omega) + Err omega).toReal at hb'
    rw [ENNReal.toReal_add (hTfin omega) (ENNReal.add_ne_top.mpr
      ⟨ENNReal.ofReal_ne_top, hEfin omega⟩),
      ENNReal.toReal_add ENNReal.ofReal_ne_top (hEfin omega), ENNReal.toReal_ofReal hb] at ha'
    rw [ENNReal.toReal_add (aux_lem_band_DT1_ne_top M s hs k z _) (hEfin omega)] at hb'
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have hdelta : M.delta ^ c1 ≤ 1 := Real.rpow_le_one M.shellPrefix.delta_pos.le
    (le_trans M.shellPrefix.delta_le_half (by norm_num)) hc1.le
  let B := Crc * (3 : ℝ) ^ (-(a1rc * (3 * (h + 1) : ℕ)))
  have hB : 0 ≤ B := mul_nonneg hCrc (by positivity)
  have hgn : ∀ c ∈ S, eLpNorm (g c) (ENNReal.ofReal (2 * Q)) μ ≤
      ENNReal.ofReal (Real.sqrt B) := by
    intro c _
    apply aux_lem_band_DT1_sqrt_diff_guarded_le _ Q B hQpos hB
    refine (hJbn c.1 _ (3 * (h + 1))).trans (ENNReal.ofReal_le_ofReal ?_)
    apply mul_le_mul_of_nonneg_right _ (by positivity)
    nlinarith
  have hgm : ∀ c ∈ S, AEMeasurable (g c) μ := by
    intro c _
    have hJ := (aux_lem_prefix_limit_actual_J_meas M c.1
      (aux_lem_band_gapD_T1point c.1 z c.2)).comp_aemeasurable
      (prefix_eta_aemeasurable M eta heta N)
    have hBm := (hJbm c.1 (aux_lem_band_gapD_T1point c.1 z c.2) (3 * (h + 1))).mono
      (Measurable.of_eval fun j => measurable_pi_apply _).comap_le
    exact ((hJ.ennreal_toReal.sub hBm.aemeasurable).norm.ennreal_ofReal).pow_const _
  have hEn : eLpNorm Err (ENNReal.ofReal (2 * Q)) μ ≤
      (S.card : ENNReal) ^ (1 / (2 * Q)) * ENNReal.ofReal (Real.sqrt B) := by
    have hex : Err = S.sup' hS g := by funext omega; simp [Err, S, g, aux_lem_band_DT1_CellErr]
    rw [hex]
    exact aux_lem_band_DT1_finmax_eLpNorm_le hS hgm (2 * Q) (by positivity) _ hgn
  have hEns : eLpNorm (fun omega => (Err omega).toReal) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (Real.sqrt Crc * (3 : ℝ) ^ (-(a * h))) := by
    have hnorm : eLpNorm (fun omega => (Err omega).toReal) (ENNReal.ofReal q) μ ≤
        eLpNorm Err (ENNReal.ofReal q) μ := by
      apply eLpNorm_mono_enorm hEm.ennreal_toReal.aestronglyMeasurable
      intro omega
      simp only [Real.enorm_eq_ofReal_abs, abs_of_nonneg ENNReal.toReal_nonneg,
        ENNReal.ofReal_toReal (hEfin omega)]
      exact le_rfl
    have hqQ : ENNReal.ofReal q ≤ ENNReal.ofReal (2 * Q) := by
      apply ENNReal.ofReal_le_ofReal
      have hqq : q ≤ Q := le_max_left _ _
      linarith
    refine hnorm.trans ((eLpNorm_le_eLpNorm_of_exponent_le hqQ).trans
      (hEn.trans ?_))
    have hcard : (S.card : ENNReal) = ENNReal.ofReal (S.card : ℝ) := by simp
    rw [hcard, ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_ofReal
    refine (aux_lem_band_DT1_entropy_bound d k h a1rc Q Crc ha1rc hQpos
      (le_max_right _ _) hCrc).trans ?_
    apply mul_le_mul_of_nonneg_left _ (Real.sqrt_nonneg Crc)
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have := min_le_right (s / 2) a1rc
    nlinarith [Nat.cast_nonneg (α := ℝ) h]
  calc
    eLpNorm _ (ENNReal.ofReal q) μ ≤
        eLpNorm (fun omega => b + (Err omega).toReal) (ENNReal.ofReal q) μ := by
      have hm0 := ((aux_lem_prefix_limit_actual_Dsc_first_meas M s k z).ennreal_toReal).comp_aemeasurable
        (prefix_eta_aemeasurable M eta heta N)
      have hproj : Measurable (fun omega : BilateralField d =>
          fun j : Set.Icc ((k : ℤ) - N - (4 * (h + 1) : ℕ))
            ((k : ℤ) - N + (4 * (h + 1) : ℕ)) => omega (j : ℤ)) :=
        Measurable.of_eval fun j => measurable_pi_apply (j : ℤ)
      have hmT := hTreal.mono hproj.comap_le
      apply eLpNorm_mono (hm0.aestronglyMeasurable.sub hmT)
      intro omega
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (add_nonneg hb ENNReal.toReal_nonneg)]
      exact hpt omega
    _ ≤ eLpNorm (fun _ : BilateralField d => b) (ENNReal.ofReal q) μ +
        eLpNorm (fun omega => (Err omega).toReal) (ENNReal.ofReal q) μ :=
      eLpNorm_add_le (by simpa only [← ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal hq)
    _ ≤ ENNReal.ofReal b + ENNReal.ofReal (Real.sqrt Crc * (3 : ℝ) ^ (-(a * h))) := by
      apply add_le_add _ hEns
      rw [eLpNorm_const _ (by positivity) (NeZero.ne μ), measure_univ, ENNReal.one_rpow, mul_one]
      simp [Real.enorm_eq_ofReal_abs, abs_of_nonneg hb]
    _ ≤ ENNReal.ofReal ((1 + Real.sqrt Crc) * (3 : ℝ) ^ (-(a * h))) := by
      rw [← ENNReal.ofReal_add hb (by positivity)]
      apply ENNReal.ofReal_le_ofReal
      have hb' : b ≤ (3 : ℝ) ^ (-(a * h)) := by
        apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
        have := min_le_left (s / 2) a1rc
        nlinarith [Nat.cast_nonneg (α := ℝ) h]
      nlinarith





theorem aux_lem_band_DT2_ne_top {d : ℕ} [NeZero d] (s : ℝ) (k : ℕ) (z : Vec d)
    (omega'' : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) :
    aux_lem_band_DT2 s k z omega'' ≠ ⊤ := by
  have hDT2_le_fullsum :
      aux_lem_band_DT2 s k z omega'' ≤
      ∑ j ∈ Finset.range (k + 1), ENNReal.ofReal ((3 : ℝ) ^ (-(s / 8) * ((k : ℝ) - (j : ℝ)))) *
        ENNReal.ofReal (∑ i ∈ Finset.Icc (j + 1) k, aux_prefix_bank_maxObs i k z omega'') := by
    unfold aux_lem_band_DT2
    refine sSup_le ?_
    rintro v ⟨j, hjk, rfl⟩
    have hmem : j ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
    refine le_trans ?_ (aux_lem_band_DT2_single_le_sum
      (fun (j' : ℕ) => ENNReal.ofReal ((3 : ℝ) ^ (-(s / 8) * ((k : ℝ) - (j' : ℝ)))) *
        ENNReal.ofReal (∑ i ∈ Finset.Icc (j' + 1) k, aux_prefix_bank_maxObs i k z omega'')) hmem)
    refine mul_le_mul_right ?_ _
    refine sSup_le ?_
    rintro w ⟨x, hx, rfl⟩
    refine ENNReal.ofReal_le_ofReal ?_
    calc |shellBlock k j omega'' x|
        ≤ ∑ i ∈ Finset.Icc (j + 1) k, |omega'' i x| := by
          unfold shellBlock; exact Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i ∈ Finset.Icc (j + 1) k, aux_prefix_bank_maxObs i k z omega'' := by
          refine Finset.sum_le_sum (fun i hi => ?_)
          have hik : i ≤ k := (Finset.mem_Icc.mp hi).2
          have hb := aux_prefix_bank_le_maxObs i k hik z x omega'' hx
          have hgrad0 : 0 ≤ Homogenization.euclideanNorm
              (shellGradient (omega'' i) x) := Real.sqrt_nonneg _
          have h3i : (0 : ℝ) ≤ (3 : ℝ) ^ i := by positivity
          nlinarith [hb, mul_nonneg h3i hgrad0]
  have hfin : (∑ j ∈ Finset.range (k + 1),
      ENNReal.ofReal ((3 : ℝ) ^ (-(s / 8) * ((k : ℝ) - (j : ℝ)))) *
        ENNReal.ofReal (∑ i ∈ Finset.Icc (j + 1) k, aux_prefix_bank_maxObs i k z omega'')) ≠ ⊤ :=
    ENNReal.sum_ne_top.mpr (fun j _ => ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top)
  exact ne_top_of_le_ne_top hfin hDT2_le_fullsum

theorem aux_lem_band_DT3_ne_top {d : ℕ} [NeZero d] (s : ℝ) (k : ℕ) (z : Vec d)
    (omega'' : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) :
    aux_lem_band_DT3 s k z omega'' ≠ ⊤ := by
  have hDT3le : aux_lem_band_DT3 s k z omega'' ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s / 8) * (k : ℝ))) *
      ENNReal.ofReal (aux_prefix_bank_maxObs 0 k z omega'') := by
    unfold aux_lem_band_DT3
    refine mul_le_mul_right ?_ _
    refine sSup_le ?_
    rintro w ⟨x, hx, rfl⟩
    refine ENNReal.ofReal_le_ofReal ?_
    have hb := aux_prefix_bank_le_maxObs 0 k (Nat.zero_le k) z x omega'' hx
    simp only [pow_zero, one_mul] at hb
    have hgrad0 : 0 ≤ Homogenization.euclideanNorm (shellGradient (omega'' 0) x) := Real.sqrt_nonneg _
    linarith
  exact ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top) hDT3le

theorem aux_lem_band_DT4_ne_top {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ (N i : ℕ) (y : Vec d),
      eta N omega i y = omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (N k : ℕ) (z : Vec d) :
    ∀ᵐ omega' ∂(chaosSampleLaw M).toMeasure, aux_lem_band_DT4 k z (eta N omega') ≠ ⊤ := by
  have hlift : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      (∑' j : ℕ, aux_lem_band_DT4_bankmaj k z j (eta N omega)) ≠ ⊤ := by
    have hpush : ∀ᵐ potential ∂Measure.map (eta N) (chaosSampleLaw M).toMeasure,
        (∑' j : ℕ, aux_lem_band_DT4_bankmaj k z j potential) ≠ ⊤ := by
      rw [prefix_eta_law M eta heta N]
      exact aux_lem_band_DT4_bankmaj_tsum_ae M k z
    exact ae_of_ae_map (prefix_eta_aemeasurable M eta heta N) hpush
  filter_upwards [hlift] with omega' hom
  have hle : aux_lem_band_DT4 k z (eta N omega') ≤
      ∑' j, aux_lem_band_DT4_bankmaj k z j (eta N omega') := by
    show (∑' j, (if k ≤ j then aux_lem_band_DT4_termFn k z j (eta N omega') else 0)) ≤ _
    refine ENNReal.tsum_le_tsum (fun j => ?_)
    by_cases hkj : k ≤ j
    · rw [if_pos hkj]; exact aux_lem_band_DT4_termFn_le_bankmaj k z j (eta N omega') hkj
    · rw [if_neg hkj]; exact zero_le
  exact ne_top_of_le_ne_top hom hle


