theorem aux_lem_band_DT1_rpow_le_one_add (x : ENNReal) {β q' : ℝ} (hβ0 : 0 ≤ β)
    (hβq' : β ≤ q') : x ^ β ≤ 1 + x ^ q' := by
  rcases le_or_gt x 1 with hx | hx
  · exact le_trans (ENNReal.rpow_le_one hx hβ0) (le_add_right le_rfl)
  · exact le_trans (ENNReal.rpow_le_rpow_of_exponent_le hx.le hβq') (le_add_left le_rfl)

theorem aux_lem_band_DT1_ofReal_le_ofReal_add_abs {α β : ℝ} (hα : 0 ≤ α) :
    ENNReal.ofReal α ≤ ENNReal.ofReal β + ENNReal.ofReal |α - β| := by
  rcases le_or_gt 0 β with hβ | hβ
  · have h1 : α ≤ β + |α - β| := by
      have := abs_le.mp (le_refl |α - β|)
      linarith [le_abs_self (α - β)]
    calc ENNReal.ofReal α ≤ ENNReal.ofReal (β + |α - β|) := ENNReal.ofReal_le_ofReal h1
      _ = ENNReal.ofReal β + ENNReal.ofReal |α - β| :=
          ENNReal.ofReal_add hβ (abs_nonneg _)
  · have hβ0 : ENNReal.ofReal β = 0 := ENNReal.ofReal_eq_zero.mpr hβ.le
    have h1 : α ≤ |α - β| := by
      have : α - β = |α - β| := by
        rw [abs_of_pos (by linarith)]
      linarith
    calc ENNReal.ofReal α ≤ ENNReal.ofReal |α - β| := ENNReal.ofReal_le_ofReal h1
      _ = ENNReal.ofReal β + ENNReal.ofReal |α - β| := by rw [hβ0, zero_add]

theorem aux_lem_band_DT1_min_add_le (x c : ENNReal) : min (x + c) 1 ≤ min x 1 + c := by
  rcases le_or_gt 1 x with hx | hx
  · have hx1 : min x 1 = 1 := min_eq_right hx
    rw [hx1]
    calc min (x + c) 1 ≤ 1 := min_le_right _ _
      _ ≤ 1 + c := CanonicallyOrderedAdd.le_self_add 1 c
  · have hxle : min x 1 = x := min_eq_left hx.le
    rw [hxle]
    exact min_le_left _ _

theorem aux_lem_band_DT1_sqrt_lipschitz {α β : ℝ} (hα : 0 ≤ α) :
    (min (ENNReal.ofReal α) 1) ^ (1 / 2 : ℝ) ≤
      (min (ENNReal.ofReal β) 1) ^ (1 / 2 : ℝ) + (ENNReal.ofReal |α - β|) ^ (1 / 2 : ℝ) := by
  have h1 : ENNReal.ofReal α ≤ ENNReal.ofReal β + ENNReal.ofReal |α - β| :=
    aux_lem_band_DT1_ofReal_le_ofReal_add_abs hα
  have h2 : min (ENNReal.ofReal α) 1 ≤ min (ENNReal.ofReal β) 1 + ENNReal.ofReal |α - β| :=
    le_trans (min_le_min h1 le_rfl) (aux_lem_band_DT1_min_add_le _ _)
  calc (min (ENNReal.ofReal α) 1) ^ (1 / 2 : ℝ)
      ≤ (min (ENNReal.ofReal β) 1 + ENNReal.ofReal |α - β|) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow h2 (by norm_num)
    _ ≤ (min (ENNReal.ofReal β) 1) ^ (1 / 2 : ℝ) + (ENNReal.ofReal |α - β|) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_add_le_add_rpow _ _ (by norm_num) (by norm_num)

