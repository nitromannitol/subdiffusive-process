theorem aux_lem_band_piece_product_trunc_Pcand_meas (d : ℕ) (s : ℝ) (m H : ℕ) (z : Vec d) :
    Measurable (fun omega : PotentialSample d =>
      aux_lem_band_piece_product_trunc_Pcand d s m z omega H) := by
  have hterm : ∀ k : Fin (H + 1), Measurable (fun omega : PotentialSample d =>
      ENNReal.ofReal ((3 : ℝ) ^ (-(s * ((k : ℕ) : ℝ) / 8))) *
        aux_lem_band_piece_product_Pj d m z omega H (k : ℕ)) :=
    fun k => (aux_lem_band_piece_product_Pj_meas d m (k : ℕ) H z).const_mul _
  have heq : (fun omega : PotentialSample d => aux_lem_band_piece_product_trunc_Pcand d s m z omega H) =
