  have hBnn : ∀ j : ℕ, (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj := fun j => by positivity
  have step1 : (∑' j : ℕ, (∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
        ∂M.P.toMeasure)) ≤
      ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1) *
