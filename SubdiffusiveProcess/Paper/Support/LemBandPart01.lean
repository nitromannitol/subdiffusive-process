      ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) * ENNReal.ofReal (CB2 * delta02 + 2) :=
        mul_le_mul_right hPscF_bound' _
    _ = ENNReal.ofReal ((CB2 * delta02 + 2) * (3 : ℝ) ^ (-(s / 16) * (H : ℝ))) := by
        rw [← ENNReal.ofReal_mul (by positivity)]
        congr 1
        have hexpeq : (3 : ℝ) ^ (-(s * (H : ℝ) / 16)) = (3 : ℝ) ^ (-(s / 16) * (H : ℝ)) := by
          congr 1; ring
        rw [hexpeq]; ring

theorem aux_lem_band_piece_product_trunc_core (d : ℕ) (hd2 : 2 ≤ d) [NeZero d]
    (s : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1) (p : ℝ) (hp : 1 ≤ p) :
    ∃ C0 delta0 : ℝ, 0 ≤ C0 ∧ 0 < delta0 ∧
      ∀ (M : GMCModel d), M.delta ≤ delta0 →
      ∀ (m : ℕ) (z : Vec d) (H : ℕ),
        (∀ᵐ omega ∂M.P.toMeasure, aux_lem_band_piece_product_Praw d s m z omega ≠ ⊤) ∧
        eLpNorm (fun omega : PotentialSample d =>
            (aux_lem_band_piece_product_Praw d s m z omega).toReal -
              (aux_lem_band_piece_product_trunc_Pcand d s m z omega H).toReal)
          (ENNReal.ofReal p) M.P.toMeasure ≤
          ENNReal.ofReal (C0 * (3 : ℝ) ^ (-(s / 16) * (H : ℝ))) := by
  have hd1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast (by omega : 1 ≤ d)
  obtain ⟨CW, deltaW, hCWnn, hdeltaWpos, hwindow⟩ :=
    aux_lem_band_piece_product_trunc_window_bound d hd1 s hs.1 hs.2 p hp
  obtain ⟨CD, deltaD, hCDnn, hdeltaDpos, hdepth⟩ :=
    aux_lem_band_piece_product_trunc_depth_bound d hd2 s hs p hp
  refine ⟨CD + CW, min deltaW deltaD, by positivity, lt_min hdeltaWpos hdeltaDpos, ?_⟩
  intro M hMdelta m z H
  have hMdeltaW : M.delta ≤ deltaW := hMdelta.trans (min_le_left _ _)
  have hMdeltaD : M.delta ≤ deltaD := hMdelta.trans (min_le_right _ _)
  obtain ⟨hPfinS, hdepthbound⟩ := hdepth M hMdeltaD m z H
  have hWfin : ∀ᵐ omega ∂M.P.toMeasure,
      (sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
          aux_lem_band_piece_product_Tj d m z omega j}) ≠ ⊤ := by
    filter_upwards [hPfinS] with omega hfin
    exact ne_top_of_le_ne_top hfin (aux_lem_band_piece_product_trunc_restrict_le_Praw d s m H z omega)
  have hwindowbound := hwindow M hMdeltaW m z H hWfin
  refine ⟨hPfinS, ?_⟩
  have htri : (fun omega : PotentialSample d =>
      (aux_lem_band_piece_product_Praw d s m z omega).toReal -
        (aux_lem_band_piece_product_trunc_Pcand d s m z omega H).toReal) =
      (fun omega => ((aux_lem_band_piece_product_Praw d s m z omega).toReal -
          (sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
            v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
              aux_lem_band_piece_product_Tj d m z omega j}).toReal) +
        ((sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
            v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
              aux_lem_band_piece_product_Tj d m z omega j}).toReal -
          (aux_lem_band_piece_product_trunc_Pcand d s m z omega H).toReal)) := by
    funext omega; ring
  rw [htri]
  have hmeasPraw : Measurable (fun omega : PotentialSample d =>
      (aux_lem_band_piece_product_Praw d s m z omega).toReal) :=
    ENNReal.measurable_toReal.comp (aux_lem_prefix_limit_actual_Psc_meas s m z)
  have hmeasW : Measurable (fun omega : PotentialSample d =>
      (sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
          aux_lem_band_piece_product_Tj d m z omega j}).toReal) :=
    ENNReal.measurable_toReal.comp (aux_lem_band_piece_product_trunc_W_meas d s m H z)
  have hmeasPcand : Measurable (fun omega : PotentialSample d =>
      (aux_lem_band_piece_product_trunc_Pcand d s m z omega H).toReal) :=
    ENNReal.measurable_toReal.comp (aux_lem_band_piece_product_trunc_Pcand_meas d s m H z)
  refine (eLpNorm_add_le (by simpa using hp)).trans ?_
  refine (add_le_add hdepthbound hwindowbound).trans ?_
  have hAB : (3 : ℝ) ^ (-(s / 8) * (H : ℝ)) ≤ (3 : ℝ) ^ (-(s / 16) * (H : ℝ)) := by
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have hHnn : (0 : ℝ) ≤ (H : ℝ) := Nat.cast_nonneg H
    nlinarith [hs.1]
  have hstep : ENNReal.ofReal (CD * (3 : ℝ) ^ (-(s / 16) * (H : ℝ))) +
      ENNReal.ofReal (CW * (3 : ℝ) ^ (-(s / 8) * (H : ℝ))) ≤
      ENNReal.ofReal (CD * (3 : ℝ) ^ (-(s / 16) * (H : ℝ))) +
      ENNReal.ofReal (CW * (3 : ℝ) ^ (-(s / 16) * (H : ℝ))) := by
    gcongr
  refine hstep.trans (le_of_eq ?_)
  rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 1
  ring

