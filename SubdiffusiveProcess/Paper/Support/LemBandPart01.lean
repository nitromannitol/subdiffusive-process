  have hterm : ∀ j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * C = C * ρ ^ j := by
    intro j
    rw [hρdef, ← Real.rpow_natCast ((3 : ℝ) ^ (-(s * R / 8))) j,
