    rw [heq]
    refine (eLpNorm_add_le (by simpa using hp)).trans ?_
    rw [hconst2]
    calc eLpNorm (fun omega : PotentialSample d => (aux_prefix_praw_PscF (s / 2) m z omega).toReal - 2)
          (ENNReal.ofReal p) M.P.toMeasure + ENNReal.ofReal 2
        ≤ ENNReal.ofReal (CB2 * M.delta) + ENNReal.ofReal 2 := by gcongr
      _ = ENNReal.ofReal (CB2 * M.delta + 2) :=
          (ENNReal.ofReal_add (mul_nonneg hCB2nn hMdeltapos) (by norm_num)).symm
  have hPscF_bound' : eLpNorm (fun omega : PotentialSample d =>
      (aux_lem_band_piece_product_Praw d (s / 2) m z omega).toReal)
