  refine ⟨Yband, hYbandmeas, ?_⟩
  refine hYbandbound.trans (ENNReal.ofReal_le_ofReal ?_)
  have hrate_eq : Real.sqrt (M.delta ^ (1 : ℕ) * (3 : ℝ) ^ (-(s / 32) * (h : ℝ)))
      = M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(s / 64) * (h : ℝ)) := by
    rw [pow_one, Real.sqrt_mul hMdeltapos]
    have h3 : Real.sqrt ((3 : ℝ) ^ (-(s / 32) * (h : ℝ))) = (3 : ℝ) ^ (-(s / 64) * (h : ℝ)) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
      congr 1
      ring
    rw [Real.sqrt_eq_rpow, h3]
  rw [hrate_eq]
  exact le_of_eq (by ring)

