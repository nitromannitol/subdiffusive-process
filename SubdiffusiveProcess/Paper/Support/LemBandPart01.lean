theorem aux_lem_band_piece_product_depth_split (s : ℝ) (hs : 0 < s) (H : ℕ) (T : ℕ → ENNReal) :
    sSup {v : ENNReal | ∃ j : ℕ, v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * T j}
      - sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
          v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * T j}
    ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
      sSup {v : ENNReal | ∃ j : ℕ, v = ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * T j} := by
  set f : ℕ → ENNReal := fun j => ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * T j with hf
  set g : ℕ → ENNReal := fun j => ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * T j with hg
  set A : ENNReal := sSup {v | ∃ j, j ≤ H ∧ v = f j} with hA
  set B : ENNReal := sSup {v | ∃ j, H < j ∧ v = f j} with hB
  set Q : ENNReal := sSup {v | ∃ j, v = g j} with hQ
  have hfg : ∀ j : ℕ, f j = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 16))) * g j := by
    intro j
    have hsplit : (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) =
        (3 : ℝ) ^ (-(s * (j : ℝ) / 16)) * (3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8)) := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
      ring_nf
    show ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * T j =
        ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 16))) *
          (ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2 * (j : ℝ) / 8))) * T j)
    rw [hsplit, ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _), mul_assoc]
  have hBle : B ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) * Q := by
    rw [hB]
    refine sSup_le ?_
    rintro v ⟨j, hj, rfl⟩
    rw [hfg j]
    have hexp : -(s * (j : ℝ) / 16) ≤ -(s * (H : ℝ) / 16) := by
      have hHj : (H : ℝ) ≤ (j : ℝ) := by exact_mod_cast hj.le
      nlinarith
    have hmono : (3 : ℝ) ^ (-(s * (j : ℝ) / 16)) ≤ (3 : ℝ) ^ (-(s * (H : ℝ) / 16)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp
    have hgQ : g j ≤ Q := by rw [hQ]; exact le_sSup ⟨j, rfl⟩
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hmono) hgQ
  have hunion : {v : ENNReal | ∃ j : ℕ, v = f j} =
      {v | ∃ j, j ≤ H ∧ v = f j} ∪ {v | ∃ j, H < j ∧ v = f j} := by
    ext v
    simp only [Set.mem_setOf_eq, Set.mem_union]
    constructor
    · rintro ⟨j, rfl⟩
      rcases le_or_gt j H with hj | hj
      · exact Or.inl ⟨j, hj, rfl⟩
      · exact Or.inr ⟨j, hj, rfl⟩
    · rintro (⟨j, -, rfl⟩ | ⟨j, -, rfl⟩) <;> exact ⟨j, rfl⟩
  have hsup_union : sSup {v : ENNReal | ∃ j : ℕ, v = f j} = A ⊔ B := by
    rw [hunion, sSup_union]
  rw [hsup_union]
  rcases le_total A B with hAB | hAB
  · rw [sup_eq_right.mpr hAB]
    calc B - A ≤ B := tsub_le_self
      _ ≤ _ := hBle
  · rw [sup_eq_left.mpr hAB]
    calc A - A = 0 := tsub_self A
      _ ≤ _ := zero_le

theorem aux_lem_band_piece_product_Ktrunc_split (X : ℕ → ℝ) (hX : ∀ i, 0 ≤ X i) (a b : ℕ)
    (hab : a ≤ b) :
    sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc a (a + K), ENNReal.ofReal (Real.exp (X i))}
    ≤ (∏ i ∈ Finset.Icc a b, ENNReal.ofReal (Real.exp (X i))) *
      sSup {u : ENNReal | ∃ K : ℕ,
        u = ∏ i ∈ Finset.Icc (b + 1) (b + 1 + K), ENNReal.ofReal (Real.exp (X i))} := by
  refine sSup_le ?_
  rintro v ⟨K, rfl⟩
  have hsub : Finset.Icc a (a + K) ⊆ Finset.Icc a b ∪ Finset.Icc (b + 1) (b + 1 + K) := by
    intro i hi
    simp only [Finset.mem_Icc] at hi
    simp only [Finset.mem_union, Finset.mem_Icc]
    rcases le_or_gt i b with hib | hib
    · exact Or.inl ⟨hi.1, hib⟩
    · exact Or.inr ⟨hib, by omega⟩
  have hone : ∀ i ∈ Finset.Icc a b ∪ Finset.Icc (b + 1) (b + 1 + K),
      i ∉ Finset.Icc a (a + K) → (1 : ENNReal) ≤ ENNReal.ofReal (Real.exp (X i)) := by
    intro i _ _
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (Real.one_le_exp (hX i))
  have hstep1 : ∏ i ∈ Finset.Icc a (a + K), ENNReal.ofReal (Real.exp (X i)) ≤
      ∏ i ∈ Finset.Icc a b ∪ Finset.Icc (b + 1) (b + 1 + K), ENNReal.ofReal (Real.exp (X i)) :=
    Finset.prod_le_prod_of_subset_of_one_le' hsub hone
  have hdisj : Disjoint (Finset.Icc a b) (Finset.Icc (b + 1) (b + 1 + K)) := by
    rw [Finset.disjoint_left]
    intro i hi hi'
    simp only [Finset.mem_Icc] at hi hi'
    omega
  rw [Finset.prod_union hdisj] at hstep1
  refine hstep1.trans ?_
  gcongr
  exact le_sSup ⟨K, rfl⟩

theorem aux_lem_band_piece_product_lam_shifted_sum (m j H K : ℕ) (hjH : j ≤ H) :
    ∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), aux_psf_lam m j i ≤
      3 * ((3 : ℝ) ^ (H - j))⁻¹ := by
  unfold aux_psf_lam
  rw [← Finset.mul_sum]
  have h := aux_psf_geom_tail (m + H + 1) K
  have hc : (0 : ℝ) < 2 * (3 : ℝ) ^ (m + 1 + j) := by positivity
  have hstep : 2 * (3 : ℝ) ^ (m + 1 + j) *
      ∑ i ∈ Finset.Icc (m + H + 1) (m + H + 1 + K), ((3 : ℝ) ^ i)⁻¹ ≤
      2 * (3 : ℝ) ^ (m + 1 + j) * ((3 / 2) * ((3 : ℝ) ^ (m + H + 1))⁻¹) :=
    mul_le_mul_of_nonneg_left h hc.le
  refine hstep.trans ?_
  have hpow : (3 : ℝ) ^ (m + H + 1) = (3 : ℝ) ^ (m + 1 + j) * (3 : ℝ) ^ (H - j) := by
    rw [← pow_add]
    congr 1
    omega
  rw [hpow]
  have h3 : (0 : ℝ) < (3 : ℝ) ^ (m + 1 + j) := by positivity
  have h3' : (0 : ℝ) < (3 : ℝ) ^ (H - j) := by positivity
  field_simp
  norm_num

def aux_lem_band_piece_product_Tj (d : ℕ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) (j : ℕ) : ENNReal :=
  sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d (m + 1 + j) z ∧
    w = (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
        sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))}}

def aux_lem_band_piece_product_Praw (d : ℕ) (s' : ℝ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) : ENNReal :=
  sSup {v : ENNReal | ∃ j : ℕ,
    v = ENNReal.ofReal ((3 : ℝ) ^ (-(s' * (j : ℝ) / 8))) *
      aux_lem_band_piece_product_Tj d m z omega j}

theorem aux_lem_band_piece_product_le_of_discount_le (d : ℕ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) {s1 s2 : ℝ} (h12 : s1 ≤ s2) :
    aux_lem_band_piece_product_Praw d s2 m z omega ≤
      aux_lem_band_piece_product_Praw d s1 m z omega := by
  refine sSup_le ?_
  rintro v ⟨j, rfl⟩
  have hjnn : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
  have hmono : (3 : ℝ) ^ (-(s2 * (j : ℝ) / 8)) ≤ (3 : ℝ) ^ (-(s1 * (j : ℝ) / 8)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (by nlinarith)
  calc ENNReal.ofReal ((3 : ℝ) ^ (-(s2 * (j : ℝ) / 8))) *
        aux_lem_band_piece_product_Tj d m z omega j
      ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s1 * (j : ℝ) / 8))) *
        aux_lem_band_piece_product_Tj d m z omega j :=
        mul_le_mul_left (ENNReal.ofReal_le_ofReal hmono) _
    _ ≤ aux_lem_band_piece_product_Praw d s1 m z omega := le_sSup ⟨j, rfl⟩

theorem aux_lem_band_piece_product_bridge (d : ℕ) [NeZero d]
    (M : GMCModel d) (s eps : ℝ)
    (eta : ℕ → BilateralField d → PotentialSample d)
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (omega : BilateralField d) (N : ℕ)
    (hprim_one : primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (m : ℕ) (z : Vec d) :
    Praw N m z omega = aux_lem_band_piece_product_Praw d s m z (eta N omega) := by
  obtain ⟨-, -, -, -, -, hP, -, -, -, -, -⟩ := hprim_one
  exact hP m z

theorem aux_lem_band_piece_product_depth_bound (d : ℕ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) (s : ℝ) (hs : 0 < s) (H : ℕ) :
    aux_lem_band_piece_product_Praw d s m z omega -
      sSup {v : ENNReal | ∃ j : ℕ, j ≤ H ∧
        v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
          aux_lem_band_piece_product_Tj d m z omega j}
    ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
      aux_lem_band_piece_product_Praw d (s / 2) m z omega :=
  aux_lem_band_piece_product_depth_split s hs H (aux_lem_band_piece_product_Tj d m z omega)

theorem aux_lem_band_piece_product_min_le_sqrt_mul (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    min a b ≤ Real.sqrt (a * b) := by
  rw [Real.le_sqrt (le_min ha hb) (mul_nonneg ha hb)]
  rw [sq]
  exact mul_le_mul (min_le_left a b) (min_le_right a b) (le_min ha hb) ha

theorem aux_lem_band_piece_product_disorder_geometric_mean (Cp Cq delta rho : ℝ) (b : ℕ)
    (hCp : 0 ≤ Cp) (hCq : 0 ≤ Cq) (hdelta : 0 ≤ delta) (hrho : 0 ≤ rho) :
    min (Cp * delta ^ b) (Cq * rho) ≤
      2 * Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := by
  have hnonneg1 : 0 ≤ Cp * delta ^ b := mul_nonneg hCp (pow_nonneg hdelta b)
  have hnonneg2 : 0 ≤ Cq * rho := mul_nonneg hCq hrho
  have hmin_le_sqrt : min (Cp * delta ^ b) (Cq * rho) ≤
      Real.sqrt ((Cp * delta ^ b) * (Cq * rho)) :=
    aux_lem_band_piece_product_min_le_sqrt_mul (Cp * delta ^ b) (Cq * rho) hnonneg1 hnonneg2
  have hsqrt_eq : Real.sqrt ((Cp * delta ^ b) * (Cq * rho)) =
      Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := by
    rw [show (Cp * delta ^ b) * (Cq * rho) = (Cp * Cq) * (delta ^ b * rho) by ring,
      Real.sqrt_mul (mul_nonneg hCp hCq)]
  rw [hsqrt_eq] at hmin_le_sqrt
  calc min (Cp * delta ^ b) (Cq * rho)
      ≤ Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := hmin_le_sqrt
    _ ≤ 2 * (Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho)) :=
      le_mul_of_one_le_left (by positivity) (by norm_num : (1 : ℝ) ≤ 2)
    _ = 2 * Real.sqrt (Cp * Cq) * Real.sqrt (delta ^ b * rho) := by ring

theorem aux_lem_band_piece_product_err_case_split
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {mb : MeasurableSpace Ω}
    (X : Ω → ℝ) (x0 : ℝ) (Xtrunc : Ω → ℝ)
    (hXtruncmeas : AEStronglyMeasurable[mb] Xtrunc μ)
    (p : ℝ≥0∞) (Cq Cp delta rho : ℝ) (b : ℕ)
    (hCq : 0 ≤ Cq) (hCp : 0 ≤ Cp) (hdelta : 0 ≤ delta) (hrho : 0 ≤ rho)
    (hbase : eLpNorm (fun ω => X ω - x0) p μ ≤ ENNReal.ofReal (Cq * delta ^ b))
    (htrunc : eLpNorm (fun ω => X ω - Xtrunc ω) p μ ≤ ENNReal.ofReal (Cp * rho)) :
    ∃ Xband : Ω → ℝ, AEStronglyMeasurable[mb] Xband μ ∧
      eLpNorm (fun ω => X ω - Xband ω) p μ ≤
        ENNReal.ofReal (2 * Real.sqrt (Cq * Cp) * Real.sqrt (delta ^ b * rho)) := by
  rcases le_or_gt (Cq * delta ^ b) (Cp * rho) with hle | hlt
  · refine ⟨fun _ => x0, aestronglyMeasurable_const, hbase.trans (ENNReal.ofReal_le_ofReal ?_)⟩
    calc Cq * delta ^ b = min (Cq * delta ^ b) (Cp * rho) := (min_eq_left hle).symm
      _ ≤ 2 * Real.sqrt (Cq * Cp) * Real.sqrt (delta ^ b * rho) :=
        aux_lem_band_piece_product_disorder_geometric_mean Cq Cp delta rho b hCq hCp hdelta hrho
  · refine ⟨Xtrunc, hXtruncmeas, htrunc.trans (ENNReal.ofReal_le_ofReal ?_)⟩
    calc Cp * rho = min (Cq * delta ^ b) (Cp * rho) := (min_eq_right hlt.le).symm
      _ ≤ 2 * Real.sqrt (Cq * Cp) * Real.sqrt (delta ^ b * rho) :=
        aux_lem_band_piece_product_disorder_geometric_mean Cq Cp delta rho b hCq hCp hdelta hrho

theorem aux_lem_band_piece_product_eramp_abs_le (lo hi : ℝ) (hlo : 0 ≤ lo) (hlohi : lo < hi)
    {x y : ℝ≥0∞} (hx : x ≠ ⊤) (hy : y ≠ ⊤) :
    |(min (1 : ℝ≥0∞) ((x - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
      (min (1 : ℝ≥0∞) ((y - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal|
    ≤ (hi - lo)⁻¹ * |x.toReal - y.toReal| := by
  have hcpos : 0 < hi - lo := sub_pos.mpr hlohi
  have hval : ∀ (z : ℝ≥0∞), z ≠ ⊤ →
      (min (1 : ℝ≥0∞) ((z - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal
        = max (min 1 ((z.toReal - lo) / (hi - lo))) 0 := by
    intro z hz
    have hsub : z - ENNReal.ofReal lo = ENNReal.ofReal (z.toReal - lo) := by
      conv_lhs => rw [← ENNReal.ofReal_toReal hz]
      rw [← ENNReal.ofReal_sub z.toReal hlo]
    have hdiv : ENNReal.ofReal (z.toReal - lo) / ENNReal.ofReal (hi - lo)
        = ENNReal.ofReal ((z.toReal - lo) / (hi - lo)) :=
      (ENNReal.ofReal_div_of_pos hcpos).symm
    rw [hsub, hdiv, ← ENNReal.ofReal_one, ← ENNReal.ofReal_min, ENNReal.toReal_ofReal']
  rw [hval x hx, hval y hy]
  have h1 : |max (min 1 ((x.toReal - lo) / (hi - lo))) 0 -
        max (min 1 ((y.toReal - lo) / (hi - lo))) 0| ≤
      |min 1 ((x.toReal - lo) / (hi - lo)) - min 1 ((y.toReal - lo) / (hi - lo))| :=
    abs_max_sub_max_le_abs _ _ _
  have h2 : |min 1 ((x.toReal - lo) / (hi - lo)) - min 1 ((y.toReal - lo) / (hi - lo))| ≤
      |(x.toReal - lo) / (hi - lo) - (y.toReal - lo) / (hi - lo)| := by
    have h := abs_min_sub_min_le_max (1 : ℝ) ((x.toReal - lo) / (hi - lo)) 1
      ((y.toReal - lo) / (hi - lo))
    rwa [sub_self, abs_zero, max_eq_right (abs_nonneg _)] at h
  have h3 : |(x.toReal - lo) / (hi - lo) - (y.toReal - lo) / (hi - lo)|
      = (hi - lo)⁻¹ * |x.toReal - y.toReal| := by
    rw [div_sub_div_same,
      show (x.toReal - lo) - (y.toReal - lo) = x.toReal - y.toReal from by ring]
    rw [abs_div, abs_of_pos hcpos, div_eq_mul_inv, mul_comm]
  exact le_trans h1 (le_trans h2 (le_of_eq h3))

theorem aux_lem_band_piece_product_eramp_eLpNorm_le {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (p : ℝ≥0∞) (lo hi : ℝ) (hlo : 0 ≤ lo) (hlohi : lo < hi)
    (F G : Ω → ℝ≥0∞) (hF : ∀ᵐ ω ∂μ, F ω ≠ ⊤) (hG : ∀ᵐ ω ∂μ, G ω ≠ ⊤) :
    SubdiffusiveProcess.RawLp.eLpNorm (fun ω =>
        (min (1 : ℝ≥0∞) ((F ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
        (min (1 : ℝ≥0∞) ((G ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal) p μ ≤
      ENNReal.ofReal (hi - lo)⁻¹ * SubdiffusiveProcess.RawLp.eLpNorm (fun ω => (F ω).toReal - (G ω).toReal) p μ := by
  have hcpos : 0 < hi - lo := sub_pos.mpr hlohi
  have hae : ∀ᵐ ω ∂μ,
      ‖(min 1 ((F ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
        (min 1 ((G ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal‖
      ≤ (hi - lo)⁻¹ * |(F ω).toReal - (G ω).toReal| := by
    filter_upwards [hF, hG] with ω hFω hGω
    rw [Real.norm_eq_abs]
    exact aux_lem_band_piece_product_eramp_abs_le lo hi hlo hlohi hFω hGω
  let c : ℝ≥0 := ⟨(hi - lo)⁻¹, inv_nonneg.mpr hcpos.le⟩
  have hc : (c : ENNReal) = ENNReal.ofReal (hi - lo)⁻¹ := by
    exact (ENNReal.ofReal_coe_nnreal (p := c)).symm
  have hn : ∀ᵐ ω ∂μ,
      ‖(min 1 ((F ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
        (min 1 ((G ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal‖₊ ≤
      c * ‖(F ω).toReal - (G ω).toReal‖₊ := by
    filter_upwards [hae] with ω hω
    change ‖_‖₊ ≤ c * ‖_‖₊
    exact_mod_cast (show ‖_‖ ≤ (hi - lo)⁻¹ * ‖(F ω).toReal - (G ω).toReal‖ by
      rwa [Real.norm_eq_abs])
  rw [← hc]
  by_cases hp0 : p = 0
  · simp [SubdiffusiveProcess.RawLp.eLpNorm, hp0]
  by_cases hpt : p = ∞
  · simp only [SubdiffusiveProcess.RawLp.eLpNorm, ite_eq_right hp0, ite_eq_left hpt]
    simpa only [ENNReal.smul_def, smul_eq_mul] using
      eLpNormEssSup_le_nnreal_smul_eLpNormEssSup_of_ae_le_mul hn
  · simp only [SubdiffusiveProcess.RawLp.eLpNorm, ite_eq_right hp0, ite_eq_right hpt]
    simpa only [ENNReal.smul_def, smul_eq_mul] using
      eLpNorm'_le_nnreal_smul_eLpNorm'_of_ae_le_mul hn (ENNReal.toReal_pos hp0 hpt)

theorem aux_lem_band_piece_product_eramp_guarded_le {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} (p : ENNReal) (lo hi : ℝ) (hlo : 0 ≤ lo) (hlohi : lo < hi)
    (F G : Ω → ENNReal) (hF : ∀ᵐ ω ∂μ, F ω ≠ ∞) (hG : ∀ᵐ ω ∂μ, G ω ≠ ∞)
    (hFm : AEMeasurable F μ) (hGm : AEMeasurable G μ) :
    eLpNorm (fun ω =>
        (min (1 : ENNReal) ((F ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal -
        (min (1 : ENNReal) ((G ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal) p μ ≤
      ENNReal.ofReal (hi - lo)⁻¹ * eLpNorm (fun ω => (F ω).toReal - (G ω).toReal) p μ := by
  have hm (X : Ω → ENNReal) (hXm : AEMeasurable X μ) :
      AEStronglyMeasurable (fun ω =>
        (min (1 : ENNReal) ((X ω - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal) μ :=
    (aemeasurable_const.min ((hXm.sub aemeasurable_const).div aemeasurable_const)).ennreal_toReal.aestronglyMeasurable
  have h := aux_lem_band_piece_product_eramp_eLpNorm_le p lo hi hlo hlohi F G hF hG
  erw [SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded ((hm F hFm).sub (hm G hGm)),
    SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded (hFm.ennreal_toReal.sub hGm.ennreal_toReal).aestronglyMeasurable] at h
  exact h

theorem aux_lem_band_piece_product_baseline_Amaj_ge_one (d : ℕ) (m j : ℕ) (z : Vec d)
    (omega : PotentialSample d) :
    (1 : ENNReal) ≤ aux_psf_Amaj m z j omega := by
  unfold aux_psf_Amaj
  obtain ⟨k, hk⟩ := aux_psf_cells_nonempty d (m + 1 + j)
  have hterm : (1 : ENNReal) ≤ ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m - j) (m + j),
      aux_psf_cellObs i (aux_psf_center (m + 1 + j) z k) omega)) := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (Real.one_le_exp
      (Finset.sum_nonneg (fun i _ => aux_psf_cellObs_nonneg i _ omega)))
  exact hterm.trans (Finset.le_sup' (f := fun k => ENNReal.ofReal (Real.exp
    (∑ i ∈ Finset.Icc (m - j) (m + j),
      aux_psf_cellObs i (aux_psf_center (m + 1 + j) z k) omega))) hk)

theorem aux_lem_band_piece_product_baseline_Bmaj_ge_one (d : ℕ) (m j : ℕ) (z : Vec d)
    (omega : PotentialSample d) :
    (1 : ENNReal) ≤ aux_psf_Bmaj m z j omega := by
  unfold aux_psf_Bmaj
  have hnn : (0 : ℝ) ≤ ∑ i ∈ Finset.Icc (m + j) (m + j + 0),
      aux_psf_lam m j i * aux_psf_maxObs i (m + 1 + j) z omega :=
    Finset.sum_nonneg (fun i _ => mul_nonneg (aux_psf_lam_pos m j i).le
      (aux_psf_maxObs_nonneg i (m + 1 + j) z omega))
  have hterm : (1 : ENNReal) ≤ ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + j + 0),
      aux_psf_lam m j i * aux_psf_maxObs i (m + 1 + j) z omega)) := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (Real.one_le_exp hnn)
  exact hterm.trans (le_iSup (fun K : ℕ => ENNReal.ofReal (Real.exp
    (∑ i ∈ Finset.Icc (m + j) (m + j + K), aux_psf_lam m j i *
      aux_psf_maxObs i (m + 1 + j) z omega))) 0)

theorem aux_lem_band_piece_product_baseline_Tj_ge_two (d : ℕ) (m j : ℕ) (z : Vec d)
    (omega : PotentialSample d) :
    (2 : ENNReal) ≤ aux_lem_band_piece_product_Tj d m z omega j := by
  unfold aux_lem_band_piece_product_Tj
  have hA : (1 : ENNReal) ≤
      ∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i z|) := by
    rw [aux_psf_prod_ofReal_exp, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (Real.one_le_exp
      (Finset.sum_nonneg (fun i _ => abs_nonneg _)))
  have hB : (1 : ENNReal) ≤ sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := by
    have hmem0 : (∏ i ∈ Finset.Icc (m + j) (m + j + 0),
        ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))) ∈
        {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := ⟨0, rfl⟩
    have heq1 : (∏ i ∈ Finset.Icc (m + j) (m + j + 0),
        ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))) = 1 := by simp
    rw [← heq1]
    exact le_sSup hmem0
  have hsum : (2 : ENNReal) ≤
      (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i z|)) +
        sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := by
    have h2 : (2 : ENNReal) = 1 + 1 := by norm_num
    rw [h2]; exact add_le_add hA hB
  refine hsum.trans (le_sSup ⟨z, ?_, rfl⟩)
  rw [aux_psf_mem_translatedCube_iff]
  intro i
  simp only [sub_self, abs_zero]
  positivity

theorem aux_lem_band_piece_product_baseline_ge_two (d : ℕ) (s : ℝ) (m : ℕ) (z : Vec d)
    (omega : PotentialSample d) :
    (2 : ENNReal) ≤ aux_lem_band_piece_product_Praw d s m z omega := by
  have h0 := aux_lem_band_piece_product_baseline_Tj_ge_two d m 0 z omega
  have hcoeff : ENNReal.ofReal ((3 : ℝ) ^ (-(s * ((0 : ℕ) : ℝ) / 8))) = 1 := by
    have hz : -(s * ((0 : ℕ) : ℝ) / 8) = 0 := by push_cast; ring
    rw [hz, Real.rpow_zero, ENNReal.ofReal_one]
  unfold aux_lem_band_piece_product_Praw
  have hle : ENNReal.ofReal ((3 : ℝ) ^ (-(s * ((0 : ℕ) : ℝ) / 8))) *
      aux_lem_band_piece_product_Tj d m z omega 0 ≤
      sSup {v : ENNReal | ∃ j : ℕ, v = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        aux_lem_band_piece_product_Tj d m z omega j} := le_sSup ⟨0, rfl⟩
  rw [hcoeff, one_mul] at hle
  exact h0.trans hle

theorem aux_lem_band_piece_product_baseline_coeff_le_one_add (c X : ENNReal) (hc : c ≤ 1)
    (hX : 1 ≤ X) :
    c * X ≤ 1 + c * (X - 1) := by
  have e : X = 1 + (X - 1) := (add_tsub_cancel_of_le hX).symm
  calc c * X = c * (1 + (X - 1)) := by rw [← e]
    _ = c * 1 + c * (X - 1) := mul_add c 1 (X - 1)
    _ = c + c * (X - 1) := by rw [mul_one]
    _ ≤ 1 + c * (X - 1) := by gcongr

theorem aux_lem_band_piece_product_baseline_term_le (d : ℕ) (hd2 : 2 ≤ d) (s : ℝ) (hs0 : 0 ≤ s)
    (m j : ℕ) (z : Vec d) (omega : PotentialSample d) :
    ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) * aux_lem_band_piece_product_Tj d m z omega j ≤
      2 + ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_psf_Amaj m z j omega - 1) + (aux_psf_Bmaj m z j omega - 1)) := by
  have hdR : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast (by omega : 1 ≤ d)
  have hTle : aux_lem_band_piece_product_Tj d m z omega j ≤
      aux_psf_Amaj m z j omega + aux_psf_Bmaj m z j omega := aux_psf_Pterm_le hdR m z j omega
  have hA1 := aux_lem_band_piece_product_baseline_Amaj_ge_one d m j z omega
  have hB1 := aux_lem_band_piece_product_baseline_Bmaj_ge_one d m j z omega
  have hcle : ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ≤ 1 := by
    rw [← ENNReal.ofReal_one]
    refine ENNReal.ofReal_le_ofReal ?_
    have hjnn : (0 : ℝ) ≤ s * (j : ℝ) / 8 :=
      div_nonneg (mul_nonneg hs0 (Nat.cast_nonneg j)) (by norm_num)
    have hexp0 : -(s * (j : ℝ) / 8) ≤ 0 := by linarith
    calc (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) ≤ (3 : ℝ) ^ (0 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp0
      _ = 1 := Real.rpow_zero 3
  set c := ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) with hc_def
  have hstepA := aux_lem_band_piece_product_baseline_coeff_le_one_add c
    (aux_psf_Amaj m z j omega) hcle hA1
  have hstepB := aux_lem_band_piece_product_baseline_coeff_le_one_add c
    (aux_psf_Bmaj m z j omega) hcle hB1
  calc c * aux_lem_band_piece_product_Tj d m z omega j
      ≤ c * (aux_psf_Amaj m z j omega + aux_psf_Bmaj m z j omega) := mul_le_mul_right hTle c
    _ = c * aux_psf_Amaj m z j omega + c * aux_psf_Bmaj m z j omega := mul_add c _ _
    _ ≤ (1 + c * (aux_psf_Amaj m z j omega - 1)) + (1 + c * (aux_psf_Bmaj m z j omega - 1)) :=
        add_le_add hstepA hstepB
    _ = 2 + c * ((aux_psf_Amaj m z j omega - 1) + (aux_psf_Bmaj m z j omega - 1)) := by
        rw [show (2 : ENNReal) = 1 + 1 from by norm_num, mul_add]
        abel

theorem aux_lem_band_piece_product_baseline_reduction (d : ℕ) (hd2 : 2 ≤ d) (s : ℝ) (hs0 : 0 ≤ s)
    (m : ℕ) (z : Vec d) (omega : PotentialSample d) :
    aux_lem_band_piece_product_Praw d s m z omega ≤
      2 + ∑' j : ℕ, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_psf_Amaj m z j omega - 1) + (aux_psf_Bmaj m z j omega - 1)) := by
  unfold aux_lem_band_piece_product_Praw
  refine sSup_le ?_
  rintro v ⟨j, rfl⟩
  calc ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        aux_lem_band_piece_product_Tj d m z omega j
      ≤ 2 + ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
          ((aux_psf_Amaj m z j omega - 1) + (aux_psf_Bmaj m z j omega - 1)) :=
        aux_lem_band_piece_product_baseline_term_le d hd2 s hs0 m j z omega
    _ ≤ 2 + ∑' j' : ℕ, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j' : ℝ) / 8))) *
          ((aux_psf_Amaj m z j' omega - 1) + (aux_psf_Bmaj m z j' omega - 1)) := by
        gcongr
        exact ENNReal.le_tsum (f := fun j : ℕ => ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
          ((aux_psf_Amaj m z j omega - 1) + (aux_psf_Bmaj m z j omega - 1))) j

theorem aux_lem_band_piece_product_baseline_c1_exp_sub_one_le_mul_exp (x : ℝ) : Real.exp x - 1 ≤ x * Real.exp x := by
  have h := Real.add_one_le_exp (-x)
  have hxe : 0 < Real.exp x := Real.exp_pos x
  have h2 : (-x + 1) * Real.exp x ≤ Real.exp (-x) * Real.exp x :=
    mul_le_mul_of_nonneg_right h hxe.le
  rw [← Real.exp_add, neg_add_cancel, Real.exp_zero] at h2
  nlinarith

theorem aux_lem_band_piece_product_baseline_c1_rpow_le_const_mul_exp (q mu x : ℝ) (hq : 0 < q) (hmu : 0 < mu) (hx : 0 ≤ x) :
    x ^ q ≤ (q / (mu * Real.exp 1)) ^ q * Real.exp (mu * x) := by
  rcases eq_or_lt_of_le hx with hx0 | hxpos
  · rw [← hx0, Real.zero_rpow hq.ne']
    positivity
  · have hy : 0 < mu * x / q := by positivity
    have hlog : Real.log (mu * x / q) ≤ mu * x / q - 1 := Real.log_le_sub_one_of_pos hy
    have hqcancel : q * (mu * x / q) = mu * x := by field_simp
    have hmul : q * Real.log (mu * x / q) ≤ mu * x - q := by
      nlinarith [mul_le_mul_of_nonneg_left hlog hq.le, hqcancel]
    have hlogsplit : Real.log (mu * x / q) = Real.log mu + Real.log x - Real.log q := by
      rw [Real.log_div (by positivity) hq.ne', Real.log_mul hmu.ne' hxpos.ne']
    have hlogC : Real.log (q / (mu * Real.exp 1)) = Real.log q - Real.log mu - 1 := by
      rw [Real.log_div hq.ne' (by positivity), Real.log_mul hmu.ne' (Real.exp_pos 1).ne',
        Real.log_exp]
      ring
    have hkey : q * Real.log x ≤ q * Real.log (q / (mu * Real.exp 1)) + mu * x := by
      rw [hlogsplit] at hmul
      rw [hlogC]
      nlinarith [hmul]
    calc x ^ q = Real.exp (Real.log x * q) := by rw [Real.rpow_def_of_pos hxpos]
      _ ≤ Real.exp (Real.log (q / (mu * Real.exp 1)) * q + mu * x) := by
          refine Real.exp_le_exp.mpr ?_
          nlinarith [hkey]
      _ = Real.exp (Real.log (q / (mu * Real.exp 1)) * q) * Real.exp (mu * x) := Real.exp_add _ _
      _ = (q / (mu * Real.exp 1)) ^ q * Real.exp (mu * x) := by
          rw [← Real.rpow_def_of_pos (show (0:ℝ) < q / (mu * Real.exp 1) by positivity)]

theorem aux_lem_band_piece_product_baseline_c1_centered_rpow_le (A : ℝ) (hA : 1 ≤ A) (R mu : ℝ) (hR : 0 < R) (hmu : 0 < mu) :
    (A - 1) ^ R ≤ (R / (mu * Real.exp 1)) ^ R * A ^ (mu + R) := by
  have hA0 : 0 < A := lt_of_lt_of_le one_pos hA
  set x : ℝ := Real.log A with hxdef
  have hx0 : 0 ≤ x := Real.log_nonneg hA
  have hAeq : A = Real.exp x := (Real.exp_log hA0).symm
  have h1 : A - 1 ≤ x * A := by
    rw [hAeq]
    calc Real.exp x - 1 ≤ x * Real.exp x := aux_lem_band_piece_product_baseline_c1_exp_sub_one_le_mul_exp x
      _ = x * Real.exp x := rfl
  have hAnn : 0 ≤ A := hA0.le
  have h1' : (A - 1) ^ R ≤ (x * A) ^ R := by
    have hxA0 : 0 ≤ x * A := mul_nonneg hx0 hAnn
    have hA10 : 0 ≤ A - 1 := by linarith
    exact Real.rpow_le_rpow hA10 h1 hR.le
  have h2 : (x * A) ^ R = x ^ R * A ^ R := Real.mul_rpow hx0 hAnn
  have h3 : x ^ R ≤ (R / (mu * Real.exp 1)) ^ R * Real.exp (mu * x) :=
    aux_lem_band_piece_product_baseline_c1_rpow_le_const_mul_exp R mu x hR hmu hx0
  have h4 : Real.exp (mu * x) = A ^ mu := by
    rw [hAeq, Real.rpow_def_of_pos (Real.exp_pos x), Real.log_exp, mul_comm x mu]
  rw [h4] at h3
  calc (A - 1) ^ R ≤ (x * A) ^ R := h1'
    _ = x ^ R * A ^ R := h2
    _ ≤ ((R / (mu * Real.exp 1)) ^ R * A ^ mu) * A ^ R := by
        exact mul_le_mul_of_nonneg_right h3 (Real.rpow_nonneg hAnn R)
    _ = (R / (mu * Real.exp 1)) ^ R * A ^ (mu + R) := by
        rw [Real.rpow_add hA0]
        ring

theorem aux_lem_band_piece_product_baseline_c1_centered_ennreal_le (A : ENNReal) (hA1 : 1 ≤ A) (hAtop : A ≠ ⊤) (R mu : ℝ)
    (hR : 0 < R) (hmu : 0 < mu) :
    (A - 1) ^ R ≤ ENNReal.ofReal ((R / (mu * Real.exp 1)) ^ R) * A ^ (mu + R) := by
  have hAeq : A = ENNReal.ofReal A.toReal := (ENNReal.ofReal_toReal hAtop).symm
  have hAreal : (1 : ℝ) ≤ A.toReal := by
    have h := ENNReal.toReal_mono hAtop hA1
    simpa using h
  have hsub : A - 1 = ENNReal.ofReal (A.toReal - 1) := by
    conv_lhs => rw [hAeq]
    rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_sub _ (by norm_num : (0 : ℝ) ≤ 1)]
  rw [hsub, ENNReal.ofReal_rpow_of_nonneg (by linarith) hR.le]
