  obtain ⟨P, hP0, hPbound⟩ := aux_lem_band_T234_bank_eLpNorm_affine_nat_uniform (d := d) qnat hqnat1
  refine ⟨P, hP0, fun M eta heta N i n z => ?_⟩
  have hple : ENNReal.ofReal q ≤ ((2 * qnat : ℕ) : ENNReal) := by
    have h1 : q ≤ ((2 * qnat : ℕ):ℝ) := by push_cast; nlinarith
    calc ENNReal.ofReal q ≤ ENNReal.ofReal (((2*qnat:ℕ):ℕ):ℝ) := ENNReal.ofReal_le_ofReal h1
      _ = ((2*qnat:ℕ):ENNReal) := by
