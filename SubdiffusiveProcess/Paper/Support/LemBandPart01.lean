  have hf : Continuous (fun x : ℝ≥0∞ =>
      min (1 : ℝ≥0∞) ((x - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))) :=
    continuous_const.min
      ((ENNReal.continuous_div_const _ hne).comp (ENNReal.continuous_sub_right _))
  exact ENNReal.continuousOn_toReal.comp_continuous hf (fun x =>
    ne_top_of_lt (lt_of_le_of_lt (min_le_left _ _) ENNReal.one_lt_top))

