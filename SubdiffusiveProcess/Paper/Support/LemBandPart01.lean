      eLpNorm (fun omega : PotentialSample d => (3 : ℝ) ^ (-(s * (H : ℝ) / 16)) *
        (aux_lem_band_piece_product_Praw d (s / 2) m z omega).toReal)
      (ENNReal.ofReal p) M.P.toMeasure :=
    eLpNorm_mono_ae_real
      (((aux_lem_prefix_limit_actual_Psc_meas s m z).ennreal_toReal).sub
        (aux_lem_band_piece_product_trunc_W_meas d s m H z).ennreal_toReal).aestronglyMeasurable hf_le
  rw [show (fun omega : PotentialSample d => (3 : ℝ) ^ (-(s * (H : ℝ) / 16)) *
      (aux_lem_band_piece_product_Praw d (s / 2) m z omega).toReal) =
