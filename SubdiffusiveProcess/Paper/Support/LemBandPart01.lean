theorem aux_lem_band_piece_product_trunc_depth_bound (d : ℕ) (hd2 : 2 ≤ d) [NeZero d]
    (s : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1) (p : ℝ) (hp : 1 ≤ p) :
