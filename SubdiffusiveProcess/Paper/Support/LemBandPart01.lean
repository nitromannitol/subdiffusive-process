      ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (aux_prefix_praw_Amaj m j z omega) ^ (mu + R) := by
    intro omega
    have := aux_lem_band_piece_product_baseline_c1_centered_ennreal_le (aux_prefix_praw_Amaj m j z omega)
      (aux_lem_band_piece_product_baseline_c1_pAmaj_ge_one m j z omega) (aux_lem_band_piece_product_baseline_c1_pAmaj_ne_top m j z omega) R mu hR hmu
    rwa [hcoeff] at this
