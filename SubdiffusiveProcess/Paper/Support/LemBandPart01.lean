          have hrW_le : r ^ W ≤ 9 * (3 : ℝ) ^ (-(s / 4 * (h : ℝ))) := by
            have hrWeq : r ^ W = (3 : ℝ) ^ (-(s / 16) * ((W : ℝ))) := by
              rw [hr_def, ← Real.rpow_natCast ((3 : ℝ) ^ (-(s / 16))) W,
                ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
            rw [hrWeq, hWeq]
            have hmono : (3 : ℝ) ^ (-(s / 16) * (4 * (h : ℝ) + 4)) ≤ (3 : ℝ) ^ (-(s / 4 * (h : ℝ))) := by
              apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
              nlinarith [Nat.cast_nonneg (α := ℝ) h, hs]
            nlinarith [hmono, Real.rpow_nonneg (show (0 : ℝ) ≤ 3 by norm_num) (-(s / 4 * (h : ℝ)))]
          have hrpow_le : r ^ (W + 1) ≤ r * (9 * (3 : ℝ) ^ (-(s / 4 * (h : ℝ)))) := by
            rw [pow_succ']
            exact mul_le_mul_of_nonneg_left hrW_le hr0
          have hdiv_le : r ^ (W + 1) / (1 - r) ≤ (r * (9 * (3 : ℝ) ^ (-(s / 4 * (h : ℝ))))) / (1 - r) := by
            have hdpos : (0 : ℝ) < 1 - r := by linarith
            rw [div_eq_mul_inv, div_eq_mul_inv]
            exact mul_le_mul_of_nonneg_right hrpow_le (inv_nonneg.mpr hdpos.le)
          have hchain : Pbank * Csq * (r ^ (W + 1) / (1 - r)) ≤
              Pbank * Csq * ((r * (9 * (3 : ℝ) ^ (-(s / 4 * (h : ℝ))))) / (1 - r)) :=
            mul_le_mul_of_nonneg_left hdiv_le (by positivity)
          refine hchain.trans_eq ?_
          field_simp


theorem aux_lem_band_DT1_abs_sub_max_le (a b : ℝ) (ha : 0 ≤ a) :
    |a - max b 0| ≤ |a - b| := by
  rcases le_or_gt 0 b with hb | hb
  · rw [max_eq_left hb]
  · rw [max_eq_right hb.le, sub_zero, abs_of_nonneg ha,
      abs_of_pos (by linarith : (0:ℝ) < a - b)]
    linarith

def aux_lem_band_DT1_catalog (d k h : ℕ) : Finset (ℕ × (Fin d → ℤ)) :=
  aux_lem_band_DT1_retainedL k h ×ˢ aux_lem_band_gapD_T1index d h

theorem aux_lem_band_DT1_catalog_nonempty (d k h : ℕ) :
    (aux_lem_band_DT1_catalog d k h).Nonempty := by
  refine ⟨(k, fun _ => (0:ℤ)), ?_⟩
  rw [aux_lem_band_DT1_catalog, Finset.mem_product]
  refine ⟨aux_lem_band_DT1_mem_retainedL le_rfl (by omega), ?_⟩
  rw [aux_lem_band_gapD_T1index, Fintype.mem_piFinset]
  intro i
  rw [Finset.mem_Icc]
  exact ⟨neg_nonpos.mpr (by positivity), by positivity⟩

theorem aux_lem_band_DT1_catalog_card_le (d k h : ℕ) :
    (aux_lem_band_DT1_catalog d k h).card ≤ 3 ^ ((h + 1) * (d + 1)) := by
  rw [aux_lem_band_DT1_catalog, Finset.card_product]
  have h1 : (aux_lem_band_DT1_retainedL k h).card ≤ h + 1 := aux_lem_band_DT1_retainedL_card_le k h
  have h2 : (aux_lem_band_gapD_T1index d h).card ≤ (2 * 3 ^ h + 1) ^ d :=
    aux_lem_band_gapD_T1index_card_le d h
  have hstep : ∀ n : ℕ, n + 1 ≤ 3 ^ n := by
    intro n
    induction n with
    | zero => norm_num
    | succ m ih =>
        have : (3:ℕ) ^ (m + 1) = 3 * 3 ^ m := by ring
        omega
  have hgap_le : 2 * 3 ^ h + 1 ≤ 3 ^ (h + 1) := by
    have h3 : (1:ℕ) ≤ 3 ^ h := Nat.one_le_iff_ne_zero.mpr (pow_ne_zero h (by norm_num))
    have : (3:ℕ) ^ (h + 1) = 3 * 3 ^ h := by ring
    omega
  have hpow_le : (2 * 3 ^ h + 1) ^ d ≤ (3 ^ (h + 1)) ^ d := Nat.pow_le_pow_left hgap_le d
  have hcombine : (h + 1) * (2 * 3 ^ h + 1) ^ d ≤ 3 ^ (h + 1) * (3 ^ (h + 1)) ^ d := by
    have hh1 : h + 1 ≤ 3 ^ (h + 1) := le_trans (by omega) (hstep (h + 1))
    exact Nat.mul_le_mul hh1 hpow_le
  have hexp_eq : (3:ℕ) ^ (h + 1) * (3 ^ (h + 1)) ^ d = 3 ^ ((h + 1) * (d + 1)) := by
    rw [← pow_mul, ← pow_add]
    congr 1
    ring
  calc (aux_lem_band_DT1_retainedL k h).card * (aux_lem_band_gapD_T1index d h).card
      ≤ (h + 1) * (2 * 3 ^ h + 1) ^ d := Nat.mul_le_mul h1 h2
    _ ≤ 3 ^ (h + 1) * (3 ^ (h + 1)) ^ d := hcombine
    _ = 3 ^ ((h + 1) * (d + 1)) := hexp_eq

theorem aux_lem_band_DT1_aestronglyMeasurable_sup' {ι Ω : Type*} {m mΩ : MeasurableSpace Ω}
    {μ : Measure[mΩ] Ω} {s : Finset ι} (hs : s.Nonempty) {f : ι → Ω → ENNReal}
    (hf : ∀ i ∈ s, AEStronglyMeasurable[m] (f i) μ) :
    AEStronglyMeasurable[m] (s.sup' hs f) μ :=
  Finset.sup'_induction (p := fun f' => AEStronglyMeasurable[m] f' μ) hs _
    (fun _ hf1 _ hf2 => continuous_sup.comp_aestronglyMeasurable (hf1.prodMk hf2)) hf

theorem aux_lem_band_DT1_finmax_eLpNorm_le {ι Ω : Type*} {mΩ : MeasurableSpace Ω}
    {μ : Measure Ω} {S : Finset ι} (hS : S.Nonempty) {g : ι → Ω → ENNReal}
    (hgm : ∀ c ∈ S, AEMeasurable (g c) μ) (Q : ℝ) (hQ : 0 < Q)
    (B : ENNReal) (hg : ∀ c ∈ S, eLpNorm (g c) (ENNReal.ofReal Q) μ ≤ B) :
    eLpNorm (S.sup' hS g) (ENNReal.ofReal Q) μ ≤ (S.card : ENNReal) ^ (1 / Q) * B := by
  set p : ENNReal := ENNReal.ofReal Q with hp_def
  have hp0 : p ≠ 0 := by rw [hp_def]; exact (ENNReal.ofReal_pos.mpr hQ).ne'
  have hptop : p ≠ ∞ := ENNReal.ofReal_ne_top
  have hptoR : p.toReal = Q := ENNReal.toReal_ofReal hQ.le
  have hptwise : ∀ ω, (S.sup' hS g ω) ^ Q ≤ ∑ c ∈ S, (g c ω) ^ Q := by
    intro ω
    simp only [Finset.sup'_apply]
    have hcell : ∀ c ∈ S, g c ω ≤ (∑ c' ∈ S, (g c' ω) ^ Q) ^ (1 / Q) := by
      intro c hc
      have hsingle : g c ω ^ Q ≤ ∑ c' ∈ S, g c' ω ^ Q :=
        Finset.single_le_sum (f := fun c' => g c' ω ^ Q) (fun c' _ => zero_le) hc
      have hmono := ENNReal.rpow_le_rpow hsingle (by positivity : (0:ℝ) ≤ 1 / Q)
      rwa [← ENNReal.rpow_mul, mul_one_div, div_self hQ.ne', ENNReal.rpow_one] at hmono
    have hsup_le : (S.sup' hS fun a => g a ω) ≤ (∑ c' ∈ S, (g c' ω) ^ Q) ^ (1 / Q) :=
      Finset.sup'_le hS _ hcell
    have hmono2 := ENNReal.rpow_le_rpow hsup_le hQ.le
    rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hQ.ne', ENNReal.rpow_one] at hmono2
  have hlint_le : (∫⁻ ω, (S.sup' hS g ω) ^ Q ∂μ) ≤ ∫⁻ ω, ∑ c ∈ S, (g c ω) ^ Q ∂μ :=
    lintegral_mono hptwise
  have hlint_eq : (∫⁻ ω, ∑ c ∈ S, (g c ω) ^ Q ∂μ) = ∑ c ∈ S, ∫⁻ ω, (g c ω) ^ Q ∂μ :=
    lintegral_finset_sum' S (fun c hc =>
      (ENNReal.continuous_rpow_const.measurable).comp_aemeasurable (hgm c hc))
  have hterm_le : ∀ c ∈ S, (∫⁻ ω, (g c ω) ^ Q ∂μ) ≤ B ^ Q := by
    intro c hc
    have heLp := hg c hc
    have hraised := ENNReal.rpow_le_rpow heLp hQ.le
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop (hgm c hc).aestronglyMeasurable, hptoR] at hraised
    have heq : ((∫⁻ ω, ‖g c ω‖ₑ ^ Q ∂μ) ^ (1 / Q)) ^ Q = ∫⁻ ω, ‖g c ω‖ₑ ^ Q ∂μ := by
      rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hQ.ne', ENNReal.rpow_one]
    rw [heq] at hraised
    simpa using hraised
  have hsum_le : (∑ c ∈ S, ∫⁻ ω, (g c ω) ^ Q ∂μ) ≤ ∑ _c ∈ S, B ^ Q :=
    Finset.sum_le_sum hterm_le
  have hcard_eq : (∑ _c ∈ S, B ^ Q) = (S.card : ENNReal) * B ^ Q := by
    rw [Finset.sum_const, nsmul_eq_mul]
  have hfinal : (∫⁻ ω, (S.sup' hS g ω) ^ Q ∂μ) ≤ (S.card : ENNReal) * B ^ Q := by
    calc (∫⁻ ω, (S.sup' hS g ω) ^ Q ∂μ) ≤ ∫⁻ ω, ∑ c ∈ S, (g c ω) ^ Q ∂μ := hlint_le
      _ = ∑ c ∈ S, ∫⁻ ω, (g c ω) ^ Q ∂μ := hlint_eq
      _ ≤ ∑ _c ∈ S, B ^ Q := hsum_le
      _ = (S.card : ENNReal) * B ^ Q := hcard_eq
  have hraised2 := ENNReal.rpow_le_rpow hfinal (by positivity : (0:ℝ) ≤ 1 / Q)
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop
    (aux_lem_band_DT1_aestronglyMeasurable_sup' hS (fun c hc => (hgm c hc).aestronglyMeasurable)), hptoR]
  calc (∫⁻ ω, ‖S.sup' hS g ω‖ₑ ^ Q ∂μ) ^ (1 / Q)
      = (∫⁻ ω, (S.sup' hS g ω) ^ Q ∂μ) ^ (1 / Q) := by simp
    _ ≤ ((S.card : ENNReal) * B ^ Q) ^ (1 / Q) := hraised2
    _ = (S.card : ENNReal) ^ (1 / Q) * (B ^ Q) ^ (1 / Q) :=
        ENNReal.mul_rpow_of_nonneg _ _ (by positivity)
    _ = (S.card : ENNReal) ^ (1 / Q) * B := by
        rw [← ENNReal.rpow_mul, mul_one_div, div_self hQ.ne', ENNReal.rpow_one]

theorem aux_lem_band_DT1_sqrt_diff_eLpNorm_le {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}
    (g : Ω → ℝ) (q' bound : ℝ) (hq' : 0 < q') (hbound : 0 ≤ bound)
    (hg : SubdiffusiveProcess.RawLp.eLpNorm g (ENNReal.ofReal q') μ ≤ ENNReal.ofReal bound) :
    SubdiffusiveProcess.RawLp.eLpNorm (fun ω => (ENNReal.ofReal |g ω|) ^ (1 / 2 : ℝ)) (ENNReal.ofReal (2 * q')) μ ≤
      ENNReal.ofReal (Real.sqrt bound) := by
  have hp0 : ENNReal.ofReal (2 * q') ≠ 0 := (ENNReal.ofReal_pos.mpr (by positivity)).ne'
  have hq0 : ENNReal.ofReal q' ≠ 0 := (ENNReal.ofReal_pos.mpr hq').ne'
  have hkey : SubdiffusiveProcess.RawLp.eLpNorm (fun ω => (ENNReal.ofReal |g ω|) ^ (1 / 2 : ℝ))
      (ENNReal.ofReal (2 * q')) μ = SubdiffusiveProcess.RawLp.eLpNorm g (ENNReal.ofReal q') μ ^ (1 / 2 : ℝ) := by
    rw [SubdiffusiveProcess.RawLp.eLpNorm_eq_raw_integral hp0 ENNReal.ofReal_ne_top,
      SubdiffusiveProcess.RawLp.eLpNorm_eq_raw_integral hq0 ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ 2 * q'),
      ENNReal.toReal_ofReal hq'.le, ← ENNReal.rpow_mul]
    simp only [enorm_eq_self, ← ofReal_norm, Real.norm_eq_abs, ← ENNReal.rpow_mul]
    rw [show (1 / 2 : ℝ) * (2 * q') = q' by ring]
    congr 1
    field_simp
  rw [hkey]
  refine (ENNReal.rpow_le_rpow hg (by norm_num : (0 : ℝ) ≤ 1 / 2)).trans_eq ?_
  rw [Real.sqrt_eq_rpow]
  exact ENNReal.ofReal_rpow_of_nonneg hbound (by norm_num : (0 : ℝ) ≤ 1 / 2)

theorem aux_lem_band_DT1_sqrt_diff_guarded_le {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}
    (g : Ω → ℝ) (q' bound : ℝ) (hq' : 0 < q') (hbound : 0 ≤ bound)
    (hg : eLpNorm g (ENNReal.ofReal q') μ ≤ ENNReal.ofReal bound) :
    eLpNorm (fun ω => (ENNReal.ofReal |g ω|) ^ (1 / 2 : ℝ)) (ENNReal.ofReal (2 * q')) μ ≤
      ENNReal.ofReal (Real.sqrt bound) := by
  have hgm := aestronglyMeasurable_of_eLpNorm_ne_top (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hg)
  have hsm : AEStronglyMeasurable (fun ω => (ENNReal.ofReal |g ω|) ^ (1 / 2 : ℝ)) μ :=
    ENNReal.continuous_rpow_const.comp_aestronglyMeasurable
      (ENNReal.continuous_ofReal.comp_aestronglyMeasurable hgm.norm)
  have hraw := aux_lem_band_DT1_sqrt_diff_eLpNorm_le g q' bound hq' hbound
    ((SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded hgm).le.trans hg)
  erw [SubdiffusiveProcess.RawLp.eLpNorm_eq_guarded hsm] at hraw
  exact hraw


def aux_lem_band_DT1_cellTerm {d : ℕ} (s : ℝ) (k h : ℕ) (z : Vec d)
    (Jb : ℕ → Vec d → ℕ → BilateralField d → ℝ) (c : ℕ × (Fin d → ℤ))
    (omega : BilateralField d) : ENNReal := by
  classical
  exact if aux_lem_band_DT1_achF c.1 k z c.2 then
    ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (c.1 : ℝ)))) *
      (min (ENNReal.ofReal (max (Jb c.1 (aux_lem_band_gapD_T1point c.1 z c.2) (3 * (h + 1)) omega) 0)) 1)
        ^ (1 / 2 : ℝ)
  else 0

def aux_lem_band_DT1_diffTerm {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (k h : ℕ) (z : Vec d) (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (Jb : ℕ → Vec d → ℕ → BilateralField d → ℝ) (N : ℕ) (c : ℕ × (Fin d → ℤ))
    (omega : BilateralField d) : ENNReal :=
  ENNReal.ofReal
    (|(aux_lem_band_Jcell M c.1 (aux_lem_band_gapD_T1point c.1 z c.2) (eta N omega)).toReal -
      Jb c.1 (aux_lem_band_gapD_T1point c.1 z c.2) (3 * (h + 1)) omega|)

def aux_lem_band_DT1_T_E {d : ℕ} (s : ℝ) (k h : ℕ) (z : Vec d)
    (Jb : ℕ → Vec d → ℕ → BilateralField d → ℝ) (omega : BilateralField d) : ENNReal :=
  (aux_lem_band_DT1_catalog d k h).sup' (aux_lem_band_DT1_catalog_nonempty d k h)
    (fun c => aux_lem_band_DT1_cellTerm s k h z Jb c omega)

def aux_lem_band_DT1_CellErr {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (k h : ℕ) (z : Vec d) (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (Jb : ℕ → Vec d → ℕ → BilateralField d → ℝ) (N : ℕ) (omega : BilateralField d) : ENNReal :=
  (aux_lem_band_DT1_catalog d k h).sup' (aux_lem_band_DT1_catalog_nonempty d k h)
    (fun c => (aux_lem_band_DT1_diffTerm M k h z eta Jb N c omega) ^ (1 / 2 : ℝ))

theorem aux_lem_band_DT1_directionA {d : ℕ} [NeZero d] (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (s : ℝ) (hs : 0 < s) (k h : ℕ) (z : Vec d)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (Jb : ℕ → Vec d → ℕ → BilateralField d → ℝ) (N : ℕ) (omega : BilateralField d) :
    aux_lem_band_DT1 M s k z (eta N omega) ≤
      aux_lem_band_DT1_T_E s k h z Jb omega +
        (ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * (h : ℝ))) +
          aux_lem_band_DT1_CellErr M k h z eta Jb N omega) := by
  unfold aux_lem_band_DT1
  refine sSup_le ?_
  rintro v ⟨j, l, hjk, hlk, hlj, x, hgrid, hann, rfl⟩
  by_cases hret : l ∈ aux_lem_band_DT1_retainedL k h
  ·                                                
    have hxk : x - z ∈ cube d (k : ℤ) := by
      rcases eq_or_lt_of_le hjk with hjk' | hjk'
      · rw [hjk'] at hann; exact hann.1
      · exact aux_lem_band_DT1_cube_mono (by exact_mod_cast hjk'.le) hann.1
    obtain ⟨kidx, hkidx_mem, hxeq⟩ := aux_lem_band_gapD_T1point_mem l k hlk z x hgrid hxk
    have hkidx_mem' : kidx ∈ aux_lem_band_gapD_T1index d h :=
      aux_lem_band_gapD_T1index_mono d (aux_lem_band_DT1_retainedL_mem hret).2 hkidx_mem
    have hcmem : (l, kidx) ∈ aux_lem_band_DT1_catalog d k h := by
      rw [aux_lem_band_DT1_catalog, Finset.mem_product]
      exact ⟨hret, hkidx_mem'⟩
    have hachF : aux_lem_band_DT1_achF l k z kidx :=
      ⟨j, hlj, hjk, by rw [← hxeq]; exact hann⟩
    have hJcell_ne_top := aux_lem_band_DT1_Jcell_ne_top M l x (eta N omega)
    have hJcell_eq : aux_lem_band_Jcell M l x (eta N omega) =
        ENNReal.ofReal (aux_lem_band_Jcell M l x (eta N omega)).toReal :=
      (ENNReal.ofReal_toReal hJcell_ne_top).symm
    have hsqrt := aux_lem_band_DT1_sqrt_lipschitz
      (α := (aux_lem_band_Jcell M l x (eta N omega)).toReal)
      (β := max (Jb l x (3 * (h + 1)) omega) 0) ENNReal.toReal_nonneg
    have hclip := aux_lem_band_DT1_abs_sub_max_le
      (aux_lem_band_Jcell M l x (eta N omega)).toReal (Jb l x (3 * (h + 1)) omega)
      ENNReal.toReal_nonneg
    have hclip' : ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
        max (Jb l x (3 * (h + 1)) omega) 0| ≤
        ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
          Jb l x (3 * (h + 1)) omega| :=
      ENNReal.ofReal_le_ofReal hclip
    have hsqrt' : (min (ENNReal.ofReal (aux_lem_band_Jcell M l x (eta N omega)).toReal) 1)
        ^ (1 / 2 : ℝ) ≤
        (min (ENNReal.ofReal (max (Jb l x (3 * (h + 1)) omega) 0)) 1) ^ (1 / 2 : ℝ) +
        ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
          Jb l x (3 * (h + 1)) omega| ^ (1 / 2 : ℝ) :=
      hsqrt.trans (add_le_add le_rfl (ENNReal.rpow_le_rpow hclip' (by norm_num : (0:ℝ) ≤ 1/2)))
    have hscale_le_one : ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) ≤ 1 := by
      rw [← ENNReal.ofReal_one]
      refine ENNReal.ofReal_le_ofReal (Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) ?_)
      have hlk' : (l : ℝ) ≤ (k : ℝ) := by exact_mod_cast hlk
      nlinarith
    have hterm1_le : ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) *
        (min (ENNReal.ofReal (max (Jb l x (3 * (h + 1)) omega) 0)) 1) ^ (1 / 2 : ℝ) ≤
        aux_lem_band_DT1_T_E s k h z Jb omega := by
      have hcellterm_eq : aux_lem_band_DT1_cellTerm s k h z Jb (l, kidx) omega =
          ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) *
            (min (ENNReal.ofReal (max (Jb l x (3 * (h + 1)) omega) 0)) 1) ^ (1 / 2 : ℝ) := by
        dsimp only [aux_lem_band_DT1_cellTerm]
        rw [if_pos hachF, hxeq]
      rw [← hcellterm_eq]
      exact Finset.le_sup' (fun c => aux_lem_band_DT1_cellTerm s k h z Jb c omega) hcmem
    have hterm2_le : ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) *
        ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
          Jb l x (3 * (h + 1)) omega| ^ (1 / 2 : ℝ) ≤
        aux_lem_band_DT1_CellErr M k h z eta Jb N omega := by
      have hle : ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) *
          ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
            Jb l x (3 * (h + 1)) omega| ^ (1 / 2 : ℝ) ≤
          ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
            Jb l x (3 * (h + 1)) omega| ^ (1 / 2 : ℝ) := by
        calc ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) *
              ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
                Jb l x (3 * (h + 1)) omega| ^ (1 / 2 : ℝ)
            ≤ 1 * ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
                Jb l x (3 * (h + 1)) omega| ^ (1 / 2 : ℝ) :=
              mul_le_mul_left hscale_le_one _
          _ = ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
                Jb l x (3 * (h + 1)) omega| ^ (1 / 2 : ℝ) := one_mul _
      refine hle.trans ?_
      have hdiffterm_eq : aux_lem_band_DT1_diffTerm M k h z eta Jb N (l, kidx) omega =
          ENNReal.ofReal |(aux_lem_band_Jcell M l x (eta N omega)).toReal -
            Jb l x (3 * (h + 1)) omega| := by
        dsimp only [aux_lem_band_DT1_diffTerm]
        rw [← hxeq]
      rw [← hdiffterm_eq]
