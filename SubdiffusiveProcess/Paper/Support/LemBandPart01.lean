theorem aux_lem_band_T234_real_moment_bound (qnat : ℕ) (hqnat : 1 ≤ qnat) (b A B gap : ℝ)
    (hb0 : 0 ≤ b) (hA : 0 ≤ A) (hB : 0 ≤ B) (hble : b ≤ A + B * gap) :
    (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤ Real.sqrt 2 * Real.sqrt (A + B * gap) := by
