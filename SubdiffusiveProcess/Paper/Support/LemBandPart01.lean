theorem aux_lem_band_D_tsum_split (f : ℕ → ENNReal) (a : ℕ) :
    ∑' j, f j = (∑ j ∈ Finset.range (a + 1), f j) + ∑' j, (if a < j then f j else 0) := by
  have hzero : ∀ j ∉ Finset.range (a + 1), (if a < j then (0:ENNReal) else f j) = 0 := by
    intro j hj
    simp only [Finset.mem_range, not_lt] at hj
    have hlt : a < j := by omega
    simp [hlt]
  have hsplit : ∀ j, f j = (if a < j then (0:ENNReal) else f j) + (if a < j then f j else 0) := by
    intro j; by_cases hj : a < j <;> simp [hj]
  calc ∑' j, f j = ∑' j, ((if a < j then (0:ENNReal) else f j) + (if a < j then f j else 0)) := by
        simp_rw [← hsplit]
    _ = (∑' j, (if a < j then (0:ENNReal) else f j)) + ∑' j, (if a < j then f j else 0) :=
        ENNReal.tsum_add
    _ = (∑ j ∈ Finset.range (a + 1), f j) + ∑' j, (if a < j then f j else 0) := by
        congr 1
        rw [(hasSum_sum_of_ne_finset_zero hzero).tsum_eq]
        apply Finset.sum_congr rfl
        intro j hj
        simp only [Finset.mem_range] at hj
        have : ¬ (a < j) := by omega
        simp [this]

