  have heq : (fun omega : PotentialSample d =>
      (aux_lem_band_piece_product_Praw d (s / 2) m z omega).toReal) =
      (fun omega => ((aux_prefix_praw_PscF (s / 2) m z omega).toReal - 2) +
        (fun _ : PotentialSample d => (2 : ℝ)) omega) := by
