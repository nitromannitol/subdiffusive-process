theorem aux_lem_band_piece_product_trunc_eta_eq {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ (N i : ℕ),
      eta N omega i = aux_lem_crossing_unforget
        (SubdiffusiveProcess.layerScaling d (N : ℤ) (omega ((i : ℤ) - (N : ℤ)))) := by
  filter_upwards [heta] with omega hw N i
  have hf : SubdiffusiveProcess.layerScaling d (N : ℤ)
      (omega ((i : ℤ) - (N : ℤ))) = aux_lem_crossing_forget (eta N omega i) := by
    apply ContinuousMap.ext
    intro y
    simpa [SubdiffusiveProcess.layerScaling, aux_lem_crossing_forget] using
      (hw N i y).symm
  rw [hf, aux_lem_crossing_unforget_forget]

theorem aux_lem_band_piece_product_trunc_footprint
    (N m : ℕ) (n : ℤ) (H i : ℕ)
    (hn : n ≤ (N : ℤ)) (hm : m = ((N : ℤ) - n).toNat)
    (hi1 : m - H ≤ i) (hi2 : i ≤ m + H) :
    (i : ℤ) - (N : ℤ) ∈ Set.Icc (-n - (H : ℕ)) (-n + (H : ℕ)) := by
  have hNn_nonneg : (0 : ℤ) ≤ (N : ℤ) - n := by linarith
  have hm' : (m : ℤ) = (N : ℤ) - n := by rw [hm]; exact Int.toNat_of_nonneg hNn_nonneg
  simp only [Set.mem_Icc]
  omega

theorem aux_lem_band_piece_product_trunc_Pcand_measurable
    {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (s : ℝ) (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (N m : ℕ) (w : Vec d) (n : ℤ) (H : ℕ)
    (hn : n ≤ (N : ℤ)) (hm : m = ((N : ℤ) - n).toNat) :
    AEStronglyMeasurable[MeasurableSpace.comap
      (fun omega : BilateralField d =>
        fun j : Set.Icc (-n - (H : ℕ)) (-n + (H : ℕ)) => omega (j : ℤ))
      inferInstance]
      (fun omega : BilateralField d => aux_lem_band_piece_product_trunc_Pcand d s m w (eta N omega) H)
      (chaosSampleLaw M).toMeasure := by
  show AEStronglyMeasurable[MeasurableSpace.comap
      (aux_lem_band_piece_product_trunc_proj (d := d) n H) inferInstance]
    (fun omega : BilateralField d =>
      aux_lem_band_piece_product_trunc_Pcand d s m w (eta N omega) H)
    (chaosSampleLaw M).toMeasure
  have hGmeas : Measurable[MeasurableSpace.comap
      (aux_lem_band_piece_product_trunc_proj (d := d) n H) inferInstance]
      (aux_lem_band_piece_product_trunc_Gval s m N n H w ∘
        aux_lem_band_piece_product_trunc_proj (d := d) n H) :=
    (aux_lem_band_piece_product_trunc_Gval_measurable s m N n H w).comp
      (comap_measurable (aux_lem_band_piece_product_trunc_proj (d := d) n H))
  have hae : (fun omega : BilateralField d =>
        aux_lem_band_piece_product_trunc_Pcand d s m w (eta N omega) H) =ᵐ[(chaosSampleLaw M).toMeasure]
      (aux_lem_band_piece_product_trunc_Gval s m N n H w ∘
        aux_lem_band_piece_product_trunc_proj (d := d) n H) := by
    filter_upwards [aux_lem_band_piece_product_trunc_eta_eq M eta heta] with omega hw
    have hpf_eq : ∀ i : ℕ, (i : ℤ) - (N : ℤ) ∈ Set.Icc (-n - (H : ℕ)) (-n + (H : ℕ)) →
        eta N omega i =
          aux_lem_band_piece_product_trunc_reconstruct N n H
            (aux_lem_band_piece_product_trunc_proj n H omega) i := by
      intro i hmem
      unfold aux_lem_band_piece_product_trunc_reconstruct aux_lem_band_piece_product_trunc_extend
      rw [dif_pos hmem]
      exact hw N i
    have hPj_eq : ∀ j : ℕ, j ≤ H →
        aux_lem_band_piece_product_Pj d m w (eta N omega) H j =
        aux_lem_band_piece_product_Pj d m w
          (aux_lem_band_piece_product_trunc_reconstruct N n H
            (aux_lem_band_piece_product_trunc_proj n H omega)) H j := by
      intro j hjH
      set recon := aux_lem_band_piece_product_trunc_reconstruct N n H
        (aux_lem_band_piece_product_trunc_proj n H omega) with hrecondef
      have hfun_eq : ∀ x : Vec d,
          (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |eta N omega i x|)) +
              (∏ i ∈ Finset.Icc (m + j) (m + H),
                ENNReal.ofReal (Real.exp (4 * |eta N omega i x - eta N omega i w|))) =
            (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |recon i x|)) +
              (∏ i ∈ Finset.Icc (m + j) (m + H),
                ENNReal.ofReal (Real.exp (4 * |recon i x - recon i w|))) := by
        intro x
        have hAeq : (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |eta N omega i x|)) =
            (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |recon i x|)) := by
          refine Finset.prod_congr rfl (fun i hi => ?_)
          have hi1 : m - j ≤ i := (Finset.mem_Icc.mp hi).1
          have hi2 : i ≤ m + j := (Finset.mem_Icc.mp hi).2
          have hmem := aux_lem_band_piece_product_trunc_footprint N m n H i hn hm
            (by omega) (by omega)
          rw [hrecondef, hpf_eq i hmem]
        have hBeq : (∏ i ∈ Finset.Icc (m + j) (m + H),
            ENNReal.ofReal (Real.exp (4 * |eta N omega i x - eta N omega i w|))) =
            (∏ i ∈ Finset.Icc (m + j) (m + H),
              ENNReal.ofReal (Real.exp (4 * |recon i x - recon i w|))) := by
          refine Finset.prod_congr rfl (fun i hi => ?_)
          have hi1 : m + j ≤ i := (Finset.mem_Icc.mp hi).1
          have hi2 : i ≤ m + H := (Finset.mem_Icc.mp hi).2
          have hmem1 := aux_lem_band_piece_product_trunc_footprint N m n H i hn hm
            (by omega) (by omega)
          rw [hrecondef, hpf_eq i hmem1]
        rw [hAeq, hBeq]
      unfold aux_lem_band_piece_product_Pj
      congr 1
      ext w'
      simp only [Set.mem_setOf_eq]
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact ⟨x, hx, hfun_eq x⟩
      · rintro ⟨x, hx, rfl⟩
        exact ⟨x, hx, (hfun_eq x).symm⟩
    show aux_lem_band_piece_product_trunc_Pcand d s m w (eta N omega) H =
      aux_lem_band_piece_product_trunc_Gval s m N n H w
        (aux_lem_band_piece_product_trunc_proj n H omega)
    unfold aux_lem_band_piece_product_trunc_Pcand aux_lem_band_piece_product_trunc_Gval
    congr 1
    ext v
    simp only [Set.mem_setOf_eq]
    constructor
    · rintro ⟨j, hjH, rfl⟩
      exact ⟨j, hjH, by rw [hPj_eq j hjH]⟩
    · rintro ⟨j, hjH, rfl⟩
      exact ⟨j, hjH, by rw [hPj_eq j hjH]⟩
  exact hGmeas.aestronglyMeasurable.congr (hae.mono fun _ h => h.symm)

theorem aux_lem_band_piece_product_trunc_factor1_uniform (d : ℕ) [NeZero d] (M : GMCModel d)
    (m j H : ℕ) (hjH : j ≤ H) (z : Vec d) (p : ℝ) (hp : 1 ≤ p)
    (hcap : (18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 ≤ 1) :
    (∫⁻ omega, (ENNReal.ofReal (Real.exp (∑ i ∈ Finset.Icc (m + j) (m + H),
        aux_psf_lam m j i * aux_prefix_praw_bank i (m + 1 + j) z omega))) ^ (3 * p)
        ∂M.P.toMeasure) ≤
