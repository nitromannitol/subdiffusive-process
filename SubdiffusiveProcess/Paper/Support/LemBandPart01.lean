  set f : PotentialSample d → ℝ := fun omega =>
    (W omega).toReal - (aux_lem_band_piece_product_trunc_Pcand d s m z omega H).toReal with hfdef
  have hf_enorm_eq : ∀ᵐ omega ∂M.P.toMeasure, (‖f omega‖ₑ : ENNReal) =
