      _ = ∑' j : ℕ, (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1)) *
          (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
