theorem aux_lem_band_piece_product_baseline_c1_coeff_le_one_add (c X : ENNReal) (hc : c ≤ 1) (hX : 1 ≤ X) :
    c * X ≤ 1 + c * (X - 1) := by
  have e : X = 1 + (X - 1) := (add_tsub_cancel_of_le hX).symm
  calc c * X = c * (1 + (X - 1)) := by rw [← e]
    _ = c * 1 + c * (X - 1) := mul_add c 1 (X - 1)
    _ = c + c * (X - 1) := by rw [mul_one]
    _ ≤ 1 + c * (X - 1) := by gcongr

theorem aux_lem_band_piece_product_baseline_c1_term_le (hd : (1 : ℝ) ≤ (d : ℝ)) (s : ℝ) (hs0 : 0 ≤ s) (m j : ℕ) (z : Vec d)
    (omega : PotentialSample d) :
    ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
      sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d ((m : ℤ) + 1 + (j : ℤ)) z ∧
        w = (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
            sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
              ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))}} ≤
      2 + ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1)) := by
  have hTle := aux_prefix_praw_Pterm_le hd m j z omega
  have hA1 := aux_lem_band_piece_product_baseline_c1_pAmaj_ge_one m j z omega
  have hB1 := aux_lem_band_piece_product_baseline_c1_pBmaj_ge_one m j z omega
  have hcle : ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ≤ 1 := by
    rw [← ENNReal.ofReal_one]
    refine ENNReal.ofReal_le_ofReal ?_
    have hjnn : (0 : ℝ) ≤ s * (j : ℝ) / 8 :=
      div_nonneg (mul_nonneg hs0 (Nat.cast_nonneg j)) (by norm_num)
    have hexp0 : -(s * (j : ℝ) / 8) ≤ 0 := by linarith
    calc (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) ≤ (3 : ℝ) ^ (0 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp0
      _ = 1 := Real.rpow_zero 3
  set c := ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) with hc_def
  have hstepA := aux_lem_band_piece_product_baseline_c1_coeff_le_one_add c (aux_prefix_praw_Amaj m j z omega) hcle hA1
  have hstepB := aux_lem_band_piece_product_baseline_c1_coeff_le_one_add c (aux_prefix_praw_Bmaj m j z omega) hcle hB1
  calc c * sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d ((m : ℤ) + 1 + (j : ℤ)) z ∧
        w = (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
            sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
              ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))}}
      ≤ c * (aux_prefix_praw_Amaj m j z omega + aux_prefix_praw_Bmaj m j z omega) := by
        gcongr
    _ = c * aux_prefix_praw_Amaj m j z omega + c * aux_prefix_praw_Bmaj m j z omega := mul_add c _ _
    _ ≤ (1 + c * (aux_prefix_praw_Amaj m j z omega - 1)) +
        (1 + c * (aux_prefix_praw_Bmaj m j z omega - 1)) := add_le_add hstepA hstepB
    _ = 2 + c * ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1)) := by
        rw [show (2 : ENNReal) = 1 + 1 from by norm_num, mul_add]
        abel

theorem aux_lem_band_piece_product_baseline_c1_PscF_le_two_add_lR (hd : (1 : ℝ) ≤ (d : ℝ)) (s : ℝ) (hs0 : 0 ≤ s) (m : ℕ)
    (z : Vec d) (omega : PotentialSample d) (R : ℝ) (hR : 0 < R) :
    aux_prefix_praw_PscF s m z omega ≤ 2 +
      (∑' j : ℕ, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R)
        ^ (1 / R) := by
  set T : ENNReal := ∑' j : ℕ, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
    ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
    with hTdef
  unfold aux_prefix_praw_PscF
  refine sSup_le ?_
  rintro v ⟨j, rfl⟩
  refine (aux_lem_band_piece_product_baseline_c1_term_le hd s hs0 m j z omega).trans ?_
  gcongr
  set g : ENNReal := ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
    ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1)) with hgdef
  have hle : g ^ R ≤ T := by
    rw [hTdef]
    exact ENNReal.le_tsum (f := fun j : ℕ => (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
      ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R) j
  have h := ENNReal.rpow_le_rpow hle (by positivity : 0 ≤ 1 / R)
  simpa only [← ENNReal.rpow_mul, mul_one_div_cancel hR.ne', ENNReal.rpow_one] using h

theorem aux_lem_band_piece_product_baseline_c1_CB_bound (M : GMCModel d) (R' : ℝ) (hR' : 0 < R')
    (hbound : (6 * R' + 1) * aux_psf_sigma M ≤ 13) :
    aux_prefix_praw_CB M R' ≤ ((7 : ℝ) ^ d * (Real.exp (169 / 4) * 2)) ^ (3 / 2 : ℝ) := by
  unfold aux_prefix_praw_CB
  have hβ1 : (1 : ℝ) ≤
      (7 : ℝ) ^ d * (Real.exp ((6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4) * 2) := by
    have h7 : (1 : ℝ) ≤ (7 : ℝ) ^ d := one_le_pow₀ (by norm_num)
    have he : (1 : ℝ) ≤ Real.exp ((6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4) * 2 := by
      nlinarith [Real.one_le_exp
        (by positivity : (0 : ℝ) ≤ (6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)]
    nlinarith
  have hexp_le : 9 * R' / (6 * R' + 1) ≤ (3 / 2 : ℝ) := by
    rw [div_le_iff₀ (by positivity)]
    nlinarith
  have hσnn : 0 ≤ aux_psf_sigma M := (aux_psf_sigma_pos M).le
  have hsq_le : (6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 ≤ 169 := by
    have hnn : 0 ≤ (6 * R' + 1) * aux_psf_sigma M := by positivity
    have h := pow_le_pow_left₀ hnn hbound 2
    calc (6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 = ((6 * R' + 1) * aux_psf_sigma M) ^ 2 := by ring
      _ ≤ (13 : ℝ) ^ 2 := h
      _ = 169 := by norm_num
  have hbase_le : (7 : ℝ) ^ d * (Real.exp ((6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4) * 2) ≤
      (7 : ℝ) ^ d * (Real.exp (169 / 4) * 2) := by
    gcongr
  calc ((7 : ℝ) ^ d * (Real.exp ((6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4) * 2)) ^
        (9 * R' / (6 * R' + 1)) ≤
      ((7 : ℝ) ^ d * (Real.exp ((6 * R' + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4) * 2)) ^ (3 / 2 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le hβ1 hexp_le
    _ ≤ ((7 : ℝ) ^ d * (Real.exp (169 / 4) * 2)) ^ (3 / 2 : ℝ) :=
        Real.rpow_le_rpow (by positivity) hbase_le (by norm_num)

theorem aux_lem_band_piece_product_baseline_c1_Aterm_ratio_lt_one (d : ℕ) (s R : ℝ) (hsR : 32 * ((d : ℝ) + 1) ≤ s * R) :
    (3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d * (2 * Real.exp 1) ^ 2 < 1 := by
  have hE : (2 * Real.exp 1) ^ 2 < (81 : ℝ) := by
    have h1 : Real.exp 1 < 2.7182818286 := Real.exp_one_lt_d9
    nlinarith [Real.exp_pos 1]
  have hkey : (9 : ℝ) ^ d * 81 ≤ (3 : ℝ) ^ (s * R / 8) := by
    have heq : (9 : ℝ) ^ d * 81 = (3 : ℝ) ^ ((2 * d + 4 : ℕ) : ℝ) := by
      rw [Real.rpow_natCast, show (9 : ℝ) = 3 ^ 2 by norm_num, ← pow_mul,
        show (81 : ℝ) = 3 ^ 4 by norm_num, ← pow_add]
    rw [heq]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    push_cast
    nlinarith
  have hpos : (0 : ℝ) < (3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d := by positivity
  calc (3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d * (2 * Real.exp 1) ^ 2
      < (3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d * 81 := by nlinarith [hE, hpos]
    _ = (3 : ℝ) ^ (-(s * R / 8)) * ((9 : ℝ) ^ d * 81) := by ring
    _ ≤ (3 : ℝ) ^ (-(s * R / 8)) * (3 : ℝ) ^ (s * R / 8) := by
        gcongr
    _ = 1 := by rw [← Real.rpow_add (by norm_num)]; norm_num

theorem aux_lem_band_piece_product_baseline_c1_Aterm_le_geom (d : ℕ) (s R : ℝ) (j : ℕ) :
    (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
        ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * (2 * Real.exp 1) ^ (2 * j + 1)) ≤
      ((9 : ℝ) ^ d * (2 * Real.exp 1)) *
        ((3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d * (2 * Real.exp 1) ^ 2) ^ j := by
  set E : ℝ := 2 * Real.exp 1 with hEdef
  set r0 : ℝ := (3 : ℝ) ^ (-(s * R / 8)) with hr0
  set A : ℝ := (9 : ℝ) ^ d with hA
  have hE1 : 1 ≤ E := by
    have := Real.add_one_le_exp (1 : ℝ)
    rw [hEdef]; nlinarith
  have hA1 : 1 ≤ A := one_le_pow₀ (by norm_num)
  have hr00 : 0 ≤ r0 := by positivity
  have hdisc : (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) = r0 ^ j := by
    rw [hr0, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
    congr 1
    ring
  have hcard : (((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) ≤ A * A ^ j := by
    have hnat : (2 * 3 ^ (2 * j + 1) + 1) ^ d ≤ (9 ^ d) ^ (j + 1) := by
      have hb : 2 * 3 ^ (2 * j + 1) + 1 ≤ 9 ^ (j + 1) := by
        have h9 : 9 ^ (j + 1) = 3 * 3 ^ (2 * j + 1) := by
          rw [show (9 : ℕ) = 3 ^ 2 by norm_num, ← pow_mul,
            show 2 * (j + 1) = (2 * j + 1) + 1 by ring, pow_succ]
          ring
        rw [h9]
        have : 1 ≤ 3 ^ (2 * j + 1) := Nat.one_le_pow _ _ (by norm_num)
        omega
      calc (2 * 3 ^ (2 * j + 1) + 1) ^ d ≤ (9 ^ (j + 1)) ^ d := Nat.pow_le_pow_left hb d
        _ = (9 ^ d) ^ (j + 1) := by rw [← pow_mul, ← pow_mul, mul_comm]
    have hcast : (((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) ≤ (((9 ^ d) ^ (j + 1) : ℕ) : ℝ) := by
      exact_mod_cast hnat
    refine hcast.trans (le_of_eq ?_)
    rw [hA]
    push_cast
    rw [pow_succ]
    ring
  have hpowE : E ^ (2 * j + 1) = E * (E ^ 2) ^ j := by rw [pow_succ, pow_mul]; ring
  rw [hdisc]
  calc r0 ^ j * ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * E ^ (2 * j + 1)) ≤
      r0 ^ j * (A * A ^ j * E ^ (2 * j + 1)) := by gcongr
    _ = A * E * (r0 * A * E ^ 2) ^ j := by
        rw [hpowE, mul_pow, mul_pow]
        ring

theorem aux_lem_band_piece_product_baseline_c1_Aseries_le (d : ℕ) (s R : ℝ) (hsR : 32 * ((d : ℝ) + 1) ≤ s * R) :
    Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
        ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * (2 * Real.exp 1) ^ (2 * j + 1))) ∧
    (∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
        ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * (2 * Real.exp 1) ^ (2 * j + 1))) ≤
      ((9 : ℝ) ^ d * (2 * Real.exp 1)) *
        (1 - (3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d * (2 * Real.exp 1) ^ 2)⁻¹ := by
  set ρ : ℝ := (3 : ℝ) ^ (-(s * R / 8)) * (9 : ℝ) ^ d * (2 * Real.exp 1) ^ 2 with hρdef
  have hρ1 : ρ < 1 := aux_lem_band_piece_product_baseline_c1_Aterm_ratio_lt_one d s R hsR
  have hρ0 : 0 ≤ ρ := by positivity
  have hle : ∀ j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
      ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * (2 * Real.exp 1) ^ (2 * j + 1)) ≤
      ((9 : ℝ) ^ d * (2 * Real.exp 1)) * ρ ^ j := fun j => aux_lem_band_piece_product_baseline_c1_Aterm_le_geom d s R j
  have hsummable_geom : Summable (fun j : ℕ => ((9 : ℝ) ^ d * (2 * Real.exp 1)) * ρ ^ j) :=
    (summable_geometric_of_lt_one hρ0 hρ1).mul_left _
  have hnn : ∀ j : ℕ, 0 ≤ (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
      ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * (2 * Real.exp 1) ^ (2 * j + 1)) := by
    intro j; positivity
  have hsummable : Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
      ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * (2 * Real.exp 1) ^ (2 * j + 1))) :=
    Summable.of_nonneg_of_le hnn hle hsummable_geom
  refine ⟨hsummable, ?_⟩
  calc (∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
        ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * (2 * Real.exp 1) ^ (2 * j + 1))) ≤
      ∑' j : ℕ, ((9 : ℝ) ^ d * (2 * Real.exp 1)) * ρ ^ j :=
        hsummable.tsum_le_tsum hle hsummable_geom
    _ = ((9 : ℝ) ^ d * (2 * Real.exp 1)) * ∑' j : ℕ, ρ ^ j := tsum_mul_left
    _ = ((9 : ℝ) ^ d * (2 * Real.exp 1)) * (1 - ρ)⁻¹ := by rw [tsum_geometric_of_lt_one hρ0 hρ1]

theorem aux_lem_band_piece_product_baseline_c1_Bseries_le (s R : ℝ) (hs : 0 < s) (hR : 0 < R) (C : ℝ) (hC : 0 ≤ C) :
    Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * C) ∧
