          (Real.exp ((mu + R) ^ 2 * σ ^ 2 / 4) * 2) ^ (2 * j + 1)) := by
        gcongr
        exact aux_prefix_praw_Amaj_rpow_lintegral_real M m j z (mu + R)
    _ = _ := by rw [add_comm mu R]

