    (hAseries : (∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
        ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1))) ≤ SA)
    (hBsummable : Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj))
    (hBseries : (∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj) ≤ SB)
    (hC2def : C2 = 2 ^ (R - 1) * (R / Real.exp 1) ^ R * (SA + SB)) :
