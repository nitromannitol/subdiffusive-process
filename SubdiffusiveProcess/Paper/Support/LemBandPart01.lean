        ∂M.P.toMeasure) ≤ ENNReal.ofReal (C2 * aux_psf_sigma M ^ R) := by
  have hmeas : ∀ j : ℕ, AEMeasurable (fun omega : PotentialSample d =>
      (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
