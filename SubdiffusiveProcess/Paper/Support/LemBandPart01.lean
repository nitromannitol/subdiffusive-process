lemma aux_lem_band_DT1_entropy_bound (d k h : ℕ) (a Q C : ℝ)
    (ha : 0 < a) (hQ : 0 < Q) (hqa : ((d : ℝ) + 1) / a ≤ Q) (hC : 0 ≤ C) :
    ((aux_lem_band_DT1_catalog d k h).card : ℝ) ^ (1 / (2 * Q)) *
      Real.sqrt (C * (3 : ℝ) ^ (-(a * (3 * (h + 1) : ℕ)))) ≤
      Real.sqrt C * (3 : ℝ) ^ (-(a * h)) := by
  have hcard : ((aux_lem_band_DT1_catalog d k h).card : ℝ) ≤
      (3 : ℝ) ^ ((h + 1) * (d + 1)) := by
    exact_mod_cast aux_lem_band_DT1_catalog_card_le d k h
  have hmul : (d : ℝ) + 1 ≤ a * Q := by
    simpa [mul_comm] using (div_le_iff₀ ha).mp hqa
  have hr : ((d : ℝ) + 1) / (2 * Q) ≤ a / 2 := by
    apply (div_le_iff₀ (by positivity : 0 < 2 * Q)).mpr
    nlinarith
  have hcf : ((aux_lem_band_DT1_catalog d k h).card : ℝ) ^ (1 / (2 * Q)) ≤
      (3 : ℝ) ^ ((a / 2) * ((h : ℝ) + 1)) := by
    calc
      _ ≤ ((3 : ℝ) ^ ((h + 1) * (d + 1))) ^ (1 / (2 * Q)) :=
        Real.rpow_le_rpow (by positivity) hcard (by positivity)
      _ = (3 : ℝ) ^ ((((h : ℝ) + 1) * ((d : ℝ) + 1)) * (1 / (2 * Q))) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
        push_cast
        rfl
      _ ≤ _ := by
        apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
        have := mul_le_mul_of_nonneg_left hr (by positivity : 0 ≤ (h : ℝ) + 1)
        convert this using 1 <;> ring
  have hroot : Real.sqrt (C * (3 : ℝ) ^ (-(a * (3 * (h + 1) : ℕ)))) =
      Real.sqrt C * (3 : ℝ) ^ (-(3 * a / 2 * ((h : ℝ) + 1))) := by
    rw [Real.sqrt_mul hC]
    congr 1
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
    congr 1
    push_cast
    ring
  rw [hroot]
  calc
    _ ≤ (3 : ℝ) ^ ((a / 2) * ((h : ℝ) + 1)) *
        (Real.sqrt C * (3 : ℝ) ^ (-(3 * a / 2 * ((h : ℝ) + 1)))) :=
      mul_le_mul_of_nonneg_right hcf (by positivity)
    _ = Real.sqrt C * (3 : ℝ) ^ (-(a * ((h : ℝ) + 1))) := by
      rw [mul_left_comm, ← Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
      congr 2
      ring
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left _ (Real.sqrt_nonneg C)
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      nlinarith

theorem aux_lem_band_DT1_le_one {d : ℕ} [NeZero d] (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (s : ℝ) (hs : 0 < s) (k : ℕ) (z : Vec d)
