    rw [show -(s * (j : ℝ) * R / 8) = -(s * R / 8) * (j : ℝ) from by ring, mul_comm]
  have hsummable : Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * C) := by
    simp_rw [hterm]; exact (summable_geometric_of_lt_one hρ0 hρ1).mul_left _
  refine ⟨hsummable, ?_⟩
  simp_rw [hterm]
  rw [tsum_mul_left, tsum_geometric_of_lt_one hρ0 hρ1]

theorem aux_lem_band_piece_product_baseline_c1_Tj_ge_two (m j : ℕ) (z : Vec d) (omega : PotentialSample d) :
