  letI : Countable Catalog := Set.countable_coe_iff.mpr hCountable
  have hmesh := prop_gluing_smooth_mesh d hd z r hr h3r hcellsub alpha t ht htd S hS A hAcont hell
    Catalog hCatalog hCatalogBounds
