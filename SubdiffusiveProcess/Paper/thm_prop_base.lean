          (1 / 8 : ℝ) * (M - m) *
            ((volume q).toReal * (p ⬝ᵥ (prepared.AE jC om).mulVec p)) := by
  filter_upwards [affine.ellipticity] with om hell n zc havail hgood
  have hs := aux_thm_prop_cell_index_spec z r zc (aux_thm_prop_mass_side g.H1 n) havail
  have hsmall := hgood.2
