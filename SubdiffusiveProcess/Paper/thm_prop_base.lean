theorem aux_thm_prop_controlled_catalogue_package
    (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (h3r : 0 < 3 * r)
    (hcellsub : ∀ k : OddGridIndex d (triadicHalf 1),
