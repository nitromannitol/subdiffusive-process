    exact hQ.trans hq.symm
  exact aux_thm_prop_controlled_boundary_restriction BD BDQ EM hcontract
    zQ zq R r hR hr hqQ SQ Sq hSQ hSq
    (fun n => Lane4.cutoffPositiveCoefficient model H om (N n) zQ hR)
