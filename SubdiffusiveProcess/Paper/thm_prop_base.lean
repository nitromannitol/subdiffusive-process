      (aux_thm_prop_grid_side_pos g.H1 n) : Set (SpatialCoordinates d))).toReal
    (1 / 8) c0 m M (by norm_num) hc0 hmM
    (centeredCube_volume_pos zc (aux_thm_prop_grid_side_pos g.H1 n)) htr hcoer rfl hsmall p
