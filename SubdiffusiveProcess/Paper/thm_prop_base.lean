            (GE := GF) (GF := GE) (NE := NF) (NF := NE) hd cU⁻¹ cL⁻¹ := by
  obtain ⟨g, c0, deltaA, hc0, hdeltaA, hAffine⟩ := hUniformAffine
  obtain ⟨p, aexp, Cp, deltaC, hp, haexp, hCp, hdeltaC, hRate, hConc⟩ :=
