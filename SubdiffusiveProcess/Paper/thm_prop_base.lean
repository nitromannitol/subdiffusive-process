    (Cp * delta * gap) (fun Hb => Cp * delta * gap * (3 : ℝ) ^ (-aexp * (Hb : ℝ))) hscalar
  dsimp only at hout
  rw [hexp] at hout
  exact ⟨by simpa only [mul_assoc] using hout.2.2.1,
