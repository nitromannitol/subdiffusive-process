        (⇑(GE jQ om f) =ᵐ[volume.restrict
          (centeredCube (z jQ) (r jQ) (hr jQ) : Set (SpatialCoordinates d))] U) ∧
        aux_thm_prop_affine_error (centeredCube (z jQ) (r jQ) (hr jQ))
