      (ENNReal.ofReal p) P ≤ ENNReal.ofReal C ∧
    ∀ Hband : ℕ,
      eLpNorm (fun om => ∑ i : Fin d, ∑ j : Fin d,
        |B om i j - (P[fun om => B om i j | aux_thm_prop_scale_band field (H1 * n) Hband]) om|)
