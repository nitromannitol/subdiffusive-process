  exact hbound k n w
    (PhiH.restrict (oddGridCell z (3 * r) h3r (triadicHalf 1) k).isOpen (hcellsub k))
    hPhiH hw htrace

/-- All-radius growth remains valid when the exponent is lowered. -/
