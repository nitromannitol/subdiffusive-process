theorem aux_lem_band_rb_ulm_key
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : in_J d) (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (hr1 : r ≤ 1)
    (s : ℝ) (hs0 : 0 < s) (hs1 : s ≤ 1)
    (Q Cd Cqv dl p : ℝ) (hQ1 : 1 ≤ Q) (hpQ : p ≤ Q) (hDQ : 2 * (d : ℝ) ≤ s * Q)
    (hCd0 : 0 < Cd) (hCqv0 : 0 < Cqv)
    (hdlnn : 0 ≤ dl)
    (hcondA : Cd * (Q + Q ^ 2) * dl ^ 2 ≤ (s / 4) * Real.log 3)
    (hcondB : Cd * dl * (1 + dl) ≤ s * Real.log 3)
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (N : ℕ)
    (hYmeasN : ∀ n : ℕ, AEStronglyMeasurable (fun om =>
        Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
          (Homogenization.originCube d 0) (-(n : ℤ))
          (E.chart z r hr (cutoffPositiveCoefficient M H om N z hr) z r))
        (chaosSampleLaw M).toMeasure)
    (hYboundN : ∀ n : ℕ, eLpNorm (fun om =>
        Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
          (Homogenization.originCube d 0) (-(n : ℤ))
          (E.chart z r hr (cutoffPositiveCoefficient M H om N z hr) z r))
        (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Cqv * (if n ≤ N then (3 : ℝ) ^ ((d : ℝ) * (n : ℝ) / Q) *
            Real.exp (Cd * (Q + Q ^ 2) * dl ^ 2 * (n : ℝ))
          else Real.exp ((Cd * dl + Cd * dl ^ 2) * (N : ℝ))))) :
    MemLp (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ∧
    eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal
      ((1 - (3 : ℝ) ^ (-s)) * Cqv /
          (1 - Real.exp (-(s / 2) * Real.log 3 + Cd * (Q + Q ^ 2) * dl ^ 2)) +
        (1 - (3 : ℝ) ^ (-s)) * Cqv * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s))) := by
  have hQpge : ENNReal.ofReal p ≤ ENNReal.ofReal Q := ENNReal.ofReal_le_ofReal hpQ
  set YN : ℕ → BilateralField d → ℝ := fun n om =>
    Homogenization.Book.Ch02.maxDescendantSigmaStarInvMatrixNormAtScale
      (Homogenization.originCube d 0) (-(n : ℤ))
      (E.chart z r hr (cutoffPositiveCoefficient M H om N z hr) z r) with hYN_def
  have hYNnn : ∀ n om, 0 ≤ YN n om := fun n om => aux_lane4_lambda_inv_moments_Y_nonneg _ _
  obtain ⟨hMemLpQ, hBoundQ, hSummableAE⟩ :=
    aux_lane4_lambda_inv_moments_series_bound (chaosSampleLaw M).toMeasure s (d : ℝ) Q
      Cd Cqv dl N hs0 (Nat.cast_nonneg d) hDQ hQ1 hCd0 hCqv0
      hdlnn hcondA hcondB YN hYNnn hYmeasN hYboundN
  have hae_dom : ∀ᵐ om ∂(chaosSampleLaw M).toMeasure,
      (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹ ≤
        ∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight s 1 n * YN n om := by
    filter_upwards [hSummableAE] with om hom_summable
    obtain ⟨Ssum0, hSsum0nn, hsqrt_summable, hSsum0eq, hlam_inv_eq⟩ :=
      aux_lane4_lambda_inv_moments_lam_inv_eq E z r hr (cutoffPositiveCoefficient M H om N z hr)
        s hs0 hs1
    have hYnn' : ∀ n : ℕ, 0 ≤ YN n om := fun n => hYNnn n om
    have hcs := aux_lane4_lambda_inv_moments_cs hs0 0 (fun n => YN n om) hYnn'
      (by simpa using hsqrt_summable) (by simpa using hom_summable)
    simp only [Finset.range_zero, Finset.sum_empty, zero_add, Nat.add_zero] at hcs
    rw [hlam_inv_eq, hSsum0eq]
    exact hcs
  have hsqrt_summable_all : ∀ om : BilateralField d, Summable (fun n : ℕ =>
      Homogenization.Book.Ch02.geometricWeight s 1 n * Real.rpow (YN n om) (1 / 2)) := by
    intro om
    obtain ⟨_, _, hs', _, _⟩ := aux_lane4_lambda_inv_moments_lam_inv_eq E z r hr
      (cutoffPositiveCoefficient M H om N z hr) s hs0 hs1
    exact hs'
  have hSsum_meas : AEStronglyMeasurable (fun om => ∑' n : ℕ,
      Homogenization.Book.Ch02.geometricWeight s 1 n * Real.rpow (YN n om) (1 / 2))
      (chaosSampleLaw M).toMeasure :=
    aux_lane4_lambda_inv_moments_Ssum_meas (chaosSampleLaw M).toMeasure s YN hYmeasN
      hsqrt_summable_all
  have hlam_inv_meas : AEStronglyMeasurable (fun om : BilateralField d =>
      (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (chaosSampleLaw M).toMeasure := by
    have heq : (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹) =
        (fun om => (∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight s 1 n *
          Real.rpow (YN n om) (1 / 2)) ^ 2) := by
      funext om
      obtain ⟨Ssum0, _, _, hSsum0eq, hlam_inv_eq⟩ := aux_lane4_lambda_inv_moments_lam_inv_eq E z r hr
        (cutoffPositiveCoefficient M H om N z hr) s hs0 hs1
      rw [hlam_inv_eq, hSsum0eq]
    rw [heq]
    exact (continuous_pow 2).comp_aestronglyMeasurable hSsum_meas
  have hlam_nn : ∀ om : BilateralField d, 0 ≤
      (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹ := fun om =>
    le_of_lt (inv_pos.mpr (E.lam_pos _ _ _ _ _ _ _ _))
  have heLpNorm_le : eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure ≤
      eLpNorm (fun om => ∑' n : ℕ, Homogenization.Book.Ch02.geometricWeight s 1 n * YN n om)
        (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure := by
    apply eLpNorm_mono_ae_real
    filter_upwards [hae_dom] with om hom
    rwa [Real.norm_of_nonneg (hlam_nn om)]
  have heLpNorm_final : eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      eLpNorm (fun om : BilateralField d =>
          (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
        (ENNReal.ofReal Q) (chaosSampleLaw M).toMeasure :=
    eLpNorm_le_eLpNorm_of_exponent_le hQpge hlam_inv_meas
  have hfinal_bound : eLpNorm (fun om : BilateralField d =>
        (E.lam z r hr (cutoffPositiveCoefficient M H om N z hr) z r s 1)⁻¹)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal
      ((1 - (3 : ℝ) ^ (-s)) * Cqv /
          (1 - Real.exp (-(s / 2) * Real.log 3 + Cd * (Q + Q ^ 2) * dl ^ 2)) +
        (1 - (3 : ℝ) ^ (-s)) * Cqv * (3 : ℝ) ^ (-s) / (1 - (3 : ℝ) ^ (-s))) :=
    heLpNorm_final.trans (heLpNorm_le.trans hBoundQ)
  exact ⟨⟨hlam_inv_meas, hfinal_bound.trans_lt ENNReal.ofReal_lt_top⟩, hfinal_bound⟩

theorem aux_lem_band_rem_bank_uniform_neumann_growth_Kbound
    (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (p PC Cres ClamF6p Dr Cp : ℝ)
    (hp : 2 ≤ p) (hDr : 0 ≤ Dr) (hCp0 : 0 ≤ Cp)
    (hCpdef : Cp = max (max Cres (PC ^ 2 * ClamF6p)) 0)
    (Kres Lam : ℕ → BilateralField d → ℝ)
    (hKresMem : ∀ N, MemLp (Kres N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure)
    (hKresBd : ∀ N, eLpNorm (Kres N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal Cres)
    (hLamMem' : ∀ N, MemLp (Lam N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure)
    (hLamBd' : ∀ N, eLpNorm (Lam N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ClamF6p) :
    ∀ N, MemLp (fun om => Dr ^ 2 * (Kres N om * (1 + PC ^ 2 * Lam N om)))
        (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun om => Dr ^ 2 * (Kres N om * (1 + PC ^ 2 * Lam N om)))
        (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (Dr ^ 2 * (Cp * (1 + Cp))) := by
  have hq1 : (1 : ℝ) ≤ 3 * p := by linarith
  intro N
  have hV : MemLp (fun om => PC ^ 2 * Lam N om) (ENNReal.ofReal (2 * (3 * p)))
      (chaosSampleLaw M).toMeasure := (hLamMem' N).const_mul _
  have hUb : eLpNorm (Kres N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal Cp := by
    refine (hKresBd N).trans ?_
    rw [hCpdef]
    exact ENNReal.ofReal_le_ofReal ((le_max_left _ _).trans (le_max_left _ _))
  have hVb : eLpNorm (fun om => PC ^ 2 * Lam N om) (ENNReal.ofReal (2 * (3 * p)))
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Cp := by
    have hs1 :
        eLpNorm (fun om => PC ^ 2 * Lam N om) (ENNReal.ofReal (2 * (3 * p)))
            (chaosSampleLaw M).toMeasure ≤
          ‖PC ^ 2‖ₑ * eLpNorm (Lam N) (ENNReal.ofReal (2 * (3 * p)))
            (chaosSampleLaw M).toMeasure :=
      eLpNorm_const_smul_le (c := PC ^ 2) (f := Lam N) (p := ENNReal.ofReal (2 * (3 * p)))
        (μ := (chaosSampleLaw M).toMeasure)
    have hs2 :
        ‖PC ^ 2‖ₑ * eLpNorm (Lam N) (ENNReal.ofReal (2 * (3 * p))) (chaosSampleLaw M).toMeasure ≤
          ‖PC ^ 2‖ₑ * ENNReal.ofReal ClamF6p :=
      mul_le_mul_left' (hLamBd' N) _
    have hs3 : ‖PC ^ 2‖ₑ * ENNReal.ofReal ClamF6p = ENNReal.ofReal (PC ^ 2 * ClamF6p) := by
      rw [Real.enorm_eq_ofReal (by positivity)]
      exact (ENNReal.ofReal_mul (by positivity)).symm
    have hs4 : ENNReal.ofReal (PC ^ 2 * ClamF6p) ≤ ENNReal.ofReal Cp := by
      rw [hCpdef]
      exact ENNReal.ofReal_le_ofReal ((le_max_right _ _).trans (le_max_left _ _))
    exact ((hs1.trans hs2).trans_eq hs3).trans hs4
  obtain ⟨hUVmem, hUVb⟩ := aux_rem_resolved_UV_moment (chaosSampleLaw M).toMeasure (3 * p) Cp
    hq1 hCp0 (Kres N) (fun om => PC ^ 2 * Lam N om) (hKresMem N) hV hUb hVb
  refine ⟨hUVmem.const_mul (Dr ^ 2), ?_⟩
  have ht1 :
      eLpNorm (fun om => Dr ^ 2 * (Kres N om * (1 + PC ^ 2 * Lam N om)))
          (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
        ‖Dr ^ 2‖ₑ * eLpNorm (fun om => Kres N om * (1 + PC ^ 2 * Lam N om))
          (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure :=
    eLpNorm_const_smul_le (c := Dr ^ 2) (f := fun om => Kres N om * (1 + PC ^ 2 * Lam N om))
      (p := ENNReal.ofReal (3 * p)) (μ := (chaosSampleLaw M).toMeasure)
  have ht2 :
      ‖Dr ^ 2‖ₑ * eLpNorm (fun om => Kres N om * (1 + PC ^ 2 * Lam N om))
          (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
        ‖Dr ^ 2‖ₑ * ENNReal.ofReal (Cp * (1 + Cp)) :=
    mul_le_mul_left' hUVb _
  have ht3 : ‖Dr ^ 2‖ₑ * ENNReal.ofReal (Cp * (1 + Cp)) =
      ENNReal.ofReal (Dr ^ 2 * (Cp * (1 + Cp))) := by
    rw [Real.enorm_eq_ofReal (by positivity)]
    exact (ENNReal.ofReal_mul (by positivity)).symm
  exact (ht1.trans ht2).trans_eq ht3

theorem aux_lem_band_rrpack_neumann_growth
    (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (t Cresp p : ℝ)
    (rho : ℝ → ℝ) (pvec : Fin d → ℝ)
    (delta0 : ℝ) (hδ0 : 0 < delta0) (B13 : ℝ) (hB13 : 0 ≤ B13)
    (hmain : ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : in_6_16 d M) (It : in_iteration d M E Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        ∃ K13 : ℕ → BilateralField d → ℝ,
          (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N, 0 ≤ K13 N omega ∧
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
              ∀ v : meanZeroSobolevGraph (unitNeumannCube d),
                SolvesNeumann (cutoffPositiveCoefficient M H omega N
                    (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) (faceBump rho pvec eps) v →
                ∀ x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)), ∀ rad : ℝ,
                  0 < rad → rad ≤ 1 →
                  localGradientEnergy (cutoffPositiveCoefficient M H omega N
                      (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
                    (show MeasurableSet (Metric.ball x rad ∩
                        (unitNeumannCube d : Set (SpatialCoordinates d))) from
                      (Metric.isOpen_ball.inter (unitNeumannCube d).isOpen).measurableSet)
                    (sobolevGradient v.val) ≤
                    K13 N omega * eps ^ (-2 : ℝ) * rad ^ t)) ∧
          (∀ N, MemLp (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ∧
            eLpNorm (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
              ENNReal.ofReal B13)) :
    ∃ delta0 : ℝ, 0 < delta0 ∧ ∃ B13 : ℝ, 0 ≤ B13 ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : in_6_16 d M) (It : in_iteration d M E Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        ∃ K13 : ℕ → BilateralField d → ℝ,
          (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N, 0 ≤ K13 N omega ∧
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
              ∀ v : meanZeroSobolevGraph (unitNeumannCube d),
                SolvesNeumann (cutoffPositiveCoefficient M H omega N
                    (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) (faceBump rho pvec eps) v →
                ∀ x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)), ∀ rad : ℝ,
                  0 < rad → rad ≤ 1 →
                  localGradientEnergy (cutoffPositiveCoefficient M H omega N
                      (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
                    (show MeasurableSet (Metric.ball x rad ∩
                        (unitNeumannCube d : Set (SpatialCoordinates d))) from
                      (Metric.isOpen_ball.inter (unitNeumannCube d).isOpen).measurableSet)
                    (sobolevGradient v.val) ≤
                    K13 N omega * eps ^ (-2 : ℝ) * rad ^ t)) ∧
          (∀ N, MemLp (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ∧
            eLpNorm (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
              ENNReal.ofReal B13) :=
  ⟨delta0, hδ0, B13, hB13, hmain⟩

theorem aux_lem_band_rem_bank_uniform_neumann_growth
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (P : Paper.in_poincare d hd E) (X : Paper.in_extension d hd E)
    (W : SubdiffusiveProcess.Lane4.SmallPerturbationInput d)
    (D : @lane4_deterministic_good_scale_input d
      ⟨Nat.ne_of_gt (lt_of_lt_of_le (by decide) hd)⟩)
    (t : ℝ) (ht0 : (d : ℝ) - 1 < t) (ht1 : t < (d : ℝ))
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (p : ℝ) (hp : 2 ≤ p)
    (rho : ℝ → ℝ) (hrho : ContDiff ℝ ∞ rho) (hrho0 : ∀ v : ℝ, 0 ≤ rho v)
    (hrhos : ∀ v : ℝ, v ∉ Set.Ioo (1 : ℝ) 2 → rho v = 0) (hrhoi : (∫ v, rho v) = 1)
    (pvec : Fin d → ℝ) (hpvec : (∑ i : Fin d, (pvec i) ^ 2) = 1) :
    ∃ delta0 : ℝ, 0 < delta0 ∧ ∃ B13 : ℝ, 0 ≤ B13 ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : in_6_16 d M) (It : in_iteration d M E Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        ∃ K13 : ℕ → BilateralField d → ℝ,
          (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N, 0 ≤ K13 N omega ∧
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
              ∀ v : meanZeroSobolevGraph (unitNeumannCube d),
                SolvesNeumann (cutoffPositiveCoefficient M H omega N
                    (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) (faceBump rho pvec eps) v →
                ∀ x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)), ∀ rad : ℝ,
                  0 < rad → rad ≤ 1 →
                  localGradientEnergy (cutoffPositiveCoefficient M H omega N
                      (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
                    (show MeasurableSet (Metric.ball x rad ∩
                        (unitNeumannCube d : Set (SpatialCoordinates d))) from
                      (Metric.isOpen_ball.inter (unitNeumannCube d).isOpen).measurableSet)
                    (sobolevGradient v.val) ≤
                    K13 N omega * eps ^ (-2 : ℝ) * rad ^ t)) ∧
          (∀ N, MemLp (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ∧
            eLpNorm (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
              ENNReal.ofReal B13) := by
  have hq1 : (1 : ℝ) ≤ 2 * (3 * p) := by linarith
  obtain ⟨δres, hδres, Cres, hCres0, hres⟩ :=
    aux_lem_band_rem_bank_uniform_rem_resolved d hd E P X W D t ht0 ht1 (2 * (3 * p)) hq1
  obtain ⟨δlam, hδlamPos, Clam, _hClamPos, hlam⟩ :=
    aux_lem_band_rb_uniform_lambda_inv_moments d hd E (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos
      le_rfl
  have hcs : HasCompactSupport rho := by
    refine HasCompactSupport.intro (isCompact_Icc (a := (1 : ℝ)) (b := 2)) ?_
    intro tau htau
    exact hrhos tau (fun h => htau ⟨h.1.le, h.2.le⟩)
  obtain ⟨Mrho, hMrho⟩ := hrho.continuous.bounded_above_of_compact_support hcs
  set Krho : ℝ := max Mrho 0 with hKrhodef
  have hKrho : ∀ tau : ℝ, |rho tau| ≤ Krho := by
    intro tau
    rw [← Real.norm_eq_abs]
    exact (hMrho tau).trans (le_max_left _ _)
  set Dr : ℝ := (∑ i : Fin d, |pvec i|) * (2 * Krho) with hDrdef
  have hDr : 0 ≤ Dr := by
    have : 0 ≤ Krho := le_max_right _ _
    positivity
  have hload := fun (eps : ℝ) (heps : 0 < eps) (heps8 : eps < 1 / 8) =>
    lane4_smoothed_load_properties d rho hrho hrhos Krho hKrho pvec eps heps heps8
  have hface : ∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ y : SpatialCoordinates d,
      |faceBump rho pvec eps y| ≤ Dr * eps⁻¹ := by
    intro eps heps heps8 y
    simpa only [faceBump, lane4_smoothed_neumann_load] using (hload eps heps heps8).2.1 y
  have hfaceMeas : ∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
      AEStronglyMeasurable (faceBump rho pvec eps)
        (volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))) := by
    intro eps heps heps8
    have hc := (hload eps heps heps8).1.continuous
    simpa only [faceBump, lane4_smoothed_neumann_load] using hc.aestronglyMeasurable
  obtain ⟨Cp, hCpdef⟩ : ∃ Cp : ℝ, Cp = max (max Cres (P.C ^ 2 * Clam (2 * (3 * p)))) 0 :=
    ⟨_, rfl⟩
  have hCp0 : 0 ≤ Cp := by rw [hCpdef]; exact le_max_right _ _
  have hmain : ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : in_6_16 d M) (It : in_iteration d M E Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H →
        M.delta ≤ min δres (δlam (2 * (3 * p))) →
        ∃ K13 : ℕ → BilateralField d → ℝ,
          (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N, 0 ≤ K13 N omega ∧
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 →
              ∀ v : meanZeroSobolevGraph (unitNeumannCube d),
                SolvesNeumann (cutoffPositiveCoefficient M H omega N
                    (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) (faceBump rho pvec eps) v →
                ∀ x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)), ∀ rad : ℝ,
                  0 < rad → rad ≤ 1 →
                  localGradientEnergy (cutoffPositiveCoefficient M H omega N
                      (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
                    (show MeasurableSet (Metric.ball x rad ∩
                        (unitNeumannCube d : Set (SpatialCoordinates d))) from
                      (Metric.isOpen_ball.inter (unitNeumannCube d).isOpen).measurableSet)
                    (sobolevGradient v.val) ≤
                    K13 N omega * eps ^ (-2 : ℝ) * rad ^ t)) ∧
          (∀ N, MemLp (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ∧
            eLpNorm (K13 N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
              ENNReal.ofReal (Dr ^ 2 * (Cp * (1 + Cp)))) := by
    intro M Rm hRmC Sreg It H HI hδ
    have hδM : M.delta ≤ δres := hδ.trans (min_le_left _ _)
    have hδlamM : M.delta ≤ δlam (2 * (3 * p)) := hδ.trans (min_le_right _ _)
    obtain ⟨Kres, hKres0, hKresMem, hKresBd, hae⟩ := hres M Rm Sreg It H HI hδM
    obtain ⟨Lam, hLamdef⟩ : ∃ Lam : ℕ → BilateralField d → ℝ, Lam = fun N om =>
        (E.lam (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos
          (cutoffPositiveCoefficient M H om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
          (fun _ : Fin d => (1 / 2 : ℝ)) 1 (1 / 8 : ℝ) 1)⁻¹ := ⟨_, rfl⟩
    have hLamRaw := fun N => hlam M Rm H HI (2 * (3 * p)) hq1 hδlamM N
    have hLamMem' : ∀ N, MemLp (Lam N) (ENNReal.ofReal (2 * (3 * p)))
        (chaosSampleLaw M).toMeasure := by
      intro N; rw [hLamdef]; exact (hLamRaw N).1
    have hLamBd' : ∀ N, eLpNorm (Lam N) (ENNReal.ofReal (2 * (3 * p)))
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (Clam (2 * (3 * p))) := by
      intro N; rw [hLamdef]; exact (hLamRaw N).2
    obtain ⟨K13, hK13def⟩ : ∃ K13 : ℕ → BilateralField d → ℝ, K13 = fun N om =>
        Dr ^ 2 * (Kres N om * (1 + P.C ^ 2 * Lam N om)) := ⟨_, rfl⟩
    have hKmom := aux_lem_band_rem_bank_uniform_neumann_growth_Kbound d M p P.C Cres
      (Clam (2 * (3 * p))) Dr Cp hp hDr hCp0 hCpdef Kres Lam hKresMem hKresBd hLamMem' hLamBd'
    refine ⟨K13, ?_, ?_⟩
    swap
    · intro N; rw [hK13def]; exact hKmom N
    filter_upwards [hae] with omega hom
    intro N
    have hlampos := E.lam_pos (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos
      (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
      (fun _ : Fin d => (1 / 2 : ℝ)) 1 (1 / 8 : ℝ) 1
    have hLampos : 0 < Lam N omega := by rw [hLamdef]; exact inv_pos.mpr hlampos
    have hKr0 := hKres0 N omega
    have h1 : 0 ≤ (1 : ℝ) + P.C ^ 2 * Lam N omega := by
      have := mul_nonneg (sq_nonneg P.C) hLampos.le
      linarith
    refine ⟨by rw [hK13def]; exact mul_nonneg (sq_nonneg Dr) (mul_nonneg hKr0 h1), ?_⟩
    intro eps heps heps8 v hsol x hx rad hrad hrad1
    have hloc := hom.2 N rho hrho hrho0 hrhos hrhoi pvec hpvec Dr hDr
      (fun e he he8 y _hy => hface e he he8 y) eps heps heps8 v hsol x hx rad hrad hrad1
    have hEn := aux_prop_neumann_growth_global_energy hd E P
      (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
      (faceBump rho pvec eps) (hfaceMeas eps heps heps8) (Dr * eps⁻¹)
      (mul_nonneg hDr (inv_nonneg.mpr heps.le)) (hface eps heps heps8) v hsol
    have hmono := E.lam_mono (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos
      (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
      (fun _ : Fin d => (1 / 2 : ℝ)) 1 1 (1 / 8 : ℝ) 1 (by norm_num)
    have hinv : (E.lam (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos
        (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
        (fun _ : Fin d => (1 / 2 : ℝ)) 1 1 1)⁻¹ ≤ Lam N omega := by
      rw [hLamdef]; exact inv_anti₀ hlampos hmono
    have he2 : eps ^ (-2 : ℝ) = (eps⁻¹) ^ 2 := by
      rw [Real.rpow_neg heps.le, inv_pow]; norm_cast
    have hEn' : sobolevCoefficientForm
        (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
        (v : SobolevData (unitNeumannCube d)) (v : SobolevData (unitNeumannCube d)) ≤
        Dr ^ 2 * eps ^ (-2 : ℝ) * P.C ^ 2 *
          (E.lam (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos
            (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
            (fun _ : Fin d => (1 / 2 : ℝ)) 1 1 1)⁻¹ := by
      rw [he2]; convert hEn using 2; ring
    rw [hK13def]
    exact aux_prop_neumann_growth_combine _ (Kres N omega) _ Dr (eps ^ (-2 : ℝ)) P.C _
      (Lam N omega) (rad ^ t) hKr0 (Real.rpow_nonneg heps.le _)
      (Real.rpow_nonneg hrad.le _) hinv hloc hEn'
  exact aux_lem_band_rrpack_neumann_growth d E t Cresp p rho pvec
    (min δres (δlam (2 * (3 * p)))) (lt_min hδres (hδlamPos (2 * (3 * p)) hq1))
    (Dr ^ 2 * (Cp * (1 + Cp))) (mul_nonneg (sq_nonneg Dr) (mul_nonneg hCp0 (by linarith))) hmain

theorem aux_lem_band_UBlane_rem_bank_uniform_neumann
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (P : Paper.in_poincare d hd E) (X : Paper.in_extension d hd E)
    (W : SubdiffusiveProcess.Lane4.SmallPerturbationInput d)
    (S : SubdiffusiveProcess.Lane4.SobolevFoundationalInput d hd)
    (D : @lane4_deterministic_good_scale_input d
      ⟨Nat.ne_of_gt (lt_of_lt_of_le (by decide) hd)⟩)
    (t : ℝ) (ht0 : (d : ℝ) - 1 < t) (ht1 : t < (d : ℝ))
    (Cresp : ℝ) (hCresp : 0 < Cresp) :
    ∀ p : ℝ, 2 ≤ p →
    ∀ rho : ℝ → ℝ, ContDiff ℝ ∞ rho → (∀ v : ℝ, 0 ≤ rho v) →
      (∀ v : ℝ, v ∉ Set.Ioo (1 : ℝ) 2 → rho v = 0) → (∫ v, rho v) = 1 →
    ∀ pvec : Fin d → ℝ, (∑ i : Fin d, (pvec i) ^ 2) = 1 →
      let Qn : Opens (SpatialCoordinates d) := unitNeumannCube d
      let zn : SpatialCoordinates d := fun _ : Fin d => (1 / 2 : ℝ)
    ∀ hPn : (∃ K : ℝ≥0, ∀ w : meanZeroSobolevGraph Qn,
        ‖(w : SobolevData Qn).1‖ ≤
          K * ‖subspaceGradient (meanZeroSobolevGraph Qn) w‖),
      ∃ delta0 : ℝ, 0 < delta0 ∧ ∃ B9 B13 Bsm : ℝ, 0 ≤ B9 ∧ 0 ≤ B13 ∧ 0 ≤ Bsm ∧
        ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
          (Rm : in_responses d M), Rm.C ≤ Cresp →
          ∀ (Sreg : in_6_16 d M) (It : in_iteration d M E Sreg),
          ∀ H : BilateralField d → C(SpatialCoordinates d, ℝ),
          InfraredCharacterization M H → M.delta ≤ delta0 →
          let Pm : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
          let Sn : ResponseSpace Qn := meanZeroResponseSpace hPn
          let an : ℕ → BilateralField d → PositiveCoefficient Qn :=
              fun N omega => cutoffPositiveCoefficient M H omega N zn one_pos
          let Lp : Sn.space →L[ℝ] ℝ :=
              (affineNeumannLoad pvec).comp
                (subspaceGradient (meanZeroSobolevGraph Qn))
          let yn : ℕ → BilateralField d → ℝ :=
              fun N omega => inverseResponse Sn (an N omega) Lp
          ∃ Kcoerc K13 : ℕ → BilateralField d → ℝ,
            (∀ᵐ omega ∂Pm, ∀ N, 0 ≤ Kcoerc N omega ∧ 0 ≤ K13 N omega ∧
              (∀ v : meanZeroSobolevGraph Qn,
                  cubeFractionalSqNorm hd zn 1 one_pos threeQuarterOrder v.val.1 ≤
                    Kcoerc N omega *
                      sobolevCoefficientForm (an N omega) v.val v.val) ∧
              (∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ v : meanZeroSobolevGraph Qn,
                  SolvesNeumann (an N omega) (faceBump rho pvec eps) v →
                  ∀ x ∈ (Qn : Set (SpatialCoordinates d)), ∀ rad : ℝ,
                      0 < rad → rad ≤ 1 →
                      localGradientEnergy (an N omega)
                        (show MeasurableSet
                            (Metric.ball x rad ∩ (Qn : Set (SpatialCoordinates d))) from
                          (Metric.isOpen_ball.inter Qn.isOpen).measurableSet)
                        (sobolevGradient v.val) ≤
                        K13 N omega * eps ^ (-2 : ℝ) * rad ^ t)) ∧
            (∀ N, MemLp (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm ∧
                  MemLp (yn N) (ENNReal.ofReal (12 * p)) Pm ∧
                  MemLp (Kcoerc N) (ENNReal.ofReal (8 * p)) Pm ∧
                  MemLp (yn N) (ENNReal.ofReal (8 * p)) Pm) ∧
            (∀ N, eLpNorm (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm +
                  eLpNorm (yn N) (ENNReal.ofReal (12 * p)) Pm +
                  eLpNorm (Kcoerc N) (ENNReal.ofReal (8 * p)) Pm +
                  eLpNorm (yn N) (ENNReal.ofReal (8 * p)) Pm ≤
                    ENNReal.ofReal B9) ∧
            (∀ N, MemLp (K13 N) (ENNReal.ofReal (3 * p)) Pm ∧
                  eLpNorm (K13 N) (ENNReal.ofReal (3 * p)) Pm ≤
                    ENNReal.ofReal B13) ∧
            (∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ fL2 : DomainL2 Qn,
                ((fL2 : SpatialCoordinates d → ℝ)
                  =ᵐ[volume.restrict (Qn : Set (SpatialCoordinates d))]
                  faceBump rho pvec eps) →
                let ys : ℕ → BilateralField d → ℝ :=
                  fun N omega => inverseResponse Sn (an N omega)
                    ((sobolevVolumeLoad fL2).comp Sn.space.subtypeL)
                ∀ N, MemLp (ys N) (ENNReal.ofReal (3 * p)) Pm ∧
                     MemLp (ys N) (ENNReal.ofReal (2 * p)) Pm ∧
                     eLpNorm (ys N) (ENNReal.ofReal (3 * p)) Pm +
                       eLpNorm (ys N) (ENNReal.ofReal (2 * p)) Pm ≤
                         ENNReal.ofReal Bsm) := by
  intro p hp rho hrho hrho0 hrhos hrhoi pvec hpvec Qn zn hPn
  obtain ⟨delta0C, hdelta0Cpos, B9, Bsm, hB9, hBsm, hC⟩ :=
    aux_lem_band_rem_bank_uniform_neumann_coercive d hd E P S Cresp hCresp p hp
      rho hrho hrho0 hrhos hrhoi pvec hpvec hPn
  obtain ⟨delta0Gr, hdelta0Grpos, B13, hB13, hGr⟩ :=
    aux_lem_band_rem_bank_uniform_neumann_growth d hd E P X W D t ht0 ht1 Cresp hCresp p hp
      rho hrho hrho0 hrhos hrhoi pvec hpvec
  refine ⟨min delta0C delta0Gr, lt_min hdelta0Cpos hdelta0Grpos, B9, B13, Bsm, hB9, hB13, hBsm, ?_⟩
  intro M Rm hRmC Sreg It H hIC hδ Pm Sn an Lp yn
  have hδC' : M.delta ≤ delta0C := hδ.trans (min_le_left _ _)
  have hδGr' : M.delta ≤ delta0Gr := hδ.trans (min_le_right _ _)
  obtain ⟨Kcoerc, hcoer, hmom9, hnorm9, hys⟩ := hC M Rm hRmC H hIC hδC'
  obtain ⟨K13, hK13ae, hK13mom⟩ := hGr M Rm hRmC Sreg It H hIC hδGr'
  refine ⟨Kcoerc, K13, ?_, hmom9, hnorm9, hK13mom, hys⟩
  filter_upwards [hK13ae] with omega hom N
  exact ⟨(hcoer N omega).1, (hom N).1, (hcoer N omega).2, (hom N).2⟩

end UBLane

section TLane
open Filter MeasureTheory Set TopologicalSpace
