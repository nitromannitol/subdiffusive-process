      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (sidePos : ∀ n : ℤ, 0 < (3 : ℝ) ^ (-n))
        (unitA : ∀ (n : ℤ) (z : SpatialCoordinates d),
          PositiveCoefficient (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n))),
      (∀ n z, (unitA n z).val =ᵐ[volume.restrict
        (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n) : Set (SpatialCoordinates d))]
          (fun _ => (1 : ℝ))) →
      ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) → n + off ≤ (N : ℤ) →
      let kappa : ℕ → ℝ := fun J =>
        Real.exp (((J : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) * ahom M J
      let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
        fun k y omega => if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
          else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y
      let reference : ℕ → ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
        fun N k y omega => kappa ((N : ℤ) - k).toNat / kappa N *
          Real.exp (H omega y + retained k y omega)
      let m : ℤ := n + off
      let w : SpatialCoordinates d := z + ((3 : ℝ) ^ (-n)) • sh
      let r : ℝ := (3 : ℝ) ^ (-m)
      ∀ h : ℕ, 1 ≤ h →
        ∃ Yband : BilateralField d → ℝ,
          AEStronglyMeasurable[MeasurableSpace.comap
            (fun omega : BilateralField d =>
              fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) =>
                omega (j : ℤ))
            inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
          eLpNorm (fun omega =>
              let aN := Lane4.cutoffPositiveCoefficient M H omega N w (sidePos m)
              let ref := reference N m w omega
              I.err w r (sidePos m) aN w r ref s 2 - Yband omega)
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (C0 * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
  obtain ⟨a, c, ha, hc, w', hw', hU⟩ := aux_lem_band_U2_err d hd I _Poincare _Extension _Perturbation
    _Sobolev D Cresp hCresp s hs
  refine ⟨a, c, ha, hc, w' + off.natAbs, by omega, ?_⟩
  intro p hp
  obtain ⟨delta0, C, hδ0, hC, hU'⟩ := hU p hp
  refine ⟨delta0, C, hδ0, hC, ?_⟩
  intro M hM Rm hRm Sreg It H hH sidePos unitA hunitA N n z _hnN hmN
  intro kappa retained reference m w r h hh
  have hT4 := aux_lem_band_U2_T4_chart_identity I M H hH N m hmN w (sidePos m)
  refine aux_lem_band_U2_K_transport M n off w w' (w' + off.natAbs) h le_rfl p _
    (fun omega => I.err w r (sidePos m) (Lane4.cutoffPositiveCoefficient M H omega N w (sidePos m)) w r (reference N m w omega) s 2)
    (fun omega => aux_lem_band_U2_errF s (aux_lem_band_U2_unitChart I M H omega ((N : ℤ) - m).toNat) 1)
    ?_ (hU' M hM Rm hRm Sreg It H hH ((N : ℤ) - m).toNat h hh)
  filter_upwards [hT4] with omega homega
  have href : reference N m w omega = aux_lem_band_U2_reference M H N m w omega := rfl
  have hpos := aux_lem_band_U2_reference_pos M H N m w omega
  have hsc : aux_lem_band_U2_errF s (I.chart w r (sidePos m) (Lane4.cutoffPositiveCoefficient M H omega N w (sidePos m)) w r)
      (aux_lem_band_U2_reference M H N m w omega) = aux_lem_band_U2_errF s (aux_lem_band_U2_unitChart I M H (aux_lem_band_U2_shift m w omega) ((N : ℤ) - m).toNat) 1 :=
    aux_lem_band_U2_errF_scaled s _ hpos _ _ homega
  show I.err w r (sidePos m) (Lane4.cutoffPositiveCoefficient M H omega N w (sidePos m)) w r (reference N m w omega) s 2 = aux_lem_band_U2_errF s (aux_lem_band_U2_unitChart I M H (aux_lem_band_U2_shift m w omega) ((N : ℤ) - m).toNat) 1
  rw [href, aux_lem_band_U2_err_eq I w r (sidePos m) _ _ hpos s hs, hsc]

end
