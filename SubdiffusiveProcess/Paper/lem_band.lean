    (hT2 : eLpNorm (fun om => ‖Mx om + ((Mx om)⁻¹)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
      (ENNReal.ofReal q) P ≤ ENNReal.ofReal Bst) :
    MemLp (fun om => aux_lem_band_des3_Krr d t t1 Cm Cmic N (U om) (V om) (Dx om) (Mx om))
      (ENNReal.ofReal q) P ∧
    eLpNorm (fun om => aux_lem_band_des3_Krr d t t1 Cm Cmic N (U om) (V om) (Dx om) (Mx om))
      (ENNReal.ofReal q) P ≤
      ENNReal.ofReal ((Cm * 2 ^ t1) * (Cp * (1 + Cp)) +
        (Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1)) * Bst + (Cmic * 2 ^ t) * Bst) := by
  have hA1 : 0 ≤ Cm * 2 ^ t1 := mul_nonneg hCm (Real.rpow_pos_of_pos (by norm_num) _).le
  have hA3 : 0 ≤ Cmic * 2 ^ t := mul_nonneg hCmic (Real.rpow_pos_of_pos (by norm_num) _).le
  have hA2 : 0 ≤ Cmic * 2 ^ t * (Cm * (max Cmic 1) ^ t1) :=
    mul_nonneg hA3 (mul_nonneg hCm
      (Real.rpow_pos_of_pos (lt_of_lt_of_le one_pos (le_max_right _ _)) _).le)
  have hDt : AEStronglyMeasurable (fun om => (1 + Dx om) ^ t) P :=
    (Real.continuous_rpow_const ht).comp_aestronglyMeasurable
      (aestronglyMeasurable_const.add hDm)
  have hT1m : AEStronglyMeasurable (fun om =>
      (1 + Dx om) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * (U om * (1 + V om))) P :=
    (hDt.mul aestronglyMeasurable_const).mul hWm.1
  have hT2m : AEStronglyMeasurable (fun om =>
      ‖Mx om + ((Mx om)⁻¹)⁻¹‖ * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t)) P :=
    hSm.mul aestronglyMeasurable_const
  have hWq : eLpNorm (fun om => U om * (1 + V om)) (ENNReal.ofReal q) P ≤
      ENNReal.ofReal (Cp * (1 + Cp)) :=
    (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hqQ) hWm.1).trans hWb
  exact aux_rem_resolved_three_term_moment P q _ _ _ (Cp * (1 + Cp)) Bst hq hA1 hA2 hA3
    (by positivity) hBst _ _ _ hWm.1 hT1m hT2m hWq hT1 hT2 q le_rfl

theorem aux_lem_band_des3_rr_stat {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)] (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (t t1 q CD CE CK aRate_max Bst a : ℝ) (hq : 1 ≤ q) (ha0 : 0 ≤ a) (ha : a ≤ aRate_max)
    (hstat : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P],
      ∀ p : ℝ, 1 ≤ p →
      let q := 2 * p * max 1 t
      ∀ D M mInv Kmac : ℕ → Ω → ℝ,
      ∀ aRate : ℝ, 0 ≤ aRate → aRate ≤ aRate_max →
      (∀ N w, 0 ≤ D N w ∧ 0 ≤ M N w ∧ 0 ≤ mInv N w ∧ 0 ≤ Kmac N w) →
      (∀ N, MemLp (D N) (ENNReal.ofReal q) P ∧ MemLp (M N) (ENNReal.ofReal q) P ∧
        MemLp (mInv N) (ENNReal.ofReal q) P ∧ MemLp (Kmac N) (ENNReal.ofReal q) P) →
      (∀ N, eLpNorm (D N) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (CD * Real.sqrt (1 + (N : ℝ)))) →
      (∀ N, eLpNorm (fun w => M N w + mInv N w) (ENNReal.ofReal q) P ≤
        ENNReal.ofReal (CE * Real.exp (aRate * (N : ℝ)))) →
      (∀ N, eLpNorm (Kmac N) (ENNReal.ofReal q) P ≤ ENNReal.ofReal CK) →
      ∀ N : ℕ,
        eLpNorm (fun w => (1 + D N w) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * Kmac N w)
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bst ∧
        eLpNorm (fun w => mInv N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bst ∧
        eLpNorm (fun w => M N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) - t) * (1 + D N w) ^ t)
          (ENNReal.ofReal p) P ≤ ENNReal.ofReal Bst)
    (Dx S W : ℕ → BilateralField d → ℝ)
    (hnn : ∀ N w, 0 ≤ Dx N w ∧ 0 ≤ S N w ∧ 0 ≤ S N w ∧ 0 ≤ W N w)
    (hLp : ∀ N, MemLp (Dx N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ∧
      MemLp (S N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ∧
      MemLp (S N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ∧
      MemLp (W N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure)
    (hD : ∀ N, eLpNorm (Dx N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (CD * Real.sqrt (1 + (N : ℝ))))
    (hS : ∀ N, eLpNorm (fun w => S N w + S N w) (ENNReal.ofReal (2 * q * max 1 t))
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (CE * Real.exp (a * (N : ℝ))))
    (hW : ∀ N, eLpNorm (W N) (ENNReal.ofReal (2 * q * max 1 t)) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal CK) :
    ∀ N : ℕ,
      eLpNorm (fun w => (1 + Dx N w) ^ t * ((3 : ℝ) ^ (-(N : ℝ))) ^ (t1 - t) * W N w)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bst ∧
      eLpNorm (fun w => S N w * ((3 : ℝ) ^ (-(N : ℝ))) ^ ((d : ℝ) + 2 - t))
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal Bst :=
  by
  intro N
  have h := hstat (BilateralField d) (chaosSampleLaw M).toMeasure q hq Dx S S W a ha0 ha
    hnn hLp hD hS hW N
  exact ⟨h.1, h.2.1⟩

theorem aux_lem_band_des3_rr_model {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
