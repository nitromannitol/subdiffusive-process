    have hDT3le' : ∀ omega'' : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d,
        (aux_lem_band_DT3 s k z omega'').toReal ≤
          (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) * aux_prefix_bank_maxObs 0 k z omega'' := by
      intro omega''
      have h1 := ENNReal.toReal_mono
        (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top) (hDT3le omega'')
      rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (Real.rpow_nonneg (by norm_num) _),
