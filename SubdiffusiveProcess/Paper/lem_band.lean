    calc CF2 * M.delta * (3 : ℝ) ^ (-(s * (Hnat : ℝ) / 16))
        ≤ CF2 * M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(s * (Hnat : ℝ) / 16)) := by
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hweaken1 hCF2_nonneg)
            (Real.rpow_nonneg (by norm_num) _)
      _ ≤ CF2 * M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(s / 64) * (h : ℝ)) := by
          exact mul_le_mul_of_nonneg_left hweaken2
            (mul_nonneg hCF2_nonneg (Real.rpow_nonneg hMdelta_pos.le _))
      _ = CF2 * (M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(s / 64) * (h : ℝ))) := by ring
  have hFbandbound''_flat : eLpNorm (fun omega => eramp (eps / 2) eps (F N m w omega) - Fband omega)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (CF2 * M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(s / 64 * (h : ℝ)))) := by
    have heqCF : CF2 * (M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(s / 64) * (h : ℝ))) =
        CF2 * M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(s / 64 * (h : ℝ))) := by ring
    rw [← heqCF]; exact hFbandbound''
  have hFbandbound''' : eLpNorm (fun omega => eramp (eps / 2) eps (F N m w omega) - Fband omega)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (CF2 * (M.delta ^ (1 / 4 : ℝ) *
        (3 : ℝ) ^ (-(min (s / 64) (a1_gap / 2) * (h : ℝ))))) :=
    aux_lem_band_piece_field_weaken (fun omega => eramp (eps / 2) eps (F N m w omega) - Fband omega)
      (ENNReal.ofReal p) CF2 M.delta (1 / 4) (1 / 4)
      (s / 64) (min (s / 64) (a1_gap / 2)) h hMdelta_pos hMdelta_le_one
      le_rfl (min_le_left _ _) hCF2_nonneg hFbandbound''_flat
                                                                                          
  have hp' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp
  have hDbandmeas' := hDbandmeas.mono hle
  have hFbandmeas' := hFbandmeas.mono hle
  refine ⟨fun omega => weight 0 * Dband omega + weight 1 * Fband omega, ?_, ?_⟩
  · exact (hDbandmeas.const_mul (weight 0)).add (hFbandmeas.const_mul (weight 1))
  · have hkey : (fun omega =>
        (weight 0 * (Draw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal +
          weight 1 * eramp (eps / 2) eps
            (F N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega)) -
        (weight 0 * Dband omega + weight 1 * Fband omega))
        = (fun omega => (weight 0 * (Draw N m w omega).toReal +
              weight 1 * eramp (eps / 2) eps (F N m w omega)) -
            (weight 0 * Dband omega + weight 1 * Fband omega)) := by
      funext omega; rw [hm_def, hw_def]
    rw [hkey]
    have hcomb := aux_lem_band_piece_field_combine2 (weight 0) (weight 1) (hweight 0) (hweight 1)
      (fun omega => (Draw N m w omega).toReal)
      (fun omega => eramp (eps / 2) eps (F N m w omega))
      Dband Fband (ENNReal.ofReal p) hp'
      (2 * Real.sqrt (CD q * C_gap)) CF2
      (M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(min (s / 64) (a1_gap / 2) * (h : ℝ))))
      (by positivity) (by positivity) hCF2_nonneg
      hDrawmeas hErampmeas hDbandmeas' hFbandmeas' hDbandbound'' hFbandbound'''
    have hRHSeq : (weight 0 * (2 * Real.sqrt (CD q * C_gap)) + weight 1 * CF2) *
        (M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(min (s / 64) (a1_gap / 2) * (h : ℝ)))) =
        (weight 0 * (2 * Real.sqrt (CD q * C_gap)) + weight 1 * CF2) *
          M.delta ^ (1 / 4 : ℝ) * (3 : ℝ) ^ (-(min (s / 64) (a1_gap / 2) * (h : ℝ))) := by ring
    exact hcomb.trans (le_of_eq (congrArg ENNReal.ofReal hRHSeq))

