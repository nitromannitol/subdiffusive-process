    have h_pos_shrink : 0 < delta0_shrink ^ 2 * |Real.log delta0_shrink| := by
      have hlog_ne_zero : Real.log delta0_shrink ≠ 0 :=
        (Real.log_ne_zero).mpr ⟨by linarith only [hdelta0_shrink_pos],
          by linarith only [hdelta0_shrink_le_half], by linarith only [hdelta0_shrink_pos]⟩
      positivity
    have hflip : (delta0_shrink ^ 2 * |Real.log delta0_shrink|)⁻¹ ≤
