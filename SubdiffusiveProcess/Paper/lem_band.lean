  have hres := (hmain M.delta hδpos hM1 M.P M.G1 M.G2 H hH.1 hH.2 (aux_lem_band_U2_kappa M)
    (aux_lem_band_U2_kappa_pos M) (fun N omega => Lane4.cutoffPositiveCoefficient M H omega N 0 hr)
    (fun N omega => aux_lem_band_U2_cutoff_ae_exp M H N omega) KD hK hMor hmoms).1 h K
  have hRNm : AEStronglyMeasurable (fun omega => dirichletResponse (killedResponseSpace hP)
