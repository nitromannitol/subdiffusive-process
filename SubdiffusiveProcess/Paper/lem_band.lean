theorem aux_lem_band_energy_final {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (p c1 c2 CK B : ℝ) (hp : 1 ≤ p)
    (hc1 : 0 ≤ c1) (hc2 : 0 ≤ c2) (hCK : 0 ≤ CK) (hB : 0 ≤ B)
    (Kmac T1 T2 T3 : ℕ → Ω → ℝ)
    (hKm : ∀ N, AEStronglyMeasurable (Kmac N) μ)
    (h1m : ∀ N, AEStronglyMeasurable (T1 N) μ)
    (h2m : ∀ N, AEStronglyMeasurable (T2 N) μ)
    (h3m : ∀ N, AEStronglyMeasurable (T3 N) μ)
    (hnn : ∀ N o, 0 ≤ Kmac N o ∧ 0 ≤ T1 N o ∧ 0 ≤ T2 N o ∧ 0 ≤ T3 N o)
    (hKn : ∀ N, eLpNorm (Kmac N) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal CK)
    (h1n : ∀ N, eLpNorm (T1 N) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal B)
    (h2n : ∀ N, eLpNorm (T2 N) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal B)
    (h3n : ∀ N, eLpNorm (T3 N) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal B) :
    ∃ K : ℕ → Ω → ℝ,
      (∀ N, MemLp (K N) (ENNReal.ofReal p) μ) ∧
      (∀ N, eLpNorm (K N) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal (1 + c1 * CK + 3 * c2 * B)) ∧
      (∀ N o, 1 ≤ K N o) ∧
      ∀ N o, c1 * Kmac N o + c2 * (T1 N o + T2 N o + T3 N o) ≤ K N o := by
  let Y : ℕ → Ω → ℝ := fun N o => T1 N o + T2 N o + T3 N o
  have hYm : ∀ N, AEStronglyMeasurable (Y N) μ := fun N => ((h1m N).add (h2m N)).add (h3m N)
  have hpE : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := ENNReal.one_le_ofReal.mpr hp
  have hYn : ∀ N, eLpNorm (Y N) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal (3 * B) := by
    intro N
    calc _ ≤ eLpNorm (fun o => T1 N o + T2 N o) (ENNReal.ofReal p) μ +
          eLpNorm (T3 N) (ENNReal.ofReal p) μ := eLpNorm_add_le ((h1m N).add (h2m N)) (h3m N) hpE
      _ ≤ (eLpNorm (T1 N) (ENNReal.ofReal p) μ + eLpNorm (T2 N) (ENNReal.ofReal p) μ) +
          eLpNorm (T3 N) (ENNReal.ofReal p) μ :=
        add_le_add (eLpNorm_add_le (h1m N) (h2m N) hpE) le_rfl
      _ ≤ (ENNReal.ofReal B + ENNReal.ofReal B) + ENNReal.ofReal B :=
        add_le_add (add_le_add (h1n N) (h2n N)) (h3n N)
      _ = ENNReal.ofReal (3 * B) := by
        rw [← ENNReal.ofReal_add hB hB, ← ENNReal.ofReal_add (add_nonneg hB hB) hB]
        congr 1
        ring
  have hscalar : ∀ (c : ℝ), 0 ≤ c → ∀ (F : Ω → ℝ) (C : ℝ),
      eLpNorm F (ENNReal.ofReal p) μ ≤ ENNReal.ofReal C →
      eLpNorm (fun o => c * F o) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal (c * C) := by
    intro c hc F C hF
    rw [aux_rem_resolved_microscopic_nonneg_scalar_eLpNorm μ p c hc F, ENNReal.ofReal_mul hc]
    exact mul_le_mul_left' hF _
  let K : ℕ → Ω → ℝ := fun N o => 1 + c1 * Kmac N o + c2 * Y N o
  have hKmeas : ∀ N, AEStronglyMeasurable (K N) μ := fun N =>
    (aestronglyMeasurable_const.add ((hKm N).const_mul c1)).add ((hYm N).const_mul c2)
  have hKnorm : ∀ N, eLpNorm (K N) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (1 + c1 * CK + 3 * c2 * B) := by
    intro N
    have hone : eLpNorm (fun _ : Ω => (1 : ℝ)) (ENNReal.ofReal p) μ = 1 := by
      rw [eLpNorm_const _ (by positivity : ENNReal.ofReal p ≠ 0) (NeZero.ne μ),
        measure_univ, ENNReal.one_rpow, mul_one]
      simp
    calc _ ≤ eLpNorm (fun o => 1 + c1 * Kmac N o) (ENNReal.ofReal p) μ +
          eLpNorm (fun o => c2 * Y N o) (ENNReal.ofReal p) μ :=
        eLpNorm_add_le (aestronglyMeasurable_const.add ((hKm N).const_mul c1))
          ((hYm N).const_mul c2) hpE
      _ ≤ (eLpNorm (fun _ : Ω => (1 : ℝ)) (ENNReal.ofReal p) μ +
          eLpNorm (fun o => c1 * Kmac N o) (ENNReal.ofReal p) μ) +
          eLpNorm (fun o => c2 * Y N o) (ENNReal.ofReal p) μ :=
        add_le_add (eLpNorm_add_le aestronglyMeasurable_const ((hKm N).const_mul c1) hpE) le_rfl
      _ ≤ (1 + ENNReal.ofReal (c1 * CK)) + ENNReal.ofReal (c2 * (3 * B)) := by
        rw [hone]
        exact add_le_add (add_le_add le_rfl (hscalar c1 hc1 _ CK (hKn N)))
          (hscalar c2 hc2 _ (3 * B) (hYn N))
      _ = _ := by
        rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_add zero_le_one (mul_nonneg hc1 hCK),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1
        ring
  refine ⟨K, fun N => ⟨hKmeas N, (hKnorm N).trans_lt ENNReal.ofReal_lt_top⟩, hKnorm, ?_, ?_⟩
  · intro N o
    obtain ⟨h0, h1, h2, h3⟩ := hnn N o
    have hleft := mul_nonneg hc1 h0
    have hright := mul_nonneg hc2 (add_nonneg (add_nonneg h1 h2) h3)
    dsimp [K, Y]
    linarith
  · intro N o
    dsimp [K, Y]
    linarith

theorem aux_lem_band_rem_bank_uniform_growth_energy
    (d : ℕ) (hd : 2 ≤ d)
