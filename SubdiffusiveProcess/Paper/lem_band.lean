        (le_iSup (fun K => sSup {w : ENNReal | ∃ x ∈ translatedCube d (m + 1 + j) z,
          w = aux_lem_band_piece_product_trunc_TjA d m j omega x +
            aux_lem_band_piece_product_trunc_TjB d m j K z omega x}) K)
    · refine iSup_le fun K => sSup_le ?_
