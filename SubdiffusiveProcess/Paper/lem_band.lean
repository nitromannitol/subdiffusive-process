    (fun _ => (0 : C(SpatialCoordinates d, ℝ))) measurable_const K N b ρ hJg).aestronglyMeasurable,
    ?_⟩
  have hb := aux_lem_extension_cell_moment_eLpNorm_finsetSup_le
