        ∂M.P.toMeasure) ≤
      (((7 ^ d : ℕ) : ℝ≥0∞) * (ENNReal.ofReal (Real.exp (1 / 4 : ℝ)) * 2)) ^
        (3 * p * 9 / (18 * p + 1)) := by
