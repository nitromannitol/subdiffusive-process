theorem aux_lem_band_fine_envelope_budget (d Q1 : ℕ) (CH Cval E0 u0 u1 : ℝ)
    (hCH : 0 ≤ CH) (hE0 : 0 ≤ E0)
    (hu1 : u1 = (d:ℝ)*Real.log 3+Cval^2/4+(9/16)*E0)
    (hu0 : u0 = 3*Real.log 2+CH/4+(d:ℝ)*((Q1:ℝ)+2)*Real.log 3+Cval^2/4+(9/16)*E0) :
    0 ≤ u0 ∧ 0 ≤ u1 ∧
    Real.log 2+CH/4 ≤ u0 ∧
    Real.log 2+(d:ℝ)*((Q1:ℝ)+2)*Real.log 3+Cval^2/4 ≤ u0 ∧
    (d:ℝ)*Real.log 3+Cval^2/4 ≤ u1 ∧
    Real.log 2+(9/16)*E0 ≤ u0 ∧ (9/16)*E0 ≤ u1 := by
  have hlog2 : (0:ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlog3 : (0:ℝ) < Real.log 3 := Real.log_pos (by norm_num)
  have hu1nn : 0 ≤ u1 := by
    rw [hu1]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    linarith
  have hu0nn : 0 ≤ u0 := by
    rw [hu0]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    have h4 : (0 : ℝ) ≤ CH / 4 := by linarith [hCH]
    linarith
  have hu0a : Real.log 2 + CH / 4 ≤ u0 := by
    rw [hu0]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    linarith
  have hu0b : Real.log 2 + (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 + Cval ^ 2 / 4 ≤ u0 := by
    rw [hu0]
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    have h4 : (0 : ℝ) ≤ CH / 4 := by linarith [hCH]
    linarith
  have hu1b : (d : ℝ) * Real.log 3 + Cval ^ 2 / 4 ≤ u1 := by
    rw [hu1]
    have h3 : (0 : ℝ) ≤ (9 / 16) * E0 := by linarith
    linarith
  have hu0c : Real.log 2 + (9 / 16) * E0 ≤ u0 := by
    rw [hu0]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    have h4 : (0 : ℝ) ≤ CH / 4 := by linarith [hCH]
    linarith
  have hu1c : (9 / 16) * E0 ≤ u1 := by
    rw [hu1]
    have h1 : (0 : ℝ) ≤ (d : ℝ) * Real.log 3 := by positivity
    have h2 : (0 : ℝ) ≤ Cval ^ 2 / 4 := by positivity
    linarith
  exact ⟨hu0nn, hu1nn, hu0a, hu0b, hu1b, hu0c, hu1c⟩

theorem aux_lem_band_fine_envelope_exponent (delta tau u0 u1 : ℝ) (N : ℕ)
    (hd : 0 < delta) (hd1 : delta ≤ 1/2) (htau : tau ≤ delta^2)
    (hu0 : 0 ≤ u0) (hu1 : 0 ≤ u1) :
    (1/(4*delta)) * (2*((N:ℝ)+1)*tau + 4*delta*(Real.log 3+u0+u1*(N:ℝ))) ≤
      (1+Real.log 3+u0+u1)*((N:ℝ)+1) := by
  have hn : 0 ≤ (N:ℝ) := Nat.cast_nonneg N
  have hlog3 : (0:ℝ) < Real.log 3 := Real.log_pos (by norm_num)
  have he : (1/(4*delta)) * (2*((N:ℝ)+1)*delta^2 + 4*delta*(Real.log 3+u0+u1*(N:ℝ))) =
      ((N:ℝ)+1)*delta/2 + (Real.log 3+u0+u1*(N:ℝ)) := by
    field_simp
    ring
  calc _ ≤ (1/(4*delta))*(2*((N:ℝ)+1)*delta^2+4*delta*(Real.log 3+u0+u1*(N:ℝ))) := by
        exact mul_le_mul_of_nonneg_left
          (add_le_add (mul_le_mul_of_nonneg_left htau (by positivity)) le_rfl) (by positivity)
    _ = _ := he
    _ ≤ _ := by nlinarith [mul_nonneg hu0 hn, mul_nonneg hlog3.le hn]

theorem aux_lem_band_fine_log_envelope
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) :
    ∃ C : ℝ, 0 < C ∧ ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∃ V : ℕ → BilateralField d → ℝ,
        (∀ N, Measurable (V N)) ∧ (∀ N o, 0 ≤ V N o) ∧
        (∀ᵐ o ∂(chaosSampleLaw M).toMeasure, ∀ N x,
          x ∈ (closedCube z r hr : Set (SpatialCoordinates d)) →
          |Real.log (cutoffCoefficient M H o N x)| ≤ V N o) ∧
        ∀ N, Integrable (fun o => Real.exp (V N o / (4*M.delta))) (chaosSampleLaw M).toMeasure ∧
          (∫ o, Real.exp (V N o / (4*M.delta)) ∂(chaosSampleLaw M).toMeasure) ≤
            Real.exp (C*((N:ℝ)+1)) := by
  classical
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlog3 : (0 : ℝ) < Real.log 3 := Real.log_pos (by norm_num)
  have hr4 : (0 : ℝ) < r + 4 := by linarith
  set K : Compacts (SpatialCoordinates d) := closedCube z (r + 4) hr4 with hKdef
  set Bnd : ℝ := ‖z‖ + (r + 4) / 2 with hBnd
  have hKnorm : ∀ x : K, ‖(x : SpatialCoordinates d)‖ ≤ Bnd := by
    intro x
    have hx : dist (x : SpatialCoordinates d) z ≤ (r + 4) / 2 := x.2
    have hx' : ‖(x : SpatialCoordinates d) - z‖ ≤ (r + 4) / 2 := by
      rwa [dist_eq_norm] at hx
    calc ‖(x : SpatialCoordinates d)‖ = ‖z + ((x : SpatialCoordinates d) - z)‖ := by
          rw [add_sub_cancel]
      _ ≤ ‖z‖ + ‖(x : SpatialCoordinates d) - z‖ := norm_add_le _ _
      _ ≤ Bnd := by rw [hBnd]; linarith
  obtain ⟨Q1, hQ1⟩ := aux_finite_cutoff_log_abs_majorant_exists_pow_half (‖z‖ + r / 2)
  obtain ⟨CHf, hCHf0, hCHfb⟩ :=
    exists_uniform_compactExponentialMoment_of_infraredCharacterization hd
  obtain ⟨Vr, hVrmeas, hVr0, hVrdom, hVrle, hVrset⟩ :=
    aux_finite_negative_layer_log_lipschitz_majorant_continuous_ratio K
  obtain ⟨Q0, hQ0⟩ := aux_finite_cutoff_log_abs_majorant_exists_pow Bnd
  set Cval : ℝ := 6 * Homogenization.Book.Ch04.gammaSigmaIndependentSumConst 2 *
    ((1 + Real.log 2) ^ (2 : ℝ)⁻¹) with hCval
  set E0 : ℝ := 5 * (1 + Real.log 2 + (d : ℝ) * ((Q0 : ℝ) + 3) * Real.log 3) with hE0
  have hE0pos : 0 < E0 := by
    rw [hE0]
    have h : (0 : ℝ) ≤ (d : ℝ) * ((Q0 : ℝ) + 3) * Real.log 3 := by positivity
    linarith
  set u1 : ℝ := (d : ℝ) * Real.log 3 + Cval ^ 2 / 4 + (9 / 16) * E0 with hu1
  set u0 : ℝ := 3 * Real.log 2 + CHf K / 4 + (d : ℝ) * ((Q1 : ℝ) + 2) * Real.log 3 +
    Cval ^ 2 / 4 + (9 / 16) * E0 with hu0
  obtain ⟨hu0nn, hu1nn, hu0a, hu0b, hu1b, hu0c, hu1c⟩ :=
    aux_lem_band_fine_envelope_budget d Q1 (CHf K) Cval E0 u0 u1 (hCHf0 K) hE0pos.le hu1 hu0
  let C : ℝ := 1 + Real.log 3 + u0 + u1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro M Rm H hH
  have hdelta : 0 < M.delta := M.shellPrefix.delta_pos
  have hdhalf : M.delta ≤ 1/2 := M.shellPrefix.delta_le_half
  set t : ℝ := 1 / (4*M.delta) with ht
  set gpt : ℕ → (Fin d → ℤ) → SpatialCoordinates d := fun N q =>
    (3 : ℝ) ^ (-(N : ℤ)) • SubdiffusiveProcess.CoarseGrainingVocab.shellCoverCenter q with hgpt
  set Amax : ℕ → BilateralField d → ℝ := fun N om =>
    (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts d ((N : ℤ) + (Q1 : ℤ))).sup'
      (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ)))
      (fun q => |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|) with hAmax
  set Aosc : ℕ → BilateralField d → ℝ := fun N om =>
    (3 : ℝ) ^ (-(N : ℤ)) * ∑ j ∈ Finset.range (N + 1), Vr (om (-(Int.ofNat j))) with hAosc
  set Ah : BilateralField d → ℝ := fun om =>
    ‖(H om).restrict (K : Set (SpatialCoordinates d))‖ with hAh
  set VV : ℕ → BilateralField d → ℝ := fun N om =>
    2 * ((N : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P + Ah om + Amax N om + Aosc N om with hVV
                  
  have hevmeas : ∀ (j : ℤ) (y : SpatialCoordinates d),
      Measurable (fun om : BilateralField d => om j y) := by
    intro j y
    exact ((continuous_eval_const y).measurable).comp (measurable_pi_apply j)
  have hAhmeas : Measurable Ah :=
    aux_finite_cutoff_log_abs_majorant_restrict_measurable K H hH.1
  have hAmaxmeas : ∀ N, Measurable (Amax N) := by
    intro N
    have h0 : Measurable
        ((SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts d ((N : ℤ) + (Q1 : ℤ))).sup'
          (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ)))
          (fun q (om : BilateralField d) =>
            |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|)) := by
      refine Finset.measurable_sup' _ (fun q _ => ?_)
      exact (Finset.measurable_sum _ (fun j _ => hevmeas (-(Int.ofNat j)) (gpt N q))).abs
    have h1 : ((SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts d ((N : ℤ) + (Q1 : ℤ))).sup'
        (SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ)))
        (fun q (om : BilateralField d) =>
          |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|)) = Amax N := by
      funext om
      exact Finset.sup'_apply _ _ om
    rwa [h1] at h0
  have hAoscmeas : ∀ N, Measurable (Aosc N) := by
    intro N
    refine measurable_const.mul (Finset.measurable_sum _ (fun j _ => ?_))
    exact hVrmeas.comp (measurable_pi_apply _)
  have hVVmeas : ∀ N, Measurable (VV N) := by
    intro N
    exact ((measurable_const.add hAhmeas).add (hAmaxmeas N)).add (hAoscmeas N)
  have hAmax0 : ∀ N om, 0 ≤ Amax N om := by
    intro N om
    obtain ⟨q, hq⟩ := SubdiffusiveProcess.CoarseGrainingVocab.shellCoverShifts_nonempty d ((N : ℤ) + (Q1 : ℤ))
    exact le_trans (abs_nonneg _) (Finset.le_sup' (f := fun q =>
      |∑ j ∈ Finset.range (N + 1), om (-(Int.ofNat j)) (gpt N q)|) hq)
  have hAosc0 : ∀ N om, 0 ≤ Aosc N om := by
    intro N om
    rw [hAosc]
    exact mul_nonneg (by positivity) (Finset.sum_nonneg (fun j _ => hVr0 _))
  have hVV0 : ∀ N om, 0 ≤ VV N om := by
    intro N om
    have htau : 0 ≤ SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P := M.G4.tauSq_pos.le
    have h1 : 0 ≤ 2 * ((N : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P := by positivity
    have h2 : 0 ≤ Ah om := norm_nonneg _
    have := hAmax0 N om
    have := hAosc0 N om
    rw [hVV]
    simp only
    linarith
  set cN : ℕ → ℝ := fun N => 2 * ((N : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P +
    4 * M.delta * (Real.log 3 + u0 + u1 * (N : ℝ)) with hcN
  have hkey : ∀ N : ℕ,
      Integrable (fun om => Real.exp (t * VV N om)) (chaosSampleLaw M).toMeasure ∧
      (∫ om, Real.exp (t * VV N om) ∂(chaosSampleLaw M).toMeasure) ≤
        Real.exp (t * cN N) := by
    intro N
    exact aux_finite_cutoff_log_abs_majorant_moment M H K Bnd hKnorm Q0 Q1 hQ0 Vr hVr0 hVrle
      (CHf K) (hCHf0 K) (fun lam hlam => hCHfb M H hH K lam hlam) Cval E0 u0 u1 t
      hCval hE0 hu1nn hu0a hu0b hu1b hu0c hu1c ht Ah (fun om => rfl) hAhmeas
      Amax (fun N om => rfl) hAmaxmeas Aosc (fun N om => rfl) hAoscmeas N
  have hKcontains : ∀ u : SpatialCoordinates d, dist u z ≤ r / 2 + 1 →
      u ∈ (K : Set (SpatialCoordinates d)) := by
    intro u hu
    show dist u z ≤ (r + 4) / 2
    linarith
  refine ⟨VV, hVVmeas, hVV0, ?_, ?_⟩
  · exact aux_finite_cutoff_log_abs_majorant_envelope M Rm H z r hr K Bnd hKnorm
      hKcontains Q1 hQ1 Vr hVr0 hVrdom hVrset Ah (fun om => rfl) Amax (fun N om => rfl)
      Aosc (fun N om => rfl)
  · intro N
    have hh := hkey N
    have htau : SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P ≤ M.delta^2 := by
      have hb := SubdiffusiveProcess.CoarseGrainingVocab.tauSq_le_delta_sq M
      have hl := Real.log_le_sub_one_of_pos (show (0:ℝ)<2 by norm_num)
      nlinarith [sq_nonneg M.delta]
    have hcNb : t * cN N ≤ C*((N:ℝ)+1) := by
      exact aux_lem_band_fine_envelope_exponent M.delta (SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P)
        u0 u1 N hdelta hdhalf htau hu0nn hu1nn
    have he : (fun o => Real.exp (t*VV N o)) =
        (fun o => Real.exp (VV N o/(4*M.delta))) := by
      funext o
      congr 1
      rw [ht]
      ring
    refine ⟨?_, ?_⟩
    · rw [← he]; exact hh.1
    · rw [← he]; exact hh.2.trans (Real.exp_le_exp.mpr hcNb)

noncomputable def aux_lem_band_fine_layer {d : ℕ}
    (K : Compacts (SpatialCoordinates d)) (n : ℕ) (o : BilateralField d) : C(K, ℝ) :=
  (o ((n+1:ℕ):ℤ)).restrict (K : Set (SpatialCoordinates d)) -
    ContinuousMap.const K (o ((n+1:ℕ):ℤ) 0)

theorem aux_lem_band_fine_layer_orlicz {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (R : ℝ) (hR : 0 < R) :
    ∃ A : ℝ, 0 < A ∧ ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
      (K : Compacts (SpatialCoordinates d)),
      (∀ x ∈ (K : Set (SpatialCoordinates d)), ‖x‖ ≤ R) → ∀ n : ℕ,
      (∫⁻ o, ENNReal.ofReal (Real.exp
        ((‖aux_lem_band_fine_layer K n o‖ /
          (A*M.delta*(1/3:ℝ)^n))^2)) ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨m, hm, hroot⟩ := exists_gmc_anchored_contraction_exp_square (d := d) R hR
  refine ⟨R*(m:ℝ)/3, by positivity, ?_⟩
  intro M K hK n
  letI : MeasurableSpace C(K, ℝ) := borel _
  letI : BorelSpace C(K, ℝ) := ⟨rfl⟩
  let i : ℤ := ((n+1:ℕ):ℤ)
  let c : ℝ := (3:ℝ)^(-i)
  have hc0 : 0 < c := by dsimp [c]; positivity
  have hc1 : c ≤ 1 := by
    dsimp [c]
    calc (3:ℝ)^(-i) ≤ (3:ℝ)^(0:ℤ) :=
        zpow_le_zpow_right₀ (by norm_num) (by dsimp [i]; omega)
      _ = 1 := zpow_zero _
  have hscale : c*R*((m:ℝ)*M.delta) = R*(m:ℝ)/3*M.delta*(1/3:ℝ)^n := by
    dsimp [c, i]
    rw [_root_.zpow_neg, zpow_add₀ (by norm_num : (3:ℝ) ≠ 0), zpow_one,
      _root_.mul_inv_rev, zpow_natCast, ← inv_pow]
    ring
  let G : C(SpatialCoordinates d, ℝ) → ℝ≥0∞ := fun f =>
    ENNReal.ofReal (Real.exp ((‖f.restrict (K : Set (SpatialCoordinates d)) -
      ContinuousMap.const K (f 0)‖/(c*R*((m:ℝ)*M.delta)))^2))
  have hG : Measurable G := by
    apply ENNReal.measurable_ofReal.comp
    apply Real.measurable_exp.comp
    apply Measurable.pow_const
    apply Measurable.div_const
    exact ((ContinuousMap.continuous_restrict (K : Set (SpatialCoordinates d))).measurable.sub
      (ContinuousMap.continuous_const'.measurable.comp (continuous_eval_const (0:SpatialCoordinates d)).measurable)).norm
  let laws : ℤ → Measure C(SpatialCoordinates d, ℝ) := fun j =>
    (scaledLayerLaw d (chaosRootFieldLaw M) j).toMeasure
  have heval : (∫⁻ o : BilateralField d, G (o i) ∂(chaosSampleLaw M).toMeasure) =
      ∫⁻ f, G f ∂(laws i) :=
    (measurePreserving_eval_infinitePi laws i).lintegral_comp hG
  have hmap : (∫⁻ f, G f ∂(laws i)) =
      ∫⁻ f, G (layerScaling d i f) ∂(chaosRootFieldLaw M).toMeasure := by
    dsimp [laws]
    simp only [scaledLayerLaw, ProbabilityMeasure.toMeasure_map]
    exact lintegral_map hG (layerScaling d i).continuous.measurable
  have hh := hroot M K hK c hc0 hc1
  have heq f : G (layerScaling d i f) = ENNReal.ofReal (Real.exp
      ((‖(f.comp (⟨fun x : SpatialCoordinates d => c • x,
          continuous_const.smul continuous_id⟩ : C(SpatialCoordinates d, SpatialCoordinates d))).restrict
            (K : Set (SpatialCoordinates d)) - ContinuousMap.const K (f 0)‖ /
          (c*R*((m:ℝ)*M.delta)))^2)) := by
    dsimp [G, layerScaling, c]
    simp only [smul_zero]
  rw [show (fun o => ENNReal.ofReal (Real.exp ((‖aux_lem_band_fine_layer K n o‖ /
      (R*(m:ℝ)/3*M.delta*(1/3:ℝ)^n))^2))) = (fun o => G (o i)) by
        funext o; dsimp [G, aux_lem_band_fine_layer, i]; rw [hscale]]
  rw [heval, hmap]
  simp_rw [heq]
  exact hh

theorem aux_lem_band_fine_series_orlicz {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [CompleteSpace E] [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (F : ℕ → Ω → E) (hFm : ∀ n, Measurable (F n))
    (A : ℝ) (hA : 0 < A)
    (hb : ∀ n, (∫⁻ o, ENNReal.ofReal (Real.exp
      ((‖F n o‖/(A*(1/3:ℝ)^n))^2)) ∂μ) ≤ 2) :
    (∀ᵐ o ∂μ, Summable (fun n => ‖F n o‖)) ∧
    ∀ h : ℕ, (∫⁻ o, ENNReal.ofReal (Real.exp
      ((‖∑' n, F (n+h) o‖ / ((3/2:ℝ)*A*(1/3:ℝ)^h))^2)) ∂μ) ≤ 2 := by
  obtain ⟨C, hC, hLp⟩ := exists_universal_orlicz_eLpNorm_constant
  have hnorm n : eLpNorm (F n) (2:ℝ≥0∞) μ ≤
      ENNReal.ofReal ((C*A*Real.sqrt 2)*(1/3:ℝ)^n) := by
    have hh := hLp μ (fun o => ‖F n o‖) (A*(1/3:ℝ)^n)
      (hFm n).norm (fun _ => norm_nonneg _) (by positivity) (hb n) 2 (by norm_num) le_rfl
    rw [eLpNorm_norm] at hh
    simpa only [ENNReal.toReal_ofNat, mul_assoc, mul_left_comm, mul_comm] using hh
  have hmem n : MemLp (F n) (2:ℝ≥0∞) μ :=
    ⟨(hFm n).aestronglyMeasurable, (hnorm n).trans_lt ENNReal.ofReal_lt_top⟩
  have hs := (memLp_geometric_tsum_tails μ (by norm_num : (1:ℝ≥0∞)≤2)
    (by norm_num) F hmem (by positivity : 0≤C*A*Real.sqrt 2)
    (by norm_num) (by norm_num) hnorm).1
  refine ⟨hs, ?_⟩
  intro h
  let a : ℕ → ℝ := fun n => A*(1/3:ℝ)^(n+h)
  have ha n : 0 < a n := by dsimp [a]; positivity
  have hseq : a = fun n => (A*(1/3:ℝ)^h)*(1/3:ℝ)^n := by
    funext n
    dsimp [a]
    rw [pow_add]
    ring
  have hsum : Summable a := by
    rw [hseq]
    exact (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left _
  have ht : (∑' n, a n) = (3/2:ℝ)*A*(1/3:ℝ)^h := by
    rw [hseq, tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    ring
  have hs' : ∀ᵐ o ∂μ, Summable (fun n => ‖F (n+h) o‖) :=
    hs.mono fun o ho => ho.comp_injective (fun _ _ he => Nat.add_right_cancel he)
  have hh := lintegral_exp_sq_norm_tsum_le μ (fun n o => F (n+h) o)
    (fun n => (hFm (n+h)).aestronglyMeasurable) a ha hsum hs' (fun n => hb (n+h))
  rwa [ht] at hh

theorem aux_lem_band_fine_layer_meas {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (K : Compacts (SpatialCoordinates d)) [MeasurableSpace C(K, ℝ)] [BorelSpace C(K, ℝ)] (n : ℕ) :
    Measurable (aux_lem_band_fine_layer K n) := by
  have h1 : Measurable (fun o : BilateralField d => (o ((n+1:ℕ):ℤ)).restrict (K : Set (SpatialCoordinates d))) := (ContinuousMap.continuous_restrict (K : Set (SpatialCoordinates d))).measurable.comp
    (measurable_pi_apply ((n+1:ℕ):ℤ))
  have h2 : Measurable (fun o : BilateralField d => ContinuousMap.const K (o ((n+1:ℕ):ℤ) 0)) := ContinuousMap.continuous_const'.measurable.comp
    ((continuous_eval_const (0 : SpatialCoordinates d)).measurable.comp
      (measurable_pi_apply ((n+1:ℕ):ℤ)))
  exact h1.sub h2

theorem aux_lem_band_fine_infrared_tail_orlicz {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (R : ℝ) (hR : 0 < R) :
    ∃ A : ℝ, 0 < A ∧ ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
      (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K : Compacts (SpatialCoordinates d)),
      (∀ x ∈ (K : Set (SpatialCoordinates d)), ‖x‖ ≤ R) → ∀ h : ℕ,
      (∫⁻ o, ENNReal.ofReal (Real.exp
        ((‖(H o - infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d))‖ /
          (A*M.delta*(1/3:ℝ)^h))^2)) ∂(chaosSampleLaw M).toMeasure) ≤ 2 := by
  obtain ⟨A, hA, hb⟩ := aux_lem_band_fine_layer_orlicz (d := d) R hR
  refine ⟨(3/2)*A, by positivity, ?_⟩
  intro M H hH K hK h
  letI : MeasurableSpace C(K, ℝ) := borel _
  letI : BorelSpace C(K, ℝ) := ⟨rfl⟩
  have hdelta := M.shellPrefix.delta_pos
  have hs := aux_lem_band_fine_series_orlicz (chaosSampleLaw M).toMeasure
    (aux_lem_band_fine_layer K) (aux_lem_band_fine_layer_meas K)
    (A*M.delta) (by positivity) (hb M K hK)
  have heq : ∀ᵐ o ∂(chaosSampleLaw M).toMeasure,
      (H o - infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d)) =
        ∑' n, aux_lem_band_fine_layer K (n+h) o := by
    filter_upwards [hs.1, hH.2] with o ho hHo
    have hp L : (∑ n ∈ Finset.range L, aux_lem_band_fine_layer K n o) =
        (infraredPartialSum o L).restrict (K : Set (SpatialCoordinates d)) := by
      ext x
      change (∑ n ∈ Finset.range L, aux_lem_band_fine_layer K n o) x =
        (infraredPartialSum o L) (x : SpatialCoordinates d)
      rw [ContinuousMap.sum_apply]
      unfold infraredPartialSum
      rw [ContinuousMap.sum_apply]
      apply Finset.sum_congr rfl
      intro n hn
      rfl
    have hlim := ((ContinuousMap.continuous_restrict (K : Set (SpatialCoordinates d))).tendsto
      (H o)).comp hHo
    have htot : (H o).restrict (K : Set (SpatialCoordinates d)) =
        ∑' n, aux_lem_band_fine_layer K n o := by
      exact tendsto_nhds_unique (by simpa only [Function.comp_def, ← hp] using hlim)
        ho.of_norm.hasSum.tendsto_sum_nat
    have hadd := ho.of_norm.sum_add_tsum_nat_add h
    have he : (H o - infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d)) =
        (H o).restrict (K : Set (SpatialCoordinates d)) -
          (infraredPartialSum o h).restrict (K : Set (SpatialCoordinates d)) := by ext x; rfl
    rw [he, htot, ← hp h]
    exact (eq_sub_iff_add_eq.mpr (by simpa only [add_comm] using hadd)).symm
  have hh := hs.2 h
  have hden : (3/2:ℝ)*(A*M.delta)*(1/3:ℝ)^h = (3/2*A)*M.delta*(1/3:ℝ)^h := by ring
  rw [hden] at hh
  refine (lintegral_congr_ae ?_).trans_le hh
  filter_upwards [heq] with o ho
  rw [ho]

theorem aux_lem_band_fine_exp_small (x a : ℝ) (hx : 0 ≤ x) (ha : 0 < a) (ha1 : a ≤ 1) :
    Real.exp x - 1 ≤ a * Real.exp (2*x/a) := by
  have hbase : Real.exp x - 1 ≤ x*Real.exp x := by
    have hh := mul_le_mul_of_nonneg_left (Real.add_one_le_exp (-x)) (Real.exp_pos x).le
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero] at hh
    nlinarith
  have hxa : x ≤ x/a := (le_div_iff₀ ha).mpr (by nlinarith)
  have hxexp : x ≤ a*Real.exp (x/a) := by
    have hh := (div_le_iff₀ ha).mp ((by linarith [Real.add_one_le_exp (x/a)] : x/a ≤ Real.exp (x/a)))
    nlinarith
  calc Real.exp x - 1 ≤ x*Real.exp x := hbase
    _ ≤ (a*Real.exp (x/a))*Real.exp x := mul_le_mul_of_nonneg_right hxexp (Real.exp_pos _).le
    _ = a*Real.exp (x/a+x) := by rw [mul_assoc, ← Real.exp_add]
    _ ≤ a*Real.exp (2*x/a) := by
      apply mul_le_mul_of_nonneg_left _ ha.le
      apply Real.exp_le_exp.mpr
      calc x / a + x ≤ x / a + x / a := add_le_add le_rfl hxa
        _ = 2 * x / a := by ring

theorem aux_lem_band_fine_envelope_moment {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (V : Ω → ℝ) (hVm : Measurable V) (hV0 : ∀ o, 0 ≤ V o)
    (delta C p : ℝ) (N : ℕ) (hp : 1 ≤ p) (hdelta : 0 < delta)
    (hdelta1 : delta ≤ 1/(8*p))
    (hi : Integrable (fun o => Real.exp (V o/(4*delta))) μ)
    (hb : (∫ o, Real.exp (V o/(4*delta)) ∂μ) ≤ Real.exp (C*((N:ℝ)+1))) :
    MemLp (fun o => Real.exp (V o)) (ENNReal.ofReal p) μ ∧
    eLpNorm (fun o => Real.exp (V o)) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (Real.exp (C*((N:ℝ)+1)/p)) ∧
    eLpNorm (fun o => Real.exp (V o)-1) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (8*p*delta*Real.exp (C*((N:ℝ)+1)/p)) := by
  have hp0 : 0 < p := by linarith
  have hden : 8*p*delta ≤ 1 := by
    have hh := (le_div_iff₀ (by positivity : 0<8*p)).mp hdelta1
    nlinarith
  have hden0 : 0 < 4*delta*p := by positivity
  let Y : Ω → ℝ := fun o => V o / (4*delta*p)
  have heq : (fun o => Real.exp (p*Y o)) = fun o => Real.exp (V o/(4*delta)) := by
    funext o
    congr 1
    dsimp [Y]
    field_simp
  have hiY : Integrable (fun o => Real.exp (p*Y o)) μ := by rw [heq]; exact hi
  have hbY : (∫ o, Real.exp (p*Y o) ∂μ) ≤ Real.exp (p*(C*((N:ℝ)+1)/p)) := by
    rw [heq, mul_div_cancel₀ _ hp0.ne']
    exact hb
  have hY := aux_finite_cutoff_log_abs_majorant_eLpNorm_exp μ Y
    (hVm.div_const _) p hp0 hiY (C*((N:ℝ)+1)/p) hbY
  have hVY o : V o ≤ Y o := by
    apply (le_div_iff₀ hden0).mpr
    have hvo := hV0 o
    nlinarith
  have hnorm : eLpNorm (fun o => Real.exp (V o)) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (Real.exp (C*((N:ℝ)+1)/p)) := by
    refine (eLpNorm_mono (fun o => ?_)).trans hY.2
    simpa only [Real.norm_of_nonneg (Real.exp_pos _).le] using Real.exp_le_exp.mpr (hVY o)
  refine ⟨⟨hVm.exp.aestronglyMeasurable, hnorm.trans_lt ENNReal.ofReal_lt_top⟩, hnorm, ?_⟩
  have hpwise o : ‖Real.exp (V o)-1‖ ≤ ‖(8*p*delta)*Real.exp (Y o)‖ := by
    rw [Real.norm_of_nonneg (sub_nonneg.mpr (Real.one_le_exp_iff.mpr (hV0 o))),
      Real.norm_of_nonneg (by positivity)]
    have hh := aux_lem_band_fine_exp_small (V o) (8*p*delta) (hV0 o) (by positivity) hden
    have he : 2*V o/(8*p*delta) = Y o := by dsimp [Y]; field_simp; ring
    rwa [he] at hh
  calc _ ≤ eLpNorm (fun o => (8*p*delta)*Real.exp (Y o)) (ENNReal.ofReal p) μ := eLpNorm_mono hpwise
    _ = ENNReal.ofReal (8*p*delta)*eLpNorm (fun o => Real.exp (Y o)) (ENNReal.ofReal p) μ := by
      have he : (fun o => (8*p*delta)*Real.exp (Y o)) = (8*p*delta) • (fun o => Real.exp (Y o)) := by
        funext o; rfl
      rw [he, eLpNorm_const_smul, Real.enorm_eq_ofReal (by positivity)]
    _ ≤ ENNReal.ofReal (8*p*delta)*ENNReal.ofReal (Real.exp (C*((N:ℝ)+1)/p)) :=
      mul_le_mul_left' hY.2 _
    _ = _ := (ENNReal.ofReal_mul (by positivity)).symm

theorem aux_lem_band_fine_growth_moments (C γ q : ℝ) (hC : 0 < C)
    (hγ : 0 < γ) (hq : 1 ≤ q) :
    ∃ delta0 B : ℝ, 0 < delta0 ∧ 0 < B ∧ delta0 ≤ 1 ∧
      ∀ {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
        (V : Ω → ℝ), Measurable V → (∀ o, 0 ≤ V o) →
      ∀ delta : ℝ, 0 < delta → delta ≤ delta0 → ∀ N : ℕ,
      Integrable (fun o => Real.exp (V o/(4*delta))) μ →
      (∫ o, Real.exp (V o/(4*delta)) ∂μ) ≤ Real.exp (C*((N:ℝ)+1)) →
      eLpNorm (fun o => Real.exp (2*(V o+delta))) (ENNReal.ofReal (2*q)) μ ≤
        ENNReal.ofReal (B*(3:ℝ)^(γ*(N:ℝ))) ∧
      eLpNorm (fun o => Real.exp (2*(V o+delta))-1) (ENNReal.ofReal q) μ ≤
        ENNReal.ofReal (B*delta*(3:ℝ)^(γ*(N:ℝ))) := by
  let p := max (2*q) (max 1 ((C+1)/(γ*Real.log 3)))
  have hpq : 2*q ≤ p := le_max_left _ _
  have hp : 1 ≤ p := (le_max_left _ _).trans (le_max_right _ _)
  have hp0 : 0 < p := by linarith
  have hlog : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hrate : (C+1)/p ≤ γ*Real.log 3 := by
    have hh : (C+1)/(γ*Real.log 3) ≤ p := (le_max_right _ _).trans (le_max_right _ _)
    have hh' := (div_le_iff₀ (mul_pos hγ hlog)).mp hh
    apply (div_le_iff₀ hp0).mpr
    nlinarith
  let B0 := Real.exp ((C+1)/p)
  have hB0 : 0 < B0 := Real.exp_pos _
  refine ⟨min 1 (1/(16*p)), (16*p+1)*B0, lt_min one_pos (by positivity),
    by positivity, min_le_left _ _, ?_⟩
  intro Ω _ μ _ V hV hV0 delta hd hd0 N hi hb
  have hδ : 2*delta ≤ 1/(8*p) := by
    have hh := (le_div_iff₀ (by positivity : 0<16*p)).mp (hd0.trans (min_le_right _ _))
    apply (le_div_iff₀ (by positivity : 0<8*p)).mpr
    nlinarith
  let W : Ω → ℝ := fun o => 2*(V o+delta)
  have hW : Measurable W := measurable_const.mul (hV.add_const _)
  have he o : W o/(4*(2*delta)) = (1/4:ℝ)+V o/(4*delta) := by
    dsimp [W]; field_simp; ring
  have hei : (fun o => Real.exp (W o/(4*(2*delta)))) =
      (fun o => Real.exp (1/4:ℝ)*Real.exp (V o/(4*delta))) := by
    funext o; rw [he, Real.exp_add]
  have hiW : Integrable (fun o => Real.exp (W o/(4*(2*delta)))) μ := by
    rw [hei]; exact hi.const_mul _
  have hbW : (∫ o, Real.exp (W o/(4*(2*delta))) ∂μ) ≤ Real.exp ((C+1)*((N:ℝ)+1)) := by
    rw [hei, integral_const_mul]
    calc Real.exp (1/4:ℝ)*(∫ o, Real.exp (V o/(4*delta)) ∂μ) ≤
        Real.exp (1/4:ℝ)*Real.exp (C*((N:ℝ)+1)) :=
          mul_le_mul_of_nonneg_left hb (Real.exp_pos _).le
      _ = Real.exp ((1/4:ℝ)+C*((N:ℝ)+1)) := (Real.exp_add _ _).symm
      _ ≤ _ := Real.exp_le_exp.mpr (by have hN : (0:ℝ)≤N := Nat.cast_nonneg N; nlinarith)
  have hh := aux_lem_band_fine_envelope_moment μ W hW
    (fun o => mul_nonneg (by norm_num) (add_nonneg (hV0 o) hd.le)) (2*delta) (C+1) p N hp (by positivity) hδ hiW hbW
  have hG : Real.exp ((C+1)*((N:ℝ)+1)/p) ≤ B0*(3:ℝ)^(γ*(N:ℝ)) := by
    rw [show (C+1)*((N:ℝ)+1)/p = (C+1)/p + ((C+1)/p)*(N:ℝ) by ring,
      Real.exp_add]
    apply mul_le_mul_of_nonneg_left _ hB0.le
    rw [Real.rpow_def_of_pos (by norm_num : (0:ℝ)<3)]
    apply Real.exp_le_exp.mpr
    calc (C+1)/p*(N:ℝ) ≤ (γ*Real.log 3)*(N:ℝ) :=
      mul_le_mul_of_nonneg_right hrate (Nat.cast_nonneg _)
      _ = _ := by ring
  have hBn : B0 ≤ (16*p+1)*B0 := by nlinarith
  have hBdiff : 16*p*B0 ≤ (16*p+1)*B0 := by nlinarith
  constructor
  · refine (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hpq)
      hW.exp.aestronglyMeasurable).trans (hh.2.1.trans ?_)
    apply ENNReal.ofReal_le_ofReal
    exact hG.trans (mul_le_mul_of_nonneg_right hBn (by positivity))
  · have hqp : q ≤ p := by linarith
    refine (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal hqp)
      (hW.exp.sub_const 1).aestronglyMeasurable).trans (hh.2.2.trans ?_)
    apply ENNReal.ofReal_le_ofReal
    calc 8*p*(2*delta)*Real.exp ((C+1)*((N:ℝ)+1)/p) ≤
        8*p*(2*delta)*(B0*(3:ℝ)^(γ*(N:ℝ))) :=
          mul_le_mul_of_nonneg_left hG (by positivity)
      _ = (16*p*B0)*delta*(3:ℝ)^(γ*(N:ℝ)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hBdiff hd.le) (by positivity)

theorem aux_lem_band_fine_tail_moment (A q : ℝ) (hA : 0 < A) (hq : 1 ≤ q) :
    ∃ C : ℝ, 0 < C ∧ ∀ {Ω : Type*} [MeasurableSpace Ω]
      (μ : Measure Ω) [IsProbabilityMeasure μ] (T : Ω → ℝ), Measurable T →
      (∀ o, 0 ≤ T o) → ∀ s : ℝ, 0 < s → s ≤ 1 →
      (∫⁻ o, ENNReal.ofReal (Real.exp ((T o/(A*s))^2)) ∂μ) ≤ 2 →
      eLpNorm (fun o => Real.exp (2*(T o+s))-1) (ENNReal.ofReal q) μ ≤
        ENNReal.ofReal (C*s) := by
  obtain ⟨Co, hCo, hO⟩ := exists_universal_orlicz_eLpNorm_constant
  let B := 2*(A+2)
  let E := (2*Real.exp ((2*q)^2*B^2/4))^(1/(2*q))
  have hB : 0 < B := by dsimp [B]; positivity
  have hE : 0 < E := by dsimp [E]; positivity
  refine ⟨Co*B*Real.sqrt (2*q)*E, by positivity, ?_⟩
  intro Ω _ μ _ T hT hT0 s hs hs1 hor
  let S : Ω → ℝ := fun o => 2*(T o+s)
  have hS : Measurable S := measurable_const.mul (hT.add_const s)
  have hS0 : ∀ o, 0 ≤ S o := fun o => mul_nonneg (by norm_num) (add_nonneg (hT0 o) hs.le)
  have hg : (∫⁻ o, ENNReal.ofReal (Real.exp ((S o/(B*s))^2)) ∂μ) ≤ 2 := by
    let X : Fin 2 → Ω → ℝ := fun i o => if i=0 then 2*T o else 2*s
    let a : Fin 2 → ℝ := fun i => if i=0 then 2*A*s else 4*s
    have hX : ∀ i ∈ (Finset.univ : Finset (Fin 2)), AEStronglyMeasurable (X i) μ := by
      intro i _; fin_cases i <;> dsimp [X]
      · exact (measurable_const.mul hT).aestronglyMeasurable
      · exact aestronglyMeasurable_const
    have hX0 : ∀ i ∈ (Finset.univ : Finset (Fin 2)), ∀ᵐ o ∂μ, 0 ≤ X i o := by
      intro i _; filter_upwards [] with o
      fin_cases i <;> dsimp [X]
      · exact mul_nonneg (by norm_num) (hT0 o)
      · positivity
    have ha : ∀ i ∈ (Finset.univ : Finset (Fin 2)), 0 < a i := by
      intro i _; fin_cases i <;> dsimp [a] <;> positivity
    have hb : ∀ i ∈ (Finset.univ : Finset (Fin 2)),
        (∫⁻ o, ENNReal.ofReal (Real.exp ((X i o/a i)^2)) ∂μ) ≤ 2 := by
      intro i _; fin_cases i
      · change (∫⁻ o, ENNReal.ofReal (Real.exp (((2*T o)/(2*A*s))^2)) ∂μ) ≤ 2
        have he o : (2*T o)/(2*A*s) = T o/(A*s) := by field_simp
        simpa only [he] using hor
      · change (∫⁻ _o : Ω, ENNReal.ofReal (Real.exp (((2*s)/(4*s))^2)) ∂μ) ≤ 2
        have he : (2*s)/(4*s) = (1/2:ℝ) := by field_simp; ring
        rw [he]
        have hh : Real.exp ((1/2:ℝ)^2) ≤ 2 := by
          calc Real.exp ((1/2:ℝ)^2) ≤ Real.exp (Real.log 2) := by
                apply Real.exp_le_exp.mpr
                have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0:ℝ)<2)
                norm_num at hh ⊢; linarith
            _ = 2 := Real.exp_log (by norm_num)
        simpa only [lintegral_const, measure_univ, mul_one, ENNReal.ofReal_ofNat] using
          ENNReal.ofReal_le_ofReal hh
    have hh := lintegral_exp_sq_finset_sum_le μ Finset.univ X a
      Finset.univ_nonempty hX hX0 ha hb
    have he o : (∑ i : Fin 2, X i o)/(∑ i : Fin 2, a i) = S o/(B*s) := by
      simp only [Fin.sum_univ_two]
      dsimp [X,a,S,B]
      congr 1 <;> ring
    simpa only [he] using hh
  have hn := hO μ S (B*s) hS hS0 (by positivity) hg (ENNReal.ofReal (2*q))
    ENNReal.ofReal_ne_top (by simpa only [ENNReal.ofReal_ofNat] using ENNReal.ofReal_le_ofReal (show (2:ℝ)≤2*q by linarith))
  rw [ENNReal.toReal_ofReal (by positivity : 0≤2*q)] at hn
  have hg' : (∫⁻ o, ENNReal.ofReal (Real.exp ((|S o|/(B*s))^2)) ∂μ) ≤ 2 := by
    simpa only [abs_of_nonneg (hS0 _)] using hg
  have he := aux_lem_band_orlicz_exp_norm μ S hS (B*s) B (2*q)
    (by positivity) (by nlinarith) (by positivity) hg'
  have hh := aux_lem_band_ref_exp_baseline_norm μ S hS q
    (Co*(B*s)*Real.sqrt (2*q)) E (by positivity) (by positivity) hn he
  convert hh using 1 <;> congr 1 <;> ring

