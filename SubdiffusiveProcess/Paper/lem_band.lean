  have hCp_pos : 0 < Cp := by
    have h0 := hC0Fnonneg; have h1 := hC0Pnonneg; have h2 := hC0Rnonneg; have h3 := hC0Cnonneg
    rw [hCp_def]; linarith only [h0, h1, h2, h3]
  refine ⟨q, delta0, Cp, hq_bound, hq1, hdelta0_pos, hCp_pos, ?_⟩
  intro M hMdelta Rm hRm Sreg _It H hInfrared eta heta F Praw Rraw Draw Z rawGood hprim
    hDbaseline sidePos unitA hunita

  have hMdelta_pos : 0 < M.delta := M.shellPrefix.delta_pos
  have hMdelta_le_half : M.delta ≤ 1/2 := M.shellPrefix.delta_le_half
  have hMdelta_le_shrink : M.delta ≤ delta0_shrink := hMdelta.trans hdelta0_le_shrink
  have h_decreasing : (delta0_shrink ^ 2)⁻¹ * |Real.log delta0_shrink|⁻¹ ≤
