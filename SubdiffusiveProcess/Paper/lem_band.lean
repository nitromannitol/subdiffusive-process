theorem aux_lem_band_piece_product_eramp_continuous (lo hi : ℝ) (hlohi : lo < hi) :
    Continuous (fun x : ℝ≥0∞ =>
      (min (1 : ℝ≥0∞) ((x - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))).toReal) := by
  have hpos : (0 : ℝ) < hi - lo := sub_pos.mpr hlohi
  have hne : ENNReal.ofReal (hi - lo) ≠ 0 :=
    ENNReal.ofReal_eq_zero.not.mpr (not_le.mpr hpos)
  have hf : Continuous (fun x : ℝ≥0∞ =>
      min (1 : ℝ≥0∞) ((x - ENNReal.ofReal lo) / ENNReal.ofReal (hi - lo))) :=
    continuous_const.min
      ((ENNReal.continuous_div_const _ hne).comp (ENNReal.continuous_sub_right _))
  exact ENNReal.continuousOn_toReal.comp_continuous hf (fun x =>
    ne_top_of_lt (lt_of_le_of_lt (min_le_left _ _) ENNReal.one_lt_top))

theorem aux_lem_band_piece_product_trunc
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (s eps : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (weight2 : ℝ) (hweight2 : 0 ≤ weight2)
    (p : ℝ) (hp : 1 ≤ p) :
    ∃ CP delta0 : ℝ, 0 ≤ CP ∧ 0 < delta0 ∧
      ∀ (M : GMCModel d), M.delta ≤ delta0 →
      ∀ (eta : ℕ → BilateralField d → PotentialSample d),
        (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
          ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
            omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
      ∀ (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
        (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
        (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop),
        (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
          primitive_scores d M s eps (eta N omega)
            (fun m y => F N m y omega) (fun m y => Praw N m y omega)
            (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
            (fun m y => Z N m y omega) (fun m y => rawGood N m y omega)) →
      ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) →
      ∀ (h : ℕ), 1 ≤ h →
        ∃ Pband : BilateralField d → ℝ,
          AEStronglyMeasurable[MeasurableSpace.comap
            (fun omega : BilateralField d =>
              fun j : Set.Icc (-n - (4 * (h + 1) : ℕ)) (-n + (4 * (h + 1) : ℕ)) => omega (j : ℤ))
            inferInstance] Pband (chaosSampleLaw M).toMeasure ∧
          eLpNorm (fun omega =>
              weight2 * (min (1 : ENNReal)
                  ((Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega - ENNReal.ofReal 6) /
                    ENNReal.ofReal ((12 : ℝ) - 6))).toReal
                - Pband omega)
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (CP * (3 : ℝ) ^ (-(s / 32) * (h : ℝ)))
  := by
  have hd1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast (by omega : 1 ≤ d)
  obtain ⟨C0, delta0, hC0nn, hdelta0pos, hcore⟩ :=
    aux_lem_band_piece_product_trunc_core d hd s hs p hp
  refine ⟨weight2 / 6 * C0, delta0, by positivity, hdelta0pos, ?_⟩
  intro M hMdelta eta hEta F Praw Rraw Draw Z rawGood hPrimitive N n z hnN h hh
  set m : ℕ := ((N : ℤ) - n).toNat with hmdef
  set w : Vec d := (3 : ℝ) ^ N • z with hwdef
  set H : ℕ := 4 * (h + 1) with hHdef
  obtain ⟨hPfinS_pot, hcorebound⟩ := hcore M hMdelta m w H
  have hae := aux_prefix_praw_actual_ae_eq M s eps eta F Praw Rraw Draw Z rawGood hPrimitive N m w
  have hmeasEta : AEMeasurable (eta N) (chaosSampleLaw M).toMeasure :=
    prefix_eta_aemeasurable M eta hEta N
  have hlaw : Measure.map (eta N) (chaosSampleLaw M).toMeasure = M.P.toMeasure :=
    prefix_eta_law M eta hEta N
  have hPfinS : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, Praw N m w omega ≠ ⊤ := by
    have hfin_pullback : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        aux_prefix_praw_PscF s m w (eta N omega) ≠ ⊤ := by
      have hpb := ae_of_ae_map (μ := (chaosSampleLaw M).toMeasure) hmeasEta
        (p := fun g => aux_prefix_praw_PscF s m w g ≠ ⊤)
      rw [hlaw] at hpb
      refine hpb ?_
      filter_upwards [hPfinS_pot] with omega' hfin'
      rwa [aux_lem_band_piece_product_Praw_eq_PscF] at hfin'
    filter_upwards [hae, hfin_pullback] with omega heq hfin
    rw [heq]; exact hfin
  set Pcand' : BilateralField d → ENNReal := fun omega =>
    aux_lem_band_piece_product_trunc_Pcand d s m w (eta N omega) H with hPcanddef
  have hdiffbound : eLpNorm (fun omega : BilateralField d =>
      (Praw N m w omega).toReal - (Pcand' omega).toReal)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (C0 * (3 : ℝ) ^ (-(s / 16) * (H : ℝ))) := by
    have hgmeas : Measurable (fun g : PotentialSample d =>
        (aux_lem_band_piece_product_Praw d s m w g).toReal -
          (aux_lem_band_piece_product_trunc_Pcand d s m w g H).toReal) :=
      (ENNReal.measurable_toReal.comp (aux_lem_prefix_limit_actual_Psc_meas s m w)).sub
        (ENNReal.measurable_toReal.comp (aux_lem_band_piece_product_trunc_Pcand_meas d s m H w))
    have hmap_eq : eLpNorm (fun g : PotentialSample d =>
        (aux_lem_band_piece_product_Praw d s m w g).toReal -
          (aux_lem_band_piece_product_trunc_Pcand d s m w g H).toReal)
        (ENNReal.ofReal p) M.P.toMeasure =
        eLpNorm (fun omega : BilateralField d =>
            (aux_lem_band_piece_product_Praw d s m w (eta N omega)).toReal -
