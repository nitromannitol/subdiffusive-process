  · simp only [hkj, if_false]
    exact measurable_const

theorem aux_lem_band_DT4_term_le {d : ℕ} (k : ℕ) (z : Vec d) (j : ℕ)
    (omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) :
    (if k ≤ j then ENNReal.ofReal ((3 : ℝ) ^ k) *
      sSup {w : ENNReal | ∃ x ∈ translatedCube d (k : ℤ) z,
        w = ENNReal.ofReal |Homogenization.euclideanNorm (shellGradient (omega j) x)|}
      else 0) ≤ aux_lem_band_DT4_bankmaj k z j omega := by
  unfold aux_lem_band_DT4_bankmaj
  by_cases hkj : k ≤ j
  · simp only [hkj, if_true]
    have hc : (0 : ℝ) ≤ (3 : ℝ) ^ k := by positivity
    have hb : sSup {w : ENNReal | ∃ x ∈ translatedCube d (k : ℤ) z,
        w = ENNReal.ofReal |Homogenization.euclideanNorm (shellGradient (omega j) x)|} ≤
        ENNReal.ofReal (((3 : ℝ) ^ j)⁻¹ * aux_prefix_bank_maxObs j j z omega) := by
      refine sSup_le ?_
      rintro w ⟨x, hx, rfl⟩
      refine ENNReal.ofReal_le_ofReal ?_
      have hxj : x ∈ translatedCube d (j : ℤ) z :=
        aux_lem_band_translatedCube_mono (by exact_mod_cast hkj) z hx
      have hb' := aux_prefix_bank_le_maxObs j j (le_refl j) z x omega hxj
      have hgabs : |Homogenization.euclideanNorm (shellGradient (omega j) x)| =
          Homogenization.euclideanNorm (shellGradient (omega j) x) :=
        abs_of_nonneg (Real.sqrt_nonneg _)
      rw [hgabs]
      have h3j : (0 : ℝ) < (3 : ℝ) ^ j := by positivity
      rw [inv_mul_eq_div, le_div_iff₀ h3j]
      nlinarith [abs_nonneg (omega j x)]
    have hstep := mul_le_mul_of_nonneg_left hb
      (show (0 : ℝ≥0∞) ≤ ENNReal.ofReal ((3 : ℝ) ^ k) from zero_le _)
    have heq : ENNReal.ofReal ((3 : ℝ) ^ k) *
        ENNReal.ofReal (((3 : ℝ) ^ j)⁻¹ * aux_prefix_bank_maxObs j j z omega) =
        ENNReal.ofReal ((3 : ℝ) ^ k / (3 : ℝ) ^ j * aux_prefix_bank_maxObs j j z omega) := by
      rw [← ENNReal.ofReal_mul hc]
      congr 1
      field_simp
    rwa [heq] at hstep
  · simp only [hkj, if_false]
    exact le_refl _

theorem aux_lem_band_DT4_bankmaj_first_moment {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (k : ℕ) (z : Vec d) (j : ℕ) :
    (∫⁻ omega, aux_lem_band_DT4_bankmaj k z j omega ∂M.P.toMeasure) ≤
      ENNReal.ofReal ((3 : ℝ) ^ k / (3 : ℝ) ^ j *
        (2 * aux_psf_sigma M * Real.sqrt (1 + Real.log
          (2 * (((aux_psf_cells d 0).card : ℕ) : ℝ))))) := by
  unfold aux_lem_band_DT4_bankmaj
  by_cases hkj : k ≤ j
  · simp only [hkj, if_true]
    have hc : (0 : ℝ) ≤ (3 : ℝ) ^ k / (3 : ℝ) ^ j := by positivity
    have hstep : ∀ omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d,
        ENNReal.ofReal ((3 : ℝ) ^ k / (3 : ℝ) ^ j * aux_prefix_bank_maxObs j j z omega) =
        ENNReal.ofReal ((3 : ℝ) ^ k / (3 : ℝ) ^ j) *
          ENNReal.ofReal (aux_prefix_bank_maxObs j j z omega) := by
      intro omega; rw [ENNReal.ofReal_mul hc]
    simp only [hstep]
    rw [lintegral_const_mul _ (prefix_bank_maxObs_measurable j j z).ennreal_ofReal]
    have hmom : (∫⁻ omega, ENNReal.ofReal (aux_prefix_bank_maxObs j j z omega) ∂M.P.toMeasure) ≤
        ENNReal.ofReal (2 * aux_psf_sigma M * Real.sqrt (1 + Real.log
          (2 * (((aux_psf_cells d (j - j)).card : ℕ) : ℝ)))) :=
      prefix_bank_maxObs_first_moment M j j z
    have hjj : j - j = 0 := Nat.sub_self j
    rw [hjj] at hmom
    have hfin := mul_le_mul_of_nonneg_left hmom
      (show (0 : ℝ≥0∞) ≤ ENNReal.ofReal ((3 : ℝ) ^ k / (3 : ℝ) ^ j) from zero_le _)
    rwa [← ENNReal.ofReal_mul hc] at hfin
  · simp only [hkj, if_false, lintegral_const, zero_mul]
    exact zero_le _

theorem aux_lem_band_DT4_bankmaj_summable {d : ℕ} (k : ℕ) :
    Summable (fun j : ℕ => (3 : ℝ) ^ k / (3 : ℝ) ^ j *
      (2 * (1 : ℝ) * Real.sqrt (1 + Real.log (2 * (((aux_psf_cells d 0).card : ℕ) : ℝ))))) := by
  have heq : ∀ j : ℕ, (3 : ℝ) ^ k / (3 : ℝ) ^ j *
      (2 * (1 : ℝ) * Real.sqrt (1 + Real.log (2 * (((aux_psf_cells d 0).card : ℕ) : ℝ)))) =
      ((3 : ℝ) ^ k * (2 * Real.sqrt (1 + Real.log
        (2 * (((aux_psf_cells d 0).card : ℕ) : ℝ))))) * ((3 : ℝ)⁻¹) ^ j := by
    intro j; rw [inv_pow, ← div_eq_mul_inv]; ring
  have hgeom : Summable (fun j : ℕ => ((3 : ℝ)⁻¹) ^ j) :=
    summable_geometric_of_lt_one (by norm_num) (by norm_num)
  exact (hgeom.mul_left _).congr (fun j => (heq j).symm)

theorem aux_lem_band_DT4_bankmaj_tsum_ae {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (k : ℕ) (z : Vec d) :
    ∀ᵐ omega ∂M.P.toMeasure, (∑' j : ℕ, aux_lem_band_DT4_bankmaj k z j omega) ≠ ⊤ := by
  have hmeas : ∀ j : ℕ, AEMeasurable (fun omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d =>
      aux_lem_band_DT4_bankmaj k z j omega) M.P.toMeasure :=
    fun j => (aux_lem_band_DT4_bankmaj_measurable k z j).aemeasurable
  set K : ℝ := 2 * aux_psf_sigma M * Real.sqrt (1 + Real.log
      (2 * (((aux_psf_cells d 0).card : ℕ) : ℝ))) with hK_def
  have hK0 : 0 ≤ K := by
    rw [hK_def]
    exact mul_nonneg (mul_nonneg (by norm_num) (aux_psf_sigma_pos M).le) (Real.sqrt_nonneg _)
  have hsummable : Summable (fun j : ℕ => (3 : ℝ) ^ k / (3 : ℝ) ^ j * K) := by
    have hbase := aux_lem_band_DT4_bankmaj_summable (d := d) k
    have haux_psf_sigma_eq : aux_psf_sigma M = (1 + (d:ℝ)) * M.delta := rfl
    exact hbase.mul_right (aux_psf_sigma M) |>.congr (fun j => by rw [hK_def]; ring)
  have hint : (∫⁻ omega, (∑' j : ℕ, aux_lem_band_DT4_bankmaj k z j omega) ∂M.P.toMeasure) ≠ ⊤ := by
    rw [lintegral_tsum hmeas]
    have hb : ∀ j, (∫⁻ omega, aux_lem_band_DT4_bankmaj k z j omega ∂M.P.toMeasure) ≤
        ENNReal.ofReal ((3 : ℝ) ^ k / (3 : ℝ) ^ j * K) :=
      fun j => aux_lem_band_DT4_bankmaj_first_moment M k z j
    refine ne_top_of_le_ne_top ?_ (ENNReal.tsum_le_tsum hb)
    rw [← ENNReal.ofReal_tsum_of_nonneg (fun j => by positivity) hsummable]
    exact ENNReal.ofReal_ne_top
  have hlt := ae_lt_top' (AEMeasurable.ennreal_tsum hmeas) hint
  filter_upwards [hlt] with omega hom
  exact hom.ne

theorem aux_lem_band_D_geom_tail_sum (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (a n : ℕ) :
    ∑ j ∈ (Finset.range n).filter (fun j => a < j), r ^ j ≤ r ^ (a + 1) / (1 - r) := by
  have hset : (Finset.range n).filter (fun j => a < j) = Finset.Ico (a + 1) n := by
    ext j; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Ico]; omega
  rw [hset, Finset.sum_Ico_eq_sum_range]
  have heq : (fun i => r ^ (a + 1 + i)) = (fun i => r ^ (a + 1) * r ^ i) := by
    funext i; rw [pow_add]
  rw [heq, ← Finset.mul_sum]
  have hgeom := aux_lem_band_T234_geom_sum_range_le r hr0 hr1 (n - (a + 1))
  have hrpow : 0 ≤ r ^ (a + 1) := pow_nonneg hr0 _
  calc r ^ (a + 1) * ∑ i ∈ Finset.range (n - (a + 1)), r ^ i
      ≤ r ^ (a + 1) * (1 / (1 - r)) := mul_le_mul_of_nonneg_left hgeom hrpow
    _ = r ^ (a + 1) / (1 - r) := by ring

theorem aux_lem_band_D_tsum_split (f : ℕ → ENNReal) (a : ℕ) :
    ∑' j, f j = (∑ j ∈ Finset.range (a + 1), f j) + ∑' j, (if a < j then f j else 0) := by
  have hzero : ∀ j ∉ Finset.range (a + 1), (if a < j then (0:ENNReal) else f j) = 0 := by
    intro j hj
    simp only [Finset.mem_range, not_lt] at hj
    have hlt : a < j := by omega
    simp [hlt]
  have hsplit : ∀ j, f j = (if a < j then (0:ENNReal) else f j) + (if a < j then f j else 0) := by
    intro j; by_cases hj : a < j <;> simp [hj]
  calc ∑' j, f j = ∑' j, ((if a < j then (0:ENNReal) else f j) + (if a < j then f j else 0)) := by
        simp_rw [← hsplit]
    _ = (∑' j, (if a < j then (0:ENNReal) else f j)) + ∑' j, (if a < j then f j else 0) :=
        ENNReal.tsum_add
    _ = (∑ j ∈ Finset.range (a + 1), f j) + ∑' j, (if a < j then f j else 0) := by
        congr 1
        rw [(hasSum_sum_of_ne_finset_zero hzero).tsum_eq]
        apply Finset.sum_congr rfl
        intro j hj
        simp only [Finset.mem_range] at hj
        have : ¬ (a < j) := by omega
        simp [this]

