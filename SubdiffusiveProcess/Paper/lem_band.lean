  have hwP : w0P ≤ width := (le_max_right _ _).trans (le_max_left _ _)
  have hwR : w0R ≤ width := (le_max_left _ _).trans (le_max_right _ _)
  have hwC : w0C ≤ width := (le_max_right _ _).trans (le_max_right _ _)
  have hwidth_pos : 0 < width := lt_of_lt_of_le hw0Fpos hwF
  refine ⟨a, c, width, ha_pos, hc_pos, hwidth_pos, ?_⟩
  intro p hp
  obtain ⟨qminF, hF'⟩ := hF p hp
  obtain ⟨qminP, hP'⟩ := hP p hp
  obtain ⟨qminR, hR'⟩ := hR p hp
  obtain ⟨qminC, hCw'⟩ := hCw p hp
                                                                         
  set qbase : ℝ := max (2 * p) (32 * (d : ℝ) / min s sigma) with hqbase_def
  set qhi : ℝ := max (max qminF qminP) (max qminR qminC) with hqhi_def
  set q : ℝ := max qhi qbase with hq_def
  have hq_bound : qbase ≤ q := le_max_right _ _
  have hqhi_le : qhi ≤ q := le_max_left _ _
  have hqF : qminF ≤ q := ((le_max_left _ _).trans (le_max_left _ _)).trans hqhi_le
  have hqP : qminP ≤ q := ((le_max_right _ _).trans (le_max_left _ _)).trans hqhi_le
  have hqR : qminR ≤ q := ((le_max_left _ _).trans (le_max_right _ _)).trans hqhi_le
  have hqC : qminC ≤ q := ((le_max_right _ _).trans (le_max_right _ _)).trans hqhi_le
  have hq1 : (1 : ℝ) ≤ q := by
    have h1 : (1 : ℝ) ≤ 2 * p := by linarith only [hp]
    exact h1.trans ((le_max_left _ _).trans hq_bound)
                                              
  obtain ⟨delta0F, C0F, hdelta0Fpos, hC0Fnonneg, hFpiece⟩ := hF' q hqF
  obtain ⟨delta0P, C0P, hdelta0Ppos, hC0Pnonneg, hPpiece⟩ := hP' q hqP
  obtain ⟨delta0R, C0R, hdelta0Rpos, hC0Rnonneg, hRpiece⟩ := hR' q hqR
  obtain ⟨delta0C, C0C, hdelta0Cpos, hC0Cnonneg, hCpiece⟩ := hCw' q hqC
                                                                                              
  obtain ⟨delta0_shrink, hdelta0_shrink_pos, hdelta0_shrink_le_half, h12q_shrink⟩ :=
    aux_lem_band_assembly_delta0_shrink q Cresp hq1 hCresp
                                                                          
  set delta0hi : ℝ := min (min delta0F delta0P) (min delta0R delta0C) with hdelta0hi_def
  set delta0 : ℝ := min delta0hi delta0_shrink with hdelta0_def
  have hdelta0_pos : 0 < delta0 := lt_min (lt_min (lt_min hdelta0Fpos hdelta0Ppos)
    (lt_min hdelta0Rpos hdelta0Cpos)) hdelta0_shrink_pos
  have hdelta0_le_hi : delta0 ≤ delta0hi := min_le_left _ _
  have hdelta0_le_shrink : delta0 ≤ delta0_shrink := min_le_right _ _
  have hdelta0_le_F : delta0 ≤ delta0F :=
    hdelta0_le_hi.trans ((min_le_left _ _).trans (min_le_left _ _))
  have hdelta0_le_P : delta0 ≤ delta0P :=
    hdelta0_le_hi.trans ((min_le_left _ _).trans (min_le_right _ _))
  have hdelta0_le_R : delta0 ≤ delta0R :=
    hdelta0_le_hi.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hdelta0_le_C : delta0 ≤ delta0C :=
    hdelta0_le_hi.trans ((min_le_right _ _).trans (min_le_right _ _))
                                                                                           
