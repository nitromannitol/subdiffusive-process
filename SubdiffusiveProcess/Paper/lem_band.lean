  intro M hMdelta Rm hRmC Sreg It H hH eta heta F Praw Rraw Draw Z rawGood hprim hDbaseline sidePos unitA hunitA h12q N n z hn hoffset kappa retained reference coords h hh
  have hM1 : ∀ i, M.delta ≤ delta01 i := fun i => hMdelta.trans (hdelta0_le1 i)
  have hM2 : ∀ i, M.delta ≤ delta02 i := fun i => hMdelta.trans (hdelta0_le2 i)
  have hM3 : ∀ i, M.delta ≤ delta03 i := fun i => hMdelta.trans (hdelta0_le3 i)
  have hM4 : ∀ i, M.delta ≤ delta04 i := fun i => hMdelta.trans (hdelta0_le4 i)
  have hM5 : ∀ i, M.delta ≤ delta05 i := fun i => hMdelta.trans (hdelta0_le5 i)
  have hM6 : ∀ i, M.delta ≤ delta06 i := fun i => hMdelta.trans (hdelta0_le6 i)
  have hM7 : ∀ i, M.delta ≤ delta07 i := fun i => hMdelta.trans (hdelta0_le7 i)
  choose Yband1 hYband1meas hYband1bound using
    (fun i => hUse1 i M (hM1 i) Rm hRmC Sreg It H hH sidePos unitA hunitA N n z hn (hoffset i) h hh)
  choose Yband2 hYband2meas hYband2bound using
    (fun i => hUse2 i M (hM2 i) Rm hRmC Sreg It H hH sidePos unitA hunitA N n z hn (hoffset i) h hh)
  choose Yband3 hYband3meas hYband3bound using
    (fun i => hUse3 i M (hM3 i) Rm hRmC Sreg It H hH sidePos unitA hunitA N n z hn (hoffset i) h hh)
  choose Yband4 hYband4meas hYband4bound using
    (fun i ei ej => hUse4 i M (hM4 i) Rm hRmC Sreg It H hH sidePos unitA hunitA N n z hn (hoffset i)
      h hh ei ej)
  choose Yband5 hYband5meas hYband5bound using
    (fun i ei ej => hUse5 i M (hM5 i) Rm hRmC Sreg It H hH sidePos unitA hunitA N n z hn (hoffset i)
      h hh ei ej)
  choose Yband6 hYband6meas hYband6bound using
    (fun i => hUse6 i M (hM6 i) Rm hRmC Sreg It H hH sidePos unitA hunitA N n z hn (hoffset i) h hh)
  choose Yband7 hYband7meas hYband7bound using
    (fun i => hUse7 i M (hM7 i) Rm H hH N n z hn (hoffset i) h hh)
  have hYmeas : ∀ (i : Fin T) (j : Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)),
      AEStronglyMeasurable (fun omega => coords omega i j) (chaosSampleLaw M).toMeasure :=
    aux_lem_band_piece_coords_value_measurable d hd I _Poincare _Extension Cresp hCresp
      s sigma hs hsigma T offset shift M Rm Sreg It H hH sidePos unitA hunitA N n z hn hoffset
  set YbandFn : BilateralField d → Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ :=
    fun omega i => Sum.elim
      (fun j => if j = 0 then Yband1 i omega else if j = 1 then Yband2 i omega
        else Yband3 i omega)
      (Sum.elim
        (fun ij => if ij.1 then Yband4 i ij.2.1 ij.2.2 omega else Yband5 i ij.2.1 ij.2.2 omega)
        (fun j => if j = 0 then Yband6 i omega else Yband7 i omega))
    with hYbandFndef
  set rateFn : Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ :=
    fun i => Sum.elim
      (fun j => if j = 0 then C01 i * M.delta ^ (c01 i) * (3 : ℝ) ^ (-(a01 i * (h : ℝ)))
        else if j = 1 then C02 i * M.delta ^ (c02 i) * (3 : ℝ) ^ (-(a02 i * (h : ℝ)))
        else C03 i * M.delta ^ (c03 i) * (3 : ℝ) ^ (-(a03 i * (h : ℝ))))
      (Sum.elim
        (fun ij => if ij.1 then C04 i * M.delta ^ (c04 i) * (3 : ℝ) ^ (-(a04 i * (h : ℝ)))
          else C05 i * M.delta ^ (c05 i) * (3 : ℝ) ^ (-(a05 i * (h : ℝ))))
        (fun j => if j = 0 then C06 i * M.delta ^ (c06 i) * (3 : ℝ) ^ (-(a06 i * (h : ℝ)))
          else C07 i * M.delta ^ (c07 i) * (3 : ℝ) ^ (-(a07 i * (h : ℝ)))))
    with hrateFndef
  have hYbandmeas : ∀ (i : Fin T) (j : Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)),
      AEStronglyMeasurable[aux_lem_band_piece_coords_bandOf d n h w0]
        (fun omega => YbandFn omega i j) (chaosSampleLaw M).toMeasure := by
    intro i j
    rw [hYbandFndef]
    rcases j with j0 | ij | j2
    · fin_cases j0 <;> simp only [Sum.elim_inl] <;>
        [skip; skip; skip] <;>
        first
        | exact aux_lem_band_piece_coords_band_widen (chaosSampleLaw M).toMeasure n h (w01 i) w0 (hw0_ge1 i) (hYband1meas i)
        | exact aux_lem_band_piece_coords_band_widen (chaosSampleLaw M).toMeasure n h (w02 i) w0 (hw0_ge2 i) (hYband2meas i)
        | exact aux_lem_band_piece_coords_band_widen (chaosSampleLaw M).toMeasure n h (w03 i) w0 (hw0_ge3 i) (hYband3meas i)
    · rcases ij with ⟨b, ei, ej⟩
      cases b <;> simp only [Sum.elim_inr, Sum.elim_inl] <;>
        first
        | exact aux_lem_band_piece_coords_band_widen (chaosSampleLaw M).toMeasure n h (w04 i) w0 (hw0_ge4 i)
            (hYband4meas i ei ej)
        | exact aux_lem_band_piece_coords_band_widen (chaosSampleLaw M).toMeasure n h (w05 i) w0 (hw0_ge5 i)
            (hYband5meas i ei ej)
    · fin_cases j2 <;> simp only [Sum.elim_inr] <;>
        first
        | exact aux_lem_band_piece_coords_band_widen (chaosSampleLaw M).toMeasure n h (w06 i) w0 (hw0_ge6 i) (hYband6meas i)
        | exact aux_lem_band_piece_coords_band_widen (chaosSampleLaw M).toMeasure n h (w07 i) w0 (hw0_ge7 i) (hYband7meas i)
  have hMdeltapos : 0 < M.delta := M.shellPrefix.delta_pos
  have hnonneg_term : ∀ C c a : ℝ, 0 ≤ C →
      0 ≤ C * M.delta ^ c * (3 : ℝ) ^ (-(a * (h : ℝ))) := fun C c a hC =>
    mul_nonneg (mul_nonneg hC (Real.rpow_nonneg hMdeltapos.le c))
      (Real.rpow_nonneg (by norm_num) _)
  have hratenonneg : ∀ i j, 0 ≤ rateFn i j := by
    intro i j
    rw [hrateFndef]
    rcases j with j0 | ij | j2
    · fin_cases j0 <;> simp only [Sum.elim_inl] <;>
        first
        | exact hnonneg_term _ _ _ (hC01 i)
        | exact hnonneg_term _ _ _ (hC02 i)
        | exact hnonneg_term _ _ _ (hC03 i)
    · rcases ij with ⟨b, ei, ej⟩
      cases b <;> simp only [Sum.elim_inr, Sum.elim_inl] <;>
        first
        | exact hnonneg_term _ _ _ (hC04 i)
        | exact hnonneg_term _ _ _ (hC05 i)
    · fin_cases j2 <;> simp only [Sum.elim_inr] <;>
        first
        | exact hnonneg_term _ _ _ (hC06 i)
        | exact hnonneg_term _ _ _ (hC07 i)
  have hbound : ∀ (i : Fin T) (j : Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)),
      eLpNorm (fun omega => coords omega i j - YbandFn omega i j) (ENNReal.ofReal p)
        (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (rateFn i j) := by
    intro i j
    rw [hYbandFndef, hrateFndef]
    rcases j with j0 | ij | j2
    · fin_cases j0 <;> simp only [Sum.elim_inl, coords] <;>
        first
        | exact hYband1bound i
        | exact hYband2bound i
        | exact hYband3bound i
    · rcases ij with ⟨b, ei, ej⟩
      cases b <;> simp only [Sum.elim_inr, Sum.elim_inl, coords] <;>
        first
        | exact hYband4bound i ei ej
        | exact hYband5bound i ei ej
    · fin_cases j2 <;> simp only [Sum.elim_inr, coords] <;>
        first
        | exact hYband6bound i
        | exact hYband7bound i
  have hp' : (1 : ENNReal) ≤ ENNReal.ofReal p := by
    rw [show (1 : ENNReal) = ENNReal.ofReal 1 from ENNReal.ofReal_one.symm]
    exact ENNReal.ofReal_le_ofReal hp
  obtain ⟨Z, hZmeas, hZbound⟩ :=
    aux_lem_band_piece_coords_combine M n h w0 Klip Phi hPhiLip coords YbandFn hYmeas hYbandmeas
      (ENNReal.ofReal p) hp' rateFn hratenonneg hbound
  refine ⟨Z, hZmeas, ?_⟩
  refine hZbound.trans ?_
  apply ENNReal.ofReal_le_ofReal
  have hdelta_le1 : M.delta ≤ 1 := hMdelta.trans hdelta0le1
  have hdom_term : ∀ (C ck ak : ℝ), 0 ≤ C → c0 ≤ ck → a0 ≤ ak →
      C * M.delta ^ ck * (3 : ℝ) ^ (-(ak * (h : ℝ))) ≤
        C * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by
    intro C ck ak hC hck hak
    have h1 : C * M.delta ^ ck ≤ C * M.delta ^ c0 :=
      mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hMdeltapos hdelta_le1 hck) hC
    have h2 : (3 : ℝ) ^ (-(ak * (h : ℝ))) ≤ (3 : ℝ) ^ (-(a0 * (h : ℝ))) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num)
        (by nlinarith [mul_le_mul_of_nonneg_right hak (Nat.cast_nonneg h : (0:ℝ) ≤ (h : ℝ))])
    exact mul_le_mul h1 h2 (Real.rpow_nonneg (by norm_num) _)
      (mul_nonneg hC (Real.rpow_nonneg hMdeltapos.le _))
  have hpointdom : ∀ i j, rateFn i j ≤ CoefOf i j * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by
    intro i j
    rw [hrateFndef, hCoefOfdef]
    rcases j with j0 | ij | j2
    · fin_cases j0 <;> simp only [Sum.elim_inl] <;>
        first
        | exact hdom_term _ _ _ (hC01 i) (hc0_le1 i) (ha0_le1 i)
        | exact hdom_term _ _ _ (hC02 i) (hc0_le2 i) (ha0_le2 i)
        | exact hdom_term _ _ _ (hC03 i) (hc0_le3 i) (ha0_le3 i)
    · rcases ij with ⟨b, ei, ej⟩
      cases b <;> simp only [Sum.elim_inr, Sum.elim_inl] <;>
        first
        | exact hdom_term _ _ _ (hC04 i) (hc0_le4 i) (ha0_le4 i)
        | exact hdom_term _ _ _ (hC05 i) (hc0_le5 i) (ha0_le5 i)
    · fin_cases j2 <;> simp only [Sum.elim_inr] <;>
        first
        | exact hdom_term _ _ _ (hC06 i) (hc0_le6 i) (ha0_le6 i)
        | exact hdom_term _ _ _ (hC07 i) (hc0_le7 i) (ha0_le7 i)
  have hsumdom : (∑ i : Fin T, ∑ j, rateFn i j) ≤
      Craw * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by
    have hstep : (∑ i : Fin T, ∑ j, rateFn i j) ≤
        ∑ i : Fin T, ∑ j, CoefOf i j * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by
      apply Finset.sum_le_sum
      intro i _
      apply Finset.sum_le_sum
      intro j _
      exact hpointdom i j
    have heq : (∑ i : Fin T, ∑ j, CoefOf i j * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) =
        Craw * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by
      rw [hCrawdef, Finset.sum_mul, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      rw [Finset.sum_mul, Finset.sum_mul]
    rw [heq] at hstep
    exact hstep
  calc (Klip : ℝ) * ∑ i : Fin T, ∑ j, rateFn i j
      ≤ (Klip : ℝ) * (Craw * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
        apply mul_le_mul_of_nonneg_left hsumdom (by positivity)
    _ = C0 * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) := by rw [hC0def]; ring

theorem aux_lem_band_meas_coords
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d)
    (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (_D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s sigma eps : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1)
    (_heps : eps ∈ Set.Ioo (0 : ℝ) 1)
    (T : ℕ) (offset : Fin T → ℤ) (shift : Fin T → SpatialCoordinates d)
    (weight : Fin 4 → ℝ) (_hweight : ∀ i, 0 ≤ weight i)
    (Klip : ℝ≥0)
    (Phi : (Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ) → ℝ)
    (hPhiLip : LipschitzWith Klip Phi) (_hPhi0 : Phi 0 = 0)
    (_hPhiNonneg : ∀ x, 0 ≤ Phi x)
    (CD : ℝ → ℝ) (_hCD : ∀ p, 1 ≤ p → 0 < CD p)
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (Rm : _root_.SubdiffusiveProcess.Paper.in_responses d M) (_hRm : Rm.C ≤ Cresp)
    (Sreg : _root_.SubdiffusiveProcess.Paper.in_6_16 d M) (_It : _root_.SubdiffusiveProcess.Paper.in_iteration d M I Sreg)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ))
    (hInfrared : InfraredCharacterization M H)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (_heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (_hprim : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
      primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (q : ℝ)
    (_hDbaseline : ∀ (N n : ℕ) (z : Vec d),
      MemLp (fun omega => (Draw N n z omega).toReal)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega => (Draw N n z omega).toReal)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (CD q * M.delta ^ (1 / 2 : ℝ)))
    (sidePos : ∀ n : ℤ, 0 < (3 : ℝ) ^ (-n))
    (unitA : ∀ (n : ℤ) (z : SpatialCoordinates d),
      PositiveCoefficient (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n)))
    (hunita : ∀ n z, (unitA n z).val =ᵐ[volume.restrict
      (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n) : Set (SpatialCoordinates d))]
        (fun _ => (1 : ℝ))) :
    ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) →
      (∀ i : Fin T, n + offset i ≤ (N : ℤ)) →
      let kappa : ℕ → ℝ := fun J =>
        Real.exp (((J : ℝ) + 1) * _root_.SubdiffusiveProcess.Model.tauSq M.P) * ahom M J
      let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
        fun n z omega => if 0 ≤ n then ∑ j ∈ Finset.Ico (0 : ℤ) n, omega (-j) z
          else -∑ j ∈ Finset.Ico n (0 : ℤ), omega (-j) z
      let reference : ℕ → ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
        fun N n z omega => kappa ((N : ℤ) - n).toNat / kappa N *
          Real.exp (H omega z + retained n z omega)
      let coords : BilateralField d →
          Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ :=
        fun omega i =>
          let m := n + offset i
          let w := z + ((3 : ℝ) ^ (-n)) • shift i
          let r := (3 : ℝ) ^ (-m)
          let aN := _root_.SubdiffusiveProcess.EllipticRegularity.cutoffPositiveCoefficient M H omega N w (sidePos m)
          let ref := reference N m w omega
          Sum.elim
            (fun j => if j = 0 then
              I.lam w r (sidePos m) aN w r sigma 2 / ref -
                I.lam w r (sidePos m) (unitA m w) w r sigma 2
            else if j = 1 then
              I.Lam w r (sidePos m) aN w r sigma 2 / ref -
                I.Lam w r (sidePos m) (unitA m w) w r sigma 2
            else ref / I.lam w r (sidePos m) aN w r sigma 2 -
              (I.lam w r (sidePos m) (unitA m w) w r sigma 2)⁻¹)
            (Sum.elim
              (fun ij =>
                (if ij.1 then (Homogenization.Book.Ch02.sigmaCoarse
                  (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
                  ((I.chart w r (sidePos m) aN w r).coeffOn
                    (Homogenization.originCube d 0))) ij.2.1 ij.2.2 / ref
                else ref * (Homogenization.Book.Ch02.sigmaStarInvCoarse
                  (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
                  ((I.chart w r (sidePos m) aN w r).coeffOn
                    (Homogenization.originCube d 0))) ij.2.1 ij.2.2) -
                (if ij.2.1 = ij.2.2 then 1 else 0))
              (fun j => if j = 0 then I.err w r (sidePos m) aN w r ref s 2
                else reference N n z omega / ref - 1))
      AEStronglyMeasurable (fun omega => Phi (coords omega)) (chaosSampleLaw M).toMeasure := by
  classical
  intro N n z hnN hoffN kappa retained reference coords
  have hcoords := aux_lem_band_piece_coords_value_measurable d hd I _Poincare _Extension
    Cresp hCresp s sigma hs hsigma T offset shift M Rm Sreg _It H hInfrared sidePos unitA hunita
    N n z hnN hoffN
  choose g hgmeas hgae using hcoords
  have hGmeas : Measurable (fun omega i j => g i j omega) :=
    Measurable.of_eval (fun i => Measurable.of_eval (fun j => (hgmeas i j).measurable))
  have hPhimeas : Measurable Phi := hPhiLip.continuous.measurable
  have hae : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ i j, coords omega i j = g i j omega := by
    rw [ae_all_iff]
    intro i
    rw [ae_all_iff]
    intro j
    exact hgae i j
  have heq : (fun omega => Phi (fun i j => g i j omega)) =ᵐ[(chaosSampleLaw M).toMeasure]
      (fun omega => Phi (coords omega)) := by
    filter_upwards [hae] with omega homega
    have hfun : (fun i j => g i j omega) = coords omega := by
      funext i j
      exact (homega i j).symm
    rw [hfun]
  exact ((hPhimeas.comp hGmeas).stronglyMeasurable.aestronglyMeasurable).congr heq

theorem aux_lem_band_assembly_x2log_mono :
    ∀ x y : ℝ, 0 < x → x ≤ y → y ≤ 1 / 2 → x ^ 2 * |Real.log x| ≤ y ^ 2 * |Real.log y| := by
  intro x y hxpos hxley hyle
  have hypos : 0 < y := lt_of_lt_of_le hxpos hxley
  have hxhalf : x ≤ 1/2 := le_trans hxley hyle
  have hyhalf : y ≤ 1/2 := hyle
  have hlogx_nonpos : Real.log x ≤ 0 := Real.log_nonpos (by linarith) (by linarith)
  have hlogy_nonpos : Real.log y ≤ 0 := Real.log_nonpos (by linarith) (by linarith)
  have habsx : |Real.log x| = -Real.log x := abs_of_nonpos hlogx_nonpos
  have habsy : |Real.log y| = -Real.log y := abs_of_nonpos hlogy_nonpos
  rw [habsx, habsy]
  set f : ℝ → ℝ := fun t => -(t ^ 2 * Real.log t) with hf_def
  set f' : ℝ → ℝ := fun t => t * (-2 * Real.log t - 1) with hf'_def
  have h_conv : Convex ℝ (Set.Ioc (0 : ℝ) (1/2)) := convex_Ioc _ _
  have hf_cont : ContinuousOn f (Set.Ioc (0 : ℝ) (1/2)) := by
    intro t ht
    have htpos : 0 < t := ht.1
    have h_cont : ContinuousAt (fun (s : ℝ) => s ^ 2 * Real.log s) t :=
      ((continuous_pow 2).continuousAt.mul (Real.continuousAt_log (ne_of_gt htpos)))
    exact ContinuousAt.neg h_cont |>.continuousWithinAt
  have h_deriv : ∀ t ∈ interior (Set.Ioc (0 : ℝ) (1/2)),
      HasDerivWithinAt f (f' t) (interior (Set.Ioc (0 : ℝ) (1/2))) t := by
    intro t ht
    have ht_mem : t ∈ Set.Ioo (0 : ℝ) (1/2) := by
      simpa [interior_Ioc] using ht
    have htpos : 0 < t := ht_mem.1
    have h_deriv_at : HasDerivAt f (f' t) t := by
      dsimp [f, f']
      have h_pow : HasDerivAt (fun (s : ℝ) => s ^ 2) ((2 : ℝ) * t) t := by
        simpa using hasDerivAt_pow 2 t
      have h_log : HasDerivAt Real.log (t⁻¹) t := Real.hasDerivAt_log (ne_of_gt htpos)
      have h_prod : HasDerivAt (fun (s : ℝ) => s ^ 2 * Real.log s)
          (((2 : ℝ) * t) * Real.log t + t ^ 2 * t⁻¹) t :=
        HasDerivAt.mul h_pow h_log
      have h_simp : ((2 : ℝ) * t) * Real.log t + t ^ 2 * t⁻¹ = (2 : ℝ) * t * Real.log t + t := by
        have h_pow_simp : t ^ 2 * t⁻¹ = t := by
          field_simp [htpos.ne.symm]
        calc
          ((2 : ℝ) * t) * Real.log t + t ^ 2 * t⁻¹ = ((2 : ℝ) * t) * Real.log t + t := by rw [h_pow_simp]
          _ = (2 : ℝ) * t * Real.log t + t := by ring
      have h_prod' : HasDerivAt (fun (s : ℝ) => s ^ 2 * Real.log s)
          ((2 : ℝ) * t * Real.log t + t) t := by
        simpa [h_simp] using h_prod
      have h_neg : HasDerivAt (fun (s : ℝ) => -(s ^ 2 * Real.log s))
          (-((2 : ℝ) * t * Real.log t + t)) t :=
        HasDerivAt.neg h_prod'
      have h_target : -((2 : ℝ) * t * Real.log t + t) = t * (-2 * Real.log t - 1) := by ring
      simpa [h_target] using h_neg
    exact h_deriv_at.hasDerivWithinAt
  have h_deriv_pos : ∀ t ∈ interior (Set.Ioc (0 : ℝ) (1/2)), 0 < f' t := by
    intro t ht
    have ht_mem : t ∈ Set.Ioo (0 : ℝ) (1/2) := by
      simpa [interior_Ioc] using ht
    have htpos : 0 < t := ht_mem.1
    have hthalf : t ≤ 1/2 := le_of_lt ht_mem.2
    dsimp [f']
    have hlog_le : Real.log t ≤ Real.log (1/2) :=
      Real.log_le_log (by linarith) hthalf
    have hlog_half_lt : Real.log (1/2) < -1/2 := by
      have := Real.log_lt_sub_one_of_pos (by norm_num : (0 : ℝ) < 1/2) (by norm_num : (1/2 : ℝ) ≠ 1)
      linarith
    have hlog_lt : Real.log t < -1/2 := lt_of_le_of_lt hlog_le hlog_half_lt
    have hpos : 0 < -2 * Real.log t - 1 := by linarith
    exact mul_pos htpos hpos
  have h_mono : StrictMonoOn f (Set.Ioc (0 : ℝ) (1/2)) :=
    strictMonoOn_of_hasDerivWithinAt_pos h_conv hf_cont h_deriv h_deriv_pos
  have hx_mem : x ∈ Set.Ioc (0 : ℝ) (1/2) := ⟨hxpos, hxhalf⟩
  have hy_mem : y ∈ Set.Ioc (0 : ℝ) (1/2) := ⟨hypos, hyhalf⟩
  rcases lt_or_eq_of_le hxley with (hxy_lt | hxy_eq)
  · have h := h_mono hx_mem hy_mem hxy_lt
    dsimp [f] at h
    linarith
  · subst hxy_eq
    exact le_rfl

theorem aux_lem_band_assembly_delta0_shrink (q Cresp : ℝ) (hq1 : 1 ≤ q) (hCresp : 0 < Cresp) :
    ∃ delta0_shrink : ℝ, 0 < delta0_shrink ∧ delta0_shrink ≤ 1/2 ∧
      12 * q ≤ Cresp⁻¹ * (delta0_shrink ^ 2)⁻¹ * |Real.log delta0_shrink|⁻¹ := by
  have hq_pos : 0 < q := by linarith only [hq1]
  set tshrink : ℝ := 12 * q * Cresp with htshrink_def
  have htshrink_pos : 0 < tshrink := by rw [htshrink_def]; positivity
  set delta0shrink_raw : ℝ := (tshrink + 1)⁻¹ with hdelta0shrink_raw_def
  have hdelta0shrink_raw_pos : 0 < delta0shrink_raw := by
    rw [hdelta0shrink_raw_def]; exact inv_pos.mpr (by linarith)
  set delta0_shrink : ℝ := min delta0shrink_raw (1/4) with hdelta0_shrink_def
  have hdelta0_shrink_pos : 0 < delta0_shrink :=
    lt_min hdelta0shrink_raw_pos (by norm_num)
  have hdelta0_shrink_le_quarter : delta0_shrink ≤ 1/4 := min_le_right _ _
  have hdelta0_shrink_le_half : delta0_shrink ≤ 1/2 := by linarith
  refine ⟨delta0_shrink, hdelta0_shrink_pos, hdelta0_shrink_le_half, ?_⟩
  have hlog_val : Real.log ((tshrink + 1)⁻¹) = -Real.log (tshrink + 1) :=
    Real.log_inv (tshrink + 1)
  have hlog_pos : 0 < Real.log (tshrink + 1) :=
    Real.log_pos (by linarith [htshrink_pos] : 1 < tshrink + 1)
  have h_ineq : tshrink * Real.log (tshrink + 1) ≤ (tshrink + 1) ^ 2 := by
    have hlog_le_t : Real.log (tshrink + 1) ≤ tshrink := by
      calc
        Real.log (tshrink + 1) ≤ (tshrink + 1) - 1 :=
          Real.log_le_sub_one_of_pos (by linarith : 0 < tshrink + 1)
        _ = tshrink := by ring
    have h5 : tshrink * Real.log (tshrink + 1) ≤ tshrink * tshrink :=
      mul_le_mul_of_nonneg_left hlog_le_t (by linarith)
    have h6 : tshrink * tshrink ≤ (tshrink + 1) ^ 2 := by nlinarith
    linarith
  have h_sq_inv : (((tshrink + 1)⁻¹) ^ 2)⁻¹ = (tshrink + 1) ^ 2 := by field_simp
  have h_abslog : |Real.log ((tshrink + 1)⁻¹)| = Real.log (tshrink + 1) := by
    rw [hlog_val, abs_neg, abs_of_pos hlog_pos]
  have h_eq : 12 * q = tshrink / Cresp := by field_simp [htshrink_def]; ring
  rw [h_eq, hdelta0_shrink_def]
  by_cases h_raw_le : (tshrink + 1)⁻¹ ≤ 1/4
  · have h_min_eq : min ((tshrink + 1)⁻¹) (1/4) = (tshrink + 1)⁻¹ := min_eq_left h_raw_le
    rw [h_min_eq, h_sq_inv, h_abslog]
    have h_div : tshrink / Cresp ≤ ((tshrink + 1) ^ 2 / Real.log (tshrink + 1)) / Cresp := by
      field_simp [hCresp.ne']
      exact h_ineq
    calc
      tshrink / Cresp = (tshrink / Cresp) := rfl
      _ ≤ (((tshrink + 1) ^ 2 / Real.log (tshrink + 1)) / Cresp) := h_div
      _ = Cresp⁻¹ * (tshrink + 1) ^ 2 * (Real.log (tshrink + 1))⁻¹ := by ring
  · have h_min_eq : min ((tshrink + 1)⁻¹) (1/4) = 1/4 := min_eq_right (by linarith)
    rw [h_min_eq]
    have ht_lt_three : tshrink < 3 := by
      have hpos' : 0 < tshrink + 1 := by linarith [htshrink_pos]
      have h_gt : (1 : ℝ) / 4 < (tshrink + 1)⁻¹ := lt_of_not_ge h_raw_le
      have h7 : (tshrink + 1) * (1 / 4) < (tshrink + 1) * (tshrink + 1)⁻¹ :=
        mul_lt_mul_of_pos_left h_gt hpos'
      rw [mul_inv_cancel₀ (ne_of_gt hpos')] at h7
      nlinarith
    have h_target : tshrink ≤ 16 * |Real.log (1/4)|⁻¹ := by
      have hlog4_pos : 0 < |Real.log (1/4)| := by
        have hlog4 : Real.log (1/4) < 0 := Real.log_neg (by norm_num) (by norm_num)
        rw [abs_of_neg hlog4]
        linarith [Real.log_pos (by norm_num : 1 < (4 : ℝ))]
      have h_three_le : (3 : ℝ) ≤ 16 * |Real.log (1/4)|⁻¹ := by
        have hlog4_val : |Real.log (1/4)| = Real.log 4 := by
          rw [show Real.log (1/4) = -Real.log 4 by
            rw [Real.log_div (by norm_num : (1 : ℝ) ≠ 0) (by norm_num : (4 : ℝ) ≠ 0),
              Real.log_one, zero_sub],
            abs_neg, abs_of_pos (Real.log_pos (by norm_num : 1 < (4 : ℝ)))]
        rw [hlog4_val]
        have hlog4_le_3 : Real.log 4 ≤ 3 := by
          calc
            Real.log 4 ≤ 4 - 1 := Real.log_le_sub_one_of_pos (by norm_num : 0 < (4 : ℝ))
            _ = 3 := by ring
        have hlog4_pos' : 0 < Real.log 4 := Real.log_pos (by norm_num)
        rw [show (16 : ℝ) * (Real.log 4)⁻¹ = 16 / Real.log 4 from by ring,
          le_div_iff₀ hlog4_pos']
        nlinarith
      linarith
    calc
      tshrink / Cresp ≤ (16 * |Real.log (1/4)|⁻¹) / Cresp := by gcongr
      _ = Cresp⁻¹ * ((1/4) ^ 2)⁻¹ * |Real.log (1/4)|⁻¹ := by ring

theorem aux_lem_band_assembly_widen
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (mu : Measure (BilateralField d)) (n : ℤ) (h w1 w0 : ℕ) (hw : w1 ≤ w0)
    {f : BilateralField d → ℝ}
    (hf : AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (w1 * (h + 1) : ℕ)) (-n + (w1 * (h + 1) : ℕ)) => omega (j : ℤ))
        inferInstance] f mu) :
    AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ))
        inferInstance] f mu := by
  set lo1 : ℤ := -n - (w1 * (h + 1) : ℕ) with hlo1def
  set hi1 : ℤ := -n + (w1 * (h + 1) : ℕ) with hhi1def
  set lo0 : ℤ := -n - (w0 * (h + 1) : ℕ) with hlo0def
  set hi0 : ℤ := -n + (w0 * (h + 1) : ℕ) with hhi0def
  have hwnat : (w1 * (h + 1) : ℕ) ≤ (w0 * (h + 1) : ℕ) := Nat.mul_le_mul_right _ hw
  have hlo : lo0 ≤ lo1 := by
    rw [hlo0def, hlo1def]
    have : ((w1 * (h + 1) : ℕ) : ℤ) ≤ ((w0 * (h + 1) : ℕ) : ℤ) := by exact_mod_cast hwnat
    omega
  have hhi : hi1 ≤ hi0 := by
    rw [hhi0def, hhi1def]
    have : ((w1 * (h + 1) : ℕ) : ℤ) ≤ ((w0 * (h + 1) : ℕ) : ℤ) := by exact_mod_cast hwnat
    omega
  set projSmall : BilateralField d → (Set.Icc lo1 hi1 → C(SpatialCoordinates d, ℝ)) :=
    fun omega j => omega (j : ℤ) with hprojSmalldef
  set projBig : BilateralField d → (Set.Icc lo0 hi0 → C(SpatialCoordinates d, ℝ)) :=
    fun omega j => omega (j : ℤ) with hprojBigdef
  set incl : Set.Icc lo1 hi1 → Set.Icc lo0 hi0 :=
    fun j => ⟨j.1, ⟨hlo.trans j.2.1, j.2.2.trans hhi⟩⟩ with hincldef
  set restrict : (Set.Icc lo0 hi0 → C(SpatialCoordinates d, ℝ)) →
      (Set.Icc lo1 hi1 → C(SpatialCoordinates d, ℝ)) :=
    fun g j => g (incl j) with hrestrictdef
  have hrestrict_meas : Measurable restrict :=
    Measurable.of_eval (fun j => measurable_pi_apply (incl j))
  have hfactor : projSmall = restrict ∘ projBig := by
    funext omega j
    rfl
  have hmono : MeasurableSpace.comap projSmall inferInstance ≤
      MeasurableSpace.comap projBig inferInstance := by
    calc MeasurableSpace.comap projSmall inferInstance
        = MeasurableSpace.comap (restrict ∘ projBig) inferInstance := by rw [hfactor]
      _ = MeasurableSpace.comap projBig (MeasurableSpace.comap restrict inferInstance) :=
          (MeasurableSpace.comap_comp).symm
      _ ≤ MeasurableSpace.comap projBig inferInstance :=
          MeasurableSpace.comap_mono hrestrict_meas.comap_le
  obtain ⟨g, hg, hfg⟩ := hf
  exact ⟨g, hg.mono hmono, hfg⟩

theorem aux_lem_band_assembly_band_le {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (n : ℤ) (h w0 : ℕ) :
    MeasurableSpace.comap (fun omega : BilateralField d =>
        fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ))
      inferInstance ≤ (inferInstance : MeasurableSpace (BilateralField d)) :=
  (Set.measurable_restrict _).comap_le

theorem aux_lem_band_assembly_rate_dom {delta a c a0 c0 : ℝ} (hdelta0 : 0 < delta)
    (hdelta1 : delta ≤ 1) (ha : a ≤ a0) (hc : c ≤ c0) (h : ℕ) :
    delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))) ≤ delta ^ c * (3 : ℝ) ^ (-(a * (h : ℝ))) := by
  have h1 : delta ^ c0 ≤ delta ^ c := Real.rpow_le_rpow_of_exponent_ge hdelta0 hdelta1 hc
  have h2 : (3 : ℝ) ^ (-(a0 * (h : ℝ))) ≤ (3 : ℝ) ^ (-(a * (h : ℝ))) := by
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have hah : a * (h : ℝ) ≤ a0 * (h : ℝ) := mul_le_mul_of_nonneg_right ha (Nat.cast_nonneg h)
    linarith
  exact mul_le_mul h1 h2 (Real.rpow_nonneg (by norm_num) _) (Real.rpow_nonneg hdelta0.le _)

theorem aux_lem_band_assembly_combine4 {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (mu : Measure (BilateralField d)) (p : ℝ)
    (hp : 1 ≤ p) (f1 f2 f3 f4 : BilateralField d → ℝ) (b1 b2 b3 b4 : ℝ)
    (_hm1 : AEStronglyMeasurable f1 mu) (_hm2 : AEStronglyMeasurable f2 mu)
    (_hm3 : AEStronglyMeasurable f3 mu) (_hm4 : AEStronglyMeasurable f4 mu)
    (hb1 : 0 ≤ b1) (hb2 : 0 ≤ b2) (hb3 : 0 ≤ b3) (hb4 : 0 ≤ b4)
    (he1 : eLpNorm f1 (ENNReal.ofReal p) mu ≤ ENNReal.ofReal b1)
    (he2 : eLpNorm f2 (ENNReal.ofReal p) mu ≤ ENNReal.ofReal b2)
    (he3 : eLpNorm f3 (ENNReal.ofReal p) mu ≤ ENNReal.ofReal b3)
    (he4 : eLpNorm f4 (ENNReal.ofReal p) mu ≤ ENNReal.ofReal b4) :
    eLpNorm (fun omega => f1 omega + f2 omega + f3 omega + f4 omega) (ENNReal.ofReal p) mu ≤
      ENNReal.ofReal (b1 + b2 + b3 + b4) := by
  have hp' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp
  have e3 : eLpNorm (fun omega => f1 omega + f2 omega) (ENNReal.ofReal p) mu ≤
      eLpNorm f1 (ENNReal.ofReal p) mu + eLpNorm f2 (ENNReal.ofReal p) mu :=
    eLpNorm_add_le hp'
  have e2 : eLpNorm (fun omega => f1 omega + f2 omega + f3 omega) (ENNReal.ofReal p) mu ≤
      eLpNorm (fun omega => f1 omega + f2 omega) (ENNReal.ofReal p) mu +
        eLpNorm f3 (ENNReal.ofReal p) mu :=
    eLpNorm_add_le hp'
  have e1 : eLpNorm (fun omega => f1 omega + f2 omega + f3 omega + f4 omega) (ENNReal.ofReal p) mu ≤
      eLpNorm (fun omega => f1 omega + f2 omega + f3 omega) (ENNReal.ofReal p) mu +
        eLpNorm f4 (ENNReal.ofReal p) mu :=
    eLpNorm_add_le hp'
  calc eLpNorm (fun omega => f1 omega + f2 omega + f3 omega + f4 omega) (ENNReal.ofReal p) mu
      ≤ eLpNorm (fun omega => f1 omega + f2 omega + f3 omega) (ENNReal.ofReal p) mu +
          eLpNorm f4 (ENNReal.ofReal p) mu := e1
    _ ≤ (eLpNorm (fun omega => f1 omega + f2 omega) (ENNReal.ofReal p) mu +
          eLpNorm f3 (ENNReal.ofReal p) mu) + eLpNorm f4 (ENNReal.ofReal p) mu := by gcongr
    _ ≤ ((eLpNorm f1 (ENNReal.ofReal p) mu + eLpNorm f2 (ENNReal.ofReal p) mu) +
          eLpNorm f3 (ENNReal.ofReal p) mu) + eLpNorm f4 (ENNReal.ofReal p) mu := by gcongr
    _ ≤ ((ENNReal.ofReal b1 + ENNReal.ofReal b2) + ENNReal.ofReal b3) + ENNReal.ofReal b4 := by
        gcongr
    _ = ENNReal.ofReal (b1 + b2 + b3 + b4) := by
        rw [← ENNReal.ofReal_add hb1 hb2, ← ENNReal.ofReal_add (by linarith) hb3,
          ← ENNReal.ofReal_add (by linarith) hb4]

theorem aux_lem_band_meas_field
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : _root_.SubdiffusiveProcess.Paper.in_J d)
    (_Poincare : _root_.SubdiffusiveProcess.Paper.in_poincare d hd I)
    (_Extension : _root_.SubdiffusiveProcess.Paper.in_extension d hd I)
    (_Perturbation : _root_.SubdiffusiveProcess.EllipticRegularity.SmallPerturbationInput d)
    (_Sobolev : _root_.SubdiffusiveProcess.EllipticRegularity.SobolevFoundationalInput d hd)
    (_D : _root_.SubdiffusiveProcess.Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (_hCresp : 0 < Cresp)
    (s sigma eps : ℝ) (_hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (_hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1)
    (heps : eps ∈ Set.Ioo (0 : ℝ) 1)
    (T : ℕ) (_offset : Fin T → ℤ) (_shift : Fin T → SpatialCoordinates d)
    (weight : Fin 4 → ℝ) (_hweight : ∀ i, 0 ≤ weight i)
    (Klip : ℝ≥0)
    (Phi : (Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ) → ℝ)
    (_hPhiLip : LipschitzWith Klip Phi) (_hPhi0 : Phi 0 = 0)
    (_hPhiNonneg : ∀ x, 0 ≤ Phi x)
    (CD : ℝ → ℝ) (_hCD : ∀ p, 1 ≤ p → 0 < CD p)
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d)
    (eta : ℕ → BilateralField d → _root_.SubdiffusiveProcess.Model.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (hprim : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
      primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (q : ℝ)
    (hDbaseline : ∀ (N n : ℕ) (z : Vec d),
      MemLp (fun omega => (Draw N n z omega).toReal)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega => (Draw N n z omega).toReal)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (CD q * M.delta ^ (1 / 2 : ℝ))) :
    ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) →
      AEStronglyMeasurable (fun omega =>
          weight 0 * (Draw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal +
          weight 1 * (min (1 : ENNReal)
            ((F N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega - ENNReal.ofReal (eps / 2)) /
              ENNReal.ofReal (eps - eps / 2))).toReal)
        (chaosSampleLaw M).toMeasure := by
  intro N n z _hn
  set m : ℕ := ((N : ℤ) - n).toNat with hm_def
  set w : SpatialCoordinates d := (3 : ℝ) ^ N • z with hw_def
  have hD : AEStronglyMeasurable (fun omega => (Draw N m w omega).toReal)
      (chaosSampleLaw M).toMeasure := (hDbaseline N m w).1.aestronglyMeasurable
  have hFraw : AEMeasurable (fun omega => F N m w omega) (chaosSampleLaw M).toMeasure := by
    have hEtaMeas := prefix_eta_aemeasurable M eta heta N
    have hcomp := (aux_lem_prefix_limit_actual_Fsc_meas s m w).comp_aemeasurable hEtaMeas
    apply hcomp.congr
    filter_upwards [hprim] with omega hps
    obtain ⟨_, _, _, _, hF, _⟩ := hps N
    exact (hF m w).symm
  have hFcont : Continuous (fun x : ENNReal => (min (1 : ENNReal)
      ((x - ENNReal.ofReal (eps / 2)) / ENNReal.ofReal (eps - eps / 2))).toReal) :=
    aux_lem_band_eramp_continuous (eps / 2) eps (by linarith [heps.1])
  have hFmeas : AEStronglyMeasurable (fun omega => (min (1 : ENNReal)
      ((F N m w omega - ENNReal.ofReal (eps / 2)) / ENNReal.ofReal (eps - eps / 2))).toReal)
      (chaosSampleLaw M).toMeasure := (hFcont.measurable.comp_aemeasurable hFraw).aestronglyMeasurable
  exact (aestronglyMeasurable_const.mul hD).add (aestronglyMeasurable_const.mul hFmeas)

theorem aux_lem_band_meas_product
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
