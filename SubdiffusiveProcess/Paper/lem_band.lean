    refine ⟨0, by rw [hcube]; exact Metric.mem_ball_self (by norm_num), ?_⟩
    rw [φb.one_of_mem_closedBall (Metric.mem_closedBall_self (by norm_num))]
    norm_num
  have hfmem : MemLp (φb : SpatialCoordinates d → ℝ) 2
      (volume.restrict (centeredCube (0 : SpatialCoordinates d) 1 hr : Set (SpatialCoordinates d))) :=
    MemLp.of_bound φb.continuous.aestronglyMeasurable 1
