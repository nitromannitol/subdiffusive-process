    (fun j _ => (aux_lane4_lambda_inv_cell_moment_env_measurable M
      (fun _ => (0 : C(SpatialCoordinates d, ℝ))) measurable_const K N _).aestronglyMeasurable)
    hp (B := Real.exp (Real.log 2 / p +
