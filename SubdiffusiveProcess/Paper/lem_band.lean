theorem aux_lem_band_des3_Kmac_moment {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (Q Z CUV : ℝ) (hQ : 1 ≤ Q) (hZ : 0 ≤ Z) (hCUV : 0 ≤ CUV)
    (U V : Ω → ℝ) (hU : AEStronglyMeasurable U P) (hV : AEStronglyMeasurable V P)
    (hUb : eLpNorm U (ENNReal.ofReal (2 * Q)) P ≤ ENNReal.ofReal CUV)
    (hVb : eLpNorm V (ENNReal.ofReal (2 * Q)) P ≤ ENNReal.ofReal CUV) :
    MemLp (fun om => Z * (U om * (1 + V om))) (ENNReal.ofReal Q) P ∧
    eLpNorm (fun om => Z * (U om * (1 + V om))) (ENNReal.ofReal Q) P ≤
      ENNReal.ofReal (Z * (CUV * (1 + CUV))) := by
  have hUm : MemLp U (ENNReal.ofReal (2 * Q)) P := ⟨hU, lt_of_le_of_lt hUb ENNReal.ofReal_lt_top⟩
  have hVm : MemLp V (ENNReal.ofReal (2 * Q)) P := ⟨hV, lt_of_le_of_lt hVb ENNReal.ofReal_lt_top⟩
  obtain ⟨hm, hb⟩ := aux_rem_resolved_UV_moment P Q CUV hQ hCUV U V hUm hVm hUb hVb
  refine ⟨hm.const_mul Z, ?_⟩
  calc eLpNorm (fun om => Z * (U om * (1 + V om))) (ENNReal.ofReal Q) P
      = eLpNorm (Z • fun om => U om * (1 + V om)) (ENNReal.ofReal Q) P := rfl
    _ ≤ ‖Z‖ₑ * eLpNorm (fun om => U om * (1 + V om)) (ENNReal.ofReal Q) P :=
        eLpNorm_const_smul_le
    _ ≤ ‖Z‖ₑ * ENNReal.ofReal (CUV * (1 + CUV)) := by gcongr
    _ = ENNReal.ofReal (Z * (CUV * (1 + CUV))) := by
        rw [Real.enorm_eq_ofReal hZ, ← ENNReal.ofReal_mul hZ]

