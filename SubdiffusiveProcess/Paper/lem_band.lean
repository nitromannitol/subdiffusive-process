      hlo hbd
  · intro N
    have hDs : MemLp (fun om => D0 N (aux_prop_growth_energy_assembly_shift d z om))
        (ENNReal.ofReal (2 * q)) (chaosSampleLaw M).toMeasure :=
      aux_prop_growth_energy_assembly_shift_memLp M z (hD0mem N)
    refine ⟨hDs.mono_exponent hle, ?_⟩
    exact ⟨hEmem.1.mul (hYs N).1, lt_of_le_of_lt (hprod N) ENNReal.ofReal_lt_top⟩
  · intro N
    rw [aux_prop_growth_energy_assembly_shift_eLpNorm M z (g := D0 N) _ (hD0mem N).1]
    exact (eLpNorm_le_eLpNorm_of_exponent_le hle (hD0mem N).1).trans (hD0mom N)
  · exact hprod

noncomputable def aux_lem_band_L1c_Cplus_fn (d : ℕ) (r CJ B CR CHK CenvK q q' δ : ℝ) (ℓ : ℕ) : ℝ :=
  aux_lane4_lambda_inv_cell_moment_Cplus d δ r CJ
    (Real.log 4 / (2 * q) + 4 * (2 * q) * CHK * δ ^ 2 + B * δ ^ 2) B CR
    (Real.log 4 / q' + 4 * q' * CenvK * δ ^ 2) ℓ

noncomputable def aux_lem_band_L1c_Cminus_fn (d : ℕ) (CenvK δ : ℝ) : ℝ :=
  Real.exp (Real.log 4 * δ + 4 * CenvK * δ +
    ((d * Real.log 3 + (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) * δ +
      2 * Real.log 2 * δ ^ 2))

noncomputable def aux_lem_band_L1c_Cq_fn (d : ℕ) (r CJ B CR CHK CenvK q q' δ : ℝ) (ℓ : ℕ) : ℝ :=
  1 + aux_lem_band_L1c_Cplus_fn d r CJ B CR CHK CenvK q q' δ ℓ + aux_lem_band_L1c_Cminus_fn d CenvK δ

noncomputable def aux_lem_band_L1c_Cd_fn (d : ℕ) (R : ℝ) : ℝ :=
  1 + R + (d * Real.log 3 + (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) +
    2 * Real.log 2

theorem aux_lem_band_L1c_Cq_fn_pos (d : ℕ) (r CJ B CR CHK CenvK q q' δ : ℝ) (ℓ : ℕ) (hr : 0 < r)
    (hCJ : 0 ≤ CJ) (hB : 0 ≤ B) (hCR : 0 ≤ CR) (hCHK : 0 ≤ CHK) (hCenvK : 0 ≤ CenvK) :
    0 < aux_lem_band_L1c_Cq_fn d r CJ B CR CHK CenvK q q' δ ℓ := by
  unfold aux_lem_band_L1c_Cq_fn aux_lem_band_L1c_Cplus_fn aux_lem_band_L1c_Cminus_fn
    aux_lane4_lambda_inv_cell_moment_Cplus
  positivity

theorem aux_lem_band_L1c_Cplus_mono (d : ℕ) (r CJ B CR CHK CenvK q q' : ℝ) (ℓ : ℕ)
    (hr : 0 < r) (hCJ : 0 ≤ CJ) (hB : 0 ≤ B) (hCR : 0 ≤ CR) (hCHK : 0 ≤ CHK)
    (hCenvK : 0 ≤ CenvK) (hq0 : 0 < q) (hq'0 : 0 < q')
    (δ1 δ2 : ℝ) (hδ1 : 0 ≤ δ1) (hle : δ1 ≤ δ2) :
    aux_lane4_lambda_inv_cell_moment_Cplus d δ1 r CJ
        (Real.log 4 / (2 * q) + 4 * (2 * q) * CHK * δ1 ^ 2 + B * δ1 ^ 2) B CR
        (Real.log 4 / q' + 4 * q' * CenvK * δ1 ^ 2) ℓ ≤
    aux_lane4_lambda_inv_cell_moment_Cplus d δ2 r CJ
        (Real.log 4 / (2 * q) + 4 * (2 * q) * CHK * δ2 ^ 2 + B * δ2 ^ 2) B CR
        (Real.log 4 / q' + 4 * q' * CenvK * δ2 ^ 2) ℓ := by
  have hδ2 : 0 ≤ δ2 := hδ1.trans hle
  have hsq : δ1 ^ 2 ≤ δ2 ^ 2 := pow_le_pow_left₀ hδ1 hle 2
  unfold aux_lane4_lambda_inv_cell_moment_Cplus
  gcongr

theorem aux_lem_band_L1c_Cminus_mono (d : ℕ) (CenvK b c : ℝ)
    (hCenvK : 0 ≤ CenvK) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (δ1 δ2 : ℝ) (hδ1 : 0 ≤ δ1) (hle : δ1 ≤ δ2) :
