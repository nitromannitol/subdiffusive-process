theorem aux_lem_band_T234_bank_eLpNorm_affine {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (q : ℝ) (hq : 1 ≤ q) :
    ∃ P : ℝ, 0 ≤ P ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
        (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d),
        (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
          ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
            omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
        ∀ (N i n : ℕ) (z : Vec d),
          eLpNorm (fun omega : BilateralField d => aux_prefix_bank_maxObs i n z (eta N omega))
            (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
            ENNReal.ofReal (P * (1 + ((n - i : ℕ):ℝ))) := by
  set qnat : ℕ := ⌈q⌉₊ with hqnat_def
  have hqnat1 : 1 ≤ qnat := by
    rw [hqnat_def]; exact Nat.one_le_ceil_iff.mpr (by linarith)
  have hqle : q ≤ (qnat:ℝ) := Nat.le_ceil q
  obtain ⟨P, hP0, hPbound⟩ := aux_lem_band_T234_bank_eLpNorm_affine_nat_uniform (d := d) qnat hqnat1
  refine ⟨P, hP0, fun M eta heta N i n z => ?_⟩
  have hple : ENNReal.ofReal q ≤ ((2 * qnat : ℕ) : ENNReal) := by
    have h1 : q ≤ ((2 * qnat : ℕ):ℝ) := by push_cast; nlinarith
    calc ENNReal.ofReal q ≤ ENNReal.ofReal (((2*qnat:ℕ):ℕ):ℝ) := ENNReal.ofReal_le_ofReal h1
      _ = ((2*qnat:ℕ):ENNReal) := by
          rw [ENNReal.ofReal_natCast]
  have hmeas := aux_lem_band_T234_bank_measurable M eta heta N i n z
  have hstep : eLpNorm (fun omega : BilateralField d => aux_prefix_bank_maxObs i n z (eta N omega))
      (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      eLpNorm (fun omega : BilateralField d => aux_prefix_bank_maxObs i n z (eta N omega))
      ((2 * qnat : ℕ) : ENNReal) (chaosSampleLaw M).toMeasure :=
    eLpNorm_le_eLpNorm_of_exponent_le hple hmeas
  exact hstep.trans (hPbound M eta heta N i n z)

theorem aux_lem_band_DT1_comap_mono_of_subset {Ω κ β : Type*} [MeasurableSpace Ω]
    [MeasurableSpace β] (f : Ω → κ → β) {A B : Set κ} (hAB : A ⊆ B) :
    MeasurableSpace.comap (fun omega : Ω => fun j : A => f omega (j : κ)) inferInstance ≤
    MeasurableSpace.comap (fun omega : Ω => fun j : B => f omega (j : κ)) inferInstance := by
  let proj : (B → β) → (A → β) := fun g => fun j : A => g ⟨(j : κ), hAB j.2⟩
  have hfactor : (fun omega : Ω => fun j : A => f omega (j : κ)) =
      proj ∘ (fun omega : Ω => fun j : B => f omega (j : κ)) := by
    funext omega j
    rfl
  rw [hfactor]
  calc MeasurableSpace.comap (proj ∘ (fun omega : Ω => fun j : B => f omega (j : κ)))
        inferInstance
      = MeasurableSpace.comap (fun omega : Ω => fun j : B => f omega (j : κ))
          (MeasurableSpace.comap proj inferInstance) := by
        rw [MeasurableSpace.comap_comp]
    _ ≤ MeasurableSpace.comap (fun omega : Ω => fun j : B => f omega (j : κ)) inferInstance := by
        apply MeasurableSpace.comap_mono
        exact (measurable_pi_iff.mpr fun j => measurable_pi_apply _).comap_le

theorem aux_lem_band_DT1_aestronglyMeasurable_mono {Ω β : Type*} [TopologicalSpace β]
    {m0 m m' : MeasurableSpace Ω} {μ : Measure[m0] Ω} {f : Ω → β}
    (hf : AEStronglyMeasurable[m'] f μ) (hmm : m' ≤ m) : AEStronglyMeasurable[m] f μ := by
  obtain ⟨g, hg, hfg⟩ := hf
  exact ⟨g, hg.mono hmm, hfg⟩

def aux_lem_band_gapD_T1index (dd gap : ℕ) : Finset (Fin dd → ℤ) :=
  Fintype.piFinset (fun _ : Fin dd => Finset.Icc (-(3 ^ gap : ℤ)) (3 ^ gap))

theorem aux_lem_band_gapD_T1index_mono (dd : ℕ) {gap1 gap2 : ℕ} (h : gap1 ≤ gap2) :
    aux_lem_band_gapD_T1index dd gap1 ⊆ aux_lem_band_gapD_T1index dd gap2 := by
