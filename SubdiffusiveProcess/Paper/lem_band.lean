          ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) i j =
        (aux_lem_band_U2_reference M H K (k : ℤ) (Homogenization.cubeCenter R) omega)⁻¹ *
          aux_lem_band_U2_sigStarInvF i j (aux_lem_band_U2_unitChart I M H
            (aux_lem_band_U2_shift (k : ℤ) (Homogenization.cubeCenter R) omega)
            ((K : ℤ) - (k : ℤ)).toNat) := by
      filter_upwards [hid] with omega homega
      rw [homega.1]
      rfl
    have hidG : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
        Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain R)
          ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) i j =
        (aux_lem_band_U2_reference M H K (k : ℤ) (Homogenization.cubeCenter R) omega) *
          aux_lem_band_U2_sigF i j (aux_lem_band_U2_unitChart I M H
