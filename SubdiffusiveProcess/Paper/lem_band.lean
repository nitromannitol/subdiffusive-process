theorem aux_lem_band_piece_product
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d)
    (_Poincare : Paper.in_poincare d hd I)
    (_Extension : Paper.in_extension d hd I)
    (_Perturbation : Lane4.SmallPerturbationInput d)
    (_Sobolev : Lane4.SobolevFoundationalInput d hd)
    (D : Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s sigma eps : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1)
    (heps : eps ∈ Set.Ioo (0 : ℝ) 1)
    (T : ℕ) (offset : Fin T → ℤ) (shift : Fin T → SpatialCoordinates d)
    (weight : Fin 4 → ℝ) (hweight : ∀ i, 0 ≤ weight i)
    (Klip : ℝ≥0)
    (Phi : (Fin T → (Fin 3 ⊕ ((Bool × (Fin d × Fin d)) ⊕ Fin 2)) → ℝ) → ℝ)
    (hPhiLip : LipschitzWith Klip Phi) (hPhi0 : Phi 0 = 0)
    (hPhiNonneg : ∀ x, 0 ≤ Phi x)
    (CD : ℝ → ℝ) (hCD : ∀ p, 1 ≤ p → 0 < CD p) :
    ∃ a0 c0 : ℝ, ∃ w0 : ℕ,
      0 < a0 ∧ 0 < c0 ∧ 0 < w0 ∧
      ∀ p : ℝ, 1 ≤ p →
        ∃ qmin : ℝ,
          ∀ q : ℝ, qmin ≤ q →
            ∃ delta0 C0 : ℝ, 0 < delta0 ∧ 0 ≤ C0 ∧
              ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ delta0 →
              ∀ (Rm : Paper.in_responses d M), Rm.C ≤ Cresp →
              ∀ (Sreg : Paper.in_6_16 d M) (_It : Paper.in_iteration d M I Sreg),
              ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
                InfraredCharacterization M H →
              ∀ (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d),
                (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
                  ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
                    omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y)) →
              ∀ (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
                (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
                (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop),
                (∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
                  primitive_scores d M s eps (eta N omega)
                    (fun m y => F N m y omega) (fun m y => Praw N m y omega)
                    (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
                    (fun m y => Z N m y omega) (fun m y => rawGood N m y omega)) →
                (hDbaseline : ∀ (N n : ℕ) (z : Vec d),
                  MemLp (fun omega => (Draw N n z omega).toReal)
                    (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
                  eLpNorm (fun omega => (Draw N n z omega).toReal)
                    (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
                    ENNReal.ofReal (CD q * M.delta ^ (1 / 2 : ℝ))) →
              ∀ (sidePos : ∀ n : ℤ, 0 < (3 : ℝ) ^ (-n))
                (unitA : ∀ (n : ℤ) (z : SpatialCoordinates d),
                  PositiveCoefficient (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n))),
                (∀ n z, (unitA n z).val =ᵐ[volume.restrict
                  (centeredCube z ((3 : ℝ) ^ (-n)) (sidePos n) : Set (SpatialCoordinates d))]
                    (fun _ => (1 : ℝ))) →
              let kappa : ℕ → ℝ := fun J =>
                Real.exp (((J : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) * ahom M J
              let retained : ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
                fun n z omega => if 0 ≤ n then ∑ j ∈ Finset.Ico (0 : ℤ) n, omega (-j) z
                  else -∑ j ∈ Finset.Ico n (0 : ℤ), omega (-j) z
              let reference : ℕ → ℤ → SpatialCoordinates d → BilateralField d → ℝ :=
                fun N n z omega => kappa ((N : ℤ) - n).toNat / kappa N *
                  Real.exp (H omega z + retained n z omega)
              let eramp : ℝ → ℝ → ENNReal → ℝ := fun lo hi x =>
                (min (1 : ENNReal) ((x - ENNReal.ofReal lo) /
                  ENNReal.ofReal (hi - lo))).toReal
              12 * q ≤ Cresp⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹ →
              ∀ (N : ℕ) (n : ℤ) (z : SpatialCoordinates d), n ≤ (N : ℤ) →
                (∀ i : Fin T, n + offset i ≤ (N : ℤ)) →
                ∀ h : ℕ, 1 ≤ h →
                  ∃ Yband : BilateralField d → ℝ,
                    AEStronglyMeasurable[MeasurableSpace.comap
                      (fun omega : BilateralField d =>
                        fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ))
                          (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ))
                      inferInstance] Yband (chaosSampleLaw M).toMeasure ∧
                    eLpNorm (fun omega =>
                        weight 2 * eramp 6 12 (Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega)
                          - Yband omega)
                      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
                      ENNReal.ofReal (C0 * M.delta ^ c0 * (3 : ℝ) ^ (-(a0 * (h : ℝ))))
  := by
  refine ⟨s / 64, 1 / 2, 4, div_pos hs.1 (by norm_num), by norm_num, by norm_num, ?_⟩
  intro p hp
  obtain ⟨CB, delta0B, hCBnn, hdelta0Bpos, hbase⟩ :=
    aux_lem_band_piece_product_baseline d hd s eps hs p hp
  obtain ⟨CP, delta0P, hCPnn, hdelta0Ppos, htrunc⟩ :=
    aux_lem_band_piece_product_trunc d hd s eps hs (weight 2) (hweight 2) p hp
  refine ⟨0, ?_⟩
  intro q _hq
  refine ⟨min 1 (min delta0B delta0P), 2 * Real.sqrt ((weight 2 / 6 * CB) * CP),
    lt_min zero_lt_one (lt_min hdelta0Bpos hdelta0Ppos),
    mul_nonneg (by norm_num) (Real.sqrt_nonneg _), ?_⟩
  intro M hMdelta Rm hRm Sreg _It H hH eta heta F Praw Rraw Draw Z rawGood hprim
    hDbaseline sidePos unitA hunitA kappa retained reference eramp h12q
    N n z hn hoffset h hh
  have hMdeltaB : M.delta ≤ delta0B :=
    hMdelta.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hMdeltaP : M.delta ≤ delta0P :=
    hMdelta.trans ((min_le_right _ _).trans (min_le_right _ _))
  obtain ⟨hPfin, hbase_bound⟩ :=
    hbase M hMdeltaB eta heta F Praw Rraw Draw Z rawGood hprim N n z hn
  obtain ⟨Pband, hPbandmeas, htrunc_bound⟩ :=
    htrunc M hMdeltaP eta heta F Praw Rraw Draw Z rawGood hprim N n z hn h hh
  have hMdeltapos : (0 : ℝ) ≤ M.delta := M.shellPrefix.delta_pos.le
                                      
  have h26 : (2 : ENNReal) ≤ ENNReal.ofReal (6 : ℝ) := by
    rw [show (2 : ENNReal) = ENNReal.ofReal (2 : ℝ) by norm_num]
    exact ENNReal.ofReal_le_ofReal (by norm_num)
  have heramp2 : (min (1 : ENNReal) (((2 : ENNReal) - ENNReal.ofReal (6 : ℝ)) /
      ENNReal.ofReal ((12 : ℝ) - 6))).toReal = 0 := by
    rw [tsub_eq_zero_of_le h26]
    simp
  have h2fin : ∀ᵐ (_omega : BilateralField d) ∂(chaosSampleLaw M).toMeasure, (2 : ENNReal) ≠ ⊤ :=
    Filter.Eventually.of_forall (fun _ => by norm_num)
  have hramp_transfer := aux_lem_band_piece_product_eramp_eLpNorm_le (ENNReal.ofReal p) 6 12
    (by norm_num) (by norm_num)
    (fun omega => Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega) (fun _ => (2 : ENNReal))
    hPfin h2fin
  dsimp only at hramp_transfer
  have hfun_eq : (fun omega : BilateralField d =>
      (min (1 : ENNReal) ((Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
          ENNReal.ofReal 6) / ENNReal.ofReal ((12 : ℝ) - 6))).toReal
        - (min (1 : ENNReal) (((2 : ENNReal) - ENNReal.ofReal (6 : ℝ)) /
            ENNReal.ofReal ((12 : ℝ) - 6))).toReal)
      = fun omega : BilateralField d =>
          (min (1 : ENNReal) ((Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
              ENNReal.ofReal 6) / ENNReal.ofReal ((12 : ℝ) - 6))).toReal := by
    funext omega
    rw [heramp2, sub_zero]
  rw [hfun_eq] at hramp_transfer
  have hbase1 : eLpNorm (fun omega : BilateralField d =>
      (min (1 : ENNReal) ((Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
          ENNReal.ofReal 6) / ENNReal.ofReal ((12 : ℝ) - 6))).toReal)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (CB * M.delta / 6) := by
    refine hramp_transfer.trans ?_
    rw [show ((12 : ℝ) - 6) = 6 by norm_num]
    calc ENNReal.ofReal (6 : ℝ)⁻¹ *
          eLpNorm (fun omega => (Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal - 2)
            (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure
        ≤ ENNReal.ofReal (6 : ℝ)⁻¹ * ENNReal.ofReal (CB * M.delta) :=
          mul_le_mul_left' hbase_bound _
      _ = ENNReal.ofReal ((6 : ℝ)⁻¹ * (CB * M.delta)) := (ENNReal.ofReal_mul (by norm_num)).symm
      _ = ENNReal.ofReal (CB * M.delta / 6) := by
          rw [show (6 : ℝ)⁻¹ * (CB * M.delta) = CB * M.delta / 6 by ring]
  have hYbase : eLpNorm (fun omega : BilateralField d =>
      weight 2 * eramp 6 12 (Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega) - 0)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (weight 2 / 6 * CB * M.delta ^ (1 : ℕ)) := by
    have hrw : (fun omega : BilateralField d =>
        weight 2 * eramp 6 12 (Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega) - 0)
        = weight 2 • (fun omega : BilateralField d =>
            (min (1 : ENNReal) ((Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
                ENNReal.ofReal 6) / ENNReal.ofReal ((12 : ℝ) - 6))).toReal) := by
      funext omega
      show weight 2 * (min (1 : ENNReal) ((Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
          ENNReal.ofReal 6) / ENNReal.ofReal ((12 : ℝ) - 6))).toReal - 0 = _
      simp only [Pi.smul_apply, smul_eq_mul, sub_zero]
    rw [hrw, eLpNorm_const_smul, Real.enorm_eq_ofReal (hweight 2), pow_one]
    calc ENNReal.ofReal (weight 2) *
        eLpNorm (fun omega : BilateralField d =>
            (min (1 : ENNReal) ((Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
                ENNReal.ofReal 6) / ENNReal.ofReal ((12 : ℝ) - 6))).toReal)
          (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure
        ≤ ENNReal.ofReal (weight 2) * ENNReal.ofReal (CB * M.delta / 6) :=
          mul_le_mul_left' hbase1 _
      _ = ENNReal.ofReal (weight 2 / 6 * CB * M.delta) := by
          rw [← ENNReal.ofReal_mul (hweight 2)]
          congr 1
          ring
  obtain ⟨Yband, hYbandmeas, hYbandbound⟩ := aux_lem_band_piece_product_err_case_split
    (fun omega : BilateralField d =>
        weight 2 * eramp 6 12 (Praw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega))
