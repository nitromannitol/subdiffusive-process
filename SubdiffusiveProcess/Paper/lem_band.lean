            (mlow0 N (aux_prop_growth_energy_assembly_shift d z om))⁻¹|)
            (ENNReal.ofReal (2 * q)) (chaosSampleLaw M).toMeasure := hb
    have h2 : eLpNorm (fun om => Real.exp |H om z|) (ENNReal.ofReal (2 * q))
