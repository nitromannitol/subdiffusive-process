              (fun _ : Fin d => (1 / 2 : ℝ)) one_pos) f u →
          ∀ x : SpatialCoordinates d, x ∈ (unitNeumannCube d : Set (SpatialCoordinates d)) →
          ∀ r : ℝ, (3 : ℝ) ^ (-(N : ℤ)) ≤ r →
            (∫ y in {y : SpatialCoordinates d | ∀ i : Fin d, |y i - x i| < r / 2} ∩
                (unitNeumannCube d : Set (SpatialCoordinates d)),
