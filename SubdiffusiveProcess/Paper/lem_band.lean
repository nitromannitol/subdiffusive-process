theorem aux_lem_band_T234_log_cellcount_le {d : ℕ} (gap : ℕ) :
    Real.log (2 * (((aux_psf_cells d gap).card : ℕ) : ℝ)) ≤
      Real.log 2 + (d:ℝ) * ((gap:ℝ) + 1) * Real.log 3 := by
  have hcard := aux_lem_band_T234_cellcount_le (d := d) gap
  have hcardpos : (0:ℝ) < (((aux_psf_cells d gap).card : ℕ) : ℝ) := by
    have hne := aux_psf_cells_nonempty d gap
    exact_mod_cast Finset.card_pos.mpr hne
  have hle : 2 * (((aux_psf_cells d gap).card : ℕ) : ℝ) ≤ 2 * (3:ℝ) ^ (d * (gap + 1)) := by
    linarith
  have hpos2 : (0:ℝ) < 2 * (((aux_psf_cells d gap).card : ℕ) : ℝ) := by linarith
  calc Real.log (2 * (((aux_psf_cells d gap).card : ℕ) : ℝ))
      ≤ Real.log (2 * (3:ℝ) ^ (d * (gap + 1))) := Real.log_le_log hpos2 hle
    _ = Real.log 2 + Real.log ((3:ℝ) ^ (d * (gap + 1))) :=
        Real.log_mul (by norm_num) (by positivity)
    _ = Real.log 2 + ((d * (gap + 1) : ℕ) : ℝ) * Real.log 3 := by rw [Real.log_pow]
    _ = Real.log 2 + (d:ℝ) * ((gap:ℝ) + 1) * Real.log 3 := by push_cast; ring

theorem aux_lem_band_T234_b_affine (qnat d gap : ℕ) :
    ((qnat:ℝ) + 1 + Real.log (2 * (((aux_psf_cells d gap).card : ℕ) : ℝ))) ≤
      ((qnat:ℝ) + 1 + Real.log 2 + (d:ℝ) * Real.log 3) + ((d:ℝ) * Real.log 3) * (gap:ℝ) := by
  have h := aux_lem_band_T234_log_cellcount_le (d := d) gap
  nlinarith [h]

theorem aux_lem_band_T234_real_moment_bound (qnat : ℕ) (hqnat : 1 ≤ qnat) (b A B gap : ℝ)
    (hb0 : 0 ≤ b) (hA : 0 ≤ A) (hB : 0 ≤ B) (hble : b ≤ A + B * gap) :
    (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤ Real.sqrt 2 * Real.sqrt (A + B * gap) := by
  have hqnat0 : (0:ℝ) < (qnat:ℝ) := by exact_mod_cast hqnat
  have hAB : 0 ≤ A + B * gap := by nlinarith
  have hpow : (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤
      (2 * (A + B * gap) ^ qnat) ^ ((1:ℝ) / (2 * qnat)) := by
    apply Real.rpow_le_rpow (by positivity) ?_ (by positivity)
    gcongr
  have hsplit : (2 * (A + B * gap) ^ qnat) ^ ((1:ℝ) / (2 * qnat)) =
      (2:ℝ) ^ ((1:ℝ) / (2 * qnat)) * ((A + B * gap) ^ qnat) ^ ((1:ℝ) / (2 * qnat)) :=
    Real.mul_rpow (by norm_num) (by positivity)
  have hsecond : ((A + B * gap) ^ qnat) ^ ((1:ℝ) / (2 * qnat)) = Real.sqrt (A + B * gap) := by
    rw [← Real.rpow_natCast (A + B * gap) qnat, ← Real.rpow_mul hAB, Real.sqrt_eq_rpow]
    congr 1
    field_simp
  have hfirst : (2:ℝ) ^ ((1:ℝ) / (2 * qnat)) ≤ Real.sqrt 2 := by
    rw [Real.sqrt_eq_rpow]
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have hqnat1 : (1:ℝ) ≤ (qnat:ℝ) := by exact_mod_cast hqnat
    have h2q : (2:ℝ) ≤ 2 * qnat := by nlinarith
    exact one_div_le_one_div_of_le (by norm_num) h2q
  rw [hsplit, hsecond] at hpow
  calc (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤
      (2:ℝ) ^ ((1:ℝ) / (2 * qnat)) * Real.sqrt (A + B * gap) := hpow
    _ ≤ Real.sqrt 2 * Real.sqrt (A + B * gap) := by
        apply mul_le_mul_of_nonneg_right hfirst (Real.sqrt_nonneg _)

theorem aux_lem_band_T234_bank_eLpNorm_affine_nat {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (N i n : ℕ) (z : Vec d) (qnat : ℕ) (hqnat : 1 ≤ qnat) :
    ∃ P : ℝ, 0 ≤ P ∧
      eLpNorm (fun omega : BilateralField d => aux_prefix_bank_maxObs i n z (eta N omega))
        ((2 * qnat : ℕ) : ENNReal) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (P * (1 + ((n - i : ℕ):ℝ))) := by
  have hmom := aux_lem_band_T234_bank_eLpNorm M eta heta N i n z qnat hqnat
  dsimp only at hmom
  set b : ℝ := (qnat:ℝ) + 1 + Real.log (2 * (((aux_psf_cells d (n-i)).card:ℕ):ℝ)) with hb_def
  set gap : ℕ := n - i with hgap_def
  set A : ℝ := (qnat:ℝ) + 1 + Real.log 2 + (d:ℝ) * Real.log 3 with hA_def
  set B : ℝ := (d:ℝ) * Real.log 3 with hB_def
  have hA0 : 0 ≤ A := by
    have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    have hlog3 : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num)
    rw [hA_def]; positivity
  have hB0 : 0 ≤ B := by
    have hlog3 : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num)
    rw [hB_def]; positivity
  have hble : b ≤ A + B * (gap:ℝ) := aux_lem_band_T234_b_affine qnat d gap
  have hb0 : 0 ≤ b := by
    have h1 : (0:ℝ) ≤ (qnat:ℝ) + 1 := by positivity
    have hlogc : (0:ℝ) ≤ Real.log (2 * (((aux_psf_cells d (n-i)).card:ℕ):ℝ)) := by
      have hcardpos : (1:ℝ) ≤ (((aux_psf_cells d (n-i)).card:ℕ):ℝ) := by
        have hne := aux_psf_cells_nonempty d (n-i)
        have := Finset.card_pos.mpr hne
        exact_mod_cast this
      apply Real.log_nonneg
      linarith
    rw [hb_def]; linarith
  have hrmb := aux_lem_band_T234_real_moment_bound qnat hqnat b A B (gap:ℝ) hb0 hA0 hB0 hble
  have hsig := aux_lem_band_T234_sigma_le M
  set P0 : ℝ := Real.sqrt 2 * (Real.sqrt A + Real.sqrt B / 2) + Real.sqrt 2 * (Real.sqrt B / 2)
    with hP0_def
  refine ⟨((1 + (d:ℝ))/2) * P0, by positivity, ?_⟩
  have hchain : aux_psf_sigma M * (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤
      ((1 + (d:ℝ))/2) * P0 * (1 + (gap:ℝ)) := by
    have hstep1 : aux_psf_sigma M * (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤
        ((1+(d:ℝ))/2) * (Real.sqrt 2 * Real.sqrt (A + B * gap)) := by
      apply mul_le_mul hsig hrmb (by positivity) (by linarith [Real.sqrt_nonneg (2:ℝ)] )
    have hstep2 : Real.sqrt 2 * Real.sqrt (A + B * (gap:ℝ)) ≤ P0 * (1 + (gap:ℝ)) := by
      have hsqrt_affine : Real.sqrt (A + B * (gap:ℝ)) ≤
          (Real.sqrt A + Real.sqrt B / 2) + (Real.sqrt B / 2) * (gap:ℝ) := by
        have hsub : Real.sqrt (A + B * (gap:ℝ)) ≤ Real.sqrt A + Real.sqrt (B * (gap:ℝ)) :=
          aux_lem_band_T234_sqrt_add_le A (B * (gap:ℝ)) hA0 (by positivity)
        have hsn : Real.sqrt (B * (gap:ℝ)) = Real.sqrt B * Real.sqrt (gap:ℝ) :=
          Real.sqrt_mul hB0 _
        have hamgm := aux_lem_band_T234_sqrt_nat_le gap
        calc Real.sqrt (A + B * (gap:ℝ)) ≤ Real.sqrt A + Real.sqrt (B * (gap:ℝ)) := hsub
          _ = Real.sqrt A + Real.sqrt B * Real.sqrt (gap:ℝ) := by rw [hsn]
          _ ≤ Real.sqrt A + Real.sqrt B * ((1 + (gap:ℝ))/2) := by gcongr
          _ = (Real.sqrt A + Real.sqrt B / 2) + (Real.sqrt B / 2) * (gap:ℝ) := by ring
      have hfinal : Real.sqrt 2 *
          ((Real.sqrt A + Real.sqrt B / 2) + (Real.sqrt B / 2) * (gap:ℝ)) ≤
          P0 * (1 + (gap:ℝ)) := by
        rw [hP0_def]
        have hgap0 : (0:ℝ) ≤ (gap:ℝ) := by positivity
        nlinarith [Real.sqrt_nonneg A, Real.sqrt_nonneg B, Real.sqrt_nonneg (2:ℝ),
          mul_nonneg (mul_nonneg (Real.sqrt_nonneg (2:ℝ)) (Real.sqrt_nonneg A)) hgap0,
          mul_nonneg (mul_nonneg (Real.sqrt_nonneg (2:ℝ)) (Real.sqrt_nonneg B)) hgap0]
      calc Real.sqrt 2 * Real.sqrt (A + B * (gap:ℝ)) ≤
          Real.sqrt 2 * ((Real.sqrt A + Real.sqrt B / 2) + (Real.sqrt B / 2) * (gap:ℝ)) := by
            apply mul_le_mul_of_nonneg_left hsqrt_affine (Real.sqrt_nonneg _)
        _ ≤ P0 * (1 + (gap:ℝ)) := hfinal
    calc aux_psf_sigma M * (2 * b ^ qnat) ^ ((1:ℝ) / (2 * qnat)) ≤
        ((1+(d:ℝ))/2) * (Real.sqrt 2 * Real.sqrt (A + B * gap)) := hstep1
      _ ≤ ((1+(d:ℝ))/2) * (P0 * (1 + (gap:ℝ))) := by
          apply mul_le_mul_of_nonneg_left hstep2 (by positivity)
      _ = ((1+(d:ℝ))/2) * P0 * (1 + (gap:ℝ)) := by ring
  have hexp_eq : ((1:ℝ) / ((2 * qnat : ℕ) : ℝ)) = (1:ℝ) / (2 * (qnat:ℝ)) := by push_cast; ring
  have h2 : (2:ENNReal) = ENNReal.ofReal (2:ℝ) := by norm_num
  have hbnn : 0 ≤ b ^ qnat := by positivity
  have henn : (0:ℝ) ≤ (1:ℝ) / (2 * (qnat:ℝ)) := by positivity
  have hconv : ENNReal.ofReal (aux_psf_sigma M) *
      (2 * ENNReal.ofReal (b ^ qnat)) ^ ((1:ℝ) / ((2*qnat:ℕ):ℝ)) =
      ENNReal.ofReal (aux_psf_sigma M * (2 * b ^ qnat) ^ ((1:ℝ) / (2 * (qnat:ℝ)))) := by
    rw [hexp_eq, h2, ← ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2),
      ENNReal.ofReal_rpow_of_nonneg (by positivity) henn,
      ← ENNReal.ofReal_mul (aux_psf_sigma_pos M).le]
  rw [hconv] at hmom
  refine hmom.trans (ENNReal.ofReal_le_ofReal ?_)
  exact hchain

