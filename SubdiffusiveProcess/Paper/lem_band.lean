def aux_lem_band_DT4_bankmaj {d : ℕ} (k : ℕ) (z : Vec d) (j : ℕ)
    (omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) : ENNReal :=
  if k ≤ j then ENNReal.ofReal ((3 : ℝ) ^ k / (3 : ℝ) ^ j * aux_prefix_bank_maxObs j j z omega)
    else 0

theorem aux_lem_band_DT4_bankmaj_measurable {d : ℕ} (k : ℕ) (z : Vec d) (j : ℕ) :
    Measurable (fun omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d =>
      aux_lem_band_DT4_bankmaj k z j omega) := by
  unfold aux_lem_band_DT4_bankmaj
  by_cases hkj : k ≤ j
  · simp only [hkj, if_true]
