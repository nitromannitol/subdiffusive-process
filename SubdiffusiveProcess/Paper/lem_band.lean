    (Dx Mx : ℕ → BilateralField d → ℝ) (hDM0 : ∀ N om, 0 ≤ Dx N om ∧ 0 ≤ Mx N om)
    (heae : ∀ᵐ om ∂(chaosSampleLaw M).toMeasure, ∀ N : ℕ,
          0 < Mx N om ∧
          (∀ x ∈ (closedCube (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos : Set (SpatialCoordinates d)),
