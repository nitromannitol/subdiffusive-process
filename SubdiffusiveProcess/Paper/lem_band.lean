theorem aux_lem_band_h0li_aboveEnvelope_moment {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (K : Compacts (SpatialCoordinates d))
    (m : ℕ) (c : SpatialCoordinates d) (p : ℝ) (hp : 0 < p) :
    eLpNorm (fun om => Real.exp (aux_lem_extension_cell_moment_aboveLogEnvelope M
        (fun _ => (0 : C(SpatialCoordinates d, ℝ))) K m c om))
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
    ENNReal.ofReal (Real.exp (Real.log 4 / p +
      aux_lem_extension_cell_moment_aboveRate d p * M.delta ^ 2 +
      aux_lem_extension_cell_moment_aboveRate d p * M.delta ^ 2 * m)) := by
  have hzero : ∀ om : BilateralField d,
      ‖((fun _ => (0 : C(SpatialCoordinates d, ℝ))) om).restrict
        (K : Set (SpatialCoordinates d))‖ = (0 : ℝ) := fun om => by
    show ‖(ContinuousMap.restrict (K : Set (SpatialCoordinates d))
      (0 : C(SpatialCoordinates d, ℝ)))‖ = 0
    rw [show (ContinuousMap.restrict (K : Set (SpatialCoordinates d))
      (0 : C(SpatialCoordinates d, ℝ))) = 0 from by ext x; rfl, norm_zero]
  set D : ℝ := (2 * Real.log 2) * M.delta ^ 2 * m with hD
  set F : BilateralField d → ℝ := fun om =>
    Real.exp (1 * aux_lem_extension_cell_moment_physicalLogNorm M (m - 1)
      ((3 : ℝ) ^ ((m - 1 : ℕ) : ℤ) • c) om) with hF
  have heq : (fun om => Real.exp (aux_lem_extension_cell_moment_aboveLogEnvelope M
      (fun _ => (0 : C(SpatialCoordinates d, ℝ))) K m c om)) = Real.exp D • F := by
    funext om
    show Real.exp (aux_lem_extension_cell_moment_aboveLogEnvelope M
      (fun _ => (0 : C(SpatialCoordinates d, ℝ))) K m c om) = Real.exp D * F om
    unfold aux_lem_extension_cell_moment_aboveLogEnvelope
    rw [hzero om, zero_add, hD, hF]
    dsimp only
    rw [one_mul, Real.exp_add, mul_comm]
  rw [heq, eLpNorm_const_smul, Real.enorm_eq_ofReal (Real.exp_pos _).le]
  have hFm : AEStronglyMeasurable F (chaosSampleLaw M).toMeasure :=
    ((measurable_const.mul
      (aux_lem_extension_cell_moment_physicalLogNorm_measurable M (m - 1) _)).exp).aestronglyMeasurable
  have hFnorm := aux_lem_extension_cell_moment_physicalLogNorm_eLpNorm M (m - 1)
    ((3 : ℝ) ^ ((m - 1 : ℕ) : ℤ) • c) 1 p (by norm_num) hp
  have hstep := mul_le_mul_left' hFnorm (ENNReal.ofReal (Real.exp D))
  refine hstep.trans ?_
  rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add]
  apply ENNReal.ofReal_le_ofReal
  apply Real.exp_le_exp.mpr
  have hlen : ((m - 1 : ℕ) : ℝ) + 1 ≤ (m : ℝ) + 1 := by
    exact_mod_cast (show m - 1 + 1 ≤ m + 1 by omega)
  have hfluctnn : (0 : ℝ) ≤ (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 :=
    sq_nonneg _
  have hdelta2 : (0 : ℝ) ≤ M.delta ^ 2 := sq_nonneg _
  have hlog2pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hp0 : 0 < p := hp
  have hm1nn : (0 : ℝ) ≤ (m : ℝ) + 1 := by positivity
  have hBnn : (0 : ℝ) ≤ Real.log 2 +
      p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4 := by positivity
  have hlog24 : Real.log 2 ≤ Real.log 4 := Real.log_le_log (by norm_num) (by norm_num)
  have hA : Real.log 2 / p ≤ Real.log 4 / p := by gcongr
  have hstep1 : (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4) *
      M.delta ^ 2 * (((m - 1 : ℕ) : ℝ) + 1) ≤
      (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4) *
        M.delta ^ 2 * ((m : ℝ) + 1) :=
    mul_le_mul_of_nonneg_left hlen (mul_nonneg hBnn hdelta2)
  have hcoefle : 2 * Real.log 2 +
      (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4) ≤
      4 * Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 := by
    nlinarith [mul_nonneg hp0.le hfluctnn]
  have hstep2 : (2 * Real.log 2 +
        (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4)) *
        M.delta ^ 2 * ((m : ℝ) + 1) ≤
      (4 * Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2) *
        M.delta ^ 2 * ((m : ℝ) + 1) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hcoefle hdelta2) hm1nn
  unfold aux_lem_extension_cell_moment_aboveRate
  nlinarith [hstep1, hstep2, hA]

theorem aux_lem_band_h0li_env_moment {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (K : Compacts (SpatialCoordinates d))
    (N : ℕ) (g : SpatialCoordinates d) (p : ℝ) (hp : 0 < p) :
    eLpNorm (aux_lane4_lambda_inv_cell_moment_env M
        (fun _ => (0 : C(SpatialCoordinates d, ℝ))) K N g)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
    ENNReal.ofReal (Real.exp (Real.log 2 / p +
      (Real.log 2 + p * (aux_lem_extension_cell_moment_nativeFluctuationConst d) ^ 2 / 4) *
        M.delta ^ 2 * ((N : ℝ) + 1))) := by
  have hzero : ∀ om : BilateralField d,
      ‖((fun _ => (0 : C(SpatialCoordinates d, ℝ))) om).restrict
        (K : Set (SpatialCoordinates d))‖ = (0 : ℝ) := fun om => by
    show ‖(ContinuousMap.restrict (K : Set (SpatialCoordinates d))
      (0 : C(SpatialCoordinates d, ℝ)))‖ = 0
    rw [show (ContinuousMap.restrict (K : Set (SpatialCoordinates d))
      (0 : C(SpatialCoordinates d, ℝ))) = 0 from by ext x; rfl, norm_zero]
  have heq : aux_lane4_lambda_inv_cell_moment_env M
      (fun _ => (0 : C(SpatialCoordinates d, ℝ))) K N g =
      fun om => Real.exp (1 * aux_lem_extension_cell_moment_physicalLogNorm M N
        ((3 : ℝ) ^ N • g) om) := by
    funext om
    show Real.exp (‖((fun _ => (0 : C(SpatialCoordinates d, ℝ))) om).restrict
        (K : Set (SpatialCoordinates d))‖ +
      aux_lem_extension_cell_moment_physicalLogNorm M N ((3 : ℝ) ^ N • g) om) = _
    rw [hzero om, zero_add, one_mul]
  rw [heq]
  have h := aux_lem_extension_cell_moment_physicalLogNorm_eLpNorm M N ((3 : ℝ) ^ N • g) 1 p
    (by norm_num) hp
  simpa only [one_mul, one_pow, mul_one] using h

theorem aux_lem_band_h0li_envMax_moment {d : ℕ} (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
