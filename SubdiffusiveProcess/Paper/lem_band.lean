theorem aux_lem_band_piece_product_baseline_c1_Bseries_le (s R : ℝ) (hs : 0 < s) (hR : 0 < R) (C : ℝ) (hC : 0 ≤ C) :
    Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * C) ∧
    (∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * C) ≤
      C * (1 - (3 : ℝ) ^ (-(s * R / 8)))⁻¹ := by
  set ρ : ℝ := (3 : ℝ) ^ (-(s * R / 8)) with hρdef
  have hρ1 : ρ < 1 := by
    rw [hρdef, show (1 : ℝ) = (3 : ℝ) ^ (0 : ℝ) from (Real.rpow_zero 3).symm]
    exact Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by nlinarith)
  have hρ0 : 0 ≤ ρ := by positivity
  have hterm : ∀ j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * C = C * ρ ^ j := by
    intro j
    rw [hρdef, ← Real.rpow_natCast ((3 : ℝ) ^ (-(s * R / 8))) j,
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
    rw [show -(s * (j : ℝ) * R / 8) = -(s * R / 8) * (j : ℝ) from by ring, mul_comm]
  have hsummable : Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * C) := by
    simp_rw [hterm]; exact (summable_geometric_of_lt_one hρ0 hρ1).mul_left _
  refine ⟨hsummable, ?_⟩
  simp_rw [hterm]
  rw [tsum_mul_left, tsum_geometric_of_lt_one hρ0 hρ1]

theorem aux_lem_band_piece_product_baseline_c1_Tj_ge_two (m j : ℕ) (z : Vec d) (omega : PotentialSample d) :
    (2 : ENNReal) ≤ sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d ((m : ℤ) + 1 + (j : ℤ)) z ∧
      w = (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)) +
        sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))}} := by
  have hA : (1 : ENNReal) ≤
      ∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i z|) := by
    rw [aux_psf_prod_ofReal_exp, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (Real.one_le_exp
      (Finset.sum_nonneg (fun i _ => abs_nonneg _)))
  have hB : (1 : ENNReal) ≤ sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := by
    have hmem0 : (∏ i ∈ Finset.Icc (m + j) (m + j + 0),
        ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))) ∈
        {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := ⟨0, rfl⟩
    have heq1 : (∏ i ∈ Finset.Icc (m + j) (m + j + 0),
        ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))) = 1 := by simp
    rw [← heq1]
    exact le_sSup hmem0
  have hsum : (2 : ENNReal) ≤
      (∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i z|)) +
        sSup {u : ENNReal | ∃ K : ℕ, u = ∏ i ∈ Finset.Icc (m + j) (m + j + K),
          ENNReal.ofReal (Real.exp (4 * |omega i z - omega i z|))} := by
    have h2 : (2 : ENNReal) = 1 + 1 := by norm_num
    rw [h2]; exact add_le_add hA hB
  refine hsum.trans (le_sSup ⟨z, ?_, rfl⟩)
  rw [aux_psf_mem_translatedCube_iff]
  intro i
  simp only [sub_self, abs_zero]
  positivity

theorem aux_lem_band_piece_product_baseline_c1_PscF_ge_two (s : ℝ) (m : ℕ) (z : Vec d) (omega : PotentialSample d) :
