section DES3RootUnif

theorem aux_lem_band_des3_h0_root_extremes_unif :
  ∀ (d : ℕ), 2 ≤ d →
  ∀ [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)],
  ∀ (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (q : ℝ), 1 ≤ q →
  ∃ Cp Cd cd : ℝ, 0 < Cp ∧ 0 < Cd ∧ 0 < cd ∧
    ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ cd / q →
      ∃ (D Mx : ℕ → BilateralField d → ℝ),
        (∀ N om, 0 ≤ D N om ∧ 0 ≤ Mx N om) ∧
        (∀ᵐ om ∂(chaosSampleLaw M).toMeasure, ∀ N : ℕ,
          0 < Mx N om ∧
          (∀ x ∈ (closedCube z r hr : Set (SpatialCoordinates d)),
            (Mx N om)⁻¹ ≤ cutoffCoefficient M (fun _ => 0) om N x ∧
              cutoffCoefficient M (fun _ => 0) om N x ≤ Mx N om) ∧
          (∀ x y, x ∈ (closedCube z r hr : Set (SpatialCoordinates d)) →
            y ∈ (closedCube z r hr : Set (SpatialCoordinates d)) →
            |Real.log (cutoffCoefficient M (fun _ => 0) om N x) -
                Real.log (cutoffCoefficient M (fun _ => 0) om N y)| ≤
              D N om * (3 : ℝ) ^ N * dist x y)) ∧
        (∀ N, MemLp (D N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
          MemLp (Mx N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure) ∧
        (∀ N, eLpNorm (D N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (Cp * Real.sqrt (1 + (N : ℝ)))) ∧
        (∀ N, eLpNorm (Mx N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal (Cp * Real.exp ((Cd * M.delta + Cp * M.delta ^ 2) * N))) := by
  intro d hd instMS instBS z r hr q hq
  obtain ⟨Cp, Cd, cd, hCp, hCd, hcd, hext⟩ := aux_lem_band_h0_extremes d hd z r hr q hq
  refine ⟨Cp, Cd, cd, hCp, hCd, hcd, ?_⟩
  intro M hδ
  obtain ⟨D, mlow, mhigh, hD0, hae, hDmem, hYmem, hDmom, hYmom⟩ := hext M hδ
  have hzmem : z ∈ (closedCube z r hr : Set (SpatialCoordinates d)) := by
    show dist z z ≤ r / 2
    simp only [dist_self]; linarith
  refine ⟨D, fun N om => |mhigh N om + (mlow N om)⁻¹|, ?_, ?_, ?_, ?_⟩
  · intro N om
    exact ⟨hD0 N om, abs_nonneg _⟩
  · filter_upwards [hae] with om hom
    intro N
    obtain ⟨hlip, hmlow_pos, hbound⟩ := hom N
    have hApos : 0 < cutoffCoefficient M (fun _ => 0) om N z := by
      have hahom : 0 < SubdiffusiveProcess.CoarseGrainingVocab.ahom M N := SubdiffusiveProcess.CoarseGrainingVocab.ahom_pos M N
      rw [cutoffCoefficient]; positivity
    have hmhigh_pos : 0 < mhigh N om :=
      lt_of_lt_of_le hApos (hbound z hzmem).2
    have hsum_pos : 0 < mhigh N om + (mlow N om)⁻¹ :=
      add_pos hmhigh_pos (inv_pos.mpr hmlow_pos)
    have habs : |mhigh N om + (mlow N om)⁻¹| = mhigh N om + (mlow N om)⁻¹ :=
      abs_of_pos hsum_pos
    refine ⟨by rw [habs]; exact hsum_pos, ?_, hlip⟩
    intro x hx
    rw [habs]
    refine ⟨?_, ?_⟩
    · have h1 : 1 / (mhigh N om + (mlow N om)⁻¹) ≤ 1 / (mlow N om)⁻¹ :=
        one_div_le_one_div_of_le (inv_pos.mpr hmlow_pos) (le_add_of_nonneg_left hmhigh_pos.le)
      rw [one_div, one_div, inv_inv] at h1
      exact h1.trans (hbound x hx).1
    · exact (hbound x hx).2.trans (le_add_of_nonneg_right (inv_pos.mpr hmlow_pos).le)
  · intro N
    exact ⟨hDmem N, (hYmem N).abs⟩
  · refine ⟨hDmom, ?_⟩
    intro N
    calc eLpNorm (fun om => |mhigh N om + (mlow N om)⁻¹|) (ENNReal.ofReal q)
          (chaosSampleLaw M).toMeasure
        = eLpNorm (fun om => mhigh N om + (mlow N om)⁻¹) (ENNReal.ofReal q)
            (chaosSampleLaw M).toMeasure := by
          rw [show (fun om => |mhigh N om + (mlow N om)⁻¹|) =
              fun om => ‖mhigh N om + (mlow N om)⁻¹‖ from
            funext (fun om => (Real.norm_eq_abs _).symm)]
          exact eLpNorm_norm _
      _ ≤ ENNReal.ofReal (Cp * Real.exp ((Cd * M.delta + Cp * M.delta ^ 2) * N)) := hYmom N

end DES3RootUnif

