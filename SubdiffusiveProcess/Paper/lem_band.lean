theorem aux_lem_band_des3_Kfin_aesm {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (d : ℕ)
    (t t1 C Cφ : ℝ) (ht : 0 ≤ t) (N : ℕ) (Kf Df Mf : Ω → ℝ)
