    (om : BilateralField d) (N : ℕ) (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r)
    (hr1 : r ≤ 1)
    (Kmacv Dv Mxv : ℝ) (hK0 : 0 ≤ Kmacv) (hD0 : 0 ≤ Dv) (hMx : 0 < Mxv)
    (henv : ∀ x ∈ (closedCube z r hr : Set (SpatialCoordinates d)),
