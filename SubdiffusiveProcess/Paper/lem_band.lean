    have hstep2 := aux_lem_band_piece_field_scale ((3 : ℝ) ^ (-(s / 8) * (k : ℝ)))
      (Real.rpow_nonneg (by norm_num) _)
      (fun omega' => aux_prefix_bank_maxObs 0 k z (eta N omega')) (ENNReal.ofReal q)
      (Pbank * (1 + ((k - 0 : ℕ) : ℝ))) (hPbankbound M eta heta N 0 k z)
    have hstep3 : eLpNorm (fun omega' => (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) *
