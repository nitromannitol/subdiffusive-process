def aux_lem_band_U2_cellMap {d : ℕ} (m : ℤ) (w : SpatialCoordinates d) :
    C(SpatialCoordinates d, SpatialCoordinates d) :=
  ⟨cubeDilation w 0 ((3 : ℝ) ^ (-m)), continuous_cubeDilation w 0 _⟩

def aux_lem_band_U2_shift {d : ℕ} (m : ℤ) (w : SpatialCoordinates d) (omega : BilateralField d) :
    BilateralField d :=
  fun i => (omega (i - m)).comp (aux_lem_band_U2_cellMap m w)

def aux_lem_band_U2_retained {d : ℕ} (k : ℤ) (y : SpatialCoordinates d) (omega : BilateralField d) : ℝ :=
  if 0 ≤ k then ∑ j ∈ Finset.Ico (0 : ℤ) k, omega (-j) y
    else -∑ j ∈ Finset.Ico k (0 : ℤ), omega (-j) y

def aux_lem_band_U2_kappa {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (J : ℕ) : ℝ :=
  Real.exp (((J : ℝ) + 1) * SubdiffusiveProcess.Frozen.Assumptions.tauSq M.P) * SubdiffusiveProcess.CoarseGrainingVocab.ahom M J

def aux_lem_band_U2_reference {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (N : ℕ) (k : ℤ)
    (y : SpatialCoordinates d) (omega : BilateralField d) : ℝ :=
  aux_lem_band_U2_kappa M ((N : ℤ) - k).toNat / aux_lem_band_U2_kappa M N *
    Real.exp (H omega y + aux_lem_band_U2_retained k y omega)

def aux_lem_band_U2_unitChart {d : ℕ} (I : Paper.in_J d) (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (omega : BilateralField d) (K : ℕ) :
    Homogenization.Book.Ch02.TriadicCoeffFamily d :=
  I.chart 0 1 one_pos (Lane4.cutoffPositiveCoefficient M H omega K 0 one_pos) 0 1

def aux_lem_band_U2_lamF {d : ℕ} (sigma : ℝ) (F : Homogenization.Book.Ch02.TriadicCoeffFamily d) : ℝ :=
  Homogenization.Book.Ch02.lambdaSq (Homogenization.originCube d 0) sigma
    (Homogenization.Book.Ch02.MultiscaleExponent.finite 2) F

def aux_lem_band_U2_LamF {d : ℕ} (sigma : ℝ) (F : Homogenization.Book.Ch02.TriadicCoeffFamily d) : ℝ :=
  Homogenization.Book.Ch02.LambdaSq (Homogenization.originCube d 0) sigma
    (Homogenization.Book.Ch02.MultiscaleExponent.finite 2) F

def aux_lem_band_U2_sigF {d : ℕ} (i j : Fin d) (F : Homogenization.Book.Ch02.TriadicCoeffFamily d) : ℝ :=
  Homogenization.Book.Ch02.sigmaCoarse
    (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
    (F.coeffOn (Homogenization.originCube d 0)) i j

def aux_lem_band_U2_sigStarInvF {d : ℕ} (i j : Fin d)
    (F : Homogenization.Book.Ch02.TriadicCoeffFamily d) : ℝ :=
  Homogenization.Book.Ch02.sigmaStarInvCoarse
    (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
    (F.coeffOn (Homogenization.originCube d 0)) i j

def aux_lem_band_U2_errF {d : ℕ} (s : ℝ) (F : Homogenization.Book.Ch02.TriadicCoeffFamily d)
    (a0 : ℝ) : ℝ :=
  (SubdiffusiveProcess.CoarseGrainingVocab.paperHomogenizationErrorFinite (Homogenization.originCube d 0) 0 s
    Homogenization.Book.Ch02.MultiscaleExponent.infinity 2 F a0).toReal

def aux_lem_band_U2_Scaled {d : ℕ} (c : ℝ) (G F : Homogenization.Book.Ch02.TriadicCoeffFamily d) : Prop :=
  ∀ Q : Homogenization.TriadicCube d,
    Homogenization.openCubeSet Q ⊆ Homogenization.openCubeSet (Homogenization.originCube d 0) →
      Homogenization.Book.Ch02.CoeffOn.AEScaled c (G.coeffOn Q) (F.coeffOn Q)

def aux_lem_band_U2_IsOne {d : ℕ} (E : Homogenization.Book.Ch02.TriadicCoeffFamily d) : Prop :=
  ∀ Q : Homogenization.TriadicCube d,
    Homogenization.openCubeSet Q ⊆ Homogenization.openCubeSet (Homogenization.originCube d 0) →
      ∀ᵐ x ∂volume.restrict (Homogenization.openCubeSet Q),
        (E.coeffOn Q).toCoeffField x = Homogenization.scalarMatrix (1 : ℝ)

theorem aux_lem_band_U2_T1_shift_measurePreserving {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (m : ℤ) (w : SpatialCoordinates d) :
    MeasurePreserving (aux_lem_band_U2_shift m w) (chaosSampleLaw M).toMeasure
      (chaosSampleLaw M).toMeasure := by
