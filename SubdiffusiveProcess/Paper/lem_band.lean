  have hinner : ENNReal.ofReal (Real.exp ((18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)) ≤
      ENNReal.ofReal (Real.exp (1 / 4 : ℝ)) :=
    ENNReal.ofReal_le_ofReal (Real.exp_le_exp.2 (by linarith [hcap]))
  have hbase_le : (((7 ^ d : ℕ) : ℝ≥0∞) *
      (ENNReal.ofReal (Real.exp ((18 * p + 1) ^ 2 * aux_psf_sigma M ^ 2 / 4)) * 2)) ≤
      (((7 ^ d : ℕ) : ℝ≥0∞) * (ENNReal.ofReal (Real.exp (1 / 4 : ℝ)) * 2)) :=
    mul_le_mul_left' (mul_le_mul_right' hinner 2) _
  exact ENNReal.rpow_le_rpow hbase_le (by positivity)

