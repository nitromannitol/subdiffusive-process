    obtain ⟨Y2, hY2m, hY2b⟩ := hZband
    exact ⟨Y2, hY2m, by simpa using hY2b⟩
  obtain ⟨Y, hYm, hYb⟩ := hprodmain.2 hXband hZband'
  have hprodBA : aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-(h : ℤ)) (h : ℤ) q
      (fun omega => aux_lem_band_U2_reference M H K 0 (aux_lem_band_U2N_zn d) omega *
        Homogenization.Book.Ch02.responseJ
