    := by
                                                                 
  obtain ⟨a0F, c0F, w0F, ha0Fpos, hc0Fpos, hw0Fpos, hF⟩ :=
    aux_lem_band_piece_field d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
      s sigma eps hs hsigma heps T offset shift weight hweight Klip Phi hPhiLip hPhi0 hPhiNonneg
      CD hCD
  obtain ⟨a0P, c0P, w0P, ha0Ppos, hc0Ppos, hw0Ppos, hP⟩ :=
    aux_lem_band_piece_product d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
      s sigma eps hs hsigma heps T offset shift weight hweight Klip Phi hPhiLip hPhi0 hPhiNonneg
      CD hCD
  obtain ⟨a0R, c0R, w0R, ha0Rpos, hc0Rpos, hw0Rpos, hR⟩ :=
    aux_lem_band_piece_response d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
      s sigma eps hs hsigma heps T offset shift weight hweight Klip Phi hPhiLip hPhi0 hPhiNonneg
      CD hCD
  obtain ⟨a0C, c0C, w0C, ha0Cpos, hc0Cpos, hw0Cpos, hCw⟩ :=
    aux_lem_band_piece_coords d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp
      s sigma eps hs hsigma heps T offset shift weight hweight Klip Phi hPhiLip hPhi0 hPhiNonneg
      CD hCD
                                                                            
  set a : ℝ := min (min a0F a0P) (min a0R a0C) with ha_def
  set c : ℝ := min (min c0F c0P) (min c0R c0C) with hc_def
  set width : ℕ := max (max w0F w0P) (max w0R w0C) with hwidth_def
  have ha_pos : 0 < a := lt_min (lt_min ha0Fpos ha0Ppos) (lt_min ha0Rpos ha0Cpos)
  have hc_pos : 0 < c := lt_min (lt_min hc0Fpos hc0Ppos) (lt_min hc0Rpos hc0Cpos)
  have haF : a ≤ a0F := (min_le_left _ _).trans (min_le_left _ _)
  have haP : a ≤ a0P := (min_le_left _ _).trans (min_le_right _ _)
  have haR : a ≤ a0R := (min_le_right _ _).trans (min_le_left _ _)
  have haC : a ≤ a0C := (min_le_right _ _).trans (min_le_right _ _)
  have hcF : c ≤ c0F := (min_le_left _ _).trans (min_le_left _ _)
  have hcP : c ≤ c0P := (min_le_left _ _).trans (min_le_right _ _)
  have hcR : c ≤ c0R := (min_le_right _ _).trans (min_le_left _ _)
