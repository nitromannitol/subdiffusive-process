    have h1 : eLpNorm (fun om => Real.exp |H om z| *
        |mhigh0 N (aux_prop_growth_energy_assembly_shift d z om) +
          (mlow0 N (aux_prop_growth_energy_assembly_shift d z om))⁻¹|) (ENNReal.ofReal q)
        (chaosSampleLaw M).toMeasure ≤
