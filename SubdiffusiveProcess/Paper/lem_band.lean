      ≤ Cβ * (2 * (C * δc * (3 : ℝ) ^ (-(min a s * h)))) := mul_le_mul_of_nonneg_left hsum hCβ
    _ = 2 * Cβ * C * δc * (3 : ℝ) ^ (-(min a s * h)) := by ring

