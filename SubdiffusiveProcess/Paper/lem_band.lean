theorem aux_lem_band_piece_product_baseline_c1_gterm_bound (M : GMCModel d) (s : ℝ) (m : ℕ) (z : Vec d) (R : ℝ) (hR0 : 0 < R)
    (hR1 : 1 ≤ R) (K Cbmaj : ℝ) (hKdef : K = 2 * Real.exp 1)
    (hsq4 : (R + (aux_psf_sigma M)⁻¹) ^ 2 * aux_psf_sigma M ^ 2 ≤ 4)
    (hCbmaj_ge : aux_prefix_praw_CB M ((aux_psf_sigma M)⁻¹ + R) ≤ Cbmaj) (j : ℕ) :
    (∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
