theorem aux_lem_band_retained_rate (d : ℕ) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1)
    (hq1 : 1 ≤ q) (h8dq : 8 * (d : ℝ) ≤ a1 * q) (Cq : ℝ) (hCq : 0 ≤ Cq) :
    ∃ Cret : ℝ, 0 ≤ Cret ∧
      ∀ (Hgrid Wgrid h : ℕ), Hgrid ≤ 2 * (h + 1) → 2 * (h + 1) ≤ Wgrid - Hgrid →
      (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
          (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
        Cret * (3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ))) := by
  have hq0 : 0 < q := by linarith
  set a0final : ℝ := min a1 s / 16 with ha0def
  have ha0pos : 0 < a0final := by rw [ha0def]; have := lt_min ha1 hs0; positivity
  obtain ⟨Cpoly, hCpolynn, hCpoly⟩ := aux_lem_band_poly_le_exp (7 * a1 / 4 - a0final) (by
    rw [ha0def]; nlinarith [min_le_left a1 s, ha1])
  refine ⟨Cq * Cpoly, by positivity, ?_⟩
  intro Hgrid Wgrid h hHle hWH
  have hpolyfinal := hCpoly h
  have hcard_mono : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ≤
      (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) := by
    have h1 : Hgrid + 1 ≤ 2 * h + 3 := by omega
    have h2 : (3 ^ (Hgrid + 2) : ℕ) ≤ 3 ^ (2 * h + 4) := Nat.pow_le_pow_right (by norm_num) (by omega)
    have h3 : (3 ^ (Hgrid + 2) : ℕ) ^ d ≤ (3 ^ (2 * h + 4)) ^ d := Nat.pow_le_pow_left h2 d
    exact_mod_cast Nat.mul_le_mul h1 h3
  have hcard_pow_mono : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) ≤
      (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) ^ (1 / q) :=
    Real.rpow_le_rpow (by positivity) hcard_mono (by positivity)
  have hexp_mono : (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ))) ≤
      (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) := by
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have : (2 * (h + 1) : ℝ) ≤ ((Wgrid - Hgrid : ℕ) : ℝ) := by exact_mod_cast hWH
    nlinarith [this, ha1.le]
  have hstep1 : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
      (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
      (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) ^ (1 / q) *
        (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) :=
    mul_le_mul hcard_pow_mono (mul_le_mul_of_nonneg_left hexp_mono hCq)
      (by positivity) (by positivity)
  have hcast : (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) =
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((2 * h + 4) * d : ℕ) := by
    have hpoweq : ((3 ^ (2 * h + 4)) ^ d : ℕ) = 3 ^ ((2 * h + 4) * d) := by rw [← pow_mul]
    rw [hpoweq]; push_cast; ring
  have hrpoweq : ((3 : ℝ) ^ ((2 * h + 4) * d : ℕ) : ℝ) ^ (1 / q) =
      (3 : ℝ) ^ (((2 * h + 4) * d : ℕ) * (1 / q) : ℝ) := by
    rw [← Real.rpow_natCast (3 : ℝ) ((2 * h + 4) * d), ← Real.rpow_mul (by norm_num)]
  have hprodrpow : ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((2 * h + 4) * d : ℕ)) ^ (1 / q) =
      (2 * (h : ℝ) + 3) ^ (1 / q) * ((3 : ℝ) ^ ((2 * h + 4) * d : ℕ)) ^ (1 / q) :=
    Real.mul_rpow (by positivity) (by positivity)
  have hpolyle : (2 * (h : ℝ) + 3) ^ (1 / q) ≤ 2 * (h : ℝ) + 3 := by
    have hx1 : (1 : ℝ) ≤ 2 * (h : ℝ) + 3 := by have := Nat.cast_nonneg (α := ℝ) h; linarith
    calc (2 * (h : ℝ) + 3) ^ (1 / q) ≤ (2 * (h : ℝ) + 3) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hx1 (by rw [div_le_one hq0]; linarith)
      _ = 2 * (h : ℝ) + 3 := Real.rpow_one _
  have hexppart : (((2 * h + 4) * d : ℕ) : ℝ) * (1 / q) ≤ (a1 / 8) * ((2 * h + 4 : ℕ) : ℝ) := by
    have hdq : (d : ℝ) / q ≤ a1 / 8 := by
      rw [div_le_div_iff₀ hq0 (by norm_num : (0 : ℝ) < 8)]
      nlinarith [h8dq]
    have heq : (((2 * h + 4) * d : ℕ) : ℝ) * (1 / q) = ((2 * h + 4 : ℕ) : ℝ) * ((d : ℝ) / q) := by
      push_cast; ring
    rw [heq]
    have h2h4 : (0 : ℝ) ≤ ((2 * h + 4 : ℕ) : ℝ) := by positivity
    nlinarith [mul_le_mul_of_nonneg_left hdq h2h4]
  have hexpsplit : (3 : ℝ) ^ (((2 * h + 4) * d : ℕ) * (1 / q) : ℝ) ≤
      (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) hexppart
  have hcombine1 : (((2 * h + 3) * (3 ^ (2 * h + 4)) ^ d : ℕ) : ℝ) ^ (1 / q) ≤
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) := by
    rw [hcast, hprodrpow, hrpoweq]
    exact mul_le_mul hpolyle hexpsplit (by positivity) (by positivity)
  have hexpeq : (a1 / 8) * ((2 * h + 4 : ℕ) : ℝ) + (-(a1 * (2 * (h + 1) : ℝ))) =
      -(7 * a1 / 4) * (h : ℝ) - (3 * a1 / 2) := by push_cast; ring
  have hstep2 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
      (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) ≤
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) := by
    rw [mul_assoc, ← Real.rpow_add (by norm_num), hexpeq]
    have hle : -(7 * a1 / 4) * (h : ℝ) - (3 * a1 / 2) ≤ -(7 * a1 / 4) * (h : ℝ) := by
      nlinarith [ha1.le]
    have hrpowle : (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ) - (3 * a1 / 2)) ≤
        (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) hle
    have h2h3nn : (0 : ℝ) ≤ 2 * (h : ℝ) + 3 := by positivity
    exact mul_le_mul_of_nonneg_left hrpowle h2h3nn
  have hexpid3 : (7 * a1 / 4 - a0final) * (h : ℝ) + (-(7 * a1 / 4) * (h : ℝ)) =
      -(a0final * (h : ℝ)) := by ring
  have hstep3 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) ≤
      Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by
    have h1 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) ≤
        (Cpoly * (3 : ℝ) ^ ((7 * a1 / 4 - a0final) * (h : ℝ))) *
          (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) := by
      have hrpownn : (0 : ℝ) ≤ (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ)) := by positivity
      exact mul_le_mul_of_nonneg_right hpolyfinal hrpownn
    refine h1.trans (le_of_eq ?_)
    rw [mul_assoc, ← Real.rpow_add (by norm_num), hexpid3]
  have hfinal1 : (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
      (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
        (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) :=
    hstep1.trans (mul_le_mul_of_nonneg_right hcombine1 (by positivity))
  have hfinal2 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
      (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) =
      (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
        (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) * Cq := by ring
  have hfinal3 : (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
      (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) * Cq ≤
      ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ))) * Cq :=
    mul_le_mul_of_nonneg_right hstep2 hCq
  have hfinal4 : ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ))) * Cq ≤
      (Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ)))) * Cq :=
    mul_le_mul_of_nonneg_right hstep3 hCq
  calc (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
        (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ))))
      ≤ (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
          (Cq * (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ)))) := hfinal1
    _ = (2 * (h : ℝ) + 3) * (3 : ℝ) ^ ((a1 / 8) * ((2 * h + 4 : ℕ) : ℝ)) *
          (3 : ℝ) ^ (-(a1 * (2 * (h + 1) : ℝ))) * Cq := hfinal2
    _ ≤ ((2 * (h : ℝ) + 3) * (3 : ℝ) ^ (-(7 * a1 / 4) * (h : ℝ))) * Cq := hfinal3
    _ ≤ (Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ)))) * Cq := hfinal4
    _ = Cq * Cpoly * (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by ring

def aux_lem_band_Cret (d : ℕ) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1) (hq1 : 1 ≤ q)
    (h8dq : 8 * (d : ℝ) ≤ a1 * q) (Cq : ℝ) (hCq : 0 ≤ Cq) : ℝ :=
  (aux_lem_band_retained_rate d s a1 q hs0 ha1 hq1 h8dq Cq hCq).choose

theorem aux_lem_band_Cret_spec (d : ℕ) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1) (hq1 : 1 ≤ q)
    (h8dq : 8 * (d : ℝ) ≤ a1 * q) (Cq : ℝ) (hCq : 0 ≤ Cq) :
    0 ≤ aux_lem_band_Cret d s a1 q hs0 ha1 hq1 h8dq Cq hCq ∧
      ∀ (Hgrid Wgrid h : ℕ), Hgrid ≤ 2 * (h + 1) → 2 * (h + 1) ≤ Wgrid - Hgrid →
        (((Hgrid + 1) * (3 ^ (Hgrid + 2)) ^ d : ℕ) : ℝ) ^ (1 / q) *
            (Cq * (3 : ℝ) ^ (-(a1 * ((Wgrid - Hgrid : ℕ) : ℝ)))) ≤
          aux_lem_band_Cret d s a1 q hs0 ha1 hq1 h8dq Cq hCq *
            (3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ))) :=
  (aux_lem_band_retained_rate d s a1 q hs0 ha1 hq1 h8dq Cq hCq).choose_spec

def aux_lem_band_Ctrunc (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (_Poincare : Paper.in_poincare d hd I)
    (_Extension : Paper.in_extension d hd I) (_Perturbation : Lane4.SmallPerturbationInput d)
    (_Sobolev : Lane4.SobolevFoundationalInput d hd)
    (D : Paper.lane4_deterministic_good_scale_input d) (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s q : ℝ) (hs0 : 0 < s) (hq1 : 1 ≤ q)
    (hq_a1 : 8 * (d : ℝ) / aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
        hCresp ≤ q) : ℝ :=
  aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q)) +
    aux_lem_band_Cret d s
      (aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp) q hs0
      (aux_lem_band_rcJ_a1_pos hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp) hq1
      (by
        have ha1pos := aux_lem_band_rcJ_a1_pos hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
          hCresp
        rw [mul_comm (aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp)
          q]
        exact (div_le_iff₀ ha1pos).mp hq_a1)
      (aux_lem_band_rcJ_C hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q hq1)
      (aux_lem_band_rcJ_qspec hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q hq1).2.1

theorem aux_lem_band_Ctrunc_nonneg (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (_Poincare : Paper.in_poincare d hd I)
    (_Extension : Paper.in_extension d hd I) (_Perturbation : Lane4.SmallPerturbationInput d)
    (_Sobolev : Lane4.SobolevFoundationalInput d hd)
    (D : Paper.lane4_deterministic_good_scale_input d) (Cresp : ℝ) (hCresp : 0 < Cresp)
    (s q : ℝ) (hs0 : 0 < s) (hq1 : 1 ≤ q)
    (hq_a1 : 8 * (d : ℝ) / aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
        hCresp ≤ q)
    (hsqq : 8 * (d : ℝ) < s * q) :
    0 ≤ aux_lem_band_Ctrunc d hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp s q
        hs0 hq1 hq_a1 := by
  unfold aux_lem_band_Ctrunc
  have hq0 : 0 < q := by linarith
  have hKnn : 0 ≤ aux_prefix_rraw_K d s q := aux_prefix_rraw_K_nonneg d s q hq0 hsqq
  have hClognn : 0 ≤ aux_prefix_rraw_C d * q * Real.log (2 + q) := by
    have hClog := (aux_prefix_rraw_C_spec d).1
    have hlog : 0 ≤ Real.log (2 + q) := Real.log_nonneg (by linarith)
    positivity
  have hCretnn := (aux_lem_band_Cret_spec d s
    (aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp) q hs0
    (aux_lem_band_rcJ_a1_pos hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp) hq1
    (by
      have ha1pos := aux_lem_band_rcJ_a1_pos hd I _Poincare _Extension _Perturbation _Sobolev D Cresp
        hCresp
      rw [mul_comm (aux_lem_band_rcJ_a1 hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp) q]
      exact (div_le_iff₀ ha1pos).mp hq_a1)
    (aux_lem_band_rcJ_C hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q hq1)
    (aux_lem_band_rcJ_qspec hd I _Poincare _Extension _Perturbation _Sobolev D Cresp hCresp q hq1).2.1).1
  exact add_nonneg (mul_nonneg hKnn hClognn) hCretnn

theorem aux_lem_band_piece_response_baseline
    {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (s eps : ℝ) (hs : 0 < s) (heps : 0 < eps)
    (weight3 : ℝ) (hweight3 : 0 ≤ weight3)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (hprim : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
      primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (p q : ℝ) (hp1 : 1 ≤ p) (hpq : p ≤ q)
    (hMr : M.delta ≤ aux_prefix_rraw_delta0 d s ({q} : Finset ℝ)) (hM1 : M.delta ≤ 1)
    (N : ℕ) (n : ℤ) (z : Vec d) (hn : n ≤ (N : ℤ)) :
    eLpNorm (fun omega =>
        weight3 * (min (1 : ENNReal)
          ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
              ENNReal.ofReal (eps ^ 2 / 4)) /
            ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
    ENNReal.ofReal (weight3 * (4 / (3 * eps ^ 2)) *
      (aux_prefix_rraw_K d s (aux_prefix_rraw_q d s ({q} : Finset ℝ)) *
        aux_prefix_rraw_rho d s (aux_prefix_rraw_q d s ({q} : Finset ℝ)) *
        (aux_prefix_rraw_C d * aux_prefix_rraw_q d s ({q} : Finset ℝ) *
          Real.log (2 + aux_prefix_rraw_q d s ({q} : Finset ℝ)) * M.delta ^ 2))) := by
  haveI : IsProbabilityMeasure (chaosSampleLaw M).toMeasure := inferInstance
  set moments : Finset ℝ := ({q} : Finset ℝ) with hmomdef
  set q' : ℝ := aux_prefix_rraw_q d s moments with hq'def
  have hq2 := aux_prefix_rraw_two_le_q d s moments
  have hq'1 : 1 ≤ q' := by rw [hq'def]; linarith
  have hq'0 : 0 < q' := by rw [hq'def]; linarith
  have hsq := aux_prefix_rraw_margin d s hs moments
  have hdeltapos : 0 < M.delta := M.shellPrefix.delta_pos
  have hbank := (aux_prefix_rraw_delta0_spec d s moments).2 M hdeltapos hMr
  have hClog := (aux_prefix_rraw_C_spec d).1
  have hlog : 0 ≤ Real.log (2 + q') := Real.log_nonneg (by rw [hq'def]; linarith)
  have hb : 0 ≤ aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2 := by positivity
  have hgood : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega =
        aux_prefix_rraw_Rset M s (eta N omega) ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) := by
    filter_upwards [hprim] with omega hω
    obtain ⟨_, _, _, _, _, _, hR, _⟩ := hω N
    exact hR _ _
  have htail := (aux_prefix_rraw_tail_eLpNorm_le M s eta heta _ _ hq'1 hbank N
    ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) 0).trans
    (aux_prefix_rraw_tail_numeric d s _ hq'0 hsq _ hb 0 ((N : ℤ) - n).toNat)
  simp only [zero_add, pow_one] at htail
  have hRq' : eLpNorm (fun omega => (Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal)
      (ENNReal.ofReal q') (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (aux_prefix_rraw_K d s q' * aux_prefix_rraw_rho d s q' *
        (aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2)) := by
    refine (eLpNorm_mono_ae_real ?_).trans htail
    filter_upwards [hgood] with omega hω
    rw [hω, Real.norm_of_nonneg ENNReal.toReal_nonneg]
    exact aux_prefix_rraw_Rset_toReal_le_tail_zero M s _ _ _
  have hRne : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega ≠ ⊤ := by
    filter_upwards [hgood] with omega hω
    rw [hω]
    unfold aux_prefix_rraw_Rset
    exact aux_psf_Rsc_ne_top M s _ _ (eta N omega)
  have hRmeas : AEStronglyMeasurable
      (fun omega => (Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal)
      (chaosSampleLaw M).toMeasure := by
    have hfull := (aux_lem_prefix_limit_raw_Rraw_bound M s eps hs moments hMr hM1 eta heta
      F Praw Rraw Draw Z rawGood hprim N n z).1
    simpa only [if_pos hn] using hfull
  have hqq' : q ≤ q' := by
    have h1 : (0 : ℝ) ≤ |16 * (d : ℝ) / s| := abs_nonneg _
    have h2 : q ≤ |q| := le_abs_self q
    have h3 : |q| ≤ ∑ x ∈ moments, |x| := by rw [hmomdef, Finset.sum_singleton]
    rw [hq'def]
    unfold aux_prefix_rraw_q
    linarith
  have hpq'' : p ≤ q' := hpq.trans hqq'
  have hpq' : ENNReal.ofReal p ≤ ENNReal.ofReal q' := ENNReal.ofReal_le_ofReal hpq''
  have hRp : eLpNorm (fun omega => (Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega).toReal)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (aux_prefix_rraw_K d s q' * aux_prefix_rraw_rho d s q' *
        (aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2)) :=
    (eLpNorm_le_eLpNorm_of_exponent_le hpq' hRmeas).trans hRq'
  have hlohi : eps ^ 2 / 4 < eps ^ 2 := by nlinarith
  have key := aux_lem_band_eramp_eLpNorm_le (ENNReal.ofReal p) (eps ^ 2 / 4) (eps ^ 2)
    (by positivity) hlohi
    (fun omega => Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega) (fun _ => (0 : ENNReal))
    hRne (Eventually.of_forall (fun _ => by simp))
  have heq0 : (min (1 : ENNReal) (((0 : ENNReal) - ENNReal.ofReal (eps ^ 2 / 4)) /
      ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal = 0 := by simp
  simp only [heq0, ENNReal.toReal_zero, sub_zero] at key
  have hscaled : (fun omega : BilateralField d => weight3 *
      (min (1 : ENNReal) ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
          ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal)
      = weight3 • (fun omega => (min (1 : ENNReal)
          ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
              ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal) := by
    funext omega; simp [smul_eq_mul]
  rw [hscaled, eLpNorm_const_smul, Real.enorm_eq_ofReal hweight3]
  have hinvnn : (0 : ℝ) ≤ (eps ^ 2 - eps ^ 2 / 4)⁻¹ :=
    inv_nonneg.mpr (by nlinarith)
  have hchain : ENNReal.ofReal weight3 *
      eLpNorm (fun omega => (min (1 : ENNReal)
          ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
              ENNReal.ofReal (eps ^ 2 / 4)) / ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal)
        (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal weight3 *
        (ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4)⁻¹ *
          ENNReal.ofReal (aux_prefix_rraw_K d s q' * aux_prefix_rraw_rho d s q' *
            (aux_prefix_rraw_C d * q' * Real.log (2 + q') * M.delta ^ 2))) :=
    mul_le_mul_left' (key.trans (mul_le_mul_left' hRp _)) _
  refine hchain.trans (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul hinvnn, ← ENNReal.ofReal_mul hweight3]
  congr 1
  have hinv : (eps ^ 2 - eps ^ 2 / 4)⁻¹ = 4 / (3 * eps ^ 2) := by
    have heq34 : eps ^ 2 - eps ^ 2 / 4 = 3 * eps ^ 2 / 4 := by ring
    rw [heq34]
    field_simp
  rw [hinv]
  ring

theorem aux_lem_band_tail_rate {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (s a1 q : ℝ) (hs0 : 0 < s) (ha1 : 0 < a1)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (hq1 : 1 ≤ q) (hq0 : 0 < q) (hsqq : 8 * (d : ℝ) < s * q) (hd_q : (d : ℝ) / q ≤ s / 32)
    (hM1 : M.delta ≤ 1) (hMdelta_tailq : M.delta ≤ aux_lem_band_tailq_delta0 d q hq1)
    (N m : ℕ) (w : Vec d) (h : ℕ) :

      eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
          (aux_prefix_rraw_shallow M s (eta N omega) m w (min (2 * (h + 1)) m)).toReal)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal ((aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q))) *
          (3 : ℝ) ^ (-(min a1 s / 16 * (h : ℝ)))) := by
  have hdelta2le1 : M.delta ^ 2 ≤ 1 := pow_le_one₀ M.shellPrefix.delta_pos.le hM1
  set a0final := min a1 s / 16 with ha0def
  have ha0pos : 0 < a0final := by rw [ha0def]; have := lt_min ha1 hs0; positivity
  set Hgrid : ℕ := min (2 * (h + 1)) m with hHdef
  have hHm : Hgrid ≤ m := min_le_right _ _
  rcases le_or_lt (2 * (h + 1)) m with hcase | hcase
  · have hHeq : Hgrid = 2 * (h + 1) := by rw [hHdef]; omega
    have hbankq : ∀ (n' : ℕ) (x : Vec d),
        eLpNorm (fun omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d =>
            (aux_psf_Jval M n' omega x).toReal) (ENNReal.ofReal q) M.P.toMeasure ≤
          ENNReal.ofReal (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) :=
      fun n' x => (aux_lem_band_tailq_delta0_spec d q hq1).2 M M.shellPrefix.delta_pos
        hMdelta_tailq n' x
    have hBnn : 0 ≤ aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2 := by
      have hClog := (aux_prefix_rraw_C_spec d).1
      have hlog : 0 ≤ Real.log (2 + q) := Real.log_nonneg (by linarith)
      positivity
    have htailraw := aux_lem_band_trunc_tail M s eta heta q
      (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) hq1 hsqq hbankq hBnn N m w
      Hgrid hHm
    have hKnn : 0 ≤ aux_prefix_rraw_K d s q := aux_prefix_rraw_K_nonneg d s q hq0 hsqq
    have hrhopos := aux_prefix_rraw_rho_pos d s q
    have hrhole : aux_prefix_rraw_rho d s q ≤ (3 : ℝ) ^ (-(3 * s / 32)) := by
      unfold aux_prefix_rraw_rho
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      nlinarith [hd_q]
    have hHeq2 : Hgrid + 1 = 2 * h + 3 := by omega
    have hpow_le : aux_prefix_rraw_rho d s q ^ (Hgrid + 1) ≤
        (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) := by
      rw [hHeq2]
      calc aux_prefix_rraw_rho d s q ^ (2 * h + 3) ≤ ((3 : ℝ) ^ (-(3 * s / 32))) ^ (2 * h + 3) :=
            pow_le_pow_left₀ hrhopos.le hrhole _
        _ = (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) := by
            rw [← Real.rpow_natCast ((3 : ℝ) ^ (-(3 * s / 32))) (2 * h + 3),
              ← Real.rpow_mul (by norm_num)]
    have hfinal_exp_tail : (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) ≤
        (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have h1 : a0final ≤ 3 * s / 16 := by rw [ha0def]; nlinarith [min_le_right a1 s]
      push_cast
      nlinarith [h1, Nat.cast_nonneg (α := ℝ) h]
    refine htailraw.trans (ENNReal.ofReal_le_ofReal ?_)
    have hClognn : 0 ≤ aux_prefix_rraw_C d * q * Real.log (2 + q) := by
      have hClog := (aux_prefix_rraw_C_spec d).1
      have hlog : 0 ≤ Real.log (2 + q) := Real.log_nonneg (by linarith)
      positivity
    calc aux_prefix_rraw_K d s q * aux_prefix_rraw_rho d s q ^ (Hgrid + 1) *
          (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2)
        ≤ aux_prefix_rraw_K d s q * (3 : ℝ) ^ (-(3 * s / 32) * ((2 * h + 3 : ℕ) : ℝ)) *
            (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hpow_le hKnn) hBnn
      _ ≤ aux_prefix_rraw_K d s q * (3 : ℝ) ^ (-(a0final * (h : ℝ))) *
            (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hfinal_exp_tail hKnn) hBnn
      _ = aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2) *
            (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by ring
      _ ≤ aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q) * 1) *
            (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by
          have hrate_nn : (0 : ℝ) ≤ (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by positivity
          have hstep : aux_prefix_rraw_C d * q * Real.log (2 + q) * M.delta ^ 2 ≤
              aux_prefix_rraw_C d * q * Real.log (2 + q) * 1 :=
            mul_le_mul_of_nonneg_left hdelta2le1 hClognn
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hstep hKnn) hrate_nn
      _ = aux_prefix_rraw_K d s q * (aux_prefix_rraw_C d * q * Real.log (2 + q)) *
            (3 : ℝ) ^ (-(a0final * (h : ℝ))) := by ring
  · have hzero : ∀ omega, (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal = 0 := by
      intro omega
      have htail0 : aux_prefix_rraw_tail M s (eta N omega) m w Hgrid = 0 := by
        unfold aux_prefix_rraw_tail
        rw [Finset.Ico_eq_empty (by omega)]
        simp
      have hb := aux_prefix_rraw_abs_Rset_sub_shallow_le M s (eta N omega) m w Hgrid hHm
      rw [htail0, ENNReal.toReal_zero] at hb
      exact abs_eq_zero.mp (le_antisymm hb (abs_nonneg _))
    have heq0 : (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal) = fun _ => (0 : ℝ) :=
      funext hzero
    rw [heq0]
    have hz : eLpNorm (fun _ => (0 : ℝ)) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure = 0 := by
      simp
    rw [hz]
    exact zero_le _

theorem aux_lem_band_piece_response_assemble
    {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (s eps : ℝ) (hs0 : 0 < s)
    (heps : eps ∈ Set.Ioo (0 : ℝ) 1)
    (weight3 : ℝ) (hweight3 : 0 ≤ weight3)
    (eta : ℕ → BilateralField d → SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d)
    (heta : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ∀ (N i : ℕ) (y : Vec d), eta N omega i y =
        omega ((i : ℤ) - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • y))
    (F Praw Rraw Draw : ℕ → ℕ → Vec d → BilateralField d → ENNReal)
    (Z : ℕ → ℕ → Vec d → BilateralField d → ℝ)
    (rawGood : ℕ → ℕ → Vec d → BilateralField d → Prop)
    (hprim : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ N,
      primitive_scores d M s eps (eta N omega)
        (fun m y => F N m y omega) (fun m y => Praw N m y omega)
        (fun m y => Rraw N m y omega) (fun m y => Draw N m y omega)
        (fun m y => Z N m y omega) (fun m y => rawGood N m y omega))
    (p q : ℝ) (hq1 : 1 ≤ q) (hpq : p ≤ q)
    (hMr : M.delta ≤ aux_prefix_rraw_delta0 d s ({q} : Finset ℝ))
    (hM1 : M.delta ≤ 1)
    (N : ℕ) (n : ℤ) (z : Vec d) (hn : n ≤ (N : ℤ)) (h : ℕ)
    (a0 : ℝ) (Hgrid Wgrid : ℕ)
    (CTail : ℝ) (hCTailnn : 0 ≤ CTail)
    (hTailbound : eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega)
          ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z)).toReal -
        (aux_prefix_rraw_shallow M s (eta N omega) ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z)
            Hgrid).toReal)
      (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (CTail * (3 : ℝ) ^ (-(a0 * (h : ℝ)))))
    (Rtrunc : BilateralField d → ℝ)
    (hRtruncmeas : AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] Rtrunc (chaosSampleLaw M).toMeasure)
    (hRtruncnn : ∀ omega, 0 ≤ Rtrunc omega)
    (Cret : ℝ) (hCretnn : 0 ≤ Cret)
    (hRetfinal : eLpNorm (fun omega => (aux_prefix_rraw_shallow M s (eta N omega)
          ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) Hgrid).toReal - Rtrunc omega)
      (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Cret * (3 : ℝ) ^ (-(a0 * (h : ℝ))))) :
    ∃ Ytrunc : BilateralField d → ℝ,
      AEStronglyMeasurable[MeasurableSpace.comap
        (fun omega : BilateralField d =>
          fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ))
        inferInstance] Ytrunc (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega =>
          weight3 * (min (1 : ENNReal)
            ((Rraw N ((N : ℤ) - n).toNat ((3 : ℝ) ^ N • z) omega -
                ENNReal.ofReal (eps ^ 2 / 4)) /
              ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal - Ytrunc omega)
        (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal (weight3 * (4 / (3 * eps ^ 2)) * (CTail + Cret) *
          (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
  haveI : IsProbabilityMeasure (chaosSampleLaw M).toMeasure := inferInstance
  set m : ℕ := ((N : ℤ) - n).toNat with hmdef
  set w : Vec d := (3 : ℝ) ^ N • z with hwdef
  have hgood : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Rraw N m w omega = aux_prefix_rraw_Rset M s (eta N omega) m w := by
    filter_upwards [hprim] with omega hω
    obtain ⟨_, _, _, _, _, _, hR, _⟩ := hω N
    exact hR m w
  have hRmeas : AEStronglyMeasurable (fun omega => (Rraw N m w omega).toReal)
      (chaosSampleLaw M).toMeasure := by
    have hfull := (aux_lem_prefix_limit_raw_Rraw_bound M s eps hs0 ({q} : Finset ℝ) hMr hM1 eta
      heta F Praw Rraw Draw Z rawGood hprim N n z).1
    simpa only [if_pos hn] using hfull
  have hshallowmeas : AEStronglyMeasurable (fun omega =>
      (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal)
      (chaosSampleLaw M).toMeasure :=
    (Measurable.comp_aemeasurable' ENNReal.measurable_toReal
      ((aux_prefix_rraw_shallow_measurable M s m w Hgrid).comp_aemeasurable'
        (prefix_eta_aemeasurable M eta heta N))).aestronglyMeasurable
  have hRtruncmeas' : AEStronglyMeasurable Rtrunc (chaosSampleLaw M).toMeasure :=
    aux_lem_band_aesm_mono _ _ _ Rtrunc hRtruncmeas
      (by
        have hrestriction : Measurable (fun omega : BilateralField d =>
            fun j : Set.Icc (-n - (Wgrid : ℕ)) (-n + (Wgrid : ℕ)) => omega (j : ℤ)) :=
          measurable_pi_iff.mpr fun j => measurable_pi_apply (j : ℤ)
        exact hrestriction.comap_le)
  have hcombined : eLpNorm (fun omega => (Rraw N m w omega).toReal - Rtrunc omega)
      (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ((CTail + Cret) * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by
    have hstep : eLpNorm (fun omega => (Rraw N m w omega).toReal - Rtrunc omega)
        (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure =
        eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal - Rtrunc omega)
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure := by
      refine eLpNorm_congr_ae ?_
      filter_upwards [hgood] with omega hω
      rw [hω]
    rw [hstep]
    have heqsplit : (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
          Rtrunc omega) =
        (fun omega => ((aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
            (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal) +
          ((aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal - Rtrunc omega)) := by
      funext omega; ring
    rw [heqsplit]
    have hp1q : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hq1
    have hRsetmeas : AEStronglyMeasurable (fun omega =>
        (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal) (chaosSampleLaw M).toMeasure := by
      refine hRmeas.congr ?_
      filter_upwards [hgood] with omega hω
      rw [hω]
    have hmeas1 : AEStronglyMeasurable (fun omega =>
        (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
          (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal)
        (chaosSampleLaw M).toMeasure := hRsetmeas.sub hshallowmeas
    have hmeas2 : AEStronglyMeasurable (fun omega =>
        (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal - Rtrunc omega)
        (chaosSampleLaw M).toMeasure := hshallowmeas.sub hRtruncmeas'
    refine (eLpNorm_add_le hmeas1 hmeas2 hp1q).trans ?_
    calc eLpNorm (fun omega => (aux_prefix_rraw_Rset M s (eta N omega) m w).toReal -
            (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal)
          (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure +
        eLpNorm (fun omega => (aux_prefix_rraw_shallow M s (eta N omega) m w Hgrid).toReal -
            Rtrunc omega) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure
        ≤ ENNReal.ofReal (CTail * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) +
            ENNReal.ofReal (Cret * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) :=
          add_le_add hTailbound hRetfinal
      _ = ENNReal.ofReal (CTail * (3 : ℝ) ^ (-(a0 * (h : ℝ))) +
            Cret * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) :=
          (ENNReal.ofReal_add (by positivity) (by positivity)).symm
      _ = ENNReal.ofReal ((CTail + Cret) * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) := by ring_nf
                                                                              
  have hRne : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, Rraw N m w omega ≠ ⊤ :=
    aux_lem_band_piece_response_Rraw_ne_top M s eps eta F Praw Rraw Draw Z rawGood hprim N m w
  have hpqE : ENNReal.ofReal p ≤ ENNReal.ofReal q := ENNReal.ofReal_le_ofReal hpq
  have hcombined_p : eLpNorm (fun omega => (Rraw N m w omega).toReal - Rtrunc omega)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal ((CTail + Cret) * (3 : ℝ) ^ (-(a0 * (h : ℝ)))) :=
    (eLpNorm_le_eLpNorm_of_exponent_le hpqE (hRmeas.sub hRtruncmeas')).trans hcombined
  have hlohi : eps ^ 2 / 4 < eps ^ 2 := by nlinarith [heps.1, heps.2]
  have hRtruncofReal : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ENNReal.ofReal (Rtrunc omega) ≠ ⊤ := Eventually.of_forall (fun _ => ENNReal.ofReal_ne_top)
  have key := aux_lem_band_eramp_eLpNorm_le (ENNReal.ofReal p) (eps ^ 2 / 4) (eps ^ 2)
    (by positivity) hlohi (fun omega => Rraw N m w omega)
    (fun omega => ENNReal.ofReal (Rtrunc omega)) hRne hRtruncofReal
  have htoRealeq : (fun omega => (Rraw N m w omega).toReal -
        (ENNReal.ofReal (Rtrunc omega)).toReal) =
      (fun omega => (Rraw N m w omega).toReal - Rtrunc omega) := by
    funext omega
    rw [ENNReal.toReal_ofReal (hRtruncnn omega)]
  rw [htoRealeq] at key

  have keyfinal := key.trans (mul_le_mul_left' hcombined_p (ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4)⁻¹))
  refine ⟨fun omega => weight3 * (min (1 : ENNReal)
      ((ENNReal.ofReal (Rtrunc omega) - ENNReal.ofReal (eps ^ 2 / 4)) /
        ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal, ?_, ?_⟩
  · have hcont : Continuous (fun x : ℝ => weight3 * (min (1 : ENNReal)
        ((ENNReal.ofReal x - ENNReal.ofReal (eps ^ 2 / 4)) /
          ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal) := by
      have h1 : Continuous (fun x : ℝ => (min (1 : ENNReal)
          ((ENNReal.ofReal x - ENNReal.ofReal (eps ^ 2 / 4)) /
            ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal) := by
        have hne : ∀ x : ℝ, (min (1 : ENNReal) ((ENNReal.ofReal x - ENNReal.ofReal (eps ^ 2 / 4)) /
            ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))) ≠ ⊤ := fun x => (min_le_left _ _).trans_lt
          ENNReal.one_lt_top |>.ne
        have heq : (fun x : ℝ => (min (1 : ENNReal)
              ((ENNReal.ofReal x - ENNReal.ofReal (eps ^ 2 / 4)) /
                ENNReal.ofReal (eps ^ 2 - eps ^ 2 / 4))).toReal) =
            fun x : ℝ => max 0 (min 1 ((x - eps ^ 2 / 4) / (eps ^ 2 - eps ^ 2 / 4))) := by
          funext x
          rcases le_or_lt 0 x with hx | hx
          · have hdenpos : (0 : ℝ) < eps ^ 2 - eps ^ 2 / 4 := by nlinarith [hlohi]
            rw [show ENNReal.ofReal x - ENNReal.ofReal (eps ^ 2 / 4) =
                ENNReal.ofReal (x - eps ^ 2 / 4) by
              rw [← ENNReal.ofReal_sub _ (by positivity)]]
            rw [← ENNReal.ofReal_div_of_pos hdenpos,
