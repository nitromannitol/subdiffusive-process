    (weight 2 / 6 * CB) CP M.delta ((3 : ℝ) ^ (-(s / 32) * (h : ℝ))) 1
    (mul_nonneg (div_nonneg (hweight 2) (by norm_num)) hCBnn) hCPnn hMdeltapos
    (Real.rpow_nonneg (by norm_num) _)
    hYbase htrunc_bound
  refine ⟨Yband, hYbandmeas, ?_⟩
  refine hYbandbound.trans (ENNReal.ofReal_le_ofReal ?_)
  have hrate_eq : Real.sqrt (M.delta ^ (1 : ℕ) * (3 : ℝ) ^ (-(s / 32) * (h : ℝ)))
      = M.delta ^ (1 / 2 : ℝ) * (3 : ℝ) ^ (-(s / 64) * (h : ℝ)) := by
    rw [pow_one, Real.sqrt_mul hMdeltapos]
    have h3 : Real.sqrt ((3 : ℝ) ^ (-(s / 32) * (h : ℝ))) = (3 : ℝ) ^ (-(s / 64) * (h : ℝ)) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
      congr 1
      ring
    rw [Real.sqrt_eq_rpow, h3]
  rw [hrate_eq]
  exact le_of_eq (by ring)

def aux_lem_band_Jcell {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (n : ℕ) (z : Vec d)
    (omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) : ENNReal :=
  sSup {v : ENNReal | ∃ e : Vec d, vecNormSq e = 1 ∧
    v = ENNReal.ofReal (section6Response M n n omega z e)}

def aux_lem_band_DT1 {d : ℕ} (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (s : ℝ) (k : ℕ)
    (z : Vec d) (omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) : ENNReal :=
  sSup {v : ENNReal | ∃ j l : ℕ, j ≤ k ∧ l ≤ k ∧ l + 2 ≤ j ∧ ∃ x : Vec d,
    OnTriadicGrid l (x - z) ∧ x - z ∈ cube d j \ cube d (j - 1) ∧
    v = ENNReal.ofReal ((3 : ℝ) ^ (-(s / 2) * ((k : ℝ) - (l : ℝ)))) *
      (min (aux_lem_band_Jcell M l x omega) 1) ^ (1 / 2 : ℝ)}

def aux_lem_band_DT2 {d : ℕ} (s : ℝ) (k : ℕ) (z : Vec d)
    (omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) : ENNReal :=
  sSup {v : ENNReal | ∃ j : ℕ, j ≤ k ∧
    v = ENNReal.ofReal ((3 : ℝ) ^ (-(s / 8) * ((k : ℝ) - (j : ℝ)))) *
      sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d k z ∧
        w = ENNReal.ofReal |shellBlock k j omega x|}}

def aux_lem_band_DT3 {d : ℕ} (s : ℝ) (k : ℕ) (z : Vec d)
    (omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) : ENNReal :=
  ENNReal.ofReal ((3 : ℝ) ^ (-(s / 8) * (k : ℝ))) *
    sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d k z ∧ w = ENNReal.ofReal |omega 0 x|}

def aux_lem_band_DT4 {d : ℕ} (k : ℕ) (z : Vec d)
    (omega : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d) : ENNReal :=
  ∑' j : ℕ, if k ≤ j then
    ENNReal.ofReal ((3 : ℝ) ^ k) *
      sSup {w : ENNReal | ∃ x : Vec d, x ∈ translatedCube d k z ∧
        w = ENNReal.ofReal |Homogenization.euclideanNorm (shellGradient (omega j) x)|}
    else 0

