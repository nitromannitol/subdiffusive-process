          omega⟩) ∘ aux_lem_band_transport_window (-(h : ℤ)) (h : ℤ) := by
    funext om j; rfl
  rw [hbs, hfac, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono
