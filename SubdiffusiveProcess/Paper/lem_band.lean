theorem aux_lem_band_U2_gw_le (sigma : ℝ) (hs : 0 ≤ sigma) (n : ℕ) :
    Homogenization.Book.Ch02.geometricWeight sigma 2 n ≤
      (3 : ℝ) ^ (-((2 * sigma) * (n : ℝ))) := by
