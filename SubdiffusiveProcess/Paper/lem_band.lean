  have hfL2 := hfmem.coeFn_toLp
                                       
  obtain ⟨δU, B, hδU, hB, hUB⟩ := aux_lem_band_rem_bank_uniform_dirichlet d hd I _Poincare
    _Extension _Perturbation _Sobolev D ((d : ℝ) - 1 / 2) ht0 ht1 Cresp hCresp (max q 2) hp2
