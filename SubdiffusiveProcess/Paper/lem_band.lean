  refine hfinal.trans ?_
  rw [Real.enorm_eq_ofReal (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (H : ℝ) / 16)))]
  calc ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) *
        eLpNorm (fun omega : PotentialSample d =>
          (aux_lem_band_piece_product_Praw d (s / 2) m z omega).toReal)
          (ENNReal.ofReal p) M.P.toMeasure
      ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (H : ℝ) / 16))) * ENNReal.ofReal (CB2 * delta02 + 2) :=
        mul_le_mul_left' hPscF_bound' _
    _ = ENNReal.ofReal ((CB2 * delta02 + 2) * (3 : ℝ) ^ (-(s / 16) * (H : ℝ))) := by
        rw [← ENNReal.ofReal_mul (by positivity)]
        congr 1
        have hexpeq : (3 : ℝ) ^ (-(s * (H : ℝ) / 16)) = (3 : ℝ) ^ (-(s / 16) * (H : ℝ)) := by
          congr 1; ring
        rw [hexpeq]; ring

private def aux_lem_band_piece_product_trunc_TjA (d : ℕ) (m j : ℕ) (omega : PotentialSample d)
    (x : Vec d) : ENNReal :=
  ∏ i ∈ Finset.Icc (m - j) (m + j), ENNReal.ofReal (Real.exp |omega i x|)

private def aux_lem_band_piece_product_trunc_TjB (d : ℕ) (m j K : ℕ) (z : Vec d)
    (omega : PotentialSample d) (x : Vec d) : ENNReal :=
  ∏ i ∈ Finset.Icc (m + j) (m + j + K), ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))

private theorem aux_lem_band_piece_product_trunc_TjB_cont (d : ℕ) (m j K : ℕ) (z : Vec d)
    (omega : PotentialSample d) :
    Continuous (aux_lem_band_piece_product_trunc_TjB d m j K z omega) := by
  unfold aux_lem_band_piece_product_trunc_TjB
  have hEq : (fun x : Vec d => ∏ i ∈ Finset.Icc (m + j) (m + j + K),
      ENNReal.ofReal (Real.exp (4 * |omega i x - omega i z|))) =
      (fun x : Vec d => ENNReal.ofReal
        (∏ i ∈ Finset.Icc (m + j) (m + j + K), Real.exp (4 * |omega i x - omega i z|))) := by
    funext x
    exact (ENNReal.ofReal_prod_of_nonneg (fun i hi => Real.exp_nonneg _)).symm
  rw [hEq]
  exact ENNReal.continuous_ofReal.comp
    (continuous_finset_prod _ fun i _ =>
      Real.continuous_exp.comp
        (continuous_const.mul
          (((PotentialField.contDiff_one (omega i)).continuous).sub continuous_const).abs))

private theorem aux_lem_band_piece_product_trunc_TjB_meas (d : ℕ) (m j K : ℕ) (z x : Vec d) :
