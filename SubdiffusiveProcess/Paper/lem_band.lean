theorem aux_lem_band_U2_lam
    (d : ℕ) (hd : 2 ≤ d) [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (_Poincare : Paper.in_poincare d hd I)
    (_Extension : Paper.in_extension d hd I)
    (_Perturbation : Lane4.SmallPerturbationInput d)
    (_Sobolev : Lane4.SobolevFoundationalInput d hd)
    (D : Paper.lane4_deterministic_good_scale_input d)
    (Cresp : ℝ) (hCresp : 0 < Cresp) (sigma : ℝ) (hsigma : sigma ∈ Set.Ioc (0 : ℝ) 1) :
    ∃ a c : ℝ, 0 < a ∧ 0 < c ∧ ∃ w' : ℕ, 0 < w' ∧
      ∀ p : ℝ, 1 ≤ p → ∃ delta0 C : ℝ, 0 < delta0 ∧ 0 ≤ C ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d), M.delta ≤ delta0 →
      ∀ (Rm : Paper.in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : Paper.in_6_16 d M) (_It : Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ K h : ℕ, 1 ≤ h →
        aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure (-((w' * (h + 1) : ℕ) : ℤ))
          ((w' * (h + 1) : ℕ) : ℤ) p
          (fun omega => aux_lem_band_U2_lamF sigma (aux_lem_band_U2_unitChart I M H omega K) - 1)
          (C * M.delta ^ c * (3 : ℝ) ^ (-(a * (h : ℝ)))) := by
  obtain ⟨a, c, ha, hc, w', hw', hcore⟩ := aux_lem_band_U2_invlam_core d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp sigma hsigma
  refine ⟨a / 2, c, by positivity, hc, w', hw', ?_⟩
  intro p hp
  obtain ⟨δ1, C1, hδ1, hC1, hcore'⟩ := hcore (4 * p) (by linarith)
  obtain ⟨δ2, C2, hδ2, hC2, hmom⟩ := aux_lem_band_U2_lamF_moment d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp sigma hsigma (4 * p) (by linarith)
  refine ⟨min δ1 δ2, 2 * C2 * C1 + 2 * C2 ^ 2 * C1, lt_min hδ1 hδ2, by positivity, ?_⟩
  intro M hM Rm hRm Sreg It H hH K h _hh
  have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
  have hδc : 0 ≤ M.delta ^ c := Real.rpow_nonneg hδpos.le c
  obtain ⟨hTm, hTdev, hTband⟩ := hcore' M (hM.trans (min_le_left _ _)) Rm hRm Sreg It H hH K
  have hB0 := hmom M (hM.trans (min_le_right _ _)) Rm hRm Sreg It H hH K
  have hlampos : ∀ omega, 0 < aux_lem_band_U2_lamF sigma (aux_lem_band_U2_unitChart I M H omega K) := by
    intro omega
    have := I.lam_pos 0 1 one_pos (Lane4.cutoffPositiveCoefficient M H omega K 0 one_pos) 0 1
      sigma 2
    rwa [aux_lem_band_U2_lam_eq I 0 1 one_pos _ sigma hsigma] at this
  obtain ⟨Y, hYm, hYb⟩ := hTband h
  have hYa : AEStronglyMeasurable Y (chaosSampleLaw M).toMeasure :=
    hYm.mono (aux_lem_band_U2_band_le_ambient _ _)
  have hY2 : eLpNorm (fun omega => (aux_lem_band_U2_lamF sigma (aux_lem_band_U2_unitChart I M H omega K))⁻¹ - 1 -
      Y omega) (ENNReal.ofReal (2 * p)) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (C1 * M.delta ^ c * (3 : ℝ) ^ (-(a * (h : ℝ)))) := by
    refine (eLpNorm_le_eLpNorm_of_exponent_le (ENNReal.ofReal_le_ofReal (by linarith))
      ((hTm.sub aestronglyMeasurable_const).sub hYa)).trans hYb
  set t : ℝ := (1 / 2) * (3 : ℝ) ^ (-(a / 2 * (h : ℝ))) with htdef
  have h3pos : 0 < (3 : ℝ) ^ (-(a / 2 * (h : ℝ))) := Real.rpow_pos_of_pos (by norm_num) _
  have h3le : (3 : ℝ) ^ (-(a / 2 * (h : ℝ))) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by norm_num)
      (by have : 0 ≤ a / 2 * (h : ℝ) := by positivity
          linarith)
  have ht0 : 0 < t := by rw [htdef]; positivity
  have ht : t ≤ 1 / 2 := by rw [htdef]; nlinarith
  have hTinv : eLpNorm (fun omega => ((aux_lem_band_U2_lamF sigma (aux_lem_band_U2_unitChart I M H omega K))⁻¹)⁻¹)
      (ENNReal.ofReal (4 * p)) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal C2 := by
    simp only [inv_inv]; exact hB0
  obtain ⟨Z, hZm, hZb⟩ := aux_lem_band_U2_recip (chaosSampleLaw M).toMeasure _
    (aux_lem_band_U2_band_le_ambient _ _) (fun omega => (aux_lem_band_U2_lamF sigma (aux_lem_band_U2_unitChart I M H omega K))⁻¹)
    hTm (fun omega => inv_pos.mpr (hlampos omega)) p hp C2 (C1 * M.delta ^ c)
    (C1 * M.delta ^ c * (3 : ℝ) ^ (-(a * (h : ℝ)))) t hC2 (mul_nonneg hC1 hδc) (by positivity)
    ht0 ht hTinv hTdev ⟨Y, hYm, hY2⟩
  refine ⟨Z, hZm, ?_⟩
  have hZb' : eLpNorm (fun omega => aux_lem_band_U2_lamF sigma (aux_lem_band_U2_unitChart I M H omega K) - 1 - Z omega)
      (ENNReal.ofReal p) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (C2 * (C1 * M.delta ^ c * (3 : ℝ) ^ (-(a * (h : ℝ)))) / t +
        4 * C2 ^ 2 * (C1 * M.delta ^ c) * t) := by
    simpa only [inv_inv] using hZb
  refine hZb'.trans (le_of_eq (congrArg ENNReal.ofReal ?_))
  have hsplit : (3 : ℝ) ^ (-(a * (h : ℝ))) =
      (3 : ℝ) ^ (-(a / 2 * (h : ℝ))) * (3 : ℝ) ^ (-(a / 2 * (h : ℝ))) := by
    rw [← Real.rpow_add (by norm_num)]; congr 1; ring
  rw [htdef, hsplit]
  field_simp
  ring

