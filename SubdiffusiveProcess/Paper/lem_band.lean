      have heq : (fun omega' => (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) *
          aux_prefix_bank_maxObs 0 k z (eta N omega')) =
          (fun omega' => (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) *
            (fun omega'' => aux_prefix_bank_maxObs 0 k z (eta N omega'')) omega') := rfl
