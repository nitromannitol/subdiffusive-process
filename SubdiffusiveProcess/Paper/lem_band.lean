      have hCk := hC0 k
      have h1 : (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) * (Pbank * (1 + (k : ℝ))) ≤
          (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) * (C0 * (3 : ℝ) ^ (s / 16 * (k : ℝ))) := by
        apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg (by norm_num) _)
        have : Pbank + Pbank * (k : ℝ) ≤ C0 * (3 : ℝ) ^ (s / 16 * (k : ℝ)) := hCk
        linarith
      have h2 : (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) * (C0 * (3 : ℝ) ^ (s / 16 * (k : ℝ))) =
          C0 * (3 : ℝ) ^ (-(s / 16) * (k : ℝ)) := by
        rw [show (3:ℝ)^(-(s/8)*(k:ℝ)) * (C0 * (3:ℝ)^(s/16*(k:ℝ))) =
            C0 * ((3:ℝ)^(-(s/8)*(k:ℝ)) * (3:ℝ)^(s/16*(k:ℝ))) by ring,
          ← Real.rpow_add (by norm_num : (0:ℝ) < 3)]
        congr 2
        ring
      have h3 : (3 : ℝ) ^ (-(s / 16) * (k : ℝ)) ≤ (3 : ℝ) ^ (-(s / 4 * (h : ℝ))) := by
        apply Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ) ≤ 3)
        nlinarith [hkgt, hs]
      calc (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) * (Pbank * (1 + (k : ℝ)))
          ≤ (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) * (C0 * (3 : ℝ) ^ (s / 16 * (k : ℝ))) := h1
        _ = C0 * (3 : ℝ) ^ (-(s / 16) * (k : ℝ)) := h2
        _ ≤ C0 * (3 : ℝ) ^ (-(s / 4 * (h : ℝ))) := by
            apply mul_le_mul_of_nonneg_left h3 hC00
    exact (hstep1.trans hstep3).trans (ENNReal.ofReal_le_ofReal hfin)

theorem aux_lem_band_translatedCube_mono {d : ℕ} {k l : ℤ} (hkl : k ≤ l) (z : Vec d) :
