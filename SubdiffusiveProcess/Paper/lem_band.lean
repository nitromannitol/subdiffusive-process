theorem aux_lem_band_piece_coords_lipschitz_pi_le {ι κ : Type*} [Fintype ι] [Fintype κ]
    (K : ℝ≥0) (Phi0 : (ι → κ → ℝ) → ℝ) (hPhi : LipschitzWith K Phi0)
    (x y : ι → κ → ℝ) :
    |Phi0 x - Phi0 y| ≤ (K : ℝ) * ∑ i, ∑ j, |x i j - y i j| := by
  rw [← Real.dist_eq]
  refine le_trans (hPhi.dist_le_mul x y) ?_
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  rw [dist_pi_le_iff (by positivity)]
  intro i
  rw [dist_pi_le_iff (by positivity)]
  intro j
  rw [Real.dist_eq]
  have h1 : |x i j - y i j| ≤ ∑ j' : κ, |x i j' - y i j'| :=
    Finset.single_le_sum (f := fun j' => |x i j' - y i j'|) (s := Finset.univ)
      (fun j' _ => abs_nonneg _) (Finset.mem_univ j)
  have h2 : ∑ j' : κ, |x i j' - y i j'| ≤ ∑ i' : ι, ∑ j' : κ, |x i' j' - y i' j'| :=
    Finset.single_le_sum (f := fun i' => ∑ j' : κ, |x i' j' - y i' j'|) (s := Finset.univ)
      (fun i' _ => Finset.sum_nonneg (fun j' _ => abs_nonneg _)) (Finset.mem_univ i)
  linarith

@[instance_reducible]
def aux_lem_band_piece_coords_bandOf (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (n : ℤ) (h w0 : ℕ) : MeasurableSpace (BilateralField d) :=
  MeasurableSpace.comap
    (fun omega : BilateralField d =>
      fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ))
    inferInstance

theorem aux_lem_band_piece_coords_bandOf_le (d : ℕ) [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    (n : ℤ) (h w0 : ℕ) :
    aux_lem_band_piece_coords_bandOf d n h w0 ≤ (inferInstance : MeasurableSpace (BilateralField d)) := by
  unfold aux_lem_band_piece_coords_bandOf
  have hmeas : Measurable (fun omega : BilateralField d =>
      fun j : Set.Icc (-n - (w0 * (h + 1) : ℕ)) (-n + (w0 * (h + 1) : ℕ)) => omega (j : ℤ)) :=
    Measurable.of_eval (fun j => measurable_pi_apply (j : ℤ))
  exact hmeas.comap_le

theorem aux_lem_band_piece_coords_combine
    {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (M : _root_.SubdiffusiveProcess.Model.GMCModel d) (n : ℤ) (h w0 : ℕ)
    (Klip : ℝ≥0) (Phi0 : (ι → κ → ℝ) → ℝ) (hPhi0Lip : LipschitzWith Klip Phi0)
    (Y Yband : BilateralField d → ι → κ → ℝ)
    (hYmeas : ∀ i j, AEStronglyMeasurable (fun omega => Y omega i j) (chaosSampleLaw M).toMeasure)
    (hYbandmeas : ∀ i j, AEStronglyMeasurable[aux_lem_band_piece_coords_bandOf d n h w0]
      (fun omega => Yband omega i j) (chaosSampleLaw M).toMeasure)
    (p : ℝ≥0∞) (hp : 1 ≤ p)
    (rate : ι → κ → ℝ) (hrate : ∀ i j, 0 ≤ rate i j)
    (hbound : ∀ i j, eLpNorm (fun omega => Y omega i j - Yband omega i j) p
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (rate i j)) :
    ∃ Z : BilateralField d → ℝ,
      AEStronglyMeasurable[aux_lem_band_piece_coords_bandOf d n h w0] Z
        (chaosSampleLaw M).toMeasure ∧
      eLpNorm (fun omega => Phi0 (Y omega) - Z omega) p (chaosSampleLaw M).toMeasure ≤
        ENNReal.ofReal ((Klip : ℝ) * ∑ i, ∑ j, rate i j) := by
  classical
                                                                 
  choose g hgmeas hgae using hYbandmeas
  have hGmeas : Measurable[aux_lem_band_piece_coords_bandOf d n h w0]
      (fun omega i j => g i j omega) :=
    @Measurable.of_eval (BilateralField d) ι (fun _ => κ → ℝ)
      (aux_lem_band_piece_coords_bandOf d n h w0) _ (fun omega i => fun j => g i j omega)
      (fun i => @Measurable.of_eval (BilateralField d) κ (fun _ => ℝ)
        (aux_lem_band_piece_coords_bandOf d n h w0) _ (fun omega j => g i j omega)
        (fun j => (hgmeas i j).measurable))
  have hPhi0cont : Continuous Phi0 := hPhi0Lip.continuous
  have hPhi0meas : Measurable Phi0 := hPhi0cont.measurable
  refine ⟨fun omega => Phi0 (fun i j => g i j omega),
    (hPhi0meas.comp hGmeas).stronglyMeasurable.aestronglyMeasurable, ?_⟩
  have hae_eq : (fun omega => Phi0 (Yband omega)) =ᵐ[(chaosSampleLaw M).toMeasure]
      (fun omega => Phi0 (fun i j => g i j omega)) := by
    have hcomp : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ i j, Yband omega i j = g i j omega := by
      rw [ae_all_iff]
      intro i
      rw [ae_all_iff]
      intro j
      exact hgae i j
    filter_upwards [hcomp] with omega homega
    have : Yband omega = fun i j => g i j omega := by
      funext i j; exact homega i j
    rw [this]
  have hpointwise : ∀ omega, |Phi0 (Y omega) - Phi0 (Yband omega)| ≤
      (Klip : ℝ) * ∑ i, ∑ j, |Y omega i j - Yband omega i j| :=
    fun omega => aux_lem_band_piece_coords_lipschitz_pi_le Klip Phi0 hPhi0Lip (Y omega) (Yband omega)
  have hae1 : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      ‖Phi0 (Y omega) - Phi0 (Yband omega)‖ ≤
        (Klip : ℝ) * ‖∑ i, ∑ j, ‖Y omega i j - Yband omega i j‖‖ := by
    filter_upwards with omega
    have h1 := hpointwise omega
    have h2 : (0:ℝ) ≤ ∑ i, ∑ j, ‖Y omega i j - Yband omega i j‖ :=
      Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => norm_nonneg _))
    have h3 : (∑ i, ∑ j, ‖Y omega i j - Yband omega i j‖ : ℝ) =
        ∑ i, ∑ j, |Y omega i j - Yband omega i j| := by
      simp only [Real.norm_eq_abs]
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg h2, h3]
    exact h1
  have hYmeasCopy := hYmeas
  choose gY hgYmeas hgYae using hYmeasCopy
  have hGYmeas : Measurable (fun omega i j => gY i j omega) :=
    Measurable.of_eval (fun i => Measurable.of_eval (fun j => (hgYmeas i j).measurable))
  have hYae : (fun omega => Phi0 (Y omega)) =ᵐ[(chaosSampleLaw M).toMeasure]
      (fun omega => Phi0 (fun i j => gY i j omega)) := by
    have hcomp : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, ∀ i j, Y omega i j = gY i j omega := by
      rw [ae_all_iff]
      intro i
      rw [ae_all_iff]
      intro j
      exact hgYae i j
    filter_upwards [hcomp] with omega homega
    congr 1
    funext i j
    exact homega i j
  have hPhiY : AEStronglyMeasurable (fun omega => Phi0 (Y omega)) (chaosSampleLaw M).toMeasure :=
    (hPhi0meas.comp hGYmeas).aestronglyMeasurable.congr hYae.symm
  have hPhiYband : AEStronglyMeasurable (fun omega => Phi0 (Yband omega)) (chaosSampleLaw M).toMeasure :=
    ((hPhi0meas.comp hGmeas).stronglyMeasurable.mono
      (aux_lem_band_piece_coords_bandOf_le d n h w0)).aestronglyMeasurable.congr hae_eq.symm
  have step1 : eLpNorm (fun omega => Phi0 (Y omega) - Phi0 (Yband omega)) p
      (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (Klip : ℝ) * eLpNorm (fun omega => ∑ i, ∑ j, ‖Y omega i j - Yband omega i j‖)
        p (chaosSampleLaw M).toMeasure :=
    eLpNorm_le_mul_eLpNorm_of_ae_le_mul (hPhiY.sub hPhiYband) hae1 p
  have hterm_meas : ∀ i j, AEStronglyMeasurable
      (fun omega => ‖Y omega i j - Yband omega i j‖) (chaosSampleLaw M).toMeasure := by
    intro i j
    have hYbandij : AEStronglyMeasurable (fun omega => Yband omega i j) (chaosSampleLaw M).toMeasure :=
      ((hgmeas i j).mono (aux_lem_band_piece_coords_bandOf_le d n h w0)).aestronglyMeasurable.congr
        (hgae i j).symm
    exact ((hYmeas i j).sub hYbandij).norm
  have hinner_meas : ∀ i, AEStronglyMeasurable
      (fun omega => ∑ j : κ, ‖Y omega i j - Yband omega i j‖) (chaosSampleLaw M).toMeasure := by
    intro i
    have heq : (fun omega => ∑ j : κ, ‖Y omega i j - Yband omega i j‖) =
        ∑ j : κ, fun omega => ‖Y omega i j - Yband omega i j‖ := by
      funext omega; rw [Finset.sum_apply]
    rw [heq]
    exact Finset.aestronglyMeasurable_sum Finset.univ (fun j _ => hterm_meas i j)
  have step2 : eLpNorm (fun omega => ∑ i, ∑ j, ‖Y omega i j - Yband omega i j‖) p
      (chaosSampleLaw M).toMeasure ≤
      ∑ i, ∑ j, eLpNorm (fun omega => ‖Y omega i j - Yband omega i j‖) p
        (chaosSampleLaw M).toMeasure := by
    have houter : (fun omega => ∑ i : ι, ∑ j : κ, ‖Y omega i j - Yband omega i j‖) =
        ∑ i : ι, fun omega => ∑ j : κ, ‖Y omega i j - Yband omega i j‖ := by
      funext omega; rw [Finset.sum_apply]
    rw [houter]
    calc eLpNorm (∑ i : ι, fun omega => ∑ j : κ, ‖Y omega i j - Yband omega i j‖) p
          (chaosSampleLaw M).toMeasure
        ≤ ∑ i : ι, eLpNorm (fun omega => ∑ j : κ, ‖Y omega i j - Yband omega i j‖) p
          (chaosSampleLaw M).toMeasure := eLpNorm_sum_le hp
      _ ≤ ∑ i : ι, ∑ j : κ, eLpNorm (fun omega => ‖Y omega i j - Yband omega i j‖) p
          (chaosSampleLaw M).toMeasure := by
          apply Finset.sum_le_sum
          intro i _
          have hinner : (fun omega => ∑ j : κ, ‖Y omega i j - Yband omega i j‖) =
              ∑ j : κ, fun omega => ‖Y omega i j - Yband omega i j‖ := by
            funext omega; rw [Finset.sum_apply]
          rw [hinner]
          exact eLpNorm_sum_le hp
  have step3 : ∀ i j, eLpNorm (fun omega => ‖Y omega i j - Yband omega i j‖) p
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (rate i j) := by
    intro i j
    have hYbandij : AEStronglyMeasurable (fun omega => Yband omega i j) (chaosSampleLaw M).toMeasure :=
      ((hgmeas i j).mono (aux_lem_band_piece_coords_bandOf_le d n h w0)).aestronglyMeasurable.congr
        (hgae i j).symm
    have hdiff : AEStronglyMeasurable (fun omega => Y omega i j - Yband omega i j)
        (chaosSampleLaw M).toMeasure := (hYmeas i j).sub hYbandij
    rw [eLpNorm_norm _ hdiff]
    exact hbound i j
  have step4 : ∑ i : ι, ∑ j : κ, eLpNorm (fun omega => ‖Y omega i j - Yband omega i j‖) p
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal (∑ i : ι, ∑ j : κ, rate i j) := by
    rw [ENNReal.ofReal_sum_of_nonneg (fun i _ =>
      Finset.sum_nonneg (fun j _ => hrate i j))]
    apply Finset.sum_le_sum
    intro i _
    rw [ENNReal.ofReal_sum_of_nonneg (fun j _ => hrate i j)]
    apply Finset.sum_le_sum
    intro j _
    exact step3 i j
  calc eLpNorm (fun omega => Phi0 (Y omega) - Phi0 (fun i j => g i j omega)) p
        (chaosSampleLaw M).toMeasure
      = eLpNorm (fun omega => Phi0 (Y omega) - Phi0 (Yband omega)) p
        (chaosSampleLaw M).toMeasure := by
        apply eLpNorm_congr_ae
        filter_upwards [hae_eq] with omega homega
        rw [homega]
    _ ≤ ENNReal.ofReal (Klip : ℝ) *
        eLpNorm (fun omega => ∑ i, ∑ j, ‖Y omega i j - Yband omega i j‖) p
        (chaosSampleLaw M).toMeasure := step1
    _ ≤ ENNReal.ofReal (Klip : ℝ) * ENNReal.ofReal (∑ i : ι, ∑ j : κ, rate i j) :=
        by gcongr; exact step2.trans step4
    _ = ENNReal.ofReal ((Klip : ℝ) * ∑ i, ∑ j, rate i j) := by
        rw [← ENNReal.ofReal_mul (by positivity)]

noncomputable def aux_lem_band_piece_coords_finInf (T : ℕ) (f : Fin T → ℝ) (default : ℝ) : ℝ :=
  if h : 0 < T then
    haveI : Nonempty (Fin T) := ⟨⟨0, h⟩⟩
    Finset.univ.inf' Finset.univ_nonempty f
  else default

theorem aux_lem_band_piece_coords_finInf_pos (T : ℕ) (f : Fin T → ℝ) (default : ℝ)
    (hpos : ∀ i, 0 < f i) (hd : 0 < default) :
    0 < aux_lem_band_piece_coords_finInf T f default := by
  unfold aux_lem_band_piece_coords_finInf
  split
  · next h =>
    have : Nonempty (Fin T) := ⟨⟨0, h⟩⟩
    exact (Finset.lt_inf'_iff Finset.univ_nonempty).mpr (fun i _ => hpos i)
  · exact hd

theorem aux_lem_band_piece_coords_finInf_le (T : ℕ) (f : Fin T → ℝ) (default : ℝ) (i : Fin T) :
    aux_lem_band_piece_coords_finInf T f default ≤ f i := by
  unfold aux_lem_band_piece_coords_finInf
  have hTpos : 0 < T := i.pos
  rw [dite_eq_left hTpos]
  have : Nonempty (Fin T) := ⟨⟨0, hTpos⟩⟩
  exact Finset.inf'_le f (Finset.mem_univ i)

noncomputable def aux_lem_band_piece_coords_finSup (T : ℕ) (f : Fin T → ℕ) : ℕ :=
  Finset.univ.sup f + 1

theorem aux_lem_band_piece_coords_finSup_pos (T : ℕ) (f : Fin T → ℕ) :
    0 < aux_lem_band_piece_coords_finSup T f := Nat.succ_pos _

theorem aux_lem_band_piece_coords_finSup_le (T : ℕ) (f : Fin T → ℕ) (i : Fin T) :
    f i ≤ aux_lem_band_piece_coords_finSup T f := by
  unfold aux_lem_band_piece_coords_finSup
  exact le_trans (Finset.le_sup (Finset.mem_univ i)) (Nat.le_succ _)

theorem aux_lem_band_piece_coords_combine_a0
    (T : ℕ) (a01 a02 a03 a04 a05 a06 a07 : Fin T → ℝ)
    (ha01 : ∀ i, 0 < a01 i) (ha02 : ∀ i, 0 < a02 i) (ha03 : ∀ i, 0 < a03 i)
    (ha04 : ∀ i, 0 < a04 i) (ha05 : ∀ i, 0 < a05 i) (ha06 : ∀ i, 0 < a06 i)
    (ha07 : ∀ i, 0 < a07 i) :
    ∃ a0 : ℝ, 0 < a0 ∧
      (∀ i, a0 ≤ a01 i) ∧ (∀ i, a0 ≤ a02 i) ∧ (∀ i, a0 ≤ a03 i) ∧ (∀ i, a0 ≤ a04 i) ∧
      (∀ i, a0 ≤ a05 i) ∧ (∀ i, a0 ≤ a06 i) ∧ (∀ i, a0 ≤ a07 i) := by
  set a0f1 := aux_lem_band_piece_coords_finInf T a01 1 with ha0f1def
