            ∀ N, MemLp (Kc N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ∧
              eLpNorm (Kc N) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
                ENNReal.ofReal (Cb q)) ∧
          (∀ (N : ℕ) (om : BilateralField d),
            inverseResponse (meanZeroResponseSpace hPn)
                (cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
                ((affineNeumannLoad pvec).comp
                  (subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)))) ≤
              Cy * Kc N om) ∧
          (∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ fL2 : DomainL2 (unitNeumannCube d),
            ((fL2 : SpatialCoordinates d → ℝ)
              =ᵐ[volume.restrict (unitNeumannCube d : Set (SpatialCoordinates d))]
