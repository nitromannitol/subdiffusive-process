          (ENNReal.ofReal ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) +
            ENNReal.ofReal Cbmaj)) := by
  set σ : ℝ := aux_psf_sigma M with hσdef
  set mu : ℝ := σ⁻¹ with hmudef
  have hAmaj_j : (∫⁻ omega, (aux_prefix_praw_Amaj m j z omega - 1) ^ R
      ∂M.P.toMeasure) ≤
      ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) *
        ENNReal.ofReal ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) := by
    refine (aux_lem_band_piece_product_baseline_c1_pAmaj_centered_rpow_lintegral M m j z R hR0).trans ?_
    have hexple : Real.exp ((R + (aux_psf_sigma M)⁻¹) ^ 2 * aux_psf_sigma M ^ 2 / 4) ≤
        Real.exp 1 := Real.exp_le_exp.mpr (by linarith [hsq4])
    have hEle : Real.exp ((R + (aux_psf_sigma M)⁻¹) ^ 2 * aux_psf_sigma M ^ 2 / 4) * 2 ≤ K := by
      rw [hKdef]; linarith
    gcongr
  have hBmaj_j : (∫⁻ omega, (aux_prefix_praw_Bmaj m j z omega - 1) ^ R
      ∂M.P.toMeasure) ≤
      ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * ENNReal.ofReal Cbmaj := by
    refine (aux_lem_band_piece_product_baseline_c1_pBmaj_centered_rpow_lintegral M m j z R hR0).trans ?_
    gcongr
  have hc0 : (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (j : ℝ) / 8)) := by positivity
  have hmeasA : Measurable (fun omega : PotentialSample d =>
      (aux_prefix_praw_Amaj m j z omega - 1) ^ R) :=
    ((aux_prefix_praw_Amaj_measurable m j z).sub measurable_const).pow_const R
  have hmeasB : Measurable (fun omega : PotentialSample d =>
      (aux_prefix_praw_Bmaj m j z omega - 1) ^ R) :=
    ((aux_prefix_praw_Bmaj_measurable m j z).sub measurable_const).pow_const R
  calc (∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
        ∂M.P.toMeasure) =
      ∫⁻ omega, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ^ R *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1)) ^ R
        ∂M.P.toMeasure := by
        simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hR0.le]
    _ ≤ ∫⁻ omega, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ^ R *
        ((2 : ENNReal) ^ (R - 1) *
          ((aux_prefix_praw_Amaj m j z omega - 1) ^ R +
            (aux_prefix_praw_Bmaj m j z omega - 1) ^ R)) ∂M.P.toMeasure := by
        refine lintegral_mono (fun omega => ?_)
        gcongr
        exact ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hR1
    _ = ∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ^ R * (2 : ENNReal) ^ (R - 1)) *
          ((aux_prefix_praw_Amaj m j z omega - 1) ^ R +
            (aux_prefix_praw_Bmaj m j z omega - 1) ^ R) ∂M.P.toMeasure := by
        congr 1; funext omega; rw [mul_assoc]
    _ = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ^ R * (2 : ENNReal) ^ (R - 1) *
        (∫⁻ omega, (aux_prefix_praw_Amaj m j z omega - 1) ^ R ∂M.P.toMeasure +
          ∫⁻ omega, (aux_prefix_praw_Bmaj m j z omega - 1) ^ R ∂M.P.toMeasure) := by
        rw [lintegral_const_mul _ (hmeasA.add hmeasB), lintegral_add_left hmeasA]
    _ ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ^ R * (2 : ENNReal) ^ (R - 1) *
        (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) *
            ENNReal.ofReal ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) +
          ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * ENNReal.ofReal Cbmaj) := by
        gcongr
    _ = ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8))) * (2 : ENNReal) ^ (R - 1) *
        (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) *
          (ENNReal.ofReal ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) +
            ENNReal.ofReal Cbmaj)) := by
        have hexp_eq : ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) ^ R = (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) := by
          rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3)]
          congr 1; ring
        rw [ENNReal.ofReal_rpow_of_nonneg hc0 hR0.le, hexp_eq, ← mul_add]

theorem aux_lem_band_piece_product_baseline_c1_M_sigma_facts (d : ℕ) (R delta0 : ℝ) (hR0 : 0 < R) (hR1 : 1 ≤ R)
    (hd0def : delta0 = 1 / ((1 + (d : ℝ)) * R)) (M : GMCModel d) (hMdelta : M.delta ≤ delta0) :
    R * aux_psf_sigma M ≤ 1 ∧
    (R + (aux_psf_sigma M)⁻¹) ^ 2 * aux_psf_sigma M ^ 2 ≤ 4 ∧
    (6 * ((aux_psf_sigma M)⁻¹ + R) + 1) * aux_psf_sigma M ≤ 13 ∧
    0 < (aux_psf_sigma M)⁻¹ + R := by
  set σ : ℝ := aux_psf_sigma M with hσdef
  set mu : ℝ := σ⁻¹ with hmudef
  have hσpos := aux_psf_sigma_pos M
  have hσeq : σ = (1 + (d : ℝ)) * M.delta := rfl
  have hRσ : R * σ ≤ 1 := by
    have h2 : σ ≤ 1 / R := by
      have heq : delta0 * (1 + (d : ℝ)) = 1 / R := by rw [hd0def]; field_simp
      have h1 : σ ≤ delta0 * (1 + (d : ℝ)) := by rw [hσeq]; nlinarith [hMdelta]
      rwa [heq] at h1
    calc R * σ ≤ R * (1 / R) := by gcongr
      _ = 1 := by field_simp
  have hσ1 : σ ≤ 1 := by
    nlinarith [hRσ, mul_nonneg (by linarith : (0 : ℝ) ≤ R - 1) hσpos.le]
  have hmuσ : mu * σ = 1 := by rw [hmudef, inv_mul_cancel₀ hσpos.ne']
  have hmuRσ : (R + mu) * σ ≤ 2 := by nlinarith [hmuσ, hRσ]
  refine ⟨hRσ, ?_, ?_, by nlinarith [hmuσ]⟩
  · have hnn2 : 0 ≤ (R + mu) * σ := by positivity
    have heq2 : (R + mu) ^ 2 * σ ^ 2 = ((R + mu) * σ) ^ 2 := by ring
    rw [heq2]; nlinarith [hmuRσ, hnn2]
  · nlinarith [hmuRσ, hσ1, hσpos.le]

theorem aux_lem_band_piece_product_baseline_c1_T_rpow_bound (M : GMCModel d) (s : ℝ) (m : ℕ) (z : Vec d) (R : ℝ)
    (hR0 : 0 < R) (hR1 : 1 ≤ R) (K Cbmaj SA SB C2 : ℝ) (hK0 : 0 ≤ K) (hCbmaj0 : 0 ≤ Cbmaj)
    (hg_j : ∀ j : ℕ, (∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
        ∂M.P.toMeasure) ≤
      ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8))) * (2 : ENNReal) ^ (R - 1) *
        (ENNReal.ofReal ((R * aux_psf_sigma M / Real.exp 1) ^ R) *
          (ENNReal.ofReal ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) +
            ENNReal.ofReal Cbmaj)))
    (hAsummable : Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
        ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1))))
    (hAseries : (∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
        ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1))) ≤ SA)
    (hBsummable : Summable (fun j : ℕ => (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj))
    (hBseries : (∑' j : ℕ, (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj) ≤ SB)
    (hC2def : C2 = 2 ^ (R - 1) * (R / Real.exp 1) ^ R * (SA + SB)) :
    (∫⁻ omega, (∑' j : ℕ, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R)
        ∂M.P.toMeasure) ≤ ENNReal.ofReal (C2 * aux_psf_sigma M ^ R) := by
  have hmeas : ∀ j : ℕ, AEMeasurable (fun omega : PotentialSample d =>
      (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R)
      M.P.toMeasure := fun j =>
    (Measurable.pow_const (measurable_const.mul
      (((aux_prefix_praw_Amaj_measurable m j z).sub measurable_const).add
        ((aux_prefix_praw_Bmaj_measurable m j z).sub measurable_const))) R).aemeasurable
  rw [lintegral_tsum hmeas]
  set σ : ℝ := aux_psf_sigma M with hσdef
  have hσpos := aux_psf_sigma_pos M
  have hAnn : ∀ j : ℕ, (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
      ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) := fun j => by positivity
  have hBnn : ∀ j : ℕ, (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj := fun j => by positivity
  have step1 : (∑' j : ℕ, (∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
        ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
        ∂M.P.toMeasure)) ≤
      ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1) *
        (ENNReal.ofReal SA + ENNReal.ofReal SB) := by
    calc (∑' j : ℕ, (∫⁻ omega, (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) / 8))) *
          ((aux_prefix_praw_Amaj m j z omega - 1) + (aux_prefix_praw_Bmaj m j z omega - 1))) ^ R
          ∂M.P.toMeasure)) ≤
        ∑' j : ℕ, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8))) * (2 : ENNReal) ^ (R - 1) *
          (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) *
            (ENNReal.ofReal ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)) +
              ENNReal.ofReal Cbmaj)) := ENNReal.tsum_le_tsum hg_j
      _ = ∑' j : ℕ, (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1)) *
          (ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
              ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1))) +
            ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj)) := by
          refine tsum_congr (fun j => ?_)
          rw [ENNReal.ofReal_mul
            (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8))),
            ENNReal.ofReal_mul
              (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)))]
          ring
      _ = (ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1)) *
          ((∑' j : ℕ, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) *
              ((((2 * 3 ^ (2 * j + 1) + 1) ^ d : ℕ) : ℝ) * K ^ (2 * j + 1)))) +
            ∑' j : ℕ, ENNReal.ofReal ((3 : ℝ) ^ (-(s * (j : ℝ) * R / 8)) * Cbmaj)) := by
          rw [ENNReal.tsum_mul_left, ENNReal.tsum_add]
      _ ≤ ENNReal.ofReal ((R * σ / Real.exp 1) ^ R) * (2 : ENNReal) ^ (R - 1) *
          (ENNReal.ofReal SA + ENNReal.ofReal SB) := by
          gcongr
          · rw [← ENNReal.ofReal_tsum_of_nonneg hAnn hAsummable]
            exact ENNReal.ofReal_le_ofReal hAseries
          · rw [← ENNReal.ofReal_tsum_of_nonneg hBnn hBsummable]
            exact ENNReal.ofReal_le_ofReal hBseries
  refine step1.trans (le_of_eq ?_)
  have hSAnn : 0 ≤ SA := le_trans (tsum_nonneg hAnn) hAseries
  have hSBnn : 0 ≤ SB := le_trans (tsum_nonneg hBnn) hBseries
  have h2eq : (2 : ENNReal) = ENNReal.ofReal (2 : ℝ) := by rw [ENNReal.ofReal_ofNat]
  have h2ofReal : (2 : ENNReal) ^ (R - 1) = ENNReal.ofReal ((2 : ℝ) ^ (R - 1)) := by
    rw [h2eq, ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by linarith)]
  rw [h2ofReal, ← ENNReal.ofReal_add hSAnn hSBnn, ← ENNReal.ofReal_mul (by positivity),
    ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [hC2def,
    show (R * σ / Real.exp 1) ^ R = (R / Real.exp 1) ^ R * σ ^ R from by
      rw [show R * σ / Real.exp 1 = (R / Real.exp 1) * σ from by ring,
        Real.mul_rpow (by positivity) hσpos.le]]
  ring

theorem aux_lem_band_piece_product_baseline_c1_PscF_centered_eLpNorm_le (hd2 : 2 ≤ d) (s : ℝ) (hs : s ∈ Set.Ioc (0 : ℝ) 1)
    (p : ℝ) (hp : 1 ≤ p) :
    ∃ CB delta0 : ℝ, 0 ≤ CB ∧ 0 < delta0 ∧
      ∀ (M : GMCModel d), M.delta ≤ delta0 →
      ∀ (m : ℕ) (z : Vec d),
        (∀ᵐ omega ∂M.P.toMeasure, aux_prefix_praw_PscF s m z omega ≠ ⊤) ∧
        eLpNorm (fun omega => (aux_prefix_praw_PscF s m z omega).toReal - 2)
          (ENNReal.ofReal p) M.P.toMeasure ≤ ENNReal.ofReal (CB * M.delta) := by
  obtain ⟨hs0, hs1⟩ := hs
  have hdR : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast (by omega : 1 ≤ d)
  set R : ℝ := 32 * ((d : ℝ) + 1) / s + p + 1 with hRdef
  have hR1 : (1 : ℝ) ≤ R := by
