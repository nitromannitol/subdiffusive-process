      ∀ (Sreg : Paper.in_6_16 d M) (_It : Paper.in_iteration d M I Sreg),
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)), InfraredCharacterization M H →
      ∀ (K k : ℕ), ∀ R ∈ aux_lem_band_U2_D (d := d) k, ∀ i j : Fin d,
        aux_lem_band_U2_CellOK (chaosSampleLaw M).toMeasure w' a c C γ M.delta q k
          (fun omega =>
            Homogenization.Book.Ch02.sigmaStarInvCoarse (Homogenization.Book.Ch02.cubeDomain R)
              ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) i j) (if i = j then (1 : ℝ) else 0) ∧
        aux_lem_band_U2_CellOK (chaosSampleLaw M).toMeasure w' a c C γ M.delta q k
          (fun omega =>
            Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain R)
              ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) i j) (if i = j then (1 : ℝ) else 0) := by
  obtain ⟨a1, c1, ha1, hc1, w1, hw1, hS⟩ := aux_lem_band_U2_sigStarInv d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp
  obtain ⟨a2, c2, ha2, hc2, w2, hw2, hG⟩ := aux_lem_band_U2_sig d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp
  obtain ⟨cm, hcm, hmom⟩ := aux_lem_band_U2_unit_entry_moment d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp
  obtain ⟨af, cf, haf, hcf, wf, hwf, hfine⟩ := aux_lem_band_U2_cellE_fine d hd I _Poincare _Extension
    _Perturbation _Sobolev D Cresp hCresp
  refine ⟨min (min a1 a2) (min af 1), min (min c1 c2) (min cm (min cf 1)),
    lt_min (lt_min ha1 ha2) (lt_min haf one_pos),
    lt_min (lt_min hc1 hc2) (lt_min hcm (lt_min hcf one_pos)),
    max (2 * max w1 w2 + 1) wf, by omega, ?_⟩
  intro γ hγ q hq
  have hq2 : 1 ≤ 2 * q := by linarith
  obtain ⟨δr, Cr, hδr, hCr, href⟩ := aux_lem_band_U2_ref_band d hd I Cresp hCresp γ hγ (2 * q) hq2
  obtain ⟨δ1, C1, hδ1, hC1, hS'⟩ := hS (2 * q) hq2
  obtain ⟨δ2, C2, hδ2, hC2, hG'⟩ := hG (2 * q) hq2
  obtain ⟨δm, Cm, hδm, hCm, hmom'⟩ := hmom (2 * q) hq2
  obtain ⟨δf, Cf, hδf, hCf, hfine'⟩ := hfine γ hγ q hq
  have hCu : 0 ≤ max C1 C2 := le_max_of_le_left hC1
  refine ⟨min (min (min δr δ1) (min δ2 δm)) (min δf 1), Cr * (2 + Cm + 2 * max C1 C2) + Cf,
    lt_min (lt_min (lt_min hδr hδ1) (lt_min hδ2 hδm)) (lt_min hδf one_pos), by positivity, ?_⟩
  intro M hM Rm hRm Sreg It H hH K k R hR i j
  obtain ⟨⟨⟨hMr, hM1⟩, ⟨hM2, hMm⟩⟩, ⟨hMf, hMone⟩⟩ := by simpa only [le_min_iff] using hM
  have hδpos : 0 < M.delta := M.shellPrefix.delta_pos
  have hg : 0 ≤ (3 : ℝ) ^ (γ * (k : ℝ)) := Real.rpow_nonneg (by norm_num) _
  have hz : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
  have hWle : 2 * max w1 w2 + 1 ≤ max (2 * max w1 w2 + 1) wf := le_max_left _ _
  by_cases hkK : k ≤ K
  · have hid := aux_lem_band_U2_cell_identity I M H hH K k hkK R hR
    obtain ⟨hrP, hrI⟩ := href M hMr Rm hRm Sreg It H hH K k hkK R hR
    obtain ⟨hrPm, hrPb, hrP1, hrPB⟩ := hrP
    obtain ⟨hrIm, hrIb, hrI1, hrIB⟩ := hrI
    obtain ⟨hZsm, hZgm⟩ := aux_lem_band_U2_unit_entry_meas I M H hH ((K : ℤ) - (k : ℤ)).toNat i j
    obtain ⟨hmS, hmG⟩ := hmom' M hMm Rm hRm Sreg It H hH ((K : ℤ) - (k : ℤ)).toNat i j
    have hidS : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
