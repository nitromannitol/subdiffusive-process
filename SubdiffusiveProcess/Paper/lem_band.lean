  have hD := ResidualModel.residualDisorderFactor_pos d
  refine ⟨min δg (min (dA / ResidualModel.residualDisorderFactor d)
    (min ((2 * ResidualModel.residualDisorderFactor d)⁻¹) 1)), B.toReal,
    lt_min hδg (lt_min (div_pos hdA hD) (lt_min (by positivity) one_pos)), ENNReal.toReal_nonneg, ?_⟩
  intro M Rm H hH hδ
  have hδgM := hδ.trans (min_le_left _ _)
  have hδA := hδ.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hδD := hδ.trans ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
