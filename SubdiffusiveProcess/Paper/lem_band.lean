          bandSigma (fun _ : ℤ => C(SpatialCoordinates d, ℝ)) h]) (chaosSampleLaw M).toMeasure :=
    (hEm.mono ((aux_lem_band_U2_bandSigma_le h).trans (aux_lem_band_U2_band_le_ambient _ _))).aestronglyMeasurable
  refine ⟨fun omega => (1 / 2 : ℝ) *
