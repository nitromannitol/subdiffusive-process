        eLpNorm (fun omega' => (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) *
          aux_prefix_bank_maxObs 0 k z (eta N omega')) (ENNReal.ofReal q)
          (chaosSampleLaw M).toMeasure := by
      refine eLpNorm_mono_ae (Eventually.of_forall (fun omega' => ?_))
      have hnn1 : 0 ≤ (aux_lem_band_DT3 s k z (eta N omega')).toReal - (0 : ℝ) := by
        simpa using ENNReal.toReal_nonneg
      have hnn2 : 0 ≤ (3 : ℝ) ^ (-(s / 8) * (k : ℝ)) * aux_prefix_bank_maxObs 0 k z (eta N omega') :=
        mul_nonneg (Real.rpow_nonneg (by norm_num) _) (prefix_bank_maxObs_nonneg 0 k z (eta N omega'))
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hnn1, abs_of_nonneg hnn2]
