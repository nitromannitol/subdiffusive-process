    (hVLp : ∀ N, MemLp (V N) (ENNReal.ofReal (2 * (2 * q * max 1 t))) (chaosSampleLaw M).toMeasure)
    (hUb : ∀ N, eLpNorm (U N) (ENNReal.ofReal (2 * (2 * q * max 1 t))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal Cp)
    (hVb : ∀ N, eLpNorm (V N) (ENNReal.ofReal (2 * (2 * q * max 1 t))) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal Cp)
    (hae :
