    (hPhiLip : LipschitzWith Klip Phi) (hPhi0 : Phi 0 = 0)
    (hPhiNonneg : ∀ x, 0 ≤ Phi x)
    (CD : ℝ → ℝ) (hCD : ∀ p, 1 ≤ p → 0 < CD p) :
    ∃ a c : ℝ, ∃ width : ℕ,
