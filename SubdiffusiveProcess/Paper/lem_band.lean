  obtain ⟨C, hC, hmain⟩ := Paper.prop_16.1 d hd 0 1 hr hP _ hphi hnonconst _ hb _ hf hfc hfsupp hf0
    (hfmem.toLp _) hfL2 ((d : ℝ) - 1 / 2) (max q 2) B ht0 ht1 hp2 hB true
  refine ⟨min δU 1, C / 2, lt_min hδU one_pos, by positivity, ?_⟩
