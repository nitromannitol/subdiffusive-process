theorem aux_lem_band_lem_neumann_15_H0 :
  ∀ (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (rho : ℝ → ℝ),
    ContDiff ℝ ∞ rho →
    (∀ tau, 0 ≤ rho tau) →
    (∀ tau, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) →
    (∫ tau, rho tau) = 1 →
    ∀ (pvec : Fin d → ℝ),
      (∑ i : Fin d, (pvec i) ^ 2) = 1 →
    ∀ (hP : ∃ Kp : ℝ≥0, ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖),
      let Q := unitNeumannCube d
      let S := meanZeroResponseSpace hP
      let L0 : S.space →L[ℝ] ℝ :=
        (affineNeumannLoad pvec).comp (subspaceGradient (meanZeroSobolevGraph Q))
      ∀ (fL2 : ℝ → DomainL2 Q),
        (∀ eps : ℝ, (0 < eps ∧ eps < 1 / 8) →
          ((fL2 eps : SpatialCoordinates d → ℝ) =ᵐ[
            volume.restrict (Q : Set (SpatialCoordinates d))]
            faceBump rho pvec eps)) →
        let Leps : ℝ → S.space →L[ℝ] ℝ := fun eps =>
          (sobolevVolumeLoad (fL2 eps)).comp S.space.subtypeL
        ∀ (t p B : ℝ),
          ((d : ℝ) - 1 < t ∧ t < (d : ℝ) ∧ 2 ≤ p ∧ 0 ≤ B) →
          ∃ C : ℝ, 0 < C ∧
            ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d),
              (0 < M.delta ∧ M.delta ≤ 1) →
                let P : Measure (BilateralField d) :=
                  (chaosSampleLaw M).toMeasure
                let aN : ℕ → BilateralField d → PositiveCoefficient Q := fun N om =>
                  cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ => (1 / 2 : ℝ)) one_pos
                let yN : ℕ → BilateralField d → ℝ := fun N om =>
                  inverseResponse S (aN N om) L0
                let yeps : ℝ → ℕ → BilateralField d → ℝ := fun eps N om =>
                  inverseResponse S (aN N om) (Leps eps)
                let ueps : ℝ → ℕ → BilateralField d → S.space := fun eps N om =>
                  responseSolution S (aN N om) (Leps eps)
                ∀ (K : ℕ → BilateralField d → ℝ),
                  (∀ N, AEStronglyMeasurable (K N) P) →
                  (∀ᵐ om ∂P, ∀ N, 0 ≤ K N om) →
                  (∀ᵐ om ∂P,
                    ∀ (N : ℕ) (eps : ℝ),
                      (0 < eps ∧ eps < 1 / 8) →
                      ∀ (x : SpatialCoordinates d) (rad : ℝ),
                        x ∈ Q → (0 < rad ∧ rad ≤ 1) →
                        localGradientEnergy (aN N om)
                            (s := Metric.ball x rad ∩ (Q : Set (SpatialCoordinates d)))
                            (isOpen_ball.measurableSet.inter Q.isOpen.measurableSet)
                            (subspaceGradient S.space (ueps eps N om)) ≤
                          K N om * eps ^ (-2 : ℝ) * rad ^ t) →
                  (∀ N,
                    MemLp (K N) (ENNReal.ofReal (3 * p)) P ∧
                      eLpNorm (K N) (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal B) →
                  (∀ N eps, (0 < eps ∧ eps < 1 / 8) →
                    MemLp (yeps eps N) (ENNReal.ofReal (3 * p)) P ∧
                      eLpNorm (yeps eps N) (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal B) →
                  (∀ N,
                    MemLp (yN N) (ENNReal.ofReal (4 * p)) P ∧
                      eLpNorm (yN N) (ENNReal.ofReal (4 * p)) P ≤ ENNReal.ofReal B) →
                  (∀ N eps, (0 < eps ∧ eps < 1 / 8) →
                    eLpNorm (fun om => yN N om - yeps eps N om)
                      (ENNReal.ofReal p) P ≤
                      ENNReal.ofReal (B * eps ^ (1 / 4 : ℝ))) →
                  ∀ (eps : ℝ), (0 < eps ∧ eps < 1 / 8) →
                    ∀ (N j : ℕ), j ≤ N →
                      eLpNorm
                        (fun pair : BilateralField d × BilateralField d =>
                          yeps eps N pair.1 -
                            yeps eps N
                              (Function.update pair.1 (-(j : ℤ))
                                (pair.2 (-(j : ℤ)))))
                        (ENNReal.ofReal p) (P.prod P) ≤
                        ENNReal.ofReal
                          (C * M.delta * eps ^ (-2 : ℝ) *
                            (3 : ℝ) ^
                              (-((t * (t - (d : ℝ) + 1) / (t + 1) /
                                (8 * Real.log 3)) * (j : ℝ)))) := by
  intro d hd _ _ rho _ _ _ _ pvec _ hP Q S L0 fL2 _ Leps t p B htpB
  obtain ⟨ht_lower, _, hp, hB⟩ := htpB
  obtain ⟨A, hA, hmain⟩ := aux_lem_band_l15h_uniform_hinv d hd (fun _ => (1 / 2 : ℝ)) 1 one_pos
    t p ht_lower hp
  refine ⟨A * B + 1, by positivity, ?_⟩
  intro M hMdelta P aN yN yeps ueps K hKm hKnn hgrowth hKmom hyeps _ _ eps heps N j hjN
  have hc1 : 1 ≤ eps ^ (-2 : ℝ) :=
    Real.one_le_rpow_of_pos_of_le_one_of_nonpos heps.1 (by linarith [heps.2]) (by norm_num)
  have hc0 : 0 ≤ eps ^ (-2 : ℝ) := zero_le_one.trans hc1
  have hK'm : ∀ N, AEStronglyMeasurable (fun om => K N om * eps ^ (-2 : ℝ)) P :=
    fun N => (hKm N).mul_const _
  have hK'nn : ∀ᵐ om ∂P, ∀ N, 0 ≤ K N om * eps ^ (-2 : ℝ) := by
    filter_upwards [hKnn] with om hom N
    exact mul_nonneg (hom N) hc0
  have hgrowth' : ∀ᵐ om ∂P, ∀ N, ∀ x ∈ (Q : Set (SpatialCoordinates d)),
      ∀ rad : ℝ, 0 < rad → rad ≤ 1 →
        localGradientEnergy (aN N om)
          (s := Metric.ball x rad) Metric.isOpen_ball.measurableSet
          (aux_lem_15_u_grad S false 0 (Leps eps) (aN N om)) ≤
          K N om * eps ^ (-2 : ℝ) * rad ^ t := by
    filter_upwards [hgrowth] with om hom N x hx rad hrad0 hrad1
    have h := hom N eps heps x rad hx ⟨hrad0, hrad1⟩
    rw [aux_lem_neumann_15_localEnergy_inter (aN N om) Metric.isOpen_ball.measurableSet] at h
    exact h
  have hmomK : eLpNorm (fun om => K N om * eps ^ (-2 : ℝ)) (ENNReal.ofReal (3 * p)) P ≤
      ENNReal.ofReal (eps ^ (-2 : ℝ) * B) := by
    have hfun : (fun om => K N om * eps ^ (-2 : ℝ)) = eps ^ (-2 : ℝ) • K N := by
      funext om; simp [mul_comm]
    rw [hfun, eLpNorm_const_smul, Real.enorm_eq_ofReal hc0, ENNReal.ofReal_mul hc0]
    gcongr
    exact (hKmom N).2
  have hmomR : eLpNorm (fun om => aux_lem_15_u_resp S false 0 (Leps eps) (aN N om))
      (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal (eps ^ (-2 : ℝ) * B) := by
    refine ((hyeps N eps heps).2).trans (ENNReal.ofReal_le_ofReal ?_)
    nlinarith
  have hbound := hmain (eps ^ (-2 : ℝ) * B) (by positivity) S false 0 (Leps eps)
    M.delta hMdelta.1 hMdelta.2 M.P M.G1 M.G2 (fun _ => (0 : C(SpatialCoordinates d, ℝ)))
    measurable_const (fun j => by filter_upwards with pair; rfl)
    (aux_lem_neumann_15_kappa M) aN
    (fun N om => aux_lem_neumann_15_coeff_ae M (fun _ => 0) om N _ one_pos)
    (fun N om => K N om * eps ^ (-2 : ℝ)) hK'm hK'nn hgrowth' N j hjN hmomK hmomR
  refine hbound.trans (ENNReal.ofReal_le_ofReal ?_)
  have hY : 0 ≤ (3 : ℝ) ^ (-(t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3)) * (j : ℝ)) :=
    (Real.rpow_pos_of_pos (by norm_num) _).le
  rw [show -((t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3)) * (j : ℝ)) =
      -(t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3)) * (j : ℝ) by ring]
  have hdel : 0 ≤ M.delta := hMdelta.1.le
  have hkey : A * (eps ^ (-2 : ℝ) * B) ≤ (A * B + 1) * eps ^ (-2 : ℝ) := by
    nlinarith
  calc A * (eps ^ (-2 : ℝ) * B) * M.delta *
        (3 : ℝ) ^ (-(t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3)) * (j : ℝ))
      ≤ (A * B + 1) * eps ^ (-2 : ℝ) * M.delta *
        (3 : ℝ) ^ (-(t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3)) * (j : ℝ)) := by
        gcongr
    _ = (A * B + 1) * M.delta * eps ^ (-2 : ℝ) *
        (3 : ℝ) ^ (-(t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3)) * (j : ℝ)) := by
        ring


theorem aux_lem_band_n15h_cpc_det {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (S : ResponseSpace (unitNeumannCube d)) (L : S.space →L[ℝ] ℝ)
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (N : ℕ) (ω₁ ω₂ : BilateralField d)
    (hagree : ∀ j : ℤ, -(N : ℤ) ≤ j → ω₁ j = ω₂ j) :
    inverseResponse S (cutoffPositiveCoefficient M (fun _ => 0) ω₁ N (fun _ => (1 / 2 : ℝ))
        one_pos) L =
      inverseResponse S (cutoffPositiveCoefficient M (fun _ => 0) ω₂ N (fun _ => (1 / 2 : ℝ))
        one_pos) L := by
  have hcut : cutoffPotential (fun _ => (0 : C(SpatialCoordinates d, ℝ))) ω₁ N =
      cutoffPotential (fun _ => (0 : C(SpatialCoordinates d, ℝ))) ω₂ N :=
    aux_prop_16_cutoff_eq (fun _ => 0) ω₁ ω₂ N rfl hagree
  have haeq := aux_prop_16_cpc_eq M (fun _ => 0) ω₁ ω₂ N (fun _ => (1 / 2 : ℝ)) one_pos hcut
  rw [haeq]

theorem aux_lem_band_n15h_coarse_eq {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (S : ResponseSpace (unitNeumannCube d)) (L : S.space →L[ℝ] ℝ)
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (N h : ℕ)
    (q : BilateralField d × BilateralField d) :
    inverseResponse S (cutoffPositiveCoefficient M (fun _ => 0) q.1 N (fun _ => (1 / 2 : ℝ))
        one_pos) L =
      inverseResponse S (cutoffPositiveCoefficient M (fun _ => 0)
        (fun j : ℤ => if (h : ℤ) < j then q.2 j else q.1 j) N (fun _ => (1 / 2 : ℝ))
        one_pos) L := by
  have hcut : cutoffPotential (fun _ => (0 : C(SpatialCoordinates d, ℝ))) q.1 N =
      cutoffPotential (fun _ => (0 : C(SpatialCoordinates d, ℝ)))
        (fun j : ℤ => if (h : ℤ) < j then q.2 j else q.1 j) N := by
    funext x
    unfold cutoffPotential
    have hsum : (∑ j ∈ Finset.range (N + 1), q.1 (-(Int.ofNat j)) x) =
        ∑ j ∈ Finset.range (N + 1),
          (fun j' : ℤ => if (h : ℤ) < j' then q.2 j' else q.1 j') (-(Int.ofNat j)) x := by
      refine Finset.sum_congr rfl fun j hj => ?_
      have hj0 : (0 : ℤ) ≤ (Int.ofNat j : ℤ) := Int.natCast_nonneg j
      have h0 : (0 : ℤ) ≤ (h : ℤ) := Int.natCast_nonneg h
      have hneg : ¬ ((h : ℤ) < -(Int.ofNat j)) := by omega
      simp only [hneg, if_false]
    rw [hsum]
  have haeq := aux_prop_16_cpc_eq M (fun _ => 0) q.1 _ N (fun _ => (1 / 2 : ℝ)) one_pos hcut
  rw [haeq]

theorem aux_lem_band_n15h_mean_centered {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (Y : Ω → ℝ) (hYm : AEStronglyMeasurable Y P)
    (hYi : Integrable Y P) (p C δ : ℝ) (hC : 0 ≤ C) (hδ : 0 ≤ δ) (hp : 1 ≤ p)
    (hb1 : eLpNorm (fun om => Y om - 1) (ENNReal.ofReal p) P ≤ ENNReal.ofReal (C * δ)) :
    eLpNorm (fun om => Y om - ∫ omega, Y omega ∂P) (ENNReal.ofReal p) P ≤
      ENNReal.ofReal (2 * C * δ) := by
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp
  have hYsub1_int : Integrable (fun om => Y om - 1) P := hYi.sub (integrable_const 1)
  set m : ℝ := ∫ omega, Y omega ∂P with hmdef
  have hmean : (∫ om, (Y om - 1) ∂P) = m - 1 := by
    rw [integral_sub hYi (integrable_const (1 : ℝ))]
    simp [hmdef]
  have habs : |m - 1| ≤ C * δ := by
    have h1 : |∫ om, (Y om - 1) ∂P| ≤ ∫ om, |Y om - 1| ∂P := by
      simpa [Real.norm_eq_abs] using
        norm_integral_le_integral_norm (μ := P) (f := fun om => Y om - 1)
    have h2 : ENNReal.ofReal (∫ om, |Y om - 1| ∂P) = eLpNorm (fun om => Y om - 1) 1 P := by
      rw [eLpNorm_one_eq_lintegral_enorm,
        ofReal_integral_eq_lintegral_ofReal hYsub1_int.abs (ae_of_all _ fun om => abs_nonneg _)]
      refine lintegral_congr fun om => ?_
      rw [← ofReal_norm_eq_enorm, Real.norm_eq_abs]
    have h3 : eLpNorm (fun om => Y om - 1) 1 P ≤
        eLpNorm (fun om => Y om - 1) (ENNReal.ofReal p) P :=
      eLpNorm_le_eLpNorm_of_exponent_le
        (by rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp)
        (hYm.sub aestronglyMeasurable_const)
    have h5 : (∫ om, |Y om - 1| ∂P) ≤ C * δ :=
      (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 (by rw [h2]; exact h3.trans hb1)
    rw [← hmean]
    exact h1.trans h5
  have hsplit : (fun om => Y om - m) = (fun om => Y om - 1) + (fun _ => (1 : ℝ) - m) := by
    funext om; simp only [Pi.add_apply]; ring
  have hadd : eLpNorm ((fun om => Y om - 1) + fun _ : Ω => (1 : ℝ) - m) (ENNReal.ofReal p) P ≤
      eLpNorm (fun om => Y om - 1) (ENNReal.ofReal p) P +
        eLpNorm (fun _ : Ω => (1 : ℝ) - m) (ENNReal.ofReal p) P :=
    eLpNorm_add_le (hYm.sub aestronglyMeasurable_const) aestronglyMeasurable_const hp1
  have hconst : eLpNorm (fun _ : Ω => (1 : ℝ) - m) (ENNReal.ofReal p) P =
      ENNReal.ofReal |1 - m| := by
    rw [eLpNorm_const ((1 : ℝ) - m)
      (ENNReal.ofReal_pos.mpr (by linarith)).ne'
      (IsProbabilityMeasure.ne_zero P)]
    simp [← ofReal_norm_eq_enorm, Real.norm_eq_abs]
  have habs' : |(1 : ℝ) - m| ≤ C * δ := by rw [abs_sub_comm]; exact habs
  rw [hsplit]
  refine hadd.trans ?_
  rw [hconst]
  refine (add_le_add hb1 (ENNReal.ofReal_mono habs')).trans ?_
  rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
  apply ENNReal.ofReal_mono
  linarith

theorem aux_lem_band_n15h_centered_cond {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (laws : ℤ → Measure C(SpatialCoordinates d, ℝ))
    [∀ j, IsProbabilityMeasure (laws j)]
    (Y : BilateralField d → ℝ) (hYm : AEStronglyMeasurable Y (Measure.infinitePi laws))
    (hYi : Integrable Y (Measure.infinitePi laws))
    (p C δ : ℝ) (hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p) (hC : 0 ≤ C) (hδ : 0 ≤ δ) (h : ℕ)
    (hCCmp : MeasurePreserving
      (fun q : BilateralField d × BilateralField d => fun j =>
        if (h : ℤ) < j then q.2 j else q.1 j)
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) (Measure.infinitePi laws))
    (hFCmp : MeasurePreserving
      (fun q : BilateralField d × BilateralField d => fun j =>
        if j < -(h : ℤ) then q.2 j else q.1 j)
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) (Measure.infinitePi laws))
    (hmean : eLpNorm (fun om => Y om - ∫ omega, Y omega ∂(Measure.infinitePi laws))
      (ENNReal.ofReal p) (Measure.infinitePi laws) ≤ ENNReal.ofReal (C * δ)) :
    eLpNorm (fun om => Y om -
        ((Measure.infinitePi laws)[Y | bandSigma (fun _ : ℤ => C(SpatialCoordinates d, ℝ)) h])
          om) (ENNReal.ofReal p) (Measure.infinitePi laws) ≤
      ENNReal.ofReal (4 * C * δ) := by
  refine (aux_prop_16_band_split laws h hp1 ENNReal.ofReal_ne_top hYi).trans ?_
  have c1 := aux_prop_16_copy_centered laws hp1 Y hYm _ hCCmp
    (∫ om, Y om ∂(Measure.infinitePi laws))
  have c2 := aux_prop_16_copy_centered laws hp1 Y hYm _ hFCmp
    (∫ om, Y om ∂(Measure.infinitePi laws))
  have hx : 0 ≤ C * δ := by positivity
  calc _ ≤ 2 * eLpNorm (fun om => Y om - ∫ om, Y om ∂(Measure.infinitePi laws))
          (ENNReal.ofReal p) (Measure.infinitePi laws) +
        2 * eLpNorm (fun om => Y om - ∫ om, Y om ∂(Measure.infinitePi laws))
          (ENNReal.ofReal p) (Measure.infinitePi laws) := add_le_add c1 c2
    _ ≤ 2 * ENNReal.ofReal (C * δ) + 2 * ENNReal.ofReal (C * δ) := by
        gcongr <;> exact hmean
    _ = ENNReal.ofReal (4 * C * δ) := by
        rw [two_mul, ← ENNReal.ofReal_add hx hx, ← ENNReal.ofReal_add (by positivity)
          (by positivity)]
        congr 1
        ring

theorem aux_lem_band_n15h_hfine
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (hP : ∃ Kp : ℝ≥0, ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖)
    (pvec : Fin d → ℝ) (fL2 : ℝ → DomainL2 (unitNeumannCube d))
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (a Cn p B : ℝ) (ha0 : 0 < a)
    (hCn : 0 ≤ Cn) (hδ0 : 0 ≤ M.delta) (hB : 0 ≤ B) (h1r : 0 < 1 - (3 : ℝ) ^ (-a)) (h N : ℕ) :
    let Q := unitNeumannCube d
    let S := meanZeroResponseSpace hP
    let L0 : S.space →L[ℝ] ℝ :=
      (affineNeumannLoad pvec).comp (subspaceGradient (meanZeroSobolevGraph Q))
    let Leps : ℝ → S.space →L[ℝ] ℝ := fun eps => (sobolevVolumeLoad (fL2 eps)).comp S.space.subtypeL
    let P : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
    let aN : ℕ → BilateralField d → PositiveCoefficient Q := fun N om =>
      cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ => (1 / 2 : ℝ)) one_pos
    let yN : ℕ → BilateralField d → ℝ := fun N om => inverseResponse S (aN N om) L0
    let yeps : ℝ → ℕ → BilateralField d → ℝ := fun eps N om => inverseResponse S (aN N om) (Leps eps)
    let laws : ℤ → Measure C(SpatialCoordinates d, ℝ) := fun j =>
      (scaledLayerLaw d (chaosRootFieldLaw M) j : Measure C(SpatialCoordinates d, ℝ))
    (hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p) →
    (hyNm : AEStronglyMeasurable (yN N) (Measure.infinitePi laws)) →
    (hFCmp : MeasurePreserving
      (fun q : BilateralField d × BilateralField d => fun j =>
        if j < -(h : ℤ) then q.2 j else q.1 j)
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) (Measure.infinitePi laws)) →
    (∀ N eps, (0 < eps ∧ eps < 1 / 8) →
      MemLp (yeps eps N) (ENNReal.ofReal (3 * p)) P ∧
        eLpNorm (yeps eps N) (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal B) →
    (∀ N eps, (0 < eps ∧ eps < 1 / 8) →
      eLpNorm (fun om => yN N om - yeps eps N om) (ENNReal.ofReal p) P ≤
        ENNReal.ofReal (B * eps ^ (1 / 4 : ℝ))) →
    (∀ ε : ℝ, (0 < ε ∧ ε < 1 / 8) → ∀ k : ℕ, k ≤ N →
      eLpNorm (fun pair : BilateralField d × BilateralField d =>
          yeps ε N pair.1 - yeps ε N (Function.update pair.1 (-(k : ℤ)) (pair.2 (-(k : ℤ)))))
        (ENNReal.ofReal p) (P.prod P) ≤
      ENNReal.ofReal (Cn * M.delta * ε ^ (-2 : ℝ) * (3 : ℝ) ^ (-(a * (k : ℝ))))) →
    ∀ ε : ℝ, 0 < ε ∧ ε < 1 / 8 →
      eLpNorm (fun q : BilateralField d × BilateralField d =>
          yN N q.1 - yN N (fun j => if j < -(h : ℤ) then q.2 j else q.1 j))
        (ENNReal.ofReal p) ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) ≤
      ENNReal.ofReal (2 * B * ε ^ (1 / 4 : ℝ) + Cn * M.delta * ε ^ (-2 : ℝ) *
        (3 : ℝ) ^ (-a * (h : ℝ)) / (1 - (3 : ℝ) ^ (-a))) := by
  intro Q S L0 Leps P aN yN yeps laws hp1 hyNm hFCmp hyeps hsmooth hn15fix ε hε
  have hyem : AEStronglyMeasurable (yeps ε N) (Measure.infinitePi laws) :=
    (hyeps N ε hε).1.aestronglyMeasurable
  have hdiff : eLpNorm (fun om => yN N om - yeps ε N om) (ENNReal.ofReal p)
      (Measure.infinitePi laws) ≤ ENNReal.ofReal (B * ε ^ (1 / 4 : ℝ)) := hsmooth N ε hε
  have hdetE : ∀ ω₁ ∈ (Set.univ : Set (BilateralField d)),
      ∀ ω₂ ∈ (Set.univ : Set (BilateralField d)),
      (∀ j : ℤ, -(N : ℤ) ≤ j → ω₁ j = ω₂ j) → yeps ε N ω₁ = yeps ε N ω₂ := by
    intro ω₁ _ ω₂ _ hagree
    exact aux_lem_band_n15h_cpc_det S (Leps ε) M N ω₁ ω₂ hagree
  have htel := aux_prop_16_fine_telescope laws hp1 (yeps ε N) hyem Set.univ
    (ae_of_all _ (fun _ => Set.mem_univ _)) h N hdetE
    (fun k => ENNReal.ofReal (Cn * M.delta * ε ^ (-2 : ℝ) * (3 : ℝ) ^ (-(a * (k : ℝ)))))
    (fun k _ hkN => hn15fix ε hε k hkN)
  have hgeo := aux_prop_16_geom_neg a ha0 (Cn * M.delta * ε ^ (-2 : ℝ))
    (by have : 0 ≤ ε ^ (-2 : ℝ) := Real.rpow_nonneg hε.1.le _; positivity) h N
  let FC : BilateralField d × BilateralField d → BilateralField d := fun q j =>
    if j < -(h : ℤ) then q.2 j else q.1 j
  have m1 : AEStronglyMeasurable (fun q : BilateralField d × BilateralField d =>
      yN N q.1 - yeps ε N q.1)
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) :=
    (hyNm.sub hyem).comp_measurePreserving measurePreserving_fst
  have m2 : AEStronglyMeasurable (fun q : BilateralField d × BilateralField d =>
      yeps ε N q.1 - yeps ε N (FC q))
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) :=
    (hyem.comp_measurePreserving measurePreserving_fst).sub
      (hyem.comp_measurePreserving hFCmp)
  have m3 : AEStronglyMeasurable (fun q : BilateralField d × BilateralField d =>
      yN N (FC q) - yeps ε N (FC q))
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) :=
    (hyNm.sub hyem).comp_measurePreserving hFCmp
  have hsplit : (fun q : BilateralField d × BilateralField d => yN N q.1 - yN N (FC q)) =
      ((fun q => yN N q.1 - yeps ε N q.1) + (fun q => yeps ε N q.1 - yeps ε N (FC q))) -
        (fun q => yN N (FC q) - yeps ε N (FC q)) := by
    funext q
    simp only [Pi.add_apply, Pi.sub_apply]
    ring
  change eLpNorm (fun q : BilateralField d × BilateralField d => yN N q.1 - yN N (FC q))
    (ENNReal.ofReal p) ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) ≤ _
  rw [hsplit]
  refine (eLpNorm_sub_le (m1.add m2) m3 hp1).trans ?_
  refine (add_le_add (eLpNorm_add_le m1 m2 hp1) le_rfl).trans ?_
  let gd : BilateralField d → ℝ := fun om => yN N om - yeps ε N om
  have hgd : AEStronglyMeasurable gd (Measure.infinitePi laws) := hyNm.sub hyem
  have e1 := aux_prop_16_eLpNorm_mp (ENNReal.ofReal p) Prod.fst
    (measurePreserving_fst : MeasurePreserving Prod.fst
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) (Measure.infinitePi laws))
    gd hgd
  have e3 := aux_prop_16_eLpNorm_mp (ENNReal.ofReal p) FC hFCmp gd hgd
  change eLpNorm (fun q : BilateralField d × BilateralField d => gd q.1)
      (ENNReal.ofReal p) ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) +
    eLpNorm (fun q : BilateralField d × BilateralField d =>
      yeps ε N q.1 - yeps ε N (FC q)) (ENNReal.ofReal p)
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) +
    eLpNorm (fun q : BilateralField d × BilateralField d => gd (FC q))
      (ENNReal.ofReal p) ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) ≤ _
  rw [e1, e3]
  have hB0 : 0 ≤ B * ε ^ (1 / 4 : ℝ) := by
    have : 0 ≤ ε ^ (1 / 4 : ℝ) := Real.rpow_nonneg hε.1.le _
    positivity
  have hF0 : 0 ≤ Cn * M.delta * ε ^ (-2 : ℝ) * (3 : ℝ) ^ (-a * (h : ℝ)) /
      (1 - (3 : ℝ) ^ (-a)) := by
    have : 0 ≤ ε ^ (-2 : ℝ) := Real.rpow_nonneg hε.1.le _
    positivity
  calc eLpNorm (fun om => yN N om - yeps ε N om) (ENNReal.ofReal p) (Measure.infinitePi laws) +
        eLpNorm (fun q : BilateralField d × BilateralField d =>
          yeps ε N q.1 - yeps ε N (FC q)) (ENNReal.ofReal p)
          ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) +
        eLpNorm (fun om => yN N om - yeps ε N om) (ENNReal.ofReal p) (Measure.infinitePi laws)
      ≤ ENNReal.ofReal (B * ε ^ (1 / 4 : ℝ)) +
          ENNReal.ofReal (Cn * M.delta * ε ^ (-2 : ℝ) * (3 : ℝ) ^ (-a * (h : ℝ)) /
            (1 - (3 : ℝ) ^ (-a))) +
          ENNReal.ofReal (B * ε ^ (1 / 4 : ℝ)) :=
        add_le_add (add_le_add hdiff (htel.trans hgeo)) hdiff
    _ = ENNReal.ofReal (2 * B * ε ^ (1 / 4 : ℝ) + Cn * M.delta * ε ^ (-2 : ℝ) *
          (3 : ℝ) ^ (-a * (h : ℝ)) / (1 - (3 : ℝ) ^ (-a))) := by
        rw [← ENNReal.ofReal_add hB0 hF0, ← ENNReal.ofReal_add (by positivity) hB0]
        congr 1
        ring

theorem aux_lem_band_prop16_neumann_H0 :
  ∀ (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (Cresp : ℝ) (hCresp : 0 < Cresp)
    (rho : ℝ → ℝ),
    ContDiff ℝ ∞ rho →
    (∀ tau, 0 ≤ rho tau) →
    (∀ tau, tau ∉ Set.Ioo (1 : ℝ) 2 → rho tau = 0) →
    (∫ tau, rho tau) = 1 →
    ∀ (pvec : Fin d → ℝ),
      (∑ i : Fin d, (pvec i) ^ 2) = 1 →
    ∀ (hP : ∃ Kp : ℝ≥0, ∀ u : meanZeroSobolevGraph (unitNeumannCube d),
        ‖(u : SobolevData (unitNeumannCube d)).1‖ ≤
          Kp * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) u‖),
      let Q := unitNeumannCube d
      let S := meanZeroResponseSpace hP
      let L0 : S.space →L[ℝ] ℝ :=
        (affineNeumannLoad pvec).comp (subspaceGradient (meanZeroSobolevGraph Q))
      ∀ (fL2 : ℝ → DomainL2 Q),
        (∀ eps : ℝ, (0 < eps ∧ eps < 1 / 8) →
          ((fL2 eps : SpatialCoordinates d → ℝ) =ᵐ[
            volume.restrict (Q : Set (SpatialCoordinates d))]
            faceBump rho pvec eps)) →
        let Leps : ℝ → S.space →L[ℝ] ℝ := fun eps =>
          (sobolevVolumeLoad (fL2 eps)).comp S.space.subtypeL
        ∀ (t p B : ℝ),
          ((d : ℝ) - 1 < t ∧ t < (d : ℝ) ∧ 2 ≤ p ∧ 0 ≤ B) →
          ∃ delta0 C : ℝ, 0 < delta0 ∧ delta0 ≤ 1 ∧ 0 < C ∧
            ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d),
              (0 < M.delta ∧ M.delta ≤ delta0) →
              ∀ (Rinput : Paper.in_responses d M),
                Rinput.C ≤ Cresp →
                4 * p ≤ Cresp⁻¹ * (M.delta ^ 2)⁻¹ * |Real.log M.delta|⁻¹ →
                let P : Measure (BilateralField d) :=
                  (chaosSampleLaw M).toMeasure
                let aN : ℕ → BilateralField d → PositiveCoefficient Q := fun N om =>
                  cutoffPositiveCoefficient M (fun _ => 0) om N (fun _ => (1 / 2 : ℝ)) one_pos
                let yN : ℕ → BilateralField d → ℝ := fun N om =>
                  inverseResponse S (aN N om) L0
                let yeps : ℝ → ℕ → BilateralField d → ℝ := fun eps N om =>
                  inverseResponse S (aN N om) (Leps eps)
                let ueps : ℝ → ℕ → BilateralField d → S.space := fun eps N om =>
                  responseSolution S (aN N om) (Leps eps)
                ∀ (K : ℕ → BilateralField d → ℝ),
                  (∀ N, AEStronglyMeasurable (K N) P) →
                  (∀ᵐ om ∂P, ∀ N, 0 ≤ K N om) →
                  (∀ᵐ om ∂P,
                    ∀ (N : ℕ) (eps : ℝ),
                      (0 < eps ∧ eps < 1 / 8) →
                      ∀ (x : SpatialCoordinates d) (rad : ℝ),
                        x ∈ Q → (0 < rad ∧ rad ≤ 1) →
                        localGradientEnergy (aN N om)
                            (s := Metric.ball x rad ∩ (Q : Set (SpatialCoordinates d)))
                            (isOpen_ball.measurableSet.inter Q.isOpen.measurableSet)
                            (subspaceGradient S.space (ueps eps N om)) ≤
                          K N om * eps ^ (-2 : ℝ) * rad ^ t) →
                  (∀ N,
                    MemLp (K N) (ENNReal.ofReal (3 * p)) P ∧
                      eLpNorm (K N) (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal B) →
                  (∀ N eps, (0 < eps ∧ eps < 1 / 8) →
                    MemLp (yeps eps N) (ENNReal.ofReal (3 * p)) P ∧
                      eLpNorm (yeps eps N) (ENNReal.ofReal (3 * p)) P ≤ ENNReal.ofReal B) →
                  (∀ N,
                    MemLp (yN N) (ENNReal.ofReal (4 * p)) P ∧
                      eLpNorm (yN N) (ENNReal.ofReal (4 * p)) P ≤ ENNReal.ofReal B) →
                  (∀ N eps, (0 < eps ∧ eps < 1 / 8) →
                    eLpNorm (fun om => yN N om - yeps eps N om)
                      (ENNReal.ofReal p) P ≤
                      ENNReal.ofReal (B * eps ^ (1 / 4 : ℝ))) →
                  (∀ h N : ℕ,
                    let sigma_h := bandSigma (fun _ : ℤ => C(SpatialCoordinates d, ℝ)) h
                    eLpNorm
                      (fun om => yN N om - (P[yN N | sigma_h]) om)
                      (ENNReal.ofReal p) P ≤
                    ENNReal.ofReal
                      (C * Real.sqrt M.delta *
                        (3 : ℝ) ^
                          (-((t * (t - (d : ℝ) + 1) / (t + 1) /
                              (8 * Real.log 3) / 32) * (h : ℝ))))) ∧
                  (∀ h N : ℕ, N < h →
                    let sigma_h := bandSigma (fun _ : ℤ => C(SpatialCoordinates d, ℝ)) h
                    eLpNorm
                      (fun om => yN N om - (P[yN N | sigma_h]) om)
                      (ENNReal.ofReal p) P ≤
                    ENNReal.ofReal
                      (C * M.delta * (3 : ℝ) ^ (-(h : ℝ))))
    := by
  intro d hd instM instB I Cresp hCresp rho hrho1 hrho2 hrho3 hrho4 pvec hpvec hP Q S L0
    fL2 hfL2 Leps t p B htpB
  obtain ⟨ht_lower, ht_upper, hp, hB⟩ := htpB
  obtain ⟨Cn, hCn, hn15⟩ := aux_lem_band_lem_neumann_15_H0 d hd rho hrho1 hrho2 hrho3 hrho4
    pvec hpvec hP fL2 hfL2 t p B ⟨ht_lower, ht_upper, hp, hB⟩
  obtain ⟨Cdev, hCdev, hdev⟩ := I.deviation_by_J
  let Cc1 : ℝ := Real.sqrt Cdev *
      (Real.sqrt (Cresp * p * Real.log (2 + p)) + Cresp * p * Real.log (2 + p))
  have hCc1_def : Cc1 = Real.sqrt Cdev *
      (Real.sqrt (Cresp * p * Real.log (2 + p)) + Cresp * p * Real.log (2 + p)) := rfl
  have hCc1_0 : 0 ≤ Cc1 := by
    have hlp : 0 ≤ Real.log (2 + p) := Real.log_nonneg (by linarith)
    rw [hCc1_def]; positivity
  obtain ⟨ha0, ha1⟩ := aux_prop_16_exponent_facts d hd t ht_lower ht_upper
  let a : ℝ := t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3)
  have ha_def : a = t * (t - (d : ℝ) + 1) / (t + 1) / (8 * Real.log 3) := rfl
  have hr1 : (3 : ℝ) ^ (-a) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have h1r : 0 < 1 - (3 : ℝ) ^ (-a) := by linarith
  refine ⟨1, Real.sqrt (4 * (2 * B + Cn / (1 - (3 : ℝ) ^ (-a))) * (2 * Cc1)) + 8 * (2 * Cc1) + 1,
    one_pos, le_refl 1, by positivity, ?_⟩
  intro M hM Rinput hRC hscale P aN yN yeps ueps K hKm hK0 hgrowth hKmom hyeps hyN hsmooth
  obtain ⟨hδ0, hδ⟩ := hM
  have hδ1 : M.delta ≤ 1 := hδ
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (by linarith only [hp])
  let laws : ℤ → Measure C(SpatialCoordinates d, ℝ) := fun j =>
    (scaledLayerLaw d (chaosRootFieldLaw M) j : Measure C(SpatialCoordinates d, ℝ))
  have hyNm : ∀ N, AEStronglyMeasurable (yN N) (Measure.infinitePi laws) := fun N =>
    (hyN N).1.aestronglyMeasurable
  have hyNint : ∀ N, Integrable (yN N) (Measure.infinitePi laws) := fun N =>
    (hyN N).1.integrable (by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (by linarith only [hp]))
  have hFCmp : ∀ h : ℕ, MeasurePreserving
      (fun q : BilateralField d × BilateralField d => fun j =>
        if j < -(h : ℤ) then q.2 j else q.1 j)
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) (Measure.infinitePi laws) :=
    fun h => measurePreserving_copy_infinitePi_block laws {j : ℤ | j < -(h : ℤ)}
  have hCCmp : ∀ h : ℕ, MeasurePreserving
      (fun q : BilateralField d × BilateralField d => fun j =>
        if (h : ℤ) < j then q.2 j else q.1 j)
      ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) (Measure.infinitePi laws) :=
    fun h => measurePreserving_copy_infinitePi_block laws {j : ℤ | (h : ℤ) < j}

  have hcoarse0 : ∀ h N : ℕ,
      (fun q : BilateralField d × BilateralField d =>
        yN N q.1 - yN N (fun j => if (h : ℤ) < j then q.2 j else q.1 j)) = 0 := by
    intro h N
    funext q
    show yN N q.1 - yN N (fun j => if (h : ℤ) < j then q.2 j else q.1 j) = (0 : ℝ)
    rw [show yN N (fun j => if (h : ℤ) < j then q.2 j else q.1 j) = yN N q.1 from
      (aux_lem_band_n15h_coarse_eq S L0 M N h q).symm, sub_self]
  have hdetN : ∀ N : ℕ, ∀ ω₁ ∈ (Set.univ : Set (BilateralField d)),
      ∀ ω₂ ∈ (Set.univ : Set (BilateralField d)),
      (∀ j : ℤ, -(N : ℤ) ≤ j → ω₁ j = ω₂ j) → yN N ω₁ = yN N ω₂ := by
    intro N ω₁ _ ω₂ _ hagree
    exact aux_lem_band_n15h_cpc_det S L0 M N ω₁ ω₂ hagree
  have hfine0 : ∀ h N : ℕ, N ≤ h →
      eLpNorm (fun q : BilateralField d × BilateralField d =>
          yN N q.1 - yN N (fun j => if j < -(h : ℤ) then q.2 j else q.1 j))
        (ENNReal.ofReal p) ((Measure.infinitePi laws).prod (Measure.infinitePi laws)) ≤ 0 := by
    intro h N hNh
    have htel := aux_prop_16_fine_telescope laws hp1 (yN N) (hyNm N) Set.univ
      (ae_of_all _ (fun _ => Set.mem_univ _)) h N (hdetN N)
      (fun _ => 0) (fun k hk hkN => absurd (lt_of_lt_of_le hk hkN) (by omega))
    simpa using htel

  have hcN : ∀ N : ℕ, eLpNorm
      (fun om => yN N om - ∫ omega, yN N omega ∂(Measure.infinitePi laws))
      (ENNReal.ofReal p) (Measure.infinitePi laws) ≤ ENNReal.ofReal (2 * Cc1 * M.delta) := by
    intro N
    obtain ⟨hDmem, hDnorm⟩ := aux_neumann_centered_response_defect_moments M Rinput Cresp p
      hCresp hRC hscale (fun N => aux_prop_16_relab N) (fun N => aux_prop_16_relab_mp M N) N
    have hrelabId : ∀ᵐ om ∂(Measure.infinitePi laws), ∀ N i x,
        aux_prop_16_relab (d := d) N om i x = om (i - (N : ℤ)) ((3 : ℝ) ^ (-(N : ℤ)) • x) :=
      ae_of_all _ fun om N i x => aux_prop_16_relab_apply N om i x
    have hdev_ae : ∀ᵐ om ∂(Measure.infinitePi laws),
        (yN N om - 1) ^ 2 ≤ Cdev *
          (fun om => Rinput.defect N (fun _ => (3 : ℝ) ^ N / 2) (aux_prop_16_relab N om)) om *
          (1 + (fun om => Rinput.defect N (fun _ => (3 : ℝ) ^ N / 2)
            (aux_prop_16_relab N om)) om) := by
      filter_upwards [hrelabId] with om hom
      exact aux_neumann_centered_response_dev M Rinput pvec hpvec hP Cdev hdev N om
        (aux_prop_16_relab N om)
        (fun x => aux_neumann_centered_response_reindex N om (aux_prop_16_relab N om) x
          (fun i y => hom N i y))
    have hb1 : eLpNorm (fun om => yN N om - 1) (ENNReal.ofReal p) (Measure.infinitePi laws) ≤
        ENNReal.ofReal (Cc1 * M.delta) :=
