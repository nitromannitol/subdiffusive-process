theorem aux_lem_band_U2_num_mom (δ c cm Cr Cm C1 Cf g z : ℝ)
    (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (hc1 : c ≤ 1) (hccm : c ≤ cm)
    (hCr : 0 ≤ Cr) (hCm : 0 ≤ Cm) (hC1 : 0 ≤ C1) (hCf : 0 ≤ Cf) (hg : 0 ≤ g) (hz : |z| ≤ 1) :
    |z| * (Cr * δ * g) + Cr * g * (Cm * δ ^ cm) ≤ (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g := by
  have hδc : δ ≤ δ ^ c := by
    have := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 hc1
    rwa [Real.rpow_one] at this
  have hδcm : δ ^ cm ≤ δ ^ c := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 hccm
  have hδcpos : 0 ≤ δ ^ c := Real.rpow_nonneg hδ0.le _
  have A : |z| * (Cr * δ * g) ≤ Cr * δ ^ c * g := by
    calc |z| * (Cr * δ * g) ≤ 1 * (Cr * δ * g) :=
          mul_le_mul_of_nonneg_right hz (by positivity)
      _ = Cr * δ * g := one_mul _
      _ ≤ Cr * δ ^ c * g := by gcongr
  have B : Cr * g * (Cm * δ ^ cm) ≤ Cr * g * (Cm * δ ^ c) := by gcongr
  have e : (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g =
      Cr * δ ^ c * g + Cr * g * (Cm * δ ^ c) + (Cr * (1 + 2 * C1) + Cf) * δ ^ c * g := by ring
  have hrest : 0 ≤ (Cr * (1 + 2 * C1) + Cf) * δ ^ c * g := by positivity
  rw [e]; linarith

theorem aux_lem_band_U2_num_band (δ c c1 cm u v t Cr Cm C1 Cf g z : ℝ)
    (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (hc1 : c ≤ 1) (hcc1 : c ≤ c1) (hccm : c ≤ cm)
    (hc1pos : 0 ≤ c1) (hcmpos : 0 ≤ cm)
    (hu0 : 0 ≤ u) (hut : u ≤ t) (hv0 : 0 ≤ v) (hvt : v ≤ t) (hv1 : v ≤ 1)
    (hCr : 0 ≤ Cr) (hCm : 0 ≤ Cm) (hC1 : 0 ≤ C1) (hCf : 0 ≤ Cf) (hg : 0 ≤ g) (hz : |z| ≤ 1) :
    |z| * (Cr * δ * g * u) + Cr * g * (C1 * δ ^ c1 * v) +
        Cr * δ * g * u * (Cm * δ ^ cm + C1 * δ ^ c1 * v) ≤
      (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g * t := by
  have hδc : δ ≤ δ ^ c := by
    have := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 hc1
    rwa [Real.rpow_one] at this
  have hδc1 : δ ^ c1 ≤ δ ^ c := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 hcc1
  have hδcm1 : δ ^ cm ≤ 1 := Real.rpow_le_one hδ0.le hδ1 hcmpos
  have hδc11 : δ ^ c1 ≤ 1 := Real.rpow_le_one hδ0.le hδ1 hc1pos
  have hδcpos : 0 ≤ δ ^ c := Real.rpow_nonneg hδ0.le _
  have hδcm0 : 0 ≤ δ ^ cm := Real.rpow_nonneg hδ0.le _
  have hδc10 : 0 ≤ δ ^ c1 := Real.rpow_nonneg hδ0.le _
  have ht0 : 0 ≤ t := hu0.trans hut
  have A : |z| * (Cr * δ * g * u) ≤ Cr * δ ^ c * g * t := by
    calc |z| * (Cr * δ * g * u) ≤ 1 * (Cr * δ * g * u) :=
          mul_le_mul_of_nonneg_right hz (by positivity)
      _ = Cr * δ * g * u := one_mul _
      _ ≤ Cr * δ ^ c * g * t := by gcongr
  have B : Cr * g * (C1 * δ ^ c1 * v) ≤ Cr * g * (C1 * δ ^ c * t) := by gcongr
  have hin : Cm * δ ^ cm + C1 * δ ^ c1 * v ≤ Cm + C1 := by
    have h1 : Cm * δ ^ cm ≤ Cm * 1 := by gcongr
    have h2 : δ ^ c1 * v ≤ 1 * 1 := mul_le_mul hδc11 hv1 hv0 zero_le_one
    have h3 : C1 * (δ ^ c1 * v) ≤ C1 * (1 * 1) := by gcongr
    linarith [mul_assoc C1 (δ ^ c1) v]
  have Cc : Cr * δ * g * u * (Cm * δ ^ cm + C1 * δ ^ c1 * v) ≤ Cr * δ ^ c * g * t * (Cm + C1) := by
    have hin0 : 0 ≤ Cm * δ ^ cm + C1 * δ ^ c1 * v := by positivity
    have h1 : Cr * δ * g * u ≤ Cr * δ ^ c * g * t := by gcongr
    exact mul_le_mul h1 hin hin0 (by positivity)
  have e : (Cr * (2 + Cm + 2 * C1) + Cf) * δ ^ c * g * t =
      Cr * δ ^ c * g * t + Cr * g * (C1 * δ ^ c * t) + Cr * δ ^ c * g * t * (Cm + C1) +
        (Cr + Cf) * δ ^ c * g * t := by ring
  have hrest : 0 ≤ (Cr + Cf) * δ ^ c * g * t := by positivity
  rw [e]; linarith

theorem aux_lem_band_U2_rates (a a1 : ℝ) (h : ℕ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (haa1 : a ≤ a1) :
    (3 : ℝ) ^ (-(h : ℝ)) ≤ (3 : ℝ) ^ (-(a * (h : ℝ))) ∧
    (3 : ℝ) ^ (-(a1 * ((h + 1 : ℕ) : ℝ))) ≤ (3 : ℝ) ^ (-(a * (h : ℝ))) ∧
    (3 : ℝ) ^ (-(a1 * ((h + 1 : ℕ) : ℝ))) ≤ 1 := by
  have hh : (0 : ℝ) ≤ h := Nat.cast_nonneg h
  have hh1 : ((h + 1 : ℕ) : ℝ) = (h : ℝ) + 1 := by push_cast; ring
  refine ⟨aux_lem_band_U2_rpow_mono_exp ?_, aux_lem_band_U2_rpow_mono_exp ?_, ?_⟩
  · have : a * (h : ℝ) ≤ 1 * (h : ℝ) := mul_le_mul_of_nonneg_right ha1 hh
    linarith
  · rw [hh1]
    have : a * (h : ℝ) ≤ a1 * (h : ℝ) := mul_le_mul_of_nonneg_right haa1 hh
    have : 0 ≤ a1 := ha0.trans haa1
    nlinarith
  · refine Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) ?_
    have : 0 ≤ a1 * ((h + 1 : ℕ) : ℝ) := mul_nonneg (ha0.trans haa1) (Nat.cast_nonneg _)
    linarith

theorem aux_lem_band_U2_unit_entry_meas {d : ℕ} [NeZero d]
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (K : ℕ) (i j : Fin d) :
    AEStronglyMeasurable (fun omega => aux_lem_band_U2_sigStarInvF i j (aux_lem_band_U2_unitChart I M H omega K))
      (chaosSampleLaw M).toMeasure ∧
    AEStronglyMeasurable (fun omega => aux_lem_band_U2_sigF i j (aux_lem_band_U2_unitChart I M H omega K))
      (chaosSampleLaw M).toMeasure := by
  have hN : ∀ a b : Fin d, AEStronglyMeasurable
      (fun omega => aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) a b) (chaosSampleLaw M).toMeasure :=
    fun a b => aux_lem_band_U2_unit_neumann_meas I M H hH K _
  have hD : ∀ a b : Fin d, AEStronglyMeasurable
      (fun omega => aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) a b) (chaosSampleLaw M).toMeasure :=
    fun a b => aux_lem_band_U2_unit_dirichlet_meas I M H hH K _
  have e1 : (fun omega => aux_lem_band_U2_sigStarInvF i j (aux_lem_band_U2_unitChart I M H omega K)) =
      fun omega => if i = j then (1 / 2 : ℝ) * aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) i i
        else aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) i j -
          (1 / 4 : ℝ) * aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) i i -
          (1 / 4 : ℝ) * aux_lem_band_U2_JN (aux_lem_band_U2_unitChart I M H omega K) j j := by
    funext omega; exact aux_lem_band_U2_sigStarInvF_eq_resp _ i j
  have e2 : (fun omega => aux_lem_band_U2_sigF i j (aux_lem_band_U2_unitChart I M H omega K)) =
      fun omega => if i = j then (1 / 2 : ℝ) * aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) i i
        else aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) i j -
          (1 / 4 : ℝ) * aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) i i -
          (1 / 4 : ℝ) * aux_lem_band_U2_JD (aux_lem_band_U2_unitChart I M H omega K) j j := by
    funext omega
    exact aux_lem_band_U2_sigF_eq_resp _ (aux_lem_band_U2_chart_symm I 0 1 one_pos _) i j
  rw [e1, e2]
  by_cases hij : i = j
  · simp only [if_pos hij]
    exact ⟨(hN i i).const_mul _, (hD i i).const_mul _⟩
  · simp only [if_neg hij]
    exact ⟨((hN i j).sub ((hN i i).const_mul _)).sub ((hN j j).const_mul _),
      ((hD i j).sub ((hD i i).const_mul _)).sub ((hD j j).const_mul _)⟩

theorem aux_lem_band_U2_band_arith_int (w1 W w' h k : ℕ) (h1 : w1 ≤ W) (h2 : 2 * W + 1 ≤ w') (hk : k ≤ h) :
