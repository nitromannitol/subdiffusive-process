        simp
      rw [hzero']
      exact zero_le _
  ·                            
    refine ⟨0, aestronglyMeasurable_const, ?_⟩
    have hDT3le : ∀ omega'' : SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d,
        aux_lem_band_DT3 s k z omega'' ≤ ENNReal.ofReal ((3 : ℝ) ^ (-(s / 8) * (k : ℝ))) *
          ENNReal.ofReal (aux_prefix_bank_maxObs 0 k z omega'') := by
      intro omega''
      unfold aux_lem_band_DT3
      gcongr
      refine sSup_le ?_
      rintro w ⟨x, hx, rfl⟩
      refine ENNReal.ofReal_le_ofReal ?_
      have hb := aux_prefix_bank_le_maxObs 0 k (Nat.zero_le k) z x omega'' hx
      simp only [pow_zero, one_mul] at hb
