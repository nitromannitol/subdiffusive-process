    have h_bound : M.delta ^ 2 * |Real.log M.delta| ≤ delta0_shrink ^ 2 * |Real.log delta0_shrink| :=
      aux_lem_band_assembly_x2log_mono M.delta delta0_shrink hMdelta_pos hMdelta_le_shrink
