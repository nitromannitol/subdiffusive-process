      ⨆ K : ℕ, sSup {w : ENNReal | ∃ x ∈ translatedCube d (m + 1 + j) z,
        w = aux_lem_band_piece_product_trunc_TjA d m j omega x +
            aux_lem_band_piece_product_trunc_TjB d m j K z omega x} := by
    intro omega
    have htail (x : Vec d) :
        sSup {u : ENNReal | ∃ K : ℕ, u = aux_lem_band_piece_product_trunc_TjB d m j K z omega x} =
        ⨆ K : ℕ, aux_lem_band_piece_product_trunc_TjB d m j K z omega x := by
      apply le_antisymm
      · refine sSup_le ?_
        rintro u ⟨K, rfl⟩
        exact le_iSup (fun K => aux_lem_band_piece_product_trunc_TjB d m j K z omega x) K
