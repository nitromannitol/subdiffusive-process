      (∀ N, MemLp (Kcoerc N) (ENNReal.ofReal (12 * p)) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (Kcoerc N) (ENNReal.ofReal (12 * p)) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal Cb12) ∧
      (∀ N, MemLp (Kcoerc N) (ENNReal.ofReal (8 * p)) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (Kcoerc N) (ENNReal.ofReal (8 * p)) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal Cb8) ∧
      (∀ N, MemLp (Kcoerc N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (Kcoerc N) (ENNReal.ofReal (3 * p)) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal Cb3) ∧
      (∀ N, MemLp (Kcoerc N) (ENNReal.ofReal (2 * p)) (chaosSampleLaw M).toMeasure ∧
        eLpNorm (Kcoerc N) (ENNReal.ofReal (2 * p)) (chaosSampleLaw M).toMeasure ≤
          ENNReal.ofReal Cb2) := by
  refine ⟨fun N om => |K N om|, ?_, ?_, ?_, ?_, ?_⟩
  · intro N omega
    exact aux_rem_bank_coerc_abs hd
      (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
      (K N omega) (hK_pt N omega)
  · intro N
    exact aux_rem_bank_abs_moment (chaosSampleLaw M).toMeasure (K N) (ENNReal.ofReal (12 * p))
      Cb12 (hK12mem N) (hK12norm N)
  · intro N
    exact aux_rem_bank_abs_moment (chaosSampleLaw M).toMeasure (K N) (ENNReal.ofReal (8 * p))
      Cb8 (hK8mem N) (hK8norm N)
  · intro N
    exact aux_rem_bank_abs_moment (chaosSampleLaw M).toMeasure (K N) (ENNReal.ofReal (3 * p))
      Cb3 (hK3mem N) (hK3norm N)
  · intro N
    exact aux_rem_bank_abs_moment (chaosSampleLaw M).toMeasure (K N) (ENNReal.ofReal (2 * p))
      Cb2 (hK2mem N) (hK2norm N)

theorem aux_lem_band_rem_bank_uniform_neumann_coercive
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (P : Paper.in_poincare d hd E)
    (Sfi : SubdiffusiveProcess.Lane4.SobolevFoundationalInput d hd)
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (p : ℝ) (hp : 2 ≤ p)
    (rho : ℝ → ℝ) (hrho : ContDiff ℝ ∞ rho) (hrho0 : ∀ v : ℝ, 0 ≤ rho v)
    (hrhos : ∀ v : ℝ, v ∉ Set.Ioo (1 : ℝ) 2 → rho v = 0) (hrhoi : (∫ v, rho v) = 1)
    (pvec : Fin d → ℝ) (hpvec : (∑ i : Fin d, (pvec i) ^ 2) = 1)
    (hPn : ∃ K : ℝ≥0, ∀ w : meanZeroSobolevGraph (unitNeumannCube d),
      ‖(w : SobolevData (unitNeumannCube d)).1‖ ≤
        K * ‖subspaceGradient (meanZeroSobolevGraph (unitNeumannCube d)) w‖) :
    ∃ delta0 : ℝ, 0 < delta0 ∧ ∃ B9 Bsm : ℝ, 0 ≤ B9 ∧ 0 ≤ Bsm ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M), Rm.C ≤ Cresp →
      ∀ (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        let Pm : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
        let Qn : Opens (SpatialCoordinates d) := unitNeumannCube d
        let zn : SpatialCoordinates d := fun _ : Fin d => (1 / 2 : ℝ)
        let Sn : ResponseSpace Qn := meanZeroResponseSpace hPn
        let an : ℕ → BilateralField d → PositiveCoefficient Qn :=
            fun N omega => cutoffPositiveCoefficient M H omega N zn one_pos
        let Lp : Sn.space →L[ℝ] ℝ :=
            (affineNeumannLoad pvec).comp
              (subspaceGradient (meanZeroSobolevGraph Qn))
        let yn : ℕ → BilateralField d → ℝ :=
            fun N omega => inverseResponse Sn (an N omega) Lp
        ∃ Kcoerc : ℕ → BilateralField d → ℝ,
          (∀ N, ∀ omega, 0 ≤ Kcoerc N omega ∧
            (∀ v : meanZeroSobolevGraph Qn,
                cubeFractionalSqNorm hd zn 1 one_pos threeQuarterOrder v.val.1 ≤
                  Kcoerc N omega *
                    sobolevCoefficientForm (an N omega) v.val v.val)) ∧
          (∀ N, MemLp (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm ∧
                MemLp (yn N) (ENNReal.ofReal (12 * p)) Pm ∧
                MemLp (Kcoerc N) (ENNReal.ofReal (8 * p)) Pm ∧
                MemLp (yn N) (ENNReal.ofReal (8 * p)) Pm) ∧
          (∀ N, eLpNorm (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm +
                eLpNorm (yn N) (ENNReal.ofReal (12 * p)) Pm +
                eLpNorm (Kcoerc N) (ENNReal.ofReal (8 * p)) Pm +
                eLpNorm (yn N) (ENNReal.ofReal (8 * p)) Pm ≤
                  ENNReal.ofReal B9) ∧
          (∀ eps : ℝ, 0 < eps → eps < 1 / 8 → ∀ fL2 : DomainL2 Qn,
              ((fL2 : SpatialCoordinates d → ℝ)
                =ᵐ[volume.restrict (Qn : Set (SpatialCoordinates d))]
                faceBump rho pvec eps) →
              let ys : ℕ → BilateralField d → ℝ :=
                fun N omega => inverseResponse Sn (an N omega)
                  ((sobolevVolumeLoad fL2).comp Sn.space.subtypeL)
              ∀ N, MemLp (ys N) (ENNReal.ofReal (3 * p)) Pm ∧
                   MemLp (ys N) (ENNReal.ofReal (2 * p)) Pm ∧
                   eLpNorm (ys N) (ENNReal.ofReal (3 * p)) Pm +
                     eLpNorm (ys N) (ENNReal.ofReal (2 * p)) Pm ≤
                       ENNReal.ofReal Bsm) := by
  obtain ⟨delta0_coerc, hδcoerc_pos, Cbound_coerc, hCbound_coerc0, h_coerc_inner⟩ :=
    aux_lem_band_rb_uniform_coercivity d hd E P Sfi (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos le_rfl
  have h12p : (1 : ℝ) ≤ 12 * p := by linarith
  have h8p : (1 : ℝ) ≤ 8 * p := by linarith
  have h3p : (1 : ℝ) ≤ 3 * p := by linarith
  have h2p : (1 : ℝ) ≤ 2 * p := by linarith
  obtain ⟨Cy, hCy0, hCyb⟩ :=
    aux_rem_bank_unit_neumann_response_le_coerc d hd Sfi rho hrho hrho0 hrhos hrhoi pvec hpvec
  have hCb12 : 0 ≤ Cbound_coerc (12 * p) := hCbound_coerc0 _ h12p
  have hCb8 : 0 ≤ Cbound_coerc (8 * p) := hCbound_coerc0 _ h8p
  have hCb3 : 0 ≤ Cbound_coerc (3 * p) := hCbound_coerc0 _ h3p
  have hCb2 : 0 ≤ Cbound_coerc (2 * p) := hCbound_coerc0 _ h2p
  refine ⟨min (delta0_coerc (12 * p)) (min (delta0_coerc (8 * p))
      (min (delta0_coerc (3 * p)) (delta0_coerc (2 * p)))),
    lt_min (hδcoerc_pos _ h12p) (lt_min (hδcoerc_pos _ h8p)
      (lt_min (hδcoerc_pos _ h3p) (hδcoerc_pos _ h2p))),
    (Cbound_coerc (12 * p) + Cy * Cbound_coerc (12 * p)) +
      (Cbound_coerc (8 * p) + Cy * Cbound_coerc (8 * p)),
    Cy * Cbound_coerc (3 * p) + Cy * Cbound_coerc (2 * p),
    add_nonneg (add_nonneg hCb12 (mul_nonneg hCy0 hCb12)) (add_nonneg hCb8 (mul_nonneg hCy0 hCb8)),
    add_nonneg (mul_nonneg hCy0 hCb3) (mul_nonneg hCy0 hCb2), ?_⟩
  intro M Rm hRmC H hIC hδ Pm0 Qn zn Sn an Lp yn
  have hM12 : M.delta ≤ delta0_coerc (12 * p) := hδ.trans (min_le_left _ _)
  have hM8 : M.delta ≤ delta0_coerc (8 * p) :=
    hδ.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hM3 : M.delta ≤ delta0_coerc (3 * p) :=
    hδ.trans ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
  have hM2 : M.delta ≤ delta0_coerc (2 * p) :=
    hδ.trans ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
  obtain ⟨K, hK_pt, hK_mom⟩ := h_coerc_inner M Rm H hIC
  have hHmeas : Measurable H := hIC.1
  have hcoerc : ∀ N omega, ∀ v : meanZeroSobolevGraph (unitNeumannCube d),
      cubeFractionalSqNorm hd (fun _ : Fin d => (1 / 2 : ℝ)) 1 one_pos threeQuarterOrder
          (v : SobolevData (unitNeumannCube d)).1 ≤
        K N omega * sobolevCoefficientForm
          (cutoffPositiveCoefficient M H omega N (fun _ : Fin d => (1 / 2 : ℝ)) one_pos)
          (v : SobolevData (unitNeumannCube d)) (v : SobolevData (unitNeumannCube d)) := by
    intro N omega v
    exact ((hK_pt N omega).2 v).2
  obtain ⟨Kcoerc, hKcoerc_pt, hKabs12, hKabs8, hKabs3, hKabs2⟩ :=
    aux_lem_band_nc_kcoerc_bank d hd M H p K hcoerc
      (Cbound_coerc (12 * p)) (Cbound_coerc (8 * p)) (Cbound_coerc (3 * p)) (Cbound_coerc (2 * p))
      (fun N => (hK_mom (12 * p) h12p hM12 N).1) (fun N => (hK_mom (12 * p) h12p hM12 N).2)
      (fun N => (hK_mom (8 * p) h8p hM8 N).1) (fun N => (hK_mom (8 * p) h8p hM8 N).2)
      (fun N => (hK_mom (3 * p) h3p hM3 N).1) (fun N => (hK_mom (3 * p) h3p hM3 N).2)
      (fun N => (hK_mom (2 * p) h2p hM2 N).1) (fun N => (hK_mom (2 * p) h2p hM2 N).2)
  have hyn_meas : ∀ N, Measurable (yn N) := by
    intro N
    exact aux_rem_bank_response_moments_measurable_inverseResponse M H hHmeas N zn one_pos Sn Lp
  have hyn_as : ∀ N, AEStronglyMeasurable (yn N) Pm0 := fun N => (hyn_meas N).aestronglyMeasurable
  have hynb : ∀ N omega, yn N omega ≤ Kcoerc N omega * Cy := fun N omega =>
    (hCyb hPn (an N omega) (Kcoerc N omega) (hKcoerc_pt N omega).1
        (hKcoerc_pt N omega).2).1.trans (le_of_eq (mul_comm Cy (Kcoerc N omega)))
  have hyn12 := fun N => aux_rem_bank_response_moments_memLp_of_envelope Pm0 (yn N) (Kcoerc N)
    Cy (Cbound_coerc (12 * p)) hCy0 (ENNReal.ofReal (12 * p)) (hyn_as N) (hKabs12 N).1 (hKabs12 N).2
    (Filter.Eventually.of_forall (fun omega =>
      ⟨inverseResponse_nonneg Sn (an N omega) Lp, (hKcoerc_pt N omega).1, hynb N omega⟩))
  have hyn8 := fun N => aux_rem_bank_response_moments_memLp_of_envelope Pm0 (yn N) (Kcoerc N)
    Cy (Cbound_coerc (8 * p)) hCy0 (ENNReal.ofReal (8 * p)) (hyn_as N) (hKabs8 N).1 (hKabs8 N).2
    (Filter.Eventually.of_forall (fun omega =>
      ⟨inverseResponse_nonneg Sn (an N omega) Lp, (hKcoerc_pt N omega).1, hynb N omega⟩))
  refine ⟨Kcoerc, fun N omega => hKcoerc_pt N omega, fun N =>
    ⟨(hKabs12 N).1, (hyn12 N).1, (hKabs8 N).1, (hyn8 N).1⟩, fun N => ?_, ?_⟩
  · have h12' : eLpNorm (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm0 +
        eLpNorm (yn N) (ENNReal.ofReal (12 * p)) Pm0 ≤
        ENNReal.ofReal (Cbound_coerc (12 * p) + Cy * Cbound_coerc (12 * p)) :=
      (add_le_add (hKabs12 N).2 (hyn12 N).2).trans
        (le_of_eq (ENNReal.ofReal_add hCb12 (mul_nonneg hCy0 hCb12)).symm)
    have h8' : eLpNorm (Kcoerc N) (ENNReal.ofReal (8 * p)) Pm0 +
        eLpNorm (yn N) (ENNReal.ofReal (8 * p)) Pm0 ≤
        ENNReal.ofReal (Cbound_coerc (8 * p) + Cy * Cbound_coerc (8 * p)) :=
      (add_le_add (hKabs8 N).2 (hyn8 N).2).trans
        (le_of_eq (ENNReal.ofReal_add hCb8 (mul_nonneg hCy0 hCb8)).symm)
    calc eLpNorm (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm0 +
          eLpNorm (yn N) (ENNReal.ofReal (12 * p)) Pm0 +
          eLpNorm (Kcoerc N) (ENNReal.ofReal (8 * p)) Pm0 +
          eLpNorm (yn N) (ENNReal.ofReal (8 * p)) Pm0
        = (eLpNorm (Kcoerc N) (ENNReal.ofReal (12 * p)) Pm0 +
              eLpNorm (yn N) (ENNReal.ofReal (12 * p)) Pm0) +
            (eLpNorm (Kcoerc N) (ENNReal.ofReal (8 * p)) Pm0 +
              eLpNorm (yn N) (ENNReal.ofReal (8 * p)) Pm0) := by rw [add_assoc]
      _ ≤ ENNReal.ofReal (Cbound_coerc (12 * p) + Cy * Cbound_coerc (12 * p)) +
            ENNReal.ofReal (Cbound_coerc (8 * p) + Cy * Cbound_coerc (8 * p)) :=
          add_le_add h12' h8'
      _ = ENNReal.ofReal ((Cbound_coerc (12 * p) + Cy * Cbound_coerc (12 * p)) +
            (Cbound_coerc (8 * p) + Cy * Cbound_coerc (8 * p))) :=
          (ENNReal.ofReal_add (add_nonneg hCb12 (mul_nonneg hCy0 hCb12))
            (add_nonneg hCb8 (mul_nonneg hCy0 hCb8))).symm
  · intro eps heps heps8 fL2 hfL2 ys N
    have hysb : ∀ omega, ys N omega ≤ Kcoerc N omega * Cy := by
      intro omega
      exact ((hCyb hPn (an N omega) (Kcoerc N omega) (hKcoerc_pt N omega).1
          (hKcoerc_pt N omega).2).2 eps heps heps8 fL2 hfL2).trans
        (le_of_eq (mul_comm Cy (Kcoerc N omega)))
    have hys_as : AEStronglyMeasurable (ys N) Pm0 :=
      (aux_rem_bank_response_moments_measurable_inverseResponse M H hHmeas N zn one_pos Sn
        ((sobolevVolumeLoad fL2).comp Sn.space.subtypeL)).aestronglyMeasurable
    have hys3 := aux_rem_bank_response_moments_memLp_of_envelope Pm0 (ys N) (Kcoerc N) Cy
      (Cbound_coerc (3 * p))
      hCy0 (ENNReal.ofReal (3 * p)) hys_as (hKabs3 N).1 (hKabs3 N).2
      (Filter.Eventually.of_forall (fun omega =>
        ⟨inverseResponse_nonneg Sn (an N omega) ((sobolevVolumeLoad fL2).comp Sn.space.subtypeL),
          (hKcoerc_pt N omega).1, hysb omega⟩))
    have hys2 := aux_rem_bank_response_moments_memLp_of_envelope Pm0 (ys N) (Kcoerc N) Cy
      (Cbound_coerc (2 * p))
      hCy0 (ENNReal.ofReal (2 * p)) hys_as (hKabs2 N).1 (hKabs2 N).2
      (Filter.Eventually.of_forall (fun omega =>
        ⟨inverseResponse_nonneg Sn (an N omega) ((sobolevVolumeLoad fL2).comp Sn.space.subtypeL),
          (hKcoerc_pt N omega).1, hysb omega⟩))
    exact ⟨hys3.1, hys2.1, (add_le_add hys3.2 hys2.2).trans
      (le_of_eq (ENNReal.ofReal_add (mul_nonneg hCy0 hCb3) (mul_nonneg hCy0 hCb2)).symm)⟩

theorem aux_lem_band_le1_assemble {Ω : Type} [MeasurableSpace Ω]
    (mu : Measure Ω) [IsProbabilityMeasure mu]
    (RD RK KD KK : ℕ → Ω → ℝ) (cD cK BD BK : ℝ) (hcD : 0 ≤ cD) (hcK : 0 ≤ cK)
    (hBD : 0 ≤ BD) (hBK : 0 ≤ BK) (e1 e2 p' : ℝ≥0∞) (h1 : e1 ≤ p') (h2 : e2 ≤ p')
    (hmD : ∀ N, AEStronglyMeasurable (RD N) mu) (hmK : ∀ N, AEStronglyMeasurable (RK N) mu)
    (hKDmem : ∀ N, MemLp (KD N) p' mu) (hKKmem : ∀ N, MemLp (KK N) p' mu)
    (hKDn : ∀ N, eLpNorm (KD N) p' mu ≤ ENNReal.ofReal BD)
    (hKKn : ∀ N, eLpNorm (KK N) p' mu ≤ ENNReal.ofReal BK)
    (haeD : ∀ N, ∀ᵐ x ∂mu, 0 ≤ RD N x ∧ 0 ≤ KD N x ∧ RD N x ≤ KD N x * cD)
    (haeK : ∀ N, ∀ᵐ x ∂mu, 0 ≤ RK N x ∧ 0 ≤ KK N x ∧ RK N x ≤ KK N x * cK) :
    ∀ N : ℕ,
      MemLp (RD N) e1 mu ∧ MemLp (RK N) e1 mu ∧ MemLp (RD N) e2 mu ∧ MemLp (RK N) e2 mu ∧
      eLpNorm (RD N) e1 mu + eLpNorm (RK N) e1 mu + eLpNorm (RD N) e2 mu +
        eLpNorm (RK N) e2 mu ≤ ENNReal.ofReal (cD * BD + cK * BK + cD * BD + cK * BK) := by
  intro N
  obtain ⟨m1, b1⟩ := aux_rem_bank_response_moments_envelope_lower mu (RD N) (KD N) cD BD hcD
    e1 p' h1 (hmD N) (hKDmem N) (hKDn N) (haeD N)
  obtain ⟨m2, b2⟩ := aux_rem_bank_response_moments_envelope_lower mu (RK N) (KK N) cK BK hcK
    e1 p' h1 (hmK N) (hKKmem N) (hKKn N) (haeK N)
  obtain ⟨m3, b3⟩ := aux_rem_bank_response_moments_envelope_lower mu (RD N) (KD N) cD BD hcD
    e2 p' h2 (hmD N) (hKDmem N) (hKDn N) (haeD N)
  obtain ⟨m4, b4⟩ := aux_rem_bank_response_moments_envelope_lower mu (RK N) (KK N) cK BK hcK
    e2 p' h2 (hmK N) (hKKmem N) (hKKn N) (haeK N)
  refine ⟨m1, m2, m3, m4, ?_⟩
  calc eLpNorm (RD N) e1 mu + eLpNorm (RK N) e1 mu + eLpNorm (RD N) e2 mu +
        eLpNorm (RK N) e2 mu
      ≤ ENNReal.ofReal (cD * BD) + ENNReal.ofReal (cK * BK) +
        ENNReal.ofReal (cD * BD) + ENNReal.ofReal (cK * BK) := by gcongr
    _ = ENNReal.ofReal (cD * BD + cK * BK + cD * BD + cK * BK) := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]

theorem aux_lem_band_rem_bank_uniform_response_moments_le1
    (d : ℕ) (hd : 2 ≤ d)
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (E : Paper.in_J d) (P : Paper.in_poincare d hd E) (X : Paper.in_extension d hd E)
    (W : SubdiffusiveProcess.Lane4.SmallPerturbationInput d)
    (t : ℝ) (ht0 : (d : ℝ) - 1 < t) (ht1 : t < (d : ℝ))
    (Cresp : ℝ) (hCresp : 0 < Cresp)
    (p : ℝ) (hp : 2 ≤ p)
    (z : SpatialCoordinates d) (r : ℝ) (hr : 0 < r) (hr1 : r ≤ 1)
    (hP : ∃ K : ℝ≥0, ∀ w : killedSobolevGraph (centeredCube z r hr),
      ‖(w : SobolevData (centeredCube z r hr)).1‖ ≤
        K * ‖subspaceGradient (killedSobolevGraph (centeredCube z r hr)) w‖)
    (phi : SpatialCoordinates d → ℝ) (hphi : ContDiff ℝ ∞ phi)
    (b : weakSobolevGraph (centeredCube z r hr))
    (hb : b.val.1 =ᵐ[volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d))] phi)
    (f : SpatialCoordinates d → ℝ) (hf : ContDiff ℝ ∞ f) (hfc : HasCompactSupport f)
    (hfsub : tsupport f ⊆ (centeredCube z r hr : Set (SpatialCoordinates d)))
    (fL2 : DomainL2 (centeredCube z r hr))
    (hfL2 : (fL2 : SpatialCoordinates d → ℝ) =ᵐ[
      volume.restrict (centeredCube z r hr : Set (SpatialCoordinates d))] f) :
    ∃ delta0 : ℝ, 0 < delta0 ∧ ∃ Bresp : ℝ, 0 ≤ Bresp ∧
      ∀ (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (Rm : in_responses d M), Rm.C ≤ Cresp →
      ∀ (Sreg : in_6_16 d M) (It : in_iteration d M E Sreg)
        (H : BilateralField d → C(SpatialCoordinates d, ℝ)),
        InfraredCharacterization M H → M.delta ≤ delta0 →
        let Pm : Measure (BilateralField d) := (chaosSampleLaw M).toMeasure
        ∀ N : ℕ,
          MemLp
            (fun omega : BilateralField d =>
              dirichletResponse (killedResponseSpace hP)
                (cutoffPositiveCoefficient M H omega N z hr) b)
            (ENNReal.ofReal (3 * p)) Pm ∧
          MemLp
            (fun omega : BilateralField d =>
              inverseResponse (killedResponseSpace hP)
                (cutoffPositiveCoefficient M H omega N z hr)
                ((sobolevVolumeLoad fL2).comp (killedResponseSpace hP).space.subtypeL))
            (ENNReal.ofReal (3 * p)) Pm ∧
          MemLp
            (fun omega : BilateralField d =>
              dirichletResponse (killedResponseSpace hP)
                (cutoffPositiveCoefficient M H omega N z hr) b)
            (ENNReal.ofReal (2 * p)) Pm ∧
          MemLp
            (fun omega : BilateralField d =>
              inverseResponse (killedResponseSpace hP)
                (cutoffPositiveCoefficient M H omega N z hr)
                ((sobolevVolumeLoad fL2).comp (killedResponseSpace hP).space.subtypeL))
            (ENNReal.ofReal (2 * p)) Pm ∧
          eLpNorm
              (fun omega : BilateralField d =>
                dirichletResponse (killedResponseSpace hP)
                  (cutoffPositiveCoefficient M H omega N z hr) b)
              (ENNReal.ofReal (3 * p)) Pm +
            eLpNorm
              (fun omega : BilateralField d =>
                inverseResponse (killedResponseSpace hP)
                  (cutoffPositiveCoefficient M H omega N z hr)
                  ((sobolevVolumeLoad fL2).comp (killedResponseSpace hP).space.subtypeL))
              (ENNReal.ofReal (3 * p)) Pm +
            eLpNorm
              (fun omega : BilateralField d =>
                dirichletResponse (killedResponseSpace hP)
                  (cutoffPositiveCoefficient M H omega N z hr) b)
              (ENNReal.ofReal (2 * p)) Pm +
            eLpNorm
              (fun omega : BilateralField d =>
                inverseResponse (killedResponseSpace hP)
                  (cutoffPositiveCoefficient M H omega N z hr)
                  ((sobolevVolumeLoad fL2).comp (killedResponseSpace hP).space.subtypeL))
              (ENNReal.ofReal (2 * p)) Pm ≤ ENNReal.ofReal Bresp := by
  have hp1 : (1 : ℝ) ≤ max (3 * p) (2 * p) := le_trans (by linarith) (le_max_left _ _)
