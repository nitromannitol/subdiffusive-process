      (min (1 : ENNReal) ((Praw N m w omega - ENNReal.ofReal 6) / ENNReal.ofReal (12 - 6))).toReal -
        (min (1 : ENNReal) ((Pcand' omega - ENNReal.ofReal 6) / ENNReal.ofReal (12 - 6))).toReal)
