theorem aux_lem_band_U2_cell_of_unit {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (m : ℤ) (w : SpatialCoordinates d)
    (Xc Zu rf : BilateralField d → ℝ)
    (hid : ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure, Xc omega = rf omega * Zu (aux_lem_band_U2_shift m w omega))
    (z0 q : ℝ) (hq : 1 ≤ q) (B1 D1 D2 ε1 ε2 : ℝ) (hB1 : 0 ≤ B1) (hD1 : 0 ≤ D1) (hD2 : 0 ≤ D2)
    (hε1 : 0 ≤ ε1) (hε2 : 0 ≤ ε2)
    (hrfm : AEStronglyMeasurable rf (chaosSampleLaw M).toMeasure)
    (hZum : AEStronglyMeasurable Zu (chaosSampleLaw M).toMeasure)
    (hrfb : eLpNorm rf (ENNReal.ofReal (2 * q)) (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal B1)
    (hrf1 : eLpNorm (fun o => rf o - 1) (ENNReal.ofReal (2 * q)) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal D1)
    (hZu1 : eLpNorm (fun o => Zu o - z0) (ENNReal.ofReal (2 * q)) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal D2)
    (lo hi lo1 hi1 lo2 hi2 : ℤ) (h1 : lo ≤ lo1) (h2 : hi1 ≤ hi) (h3 : lo ≤ lo2 - m)
    (h4 : hi2 - m ≤ hi)
    (hrfB : aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure lo1 hi1 (2 * q) (fun o => rf o - 1) ε1)
    (hZuB : aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure lo2 hi2 (2 * q) (fun o => Zu o - z0) ε2) :
    AEStronglyMeasurable Xc (chaosSampleLaw M).toMeasure ∧
    eLpNorm (fun o => Xc o - z0) (ENNReal.ofReal q) (chaosSampleLaw M).toMeasure ≤
      ENNReal.ofReal (|z0| * D1 + B1 * D2) ∧
    aux_lem_band_U2_BandApprox (chaosSampleLaw M).toMeasure lo hi q (fun o => Xc o - z0)
      (|z0| * ε1 + B1 * ε2 + ε1 * (D2 + ε2)) := by
  have hmp := aux_lem_band_U2_T1_shift_measurePreserving M m w
  have hZm : AEStronglyMeasurable (fun o => Zu (aux_lem_band_U2_shift m w o)) (chaosSampleLaw M).toMeasure :=
    hZum.comp_measurePreserving hmp
  have hZ1 : eLpNorm (fun o => Zu (aux_lem_band_U2_shift m w o) - z0) (ENNReal.ofReal (2 * q))
      (chaosSampleLaw M).toMeasure ≤ ENNReal.ofReal D2 := by
    rw [aux_lem_band_U2_eLpNorm_comp_shift M m w (fun o => Zu o - z0)]; exact hZu1
  obtain ⟨hmom, hband⟩ := aux_lem_band_U2_prod (chaosSampleLaw M).toMeasure (aux_lem_band_U2_band d lo hi)
    (aux_lem_band_U2_band_le_ambient lo hi) rf (fun o => Zu (aux_lem_band_U2_shift m w o)) hrfm hZm z0 q hq
    B1 D1 D2 ε1 ε2 hB1 hD1 hD2 hε1 hε2 hrfb hrf1 hZ1
  have hXc : Xc =ᵐ[(chaosSampleLaw M).toMeasure] fun o => rf o * Zu (aux_lem_band_U2_shift m w o) := hid
  have hXc' : (fun o => rf o * Zu (aux_lem_band_U2_shift m w o) - z0) =ᵐ[(chaosSampleLaw M).toMeasure]
      fun o => Xc o - z0 := by
    filter_upwards [hid] with o ho
    rw [ho]
  refine ⟨(hrfm.mul hZm).congr hXc.symm, ?_, ?_⟩
  · rw [← eLpNorm_congr_ae hXc']; exact hmom
  · refine aux_lem_band_U2_BA_congr_ae hXc' ?_
    have hY1 := aux_lem_band_U2_BA_band_mono h1 h2 hrfB
    have hY2 := aux_lem_band_U2_BA_band_mono h3 h4 (aux_lem_band_U2_BA_shift M m w hZuB)
    obtain ⟨Y1, hY1m, hY1b⟩ := hY1
    obtain ⟨Y2, hY2m, hY2b⟩ := hY2
    exact hband ⟨Y1, hY1m, hY1b⟩ ⟨Y2, hY2m, hY2b⟩

theorem aux_lem_band_U2_cell_identity {d : ℕ}
    [MeasurableSpace C(SpatialCoordinates d, ℝ)] [BorelSpace C(SpatialCoordinates d, ℝ)]
    (I : Paper.in_J d) (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d)
    (H : BilateralField d → C(SpatialCoordinates d, ℝ)) (hH : InfraredCharacterization M H)
    (K k : ℕ) (hk : k ≤ K) (R : Homogenization.TriadicCube d) (hR : R ∈ aux_lem_band_U2_D (d := d) k) :
    ∀ᵐ omega ∂(chaosSampleLaw M).toMeasure,
      Homogenization.Book.Ch02.sigmaStarInvCoarse (Homogenization.Book.Ch02.cubeDomain R)
          ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) =
        (aux_lem_band_U2_reference M H K (k : ℤ) (Homogenization.cubeCenter R) omega)⁻¹ •
          Homogenization.Book.Ch02.sigmaStarInvCoarse
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            ((aux_lem_band_U2_unitChart I M H (aux_lem_band_U2_shift (k : ℤ) (Homogenization.cubeCenter R) omega)
              ((K : ℤ) - (k : ℤ)).toNat).coeffOn (Homogenization.originCube d 0)) ∧
      Homogenization.Book.Ch02.sigmaCoarse (Homogenization.Book.Ch02.cubeDomain R)
          ((aux_lem_band_U2_unitChart I M H omega K).coeffOn R) =
        (aux_lem_band_U2_reference M H K (k : ℤ) (Homogenization.cubeCenter R) omega) •
          Homogenization.Book.Ch02.sigmaCoarse
            (Homogenization.Book.Ch02.cubeDomain (Homogenization.originCube d 0))
            ((aux_lem_band_U2_unitChart I M H (aux_lem_band_U2_shift (k : ℤ) (Homogenization.cubeCenter R) omega)
              ((K : ℤ) - (k : ℤ)).toNat).coeffOn (Homogenization.originCube d 0)) := by
  have hpos : 0 < (3 : ℝ) ^ (-(k : ℤ)) := by positivity
  have hT4 := aux_lem_band_U2_T4_chart_identity I M H hH K (k : ℤ) (by exact_mod_cast hk)
    (Homogenization.cubeCenter R) hpos
  have hR' : R ∈ Homogenization.descendantsAtScale (Homogenization.originCube d 0) (-(k : ℤ)) := by
    have : (Homogenization.originCube d 0).scale - (k : ℤ) = -(k : ℤ) := by
      simp [Homogenization.originCube]
    have hR2 := hR
    unfold aux_lem_band_U2_D at hR2
    rwa [this] at hR2
  filter_upwards [hT4] with omega homega
  have hcore := aux_rechart_actual_descendant_core I M H omega K k 0 1 one_pos R hR'
    (Homogenization.cubeCenter R) ((3 : ℝ) ^ (-(k : ℤ))) hpos (by funext i; simp) (one_mul _).symm
