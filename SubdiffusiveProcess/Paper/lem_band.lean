      (fun x => (aux_lem_band_piece_product_trunc_Afac_meas d m j x).add
        (aux_lem_band_piece_product_trunc_TjB_meas d m j K z x))
  have heq2 : ∀ omega : PotentialSample d,
      sSup {w : ENNReal | ∃ x ∈ translatedCube d (m + 1 + j) z,
