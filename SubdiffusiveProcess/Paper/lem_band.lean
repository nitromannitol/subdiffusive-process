theorem aux_lem_band_U2_CellOK_mono {d : ℕ} [MeasurableSpace C(SpatialCoordinates d, ℝ)]
    {P : Measure (BilateralField d)} {w1 w2 : ℕ} {a1 a2 c1 c2 C1 C2 γ δ q : ℝ} {k : ℕ}
    {X : BilateralField d → ℝ} {x0 : ℝ}
    (hw : w1 ≤ w2) (ha : a2 ≤ a1) (hc : c2 ≤ c1) (hC : C1 ≤ C2) (hδ0 : 0 < δ) (hδ1 : δ ≤ 1)
    (hC1 : 0 ≤ C1) (h : aux_lem_band_U2_CellOK P w1 a1 c1 C1 γ δ q k X x0) :
    aux_lem_band_U2_CellOK P w2 a2 c2 C2 γ δ q k X x0 := by
  obtain ⟨hm, hmom, hband⟩ := h
  have hδc : δ ^ c1 ≤ δ ^ c2 := Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 hc
  have hδc0 : 0 ≤ δ ^ c1 := Real.rpow_nonneg hδ0.le _
  have hg : 0 ≤ (3 : ℝ) ^ (γ * (k : ℝ)) := Real.rpow_nonneg (by norm_num) _
  have hCδ : C1 * δ ^ c1 ≤ C2 * δ ^ c2 := mul_le_mul hC hδc hδc0 (hC1.trans hC)
  refine ⟨hm, hmom.trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hCδ hg)), ?_⟩
  intro h hkh
  have hw' : ((w1 * (h + 1) : ℕ) : ℤ) ≤ ((w2 * (h + 1) : ℕ) : ℤ) := by
    exact_mod_cast Nat.mul_le_mul_right _ hw
  refine aux_lem_band_U2_BA_band_mono (by omega) hw' (aux_lem_band_U2_BA_mono ?_ (hband h hkh))
  have h3 : (3 : ℝ) ^ (-(a1 * (h : ℝ))) ≤ (3 : ℝ) ^ (-(a2 * (h : ℝ))) :=
    aux_lem_band_U2_rpow_mono_exp (by have : (0 : ℝ) ≤ h := Nat.cast_nonneg h; nlinarith)
  have h30 : 0 ≤ (3 : ℝ) ^ (-(a1 * (h : ℝ))) := Real.rpow_nonneg (by norm_num) _
  calc C1 * δ ^ c1 * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(a1 * (h : ℝ)))
      ≤ C2 * δ ^ c2 * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(a1 * (h : ℝ))) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hCδ hg) h30
    _ ≤ C2 * δ ^ c2 * (3 : ℝ) ^ (γ * (k : ℝ)) * (3 : ℝ) ^ (-(a2 * (h : ℝ))) := by
        have : 0 ≤ C2 * δ ^ c2 * (3 : ℝ) ^ (γ * (k : ℝ)) :=
          mul_nonneg (mul_nonneg (hC1.trans hC) (Real.rpow_nonneg hδ0.le _)) hg
        exact mul_le_mul_of_nonneg_left h3 this

theorem aux_lem_band_U2_band_arith (w1 W w' h k : ℕ) (h1 : w1 ≤ W) (h2 : 2 * W + 1 ≤ w') (hk : k ≤ h) :
    w1 * (h + 1 + 1) + k ≤ w' * (h + 1) ∧ h + 1 ≤ w' * (h + 1) := by
  have e1 : w1 * (h + 1 + 1) ≤ W * (h + 1 + 1) := Nat.mul_le_mul_right _ h1
  have e2 : (2 * W + 1) * (h + 1) ≤ w' * (h + 1) := Nat.mul_le_mul_right _ h2
