import SubdiffusiveProcess.Sobolev.ReflectionEnergy
import SubdiffusiveProcess.Geometry.ReflectionSlopes

/-! # Reflection of the actual affine variational objectives

The Dirichlet formula uses a killed variation and its gradient, so the
constant generated by an off-origin reflection of an affine function never
needs to be treated as a killed function. Both formulas here are literal
integrals on the two domains, with their actual pulled-back coefficients.
-/
open MeasureTheory Filter Set TopologicalSpace
open scoped ENNReal NNReal
noncomputable section
namespace SubdiffusiveProcess
variable {d : ℕ} {U Ω : Opens (SpatialCoordinates d)}

/-- The pulled-back coordinate gradient is the signed composed gradient almost everywhere. -/
theorem reflectionSobolevData_gradient_coeFn (z : SpatialCoordinates d)
    (I : Finset (Fin d))
    (hU : coordinateReflection z I ⁻¹' (Ω : Set (SpatialCoordinates d)) = U)
    (u : SobolevData Ω) (i : Fin d) :
    ((reflectionSobolevData z I hU u).2 i : SpatialCoordinates d → ℝ)
      =ᵐ[volume.restrict (U : Set (SpatialCoordinates d))]
      fun x => coordinateReflectionSign I i * u.2 i (coordinateReflection z I x) := by
  filter_upwards [Lp.coeFn_smul (coordinateReflectionSign I i)
    (reflectionLp z I hU (u.2 i)), reflectionLp_coeFn z I hU (u.2 i)] with x hs hu
  change (coordinateReflectionSign I i • reflectionLp z I hU (u.2 i)) x = _
  rw [hs]
  simp only [Pi.smul_apply, smul_eq_mul, hu, Function.comp_apply]

/-- Reflecting both the slope and variation preserves the affine Dirichlet objective. -/
theorem affineDirichletObjective_reflection (z : SpatialCoordinates d)
    (I : Finset (Fin d))
    (hU : coordinateReflection z I ⁻¹' (Ω : Set (SpatialCoordinates d)) = U)
    (a : PositiveCoefficient Ω) (p : Fin d → ℝ) (u : SobolevData Ω) :
    (∑ i : Fin d, ∫ x in (U : Set (SpatialCoordinates d)),
      (reflectionCoefficient z I hU a).val x *
        (coordinateReflectionDerivative I p i + (reflectionSobolevData z I hU u).2 i x)^2) =
    ∑ i : Fin d, ∫ x in (Ω : Set (SpatialCoordinates d)),
      a.val x * (p i + u.2 i x)^2 := by
  apply Finset.sum_congr rfl
  intro i _
  calc
    _ = ∫ x in (U : Set (SpatialCoordinates d)),
        a.val (coordinateReflection z I x) *
          (p i + u.2 i (coordinateReflection z I x))^2 := by
      apply integral_congr_ae
      filter_upwards [reflectionCoefficient_coeFn z I hU a,
        reflectionSobolevData_gradient_coeFn z I hU u i] with x ha hu
      rw [ha, hu, coordinateReflectionDerivative_apply, ← mul_add, mul_pow,
        coordinateReflectionSign_sq, one_mul, Function.comp_apply]
    _ = _ := (coordinateReflection_domain_measurePreserving z I hU).integral_comp
      (coordinateReflectionEquiv z I).toHomeomorph.measurableEmbedding
      (fun y => a.val y * (p i + u.2 i y)^2)

/-- The volume load is unchanged when both its slope and the Sobolev data are reflected. -/
theorem affineNeumannLoad_integral_reflection (z : SpatialCoordinates d)
    (I : Finset (Fin d))
    (hU : coordinateReflection z I ⁻¹' (Ω : Set (SpatialCoordinates d)) = U)
    (p : Fin d → ℝ) (u : SobolevData Ω) :
    (∑ i : Fin d, ∫ x in (U : Set (SpatialCoordinates d)),
      coordinateReflectionDerivative I p i * (reflectionSobolevData z I hU u).2 i x) =
    ∑ i : Fin d, ∫ x in (Ω : Set (SpatialCoordinates d)), p i * u.2 i x := by
  apply Finset.sum_congr rfl
  intro i _
  calc
    _ = ∫ x in (U : Set (SpatialCoordinates d)), p i * u.2 i (coordinateReflection z I x) := by
      apply integral_congr_ae
      filter_upwards [reflectionSobolevData_gradient_coeFn z I hU u i] with x hu
      rw [hu, coordinateReflectionDerivative_apply]
      calc
        _ = coordinateReflectionSign I i ^ 2 * (p i * u.2 i (coordinateReflection z I x)) := by ring
        _ = _ := by rw [coordinateReflectionSign_sq, one_mul]
    _ = _ := (coordinateReflection_domain_measurePreserving z I hU).integral_comp
      (coordinateReflectionEquiv z I).toHomeomorph.measurableEmbedding
      (fun y => p i * u.2 i y)

/-- The literal inverse-Neumann objective is invariant under simultaneous reflection. -/
theorem affineInverseNeumannObjective_reflection (z : SpatialCoordinates d)
    (I : Finset (Fin d))
    (hU : coordinateReflection z I ⁻¹' (Ω : Set (SpatialCoordinates d)) = U)
    (a : PositiveCoefficient Ω) (p : Fin d → ℝ) (u : SobolevData Ω) :
    (2 * (∑ i : Fin d, ∫ x in (U : Set (SpatialCoordinates d)),
        coordinateReflectionDerivative I p i * (reflectionSobolevData z I hU u).2 i x) -
      ∑ i : Fin d, ∫ x in (U : Set (SpatialCoordinates d)),
        (reflectionCoefficient z I hU a).val x *
          ((reflectionSobolevData z I hU u).2 i x * (reflectionSobolevData z I hU u).2 i x)) =
    2 * (∑ i : Fin d, ∫ x in (Ω : Set (SpatialCoordinates d)), p i * u.2 i x) -
      ∑ i : Fin d, ∫ x in (Ω : Set (SpatialCoordinates d)), a.val x * (u.2 i x * u.2 i x) := by
  rw [affineNeumannLoad_integral_reflection,
    ← sobolevCoefficientForm_apply, sobolevCoefficientForm_reflection, sobolevCoefficientForm_apply]

end SubdiffusiveProcess
