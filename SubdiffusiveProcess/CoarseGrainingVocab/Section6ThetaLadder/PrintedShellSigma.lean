import SubdiffusiveProcess.CoarseGrainingVocab.Section6ThetaLadder.TranslatedStoppingEvent
import SubdiffusiveProcess.CoarseGrainingVocab.NegativeBesovSupport
import SubdiffusiveProcess.CoarseGrainingVocab.Section6BoundedMultiplier.SubunitGeometry

/-!
# Theta ladder: honest sigma-field of the printed stopping event

The literal `GoodFieldOne` and `GoodFieldTwo` predicates quantify over every
auxiliary depth.  Their observation cubes therefore exhaust physical space.
Moreover the `GoodFieldTwo` product and the gradient term in
`accumulatedError` contain infinite shell suffixes.  Consequently the printed
stopping event is not local to any fixed enlargement of the parent cube and
does not stop at the cutoff shell `L`: its honest carrier is the sigma-field
generated by every complete shell field.
-/

namespace SubdiffusiveProcess.CoarseGrainingVocab.Section6ThetaLadder

open MeasureTheory SubdiffusiveProcess.CoarseGrainingVocab
open SubdiffusiveProcess.CoarseGrainingVocab.Section6BoundedMultiplier

noncomputable section

private abbrev Sample (d : ℕ) :=
  SubdiffusiveProcess.Frozen.Assumptions.PotentialSample d

/-- Spatial observation window forced by the unbounded auxiliary-depth
quantifier in `GoodFieldOne` and `GoodFieldTwo`. -/
def thetaLadderPrintedWindow (d _m : ℕ) (_z : Vec d) : Set (Vec d) :=
  Set.univ

/-- Shell range forced by the infinite suffixes in `GoodFieldTwo` and
`accumulatedError`. -/
def thetaLadderPrintedShellIndices : Set ℕ := Set.univ

/-- The honest sigma-field of the printed theta-ladder stopping route: every
complete shell coordinate is observed. -/
def thetaLadderPrintedShellSigma (d : ℕ) : MeasurableSpace (Sample d) :=
  potentialShellIndexSigma thetaLadderPrintedShellIndices

/-- The printed window is genuinely unbounded; it is not an `m+1` or `m+2`
enlargement. -/
theorem thetaLadderPrintedWindow_eq_univ (d m : ℕ) (z : Vec d) :
    thetaLadderPrintedWindow d m z = Set.univ := rfl

/-- The observation cubes occurring in either printed field predicate exhaust
space as the auxiliary depth grows. -/
theorem iUnion_goodField_observationCubes_eq_univ
    (d m : ℕ) (y : Vec d) :
    (⋃ j : ℕ, translatedCube d ((m + 1 + j : ℕ) : ℤ) y) = Set.univ := by
  rw [Set.eq_univ_iff_forall]
  intro x
  rw [Set.mem_iUnion]
  obtain ⟨j, hj⟩ := pow_unbounded_of_one_lt
    (2 * dist x y) (by norm_num : (1 : ℝ) < 3)
  refine ⟨j, ?_⟩
  rw [translatedCube_eq_metricBall, Metric.mem_ball, zpow_natCast]
  have hmono : (3 : ℝ) ^ j ≤ (3 : ℝ) ^ (m + 1 + j) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  nlinarith

/-- Every shell above the cutoff remains in the printed observation range. -/
theorem cutoff_succ_mem_thetaLadderPrintedShellIndices (L : ℕ) :
    L + 1 ∈ thetaLadderPrintedShellIndices := Set.mem_univ _

/-- On the sequence carrier, observing every complete shell coordinate is
exactly the ambient product sigma-field. -/
theorem thetaLadderPrintedShellSigma_eq_ambient (d : ℕ) :
    thetaLadderPrintedShellSigma d =
      (inferInstance : MeasurableSpace (Sample d)) := by
  unfold thetaLadderPrintedShellSigma thetaLadderPrintedShellIndices
  apply le_antisymm
  · exact potentialShellIndexSigma_le_borel Set.univ
  · change (⨆ k : ℕ, MeasurableSpace.comap
        (fun omega : Sample d ↦ omega k) inferInstance) ≤
      potentialShellIndexSigma Set.univ
    refine iSup_le fun k ↦ ?_
    exact le_iSup_of_le k (le_iSup_of_le (Set.mem_univ k) le_rfl)

/-- Honesty check: the translated stopped event is measurable in the exact
all-shell sigma-field dictated by the printed predicates. -/
theorem measurableSet_translatedThetaLadderStoppingEvent_printedShellSigma
    {d : ℕ}
    (M : SubdiffusiveProcess.Frozen.Assumptions.GMCModel d) (L : ℕ)
    (C1 C2 : ℝ) (step m j0 : ℕ) (z : Vec d) :
    MeasurableSet[thetaLadderPrintedShellSigma d]
      (translatedThetaLadderStoppingEvent M L C1 C2 step m j0 z) := by
  rw [thetaLadderPrintedShellSigma_eq_ambient]
  exact measurableSet_translatedThetaLadderStoppingEvent
    M L C1 C2 step m j0 z

end

end SubdiffusiveProcess.CoarseGrainingVocab.Section6ThetaLadder
