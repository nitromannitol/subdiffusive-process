module

public import SubdiffusiveProcess.CoarseGrainingVocab.RestrictedCoefficientSigma

@[expose] public section

/-!
# Theta ladder: the literal restricted-coefficient observation

The bounded-multiplier anchor asks for exceptional events in the sigma-field
generated by the cutoff coefficient on one physical window.  This file
identifies that sigma-field with the pullback of the product measurable space
on the literal restricted field.  It is the measure-theoretic entry point for
the manuscript's countable analytic failure-event construction.
-/

namespace SubdiffusiveProcess.CoarseGrainingVocab.Section6ThetaLadder

open MeasureTheory SubdiffusiveProcess.CoarseGrainingVocab

noncomputable section

variable {d : ℕ} {Ω : Type*}

/-- The coefficient field observed only on `B`. -/
def restrictedCoefficientObservation (a : Ω → Vec d → ℝ)
    (B : Set (Vec d)) (omega : Ω) : B → ℝ :=
  fun x => a omega x

/-- The restricted sigma-field is exactly the pullback of the product
sigma-field on the literal restricted coefficient observation. -/
theorem restrictedCoefficientSigma_eq_comap_observation
    (a : Ω → Vec d → ℝ) (B : Set (Vec d)) :
    restrictedCoefficientSigma a B =
      MeasurableSpace.comap (restrictedCoefficientObservation a B)
        (inferInstance : MeasurableSpace (B → ℝ)) := by
  apply le_antisymm
  · refine iSup_le fun x => ?_
    have hobs : @Measurable Ω (B → ℝ)
        (MeasurableSpace.comap (restrictedCoefficientObservation a B)
          (inferInstance : MeasurableSpace (B → ℝ)))
        (inferInstance : MeasurableSpace (B → ℝ))
        (restrictedCoefficientObservation a B) :=
      Measurable.of_comap_le le_rfl
    have hx := (measurable_pi_apply x).comp hobs
    simpa only [restrictedCoefficientObservation, Function.comp_def] using! hx.comap_le
  · have hobs : @Measurable Ω (B → ℝ)
        (restrictedCoefficientSigma a B)
        (inferInstance : MeasurableSpace (B → ℝ))
        (restrictedCoefficientObservation a B) := by
      let : MeasurableSpace Ω := restrictedCoefficientSigma a B
      exact measurable_pi_iff.mpr fun x =>
        measurable_eval_restrictedCoefficientSigma x.property
    exact hobs.comap_le

/-- Pulling back a measurable analytic event on the restricted-field carrier
produces an event in the anchor's literal restricted coefficient sigma-field. -/
theorem MeasurableSet.preimage_restrictedCoefficientObservation
    {a : Ω → Vec d → ℝ} {B : Set (Vec d)} {s : Set (B → ℝ)}
    (hs : MeasurableSet s) :
    MeasurableSet[restrictedCoefficientSigma a B]
      (restrictedCoefficientObservation a B ⁻¹' s) := by
  rw [restrictedCoefficientSigma_eq_comap_observation]
  exact MeasurableSpace.measurableSet_comap.mpr ⟨s, hs, rfl⟩

end

end SubdiffusiveProcess.CoarseGrainingVocab.Section6ThetaLadder
